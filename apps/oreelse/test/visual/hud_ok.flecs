// The HUD of a base in good shape, over the seeded map at the start, the game paused so nothing
// moves; the slow blink is on and the fast one off. The status bar at the top right: full health
// (a full green bar), Luminite 12 held / 25 shipped, the next wave 0.8 of the gap away (an orange
// bar at 0.8) and enough power (40 / 24 W, a full green bar). No alert and no mine bar. At the
// bottom the toast of a shipment in teal and the rocket status line of a ready rocket (a cargo
// bay, 4 engines and a fuel tank) in bright green.
include apps/oreelse/test/visual/setup/seed
include apps/oreelse/etc/oreelse

using box.transform
using box.camera
using box.surface
using oreelse

// The capture is 640x360: the HUD lays out for a 1280x720 window and its camera shows it at
// half size, so the capture holds the whole HUD as a 1280x720 window shows it
window {
  Surface: {width: 1280, height: 720}
}

hud {
  ui {
    camera {
      Camera: {ortho: true, ortho_scale: 0.5}
    }
  }
}

// A rocket pad on the tiles (4..6, 4..6) in the corner of the map, which no deposit reaches;
// it stands at the center of its middle tile (5, 5). Tile (row, col) is centered at
// x = -47 + 2 col, z = -47 + 2 row
hud_pad : RocketPad {
  Position: {-37, 0, -37}
  OreBuilding: {row: 4, col: 4}
}

// Paused: no system of play changes the state below. The rocket state derives its units,
// validity and the Luminite held from these parts and the inventory
$ {
  (OreGameState, Paused)
  OreBlink: {fast: false, slow: true, lamp: true}
  OreToast: {text: "Shipment away!  +25 Luminite", warn: false, age: 0}
  OreInventory: {
    slots: [{item: items.Luminite, amount: 12}, {item: items.IronPlate, amount: 16}]
  }
  OrePowerState: {production: 40, demand: 24, ratio: 1, blackout: false}
  OreWaveState: {
    root: critters, wave: 2, timer: 10, gap: 50, frac: 0.8, left: 0, spawn: [0, 0, 0, 0],
    spawn_timer: 0, stagger: 0.45, budget: 2.6, style: Mixed, side: 1, kills: 2
  }
  OreRocketState: {
    pad: hud_pad, engines: 4, fuel: 1, cargo: 1, life_support: 0, shipped: 25,
    x: -37, y: 0.74, z: -37
  }
}

// The buildings of the second part of the models from zoom level 0, standing still as the
// original's do, on the textured basin south west of the deposits. The astronaut stands in the
// middle, facing the camera, for the scale. Behind it, two rocket pads on their 3x3 tiles: on
// the left a rocket of 1 unit (a cargo bay, its 4 engines and a fuel storage), its ports dark;
// on the right a rocket of 3 units (two cargo bays loaded with Luminite, their ports lit, and
// the life support, its 12 engines and 3 fuel storages). Both are valid, with their nose. In
// front, on their 2x2 tiles: the factory on the left and the drone pad on the right with its
// four drones docked over the bays where the original places them, drone b at the angle
// (b + 0.5) * 2 PI / 4, 1.4 from the center of the pad and 0.62 above the ground
include apps/oreelse/test/visual/setup/seed
include apps/oreelse/etc/oreelse
include apps/oreelse/test/visual/setup/world

using box.transform
using oreelse

astronaut {
  Position: {-23, 0, 29}
  Rotation: {0, 0.3, 0}
}

buildings_b {
  pad_a : RocketPad {
    Position: {-29, 0, 25}
  }

  // The rocket stands on the axis of its pad at the base_y 0.74 of the original's LaunchPad
  rocket_a {
    Position: {-29, 0.74, 25}
    Rocket: {engines: 4, fuel: 1, cargo: 1, life_support: 0, loaded: false, valid: true}
  }

  pad_b : RocketPad {
    Position: {-17, 0, 25}
  }

  rocket_b {
    Position: {-17, 0.74, 25}
    Rocket: {engines: 12, fuel: 3, cargo: 2, life_support: 1, loaded: true, valid: true}
  }

  factory : Factory {
    Position: {-28, 0, 32}
  }

  drone_pad : DronePad {
    Position: {-18, 0, 32}
  }

  // 1.4 * sin(PI / 4) = 0.98995 out along x and z from the center of the pad
  drone_a : RepairDrone {
    Position: {-17.01005, 0.62, 32.98995}
  }

  drone_b : RepairDrone {
    Position: {-17.01005, 0.62, 31.01005}
  }

  drone_c : RepairDrone {
    Position: {-18.98995, 0.62, 31.01005}
  }

  drone_d : RepairDrone {
    Position: {-18.98995, 0.62, 32.98995}
  }
}

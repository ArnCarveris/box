// The look of the map from zoom level 2, high above the astronaut near the north east corner,
// at the Medium render quality: full resolution, Bloom and the cloud shadows of the sun but no
// Gtao, and shadows of 2048 texels to 140 units. The hazard band runs along the north and east
// edges of the playable area, the boulders lie on the textured basin and plain, the dunes rise
// beyond
include apps/oreelse/test/visual/setup/seed
include apps/oreelse/etc/oreelse
include apps/oreelse/test/visual/setup/world
include apps/oreelse/test/visual/setup/band

using oreelse

// Height 0 snaps the camera to level 2 on the first frame
$ {
  OreView: {camera: camera, level: 2, height: 0, back: 0, look: 0}
  OreQuality: {tier: Medium}
}

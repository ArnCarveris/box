// The title screen over the seeded map at the start: a panel of 900x640 in the middle of the
// window, its hazard strip on top; three signs, MINE in orange, DEFEND in red and ESCAPE in teal,
// each edged in its color with its warning sign art over its label; the two lines of what the game
// is about, the list of the eight controls (the keys right aligned, the actions in the soft
// color) and PRESS ANY KEY TO START at the bottom. No status bar.
include apps/oreelse/test/visual/setup/seed
include apps/oreelse/etc/oreelse

using box.transform
using box.camera
using box.surface
using oreelse

// The capture is 640x360: the HUD lays out for a 1280x720 window and its camera shows it at
// half size, so the capture holds the whole screen as a 1280x720 window shows it
window {
  Surface: {width: 1280, height: 720}
}

hud {
  ui {
    camera {
      Camera: {ortho: true, ortho_scale: 0.5}
    }
  }
}

// The title screen over the seeded map at the start, dimmed by a veil: the ORE ELSE logo in glowing
// amber over a hazard rule, the line about the crash, three sign cards, MINE in orange, DEFEND in
// red and ESCAPE in teal, each edged and lit in its color with its warning sign art over its label;
// the two lines of what the game is about, the eight controls in two columns with their key caps
// and PRESS ANY KEY TO START at the bottom. No status bar.
include apps/oreelse/test/visual/setup/seed
include apps/oreelse/etc/oreelse

using box.transform
using box.camera
using box.surface
using oreelse

// The capture is 640x360: the HUD lays out for a 1280x720 window and its camera shows it at
// half size, so the capture holds the whole screen as a 1280x720 window shows it
window {
  Surface: {width: 1280, height: 720}
}

hud {
  ui {
    camera {
      Camera: {ortho: true, ortho_scale: 0.5}
    }
  }
}

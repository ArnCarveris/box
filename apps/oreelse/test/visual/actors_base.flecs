// The astronaut and a deposit of each ore from zoom level 0: the astronaut at the center, turned
// toward the camera, between the four Luminite deposits of the map, and an iron, a copper and a
// stone deposit in front of it with the looks deposits.flecs gives them
include apps/oreelse/test/visual/setup/seed
include apps/oreelse/etc/oreelse
include apps/oreelse/test/visual/setup/world

using box.transform
using oreelse

astronaut {
  Rotation: {0, 0.6, 0}
}

samples {
  iron {
    Position: {-3, 0, 3}
    Rotation: {0, 0.4, 0}
    Ore: {
      tint: {155, 194, 234}, padTint: {139, 139, 147}, glow: 0.25,
      metallic: 0.45, roughness: 0.12,
      chunks: 12, chunkSize: 0.28, spread: 0.62
    }
  }

  copper {
    Position: {1, 0, 5}
    Rotation: {0, 1.3, 0}
    Ore: {
      tint: {250, 194, 118}, padTint: {150, 135, 125}, glow: 0.25,
      metallic: 0.25, roughness: 0.12,
      chunks: 12, chunkSize: 0.28, spread: 0.62
    }
  }

  stone {
    Position: {3, 0, 3}
    Rotation: {0, 2.2, 0}

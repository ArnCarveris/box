// The buildings of the first part of the models from zoom level 0, standing still as the
// original's do, on the textured basin south west of the deposits. The astronaut stands in the
// middle, facing the camera, for the scale. Behind it, from left to right: the gun turret, the
// laser turret, the missile turret, the drill and the solar panel, each on a tile of the grid.
// In front of them: two walls on neighboring tiles with the connector between them, the good
// and the bad tile marker and two pad beacons. In the front row, the Light template three times
// its size: the status lamp in its live, ok, warn and dead colors, a lamp that is off, and a
// work lamp that lights its surroundings with a point light
include apps/oreelse/test/visual/setup/seed
include apps/oreelse/etc/oreelse
include apps/oreelse/test/visual/setup/world

using box.transform
using box.material
using oreelse

const lampLive: Rgb = {92, 236, 222}
const lampOk: Rgb = {124, 226, 148}
const lampWarn: Rgb = {240, 152, 72}
const lampDead: Rgb = {248, 84, 72}
const hazard: Rgb = {240, 176, 58}

astronaut {
  Position: {-23, 0, 29}
  Rotation: {0, 0.3, 0}
}

buildings_a {
  gun_turret : GunTurret {
    Position: {-31, 0, 21}
  }

  laser_turret : LaserTurret {
    Position: {-27, 0, 21}
  }

  missile_turret : MissileTurret {
    Position: {-23, 0, 21}
  }

  drill : Drill {
    Position: {-19, 0, 21}
  }

  solar_panel : SolarPanel {
    Position: {-15, 0, 21}
  }

  // Two walls on the tiles of columns 8 and 9 of one row, the connector on the edge between
  // them where OreBuildings places it
  wall_a : Wall {
    Position: {-31, 0, 25}
  }

  wall_b : Wall {
    Position: {-29, 0, 25}
  }

  wall_link : WallSegment {
    Position: {-30, 0, 25}
    Rotation: {0, 0, 0}
  }

  // The markers at the height the original draws them over a tile
  marker : TileMarker {
    Position: {-25, 0.12, 25}
  }

  marker_bad : TileMarkerBad {
    Position: {-21, 0.12, 25}
  }

  beacon_a {
    Position: {-17, 0, 25}
    PadBeacon: {}
  }

  beacon_b {
    Position: {-15, 0, 25}
    PadBeacon: {}
  }

  lamps {
    Position: {-23, 0, 31}
    Scale: {3, 3, 3}

    live {
      Position: {-2.6, 0, 0}
      Light: {color: lampLive, dead: lampDead, status: true, w: 0.22, d: 0.24, h: 0.12,
        strength: 2.8}
    }

    ok {
      Position: {-2, 0, 0}
      Light: {color: lampOk, dead: lampDead, status: true, w: 0.22, d: 0.24, h: 0.12,
        strength: 2.8}
    }

    warn {
      Position: {-1.4, 0, 0}
      Light: {color: lampWarn, dead: lampDead, status: true, w: 0.22, d: 0.24, h: 0.12,
        strength: 2.8}
    }

    dead {
      Position: {1.4, 0, 0}
      Light: {color: lampDead, dead: lampDead, status: true, w: 0.22, d: 0.24, h: 0.12,
        strength: 2.8}
    }

    off {
      Position: {2, 0, 0}
      Light: {on: false, w: 0.22, d: 0.24, h: 0.12}
    }

    work {
      Position: {2.6, 0, 0}
      Light: {color: hazard, work: true, w: 0.22, d: 0.22, h: 0.14, strength: 1.8, light: 1.5}
    }
  }
}

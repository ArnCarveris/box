// The critters and the projectiles from zoom level 0: the astronaut on the basin south of the
// deposits, turned toward the camera, with the behemoth and the brute behind it, the skitter,
// the mite, a tracer and a missile in flight in front of it, nearer the camera, and a laser
// beam reaching the brute. Every actor faces about toward the camera, turned to show a side
include apps/oreelse/test/visual/setup/seed
include apps/oreelse/etc/oreelse
include apps/oreelse/test/visual/setup/world

using flecs.script.math
using box.transform

// Beyond the deposit clusters, which reach about 23 units from the center
astronaut {
  Position: {0, 0, 30}
  Rotation: {0, 0.6, 0}
}

actors {
  behemoth : Behemoth {
    Position: {-9, 0, 23}
    Rotation: {0, 0.5, 0}
  }

  brute : Brute {
    Position: {8, 0, 25}
    Rotation: {0, -0.5, 0}
  }

  skitter : Skitter {
    Position: {-4.5, 0, 34.5}
    Rotation: {0, 0.4, 0}
  }

  mite : Mite {
    Position: {-1.5, 0, 36.5}
    Rotation: {0, -0.3, 0}
  }

  // Flying across the view at the height of a turret's muzzle
  tracer : Tracer {
    Position: {2, 1, 36}
    Rotation: {0, 1.2, 0}
  }

  missile : Missile {
    Position: {4.5, 1.2, 35}
    Rotation: {0, -1.0, 0}
  }

  // From (2, 1, 31) to the brute's head at (7.6, 1, 25.8): halfway between them, turned
  // toward the brute and as long as their distance
  laser_beam : LaserBeam {
    Position: {4.8, 1, 28.4}
    Rotation: {0, atan2(5.6, -5.2), 0}
    Scale: {1, 1, sqrt(5.6 * 5.6 + 5.2 * 5.2)}
  }
}

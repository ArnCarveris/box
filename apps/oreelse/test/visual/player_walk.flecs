// The astronaut walking east on the basin south of the deposits, three frames into play, seen
// from close up on its right side: a full stride, the legs and arms swung opposite to
// each other and the body bobbed up. The game plays, walked by a held action of the scene's own,
// and the walk cycle (OrePlayerGait) and the limbs start in the stride, the half step before it
// counted, so OrePlayerFx kicks up the dust on frame one; three frames old it is still too small
// to show behind the boots (oreelse_player_fx.py checks it, particles_gallery shows FootDust)
include apps/oreelse/test/visual/setup/seed
include apps/oreelse/etc/oreelse

using flecs.script.math
using box.transform
using box.input
using oreelse

// Held for the whole scene: it has no binding, so no input releases it
walk_east {
  ActionState: {down: true}
}

// The camera stays put: it is detached from the astronaut (OreView.camera 0)
$ {
  (OreGameState, Playing)
  OreActions: {
    forward: actions.Forward,
    back: actions.Back,
    left: actions.Left,
    right: walk_east,
    run: actions.Run,
    mine: actions.Mine,
    place: actions.Place
  }
  OreView: {camera: 0, view: main_view, level: 0, height: 0, back: 0, look: 0}
}

// 4.4 south of the astronaut, looking north and down at 1 above its feet
camera {
  Position: {-5.8, 1.6, 35.4}
  Rotation: {-atan2(1.6 - 1, 4.4), 0, 0}
}

// Beyond the deposit clusters, facing east. The limbs hold the pose of the cycle at 1:
// sin(1 + phase) * swing
astronaut {
  Position: {-6, 0, 31}
  Rotation: {0, PI / 2, 0}
  OrePlayerGait: {cycle: 1, step: 1}

  leg_left {
    Rotation: {0.463, 0, 0}
  }

  leg_right {
    Rotation: {-0.463, 0, 0}
  }

  arm_left {
    Rotation: {-0.32, 0, 0}
  }

  arm_right {
    Rotation: {0.32, 0, 0}
  }
}

// The astronaut walking east on the basin south of the deposits, three frames into play, seen
// from close up on its right: a full stride, the legs and arms swung opposite to each other, the
// body bobbed up, and the foot dust of the half step it just took at its feet. The game plays,
// walked by a held action of the scene's own, and the walk cycle (OreGait) and the limbs start
// in the stride, the half step before it counted, so OrePlayerFx kicks up the dust on frame one
include apps/oreelse/test/visual/setup/seed
include apps/oreelse/etc/oreelse

using flecs.script.math
using box.transform
using box.input
using oreelse

// Held for the whole scene: it has no binding, so no input releases it
walk_east {
  ActionState: {down: true}
}

// The camera stays put: it is detached from the astronaut (OreView.camera 0)
$ {
  (OreGameState, Playing)
  OreActions: {
    forward: actions.Forward,
    back: actions.Back,
    left: actions.Left,
    right: walk_east,
    run: actions.Run,
    mine: actions.Mine,
    place: actions.Place
  }
  OreView: {camera: 0, view: main_view, level: 0, height: 0, back: 0, look: 0}
}

camera {
  Position: {-5.6, 2.6, 35.5}
  Rotation: {-atan2(2.6 - 0.9, 4.5), 0, 0}
}

// Beyond the deposit clusters, facing east. The limbs hold the pose of the cycle at 1:
// sin(1 + phase) * swing
astronaut {
  Position: {-6, 0, 31}
  Rotation: {0, PI / 2, 0}
  OreGait: {cycle: 1, step: 1}

  leg_left {
    Rotation: {0.463, 0, 0}
  }

  leg_right {
    Rotation: {-0.463, 0, 0}
  }

  arm_left {
    Rotation: {-0.32, 0, 0}
  }

  arm_right {
    Rotation: {0.32, 0, 0}
  }
}

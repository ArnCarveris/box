// The astronaut flying east on its jetpack over a row of walls, three frames into play, seen
// from behind on its right: hovering 3 units up, its legs and arms trailing behind, and the
// jet plume shooting down from its backpack, flame yellow through orange to smoke. The game
// plays, walked by a held action of the scene's own; the astronaut starts in the air with its
// limbs trailing, and its plume also bursts what it keeps alive while it plays on its first frame
include apps/oreelse/test/visual/setup/seed
include apps/oreelse/etc/oreelse

using flecs.script.math
using box.transform
using box.input
using box.particle
using oreelse

// Held for the whole scene: it has no binding, so no input releases it
walk_east {
  ActionState: {down: true}
}

// The camera stays put: it is detached from the astronaut (OreView.camera 0)
$ {
  (OreGameState, Playing)
  OreActions: {
    forward: actions.Forward,
    back: actions.Back,
    left: actions.Left,
    right: walk_east,
    run: actions.Run,
    mine: actions.Mine,
    place: actions.Place
  }
  OreView: {camera: 0, view: main_view, level: 0, height: 0, back: 0, look: 0}
}

// 2 west and 3.2 south of the astronaut, turned toward it and looking down at 0.6 above its
// feet
camera {
  Position: {-9, 5.5, 34.2}
  Rotation: {-atan2(5.5 - 3.6, sqrt(2 * 2 + 3.2 * 3.2)), -atan2(2, 3.2), 0}
}

// Walls on row 39, columns 18 to 23, placed as the game places them so they register in the
// tile grid and join with segments. Tile (row, col) is centered at x = -47 + 2 col,
// z = -47 + 2 row
walls {
  for col in 18..24 {
    "wall_{col}" {
      (IsA, Wall)
      Position: {-47 + 2 * col, 0, 31}
      OreBuilding: {row: 39, col: col}
    }
  }
}

// Over the wall of column 20, facing east, at the height of the jetpack. The limbs hold the
// trail of a walk in the air: 0.85 times their swing
astronaut {
  Position: {-7, 3, 31}
  Rotation: {0, PI / 2, 0}
  OrePlayer: {moving: true, running: false, hover: 3, airborne: true}

  leg_left {
    Rotation: {0.4675, 0, 0}
  }

  leg_right {
    Rotation: {0.4675, 0, 0}
  }

  arm_left {
    Rotation: {0.323, 0, 0}
  }

  arm_right {
    Rotation: {0.323, 0, 0}
  }

  // 70 a second over a mean life of 0.3 s
  jet {
    ParticleBurst: {count: 21}
  }
}

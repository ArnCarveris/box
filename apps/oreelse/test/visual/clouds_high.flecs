// The cloud shadows of the sun over the seeded map from zoom level 2, at the High render
// quality, 40 seconds into play: the soft edged shadows of the clouds cover about 45% of the
// basin and the plain, deposits and boulders included, and darken the sun to 0.4 under a full
// cloud. The scene stays on the title screen, where the clock of play stands still, so the
// clouds stand where 40 seconds of drift put them
include apps/oreelse/test/visual/setup/seed
include apps/oreelse/etc/oreelse
include apps/oreelse/test/visual/setup/world

using oreelse

// Height 0 snaps the camera to level 2 on the first frame
$ {
  OreView: {camera: camera, view: main_view, level: 2, height: 0, back: 0, look: 0}
  OreQuality: {tier: High}
  OreClock: {elapsed: 40}
}

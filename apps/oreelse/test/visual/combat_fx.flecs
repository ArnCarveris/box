// A laser and a gun turret firing at critters and a missile exploding, from zoom level 0 while
// playing, captured three frames into play: the pink beam of the laser turret on the left runs
// from its lens to the brute, its lens glows and the pink sparks fly where the beam lands, both
// lighting their surroundings pink; the gun turret on the right has fired its first shot at the
// skitter, its muzzle flash lit and fading, the sparks of the shot at the muzzle and the tracer
// on its way; between them a missile that dived into the ground in the first frame explodes, a
// fireball with its flash light. Two solar panels behind the laser power it. The critters stand
// still (speed 0) with hit points to spare, out of the blast, and the astronaut in front holds its
// pistol, so the picture is the same in every render.
include apps/oreelse/test/visual/setup/seed
include apps/oreelse/etc/oreelse

using box.transform
using box.particle
using oreelse

// Three frames of the streams show a few particles at most, so the glow and the sparks of the
// beam burst what they keep alive while they play (rate times the mean lifetime) on their first
// frame: the parts of a placed building copy the prefab's parts when it is placed, so the scene
// sets them on the prefab before it places the turret
LaserTurret {
  hit_fx {
    ParticleBurst: {count: 61}
  }

  head {
    fx {
      ParticleBurst: {count: 12}
    }
  }
}

// The turrets, the explosion and the trail animate only while playing
$ {
  (OreGameState, Playing)
}

// Beyond the deposit clusters, which reach about 23 units from the center. Its pistol is held
// (its timer far off), so it does not shoot the critters
astronaut {
  Position: {0, 0, 34}
  Rotation: {0, 0.6, 0}
  OreAttackTimer: {value: 100000}
}

// Placed buildings, under the run's parent of the buildings, each at the center of its tile: the
// laser turret on (38, 21), the gun turret on (38, 25) and the panels on (35, 20) and (35, 21)
buildings {
  laser : LaserTurret {
    Position: {-5, 0, 29}
    OreBuilding: {row: 38, col: 21}
  }

  gun : GunTurret {
    Position: {3, 0, 29}
    OreBuilding: {row: 38, col: 25}
  }

  panel_a : SolarPanel {
    Position: {-7, 0, 23}
    OreBuilding: {row: 35, col: 20}
  }

  panel_b : SolarPanel {
    Position: {-5, 0, 23}
    OreBuilding: {row: 35, col: 21}
  }
}

// The brute 7 units north west of the laser and the skitter 6 units north east of the gun, in
// range of their turret only, standing still with hit points to spare
const brute: entity = oreelse.spawn_critter(Brute, -10, 24)
const skitter: entity = oreelse.spawn_critter(Skitter, 7, 24.5)

$brute {
  OreSpeed = {value: 0}
  OreHealth = {value: 100000, max: 100000}
  OreCritter = {retarget: 100, jitter: 0, attacking: false, anim: 1.1}
}

$skitter {
  OreSpeed = {value: 0}
  OreHealth = {value: 100000, max: 100000}
  OreCritter = {retarget: 100, jitter: 0, attacking: false, anim: 0.8}
}

// A missile of the missile turret just above the ground between the turrets, diving at its
// speed: it reaches the ground in the first frame and explodes, its splash 5 (scale 1) reaching
// neither critter
projectiles {
  missile : Missile {
    Position: {-1, 0.2, 27}
    Rotation: {1.2, 0.5, 0}
    OreProjectile: {vx: 3.1, vy: -16.8, vz: 5.7, life: 5, radius: 0.8}
    OreDamage: {value: 150}
    OreSplash: {radius: 5}
  }
}

// The look of the map from zoom level 0, close behind the astronaut near the north east
// corner, at the Low render quality: half resolution, no Gtao or Bloom and shadows of 1024
// texels to 91 units. The sun lights the dirt textures of the basin and the plain from the
// south west; the hazard band runs along the north and east edges of the playable area
include apps/oreelse/test/visual/setup/seed
include apps/oreelse/etc/oreelse
include apps/oreelse/test/visual/setup/band

using oreelse

// Height 0 snaps the camera to level 0 on the first frame
$ {
  OreView: {camera: camera, level: 0, height: 0, back: 0, look: 0}
  OreQuality: {tier: Low}
}

// The flora from zoom level 0 in the sun, on the basin south of the deposits: a patch of
// frondstalks on the left, of ashcups in the middle and of quillbulbs on the right, behind the
// astronaut, who stands facing the camera for the scale. The fronds and membranes are alpha
// tested cutouts: their edges are clean, without a blended fringe, and their shadows on the
// ground have the holes of their textures. The seeded map's own flora (scenery.flecs) is moved
// out of sight, so only the patches show.
include apps/oreelse/test/visual/setup/seed
include apps/oreelse/etc/oreelse

using box.transform
using oreelse

// Beyond the deposit clusters, which reach about 23 units from the center
astronaut {
  Position: {0, 0, 31}
  Rotation: {0, 0.4, 0}
}

// The map's plants are children of flora, which their positions are relative to
flora {
  Position: {0, -100, 0}
}

flora_patches {
  frondstalk_a {
    Position: {-7.2, 0, 26.4}
    Rotation: {0, 0.4, 0}
    Frondstalk: {height: 2.4, stalkTint: {104, 80, 88}}
  }

  frondstalk_b {
    Position: {-4.6, 0, 27.6}
    Rotation: {0, 2.1, 0}
    Frondstalk: {height: 1.9, stalkTint: {92, 74, 80}}
  }

  frondstalk_c {
    Position: {-6.4, 0, 29.4}
    Rotation: {0, 4.3, 0}
    Frondstalk: {height: 2.1, stalkTint: {110, 86, 96}}
  }

  frondstalk_d {
    Position: {-8.6, 0, 28.6}
    Rotation: {0, 5.6, 0}
    Frondstalk: {height: 1.8, stalkTint: {98, 72, 84}}
  }

  ashcup_a {
    Position: {-1.6, 0, 26.6}
    Rotation: {0, 0.9, 0}
    Ashcup: {size: 0.8, nubTint: {150, 128, 118}}
  }

  ashcup_b {
    Position: {0.4, 0, 27.2}
    Rotation: {0, 2.6, 0}
    Ashcup: {size: 0.62, nubTint: {162, 136, 124}}
  }

  ashcup_c {
    Position: {2.2, 0, 26.2}
    Rotation: {0, 4.1, 0}
    Ashcup: {size: 0.74, nubTint: {140, 120, 112}}
  }

  ashcup_d {
    Position: {-0.6, 0, 28.6}
    Rotation: {0, 5.2, 0}
    Ashcup: {size: 0.56, nubTint: {156, 132, 120}}
  }

  ashcup_e {
    Position: {1.6, 0, 29.0}
    Rotation: {0, 1.7, 0}
    Ashcup: {size: 0.68, nubTint: {146, 124, 116}}
  }

  quillbulb_a {
    Position: {5.2, 0, 26.6}
    Rotation: {0, 0.2, 0}
    Quillbulb: {size: 0.78, bulbTint: {160, 144, 134}}
  }

  quillbulb_b {
    Position: {7.4, 0, 27.4}
    Rotation: {0, 2.4, 0}
    Quillbulb: {size: 0.62, bulbTint: {150, 138, 130}}
  }

  quillbulb_c {
    Position: {5.8, 0, 29.2}
    Rotation: {0, 3.9, 0}
    Quillbulb: {size: 0.7, bulbTint: {176, 156, 146}}
  }

  quillbulb_d {
    Position: {8.4, 0, 29.6}
    Rotation: {0, 5.4, 0}
    Quillbulb: {size: 0.56, bulbTint: {146, 134, 126}}
  }
}

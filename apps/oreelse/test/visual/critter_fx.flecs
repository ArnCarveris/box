// The critters mid-stride and a fresh corpse, from zoom level 0 while playing: the astronaut on
// the basin south of the deposits, the behemoth and the brute behind it, the skitter and the mite
// beside it, each going for it with its body up on the bob, waddling, and its legs mid-swing,
// and in front of it the corpse of a skitter that just died, tipped over, squashed,
// charred black with its eyes dark and its embers glowing. The critters stand still (speed 0)
// and their walk cycles are set, so their poses are the same in every render.
include apps/oreelse/test/visual/setup/seed
include apps/oreelse/etc/oreelse

using box.transform
using oreelse

// Beyond the deposit clusters, which reach about 23 units from the center
astronaut {
  Position: {0, 0, 30}
  Rotation: {0, 0.6, 0}
}

// The walk and the corpses animate only while playing
$ {
  (OreGameState, Playing)
}

// Each out of its attack range of the astronaut, so it walks rather than chews, turned toward it
// by OreCritterMove and posed at its walk cycle by OreCritterFx and OreCritterLimbs
critter_fx {
  behemoth : Behemoth {
    Position: {-10, 0, 23}
    OreSpeed: {value: 0}
    OreTarget: {value: astronaut}
    OreCritter: {retarget: 100, jitter: 0, attacking: false, anim: 1.1}
  }

  brute : Brute {
    Position: {8, 0, 25}
    OreSpeed: {value: 0}
    OreTarget: {value: astronaut}
    OreCritter: {retarget: 100, jitter: 0, attacking: false, anim: 2.0}
  }

  skitter : Skitter {
    Position: {-5.5, 0, 33.5}
    OreSpeed: {value: 0}
    OreTarget: {value: astronaut}
    OreCritter: {retarget: 100, jitter: 0, attacking: false, anim: 0.8}
  }

  mite : Mite {
    Position: {-3.5, 0, 31}
    OreSpeed: {value: 0}
    OreTarget: {value: astronaut}
    OreCritter: {retarget: 100, jitter: 0, attacking: false, anim: 1.3}
  }
}

// A skitter's corpse in front of the astronaut, as one that died heading 2.2 radians about y
const corpse: entity = oreelse.corpse(Skitter, {3.5, 0, 34}, 2.2)

// The health bar over the damaged astronaut, from zoom level 0 while playing, on the basin south
// west of the deposits: the astronaut at 35% health facing the camera, with a dark bar 4 px tall
// (2 px in the half size capture) 6 px above the tip of its antenna, as wide as its model box
// looks on screen. The fill covers about a third of the inside of the bar in a red-orange
// between {248, 84, 72} and amber {240, 176, 58}. Below the top center the HUD shows no suit
// breach alert (above 30%), and the status bar at the top right has no health gauge.
include apps/oreelse/test/visual/setup/seed
include apps/oreelse/etc/oreelse

using box.transform
using box.camera
using box.surface
using oreelse

// The capture is 640x360: the UI lays out for a 1280x720 window and its cameras show it at half
// size, so the capture holds the bar and the HUD as a 1280x720 window shows them
window {
  Surface: {width: 1280, height: 720}
}

health_bars {
  camera {
    Camera: {ortho: true, ortho_scale: 0.5}
  }
}

hud {
  ui {
    camera {
      Camera: {ortho: true, ortho_scale: 0.5}
    }
  }
}

// The bar shows while playing. Height 0 snaps the camera to level 0 on the first frame
$ {
  (OreGameState, Playing)
  OreView: {camera: camera, view: main_view, level: 0, height: 0, back: 0, look: 0}
}

// Just hurt, so it does not regenerate during the capture. The health is set after OrePlayer
// (run.flecs), which the game's bars follow
astronaut {
  Position: {-23, 0, 37}
  Rotation: {0, 0.3, 0}
  OreHurt: {since: 0}
  OreHealth: {value: 35, max: 100}
}

// The model of an ore deposit, the Ore template of the original. Its origin is the center of
// its tile on the ground: a pad, slabs of rock around it and chunks of ore in the tint, which
// glow with the glow of the ore. deposits.flecs gives each ore its look. Every instance draws
// its own slabs and chunks from oreRng, seeded from the session, so a seeded session gives
// the same deposits.

using flecs.script.math
using box.transform
using box.geometry
using box.material

const oreRng: Rng = {seed: oreelse.seed(3)}

template Ore {
  prop tint: Rgb = {140, 138, 132}
  prop padTint: Rgb = {96, 82, 66}
  prop glow: f32 = 0
  prop metallic: f32 = 0
  prop roughness: f32 = 0.7
  prop chunks: i32 = 11
  prop chunkSize: f32 = 0.28
  prop chunkTall: f32 = 1
  prop spread: f32 = 0.62
  prop chunkShape: i32 = 0
  prop slabs: i32 = 4

  pad {
    Position: {0, 0.055, 0}
    Rotation: {0, oreRng.f(0.5) - 0.25, 0}
    Box: {1.44, 0.11, 1.36}
    Rgb: padTint
    PbrMaterial: {metallic: 0, roughness: 0.95}
  }

  // Flat slabs around the center, one per quarter turn
  for k in 0..slabs {
    const sa = 1.5708 * k + oreRng.f(1) - 0.5
    const sr = 0.3 + oreRng.f(0.16)
    const sw = 0.66 + oreRng.f(0.44)
    const sd = 0.58 + oreRng.f(0.4)
    const sh = 0.06 + oreRng.f(0.1)

    "shelf_{k}" {
      Position: {cos(sa) * sr, sh * 0.5, sin(sa) * sr}
      Rotation: {oreRng.f(0.16) - 0.08, oreRng.f(6.283), oreRng.f(0.16) - 0.08}
      Box: {sw, sh, sd}
      Rgb: padTint
      PbrMaterial: {metallic: 0, roughness: 0.88 + oreRng.f(0.1)}
    }
  }

  // Chunks of ore scattered over the pad, more of them toward the center
  for i in 0..chunks {
    const a = oreRng.f(6.283)
    const rad = spread * sqrt(oreRng.f(1))
    const w = chunkSize * (0.55 + oreRng.f(0.75))
    const h = w * chunkTall * (0.7 + oreRng.f(0.8))
    const d = w * (0.7 + oreRng.f(0.55))

    "chunk_{i}" {
      Position: {cos(a) * rad, 0.09 + h * 0.42, sin(a) * rad}
      Rotation: {oreRng.f(0.9) - 0.45, oreRng.f(6.283), oreRng.f(0.9) - 0.45}
      Rgb: tint
      PbrMaterial: {metallic: metallic, roughness: roughness}

      if chunkShape > 0 {
        IcoSphere: {segments: 1, smooth: false, radius: 0.5}
        Scale: {w, h, d}
      }

      if chunkShape < 1 {
        Box: {w, h, d}
      }

      if glow > 0 {
        Emissive: {strength: glow, color: tint}
      }
    }
  }
}

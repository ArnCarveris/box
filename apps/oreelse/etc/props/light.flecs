// The indicator light of the buildings, the Light template of the original: a housing, an
// emissive bulb and a glass cover over it. Its origin is the bottom of the housing and it faces
// +Y; a lamp on a wall turns it with Rotation {PI / 2, 0, 0} to face +Z.
//
// The bulb glows in color while on, and is the part the game drives: a status lamp (status) is
// the power lamp of its building, which OrePower colors live, ok, warn or dead and blinks with
// the lamp signal of OreBlink (cfg.lampRate, the original's blink) while dead, through the
// OreStatusLamp of its bulb; a work lamp (work) lights while its building works, blinking at
// blink per second if blink is above 0, through the OreWorkLight of its bulb. Standing still
// both show color at strength. A status lamp lights its surroundings with a small point light
// of cfg.statusLampLight and cfg.statusLampRange, retuned for box's falloff, which is much
// brighter than the original's within a unit of the light; OrePower blinks it with the bulb.
// Any other lamp with light above 0 lights them with a point light of that intensity and range.

using box.transform
using box.geometry
using box.material
using box.light

const lightHousing: Rgb = {113, 118, 129}
const lightOff: Rgb = {110, 115, 125}
const lightGlass: Rgb = {232, 242, 246}

template Light {
  prop color: Rgb = {162, 246, 240}
  prop dead: Rgb = {252, 155, 145}
  prop warn: Rgb = {248, 203, 145}
  prop ok: Rgb = {185, 242, 200}
  prop on = true
  prop status = false
  prop work = false
  prop w: f32 = 0.22
  prop d: f32 = 0.22
  prop h: f32 = 0.1
  prop strength: f32 = 2.6
  prop blink: f32 = 1.4
  prop light: f32 = 0
  prop range: f32 = 2.6

  const bulbY = 0.04 + h * 0.5
  const glassY = 0.04 + h + 0.005

  housing {
    Position: {0, 0.02, 0}
    Box: {w + 0.07, 0.04, d + 0.07}
    Rgb: lightHousing
    PbrMaterial: {metallic: 0.55, roughness: 0.45}
  }

  bulb {
    Position: {0, bulbY, 0}
    Box: {w, h, d}
    PbrMaterial: {metallic: 0, roughness: 0.35}

    if on {
      Rgb: color
      Emissive: {strength: strength, color: color}
    } else {
      Rgb: lightOff
    }

    // OrePower colors the bulb of a status lamp and its light by the power of its building
    if status {
      if on {
        PointLight: {intensity: cfg.statusLampLight, range: cfg.statusLampRange}
      }

      oreelse.OreStatusLamp: {
        live: color, dead: dead, warn: warn, ok: ok, strength: strength,
        light: cfg.statusLampLight
      }
    } else {
      if on && light > 0 {
        PointLight: {intensity: light, range: range}
      }
    }

    // The bulb of a work lamp lights while its building works (OreWorkLights)
    if work {
      oreelse.OreWorkLight: {on: strength, off: 0, blink: blink, light: light}
    }
  }

  // The original's glass, alpha 78 of 255
  glass {
    Position: {0, glassY, 0}
    Box: {w + 0.04, 0.04, d + 0.04}
    Rgb: lightGlass
    Opacity: {0.306}
    PbrMaterial: {metallic: 0, roughness: 0.06}
  }
}

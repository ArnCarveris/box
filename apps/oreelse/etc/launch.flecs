// The rocket on the pad: the items a rocket is built from, and the rocket entity, an instance
// of the Rocket template (rocket/rocket.flecs) kept in step with the rocket state of OreRocket.
// It stands at the bottom of the rocket the state gives, so it rises during the ascent; its
// props follow the parts, the load and the validity of the state. Nothing in C writes them.
// Without parts (no pad, an empty pad, after the arrival) the template builds nothing, so the
// rocket is gone. The entity itself always exists: an instance of a template created and
// deleted by a reactive if aborts the app at exit.
//
// The state is reset with every run (run.flecs), which empties the rocket of the previous run.
//
// The kit also names the effects of the flight and the template of the pad's clamps: through
// the flight OreRocketFx (apps/oreelse/src/rocket.c) plays FlameBurst and SmokeBurst under the
// rocket, shakes it (OreRocketModel) during the ignition and swings the clamps out.

using box.transform
using oreelse

$ {
  OreRocketKit: {
    engine: items.RocketEngine,
    fuel: items.RocketFuelStorage,
    cargo: items.RocketCargoBay,
    life_support: items.RocketLifeSupport,
    luminite: items.Luminite,
    flame: FlameBurst,
    smoke: SmokeBurst,
    clamp: PadClamp
  }
}

const rocketState = OreRocketState[OreRocketState]

// Each value on its own, so a change of one (the height, every frame of the ascent) only sets
// what depends on it
const rocketX = rocketState.x
const rocketY = rocketState.y
const rocketZ = rocketState.z
const rocketEngines = rocketState.engines
const rocketFuel = rocketState.fuel
const rocketCargo = rocketState.cargo
const rocketLife = rocketState.life_support
const rocketLoaded = rocketState.loaded > 0
const rocketValid = rocketState.valid

rocket {
  Position: {rocketX, rocketY, rocketZ}
  DynamicTransform
  OreRocketModel
  Rocket: {
    engines: rocketEngines,
    fuel: rocketFuel,
    cargo: rocketCargo,
    life_support: rocketLife,
    loaded: rocketLoaded,
    valid: rocketValid
  }
}

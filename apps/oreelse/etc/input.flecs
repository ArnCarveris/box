using flecs.script
using box.input
using oreelse

actions {
  // Walking keys apply with the run key held too
  Forward {
    Action: {description: "Walk north, toward -Z"}
    Binding: {key: W, ignore_modifiers: true}
  }

  Back {
    Action: {description: "Walk south, toward +Z"}
    Binding: {key: S, ignore_modifiers: true}
  }

  Left {
    Action: {description: "Walk west, toward -X"}
    Binding: {key: A, ignore_modifiers: true}
  }

  Right {
    Action: {description: "Walk east, toward +X"}
    Binding: {key: D, ignore_modifiers: true}
  }

  Run {
    Action: {description: "Run at twice the walking speed while held"}

    left_shift {
      Binding: {key: ShiftLeft, ignore_modifiers: true}
    }

    right_shift {
      Binding: {key: ShiftRight, ignore_modifiers: true}
    }
  }

  // A press on a panel of the UI (an InputBlocker) does not reach the binding
  Mine {
    Action: {description: "Mine the deposit under the cursor while held"}
    Binding: {key: MouseRight, ignore_modifiers: true}
  }

  Cancel {
    Action: {description: "Back out of one thing; with nothing left, pause or resume"}
    Binding: {key: Escape}
  }

  Restart {
    Action: {description: "Start a new run once the game is won or lost"}
    Binding: {key: R}
  }

  // No key: the pause screen's button raises it (ActionTrigger)
  Quality {
    Action: {description: "Cycle the render quality, High to Medium to Low and back to High"}
  }
}

$ {
  OreActions: {
    forward: actions.Forward,
    back: actions.Back,
    left: actions.Left,
    right: actions.Right,
    run: actions.Run,
    mine: actions.Mine
  }
}

async {
  while true {
    await on.pressed(actions.Cancel)
    await oreelse.cancel()
  }
}

async {
  while true {
    await on.pressed(actions.Restart)
    await oreelse.restart()
  }
}

async {
  while true {
    await on.pressed(actions.Quality)
    await oreelse.cycleQuality()
  }
}

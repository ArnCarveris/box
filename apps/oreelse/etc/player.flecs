// The astronaut, the Astronaut template of the original: a suit of boxes with a helmet and
// its visor, a backpack with two tanks, and the jet child that the jetpack plume comes out of.
// Its origin is between its feet on the ground and it faces +Z. The legs and arms are pivots
// with OreLimb (at the hips and shoulders) that OreLimbs swings while playing.

using flecs.script.math
using box.transform
using box.geometry
using box.material
using oreelse

template Astronaut {
  prop suit: Rgb = {243, 245, 248}

  // The bounds of the model, the anchor of its health bar (src/health_bars.c): out to the
  // shoulder pads on x, the backpack on z and the antenna tip on y
  OreModelBox: {w: 1.06, d: 0.9, h: 2.29}

  const suitShade: Rgb = {220, 223, 231}
  const trim: Rgb = {246, 197, 129}
  const visorColor: Rgb = {162, 246, 240}
  const rubber: Rgb = {131, 137, 150}
  const seam: Rgb = {200, 205, 214}
  const hardware: Rgb = {165, 171, 182}

  leg_left {
    Position: {0.16, 0.66, 0}
    OreLimb: {phase: 0, swing: 0.55}

    shin {
      Position: {0, -0.31, 0}
      Box: {0.22, 0.62, 0.24}
      Rgb: suitShade
      PbrMaterial: {metallic: 0, roughness: 0.8}

      knee_pad {
        Position: {0, 0.2, 0.1}
        Box: {0.2, 0.16, 0.1}
        Rgb: seam
        PbrMaterial: {metallic: 0.15, roughness: 0.7}
      }
    }

    foot {
      Position: {0, -0.62, 0.07}
      Box: {0.24, 0.14, 0.36}
      Rgb: rubber
      PbrMaterial: {metallic: 0, roughness: 0.9}

      toe_cap {
        Position: {0, 0.02, 0.15}
        Box: {0.26, 0.16, 0.1}
        Rgb: seam
        PbrMaterial: {metallic: 0.2, roughness: 0.65}
      }

      heel_strap {
        Position: {0, 0.02, -0.13}
        Box: {0.26, 0.12, 0.12}
        Rgb: hardware
        PbrMaterial: {metallic: 0.4, roughness: 0.6}
      }
    }
  }

  leg_right {
    Position: {-0.16, 0.66, 0}
    OreLimb: {phase: PI, swing: 0.55}

    shin {
      Position: {0, -0.31, 0}
      Box: {0.22, 0.62, 0.24}
      Rgb: suitShade
      PbrMaterial: {metallic: 0, roughness: 0.8}

      knee_pad {
        Position: {0, 0.2, 0.1}
        Box: {0.2, 0.16, 0.1}
        Rgb: seam
        PbrMaterial: {metallic: 0.15, roughness: 0.7}
      }
    }

    foot {
      Position: {0, -0.62, 0.07}
      Box: {0.24, 0.14, 0.36}
      Rgb: rubber
      PbrMaterial: {metallic: 0, roughness: 0.9}

      toe_cap {
        Position: {0, 0.02, 0.15}
        Box: {0.26, 0.16, 0.1}
        Rgb: seam
        PbrMaterial: {metallic: 0.2, roughness: 0.65}
      }

      heel_strap {
        Position: {0, 0.02, -0.13}
        Box: {0.26, 0.12, 0.12}
        Rgb: hardware
        PbrMaterial: {metallic: 0.4, roughness: 0.6}
      }
    }
  }

  torso {
    Position: {0, 1.1, 0}
    Box: {0.58, 0.74, 0.42}
    Rgb: suit
    PbrMaterial: {metallic: 0, roughness: 0.82}

    belt {
      Position: {0, -0.3, 0}
      Box: {0.62, 0.12, 0.46}
      Rgb: trim
      PbrMaterial: {metallic: 0.3, roughness: 0.45}

      buckle {
        Position: {0, 0, 0.22}
        Box: {0.16, 0.16, 0.06}
        Rgb: hardware
        PbrMaterial: {metallic: 0.75, roughness: 0.35}
      }

      pouch_left {
        Position: {0.25, -0.01, 0.17}
        Box: {0.16, 0.15, 0.14}
        Rgb: suitShade
        PbrMaterial: {metallic: 0, roughness: 0.8}
      }

      pouch_right {
        Position: {-0.28, 0, 0.02}
        Box: {0.14, 0.16, 0.2}
        Rgb: suitShade
        PbrMaterial: {metallic: 0, roughness: 0.8}
      }
    }

    chest_panel {
      Position: {0, 0.1, 0.23}
      Box: {0.26, 0.2, 0.05}
      Rgb: rubber
      PbrMaterial: {metallic: 0.1, roughness: 0.85}

      led_left {
        Position: {-0.07, 0.035, 0.02}
        Box: {0.05, 0.05, 0.03}
        Rgb: visorColor
        Emissive: {strength: 2.2, color: visorColor}
      }

      led_right {
        Position: {0, 0.035, 0.02}
        Box: {0.05, 0.05, 0.03}
        Rgb: trim
        Emissive: {strength: 1.8, color: trim}
      }

      readout {
        Position: {0.045, -0.045, 0.02}
        Box: {0.13, 0.05, 0.03}
        Rgb: visorColor
        Emissive: {strength: 1.4, color: visorColor}
      }
    }

    seam_left {
      Position: {0.21, 0.06, 0.207}
      Box: {0.05, 0.57, 0.03}
      Rgb: seam
      PbrMaterial: {metallic: 0.1, roughness: 0.72}
    }

    seam_right {
      Position: {-0.21, 0.06, 0.207}
      Box: {0.05, 0.57, 0.03}
      Rgb: seam
      PbrMaterial: {metallic: 0.1, roughness: 0.72}
    }

    collar {
      Position: {0, 0.4, 0}
      Box: {0.34, 0.14, 0.3}
      Rgb: hardware
      PbrMaterial: {metallic: 0.7, roughness: 0.38}
    }
  }

  backpack {
    Position: {0, 1.14, -0.32}
    Box: {0.46, 0.6, 0.26}
    Rgb: suitShade
    PbrMaterial: {metallic: 0.15, roughness: 0.7}

    tank_left {
      Position: {-0.13, 0, -0.16}
      Box: {0.14, 0.5, 0.14}
      Rgb: trim
      PbrMaterial: {metallic: 0.6, roughness: 0.35}

      cap {
        Position: {0, 0.27, 0}
        Box: {0.16, 0.08, 0.16}
        Rgb: hardware
        PbrMaterial: {metallic: 0.8, roughness: 0.3}
      }
    }

    tank_right {
      Position: {0.13, 0, -0.16}
      Box: {0.14, 0.5, 0.14}
      Rgb: trim
      PbrMaterial: {metallic: 0.6, roughness: 0.35}

      cap {
        Position: {0, 0.27, 0}
        Box: {0.16, 0.08, 0.16}
        Rgb: hardware
        PbrMaterial: {metallic: 0.8, roughness: 0.3}
      }
    }

    nozzle_left {
      Position: {-0.13, -0.34, -0.16}
      Cylinder: {segments: 8, smooth: true, length: 0.14, radius: 0.5}
      Scale: {0.09, 1, 0.09}
      Rgb: rubber
      PbrMaterial: {metallic: 0.35, roughness: 0.8}
    }

    nozzle_right {
      Position: {0.13, -0.34, -0.16}
      Cylinder: {segments: 8, smooth: true, length: 0.14, radius: 0.5}
      Scale: {0.09, 1, 0.09}
      Rgb: rubber
      PbrMaterial: {metallic: 0.35, roughness: 0.8}
    }

    hose_upper {
      Position: {-0.215, 0.08, -0.12}
      Cylinder: {segments: 6, smooth: true, length: 0.3, radius: 0.5}
      Rotation: {0, 0, -0.35}
      Scale: {0.05, 1, 0.05}
      Rgb: rubber
      PbrMaterial: {metallic: 0.2, roughness: 0.85}
    }

    hose_side {
      Position: {-0.25, -0.07, 0.03}
      Cylinder: {segments: 6, smooth: true, length: 0.32, radius: 0.5}
      Rotation: {1.5708, 0, 0}
      Scale: {0.05, 1, 0.05}
      Rgb: rubber
      PbrMaterial: {metallic: 0.2, roughness: 0.85}
    }

    hose_torso {
      Position: {-0.28, -0.055, 0.28}
      Cylinder: {segments: 6, smooth: true, length: 0.22, radius: 0.5}
      Rotation: {1.45, 0, 0}
      Scale: {0.05, 1, 0.05}
      Rgb: hardware
      PbrMaterial: {metallic: 0.7, roughness: 0.4}
    }
  }

  jet {
    Position: {0, 0.74, -0.48}
    JetPlume: {}
  }

  arm_left {
    Position: {0.4, 1.36, 0}
    OreLimb: {phase: PI, swing: 0.38}

    upper {
      Position: {0, -0.26, 0}
      Box: {0.18, 0.56, 0.18}
      Rgb: suit
      PbrMaterial: {metallic: 0, roughness: 0.8}

      shoulder_pad {
        Position: {0, 0.19, 0}
        Box: {0.26, 0.16, 0.22}
        Rgb: suitShade
        PbrMaterial: {metallic: 0.1, roughness: 0.75}
      }

      elbow_pad {
        Position: {0, -0.16, 0.02}
        Box: {0.2, 0.14, 0.2}
        Rgb: seam
        PbrMaterial: {metallic: 0.15, roughness: 0.7}
      }

      patch {
        Position: {0.1, 0.06, 0}
        Box: {0.03, 0.14, 0.12}
        Rgb: trim
        PbrMaterial: {metallic: 0.3, roughness: 0.45}
      }
    }

    glove {
      Position: {0, -0.58, 0.02}
      Box: {0.2, 0.2, 0.2}
      Rgb: trim
      PbrMaterial: {metallic: 0.3, roughness: 0.45}

      cuff {
        Position: {0, 0.09, 0.01}
        Box: {0.22, 0.07, 0.22}
        Rgb: rubber
        PbrMaterial: {metallic: 0.2, roughness: 0.85}
      }
    }
  }

  arm_right {
    Position: {-0.4, 1.36, 0}
    OreLimb: {phase: 0, swing: 0.38}

    upper {
      Position: {0, -0.26, 0}
      Box: {0.18, 0.56, 0.18}
      Rgb: suit
      PbrMaterial: {metallic: 0, roughness: 0.8}

      shoulder_pad {
        Position: {0, 0.19, 0}
        Box: {0.26, 0.16, 0.22}
        Rgb: suitShade
        PbrMaterial: {metallic: 0.1, roughness: 0.75}
      }

      elbow_pad {
        Position: {0, -0.16, 0.02}
        Box: {0.2, 0.14, 0.2}
        Rgb: seam
        PbrMaterial: {metallic: 0.15, roughness: 0.7}
      }
    }

    glove {
      Position: {0, -0.58, 0.02}
      Box: {0.2, 0.2, 0.2}
      Rgb: trim
      PbrMaterial: {metallic: 0.3, roughness: 0.45}

      cuff {
        Position: {0, 0.09, 0.01}
        Box: {0.22, 0.07, 0.22}
        Rgb: rubber
        PbrMaterial: {metallic: 0.2, roughness: 0.85}
      }
    }
  }

  helmet {
    Position: {0, 1.74, 0}
    Box: {0.52, 0.5, 0.5}
    Rgb: suit
    PbrMaterial: {metallic: 0.05, roughness: 0.55}

    visor {
      Position: {0, 0.02, 0.25}
      Box: {0.4, 0.26, 0.06}
      Rgb: visorColor
      Emissive: {strength: 1.6, color: visorColor}
      PbrMaterial: {metallic: 0.2, roughness: 0.1}
    }

    chin_guard {
      Position: {0, -0.17, 0.2}
      Box: {0.34, 0.12, 0.14}
      Rgb: suitShade
      PbrMaterial: {metallic: 0.1, roughness: 0.7}
    }

    antenna {
      Position: {0.22, 0.34, -0.12}
      Box: {0.05, 0.28, 0.05}
      Rgb: rubber
      PbrMaterial: {metallic: 0.3, roughness: 0.75}
    }

    antenna_base {
      Position: {0.22, 0.24, -0.12}
      Box: {0.09, 0.08, 0.09}
      Rgb: hardware
      PbrMaterial: {metallic: 0.75, roughness: 0.35}
    }

    antenna_tip {
      Position: {0.22, 0.5, -0.12}
      Box: {0.09, 0.09, 0.09}
      Rgb: trim
      Emissive: {strength: 1.2, color: trim}
    }
  }
}

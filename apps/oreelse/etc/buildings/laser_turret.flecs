// The laser turret, the LaserTurret prefab of the original: a base and an apron with a hazard
// lip, two coils with pink glowing rings at the back, a column with the status lamp on its
// front, and the head with its yoke, the emitter, a fin, the barrel, its collar and the glowing
// lens. Its origin is the center of its tile on the ground and the head faces +Z.
//
// Named parts: head (turns about y to aim), head/fx (the lens, where the beam starts and glows,
// BeamGlow), hit_fx (moves to where the beam hits, with its sparks, BeamSparks) and column/lamp
// (status lamp, Light). The turret plays the glow and the sparks while it fires.

using box.transform
using box.geometry
using box.material
using oreelse

const steel: Rgb = {214, 219, 226}
const steelShade: Rgb = {177, 182, 193}
const steelDeep: Rgb = {129, 135, 148}
const laserPink: Rgb = {247, 165, 212}
const lampLive: Rgb = {162, 246, 240}
const lampDead: Rgb = {252, 155, 145}

prefab LaserTurret {
  // The item: crafted through the order book into the inventory, placed by spending one
  OreItem: {name: "Laser turret", detail: "High efficiency photon delivery for melting opponents."}
  OreIcon: {texture: icons.laser_turret}
  OreRecipe: {
    inputs: [
      {item: items.IronPlate, amount: 30},
      {item: items.Wire, amount: 10},
      {item: items.Electronics, amount: 10}
    ],
    yield: 1, time: 4
  }
  OreFootprint: {w: 1, h: 1}
  OreHealth: {value: 150, max: 150}
  // The box of the model, the health bar's anchor
  OreModelBox: {w: 1.74, d: 1.74, h: 2}
  OrePowerConsumer: {watts: 25}
  OrePowerCategory: {kind: Weapons}
  // The weapon: a beam from the muzzle 1.7 up and 0.74 ahead that burns its target within 13
  // for 50 a second at multiplier 1
  OreTurret: {}
  OreDamage: {value: 50}
  OreRange: {value: 13}
  OreMuzzle: {speed: 0, height: 1.7, forward: 0.74}
  OreBeam: {prefab: LaserBeam}

  hit_fx {
    Position: {0, 0, 0}
    BeamSparks: {color: {247, 165, 212}}
  }

  base {
    Position: {0, 0.13, 0}
    Box: {1.74, 0.26, 1.74}
    Rgb: steelDeep
    PbrMaterial: {metallic: 0.35, roughness: 0.6}
  }

  apron {
    Position: {0, 0.28, 0}
    Box: {1.44, 0.08, 1.44}
    Rgb: steelShade
    PbrMaterial: {metallic: 0.45, roughness: 0.5}
  }

  lip : HazardTrim {
    Position: {0, 0.35, 0.55}
    Box: {1.44, 0.06, 0.34}
  }

  coil_a {
    Position: {-0.54, 0.52, -0.56}
    Cylinder: {segments: 10, smooth: true, length: 0.42, radius: 0.5}
    Scale: {0.12, 1, 0.12}
    Rgb: steelShade

    glow {
      Position: {0, 0.06, 0}
      Cylinder: {segments: 10, smooth: true, length: 0.12, radius: 0.5}
      Scale: {1.24, 1, 1.24}
      Rgb: laserPink
      Emissive: {strength: 2.6, color: laserPink}
    }
  }

  coil_b {
    Position: {0.54, 0.52, -0.56}
    Cylinder: {segments: 10, smooth: true, length: 0.42, radius: 0.5}
    Scale: {0.12, 1, 0.12}
    Rgb: steelShade

    glow {
      Position: {0, 0.06, 0}
      Cylinder: {segments: 10, smooth: true, length: 0.12, radius: 0.5}
      Scale: {1.24, 1, 1.24}
      Rgb: laserPink
      Emissive: {strength: 2.6, color: laserPink}
    }
  }

  column {
    Position: {0, 0.945, 0.04}
    Box: {0.68, 1.31, 0.68}
    Rgb: steelShade
    PbrMaterial: {metallic: 0.55, roughness: 0.45}

    lamp {
      Position: {0, 0.12, 0.32}
      Rotation: {1.5708, 0, 0}
      Light: {
        color: lampLive, dead: lampDead, status: true,
        w: 0.3, d: 0.1, h: 0.05, strength: 2.8
      }
    }
  }

  head {
    Position: {0, 1.68, 0.04}
    Rotation: {0, 0, 0}

    yoke_l {
      Position: {-0.35, 0, -0.06}
      Box: {0.1, 0.46, 0.36}
      Rgb: steel
    }

    yoke_r {
      Position: {0.35, 0, -0.06}
      Box: {0.1, 0.46, 0.36}
      Rgb: steel
    }

    emitter {
      Position: {0, 0.02, -0.02}
      Box: {0.52, 0.4, 0.52}
      Rgb: steel
      PbrMaterial: {metallic: 0.6, roughness: 0.38}
    }

    fin {
      Position: {0, 0.26, -0.1}
      Box: {0.36, 0.12, 0.42}
      Rgb: steelShade
    }

    barrel {
      Position: {0, 0.02, 0.42}
      Cylinder: {segments: 12, smooth: true, length: 0.6, radius: 0.5}
      Rotation: {1.5708, 0, 0}
      Scale: {0.15, 1, 0.15}
      Rgb: steelShade
      PbrMaterial: {metallic: 0.65, roughness: 0.35}
    }

    collar {
      Position: {0, 0.02, 0.6}
      Cylinder: {segments: 12, smooth: true, length: 0.1, radius: 0.5}
      Rotation: {1.5708, 0, 0}
      Scale: {0.2, 1, 0.2}
      Rgb: steelDeep
    }

    lens {
      Position: {0, 0.02, 0.7}
      Cylinder: {segments: 12, smooth: true, length: 0.1, radius: 0.5}
      Rotation: {1.5708, 0, 0}
      Scale: {0.14, 1, 0.14}
      Rgb: laserPink
      Emissive: {strength: 3.4, color: laserPink}
    }

    fx {
      Position: {0, 0.02, 0.82}
      BeamGlow: {color: {247, 165, 212}}
    }
  }
}

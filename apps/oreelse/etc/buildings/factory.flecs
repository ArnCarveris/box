    }

    head {
      Position: {0, -0.14, 0}
      Box: {1.16, 0.34, 0.72}
      Rgb: facSteel
      PbrMaterial: {metallic: 0.6, roughness: 0.35}

      edge {
        Position: {0, -0.2, 0}
        Box: {1.0, 0.1, 0.6}
        Rgb: facHazard
      }
    }
  }

  wheel_post_l {
    Position: {-1.34, 2.18, -0.7}
    Cylinder: {segments: 12, smooth: true, length: 0.62, radius: 0.5}
    Scale: {0.56, 1, 0.56}
    Rgb: facDeep
    PbrMaterial: {metallic: 0.5, roughness: 0.5}

    collar {
      Position: {0, 0.28, 0}
      Cylinder: {segments: 12, smooth: true, length: 0.1, radius: 0.5}
      Scale: {1.18, 1, 1.18}
      Rgb: facShade
    }
  }

  wheel_post_r {
    Position: {1.34, 2.18, -0.7}
    Cylinder: {segments: 12, smooth: true, length: 0.62, radius: 0.5}
    Scale: {0.56, 1, 0.56}
    Rgb: facDeep
    PbrMaterial: {metallic: 0.5, roughness: 0.5}

    collar {
      Position: {0, 0.28, 0}
      Cylinder: {segments: 12, smooth: true, length: 0.1, radius: 0.5}
      Scale: {1.18, 1, 1.18}
      Rgb: facShade
    }
  }

  // The flywheels lie flat on their posts and spin about y (the original's speed 5)
  wheel_left {
    Position: {-1.34, 2.62, -0.7}

    flywheel {
      Position: {0, 0, 0}
      Rotation: {0, 0, 0}

      shroud {
        Cylinder: {segments: 16, smooth: true, length: 0.1, radius: 0.5}
        Scale: {0.34, 1, 0.34}
        Rgb: facShade
        PbrMaterial: {metallic: 0.65, roughness: 0.32}
      }

      face_front : FanDisc {
        Position: {0, 0.06, 0}
        Rotation: {-1.5708, 0, 0}
        Scale: {0.7, 0.7, 1}
      }

      face_back : FanDisc {
        Position: {0, -0.06, 0}
        Rotation: {1.5708, 0, 0}
        Scale: {0.7, 0.7, 1}
      }
    }
  }

  wheel_right {
    Position: {1.34, 2.62, -0.7}

    flywheel {
      Position: {0, 0, 0}
      Rotation: {0, 0, 0}

      shroud {
        Cylinder: {segments: 16, smooth: true, length: 0.1, radius: 0.5}
        Scale: {0.34, 1, 0.34}
        Rgb: facShade
        PbrMaterial: {metallic: 0.65, roughness: 0.32}
      }

      face_front : FanDisc {
        Position: {0, 0.06, 0}
        Rotation: {-1.5708, 0, 0}
        Scale: {0.7, 0.7, 1}
      }

      face_back : FanDisc {
        Position: {0, -0.06, 0}
        Rotation: {1.5708, 0, 0}
        Scale: {0.7, 0.7, 1}
      }
    }
  }

  crate_a {
    Position: {-1.5, 0.55, 1.0}
    Box: {0.5, 0.46, 0.5}
    Rgb: facShade
  }

  crate_b {
    Position: {-1.5, 0.55, 1.62}
    Rotation: {0, 0.4, 0}
    Box: {0.5, 0.46, 0.5}
    Rgb: facSteel

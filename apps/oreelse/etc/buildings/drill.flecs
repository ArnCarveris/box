// The drill, the Drill prefab of the original, which mines the deposit it stands on: a frame of
// beams on the ground with a hazard lip, two legs with their rails up to a crown with the two
// status lamps, a carriage that rides the legs (a piston in the original), a slider on it that
// rides fore and aft with the motor and the bit, and the housing at the back. Its origin is the
// center of its tile on the ground and it faces +Z.
//
// Named parts: carriage (moves along y), carriage/slider (moves along z), carriage/slider/bit
// (spins about y and shakes), crown/pod_l/lamp_l and crown/pod_r/lamp_r (status lamps, Light)
// and dust (where the drill dust comes out). Standing still, all rest where the original's do.

using flecs.script.math
using box.transform
using box.geometry
using box.material
using oreelse

const steel: Rgb = {172, 180, 194}
const steelDeep: Rgb = {56, 62, 76}
const hazard: Rgb = {240, 176, 58}
const lampLive: Rgb = {92, 236, 222}
const lampDead: Rgb = {248, 84, 72}

prefab Drill {
  // The item: crafted through the order book into the inventory, placed by spending one
  OreItem: {name: "Drill", detail: "Mines ore deposits."}
  OreRecipe: {inputs: [{item: items.IronPlate, amount: 6}], yield: 1, time: 1}
  // It only goes on tiles with a deposit, which it mines
  OreFootprint: {w: 1, h: 1, deposit: true}
  OreHealth: {value: 100, max: 100}
  OrePowerConsumer: {watts: 4}
  OrePowerCategory: {kind: Mining}

  beam_front {
    Position: {0, 0.11, 0.76}
    Box: {1.86, 0.22, 0.34}
    Rgb: steelDeep
    PbrMaterial: {metallic: 0.35, roughness: 0.6}

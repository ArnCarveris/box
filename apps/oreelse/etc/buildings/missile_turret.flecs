// The missile turret, the MissileTurret prefab of the original: a base and an apron with a hazard
// lip, a pillar with a panel and the status lamp, a crate, and the head with its rack and two
// launch pods tilted up toward +Z, each with two red missile tips. Its origin is the center of
// its tile on the ground and the head faces +Z.
//
// Named parts: head (turns about y to aim), head/fx (above the pods, where the missiles launch)
// and pillar/light (status lamp, Light).

using box.transform
using box.geometry
using box.material
using oreelse

const steel: Rgb = {172, 180, 194}
const steelShade: Rgb = {112, 120, 136}
const steelDeep: Rgb = {56, 62, 76}
const missileRed: Rgb = {226, 84, 68}
const lampLive: Rgb = {92, 236, 222}
const lampDead: Rgb = {248, 84, 72}

prefab MissileTurret {
  // The item: crafted through the order book into the inventory, placed by spending one
  OreItem: {name: "Missile turret", detail: "Firepower to deal with the most sturdy targets."}
  OreRecipe: {
    inputs: [
      {item: items.IronPlate, amount: 40},
      {item: items.Wire, amount: 20},
      {item: items.Electronics, amount: 20}
    ],
    yield: 1, time: 5
  }
  OreFootprint: {w: 1, h: 1}
  OreHealth: {value: 180, max: 180}
  OrePowerConsumer: {watts: 20}
  OrePowerCategory: {kind: Weapons}
  // The weapon: a homing missile every 0.5 s at multiplier 1 at a target within 17, at 18 from
  // the muzzle 1.8 up and 0.44 ahead, exploding for 150 on every critter within 5
  OreTurret: {}
  OreDamage: {value: 150}
  OreRange: {value: 17}
  OreAttackInterval: {value: 0.5}
  OreSplash: {radius: 5}
  OreMuzzle: {speed: 18, height: 1.8, forward: 0.44}
  OreAmmo: {projectile: Missile}

  base {
    Position: {0, 0.15, 0}
    Box: {1.86, 0.3, 1.86}
    Rgb: steelDeep
    PbrMaterial: {metallic: 0.35, roughness: 0.6}
  }

  apron {
    Position: {0, 0.32, 0}
    Box: {1.56, 0.08, 1.56}
    Rgb: steelShade
    PbrMaterial: {metallic: 0.45, roughness: 0.5}
  }

  lip : HazardTrim {
    Position: {0, 0.39, 0.61}
    Box: {1.56, 0.06, 0.34}
  }

  pillar {
    Position: {0, 0.72, -0.18}
    Box: {0.78, 0.72, 0.66}
    Rgb: steelShade
    PbrMaterial: {metallic: 0.55, roughness: 0.45}

    panel {
      Position: {0, 0.04, 0.35}
      Box: {0.44, 0.28, 0.05}
      Rgb: steelDeep
    }

    light {
      Position: {0, 0.26, 0.31}
      Rotation: {1.5708, 0, 0}
      Light: {
        color: lampLive, dead: lampDead, status: true,
        w: 0.34, d: 0.09, h: 0.05, strength: 2.8
      }
    }
  }

  crate {
    Position: {-0.62, 0.52, 0.5}
    Box: {0.44, 0.32, 0.5}
    Rgb: steelShade
  }

  head {
    Position: {0, 1.16, -0.18}
    Rotation: {0, 0, 0}

    rack {
      Position: {0, 0, 0}
      Box: {0.96, 0.26, 0.82}
      Rgb: steel
      PbrMaterial: {metallic: 0.6, roughness: 0.4}
    }

    pod_l {
      Position: {-0.3, 0.28, 0.1}
      Rotation: {-0.5, 0, 0}
      Box: {0.34, 0.36, 1.04}
      Rgb: steelShade
      PbrMaterial: {metallic: 0.55, roughness: 0.42}

      rail {
        Position: {0, -0.22, 0}
        Box: {0.2, 0.12, 0.9}
        Rgb: steelDeep
      }

      tip {
        Position: {0, 0.09, 0.62}
        Cone: {segments: 10, smooth: true, length: 0.3, radius: 0.5}
        Rotation: {1.5708, 0, 0}
        Scale: {0.15, 1, 0.15}
        Rgb: missileRed
      }

      tip_low {
        Position: {0, -0.09, 0.62}
        Cone: {segments: 10, smooth: true, length: 0.3, radius: 0.5}
        Rotation: {1.5708, 0, 0}
        Scale: {0.15, 1, 0.15}
        Rgb: missileRed
      }
    }

    pod_r {
      Position: {0.3, 0.28, 0.1}
      Rotation: {-0.5, 0, 0}
      Box: {0.34, 0.36, 1.04}
      Rgb: steelShade
      PbrMaterial: {metallic: 0.55, roughness: 0.42}

      rail {
        Position: {0, -0.22, 0}
        Box: {0.2, 0.12, 0.9}
        Rgb: steelDeep
      }

      tip {
        Position: {0, 0.09, 0.62}
        Cone: {segments: 10, smooth: true, length: 0.3, radius: 0.5}
        Rotation: {1.5708, 0, 0}
        Scale: {0.15, 1, 0.15}
        Rgb: missileRed
      }

      tip_low {
        Position: {0, -0.09, 0.62}
        Cone: {segments: 10, smooth: true, length: 0.3, radius: 0.5}
        Rotation: {1.5708, 0, 0}
        Scale: {0.15, 1, 0.15}
        Rgb: missileRed
      }
    }

    fx {
      Position: {0, 0.64, 0.62}
    }
  }
}

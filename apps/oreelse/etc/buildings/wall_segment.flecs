// The connector between two neighboring walls, the WallSegment prefab of the original: a lower
// concrete plinth and kerb, a steel panel with three ribs across it, a rail and a short hazard
// trim (HazardTrimShort) on top. It spans the gap between two walls along x: its origin is the
// middle of the edge of the two tiles on the ground, turned by PI / 2 about y between two walls
// of one column. OreBuildings places it.

using box.transform
using box.geometry
using box.material

const steelShade: Rgb = {177, 182, 193}
const steelDeep: Rgb = {129, 135, 148}
const concrete: Rgb = {187, 184, 178}
const concreteShade: Rgb = {159, 157, 154}

prefab WallSegment {
  plinth {
    Position: {0, 0.14, 0}
    Box: {1.06, 0.28, 0.92}
    Rgb: concrete
    PbrMaterial: {metallic: 0, roughness: 0.94}
  }

  kerb {
    Position: {0, 0.31, 0}
    Box: {1.06, 0.06, 0.84}
    Rgb: concreteShade
    PbrMaterial: {metallic: 0.1, roughness: 0.8}
  }

  panel {
    Position: {0, 0.61, 0}
    Box: {1.06, 0.54, 0.78}
    Rgb: steelDeep
    PbrMaterial: {metallic: 0.55, roughness: 0.45}
  }

  rib_a {
    Position: {-0.34, 0.61, 0}
    Box: {0.1, 0.5, 0.9}
    Rgb: steelShade
    PbrMaterial: {metallic: 0.6, roughness: 0.4}
  }

  rib_b {
    Position: {0, 0.61, 0}
    Box: {0.1, 0.5, 0.9}
    Rgb: steelShade
    PbrMaterial: {metallic: 0.6, roughness: 0.4}
  }

  rib_c {
    Position: {0.34, 0.61, 0}
    Box: {0.1, 0.5, 0.9}
    Rgb: steelShade
    PbrMaterial: {metallic: 0.6, roughness: 0.4}
  }

  rail {
    Position: {0, 0.94, 0}
    Box: {1.06, 0.12, 0.86}
    Rgb: steelShade
    PbrMaterial: {metallic: 0.6, roughness: 0.4}
  }

  trim : HazardTrimShort {
    Position: {0, 1.03, 0}
  }
}

  // at most powerBars in total; the demand is the consumers' watts times the bars assigned /
  // powerBars, and a category runs at its level times powerStep (0, 0.5, 1, 1.5, 2)
  export const powerBars: i32 = 6
  export const powerStep: f32 = 0.5

  // A drill adds dt * drillSpeed times the Mining multiplier to its timer
  export const drillSpeed: f32 = 1
>>>>>>> 9cd93619de444074b2d548096e1fb906cb9dded3

  // Walking speed in units per second, and its multiplier while the run key is held
  export const walkSpeed: f32 = 7
  export const runMultiplier: f32 = 2

  // The zoom levels of the camera, from 0 (closest, 44.6 degrees down) to 2 (59.5 degrees):
  // the camera sits height above the ground and back behind the astronaut and looks at the
  // point look above it
  export const zoom: OreZoom = {
    height: [15, 26.3, 38.9],
    back: [14, 18.7, 20.7],
    look: [1.2, 2.5, 3.8]
  }

  // The camera covers cameraGlide * dt of the distance to its target every frame
  export const cameraGlide: f32 = 5

  // Seconds of play a warning toast and any other toast are shown
  export const warnToast: f32 = 2.5
  export const infoToast: f32 = 4

  // The blink signals: fast is sin(elapsed * blinkFast) > 0, slow sin(elapsed * blinkSlow) > 0,
  // and the lamp is on for the first half of every 1 / lampRate seconds
  export const blinkFast: f32 = 8
  export const blinkSlow: f32 = 6
  export const lampRate: f32 = 1.4

  // The flash light of an explosion (ore_explosion, BoomBurst) at scale 1: its peak intensity
  // and its range, both times the scale of the blast. It fades to 0 over 1 / 4.5 s, the
  // EffectFlash of BoomBurst, so it fades at 9 * 4.5 times the scale a second as the original's
  export const explosionPeak: f32 = 9
  export const explosionRange: f32 = 13

  // The combust of a critter of body radius r (ore_combust, CombustBurst), r clamped to
  // [combustRadiusMin, combustRadiusMax]: it plays combustLift * r above the critter's position,
  // its sizes and speeds at sqrt(r) and its spawn volumes and offsets at r. Its flash light peaks
  // at combustPeak * sqrt(r) and reaches combustRange + combustRangeRadius * r; it fades to 0
  // over 1 / 7 s, the EffectFlash of CombustBurst
  export const combustRadiusMin: f32 = 0.1
  export const combustRadiusMax: f32 = 4
  export const combustLift: f32 = 0.9
  export const combustPeak: f32 = 4.5
  export const combustRange: f32 = 3
  export const combustRangeRadius: f32 = 4

  // The astronaut's hit points. Any damage starts its hurt timer over; after playerRegenDelay
  // seconds without damage it regenerates playerRegen hit points a second up to the maximum
  export const playerHp: f32 = 100
  export const playerRegen: f32 = 2
  export const playerRegenDelay: f32 = 5

  // The waves: the first starts firstWaveAt seconds into the run, every next one waveGap seconds
  // after the last critter of the previous one spawned. Wave w has a budget of
  // waveBudgetBase * waveBudgetGrowth ^ (w - 1), spent on at most waveUnitCap critters, at most
  // waveBehemothCap of them behemoths. The costs and the first waves of the tiers are on the
  // critter prefabs (OreWaveTier)
  export const firstWaveAt: f32 = 90
  export const waveGap: f32 = 50
  export const waveBudgetBase: f32 = 2
  export const waveBudgetGrowth: f32 = 1.3
  export const waveUnitCap: i32 = 10000
  export const waveBehemothCap: i32 = 25

  // The style of a wave, one draw per wave: below swarmChance a swarm, below swarmChance +
  // eliteChance an elite wave, otherwise mixed. A style's mix is the share of the budget of
  // every tier, mite, skitter, brute and behemoth (the order of OreArsenal)
  export const swarmChance: f32 = 0.25
  export const eliteChance: f32 = 0.25
  export const mixedMix: OreWaveMix = {tier: [0.25, 0.25, 0.25, 0.25]}
  export const swarmMix: OreWaveMix = {tier: [0.7, 0.2, 0.1, 0]}
  export const eliteMix: OreWaveMix = {tier: [0.05, 0.15, 0.55, 0.25]}

  // The spawns of a wave: one every min(spawnStagger, spawnWindow / count) seconds, the first at
  // once, on a side of the map edgeInset inside the edge tiles, edgeSpawnJitter off on both axes
  export const spawnStagger: f32 = 0.45
  export const spawnWindow: f32 = 20
  export const edgeInset: f32 = 1
  export const edgeSpawnJitter: f32 = 5

  // A critter goes for the astronaut within aggroRange, unless a building is closer, and looks
  // for a target again every retargetInterval * U(0.75, 1.25) seconds. It walks critterJitter
  // times its heading jitter radians off the direction to its goal, and the building on the tile
  // wallProbe ahead becomes its target
  export const aggroRange: f32 = 14
  export const retargetInterval: f32 = 0.5
  export const critterJitter: f32 = 0.22
  export const wallProbe: f32 = 1.2

  // The crowd separation and the critter spatial index: cells of crowdCell, at most crowdBucket
  // critters of a cell looked at and the crowdNeighbors most overlapping pairs of a critter kept
  // (up to 12, ORE_CROWD_NEAR). A critter's push is scaled by crowdPush * dt and moves it at
  // most crowdMaxSpeed * dt
  export const crowdCell: f32 = 1.6
  export const crowdPush: f32 = 30
  export const crowdMaxSpeed: f32 = 14
  export const crowdNeighbors: i32 = 6
  export const crowdBucket: i32 = 12

  // The walk of a critter (OreCritterFx): its walk cycle advances its OreGait.step radians per
  // unit walked and stands still while it attacks; it waddles critterWaddle * sin(cycle / 2)
  // radians about z, and its legs swing at critterAttackSwing of their swing while it attacks
  export const critterWaddle: f32 = 0.07
  export const critterAttackSwing: f32 = 0.35

  // The death of a critter: a critter without a death burst splats splatLift above its feet.
  // Its corpse lies corpseTime seconds, then sinks at corpseSink units a second until it is
  // 2 r + 1 below the ground, r its radius; at most corpseCap corpses, the oldest goes first.
  // The corpse is tipped corpseTip + U(0, corpseTipJitter) radians about x and rolled
  // (U(0, 1) - 0.5) * corpseRoll about z before it turns to the critter's heading (the
  // original's Euler order x y z), squashed to corpseSquash of its height and charred with the
  // tint corpseColor
  export const splatLift: f32 = 0.6
  export const corpseTime: f32 = 4
  export const corpseSink: f32 = 0.7
  export const corpseCap: i32 = 100
  export const corpseTip: f32 = 1.1
  export const corpseTipJitter: f32 = 0.2
  export const corpseRoll: f32 = 0.8
  export const corpseSquash: f32 = 0.55
  export const corpseColor: Tint = {40, 36, 34, 255}

  // The render quality tiers Low, Medium and High (OreQuality.tier), the quality.flecs of the
  // original: the resolution scale of the surfaces (2 renders at half the pixels), the shadow
  // map resolution and distance of the world view, and whether its Gtao and Bloom run
  export const quality: OreQualityTiers = {
    resolution_scale: [2, 1, 1],
    shadow_resolution: [1024, 2048, 4096],
    shadow_distance: [91, 140, 140],
    gtao: [false, false, true],
    bloom: [false, true, true]
  }
}

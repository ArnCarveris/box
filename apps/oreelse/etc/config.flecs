// Constants of the game. The oreelse systems read them as cfg.<name>, once per run of a system.

using box.types
using box.material
using oreelse

cfg {
  // The map: rows by cols tiles with an edge of tile units. Tile (row, col) is centered at
  // x = x0 + col * tile, z = z0 + row * tile, so the centers span -47 to 47 and the world
  // origin is the corner of tiles (23, 23), (23, 24), (24, 23) and (24, 24)
  export const rows: i32 = 48
  export const cols: i32 = 48
  export const tile: f32 = 2
  export const x0: f32 = -47
  export const z0: f32 = -47

  // The astronaut stays within [-mapClamp, mapClamp] on x and z, the centers of the edge tiles
  export const mapClamp: f32 = 47

  // Ore of a new deposit, its amount and its capacity
  export const depositAmount: i32 = 1000

  // A plant of the flora under a building sinks floraSink units below the ground, out of sight,
  // until the building is gone
  export const floraSink: f32 = 8

  // The astronaut mines a tile whose center is at most reach away on x and z, and places a
  // building whose footprint (the rectangle of its tile centers) is at most reach away
  export const reach: f32 = 15

  // Seconds a swing at a building takes to demolish it
  export const dozeTime: f32 = 0.8

  // A placement drag covers at most dragMax cells (up to 64, ORE_DRAG_MAX)
  export const dragMax: i32 = 64

  // The preview of placement: the tile markers of a cell at previewMarkerY, the ghost of the
  // building at ghostY and ghostScale, tinted ghostGood on a cell that can be placed and ghostBad
  // on one that cannot, at ghostOpacity (the original's alpha 118 of 255)
  export const previewMarkerY: f32 = 0.12
  export const ghostY: f32 = 0.1
  export const ghostScale: f32 = 0.86
  export const ghostGood: Tint = {206, 242, 255, 255}
  export const ghostBad: Tint = {252, 174, 165, 255}
  export const ghostOpacity: f32 = 0.4627

  // The jetpack: over a tile with a building the astronaut hovers at hoverHeight, rising at
  // hoverRise and falling back to the ground at hoverFall units a second; above airborne it is
  // in the air
  export const hoverHeight: f32 = 3
  export const hoverRise: f32 = 7
  export const hoverFall: f32 = 5
  export const airborne: f32 = 0.01

  // The walk of the astronaut (OrePlayerFx): its walk cycle (OrePlayerGait) advances its speed
  // times stepRate radians a second, it bobs up to bobHeight above the ground with every step and
  // kicks up FootDust footDustY above the ground at every half step on the ground
  export const stepRate: f32 = 1.6
  export const bobHeight: f32 = 0.07
  export const footDustY: f32 = 0.04

  // The limbs of the astronaut (OreLimb) cover limbBlend * dt of the distance to their pose every
  // frame. In the air they trail airTrail times their swing behind while moving (times the run
  // multiplier while running, at most airTrailMax) and dangle airDangle times their swing at
  // airDangleRate radians a second
  export const limbBlend: f32 = 14
  export const airTrail: f32 = 0.85
  export const airTrailMax: f32 = 1.25
  export const airDangle: f32 = 0.14
  export const airDangleRate: f32 = 1.6

  // The death of the astronaut: SplatBurst plays playerSplatLift above its position and it falls
  // over, turned deathPitch about x (and its yaw dropped, as the original)
  export const playerSplatLift: f32 = 1.1
  export const deathPitch: f32 = 1.5708

  // A deposit shrinks with its ore, to a scale of depositScaleMin + (1 - depositScaleMin) *
  // amount / capacity. Every yield plays MineBurst mineBurstY above its tile and a deposit that
  // is used up PoofBurst depositPoofY above it
  export const depositScaleMin: f32 = 0.55
  export const mineBurstY: f32 = 0.6
  export const depositPoofY: f32 = 0.4

  // A building placed plays PoofBurst placePoofY above the center of its footprint, one
  // demolished demolishPoofY above the tile the swing was at
  export const placePoofY: f32 = 0.4
  export const demolishPoofY: f32 = 0.6

  // The inventory holds at most inventorySlots kinds of items with a count above 0 (up to 15,
  // the slots of OreInventory)
  export const inventorySlots: i32 = 15

  // The order book: at most craftOrders orders, craftEntries crafted items per order,
  // craftHold item kinds held per order (its pool, what it borrows and what it plans) and
  // craftRows queue rows in total, where an order counts max(1, entries); recipes are planned
  // at most craftDepth levels deep. Placing or growing an order that breaks one is refused
  // (orders, entries and rows up to 8, 8 and 16, the arrays of OreCraftBook)
  export const craftOrders: i32 = 8
  export const craftEntries: i32 = 8
  export const craftHold: i32 = 12
  export const craftRows: i32 = 16
  export const craftDepth: i32 = 8

  // Units a batch order (shift) asks for
  export const craftBatch: i32 = 5

  // The rocket: a unit is a cargo bay or the life support. A rocket takes at most maxCargoBays
  // cargo bays and maxLifeSupport life supports, and launches with enginesPerUnit engines and
  // one fuel storage per unit; a cargo bay holds cargoCapacity Luminite
  export const cargoCapacity: i32 = 25
  export const maxCargoBays: i32 = 4
  export const maxLifeSupport: i32 = 1
  export const enginesPerUnit: i32 = 4

  // The launch: the engines fire for ignitionTime seconds, then the rocket climbs, its speed
  // growing by launchAccel units a second every second, until it is launchAltitude up, where it
  // arrives (about 3.65 seconds of ascent)
  export const ignitionTime: f32 = 1.6
  export const launchAccel: f32 = 9
  export const launchAltitude: f32 = 60

  // The look of the launch: the rocket shakes by launchShake radians during the ignition, a
  // FlameBurst and a SmokeBurst play under it every launchFxInterval seconds of the flight, and
  // the clamps of the pad swing out by clampTilt radians from the launch to the arrival
  export const launchShake: f32 = 0.045
  export const launchFxInterval: f32 = 0.08
  export const clampTilt: f32 = 0.6

  // The power allocation: Mining, Weapons and Construction each take a level of 0 to 4 bars,
  // at most powerBars in total; the demand is the consumers' watts times the bars assigned /
  // powerBars, and a category runs at its level times powerStep (0, 0.5, 1, 1.5, 2)
  export const powerBars: i32 = 6
  export const powerStep: f32 = 0.5

  // A drill adds dt * drillSpeed times the Mining multiplier to its timer
  export const drillSpeed: f32 = 1

  // Walking speed in units per second, and its multiplier while the run key is held
  export const walkSpeed: f32 = 7
  export const runMultiplier: f32 = 2

  // The repair drones of a drone pad: they fly at droneSpeed units a second, slowed from 20% to
  // 100% of it within droneEase of their goal, cruise droneCruise above the ground and arrive
  // within droneArrive. A drone repairs droneRepair hit points a second, and every
  // droneHpPerIron hit points one Iron leaves the inventory. Docked or returning, it looks for a
  // target every droneScan seconds
  export const droneSpeed: f32 = 7
  export const droneCruise: f32 = 2.8
  export const droneArrive: f32 = 0.45
  export const droneEase: f32 = 1.8
  export const droneRepair: f32 = 14
  export const droneHpPerIron: f32 = 10
  export const droneScan: f32 = 0.5

  // The look of a drone's flight: it turns toward its goal at most droneTurn radians a second,
  // bobs droneBob up and down at droneBobRate radians of its phase a second while it welds, and
  // its rotors spin up to droneRotor radians a second in flight (alternating directions),
  // gaining or losing droneSpinUp times droneRotor a second, down to 0 docked
  export const droneTurn: f32 = 7
  export const droneBob: f32 = 0.07
  export const droneBobRate: f32 = 3.2
  export const droneRotor: f32 = 34
  export const droneSpinUp: f32 = 2.5

  // The zoom levels of the camera, from 0 (closest, 44.6 degrees down) to 2 (59.5 degrees):
  // the camera sits height above the ground and back behind the astronaut and looks at the
  // point look above it
  export const zoom: OreZoom = {
    height: [15, 26.3, 38.9],
    back: [14, 18.7, 20.7],
    look: [1.2, 2.5, 3.8]
  }

  // The camera covers cameraGlide * dt of the distance to its target every frame
  export const cameraGlide: f32 = 5

  // Seconds of play a warning toast and any other toast are shown
  export const warnToast: f32 = 2.5
  export const infoToast: f32 = 4

  // The blink signals: fast is sin(elapsed * blinkFast) > 0, slow sin(elapsed * blinkSlow) > 0,
  // and the lamp is on for the first half of every 1 / lampRate seconds
  export const blinkFast: f32 = 8
  export const blinkSlow: f32 = 6
  export const lampRate: f32 = 1.4

  // The point light of a status lamp's bulb (the Light template), at statusLampLight while the
  // bulb is lit and 0 in the off half of its blink, reaching statusLampRange. The original's
  // lamps have none; it is kept small, as box's falloff is much brighter close to a light
  export const statusLampLight: f32 = 0.35
  export const statusLampRange: f32 = 1.8

  // The work lights of the buildings (OreWorkLight) cover workLightRate * dt of the distance to
  // their level every frame
  export const workLightRate: f32 = 7

  // The flash light of an explosion (ore_explosion, BoomBurst) at scale 1: its peak intensity
  // and its range, both times the scale of the blast. It fades to 0 over 1 / 4.5 s, the
  // EffectFlash of BoomBurst, so it fades at 9 * 4.5 times the scale a second as the original's
  export const explosionPeak: f32 = 9
  export const explosionRange: f32 = 13

  // The combust of a critter of body radius r (ore_combust, CombustBurst), r clamped to
  // [combustRadiusMin, combustRadiusMax]: it plays combustLift * r above the critter's position,
  // its sizes and speeds at sqrt(r) and its spawn volumes and offsets at r. Its flash light peaks
  // at combustPeak * sqrt(r) and reaches combustRange + combustRangeRadius * r; it fades to 0
  // over 1 / 7 s, the EffectFlash of CombustBurst
  export const combustRadiusMin: f32 = 0.1
  export const combustRadiusMax: f32 = 4
  export const combustLift: f32 = 0.9
  export const combustPeak: f32 = 4.5
  export const combustRange: f32 = 3
  export const combustRangeRadius: f32 = 4

  // The astronaut's hit points. Any damage starts its hurt timer over; after playerRegenDelay
  // seconds without damage it regenerates playerRegen hit points a second up to the maximum
  export const playerHp: f32 = 100
  export const playerRegen: f32 = 2
  export const playerRegenDelay: f32 = 5

  // The waves: the first starts firstWaveAt seconds into the run, every next one waveGap seconds
  // after the last critter of the previous one spawned. Wave w has a budget of
  // waveBudgetBase * waveBudgetGrowth ^ (w - 1), spent on at most waveUnitCap critters, at most
  // waveBehemothCap of them behemoths. The costs and the first waves of the tiers are on the
  // critter prefabs (OreWaveTier)
  export const firstWaveAt: f32 = 90
  export const waveGap: f32 = 50
  export const waveBudgetBase: f32 = 2
  export const waveBudgetGrowth: f32 = 1.3
  export const waveUnitCap: i32 = 10000
  export const waveBehemothCap: i32 = 25

  // The stress test (--stresstest[=N], etc/stresstest.flecs): every run starts stressMinutes
  // minutes in (N when above 0) as a late game base. Its wall rings are the perimeters of rows
  // and columns stressEdge to stressFar and one in, the turret ring two in; a building of its
  // sites goes on the first free cell within stressSearch square shells of its tile; the solar
  // panels fill rings stressSolarInset in from the edge of the map and further in until the
  // production is stressPowerMargin times the watts of the consumers. The astronaut stands on
  // the free tile nearest to (stressCenter, stressCenter), the next wave stressWaveLead away
  export const stressMinutes: f32 = 30
  export const stressEdge: i32 = 10
  export const stressFar: i32 = 37
  export const stressCenter: i32 = 24
  export const stressSearch: i32 = 8
  export const stressSolarInset: i32 = 3
  export const stressPowerMargin: f32 = 1.15
  export const stressWaveLead: f32 = 10

  // The style of a wave, one draw per wave: below swarmChance a swarm, below swarmChance +
  // eliteChance an elite wave, otherwise mixed. A style's mix is the share of the budget of
  // every tier, mite, skitter, brute and behemoth (the order of OreArsenal)
  export const swarmChance: f32 = 0.25
  export const eliteChance: f32 = 0.25
  export const mixedMix: OreWaveMix = {tier: [0.25, 0.25, 0.25, 0.25]}
  export const swarmMix: OreWaveMix = {tier: [0.7, 0.2, 0.1, 0]}
  export const eliteMix: OreWaveMix = {tier: [0.05, 0.15, 0.55, 0.25]}

  // The spawns of a wave: one every min(spawnStagger, spawnWindow / count) seconds, the first at
  // once, on a side of the map edgeInset inside the edge tiles, edgeSpawnJitter off on both axes
  export const spawnStagger: f32 = 0.45
  export const spawnWindow: f32 = 20
  export const edgeInset: f32 = 1
  export const edgeSpawnJitter: f32 = 5

  // A critter goes for the astronaut within aggroRange, unless a building is closer, and looks
  // for a target again every retargetInterval * U(0.75, 1.25) seconds. It walks critterJitter
  // times its heading jitter radians off the direction to its goal, and the building on the tile
  // wallProbe ahead becomes its target
  export const aggroRange: f32 = 14
  export const retargetInterval: f32 = 0.5
  export const critterJitter: f32 = 0.22
  export const wallProbe: f32 = 1.2

  // The crowd separation and the critter spatial index: cells of crowdCell, at most crowdBucket
  // critters of a cell looked at and the crowdNeighbors most overlapping pairs of a critter kept
  // (up to 12, ORE_CROWD_NEAR). A critter's push is scaled by crowdPush * dt and moves it at
  // most crowdMaxSpeed * dt
  export const crowdCell: f32 = 1.6
  export const crowdPush: f32 = 30
  export const crowdMaxSpeed: f32 = 14
  export const crowdNeighbors: i32 = 6
  export const crowdBucket: i32 = 12

  // The walk of a critter (OreCritterFx): its walk cycle advances its OreGait.step radians per
  // unit walked and stands still while it attacks; it waddles critterWaddle * sin(cycle / 2)
  // radians about z, and its legs swing at critterAttackSwing of their swing while it attacks
  export const critterWaddle: f32 = 0.07
  export const critterAttackSwing: f32 = 0.35

  // The death of a critter: a critter without a death burst splats splatLift above its feet.
  // Its corpse lies corpseTime seconds, then sinks at corpseSink units a second until it is
  // 2 r + 1 below the ground, r its radius; at most corpseCap corpses, the oldest goes first.
  // The corpse is tipped corpseTip + U(0, corpseTipJitter) radians about x and rolled
  // (U(0, 1) - 0.5) * corpseRoll about z before it turns to the critter's heading (the
  // original's Euler order x y z), squashed to corpseSquash of its height and charred with the
  // tint corpseColor
  export const splatLift: f32 = 0.6
  export const corpseTime: f32 = 4
  export const corpseSink: f32 = 0.7
  export const corpseCap: i32 = 100
  export const corpseTip: f32 = 1.1
  export const corpseTipJitter: f32 = 0.2
  export const corpseRoll: f32 = 0.8
  export const corpseSquash: f32 = 0.55
  export const corpseColor: Tint = {110, 105, 102, 255}

  // The astronaut's pistol: fully automatic, it fires a Tracer of pistolDamage at pistolSpeed
  // every pistolInterval seconds at the nearest live critter within pistolRange, from pistolY
  // above the astronaut
  export const pistolDamage: f32 = 6
  export const pistolRange: f32 = 9
  export const pistolInterval: f32 = 0.45
  export const pistolSpeed: f32 = 30
  export const pistolY: f32 = 1.3

  // The aim of the weapons: shots and missiles aim turretAimY above a critter's position, the
  // laser beam turretAimPerRadius times the critter's radius above it. The gun turret leads its
  // shots by at most leadCap seconds of the target's walk. A missile turns at most
  // missileTurnRate radians a second (straight at its target within speed / missileTurnRate)
  // and, when its target is gone, takes the nearest live critter within missileReacquire
  export const turretAimY: f32 = 0.6
  export const turretAimPerRadius: f32 = 0.9
  export const leadCap: f32 = 2
  export const missileTurnRate: f32 = 6
  export const missileReacquire: f32 = 6

  // The effects of combat (src/weapons.c, src/buildings.c). The sparks of a laser beam sit back
  // from its end toward the turret by the target's radius (0.5 without one) times
  // turretHitInset, at most halfway. A missile explodes splashBlastLift above where it ends, its BoomBurst scaled
  // clamp(splash radius / splashBlastPer, splashBlastMin, splashBlastMax). A shot that reaches
  // impactY or below throws up its dust and sparks at that height. A destroyed building
  // explodes wreckBlastY above the ground at scale wreckBlastScale
  export const turretHitInset: f32 = 0.9
  export const splashBlastPer: f32 = 5
  export const splashBlastMin: f32 = 0.65
  export const splashBlastMax: f32 = 1.25
  export const splashBlastLift: f32 = 0.2
  export const impactY: f32 = 0.05
  export const wreckBlastY: f32 = 0.55
  export const wreckBlastScale: f32 = 0.8

  // The health bar of a damaged building (etc/ui/health_bar.flecs): hpBarHeight pixels tall,
  // hpBarMargin above the top of the projection of the building's model box and as wide as it,
  // not shown when narrower than hpBarMinWidth. A hpBarBack plate with a 1 pixel hpBarEdge and a
  // fill inset 1 pixel, (width - 2) * frac wide, blended from hpBarMid to hpBarFull by
  // (frac - 0.5) * 2 at half health and above, from hpBarLow to hpBarMid by frac * 2 below.
  // The bar is UI, so its colors keep the original's bytes and the bar blends them as the
  // original (README.md, Colors)
  export const hpBarHeight: f32 = 4
  export const hpBarMargin: f32 = 6
  export const hpBarMinWidth: f32 = 6
  export const hpBarBack: rgba = {14, 12, 16, 200}
  export const hpBarEdge: rgba = {6, 5, 7, 230}
  export const hpBarFull: Rgb = {92, 236, 140}
  export const hpBarMid: Rgb = {240, 176, 58}
  export const hpBarLow: Rgb = {248, 84, 72}

  // The render quality tiers Low, Medium and High (OreQuality.tier), the quality.flecs of the
  // original: the resolution scale of the surfaces (2 renders at half the pixels), the shadow
  // map resolution and distance of the world view, and whether its Gtao and Bloom run
  export const quality: OreQualityTiers = {
    resolution_scale: [2, 1, 1],
    shadow_resolution: [1024, 2048, 4096],
    shadow_distance: [91, 140, 140],
    gtao: [false, false, true],
    bloom: [false, true, true]
  }
}

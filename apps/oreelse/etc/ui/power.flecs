using flecs.script
using box.layout
using box.geometry
using box.material
using box.texture
using box.text
using box.picking
using box.transition
using oreelse

const powerBarWidth: f32 = 54
const powerBarHeight: f32 = 11
const powerBarX: f32 = 10
const powerBarTop: f32 = 40
const powerBarPitch: f32 = 15
const powerColumnWidth: f32 = 74

template PowerBar {
  prop kind: i32 = 0
  prop level: i32 = 1
  prop y: f32 = 0

  mut hover = false

  const motion = OreUiMotion[OreUiMotion].scale
  const alloc = OrePowerAlloc[OrePowerAlloc]
  const tone: i32 = match kind {
    0: alloc.level[0]
    1: alloc.level[1]
    _: alloc.level[2]
  }
  const lit = level <= tone

  const warnColor: Rgb = match hover {
    true: {252, 190, 130}
    false: {240, 152, 72}
  }

  const okColor: Rgb = match hover {
    true: {174, 242, 192}
    false: {124, 226, 148}
  }

  const liveColor: Rgb = match hover {
    true: {156, 246, 238}
    false: {92, 236, 222}
  }

  const offColor: Rgb = match hover {
    true: {44, 48, 54}
    false: {14, 15, 18}
  }

  const litColor: Rgb = match tone {
    1: warnColor
    2: okColor
    _: liveColor
  }

  const barColor: Rgb = match lit {
    true: litColor
    false: offColor
  }

  const barGlow: f32 = match lit {
    true: 0.18
    false: 0
  }

  Interactive
  Cursor: {CursorPointer}
  LayoutItem: {
    h: Left, v: Top, x: powerBarX, y: -y,
    width: {mode: Fixed, value: powerBarWidth}, height: {mode: Fixed, value: powerBarHeight}
  }
  Rect: {1, 1}
  Rgb: barColor
  Emissive: {strength: barGlow, color: litColor}
  Border: {width: 1, radius: 2, color: {52, 56, 62, 255}}
  Transition: [Rgb: {duration: 0.14 * motion}, Emissive: {duration: 0.14 * motion}]

  async {
    while true {
      await on.enter(this)
      hover = true
    }
  }

  async {
    while true {
      await on.leave(this)
      hover = false
    }
  }

  async {
    while true {
      await on.click(this)
      const changed: bool = oreelse.power_set(kind, level)
    }
  }
}

template PowerColumn {
  prop kind: i32 = 0
  prop icon: entity = 0
  prop caption: string = ""
  prop x: f32 = 0

  Layout: {}
  LayoutItem: {
    h: Left, v: Top, x: x,
    width: {mode: Fixed, value: powerColumnWidth}, height: {mode: Fixed, value: 150}
  }

  PowerBar bar_4(kind: kind, level: 4, y: powerBarTop)
  PowerBar bar_3(kind: kind, level: 3, y: powerBarTop + powerBarPitch)
  PowerBar bar_2(kind: kind, level: 2, y: powerBarTop + powerBarPitch * 2)
  PowerBar bar_1(kind: kind, level: 1, y: powerBarTop + powerBarPitch * 3)

  OreGlyph symbol(tex: icon, size: 24, x: 25, y: 104)

  OreText caption_label(
    text: caption, size: 9, font: ui_fonts.label, color: palette.soft,
    width: powerColumnWidth, align: Center, y: 132)
}

template PowerFree {
  const alloc = OrePowerAlloc[OrePowerAlloc]
  const freeBars = cfg.powerBars - alloc.level[0] - alloc.level[1] - alloc.level[2]

  Layout: {direction: Row, spacing: 3, v: Middle}
  LayoutItem: {h: Right, v: Top, x: -12, y: -12}

  OreText word(text: "FREE {freeBars}", size: 11, font: ui_fonts.mono, color: palette.amber)

  gap {
    LayoutItem: {width: {mode: Fixed, value: 4}}
  }

  for i in 0..cfg.powerBars {
    "pip_{i}" {
      const on = i < freeBars
      LayoutItem: {width: {mode: Fixed, value: 5}, height: {mode: Fixed, value: 10}}
      Rect: {1, 1}
      if on {
        Rgb: palette.amber
        Emissive: {strength: 0.5, color: palette.amberGlow}
      } else {
        Rgb: {38, 41, 46}
        Emissive: {strength: 0, color: palette.amberGlow}
      }
      box.spatial.SpatialIgnore
    }
  }
}

using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.effects
using box.layout
using box.text
using box.surface
using box.transition
using oreelse

template OreLineTag {
  prop text: string = ""
  prop color: Rgb = {232, 230, 222}
  prop y: f32 = 0

  Layout: {direction: Row, spacing: 9, v: Middle, padding: {4, 4, 9, 13}}
  Item: {h: Center, v: Bottom, y: y}
  Rect: {1, 1}
  Rgb: {13, 14, 17}
  Border: {width: 1, radius: 2, color: {color.r / 2, color.g / 2, color.b / 2, 255}}

  tick {
    Item: {width: {mode: Fixed, value: 3}, height: {mode: Fixed, value: 15}}
    Rect: {1, 1}
    Rgb: color
    Emissive: {strength: 0.4, color: color}
    box.spatial.Ignore
  }

  OreText line(text: text, size: 15, font: ui_fonts.label, color: color, glow: 0.12)
}

template OreToastLine {
  const toastState = OreToast[OreToast]
  const toastText = toastState.text

  const toastColor: Rgb = match toastState.warn {
    true: palette.red
    false: palette.luminite
  }

  Layout: {}
  Item: {width: {mode: Grow}, height: {mode: Grow}}
  box.spatial.Ignore

  if toastText != "" {
    OreLineTag toast(text: toastText, color: toastColor, y: 150)
  }
}

template OreMineBar {
  const mineProgress: f32 = astronaut[OreMining].progress

  Layout: {}
  Item: {width: {mode: Grow}, height: {mode: Grow}}
  box.spatial.Ignore

  if mineProgress > 0 {
    OreBar mine_bar(
      width: 224, height: 12, frac: mineProgress, color: palette.ore, glow: 0.3, notches: 8,
      seconds: 0, h: Center, v: Bottom, y: -102)
  }
}

template OreBreachAlert {
  const fast = OreBlink[OreBlink].fast
  const health = astronaut[OreHealth]
  const hpFrac: f32 = health.value / health.max

  Layout: {}
  Item: {width: {mode: Grow}, height: {mode: Grow}}
  box.spatial.Ignore

  if hpFrac < 0.3 {
    OreVeil danger(dim: 0, edge: match fast { true: 0.55; _: 0.2 }, color: {210, 24, 16})

    alert {
      Position: {0, 0, 1}
      Layout: {direction: Row, spacing: 8, v: Middle, padding: {4, 4, 9, 11}}
      Item: {h: Center, v: Top, y: -18}
      Rect: {1, 1}
      if fast {
        Rgb: {78, 16, 12}
      } else {
        Rgb: {34, 10, 8}
      }
      Border: {width: 1, radius: 2, color: {236, 84, 70, 255}}

      OreGlyph heart(tex: icons.heart, size: 18)
      OreText word(text: "! SUIT BREACH !", size: 15, font: ui_fonts.stencil, color: palette.red, glow: 0.45)
    }
  }
}

template OreRocketLine {
  const slow = OreBlink[OreBlink].slow
  const rocketState = OreRocketState[OreRocketState]
  const hasPad = rocketState.pad != 0
  const flying = rocketState.phase != Idle
  const valid = rocketState.valid
  const units = rocketState.units
  const engines = rocketState.engines
  const fuel = rocketState.fuel
  const engineNeed = units * cfg.enginesPerUnit

  const fuelText = "Needs {units} fuel tanks, {fuel} installed (Y)"
  const engineText: string = match engines != engineNeed {
    true: "Needs {engineNeed} engines, {engines} installed (T)"
    false: fuelText
  }
  const unitText: string = match units == 0 {
    true: "Install a cargo bay (U) or life support (I)"
    false: engineText
  }
  const readyText: string = match valid {
    true: "Rocket ready to launch (P)"
    false: unitText
  }
  const rocketText: string = match flying {
    true: "LAUNCHING"
    false: readyText
  }

  const readyColor: Rgb = match slow {
    true: {124, 226, 148}
    false: {68, 148, 96}
  }

  const rocketColor: Rgb = match valid {
    true: readyColor
    false: {248, 196, 112}
  }

  Layout: {}
  Item: {width: {mode: Grow}, height: {mode: Grow}}
  box.spatial.Ignore

  if hasPad {
    OreLineTag rocket_line(text: rocketText, color: rocketColor, y: 66)
  }
}

template OreLuminiteGauge {
  const rocketState = OreRocketState[OreRocketState]
  const held = rocketState.held
  const shipped = rocketState.shipped

  Layout: {}
  Item: {h: Left, v: Top, x: 12, y: -11, width: {mode: Fixed, value: 130}, height: {mode: Fixed, value: 38}}

  OreGlyph symbol(tex: icons.luminite, size: 30, y: 4)

  numbers {
    Layout: {direction: Row, spacing: 5, v: Bottom}
    Item: {h: Left, v: Top, x: 37}
    OreText held_label(text: "{held}", size: 22, font: ui_fonts.mono, color: palette.luminite, glow: 0.15)
    OreText shipped_label(text: "/ {shipped}", size: 14, font: ui_fonts.mono, color: palette.soft)
  }

  OreText caption(text: "HELD / SHIPPED", size: 9, font: ui_fonts.label, color: palette.soft, x: 37, y: 26)
}

template OreWaveGauge {
  const fast = OreBlink[OreBlink].fast
  const waveState = OreWaveState[OreWaveState]
  const waveFrac = waveState.frac
  const spawning = waveState.left > 0
  const wave = waveState.wave

  const waveFlash: Rgb = match fast {
    true: {248, 96, 84}
    false: {132, 48, 44}
  }

  const waveSoon: Rgb = match waveFrac > 0.75 {
    true: {240, 152, 72}
    false: palette.violet
  }

  const waveColor: Rgb = match spawning {
    true: waveFlash
    false: waveSoon
  }

  const waveText: string = match spawning {
    true: "WAVE {wave} ATTACKING"
    false: "NEXT WAVE {wave + 1}"
  }

  Layout: {}
  Item: {h: Left, v: Top, x: 158, y: -11, width: {mode: Fixed, value: 170}, height: {mode: Fixed, value: 38}}

  OreGlyph symbol(tex: icons.critter, size: 28, y: 4)
  OreText caption(text: waveText, size: 11, font: ui_fonts.label, color: waveColor, x: 36, y: 3)
  OreBar bar(width: 132, height: 11, frac: waveFrac, color: waveColor, glow: 0.6, notches: 10, seconds: 0.1, x: 36, y: 22)
}

template OrePowerGauge {
  const powerState = OrePowerState[OrePowerState]
  const production = floor(powerState.production)
  const demand = floor(powerState.demand)
  const blackout = powerState.blackout

  const powerColor: Rgb = match blackout {
    true: palette.red
    false: palette.green
  }

  Layout: {}
  Item: {h: Left, v: Top, x: 344, y: -11, width: {mode: Fixed, value: 176}, height: {mode: Fixed, value: 38}}

  OreGlyph symbol(tex: icons.power, size: 26, y: 5)
  OreText readout(text: "{production:.0} / {demand:.0} W", size: 14, font: ui_fonts.mono, color: powerColor, glow: 0.3, x: 34, y: 1)
  OreBar bar(width: 138, height: 11, frac: powerState.ratio, color: powerColor, glow: 0.6, notches: 8, seconds: 0.35, x: 34, y: 22)
}

template OreStatusDivider {
  prop x: f32 = 0

  Item: {
    h: Left, v: Top, x: x, y: -14,
    width: {mode: Fixed, value: 1}, height: {mode: Fixed, value: 32}
  }
  Rect: {1, 1}
  Rgb: palette.divider
  box.spatial.Ignore
}

template OreHudBloom {
  Bloom: {intensity: 0.6, threshold: 0.85, threshold_softness: 0.08}
}

hud_bloom { OreHudBloom }

template OreHud {
  const title = OreGameState?[(OreGameState, Title)]
  const playing = OreGameState?[(OreGameState, Playing)]
  const paused = OreGameState?[(OreGameState, Paused)]
  const live = playing || paused
  const won = OreGameState?[(OreGameState, Won)]
  const lost = OreGameState?[(OreGameState, Lost)]
  const ended = won || lost

  const none: entity = 0
  const inventoryOpen = playing && OreInventoryScreen[OreInventoryScreen].open
  const itemInfo = OreItemInfo[OreItemInfo]
  const hasPad = OreRocketState[OreRocketState].pad != 0
  const rowCount = OreCraftBook[OreCraftBook].row_count
  const lowTier = OreQuality[OreQuality].tier == Low

  const hasStatus = window?[box.surface.Status]
  const isWindow: bool = match hasStatus {
    true: window[box.surface.Status].window
    false: false
  }
  const pointWidth: f32 = match isWindow {
    true: window[box.surface.Status].point_width
    false: window[Surface].width
  }
  const pointHeight: f32 = match isWindow {
    true: window[box.surface.Status].point_height
    false: window[Surface].height
  }
  const screenScale = ore_screen_scale(pointWidth, pointHeight)

  ui {
    Scene: {}

    OreScreenCamera camera(scale: screenScale)

    screen {
      OreScreenRoot: {width: pointWidth / screenScale, height: pointHeight / screenScale}
      Layout: {}

      if live {
        OreBreachAlert breach() {
          Position: {0, 0, -1}
        }
      }

      if !title {
        Panel status(
          width: 532, height: 56, capH: 6, h: Right, v: Top, x: -18, y: -16,
          aura: 0.12) {
          OreLuminiteGauge luminite()
          OreStatusDivider divider_a(x: 150)
          OreWaveGauge wave()
          OreStatusDivider divider_b(x: 336)
          OrePowerGauge power()
        }
      }

      if live {
        OreToastLine toast_line()
        OreMineBar mine_line()
        OreRocketLine rocket_status()
      }

      if playing {
        Panel power_panel(
          width: 264, height: 152, capH: 6, title: "POWER", h: Left, v: Bottom, x: 18, y: 18,
          delay: 0.05) {
          PowerFree free()
          PowerColumn mining(kind: 0, icon: icons.drill, caption: "MINING", x: 12)
          PowerColumn weapons(kind: 1, icon: icons.gun_turret, caption: "WEAPONS", x: 95)
          PowerColumn construction(kind: 2, icon: icons.factory, caption: "CONSTRUCTION", x: 178)
        }
      }

      if playing && rowCount > 0 {
        Panel queue_panel(
          width: 252, height: 42 + rowCount * 28, capH: 6, title: "ORDER QUEUE", h: Right, v: Bottom,
          x: -18, y: 40) {
          Position: {0, 0, 1}
          OreQueueRows rows()
        }
      }

      if playing && hasPad {
        Panel rocket_panel(
          width: 284, height: 366, capH: 6, title: "ROCKET ASSEMBLY", h: Right, v: Top,
          x: -18, y: -80, delay: 0.1) {
          Position: {0, 0, 2}
          OreRocketBody body()
        }
      }

      if playing {
        InventoryButton inventory_button(label: "INVENTORY", action: actions.Inventory)
      }

      if inventoryOpen {
        InventoryScreen inventory() {
          Position: {0, 0, 3}
        }

        if itemInfo.item != none {
          ItemInfoPanel info_panel(item: itemInfo.item, place: itemInfo.place) {
            Position: {0, 0, 4}
          }
        }
      }

      if title {
        OreTitleScreen title_screen() {
          Position: {0, 0, 5}
        }
      }

      if paused {
        OrePauseScreen pause_screen() {
          Position: {0, 0, 5}
        }
      }

      if ended {
        OreEndScreen end_screen() {
          Position: {0, 0, 5}
        }
      }
    }
  }

  view {
    View: {
      camera: ui.camera,
      lighting: {enabled: false},
      culling: {enabled: false},
      effects: [{enabled: !lowTier, effect: hud_bloom}]
    }
  }
}

using flecs.script.math
using box.types
using box.transform
using box.layout
using box.geometry
using box.material
using box.text
using box.texture
using box.transition
using box.picking
using oreelse

const panelRadius: f32 = 3
const stripWidth: f32 = 2048
const stripHeight: f32 = 12

template Panel : OreOneShot {
  prop width: f32 = 252
  prop height: f32 = 100
  prop title: string = ""
  prop cap: bool = true
  prop capH: f32 = 7
  prop fill: rgba = {24, 26, 30, 244}
  prop edge: rgba = {78, 82, 88, 255}
  prop glow: Rgb = {240, 176, 58}
  prop aura: f32 = 0.1
  prop block: bool = true
  prop brackets: bool = true
  prop h: Align = Left
  prop v: VAlign = Top
  prop x: f32 = 0
  prop y: f32 = 0
  prop delay: f32 = 0

  const motion = OreUiMotion[OreUiMotion].scale
  const shown = fired || motion == 0
  const scale = max(width / stripWidth, capH / stripHeight)
  const spanU = width / (stripWidth * scale)
  const spanV = capH / (stripHeight * scale)
  const bx = width / 2 - 10
  const by = height / 2 - 10
  const top: f32 = match cap { true: capH; _: 0 }

  Layout: {}
  LayoutItem: {
    h: h, v: v, x: x, y: y,
    width: {mode: Fixed, value: width}, height: {mode: Fixed, value: height}
  }
  Opacity: {match shown { true: 1; _: 0 }}
  Transition: [Opacity: {duration: 0.28 * motion, delay: delay * motion}]

  if block {
    InputBlocker
  }

  shadow {
    Position: {0, -4, -6}
    Rect: {width * 1.1 + 56, height * 1.1 + 56}
    Image: {texture: ui_art.halo}
    Rgb: {0, 0, 0}
    Opacity: {0.7}
    box.spatial.SpatialIgnore
  }

  OreHalo rim(size: width + 44, height: height + 44, color: glow, alpha: aura, z: -5)

  chrome {
    Position: {0, 0, -4}
    Layout: {}
    LayoutItem: {
      h: Left, v: Top,
      width: {mode: Fixed, value: width}, height: {mode: Fixed, value: height}
    }
    Border: {radius: panelRadius}
    ClipChildren

    plate {
      Position: {0, 0, 0}
      LayoutItem: {
        h: Left, v: Top,
        width: {mode: Fixed, value: width}, height: {mode: Fixed, value: height}
      }
      Rect: {1, 1}
      Image: {texture: ui_art.plate}
      Rgb: {fill.r, fill.g, fill.b}
      Opacity: {fill.a / 255.0}
      Border: {width: 1, radius: panelRadius, color: edge}
    }

    if cap {
      strip {
        Position: {0, 0, 1}
        LayoutItem: {
          h: Left, v: Top,
          width: {mode: Fixed, value: width}, height: {mode: Fixed, value: capH}
        }
        Rect: {1, 1}
        Rgb: {255, 255, 255}
        Image: {
          texture: ui_art.hazard,
          u0: 0.5 - spanU / 2, v0: 0.5 - spanV / 2, u1: 0.5 + spanU / 2, v1: 0.5 + spanV / 2
        }
        box.spatial.SpatialIgnore
      }
    }

    OreRule sheen(width: width - 2, x: 1, y: top + 1, color: {96, 100, 106}) {
      Position: {0, 0, 2}
      Opacity: {0.5}
    }
  }

  if brackets {
    bracket_bl {
      Position: {-bx, -by, -3}
      Rotation: {0, 0, PI / 2}
      Rect: {12, 12}
      Image: {texture: ui_art.bracket}
      Rgb: {edge.r, edge.g, edge.b}
      box.spatial.SpatialIgnore
    }

    bracket_br {
      Position: {bx, -by, -3}
      Rotation: {0, 0, PI}
      Rect: {12, 12}
      Image: {texture: ui_art.bracket}
      Rgb: {edge.r, edge.g, edge.b}
      box.spatial.SpatialIgnore
    }
  }

  if title != "" {
    OreText heading(
      text: title, size: 15, font: ui_fonts.stencil, color: palette.amber, glow: 0.35,
      glowColor: palette.amberGlow, x: 12, y: top + 5)
    OreRule heading_rule(width: width - 24, x: 12, y: top + 26)
  }
}

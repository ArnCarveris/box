// The colors of the UI, the original's palette, as palette.<name>: the text, the muted text,
// the accents, the wells of the bars and the dividers.

using box.material

palette {
  // Text and muted text
  export const text: Rgb = {242, 244, 247}
  export const soft: Rgb = {199, 204, 211}

  // Accents: amber, red (warnings, a short supply), green (fine, in supply)
  export const amber: Rgb = {248, 216, 131}
  export const red: Rgb = {243, 165, 155}
  export const green: Rgb = {185, 242, 200}

  // Luminite and the other ores
  export const luminite: Rgb = {165, 248, 238}
  export const ore: Rgb = {246, 216, 171}

  // The empty part of a bar and the lines between the groups of a panel
  export const well: Rgb = {64, 66, 73}
  export const divider: Rgb = {135, 141, 150}
}

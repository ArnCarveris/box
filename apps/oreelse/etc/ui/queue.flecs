using flecs.script
using flecs.script.math
using box.layout
using box.transform
using box.geometry
using box.material
using box.texture
using box.text
using box.picking
using oreelse

const queueRowWidth: f32 = 228
const queueRowHeight: f32 = 26
const queueRowPitch: f32 = 28
const queueRowX: f32 = 12
const queueRowY: f32 = 37
const queueIndent: f32 = 16
const queueContentZ: f32 = 3

template QueueRow {
  prop row: i32 = 0
  prop order: i32 = 0
  prop icon: entity = 0
  prop label: string = ""
  prop sub: bool = false
  prop count: i32 = 0
  prop active: bool = false
  prop progress: f32 = 0
  prop stalled: bool = false

  mut hover = false

  const header = !sub
  const hot = hover && header && count > 0
  const f: f32 = clamp(progress, 0, 1)

  const indent: f32 = match sub {
    true: queueIndent
    false: 0
  }

  const labelTone: Rgb = match sub {
    true: palette.soft
    false: palette.text
  }

  const stalledTone: Rgb = match active {
    true: {255, 214, 204}
    false: palette.red
  }

  const activeTone: Rgb = match active {
    true: palette.amberPale
    false: labelTone
  }

  const labelColor: Rgb = match stalled {
    true: stalledTone
    false: activeTone
  }

  const fillColor: Rgb = match stalled {
    true: {92, 30, 24}
    false: {92, 66, 20}
  }

  const glowColor: Rgb = match stalled {
    true: palette.red
    false: palette.amber
  }

  Layout: {}
  LayoutItem: {
    h: Left, v: Top, x: queueRowX, y: -(queueRowY + row * queueRowPitch),
    width: {mode: Fixed, value: queueRowWidth}, height: {mode: Fixed, value: queueRowHeight}
  }

  if header {
    Interactive
    Cursor: {CursorPointer}
  }

  if hot {
    Rect: {1, 1}
    Rgb: {54, 30, 28}
    Border: {width: 1, radius: 2, color: {236, 84, 70, 255}}
  } else if active {
    Rect: {1, 1}
    Rgb: palette.well
    Border: {radius: 2}
  } else if header {
    Rect: {1, 1}
    Rgb: {30, 32, 37}
    Border: {radius: 2}
  }

  if active {
    fill {
      Position: {(f - 1) * queueRowWidth / 2, 0, 1}
      Scale: {max(f, 0.005), 1, 1}
      Rect: {queueRowWidth, queueRowHeight}
      Rgb: fillColor
      box.spatial.SpatialIgnore
    }

    edge {
      Position: {(f - 0.5) * queueRowWidth, 0, 2}
      Rect: {2, queueRowHeight}
      Rgb: glowColor
      Emissive: {strength: 0.5, color: glowColor}
      box.spatial.SpatialIgnore
    }
  }

  if sub {
    tick {
      Position: {0, 0, queueContentZ}
      LayoutItem: {
        h: Left, v: Top, x: 7, y: -12,
        width: {mode: Fixed, value: 7}, height: {mode: Fixed, value: 2}
      }
      Rect: {1, 1}
      Rgb: palette.faint
      box.spatial.SpatialIgnore
    }
  }

  if icon != 0 {
    OreGlyph symbol(tex: icon, size: 20, x: 4 + indent, y: 3) {
      Position: {0, 0, queueContentZ}
    }
  }

  OreText name_label(text: label, size: 13, color: labelColor, x: 30 + indent, y: 4) {
    Position: {0, 0, queueContentZ}
  }

  if hot {
    cancel_a {
      Position: {queueRowWidth / 2 - 13, 0, queueContentZ}
      Line: {-4, -4, 4, 4, width: 2}
      Rgb: palette.red
      box.spatial.SpatialIgnore
    }

    cancel_b {
      Position: {queueRowWidth / 2 - 13, 0, queueContentZ}
      Line: {-4, 4, 4, -4, width: 2}
      Rgb: palette.red
      box.spatial.SpatialIgnore
    }
  }

  async {
    while true {
      await on.enter(this)
      hover = true
    }
  }

  async {
    while true {
      await on.leave(this)
      hover = false
    }
  }

  async {
    while true {
      await on.click(this)
      if header && count > 0 {
        const cancelled: bool = oreelse.craft_cancel(order)
      }
    }
  }
}

template OreQueueRows {
  const book = OreCraftBook[OreCraftBook]
  const rowCount = book.row_count

  Layout: {}
  LayoutItem: {
    h: Left, v: Top,
    width: {mode: Grow, content_min: false}, height: {mode: Grow, content_min: false}
  }

  for i in 0..rowCount {
    const r = book.rows[i]
    const thing: entity = r.item
    const itemName = thing[OreItem].name
    const countText = "{itemName} ({r.count}x)"
    const fullText: string = match r.full {
      true: " - inventory full"
      false: ""
    }
    const doneText: string = match r.full {
      true: "{itemName} - inventory full"
      false: "{itemName} - wrapping up"
    }
    const rowText: string = match r.sub || r.count > 0 {
      true: "{countText}{fullText}"
      false: doneText
    }

    QueueRow "row_{r.order}_{thing.name()}"(
      row: i, order: r.order, icon: thing[OreIcon].texture, label: rowText,
      sub: r.sub, count: r.count, active: r.active, progress: r.progress,
      stalled: r.stalled)
  }
}

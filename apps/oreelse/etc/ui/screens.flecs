using flecs.script
using flecs.script.math
using box.app
using box.types
using box.layout
using box.transform
using box.geometry
using box.material
using box.texture
using box.text
using box.input
using box.picking
using box.movement
using box.transition
using oreelse

ui_signs {
  mine { Path: {path: "apps/oreelse/etc/ui/signs/mine.svg", width: 512, height: 512} }
  defend { Path: {path: "apps/oreelse/etc/ui/signs/defend.svg", width: 512, height: 512} }
  escape { Path: {path: "apps/oreelse/etc/ui/signs/escape.svg", width: 512, height: 512} }
}

const keyWidth: f32 = 92
const actionWidth: f32 = 306
const signWidth: f32 = 244
const signHeight: f32 = 196
const signArt: f32 = 122

template OreControl {
  prop key: string = ""
  prop action: string = ""

  Layout: {direction: Row, spacing: 12, v: Middle}

  OreKeyCap cap(key: key, width: keyWidth, height: 20, size: 12)
  OreText action_label(text: action, size: 14, color: palette.soft, width: actionWidth)
}

template OreControls {
  Layout: {direction: Row, spacing: 24}

  left {
    Layout: {direction: Column, spacing: 6}
    OreControl walk(key: "W A S D", action: "Walk")
    OreControl run(key: "Shift", action: "Walk faster")
    OreControl zoom(key: "Mouse wheel", action: "Zoom in/out")
    OreControl place(key: "Left click", action: "Place selected building")
  }

  right {
    Layout: {direction: Column, spacing: 6}
    OreControl demolish(key: "Right click", action: "Demolish/mine object under mouse cursor")
    OreControl inventory(key: "E", action: "Open / close the inventory")
    OreControl pick(key: "Q", action: "Select the building under the cursor / deselect")
    OreControl cancel(key: "ESC", action: "Cancel / Pause")
  }
}

template OrePulseText {
  prop text: string = ""
  prop size: f32 = 16
  prop color: Rgb = {232, 230, 222}
  prop font: entity = ui_fonts.stencil

  const motion = OreUiMotion[OreUiMotion].scale
  const beat: i32 = floor(AppStatus[AppStatus].elapsed * 1.25)
  const bright = motion == 0 || beat % 2 == 0

  Text: {value: text, size: size, font: font}
  Rgb: color
  if bright {
    Opacity: {1}
  } else {
    Opacity: {0.35}
  }
  Transition: [Opacity: {duration: 0.7 * motion, timing_function: EaseInOut}]
  box.spatial.Ignore
}

template OreLogoGlyph : OreOneShot {
  prop letter: string = ""
  prop index: i32 = 0

  const motion = OreUiMotion[OreUiMotion].scale
  const shown = fired || motion == 0
  const delay: f32 = (0.1 + index * 0.075) * motion
  const k: f32 = match shown { true: 1; _: 1.3 }
  const a: f32 = match shown { true: 1; _: 0 }
  const e: f32 = match shown { true: 1.4; _: 3.5 }

  Scale: {k, k, 1}
  Opacity: {a}
  Text: {value: letter, size: 104, font: ui_fonts.stencil}
  Rgb: palette.amber
  Emissive: {strength: e, color: palette.amberGlow}
  Transition: [
    Scale: {duration: 0.7 * motion, delay: delay, timing_function: EaseOut},
    Opacity: {duration: 0.45 * motion, delay: delay, timing_function: EaseOut},
    Emissive: {duration: 1.4 * motion, delay: delay, timing_function: EaseOut}
  ]
  box.spatial.Ignore
}

template OreLogo {
  Layout: {}
  Item: {width: {mode: Fixed, value: 860}, height: {mode: Fixed, value: 108}}

  OreHalo glow(size: 860, height: 280, color: {255, 130, 30}, alpha: 0.22, z: -1)

  letters {
    Position: {0, 0, 1}
    Layout: {direction: Row, v: Middle, h: Center}
    Item: {width: {mode: Grow}, height: {mode: Grow}}

    OreLogoGlyph g0(letter: "O", index: 0)
    OreLogoGlyph g1(letter: "R", index: 1)
    OreLogoGlyph g2(letter: "E", index: 2)
    gap {
      Item: {width: {mode: Fixed, value: 36}}
    }
    OreLogoGlyph g3(letter: "E", index: 3)
    OreLogoGlyph g4(letter: "L", index: 4)
    OreLogoGlyph g5(letter: "S", index: 5)
    OreLogoGlyph g6(letter: "E", index: 6)
  }
}

template OreSign : OreOneShot {
  prop label: string = ""
  prop color: Rgb = {232, 230, 222}
  prop art: entity = 0
  prop index: i32 = 0

  const motion = OreUiMotion[OreUiMotion].scale
  const shown = fired || motion == 0
  const delay: f32 = (0.55 + index * 0.13) * motion
  const a: f32 = match shown { true: 1; _: 0 }

  Layout: {}
  Item: {width: {mode: Fixed, value: signWidth}, height: {mode: Fixed, value: signHeight}}
  Opacity: {a}
  Transition: [Opacity: {duration: 0.4 * motion, delay: delay}]

  Panel card(
    width: signWidth, height: signHeight, capH: 6, block: false, glow: color, aura: 0.3,
    edge: {color.r, color.g, color.b, 255}, fill: {26, 28, 32, 255}) {
    OreGlyph art_image(tex: art, size: signArt, h: Center, y: 14)
    OreText label_text(
      text: label, size: 32, font: ui_fonts.stencil, color: color, glow: 0.12,
      width: signWidth, align: Center, y: 146)
  }
}

template OreTitleScreen {
  const veilEdge: f32 = 0.95

  Layout: {}
  Item: {width: {mode: Grow}, height: {mode: Grow}}

  OreVeil veil(dim: 0.52, edge: veilEdge)

  column {
    Position: {0, 0, 2}
    Layout: {direction: Column, h: Center, v: Middle, spacing: 14}
    Item: {width: {mode: Grow}, height: {mode: Grow}}

    OreLogo logo()
    OreHazardRule rule(width: 620, height: 6)
    OreText tagline(
      text: "You crash-landed on a hostile planet.", size: 18, font: ui_fonts.label,
      color: palette.text)

    signs {
      Layout: {direction: Row, spacing: 22}
      OreSign mine(label: "MINE", color: palette.ore, art: ui_signs.mine, index: 0)
      OreSign defend(label: "DEFEND", color: palette.red, art: ui_signs.defend, index: 1)
      OreSign escape(label: "ESCAPE", color: palette.luminite, art: ui_signs.escape, index: 2)
    }

    OreText goal(
      text: "Collect luminite, ship it off planet with rockets, defend the base against attacks,\nescape before the waves get too strong.",
      size: 15, color: palette.text, width: 760, align: Center)

    OreControls controls()

    OrePulseText start(text: "PRESS ANY KEY TO START", size: 18, color: palette.amber)
  }
}

template OreQualityValue {
  const tier = OreQuality[OreQuality].tier
  const level: i32 = match tier { Low: 1; Medium: 2; _: 3 }
  const mediumText: string = match tier == Medium {
    true: "MEDIUM"
    false: "HIGH"
  }
  const tierText: string = match tier == Low {
    true: "LOW"
    false: mediumText
  }

  Layout: {direction: Row, spacing: 3, v: Middle}

  for i in 0..3 {
    "led_{i}" {
      const on = i < level
      Item: {width: {mode: Fixed, value: 6}, height: {mode: Fixed, value: 12}}
      Rect: {1, 1}
      if on {
        Rgb: palette.amber
        Emissive: {strength: 0.5, color: palette.amberGlow}
      } else {
        Rgb: {38, 41, 46}
        Emissive: {strength: 0, color: palette.amberGlow}
      }
      box.spatial.Ignore
    }
  }

  gap {
    Item: {width: {mode: Fixed, value: 4}}
  }

  OreText tier_name(text: tierText, size: 13, font: ui_fonts.mono, color: palette.amber, width: 48)
}

template OreQualityButton {
  mut hover = false

  const motion = OreUiMotion[OreUiMotion].scale
  const buttonWidth: f32 = 212
  const buttonHeight: f32 = 30

  ActionTrigger: {action: actions.Quality}
  Cursor: {CursorPointer}
  Layout: {direction: Row, spacing: 12, h: Center, v: Middle}
  Item: {width: {mode: Fixed, value: buttonWidth}, height: {mode: Fixed, value: buttonHeight}}
  Rect: {1, 1}
  if hover {
    Rgb: {66, 58, 38}
    Border: {width: 1, radius: 3, color: {240, 176, 58, 255}}
  } else {
    Rgb: {30, 32, 37}
    Border: {width: 1, radius: 3, color: {78, 82, 88, 255}}
  }
  Transition: [Rgb: {duration: 0.12 * motion}]

  OreText caption(text: "QUALITY", size: 12, font: ui_fonts.label, color: palette.soft)
  OreQualityValue value()

  async {
    while true {
      await on.enter(this)
      hover = true
      await on.leave(this)
      hover = false
    }
  }
}

template OrePauseScreen {
  const panelWidth: f32 = 880
  const panelHeight: f32 = 320

  Layout: {}
  Item: {width: {mode: Grow}, height: {mode: Grow}}

  OreVeil veil(dim: 0.3, edge: 0.8)

  Panel panel(
    width: panelWidth, height: panelHeight, capH: 8, block: false, h: Center, v: Middle, y: 40,
    aura: 0.14) {
    Position: {0, 0, 2}
    column {
      Layout: {direction: Column, h: Center, v: Middle, spacing: 16}
      Item: {
        h: Left, v: Top,
        width: {mode: Fixed, value: panelWidth}, height: {mode: Fixed, value: panelHeight}
      }

      OreText heading(text: "PAUSED", size: 44, font: ui_fonts.stencil, color: palette.amber, glow: 0.35, glowColor: palette.amberGlow)
      OreQualityButton quality()
      OreControls controls()
      OreText resume(text: "Press ESC to resume", size: 14, font: ui_fonts.label, color: palette.soft)
    }
  }
}

template OreStatTile {
  prop value: string = ""
  prop caption: string = ""
  prop color: Rgb = {232, 230, 222}

  const tileWidth: f32 = 176
  const tileHeight: f32 = 88

  Layout: {direction: Column, h: Center, v: Middle, spacing: 2}
  Item: {width: {mode: Fixed, value: tileWidth}, height: {mode: Fixed, value: tileHeight}}
  Rect: {1, 1}
  Rgb: palette.well
  Border: {width: 1, radius: 3, color: {color.r / 2, color.g / 2, color.b / 2, 255}}
  box.spatial.Ignore

  OreText amount(text: value, size: 34, font: ui_fonts.mono, color: color, glow: 0.5)
  OreText name(text: caption, size: 11, font: ui_fonts.label, color: palette.soft)
}

template OreEndRays : OreOneShot {
  prop color: Rgb = {255, 255, 255}

  const motion = OreUiMotion[OreUiMotion].scale
  const shown = fired || motion == 0
  const a: f32 = match shown { true: 0.075; _: 0 }

  Position: {0, 62, 1}
  Rect: {1300, 1300}
  Image: {texture: ui_art.rays}
  Rgb: color
  Opacity: {a}
  BlendMode: Additive
  AngularVelocity: {0, 0, 0.07}
  Transition: [Opacity: {duration: 1.4 * motion}]
  box.spatial.Ignore
}

template OreEndScreen {
  const won = OreGameState?[(OreGameState, Won)]
  const shipped = OreRocketState[OreRocketState].shipped
  const waveState = OreWaveState[OreWaveState]
  const kills = waveState.kills
  const wave = waveState.wave
  const elapsed = OreClock[OreClock].elapsed
  const minutes = floor(elapsed / 60)
  const seconds = floor(elapsed) % 60

  const headingText: string = match won {
    true: "YOU ESCAPED"
    false: "THE SWARM GOT YOU"
  }

  const tone: Rgb = match won {
    true: palette.luminite
    false: palette.red
  }

  const veilTone: Rgb = match won {
    true: {0, 0, 0}
    false: {60, 4, 2}
  }

  Layout: {}
  Item: {width: {mode: Grow, content_min: false}, height: {mode: Grow, content_min: false}}

  OreVeil veil(dim: 0.5, edge: 0.95, color: veilTone)
  if won {
    OreEndRays rays(color: tone)
  }

  column {
    Position: {0, 0, 2}
    Layout: {direction: Column, h: Center, v: Middle, spacing: 18}
    Item: {width: {mode: Grow}, height: {mode: Grow}}

    OreText heading(text: headingText, size: 72, font: ui_fonts.stencil, color: tone, glow: 0.5)
    OreHazardRule rule(width: 620, height: 6)

    tiles {
      Layout: {direction: Row, spacing: 12}
      OreStatTile luminite(value: "{shipped}", caption: "LUMINITE SHIPPED", color: palette.luminite)
      OreStatTile critters(value: "{kills}", caption: "CRITTERS KILLED", color: palette.red)
      OreStatTile clock(value: "{minutes:.0}:{seconds:02}", caption: "TIME SURVIVED", color: palette.text)
      OreStatTile last_wave(value: "{wave}", caption: "LAST WAVE", color: palette.amber)
    }

    OrePulseText again(text: "PRESS R TO LAND AGAIN", size: 18, color: palette.amber)
  }
}

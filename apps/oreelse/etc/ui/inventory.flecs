using flecs.script
using flecs.script.math
using box.types
using box.layout
using box.transform
using box.geometry
using box.material
using box.text
using box.picking
using box.transition
using oreelse

const slotSize: f32 = 72
const slotRadius: f32 = 3
const slotIcon: f32 = 44
const sectionPad: f32 = 14
const titleSize: f32 = 19
const infoWidth: f32 = 560
const infoHeight: f32 = 154
const infoText: f32 = 14

template OreSlotFace {
  prop filled: bool = true
  prop can: bool = true
  prop selected: bool = false
  prop hover: bool = false
  prop down: bool = false
  prop tex: entity = 0

  const motion = OreUiMotion[OreUiMotion].scale
  const lit = hover && can && filled
  const lift: f32 = match down && lit { true: 0.94; _: match lit { true: 1.12; _: 1 } }
  const iconAlpha: f32 = match can { true: 1; _: 0.45 }

  const liveFace: Rgb = match lit {
    true: {66, 72, 82}
    false: {46, 50, 58}
  }

  const faceFilled: Rgb = match selected {
    true: {84, 62, 22}
    false: liveFace
  }

  const face: Rgb = match filled && can {
    true: faceFilled
    false: {16, 17, 20}
  }

  const edgeLive: rgba = match lit {
    true: {240, 176, 58, 255}
    false: {88, 94, 106, 255}
  }

  const edgeFilled: rgba = match selected {
    true: {240, 176, 58, 255}
    false: edgeLive
  }

  const edge: rgba = match filled {
    true: edgeFilled
    false: {40, 43, 48, 255}
  }

  Layout: {}
  LayoutItem: {
    h: Left, v: Top,
    width: {mode: Fixed, value: slotSize}, height: {mode: Fixed, value: slotSize}
  }
  box.spatial.SpatialIgnore

  plate {
    Position: {0, 0, 0}
    Layout: {}
    LayoutItem: {
      h: Left, v: Top,
      width: {mode: Fixed, value: slotSize}, height: {mode: Fixed, value: slotSize}
    }
    Rect: {1, 1}
    Image: {texture: ui_art.plate}
    Rgb: face
    Border: {width: match selected { true: 2; _: 1 }, radius: slotRadius, color: edge}
    Transition: [Rgb: {duration: 0.12 * motion}]
  }

  if filled {
    art {
      Position: {0, 6, 2}
      Scale: {lift, lift, 1}
      Rect: {slotIcon, slotIcon}
      Image: {texture: tex}
      Opacity: {iconAlpha}
      Transition: [Scale: {duration: 0.12 * motion, timing_function: EaseOut}]
      box.spatial.SpatialIgnore
    }
  } else {
    socket_a {
      Position: {0, 0, 1}
      Line: {-7, 0, 7, 0, width: 1}
      Rgb: {44, 47, 52}
      box.spatial.SpatialIgnore
    }

    socket_b {
      Position: {0, 0, 1}
      Line: {0, -7, 0, 7, width: 1}
      Rgb: {44, 47, 52}
      box.spatial.SpatialIgnore
    }
  }
}

template StockSlot : box.widgets.HeadlessButton {
  prop index: i32 = 0
  prop item: entity = 0
  prop count: i32 = 0
  prop active: bool = false

  const pitch: f32 = 80
  const none: entity = 0
  const filled = item != none

  Layout: {}
  LayoutItem: {
    h: Left, v: Top, x: (index % 5) * pitch, y: -floor(index / 5) * pitch,
    width: {mode: Fixed, value: slotSize}, height: {mode: Fixed, value: slotSize}
  }
  Rect: {1, 1}
  Rgb: {0, 0, 0}
  BlendMode: Additive

  if filled {
    OreSlotFace face(selected: active, hover: hover, down: down, tex: item[OreIcon].texture)

    OreText count_label(
      text: "{count}", size: 15, font: ui_fonts.mono, color: palette.text,
      width: slotSize - 7, align: Right, y: 51) {
      Position: {0, 0, 3}
    }
  } else {
    OreSlotFace face(filled: false)
  }

  async {
    while true {
      const e = await on.activate(this)
      if ui.activation(e) == this {
        await oreelse.inventory_pick(index)
      }
    }
  }

  async {
    while true {
      await on.enter(this)
      await oreelse.inventory_hover(index, none, true)
    }
  }

  async {
    while true {
      await on.leave(this)
      hover = false
      await oreelse.inventory_hover(index, none, false)
    }
  }
}

template SlotButton : box.widgets.HeadlessButton {
  prop item: entity = 0
  prop key: string = ""
  prop can: bool = true

  const none: entity = 0

  Layout: {}
  LayoutItem: {width: {mode: Fixed, value: slotSize}, height: {mode: Fixed, value: slotSize}}
  Rect: {1, 1}
  Rgb: {0, 0, 0}
  BlendMode: Additive

  OreSlotFace face(can: can, hover: hover, down: down, tex: item[OreIcon].texture)

  if key != "" {
    OreKeyCap key_label(key: key, width: 16, height: 16, size: 10, x: 4, y: 4) {
      Position: {0, 0, 3}
    }
  }

  async {
    while true {
      const e = await on.activate(this)
      if ui.activation(e) == this {
        await oreelse.inventory_order(item, e.shift)
      }
    }
  }

  async {
    while true {
      await on.enter(this)
      await oreelse.inventory_hover(-1, item, true)
    }
  }

  async {
    while true {
      await on.leave(this)
      hover = false
      await oreelse.inventory_hover(-1, item, false)
    }
  }
}

const tabWidth: f32 = 148
const tabHeight: f32 = 30

template TabButton : box.widgets.HeadlessButton {
  prop tab: i32 = 0
  prop active: bool = false

  const motion = OreUiMotion[OreUiMotion].scale

  const face: Rgb = match active {
    true: {60, 48, 22}
    false: match hover { true: {50, 54, 60}; _: {30, 32, 37} }
  }

  const ink: Rgb = match active {
    true: palette.amberPale
    false: match hover { true: palette.text; _: palette.soft }
  }

  Layout: {direction: Row, h: Center, v: Middle}
  LayoutItem: {width: {mode: Fixed, value: tabWidth}, height: {mode: Fixed, value: tabHeight}}
  Rect: {1, 1}
  Rgb: face
  Border: {width: 1, radius: slotRadius, color: {62, 66, 72, 255}}
  Transition: [Rgb: {duration: 0.16 * motion}]

  OreText caption(text: label, size: 14, font: ui_fonts.label, color: ink)

  async {
    while true {
      const e = await on.activate(this)
      if ui.activation(e) == this {
        await oreelse.inventory_tab(tab)
      }
    }
  }

  async {
    while true {
      await on.leave(this)
      hover = false
    }
  }
}

template TabMarker {
  prop tab: i32 = 0

  const motion = OreUiMotion[OreUiMotion].scale

  LayoutFloat: {h: Left, v: Bottom, anchor_h: Left, anchor_v: Bottom, x: tab * (tabWidth + 8)}
  LayoutItem: {width: {mode: Fixed, value: tabWidth}, height: {mode: Fixed, value: 3}}
  Transition: [Position: {duration: 0.26 * motion, timing_function: EaseInOut}]
  box.spatial.SpatialIgnore

  OreHalo beam(size: tabWidth, height: 18, color: palette.amber, alpha: 0.45, z: 0)

  rule {
    Position: {0, 0, 1}
    Rect: {tabWidth - 12, 2}
    Rgb: palette.amber
    Emissive: {strength: 0.6, color: palette.amberGlow}
  }
}

template InventoryButtonFace {
  prop label: string = ""
  prop hover: bool = false
  prop down: bool = false

  const buttonWidth: f32 = 196
  const buttonHeight: f32 = 38
  const motion = OreUiMotion[OreUiMotion].scale
  const lift: f32 = match down { true: 0.97; _: 1 }
  const halo: f32 = match hover { true: 0.4; _: 0.12 }

  const face: Rgb = match hover {
    true: {66, 58, 38}
    false: {34, 37, 42}
  }

  const ink: Rgb = match hover {
    true: palette.amberPale
    false: palette.text
  }

  Layout: {}
  LayoutItem: {
    h: Left, v: Top,
    width: {mode: Fixed, value: buttonWidth}, height: {mode: Fixed, value: buttonHeight}
  }
  Scale: {lift, lift, 1}
  Transition: [Scale: {duration: 0.08 * motion}]
  box.spatial.SpatialIgnore

  OreHalo aura(size: buttonWidth + 60, height: buttonHeight + 50, color: palette.amber, alpha: halo, z: -1) {
    Transition: [Opacity: {duration: 0.16 * motion}]
  }

  plate {
    Position: {0, 0, 0}
    LayoutItem: {
      h: Left, v: Top,
      width: {mode: Fixed, value: buttonWidth}, height: {mode: Fixed, value: buttonHeight}
    }
    Rect: {1, 1}
    Image: {texture: ui_art.plate}
    Rgb: face
    Border: {width: 1, radius: slotRadius, color: {98, 102, 106, 255}}
    Transition: [Rgb: {duration: 0.12 * motion}]
  }

  row {
    Position: {0, 0, 1}
    Layout: {direction: Row, spacing: 10, h: Center, v: Middle}
    LayoutItem: {
      h: Left, v: Top,
      width: {mode: Fixed, value: buttonWidth}, height: {mode: Fixed, value: buttonHeight}
    }

    OreKeyCap key(key: "E", width: 18, height: 18)
    OreText word(text: label, size: 15, font: ui_fonts.stencil, color: ink)
  }
}

template InventoryButton : box.widgets.HeadlessButton {
  InputBlocker
  Layout: {}
  LayoutItem: {
    h: Center, v: Bottom, y: 22,
    width: {mode: Fixed, value: 196}, height: {mode: Fixed, value: 38}
  }
  Rect: {1, 1}
  Rgb: {0, 0, 0}
  BlendMode: Additive

  InventoryButtonFace face(label: label, hover: hover, down: down)

  async {
    while true {
      await on.leave(this)
      hover = false
    }
  }
}

template StockBody {
  const gridWidth: f32 = 392
  const gridHeight: f32 = 232

  const none: entity = 0
  const stock = OreInventory[OreInventory]
  const selected = OrePlacement[OrePlacement].selected

  Layout: {
    direction: Column, spacing: 8, padding: {sectionPad, sectionPad, sectionPad, sectionPad}
  }
  LayoutItem: {h: Left, v: Top}

  OreText title(text: "INVENTORY", size: titleSize, font: ui_fonts.stencil, color: palette.amber, glow: 0.35, glowColor: palette.amberGlow)
  OreText hint(text: "Click a building to place it - 15 slots", size: 13, color: palette.soft)

  grid {
    Layout: {}
    LayoutItem: {
      width: {mode: Fixed, value: gridWidth}, height: {mode: Fixed, value: gridHeight}
    }

    for i in 0..15 {
      StockSlot "slot_{i}"(
        index: i, item: stock.slots[i].item, count: stock.slots[i].amount,
        active: stock.slots[i].item != none && stock.slots[i].item == selected)
    }
  }
}

template BuildingsPage {
  const flips = OreCanOrderFlips[OreCanOrderFlips].count

  Layout: {direction: Column, spacing: 8}

  row_base {
    Layout: {direction: Row, spacing: 8}
    SlotButton wall(item: Wall, can: flips >= 0 && Wall[OreCanOrder].value)
    SlotButton drill(item: Drill, can: flips >= 0 && Drill[OreCanOrder].value)
    SlotButton solar_panel(item: SolarPanel, can: flips >= 0 && SolarPanel[OreCanOrder].value)
  }

  row_turrets {
    Layout: {direction: Row, spacing: 8}
    SlotButton gun_turret(item: GunTurret, can: flips >= 0 && GunTurret[OreCanOrder].value)
    SlotButton laser_turret(item: LaserTurret, can: flips >= 0 && LaserTurret[OreCanOrder].value)
    SlotButton missile_turret(item: MissileTurret, can: flips >= 0 && MissileTurret[OreCanOrder].value)
  }

  row_late {
    Layout: {direction: Row, spacing: 8}
    SlotButton factory(item: Factory, can: flips >= 0 && Factory[OreCanOrder].value)
    SlotButton rocket_pad(item: RocketPad, can: flips >= 0 && RocketPad[OreCanOrder].value)
    SlotButton drone_pad(item: DronePad, can: flips >= 0 && DronePad[OreCanOrder].value)
  }
}

template RocketPage {
  const flips = OreCanOrderFlips[OreCanOrderFlips].count

  Layout: {direction: Column, spacing: 8}

  row_rocket {
    Layout: {direction: Row, spacing: 8}
    SlotButton engine(item: items.RocketEngine, key: "F", can: flips >= 0 && items.RocketEngine[OreCanOrder].value)
    SlotButton fuel(item: items.RocketFuelStorage, key: "G", can: flips >= 0 && items.RocketFuelStorage[OreCanOrder].value)
    SlotButton cargo_bay(item: items.RocketCargoBay, key: "H", can: flips >= 0 && items.RocketCargoBay[OreCanOrder].value)
    SlotButton life_support(item: items.RocketLifeSupport, key: "J", can: flips >= 0 && items.RocketLifeSupport[OreCanOrder].value)
  }
}

template ConstructBody {
  prop tab: i32 = 0

  const pageWidth: f32 = 312
  const pageHeight: f32 = 232

  Layout: {
    direction: Column, spacing: 8, padding: {sectionPad, sectionPad, sectionPad, sectionPad}
  }
  LayoutItem: {h: Left, v: Top}

  OreText title(text: "CONSTRUCT", size: titleSize, font: ui_fonts.stencil, color: palette.amber, glow: 0.35, glowColor: palette.amberGlow)

  tabs {
    Layout: {direction: Row, spacing: 8}

    TabButton buildings_tab(label: "Buildings", tab: 0, active: tab == 0)
    TabButton rocket_tab(label: "Rocket", tab: 1, active: tab == 1)
    TabMarker marker(tab: tab)
  }

  pages {
    Layout: {direction: Column}
    LayoutItem: {
      width: {mode: Fixed, value: pageWidth}, height: {mode: Fixed, value: pageHeight}
    }

    if tab == 0 {
      BuildingsPage buildings_page()
    } else {
      RocketPage rocket_page()
    }
  }
}

template ItemInfoPanel {
  prop item: entity = 0
  prop place: bool = false

  const iconSize: f32 = 56
  const needIcon: f32 = 24

  const needs = OreNeeds[OreNeeds]
  const recipe = item?[OreRecipe]
  const consumer = item?[OrePowerConsumer]
  const producer = item?[OrePowerProducer]
  const draw: f32 = match consumer {
    true: item[OrePowerConsumer].watts
    false: 0
  }
  const gen: f32 = match producer {
    true: item[OrePowerProducer].watts
    false: 0
  }
  const craftTime: f32 = match recipe {
    true: item[OreRecipe].time
    false: 0
  }
  const yields: i32 = match recipe {
    true: item[OreRecipe].yield
    false: 0
  }

  const genText: string = match gen > 0 {
    true: " - +{gen:.0} W"
    false: ""
  }
  const powerText: string = match draw > 0 {
    true: " - {draw:.0} W"
    false: genText
  }
  const craftText: string = match yields > 1 {
    true: "Craft {craftTime:.1}s - yields {yields}{powerText}"
    false: "Craft {craftTime:.1}s{powerText}"
  }
  const recipeText: string = match recipe {
    true: craftText
    false: "Mined from deposits"
  }
  const noteText: string = match place {
    true: "Ready to place{powerText}"
    false: recipeText
  }

  Layout: {}
  LayoutItem: {
    h: Center, v: Middle, y: -224,
    width: {mode: Fixed, value: infoWidth}, height: {mode: Fixed, value: infoHeight}
  }

  Panel panel(width: infoWidth, height: infoHeight, capH: 6, aura: 0.14) {
    OreGlyph icon(tex: item[OreIcon].texture, size: iconSize, x: 14, y: 22)
    OreText item_name(text: item[OreItem].name, size: 21, font: ui_fonts.stencil, color: palette.text, x: 82, y: 17)
    OreText note(text: noteText, size: infoText, font: ui_fonts.label, color: palette.amber, x: 82, y: 49)
    OreText detail(text: item[OreItem].detail, size: infoText, color: palette.soft, x: 82, y: 71)

    if recipe && !place && needs.item == item && needs.count > 0 {
      OreText needs_label(text: "NEEDS", size: 12, font: ui_fonts.stencil, color: palette.amber, x: 14, y: 114)

      needs_list {
        Layout: {direction: Row, spacing: 18}
        LayoutItem: {h: Left, v: Top, x: 82, y: -106}

        for i in 0..needs.count {
          "need_{i}" {
            const need = needs.ores[i]
            const ore = need.item
            const short = need.have < need.need

            Layout: {direction: Row, spacing: 6, v: Middle}

            OreGlyph icon(tex: ore[OreIcon].texture, size: needIcon)
            OreText amount(
              text: "{need.have}/{need.need}", size: 15, font: ui_fonts.mono,
              color: match short { true: palette.red; _: palette.text },
              glow: match short { true: 0.4; _: 0 })
          }
        }
      }
    }
  }
}

template InventoryScreen {
  const screenWidth: f32 = 802
  const screenHeight: f32 = 368
  const sectionTop: f32 = 20
  const sectionHeight: f32 = 334
  const stockWidth: f32 = 420
  const constructWidth: f32 = 340
  const sectionFill: rgba = {34, 37, 42, 255}
  const sectionEdge: rgba = {62, 66, 72, 255}

  const tab = OreInventoryScreen[OreInventoryScreen].tab

  Layout: {}
  LayoutItem: {
    h: Center, v: Middle, y: 60,
    width: {mode: Fixed, value: screenWidth}, height: {mode: Fixed, value: screenHeight}
  }

  Panel panel(
    width: screenWidth, height: screenHeight, capH: 8,
    fill: {18, 20, 23, 250}, aura: 0.14) {
    Panel stock_section(
      width: stockWidth, height: sectionHeight, cap: false, fill: sectionFill, edge: sectionEdge,
      aura: 0, brackets: false, x: sectionPad, y: -sectionTop) {
      StockBody body()
    }

    Panel construct_section(
      width: constructWidth, height: sectionHeight, cap: false, fill: sectionFill, edge: sectionEdge,
      aura: 0, brackets: false, x: sectionPad + stockWidth + sectionPad, y: -sectionTop) {
      ConstructBody body(tab: tab)
    }
  }
}

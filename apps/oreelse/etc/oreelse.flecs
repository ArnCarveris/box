// Ore Else: you crash-landed on a hostile planet. The game is played top down on a 48x48 tile
// map with a camera that follows the astronaut. This scene holds the window, the camera, the
// look of the original's engine.flecs (the sun, the atmosphere, the effects of the view and the
// render quality tier), the tile markers, the preview of placement and the HUD; the included
// scripts hold the constants, the palette and the icons of the UI, the items, the buildings and
// their connector rules, the models, the input, the map, the run and the UI kit and HUD
// templates. The game boots into the title screen.

include config
include ui/palette
include ui/icons
include resources
include particles
include materials/terrain
include materials/hazard
include materials/solar_cells
include materials/wall_plate
include materials/vent
include materials/fan
include materials/drone_bay
include materials/flora
include props/ore
include props/flora
include props/light
include props/markers
include projectiles/tracer
include projectiles/missile
include projectiles/laser_beam
include buildings/pad_beacon
include buildings/wall
include buildings/wall_segment
include buildings/drill
include buildings/solar_panel
include buildings/gun_turret
include buildings/laser_turret
include buildings/missile_turret
include buildings/factory
include buildings/drone
include buildings/drone_pad
include rocket/pad_clamp
include rocket/rocket_bell
include rocket/rocket_port
include rocket/rocket_bay
include rocket/rocket
include buildings/rocket_pad
include buildings/rules
include player
include critters/mite
include critters/skitter
include critters/brute
include critters/behemoth
include input
include world
include boundary
include scenery
include deposits
include run
include launch
include ui/panel
include ui/queue
include ui/power
include ui/rocket_panel
include ui/hud

using flecs.script.math
using box.transform
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.atmosphere
using oreelse

window {
  Surface: {width: 1280, height: 720, vsync: true}
}

// The camera of the original, 50 degrees of field of view. OreCameraFollow places it above the
// astronaut at the zoom level of OreView every frame
camera {
  Camera: {fov: 50, near_: 0.5, far_: 500}
  Position: {0, 15, 14}
  Rotation: {-atan2(15 - 1.2, 14), 0, 0}
  DynamicTransform
}

// The sun of the original shines from (-1.4, 1.8, 1.2) toward the origin, its +Z along
// -(-1.4, 1.8, 1.2), in its warm color. The original's moon has no light and its stars and top
// of atmosphere light are not ported
sun {
  Rotation: {asin(1.8 / sqrt(1.96 + 3.24 + 1.44)), atan2(1.4, -1.2), 0}
  DirectionalLight: {intensity: 1.5}
  Rgb: {255, 206, 168}
}

// The sky lit by the sun. The Atmosphere singleton is also the environment the world view takes
// its ambient light from, so there is no hemisphere AmbientLight
$ {
  Atmosphere: {sun: sun}
}

// The contact shadows of the original's SSAO
gtao {
  Gtao: {radius: 0.5}
}

bloom {
  Bloom: {}
}

// The metering of the original: no share of the histogram left out at the dark end and a wider
// accepted brightness range than the defaults
exposure {
  AutoExposure: {min_log_luma: -16, low_percentile: 0, min_brightness: 0.05, max_brightness: 0.5}
}

// Tony McMapface, as the original, desaturates the colors as they brighten
tonemap {
  Tonemap: {auto_exposure: exposure, operator_: TonyMcMapface}
}

// The world view. OreQualityApply sets the resolution of its shadows, their distance and whether
// its Gtao and Bloom run from the render quality tier (cfg.quality); the values here are High's
main_view {
  View: {
    camera: camera,
    clear: {enabled: true, color: {178, 150, 128, 255}},
    // Lit by the sky of the atmosphere at half intensity, the ambient_intensity 0.5 of the
    // original; the atmosphere draws the sky, so the environment draws no background
    lighting: {enabled: true, baked: true, reflections: true, atmosphere: true,
      environment: {source: Atmosphere, intensity: 0.5, yaw: 0, background: false}},
    shadows: {enabled: true, resolution: 4096, max_distance: 140},
    // Instances smaller than 3 pixels on screen are not drawn, the screen_px_threshold of the
    // original
    culling: {enabled: true, occlusion: true, min_dimension_px: 3},
    effects: [{effect: gtao}, {effect: bloom}, {effect: tonemap}]
  }
}

// The markers of mining, which OrePlayerMine moves to the target and shows while the Mine
// action is held, and the preview of placement, whose markers and ghosts OrePlacePreview pools
// under place
markers {
  mine : TileMarker {
    Position: {0, 0.14, 0}
    DynamicTransform
    Disabled
  }

  mine_bad : TileMarkerBad {
    Position: {0, 0.14, 0}
    DynamicTransform
    Disabled
  }

  place {}
}

// The render quality tier, High at every start of the app; the pause screen's button cycles it
// with oreelse.cycleQuality(). A restart keeps it. OreLook names what the tier applies to
$ {
  OreLook: {view: main_view, gtao: gtao, bloom: bloom}
  OreQuality: {tier: High}
}

// The one shot effects the game plays from C (etc/particles): the astronaut's foot dust and
// death splat, the burst of every yield of a deposit, and the poof of a used up deposit and of a
// building placed or demolished
$ {
  OreEffects: {
    foot_dust: FootDust, mine_burst: MineBurst, poof_burst: PoofBurst, splat_burst: SplatBurst
  }
}

// The critter prefabs of the tiers the waves spawn, cheapest first: the shares of the style
// mixes (cfg.mixedMix, cfg.swarmMix, cfg.eliteMix) and OreWaveState.spawn follow this order. A
// critter without a death burst splats; every corpse smolders with the embers
$ {
  OreArsenal: {critters: [Mite, Skitter, Brute, Behemoth], splat: SplatBurst, embers: CorpseEmbers}
}

// The camera starts at zoom level 0; height 0 snaps it there on the first frame
$ {
  OreView: {camera: camera, view: main_view, level: 0, height: 0, back: 0, look: 0}
  OreMineMarker: {good: markers.mine, bad: markers.mine_bad}
  OrePreview: {root: markers.place, good: TileMarker, bad: TileMarkerBad}
  (OreGameState, Title)
}

// The HUD (ui/hud.flecs), created after the world view so it draws over it
hud {
  OreHud: {surface: window}
}

// Ore Else: you crash-landed on a hostile planet. The game is played top down on a 48x48 tile
// map with a camera that follows the astronaut. This scene holds the window, the camera, the
// look of the original's engine.flecs (the sun, the atmosphere, the effects of the view and the
// render quality tier), the tile markers, the preview of placement, the health bars and the HUD;
// the included scripts hold the constants, the palette and the icons of the UI, the items, the
// buildings and their connector rules, the models, the input, the map, the run and the UI kit,
// health bar, inventory screen, screen and HUD templates. The game boots into the title screen.

include config
include ui/palette
include ui/icons
include resources
include particles
include materials/terrain
include materials/hazard
include materials/solar_cells
include materials/wall_plate
include materials/vent
include materials/fan
include materials/drone_bay
include materials/flora
include props/ore
include props/flora
include props/light
include props/markers
include projectiles/tracer
include projectiles/missile
include projectiles/laser_beam
include buildings/pad_beacon
include buildings/wall
include buildings/wall_segment
include buildings/drill
include buildings/solar_panel
include buildings/gun_turret
include buildings/laser_turret
include buildings/missile_turret
include buildings/factory
include buildings/drone
include buildings/drone_pad
include rocket/pad_clamp
include rocket/rocket_bell
include rocket/rocket_port
include rocket/rocket_bay
include rocket/rocket
include buildings/rocket_pad
include buildings/rules
include player
include critters/mite
include critters/skitter
include critters/brute
include critters/behemoth
include input
include world
include boundary
include scenery
include deposits
include run
include launch
include stresstest
include ui/kit
include ui/panel
include ui/queue
include ui/power
include ui/rocket_panel
include ui/inventory
include ui/screens
include ui/hud
include ui/health_bar

using flecs.script.math
using box.transform
using box.material
using box.camera
using box.view
using box.light
using box.texture
using box.effects
using box.surface
using box.atmosphere
using oreelse

$ {
  Scene: {cookies: true, environment: true, aerial_perspective: true, alpha_cutout: true,
    blend_modes: true}
}

window {
  Surface: {width: 1280, height: 720, vsync: true}
}

// The camera of the original, 50 degrees of field of view. OreCameraFollow places it above the
// astronaut at the zoom level of OreView every frame
camera {
  Camera: {fov: 50, near_: 0.5, far_: 500}
  Position: {0, 15, 14}
  Rotation: {-atan2(15 - 1.2, 14), 0, 0}
  DynamicTransform
}

// The cloud shadows of the original's cloud_shadow {strength: 0.6, scale: 13, coverage: 0.45,
// softness: 0.35, speed: 3, direction: 0.7}, which darkened the direct sun by
// 1 - smoothstep(thr - soft, thr + soft, n) * strength with thr = 1 - coverage, n two octaves of
// value noise at world XZ / scale plus the drift. The sun's LightCookie casts them with the
// seamless fbm noise of the engine's CookieNoise (etc/assets/textures/cloud_noise.png, copied
// here), read as stored:
// - size: the base octave of the texture has 8 cells across the tile, so 8 * 13 = 104 world
//   units make a cell of about 13 units, the original's scale.
// - threshold: the cookie is the transmittance t, shaded where t is below the threshold, so
//   the threshold is about the coverage (the original's noise above 1 - coverage). The texture
//   is a little steeper than t (CookieNoise): 42% of its texels are below 0.45 and 45% below
//   0.47, so 0.47 shades the original's 45% of the ground.
// - softness: the cookie ramps linearly over 2 * softness of t around the threshold, the
//   original's smoothstep over 2 * soft of n. The texture spreads wider than the two octaves of
//   value noise (a deviation of 0.23 against about 0.16) and the smoothstep is 1.5 times
//   steeper at its middle than a linear ramp, which about cancel: 0.35 * 0.23 / 0.16 / 1.5 =
//   0.34, so the same 0.35 gives edges as soft as the original's.
// - strength: mix(1, lit, 0.6) darkens a fully clouded spot to 0.4, as 1 - 1 * 0.6 did.
// - velocity: 3 units per second along the heading 0.7 radians around world Y,
//   3 * (cos 0.7, sin 0.7) along world X and Z, added to the position read as the original
//   added its drift. OreCloudShadowApply (src/look.c) moves the cookie's offset by it over the
//   clock of play, as the original's drift stopped while paused, and sets the strength to 0 at
//   the tiers without cloud_shadows (cfg.quality).
// - height: the original shaded the ground right under its noise; the cookie reads the noise
//   where the ray toward the sun crosses the plane at height 10, which this sun (l.y 0.70) puts
//   about 10 units toward it (1.02 per unit of height), less than a cell, and above the
//   buildings and the plants, which all take the shadows. Only a rocket climbing above it
//   leaves them.
cloud_noise {
  Path: {path: "apps/oreelse/etc/assets/textures/cloud_noise.png", single_channel: true}
}

// The sun of the original shines from (-1.4, 1.8, 1.2) toward the origin, its +Z along
// -(-1.4, 1.8, 1.2), in its warm color. The original's moon has no light and its stars and top
// of atmosphere light are not ported
sun {
  Rotation: {asin(1.8 / sqrt(1.96 + 3.24 + 1.44)), atan2(1.4, -1.2), 0}
  DirectionalLight: {intensity: 1.5}
  Rgb: {255, 232, 212}
  LightCookie: {
    texture: cloud_noise, projection: Plane, size: 8 * 13, height: 10,
    threshold: 0.47, softness: 0.35, strength: 0.6
  }
  OreCloudShadow: {strength: 0.6, velocity: [3 * cos(0.7), 3 * sin(0.7)]}
}

// The sky lit by the sun. The Atmosphere singleton is also the environment the world view takes
// its ambient light from, so there is no hemisphere AmbientLight
$ {
  Atmosphere: {sun: sun}
}

// The contact shadows of the original's SSAO
gtao {
  Gtao: {radius: 0.5}
}

bloom {
  Bloom: {}
}

// The metering of the original: no share of the histogram left out at the dark end and a wider
// accepted brightness range than the defaults
exposure {
  AutoExposure: {min_log_luma: -16, low_percentile: 0, min_brightness: 0.05, max_brightness: 0.5}
}

// Tony McMapface, as the original, desaturates the colors as they brighten
tonemap {
  Tonemap: {auto_exposure: exposure, operator_: TonyMcMapface}
}

// The world view. OreQualityApply sets the resolution of its shadows, their distance and whether
// its Gtao and Bloom run from the render quality tier (cfg.quality); the values here are High's
main_view {
  View: {
    camera: camera,
    clear: {enabled: true, color: {218, 202, 188, 255}},
    // Lit by the sky of the atmosphere at half intensity, the ambient_intensity 0.5 of the
    // original; the atmosphere draws the sky, so the environment draws no background
    lighting: {enabled: true, baked: true, reflections: true, atmosphere: true,
      environment: {source: Atmosphere, intensity: 0.5, yaw: 0, background: false}},
    shadows: {enabled: true, resolution: 4096, max_distance: 140},
    // Instances smaller than 3 pixels on screen are not drawn, the screen_px_threshold of the
    // original
    culling: {enabled: true, occlusion: true, min_dimension_px: 3},
    effects: [{effect: gtao}, {effect: bloom}, {effect: tonemap}]
  }
}

// The markers of mining, which OrePlayerMine moves to the target and shows while the Mine
// action is held, and the preview of placement, whose markers and ghosts OrePlacePreview pools
// under place
markers {
  mine : TileMarker {
    Position: {0, 0.14, 0}
    DynamicTransform
    Disabled
  }

  mine_bad : TileMarkerBad {
    Position: {0, 0.14, 0}
    DynamicTransform
    Disabled
  }

  place {}
}

// The render quality tier, High at every start of the app; the pause screen's button cycles it
// with oreelse.cycleQuality(). A restart keeps it. OreLook names what the tier applies to
$ {
  OreLook: {view: main_view, gtao: gtao, bloom: bloom}
  OreQuality: {tier: High}
}

// The one shot effects the game plays from C (etc/particles): the astronaut's foot dust and
// death splat, the burst of every yield of a deposit, the poof of a used up deposit and of a
// building placed or demolished, and the effects of combat: the explosion of a missile and of a
// destroyed building, the sparks of a shot at the muzzle and where it hits, the puff of a hit on
// a critter and the dust of a hit on the ground
$ {
  OreEffects: {
    foot_dust: FootDust, mine_burst: MineBurst, poof_burst: PoofBurst, splat_burst: SplatBurst,
    boom_burst: BoomBurst, spark_burst: SparkBurst, hit_puff: HitPuff, impact_dust: ImpactDust
  }
}

// The critter prefabs of the tiers the waves spawn, cheapest first: the shares of the style
// mixes (cfg.mixedMix, cfg.swarmMix, cfg.eliteMix) and OreWaveState.spawn follow this order. A
// critter without a death burst splats; every corpse smolders with the embers
$ {
  OreArsenal: {critters: [Mite, Skitter, Brute, Behemoth], splat: SplatBurst, embers: CorpseEmbers}
}

// The camera starts at zoom level 0; height 0 snaps it there on the first frame
$ {
  OreView: {camera: camera, view: main_view, level: 0, height: 0, back: 0, look: 0}
  OreMineMarker: {good: markers.mine, bad: markers.mine_bad}
  OrePreview: {root: markers.place, good: TileMarker, bad: TileMarkerBad}
  (OreGameState, Title)
}

// The health bars of the damaged buildings (ui/health_bar.flecs): a screen space UI scene whose
// view is created after the world view and before the HUD, so the bars draw over the world and
// under the panels of the HUD. OreHealthBarsShow gives the view its camera only while playing;
// the game creates the bars under bars
health_bars {
  Scene: {cookies: true, environment: true, aerial_perspective: true, alpha_cutout: true, blend_modes: true}

  camera {
    Position: {0, 0, 100}
    Camera: {ortho: true, ortho_scale: 1}
  }

  bars {}
}

health_bars_view {
  View: {camera: health_bars.camera, lighting: {enabled: false}, culling: {enabled: false}}
}

$ {
  OreHealthBars: {
    bar: HealthBar, root: health_bars.bars, view: health_bars_view, camera: health_bars.camera,
    world: main_view
  }
}

// The HUD (ui/hud.flecs), created after the world view so it draws over it
hud {
  OreHud: {}
}

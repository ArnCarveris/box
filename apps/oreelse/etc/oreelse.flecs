// Ore Else: you crash-landed on a hostile planet. The game is played top down on a 48x48 tile
// map with a camera that follows the astronaut. This scene holds the window, the camera, the
// look of the original's engine.flecs (the sun, the atmosphere, the effects of the view and the
// render quality tier) and the tile markers; the included scripts hold the constants, the
// items, the models, the input, the map and the run. The game boots into the title screen.

include config
include resources
include materials/terrain
include materials/hazard
include materials/solar_cells
include materials/wall_plate
include materials/vent
include materials/fan
include materials/drone_bay
include props/ore
include props/light
include props/markers
include buildings/pad_beacon
include buildings/wall
include buildings/wall_segment
include buildings/drill
include buildings/solar_panel
include buildings/gun_turret
include buildings/laser_turret
include buildings/missile_turret

// The plume of the jetpack, the JetPlume template of the original: flame shooting down from
// the backpack, from a pale yellow through orange to grey smoke, added onto the image. It is
// stopped; OrePlayerFx plays it while the astronaut hovers. Its flare sprite is in pools.flecs.

using box.transform
using box.types
using box.particle

template JetPlume {
  prop rate: f32 = 70
  prop color: rgb = {255, 236, 150}
  prop vy: f32 = -6
  prop size: f32 = 0.13

  // A cone of 14 degrees from a disc of 0.07 around the nozzles, at vy with 0.8 of variance,
  // living 0.3 +- 0.1 s and inheriting 0.45 of the astronaut's velocity
  ParticleEmitter: {
    max: 48,
    rate: rate,
    shape: EmitterDisc,
    radius: 0.07,
    direction: {0, -1, 0},
    spread: 14,
    speed: {-vy - 0.8, -vy + 0.8},
    lifetime: {0.2, 0.4},
    size: {size - 0.05, size + 0.05},
    rotation: {-180, 180},
    spin: {-344, 344},
    opacity: {1, 1},
    inherit_velocity: 0.45,
    color: color,
    seed: 41
  }

  ParticlePlayback: {state: ParticleStopped}

  // The forces of the fire pool: a lift of 1.6, drag 3 and turbulence 2.2 at scale 1.4
  ParticleForces: {gravity: {0, 1.6, 0}, drag: 3, turbulence: 2.2, turbulence_scale: 1.4}

  ParticleAppearance: {
    shape: ParticleSprite,
    blend: ParticleAdditive,
    texture: sprFlare,
    softness: 0.6,
    lit: 0
  }

  // The pool's flare size curve with the growth of 0.5 per second, its spike of opacity with
  // the alpha of the color ramp (235, 225 at 0.35, 110 at the end), and the color ramp through
  // {248, 92, 40} to {114, 108, 102} as multipliers of the color in linear light
  ParticleCurves: {
    size: {0.3, 1.92, 2.27, 2.04},
    opacity: {0.83, 0.49, 0.13, 0},
    color: {
      start: {255, 255, 255},
      early: {248, 100, 74},
      late: {197, 109, 137},
      end: {114, 118, 175}
    }
  }
}

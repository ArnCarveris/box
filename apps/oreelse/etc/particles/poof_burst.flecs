// A puff of dust where a building is placed or removed or a deposit is mined out, the
// PoofBurst of the original.

using box.transform
using box.geometry
using box.particle

// The hemisphere of radius 0.34 the dust spawns over
prefab shapePoof {
  HemiSphere: {segments: 16, radius: 0.34}
}

prefab PoofBurst {
  // The burst: 18 particles of the fx pool, from a hemisphere of 0.34, offset {0, 0.1, 0}, at
  // {0, 1.5, 0} +- {0.7, 0.7, 0.7}, radial 1.9, living 0.55 +- 0.22 s, sized 0.15 +- 0.06
  // growing 0.35 a second, colored {198, 168, 132} to {150, 132, 112, 120}
  particles {
    Position: {0, 0.1, 0}
    Emitter: {
      max: 18,
      rate: 0,
      shape: EmitterMesh,
      source: shapePoof,
      direction: {0, 1, 0},
      spread: 25,
      speed: {0.8, 2.2},
      radial: {1.9, 1.9},
      lifetime: {0.33, 0.77},
      size: {0.09, 0.21},
      rotation: {-180, 180},
      spin: {-126, 126},
      color: {228, 212, 190},
      seed: 224
    }
    Burst: {count: 18}
    Forces: {gravity: {0, -5, 0}, drag: 2.5, turbulence: 0.7, turbulence_scale: 1.2}
    Appearance: {
      shape: Sprite,
      texture: sprPuff,
      softness: 0.35,
      lit: 0.8
    }
    Curves: {
      size: {keys: [{0, 0.45}, {0.33333334, 1.67}, {0.6666667, 2.6}, {1, 3.43}]},
      opacity: {keys: [{0, 1}, {0.33333334, 0.82}, {0.6666667, 0.58}, {1, 0}]},
      color: {keys: [
        {0, {255, 255, 255}},
        {0.33333334, {246, 247, 250}},
        {0.6666667, {236, 239, 244}},
        {1, {226, 230, 238}}
      ]}
    }
  }
}

// The glow at the lens of a laser turret while it fires, the BeamGlow of the original: a
// stream of glow sparks and a light of the beam's color. The turret plays it while its beam
// is on and stops it when it goes off; the box.particle.Light of the emitter lights the light at
// peak while it plays and turns it off at once when it stops, the FlashLight with fade 0 of
// the original.

using box.types
using box.light
using box.particle
using box.material

template BeamGlow {
  prop color: rgb = {248, 165, 214}
  prop peak: f32 = 4.5
  prop radius: f32 = 7
  prop rate: f32 = 55

  Rgb: {color.r, color.g, color.b}
  PointLight: {intensity: 0, range: radius}
  box.particle.Light: {intensity: peak}

  // The stream: 55 a second into the glow pool, from a sphere of 0.05, at {0, 0.4, 0} +-
  // {0.9, 0.9, 0.9}, radial 1.2, living 0.22 +- 0.08 s, sized 0.075 +- 0.035 growing -0.1 a
  // second, colored {240, 96, 172}
  Emitter: {
    max: 25,
    rate: rate,
    shape: EmitterSphere,
    radius: 0.05,
    direction: {0, 1, 0},
    spread: 66,
    speed: {0, 1.3},
    radial: {1.2, 1.2},
    lifetime: {0.14, 0.3},
    size: {0.04, 0.11},
    color: color,
    seed: 230
  }
  Playback: {state: Stopped}
  Forces: {gravity: {0, -4, 0}, drag: 1.5}
  Appearance: {
    shape: Sprite,
    blend: Additive,
    texture: sprSpark,
    softness: 0.25,
    lit: 0
  }
  Curves: {
    size: {keys: [{0, 1.25}, {0.33333334, 0.81}, {0.6666667, 0.38}, {1, 0.04}]},
    opacity: {keys: [{0, 1}, {0.33333334, 1}, {0.6666667, 0.93}, {1, 0}]}
  }
}

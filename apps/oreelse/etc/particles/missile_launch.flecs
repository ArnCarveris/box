// The launch of a missile from its rack, the MissileLaunch of the original: a flash and
// exhaust of the fire pool and smoke blown back along -Z, the launch direction of a turret
// aimed at 0. ore_burst_aimed (src/particles.c) turns it about Y to the aim of the turret, as
// the original's oreLaunchFx turns the velocities and offsets.

using box.transform
using box.particle

prefab MissileLaunch {
  // The flash: 4 particles of the fire pool, from a sphere of 0.16, at {0, 0.3, -1.2} +-
  // {0.4, 0.3, 0.5}, living 0.17 +- 0.05 s, sized 0.58 +- 0.18 growing 1.2 a second, colored
  // {255, 246, 224} through {255, 208, 132} at 0.45 to {255, 138, 62, 190}
  flash {
    Position: {0, 0, 0}
    ParticleEmitter: {
      max: 4,
      rate: 0,
      shape: EmitterSphere,
      radius: 0.16,
      direction: {0, 0.243, -0.97},
      spread: 18,
      speed: {0.679, 1.795},
      lifetime: {0.12, 0.22},
      size: {0.4, 0.76},
      rotation: {-180, 180},
      spin: {-115, 115},
      color: {255, 251, 241},
      seed: 215
    }
    ParticleBurst: {count: 4}
    ParticleForces: {gravity: {0, 1.6, 0}, drag: 3, turbulence: 2.2, turbulence_scale: 1.4}
    ParticleAppearance: {
      shape: ParticleSprite,
      blend: ParticleAdditive,
      texture: sprFlare,
      softness: 0.6,
      lit: 0
    }
    ParticleCurves: {
      size: {keys: [{0, 0.3}, {0.33333334, 1.55}, {0.6666667, 1.58}, {1, 1.28}]},
      opacity: {keys: [{0, 0.9}, {0.33333334, 0.56}, {0.6666667, 0.17}, {1, 0}]},
      color: {keys: [
        {0, {255, 255, 255}},
        {0.33333334, {255, 242, 218}},
        {0.6666667, {255, 222, 182}},
        {1, {255, 197, 145}}
      ]}
    }
  }

  // The exhaust: 10 particles of the fire pool, from a sphere of 0.18, at {0, 0.2, -4.6} +-
  // {0.7, 0.5, 1.3}, radial 1.4, living 0.32 +- 0.12 s, sized 0.42 +- 0.14 growing 0.9 a second,
  // colored {255, 226, 176} through {255, 152, 66, 235} at 0.38 to {148, 70, 40, 120}
  exhaust {
    Position: {0, 0, 0}
    ParticleEmitter: {
      max: 10,
      rate: 0,
      shape: EmitterSphere,
      radius: 0.18,
      direction: {0, 0.043, -0.999},
      spread: 9,
      speed: {3.284, 5.925},
      radial: {1.4, 1.4},
      lifetime: {0.2, 0.44},
      size: {0.28, 0.56},
      rotation: {-180, 180},
      spin: {-172, 172},
      color: {255, 242, 216},
      seed: 216
    }
    ParticleBurst: {count: 10}
    ParticleForces: {gravity: {0, 1.6, 0}, drag: 3, turbulence: 2.2, turbulence_scale: 1.4}
    ParticleAppearance: {
      shape: ParticleSprite,
      blend: ParticleAdditive,
      texture: sprFlare,
      softness: 0.6,
      lit: 0
    }
    ParticleCurves: {
      size: {keys: [{0, 0.3}, {0.33333334, 1.7}, {0.6666667, 1.86}, {1, 1.6}]},
      opacity: {keys: [{0, 0.9}, {0.33333334, 0.52}, {0.6666667, 0.13}, {1, 0}]},
      color: {keys: [
        {0, {255, 255, 255}},
        {0.33333334, {255, 220, 181}},
        {0.6666667, {232, 189, 154}},
        {1, {200, 152, 135}}
      ]}
    }
  }

  // The smoke: 13 particles of the smoke pool, from a sphere of 0.2, offset {0, 0, -0.12}, at
  // {0, 0.35, -3} +- {0.6, 0.4, 1.1}, radial 1.2, living 0.95 +- 0.3 s, sized 0.42 +- 0.13
  // growing 1.05 a second, colored {150, 138, 128, 220} through {110, 102, 96, 175} at 0.35 to
  // {80, 76, 72, 0}
  smoke {
    Position: {0, 0, -0.12}
    ParticleEmitter: {
      max: 13,
      rate: 0,
      shape: EmitterSphere,
      radius: 0.2,
      direction: {0, 0.116, -0.993},
      spread: 11,
      speed: {1.881, 4.159},
      radial: {1.2, 1.2},
      lifetime: {0.65, 1.25},
      size: {0.29, 0.55},
      rotation: {-180, 180},
      spin: {-80, 80},
      color: {202, 194, 188},
      seed: 217
    }
    ParticleBurst: {count: 13}
    ParticleForces: {gravity: {0, -0.6, 0}, drag: 0.9, turbulence: 1.5, turbulence_scale: 0.55}
    ParticleAppearance: {
      shape: ParticleSprite,
      texture: sprPuff,
      softness: 0.5,
      lit: 0.85
    }
    ParticleCurves: {
      size: {keys: [{0, 0.35}, {0.33333334, 2.24}, {0.6666667, 4.55}, {1, 7.09}]},
      opacity: {keys: [{0, 0}, {0.33333334, 0.56}, {0.6666667, 0.21}, {1, 0}]},
      color: {keys: [
        {0, {255, 255, 255}},
        {0.33333334, {226, 226, 228}},
        {0.6666667, {210, 213, 214}},
        {1, {196, 199, 201}}
      ]}
    }
  }
}

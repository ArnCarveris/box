// Sparks where a bullet hits, at the muzzle of a gun turret as it fires, the SparkBurst
// of the original.

using box.transform
using box.geometry
using box.light
using box.particle

prefab SparkBurst {
  // The burst: 10 particles of the glow pool, from a sphere of 0.1, at {0, 1.4, 0} +-
  // {1.4, 1, 1.4}, radial 3.2, living 0.28 +- 0.14 s, sized 0.055 +- 0.025 stretched 2.2,
  // colored {255, 250, 232} through {255, 236, 176} at 0.3 to {255, 116, 26, 210}
  particles {
    ParticleEmitter: {
      max: 10,
      rate: 0,
      shape: EmitterSphere,
      radius: 0.1,
      direction: {0, 1, 0},
      spread: 45,
      speed: {0.4, 2.4},
      radial: {3.2, 3.2},
      lifetime: {0.14, 0.42},
      size: {0.03, 0.08},
      color: {255, 250, 232},
      seed: 226
    }
    ParticleBurst: {count: 10}
    ParticleForces: {gravity: {0, -4, 0}, drag: 1.5}
    ParticleAppearance: {
      shape: ParticleSprite,
      blend: ParticleAdditive,
      texture: sprSpark,
      softness: 0.25,
      stretch: 0.52,
      lit: 0
    }
    ParticleCurves: {
      size: {1.25, 0.9, 0.47, 0.05},
      opacity: {1, 0.99, 0.85, 0},
      color: {
        start: {255, 255, 255},
        early: {255, 235, 186},
        late: {255, 177, 108},
        end: {255, 118, 30}
      }
    }
  }
}

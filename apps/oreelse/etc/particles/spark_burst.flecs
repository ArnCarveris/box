// Sparks where a bullet hits, at the muzzle of a gun turret as it fires, the SparkBurst
// of the original.

using box.particle
using box.transform

prefab SparkBurst {
  // The burst: 10 particles of the glow pool, from a sphere of 0.1, at {0, 1.4, 0} +-
  // {1.4, 1, 1.4}, radial 3.2, living 0.28 +- 0.14 s, sized 0.055 +- 0.025 stretched 2.2,
  // colored {255, 250, 232} through {255, 236, 176} at 0.3 to {255, 116, 26, 210}
  particles {
    Position: {0, 0, 0}
    ParticleEmitter: {
      max: 10,
      rate: 0,
      shape: EmitterSphere,
      radius: 0.1,
      direction: {0, 1, 0},
      spread: 45,
      speed: {0.4, 2.4},
      radial: {3.2, 3.2},
      lifetime: {0.14, 0.42},
      size: {0.03, 0.08},
      color: {255, 253, 245},
      seed: 226
    }
    ParticleBurst: {count: 10}
    ParticleForces: {gravity: {0, -4, 0}, drag: 1.5}
    ParticleAppearance: {
      shape: ParticleSprite,
      blend: ParticleAdditive,
      texture: sprSpark,
      softness: 0.25,
      stretch: 0.52,
      lit: 0
    }
    ParticleCurves: {
      size: {keys: [{0, 1.25}, {0.33333334, 0.9}, {0.6666667, 0.47}, {1, 0.05}]},
      opacity: {keys: [{0, 1}, {0.33333334, 0.99}, {0.6666667, 0.85}, {1, 0}]},
      color: {keys: [
        {0, {255, 255, 255}},
        {0.33333334, {255, 246, 222}},
        {0.6666667, {255, 217, 174}},
        {1, {255, 181, 96}}
      ]}
    }
  }
}

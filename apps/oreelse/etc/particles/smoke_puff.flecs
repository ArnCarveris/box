// A puff from a factory's exhaust vent, the SmokePuff of the original, shot up at every
// beat of the vent. Its script names no pool; the factory fires it into the fx pool.

using box.transform
using box.particle

prefab SmokePuff {
  // The burst: 5 particles of the fx pool, from a box of {0.14, 0.06, 0.14}, offset
  // {0, 0.06, 0}, at {0, 3.4, 0} +- {0.5, 0.6, 0.5}, radial 0.3, living 0.9 +- 0.3 s, sized 0.24
  // +- 0.1 growing 1.1 a second, colored {148, 144, 140, 200} to {104, 98, 94, 120}
  particles {
    Position: {0, 0.06, 0}
    Emitter: {
      max: 5,
      rate: 0,
      shape: EmitterBox,
      extents: {0.14, 0.06, 0.14},
      direction: {0, 1, 0},
      spread: 8,
      speed: {2.8, 4},
      radial: {0.3, 0.3},
      lifetime: {0.6, 1.2},
      size: {0.14, 0.34},
      color: {200, 198, 196},
      seed: 225
    }
    Burst: {count: 5}
    Forces: {gravity: {0, -5, 0}, drag: 2.5, turbulence: 0.7, turbulence_scale: 1.2}
    Appearance: {
      shape: Sprite,
      texture: sprPuff,
      softness: 0.35,
      lit: 0.8
    }
    Curves: {
      size: {keys: [{0, 0.45}, {0.33333334, 2.78}, {0.6666667, 5.25}, {1, 7.69}]},
      opacity: {keys: [{0, 0.78}, {0.33333334, 0.68}, {0.6666667, 0.51}, {1, 0}]},
      color: {keys: [
        {0, {255, 255, 255}},
        {0.33333334, {244, 243, 243}},
        {0.6666667, {232, 231, 230}},
        {1, {220, 217, 216}}
      ]}
    }
  }
}

// The bursts of the factory's press, the PressPuff and PressSparks of the original's
// factory.flecs, played together where the press lands on every stroke. Their script names
// no pool; the factory fires the puff into the fx pool and the sparks into the glow pool.

using box.transform
using box.particle

// A puff of dust squeezed out from under the factory's press as it lands, fired into the
// fx pool
prefab PressPuff {
  // The burst: 9 particles of the fx pool, from a box of {0.42, 0.03, 0.24}, offset
  // {0, 0.02, 0}, at {0, 0.7, 0} +- {1.5, 0.5, 1}, radial 2.6, living 0.34 +- 0.12 s, sized 0.13
  // +- 0.06 growing 1.3 a second, colored {228, 214, 196, 220} to {104, 98, 94, 120}
  particles {
    Position: {0, 0.02, 0}
    Emitter: {
      max: 9,
      rate: 0,
      shape: EmitterBox,
      extents: {0.42, 0.03, 0.24},
      direction: {0, 1, 0},
      spread: 65,
      speed: {0.2, 1.2},
      radial: {2.6, 2.6},
      lifetime: {0.22, 0.46},
      size: {0.07, 0.19},
      color: {243, 236, 227},
      seed: 228
    }
    Burst: {count: 9}
    Forces: {gravity: {0, -5, 0}, drag: 2.5, turbulence: 0.7, turbulence_scale: 1.2}
    Appearance: {
      shape: Sprite,
      texture: sprPuff,
      softness: 0.35,
      lit: 0.8
    }
    Curves: {
      size: {keys: [{0, 0.45}, {0.33333334, 2.49}, {0.6666667, 4.57}, {1, 6.6}]},
      opacity: {keys: [{0, 0.86}, {0.33333334, 0.73}, {0.6666667, 0.53}, {1, 0}]},
      color: {keys: [
        {0, {255, 255, 255}},
        {0.33333334, {234, 234, 235}},
        {0.6666667, {209, 210, 212}},
        {1, {180, 181, 185}}
      ]}
    }
  }
}

// Sparks thrown out from under the press as it lands, fired into the glow pool
prefab PressSparks {
  // The burst: 12 particles of the glow pool, from a box of {0.34, 0.02, 0.2}, offset
  // {0, 0.03, 0}, at {0, 3.6, 0} +- {1.4, 1.6, 1.4}, radial 7.5, living 0.26 +- 0.1 s, sized
  // 0.045 +- 0.02 growing -0.06 a second, colored {255, 250, 232} through {255, 236, 176} at 0.3
  // to {255, 116, 26, 210}
  particles {
    Position: {0, 0.03, 0}
    Emitter: {
      max: 12,
      rate: 0,
      shape: EmitterBox,
      extents: {0.34, 0.02, 0.2},
      direction: {0, 1, 0},
      spread: 21,
      speed: {2, 5.2},
      radial: {7.5, 7.5},
      lifetime: {0.16, 0.36},
      size: {0.025, 0.065},
      color: {255, 253, 245},
      seed: 229
    }
    Burst: {count: 12}
    Forces: {gravity: {0, -4, 0}, drag: 1.5}
    Appearance: {
      shape: Sprite,
      blend: Additive,
      texture: sprSpark,
      softness: 0.25,
      lit: 0
    }
    Curves: {
      size: {keys: [{0, 1.25}, {0.33333334, 0.8}, {0.6666667, 0.36}, {1, 0.03}]},
      opacity: {keys: [{0, 1}, {0.33333334, 0.99}, {0.6666667, 0.85}, {1, 0}]},
      color: {keys: [
        {0, {255, 255, 255}},
        {0.33333334, {255, 246, 222}},
        {0.6666667, {255, 217, 174}},
        {1, {255, 181, 96}}
      ]}
    }
  }
}

// The bursts of the factory's press, the PressPuff and PressSparks of the original's
// factory.flecs, played together where the press lands on every stroke. Their script names
// no pool; the factory fires the puff into the fx pool and the sparks into the glow pool.

using box.transform
using box.particle

// A puff of dust squeezed out from under the factory's press as it lands, fired into the
// fx pool
prefab PressPuff {
  // The burst: 9 particles of the fx pool, from a box of {0.42, 0.03, 0.24}, offset
  // {0, 0.02, 0}, at {0, 0.7, 0} +- {1.5, 0.5, 1}, radial 2.6, living 0.34 +- 0.12 s, sized 0.13
  // +- 0.06 growing 1.3 a second, colored {228, 214, 196, 220} to {104, 98, 94, 120}
  particles {
    Position: {0, 0.02, 0}
    ParticleEmitter: {
      max: 9,
      rate: 0,
      shape: EmitterBox,
      extents: {0.42, 0.03, 0.24},
      direction: {0, 1, 0},
      spread: 65,
      speed: {0.2, 1.2},
      radial: {2.6, 2.6},
      lifetime: {0.22, 0.46},
      size: {0.07, 0.19},
      color: {228, 214, 196},
      seed: 228
    }
    ParticleBurst: {count: 9}
    ParticleForces: {gravity: {0, -5, 0}, drag: 2.5, turbulence: 0.7, turbulence_scale: 1.2}
    ParticleAppearance: {
      shape: ParticleSprite,
      texture: sprPuff,
      softness: 0.35,
      lit: 0.8
    }
    ParticleCurves: {
      size: {0.45, 2.49, 4.57, 6.6},
      opacity: {0.86, 0.73, 0.53, 0},
      color: {
        start: {255, 255, 255},
        early: {209, 209, 211},
        late: {163, 164, 168},
        end: {117, 118, 124}
      }
    }
  }
}

// Sparks thrown out from under the press as it lands, fired into the glow pool
prefab PressSparks {
  // The burst: 12 particles of the glow pool, from a box of {0.34, 0.02, 0.2}, offset
  // {0, 0.03, 0}, at {0, 3.6, 0} +- {1.4, 1.6, 1.4}, radial 7.5, living 0.26 +- 0.1 s, sized
  // 0.045 +- 0.02 growing -0.06 a second, colored {255, 250, 232} through {255, 236, 176} at 0.3
  // to {255, 116, 26, 210}
  particles {
    Position: {0, 0.03, 0}
    ParticleEmitter: {
      max: 12,
      rate: 0,
      shape: EmitterBox,
      extents: {0.34, 0.02, 0.2},
      direction: {0, 1, 0},
      spread: 21,
      speed: {2, 5.2},
      radial: {7.5, 7.5},
      lifetime: {0.16, 0.36},
      size: {0.025, 0.065},
      color: {255, 250, 232},
      seed: 229
    }
    ParticleBurst: {count: 12}
    ParticleForces: {gravity: {0, -4, 0}, drag: 1.5}
    ParticleAppearance: {
      shape: ParticleSprite,
      blend: ParticleAdditive,
      texture: sprSpark,
      softness: 0.25,
      lit: 0
    }
    ParticleCurves: {
      size: {1.25, 0.8, 0.36, 0.03},
      opacity: {1, 0.99, 0.85, 0},
      color: {
        start: {255, 255, 255},
        early: {255, 235, 186},
        late: {255, 177, 108},
        end: {255, 118, 30}
      }
    }
  }
}

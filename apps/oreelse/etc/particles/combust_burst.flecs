// A critter's death, the CombustBurst of the original: layered bursts of an organic
// combustion authored for a body of radius 1. ore_combust (src/particles.c) plays it at the
// center of the body (0.9 r above its feet) with the sizes and speeds at sqrt(r) and the
// spawn volumes and offsets at r, with the flash light of the original's oreCombust. A pale
// green flash and licks of the fire pool, ichor of the fx pool, chunks of the debris pool, a
// ring of spores of the glow pool, cinders of the ember pool and soot.
//
// The spores' squash (stretch 0.45) has no equivalent and is left out, and so is the mass of
// the chunks. The original also scales the count of every layer with sqrt(r); box plays the
// counts of radius 1 at every radius.

using box.transform
using box.geometry
using box.light
using box.particle
using box.material

// The ring the spores spawn on: radius 1.3, 0.35 thick
prefab shapeSporeRing {
  Torus: {segments: 32, rings: 6, radius: 1.3, tube: 0.175}
}

// The hemisphere of radius 0.95 the soot rises from
prefab shapeSootDome {
  HemiSphere: {segments: 16, radius: 0.95}
}

prefab CombustBurst {
  // The flash: 6 particles of the fire pool, from a sphere of 0.5, offset {0, 0.45, 0}, radial
  // 1.6, living 0.13 +- 0.04 s, sized 1.05 +- 0.24 growing 2.2 a second, colored {255, 255, 238}
  // through {214, 255, 148} at 0.32 to {124, 226, 56, 200}
  flash {
    Position: {0, 0.45, 0}
    ParticleEmitter: {
      max: 6,
      rate: 0,
      shape: EmitterSphere,
      radius: 0.5,
      direction: {0, 0, 0},
      speed: {0, 0},
      radial: {1.6, 1.6},
      lifetime: {0.09, 0.17},
      size: {0.81, 1.29},
      rotation: {-180, 180},
      spin: {-143, 143},
      color: {255, 255, 247},
      seed: 208
    }
    ParticleBurst: {count: 6}
    ParticleForces: {gravity: {0, 1.6, 0}, drag: 3, turbulence: 2.2, turbulence_scale: 1.4}
    ParticleAppearance: {
      shape: ParticleSprite,
      blend: ParticleAdditive,
      texture: sprFlare,
      softness: 0.6,
      lit: 0
    }
    ParticleCurves: {
      size: {keys: [{0, 0.3}, {0.33333334, 1.51}, {0.6666667, 1.51}, {1, 1.21}]},
      opacity: {keys: [{0, 0.9}, {0.33333334, 0.56}, {0.6666667, 0.17}, {1, 0}]},
      color: {keys: [
        {0, {255, 255, 255}},
        {0.33333334, {235, 255, 206}},
        {0.6666667, {212, 248, 175}},
        {1, {185, 242, 134}}
      ]}
    }
  }

  // The flash again, twice as large at half the opacity and with the same seed, so a halo
  // sits on each of its particles: the original's fire pool is emissive at 2.6, brighter than
  // box draws a particle, and it looks flat without it
  flash_halo {
    Position: {0, 0.45, 0}
    ParticleEmitter: {
      max: 6,
      rate: 0,
      shape: EmitterSphere,
      radius: 0.5,
      direction: {0, 0, 0},
      speed: {0, 0},
      radial: {1.6, 1.6},
      lifetime: {0.09, 0.17},
      size: {1.62, 2.58},
      rotation: {-180, 180},
      spin: {-143, 143},
      opacity: {0.5, 0.5},
      color: {255, 255, 247},
      seed: 208
    }
    ParticleBurst: {count: 6}
    ParticleForces: {gravity: {0, 1.6, 0}, drag: 3, turbulence: 2.2, turbulence_scale: 1.4}
    ParticleAppearance: {
      shape: ParticleSprite,
      blend: ParticleAdditive,
      texture: sprFlare,
      softness: 0.6,
      lit: 0
    }
    ParticleCurves: {
      size: {keys: [{0, 0.3}, {0.33333334, 1.51}, {0.6666667, 1.51}, {1, 1.21}]},
      opacity: {keys: [{0, 0.9}, {0.33333334, 0.56}, {0.6666667, 0.17}, {1, 0}]},
      color: {keys: [
        {0, {255, 255, 255}},
        {0.33333334, {235, 255, 206}},
        {0.6666667, {212, 248, 175}},
        {1, {185, 242, 134}}
      ]}
    }
  }

  // The ichor: 16 particles of the fx pool, from a sphere of 1.3, at {0, 3, 0} +-
  // {1.8, 1.6, 1.8}, radial 7, living 0.58 +- 0.22 s, sized 0.17 +- 0.07 stretched 2, colored
  // {138, 226, 118} through {104, 190, 88, 240} at 0.45 to {62, 122, 54, 130}
  ichor {
    Position: {0, 0, 0}
    ParticleEmitter: {
      max: 16,
      rate: 0,
      shape: EmitterSphere,
      radius: 1.3,
      direction: {0, 1, 0},
      spread: 31,
      speed: {1.4, 4.6},
      radial: {7, 7},
      lifetime: {0.36, 0.8},
      size: {0.1, 0.24},
      rotation: {-180, 180},
      spin: {-229, 229},
      color: {194, 242, 181},
      seed: 209
    }
    ParticleBurst: {count: 16}
    ParticleForces: {gravity: {0, -5, 0}, drag: 2.5, turbulence: 0.7, turbulence_scale: 1.2}
    ParticleAppearance: {
      shape: ParticleSprite,
      texture: sprPuff,
      softness: 0.35,
      stretch: 0.2,
      lit: 0.8
    }
    ParticleCurves: {
      size: {keys: [{0, 0.45}, {0.33333334, 1.17}, {0.6666667, 1.4}, {1, 1.5}]},
      opacity: {keys: [{0, 1}, {0.33333334, 0.96}, {0.6666667, 0.69}, {1, 0}]},
      color: {keys: [
        {0, {255, 255, 255}},
        {0.33333334, {234, 241, 234}},
        {0.6666667, {211, 221, 212}},
        {1, {183, 194, 186}}
      ]}
    }
  }

  // The licks: 18 particles of the fire pool, from a sphere of 1.25, at {0, 3.4, 0} +-
  // {1.3, 1.1, 1.3}, radial 5.2, living 0.42 +- 0.16 s, sized 0.3 +- 0.15 growing 0.4 a second
  // stretched 1.5, colored {186, 255, 110} through {126, 196, 40, 245} at 0.3 to
  // {50, 60, 26, 150}
  licks {
    Position: {0, 0, 0}
    ParticleEmitter: {
      max: 18,
      rate: 0,
      shape: EmitterSphere,
      radius: 1.25,
      direction: {0, 1, 0},
      spread: 21,
      speed: {2.3, 4.5},
      radial: {5.2, 5.2},
      lifetime: {0.26, 0.58},
      size: {0.15, 0.45},
      rotation: {-180, 180},
      spin: {-172, 172},
      color: {222, 255, 175},
      seed: 210
    }
    ParticleBurst: {count: 18}
    ParticleForces: {gravity: {0, 1.6, 0}, drag: 3, turbulence: 2.2, turbulence_scale: 1.4}
    ParticleAppearance: {
      shape: ParticleSprite,
      blend: ParticleAdditive,
      texture: sprFlare,
      softness: 0.6,
      stretch: 0.12,
      lit: 0
    }
    ParticleCurves: {
      size: {keys: [{0, 0.3}, {0.33333334, 1.64}, {0.6666667, 1.76}, {1, 1.48}]},
      opacity: {keys: [{0, 0.9}, {0.33333334, 0.53}, {0.6666667, 0.14}, {1, 0}]},
      color: {keys: [
        {0, {255, 255, 255}},
        {0.33333334, {213, 224, 170}},
        {0.6666667, {183, 186, 158}},
        {1, {145, 133, 146}}
      ]}
    }
  }

  // The chunks: 10 particles of the debris pool, from a sphere of 1, at {0, 5.6, 0} +-
  // {2.5, 2.2, 2.5}, radial 5.6, living 1.5 +- 0.5 s, sized 0.21 +- 0.09, colored {78, 94, 46}
  // through {58, 68, 36} at 0.5 to {40, 44, 28}
  chunks {
    Position: {0, 0, 0}
    ParticleEmitter: {
      max: 10,
      rate: 0,
      shape: EmitterSphere,
      radius: 1,
      direction: {0, 1, 0},
      spread: 24,
      speed: {3.4, 7.8},
      radial: {5.6, 5.6},
      lifetime: {1, 2},
      size: {0.12, 0.3},
      rotation: {-180, 180},
      spin: {-688, 688},
      color: {150, 163, 118},
      seed: 211
    }
    ParticleBurst: {count: 10}
    ParticleForces: {gravity: {0, -17, 0}, drag: 0.3}
    ParticleAppearance: {
      shape: ParticleSprite,
      texture: sprChunk,
      lit: 1
    }
    ParticleCurves: {
      opacity: {keys: [{0, 1}, {0.33333334, 1}, {0.6666667, 1}, {1, 0}]},
      color: {keys: [
        {0, {255, 255, 255}},
        {0.33333334, {237, 235, 241}},
        {0.6666667, {218, 213, 228}},
        {1, {198, 189, 215}}
      ]}
    }
  }

  // The spores: 24 particles of the glow pool, from a ring of 1.3 and 0.35 thick, offset
  // {0, -0.85, 0}, radial 7, living 0.5 +- 0.1 s, sized 0.5 +- 0.14 growing 0.9 a second
  // stretched 0.45, colored {214, 255, 158, 240} to {92, 186, 66, 0}
  spores {
    Position: {0, -0.85, 0}
    ParticleEmitter: {
      max: 24,
      rate: 0,
      shape: EmitterMesh,
      source: shapeSporeRing,
      direction: {0, 0, 0},
      speed: {0, 0},
      radial: {7, 7},
      lifetime: {0.4, 0.6},
      size: {0.36, 0.64},
      color: {236, 255, 206},
      seed: 212
    }
    ParticleBurst: {count: 24}
    ParticleForces: {gravity: {0, -4, 0}, drag: 1.5}
    ParticleAppearance: {
      shape: ParticleSprite,
      blend: ParticleAdditive,
      texture: sprSpark,
      softness: 0.25,
      lit: 0
    }
    ParticleCurves: {
      size: {keys: [{0, 1.25}, {0.33333334, 1.17}, {0.6666667, 0.76}, {1, 0.1}]},
      opacity: {keys: [{0, 0.94}, {0.33333334, 0.63}, {0.6666667, 0.29}, {1, 0}]},
      color: {keys: [
        {0, {255, 255, 255}},
        {0.33333334, {233, 245, 233}},
        {0.6666667, {207, 234, 207}},
        {1, {176, 222, 176}}
      ]}
    }
  }

  // The cinders: 9 particles of the ember pool, from a sphere of 0.85, offset {0, -0.35, 0}, at
  // {0, 1, 0} +- {0.8, 0.6, 0.8}, radial 1.4, living 1.35 +- 0.55 s, sized 0.12 +- 0.05, colored
  // {255, 138, 52} through {236, 92, 34} at 0.45 to {58, 26, 16, 140}
  cinders {
    Position: {0, -0.35, 0}
    ParticleEmitter: {
      max: 9,
      rate: 0,
      shape: EmitterSphere,
      radius: 0.85,
      direction: {0, 1, 0},
      spread: 39,
      speed: {0.4, 1.6},
      radial: {1.4, 1.4},
      lifetime: {0.8, 1.9},
      size: {0.07, 0.17},
      color: {255, 194, 125},
      seed: 213
    }
    ParticleBurst: {count: 9}
    ParticleForces: {gravity: {0, 0.8, 0}, drag: 1.1, turbulence: 1.8, turbulence_scale: 1.1}
    ParticleAppearance: {
      shape: ParticleSprite,
      blend: ParticleAdditive,
      texture: sprSpark,
      softness: 0.25,
      lit: 0
    }
    ParticleCurves: {
      size: {keys: [{0, 1.25}, {0.33333334, 0.9}, {0.6666667, 0.47}, {1, 0.05}]},
      opacity: {keys: [{0, 0.15}, {0.33333334, 0.77}, {0.6666667, 0.49}, {1, 0}]},
      color: {keys: [
        {0, {255, 255, 255}},
        {0.33333334, {249, 227, 230}},
        {0.6666667, {211, 188, 203}},
        {1, {131, 130, 174}}
      ]}
    }
  }

  // The soot: 12 particles of the smoke pool, from a hemisphere of 0.95, offset {0, 0.1, 0}, at
  // {0, 2.2, 0} +- {0.8, 0.6, 0.8}, radial 3.2, living 1.5 +- 0.5 s, sized 0.55 +- 0.24 growing
  // 0.9 a second, colored {74, 78, 54, 225} through {50, 50, 42, 190} at 0.35 to
  // {32, 32, 28, 60}
  soot {
    Position: {0, 0.1, 0}
    ParticleEmitter: {
      max: 12,
      rate: 0,
      shape: EmitterMesh,
      source: shapeSootDome,
      direction: {0, 1, 0},
      spread: 20,
      speed: {1.6, 2.8},
      radial: {3.2, 3.2},
      lifetime: {1, 2},
      size: {0.31, 0.79},
      rotation: {-180, 180},
      spin: {-63, 63},
      color: {147, 150, 127},
      seed: 214
    }
    ParticleBurst: {count: 12}
    ParticleForces: {gravity: {0, -0.6, 0}, drag: 0.9, turbulence: 1.5, turbulence_scale: 0.55}
    ParticleAppearance: {
      shape: ParticleSprite,
      texture: sprPuff,
      softness: 0.5,
      lit: 0.85
    }
    ParticleCurves: {
      size: {keys: [{0, 0.35}, {0.33333334, 2.27}, {0.6666667, 4.65}, {1, 7.25}]},
      opacity: {keys: [{0, 0}, {0.33333334, 0.6}, {0.6666667, 0.3}, {1, 0}]},
      color: {keys: [
        {0, {255, 255, 255}},
        {0.33333334, {221, 217, 234}},
        {0.6666667, {205, 200, 219}},
        {1, {187, 183, 203}}
      ]}
    }
  }

  // The flash light of oreCombust at the center of the body, acid green: it starts at its peak
  // and fades linearly to 0 over 1 / 7 s. ore_combust sets the peak of a play to
  // cfg.combustPeak * sqrt(r) and its range to cfg.combustRange + cfg.combustRangeRadius * r
  light {
    Position: {0, 0, 0}
    Rgb: {212, 255, 180}
    PointLight: {intensity: 4.5, range: 7}
    EffectFlash: {intensity: 4.5, seconds: 0.143}
  }
}

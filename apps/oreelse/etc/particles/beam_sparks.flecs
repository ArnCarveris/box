// Sparks where a laser beam lands, the BeamSparks of the original, with a light of the
// beam's color. The turret plays it at the end of the beam while the beam is on; the
// box.particle.Light of the emitter lights the light at peak while it plays and turns it off at
// once when it stops. The sparks start white and take the beam's color by 0.3 of their life,
// a ramp computed for the default color.

using box.types
using box.light
using box.particle
using box.material

template BeamSparks {
  prop color: rgb = {248, 165, 214}
  prop rate: f32 = 180
  prop peak: f32 = 5
  prop radius: f32 = 5.5

  Rgb: {color.r, color.g, color.b}
  PointLight: {intensity: 0, range: radius}
  box.particle.Light: {intensity: peak}

  // The stream: 180 a second into the glow pool, from a sphere of 0.07, at {0, 1.2, 0} +-
  // {2.4, 2.4, 2.4}, radial 3.2, living 0.34 +- 0.1 s, sized 0.12 +- 0.05 growing -0.22 a
  // second, colored {255, 250, 252} through {240, 96, 172} at 0.3 to {120, 30, 80, 0}
  Emitter: {
    max: 119,
    rate: rate,
    shape: EmitterSphere,
    radius: 0.07,
    direction: {0, 1, 0},
    spread: 63,
    speed: {0, 3.6},
    radial: {3.2, 3.2},
    lifetime: {0.24, 0.44},
    size: {0.07, 0.17},
    color: {255, 253, 254},
    seed: 231
  }
  Playback: {state: Stopped}
  Forces: {gravity: {0, -4, 0}, drag: 1.5}
  Appearance: {
    shape: Sprite,
    blend: Additive,
    texture: sprSpark,
    softness: 0.25,
    lit: 0
  }
  Curves: {
    size: {keys: [{0, 1.25}, {0.33333334, 0.71}, {0.6666667, 0.28}, {1, 0.02}]},
    opacity: {keys: [{0, 1}, {0.33333334, 0.95}, {0.6666667, 0.44}, {1, 0}]},
    color: {keys: [
      {0, {255, 255, 255}},
      {0.33333334, {246, 164, 213}},
      {0.6666667, {217, 136, 186}},
      {1, {182, 98, 153}}
    ]}
  }
}

// Dust where a bullet or a missile hits the ground, the ImpactDust of the original.

using box.transform
using box.particle

prefab ImpactDust {
  // The burst: 12 particles of the fx pool, from a disc of 0.22, offset {0, 0.05, 0}, at
  // {0, 1.1, 0} +- {0.5, 0.5, 0.5}, radial 2.6, living 0.62 +- 0.24 s, sized 0.19 +- 0.08
  // growing 0.7 a second, colored {198, 176, 148, 215} to {162, 148, 130, 80}
  particles {
    Position: {0, 0.05, 0}
    Emitter: {
      max: 12,
      rate: 0,
      shape: EmitterDisc,
      radius: 0.22,
      direction: {0, 1, 0},
      spread: 24,
      speed: {0.6, 1.6},
      radial: {2.6, 2.6},
      lifetime: {0.38, 0.86},
      size: {0.11, 0.27},
      rotation: {-180, 180},
      spin: {-138, 138},
      color: {228, 216, 200},
      seed: 222
    }
    Burst: {count: 12}
    Forces: {gravity: {0, -5, 0}, drag: 2.5, turbulence: 0.7, turbulence_scale: 1.2}
    Appearance: {
      shape: Sprite,
      texture: sprPuff,
      softness: 0.35,
      lit: 0.8
    }
    Curves: {
      size: {keys: [{0, 0.45}, {0.33333334, 2.06}, {0.6666667, 3.53}, {1, 4.93}]},
      opacity: {keys: [{0, 0.84}, {0.33333334, 0.67}, {0.6666667, 0.44}, {1, 0}]},
      color: {keys: [
        {0, {255, 255, 255}},
        {0.33333334, {248, 249, 251}},
        {0.6666667, {241, 243, 246}},
        {1, {234, 237, 241}}
      ]}
    }
  }
}

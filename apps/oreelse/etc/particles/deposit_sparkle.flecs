// Glints rising off a Luminite deposit, the DepositSparkle of the original: a few pale blue
// sparks a second over the pad of the deposit. On a deposit OreDepositSparkle plays it while the
// game plays and OreDepositSparkleHold pauses it otherwise. The layers are children at the
// original's offset of 0.18 above the deposit.

using box.transform
using box.types
using box.particle

template DepositSparkle {
  prop color: rgb = {222, 248, 255}
  prop rate: f32 = 2.4

  // The glints: 2.4 a second into the ember pool, from a disc of 0.5, offset {0, 0.18, 0}, at
  // {0, 0.55, 0} +- {0.12, 0.2, 0.12}, living 1.3 +- 0.5 s, sized 0.055 +- 0.025, colored
  // {186, 240, 255, 235} through {130, 210, 255, 200} at 0.5 to {70, 150, 220, 0}
  sparkle {
    Position: {0, 0.18, 0}
    Emitter: {
      max: 7,
      rate: rate,
      shape: EmitterDisc,
      radius: 0.5,
      direction: {0, 1, 0},
      spread: 12,
      speed: {0.35, 0.75},
      lifetime: {0.8, 1.8},
      size: {0.03, 0.08},
      color: color,
      seed: 236
    }
    Forces: {gravity: {0, 0.8, 0}, drag: 1.1, turbulence: 1.8, turbulence_scale: 1.1}
    Appearance: {
      shape: Sprite,
      blend: Additive,
      texture: sprSpark,
      softness: 0.25,
      lit: 0
    }
    Curves: {
      size: {keys: [{0, 1.25}, {0.33333334, 0.9}, {0.6666667, 0.47}, {1, 0.05}]},
      opacity: {keys: [{0, 0.14}, {0.33333334, 0.64}, {0.6666667, 0.31}, {1, 0}]},
      color: {keys: [
        {0, {255, 255, 255}},
        {0.33333334, {232, 246, 255}},
        {0.6666667, {203, 230, 250}},
        {1, {167, 208, 239}}
      ]}
    }
  }

  // The glints again, twice as large at half the opacity and with the same seed, so a halo
  // sits on each of its particles: the original's ember pool is emissive at 2.2, brighter than
  // box draws a particle, and it looks flat without it
  sparkle_halo {
    Position: {0, 0.18, 0}
    Emitter: {
      max: 7,
      rate: rate,
      shape: EmitterDisc,
      radius: 0.5,
      direction: {0, 1, 0},
      spread: 12,
      speed: {0.35, 0.75},
      lifetime: {0.8, 1.8},
      size: {0.06, 0.16},
      opacity: {0.5, 0.5},
      color: color,
      seed: 236
    }
    Forces: {gravity: {0, 0.8, 0}, drag: 1.1, turbulence: 1.8, turbulence_scale: 1.1}
    Appearance: {
      shape: Sprite,
      blend: Additive,
      texture: sprFlare,
      softness: 0.25,
      lit: 0
    }
    Curves: {
      size: {keys: [{0, 1.25}, {0.33333334, 0.9}, {0.6666667, 0.47}, {1, 0.05}]},
      opacity: {keys: [{0, 0.14}, {0.33333334, 0.64}, {0.6666667, 0.31}, {1, 0}]},
      color: {keys: [
        {0, {255, 255, 255}},
        {0.33333334, {232, 246, 255}},
        {0.6666667, {203, 230, 250}},
        {1, {167, 208, 239}}
      ]}
    }
  }
}

// The camera, its zoom level, the render quality tier and the session seed (OreSeed) are not
// part of a run.

using flecs.script.math
using box.transform
using oreelse

astronaut {
  OreRunScript
  Position: {0, 0, 0}
  Rotation: {0, PI, 0}
  Astronaut: {}
  OrePlayer: {moving: false, running: false}
  OreCrafter: {speed: 1}
  OreHealth: {value: cfg.playerHp, max: cfg.playerHp}
  OreHurt: {since: 0}
}

// Placement puts the buildings and the connectors between them here
buildings {}

// The waves spawn the critters here
critters {}


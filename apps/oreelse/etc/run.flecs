// A new run: the astronaut at the center of the map facing north, and the clock, the blink
// signals, the toast and the generator of the run. oreelse.restart() reloads this script (it
// created the astronaut, which has OreRunScript), deposits.flecs and scenery.flecs: the reload
// deletes the astronaut and creates it again, so nothing of the previous run stays. The camera,
// its zoom level, the render quality tier and the session seed (OreSeed) are not part of a run.

using flecs.script.math
using box.transform
using oreelse

astronaut {
  OreRunScript
  Position: {0, 0, 0}
  Rotation: {0, PI, 0}
  Astronaut: {}
  OrePlayer: {moving: false, running: false}
}

$ {
  OreRandom: {state: oreelse.seed(0)}
  OreClock: {elapsed: 0}
  OreBlink: {fast: false, slow: false, lamp: true}
  OreToast: {text: "", warn: false, age: 0}
}

// The landing marking of a drone bay, the BayPad of the original: the bay texture and its
// normal map on a quad. The drone pad wears it.

using box.geometry
using box.material
using box.texture

bay_tex {
  TexturePath: {path: "apps/oreelse/etc/assets/drone_bay.svg", width: 256, height: 256}
}

bay_norm {
  TexturePath: {path: "apps/oreelse/etc/assets/drone_bay_normal.svg", width: 256, height: 256}
}

prefab BayPad {
  Quad: {1.46, 1.46}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0.35, roughness: 0.58}
  PbrTextures: {albedo: bay_tex, normal: bay_norm}
}

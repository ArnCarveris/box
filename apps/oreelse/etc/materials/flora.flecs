// The blade and membrane cutouts of the flora, the FloraFrond, FloraFrondB, FloraMembrane and
// FloraMembraneB of the original: an alien blade or membrane texture with its normal map on a
// unit quad, which the plants of props/flora.flecs scale to their size. The original blends their
// alpha; here they are alpha tested (AlphaCutoff), so they draw in the opaque pass with clean
// edges and cast shadows with the holes of the texture.
//
// Each face is one side: the quad faces +Z and its back is culled. A blade is two faces back to
// back, the prefab and its child back turned by PI about y, so it shows its texture from both
// sides as the original's.

using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.texture

frond_tex {
  TexturePath: {path: "apps/oreelse/etc/assets/flora_frond.svg", width: 256, height: 256}
}

frond_b_tex {
  TexturePath: {path: "apps/oreelse/etc/assets/flora_frond_b.svg", width: 256, height: 256}
}

frond_norm {
  TexturePath: {path: "apps/oreelse/etc/assets/flora_frond_normal.svg", width: 256, height: 256}
}

membrane_tex {
  TexturePath: {path: "apps/oreelse/etc/assets/flora_pad.svg", width: 256, height: 256}
}

membrane_b_tex {
  TexturePath: {path: "apps/oreelse/etc/assets/flora_pad_b.svg", width: 256, height: 256}
}

membrane_norm {
  TexturePath: {path: "apps/oreelse/etc/assets/flora_pad_normal.svg", width: 256, height: 256}
}

// One side of each material
prefab FloraFrondFace {
  Quad: {1, 1}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0, roughness: 0.78}
  PbrTextures: {albedo: frond_tex, normal: frond_norm}
  Emissive: {strength: 0.18, color: {112, 84, 122}}
  AlphaCutoff: {value: 0.5}
}

prefab FloraFrondBFace {
  Quad: {1, 1}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0, roughness: 0.78}
  PbrTextures: {albedo: frond_b_tex, normal: frond_norm}
  Emissive: {strength: 0.18, color: {88, 94, 128}}
  AlphaCutoff: {value: 0.5}
}

prefab FloraMembraneFace {
  Quad: {1, 1}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0, roughness: 0.7}
  PbrTextures: {albedo: membrane_tex, normal: membrane_norm}
  Emissive: {strength: 0.18, color: {84, 90, 124}}
  AlphaCutoff: {value: 0.5}
}

prefab FloraMembraneBFace {
  Quad: {1, 1}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0, roughness: 0.7}
  PbrTextures: {albedo: membrane_b_tex, normal: membrane_norm}
  Emissive: {strength: 0.18, color: {114, 88, 108}}
  AlphaCutoff: {value: 0.5}
}

// The blades and membranes the plants use, both sides
prefab FloraFrond : FloraFrondFace {
  back : FloraFrondFace {
    Position: {0, 0, 0}
    Rotation: {0, PI, 0}
  }
}

prefab FloraFrondB : FloraFrondBFace {
  back : FloraFrondBFace {
    Position: {0, 0, 0}
    Rotation: {0, PI, 0}
  }
}

prefab FloraMembrane : FloraMembraneFace {
  back : FloraMembraneFace {
    Position: {0, 0, 0}
    Rotation: {0, PI, 0}
  }
}

prefab FloraMembraneB : FloraMembraneBFace {
  back : FloraMembraneBFace {
    Position: {0, 0, 0}
    Rotation: {0, PI, 0}
  }
}

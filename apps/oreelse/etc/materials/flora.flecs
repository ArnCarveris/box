// The blade and membrane cutouts of the flora, the FloraFrond, FloraFrondB, FloraMembrane and
// FloraMembraneB of the original: an alien blade or membrane texture with its normal map on a
// unit quad, which the plants of props/flora.flecs scale to their size. The original blends their
// alpha; here they are alpha tested (AlphaCutoff), so they draw in the opaque pass with clean
// edges and cast shadows with the holes of the texture.
//
// Each prefab is one side: the quad faces +Z and its back is culled. The plants draw a blade as
// two of them back to back, the blade and its child back turned by PI about y, so it shows its
// texture from both sides as the original's (props/flora.flecs).

using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.texture

frond_tex {
  TexturePath: {
    path: "apps/oreelse/etc/assets/flora_frond.svg", width: 256, height: 256, linear: true
  }
}

frond_b_tex {
  TexturePath: {
    path: "apps/oreelse/etc/assets/flora_frond_b.svg", width: 256, height: 256, linear: true
  }
}

frond_norm {
  TexturePath: {path: "apps/oreelse/etc/assets/flora_frond_normal.svg", width: 256, height: 256}
}

membrane_tex {
  TexturePath: {
    path: "apps/oreelse/etc/assets/flora_pad.svg", width: 256, height: 256, linear: true
  }
}

membrane_b_tex {
  TexturePath: {
    path: "apps/oreelse/etc/assets/flora_pad_b.svg", width: 256, height: 256, linear: true
  }
}

membrane_norm {
  TexturePath: {path: "apps/oreelse/etc/assets/flora_pad_normal.svg", width: 256, height: 256}
}

prefab FloraFrond {
  Quad: {1, 1}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0, roughness: 0.78}
  PbrTextures: {albedo: frond_tex, normal: frond_norm}
  Emissive: {strength: 0.18, color: {177, 155, 184}}
  AlphaCutoff: {value: 0.5}
}

prefab FloraFrondB {
  Quad: {1, 1}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0, roughness: 0.78}
  PbrTextures: {albedo: frond_b_tex, normal: frond_norm}
  Emissive: {strength: 0.18, color: {159, 163, 188}}
  AlphaCutoff: {value: 0.5}
}

prefab FloraMembrane {
  Quad: {1, 1}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0, roughness: 0.7}
  PbrTextures: {albedo: membrane_tex, normal: membrane_norm}
  Emissive: {strength: 0.18, color: {155, 160, 185}}
  AlphaCutoff: {value: 0.5}
}

prefab FloraMembraneB {
  Quad: {1, 1}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0, roughness: 0.7}
  PbrTextures: {albedo: membrane_b_tex, normal: membrane_norm}
  Emissive: {strength: 0.18, color: {178, 159, 174}}
  AlphaCutoff: {value: 0.5}
}

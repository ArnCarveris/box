// The hazard stripe texture and the trim pieces of the original that wear it. HazardBoundary
// is the band around the playable area (boundary.flecs); the others trim the buildings.
//
// The original repeats the texture scale_x times along the length (x) of a trim and scale_y
// times across it (z). The top face of box's Box runs u along z and v against x, so the scales
// trade places here, and the negative v scale keeps the slant of the stripes.

using box.geometry
using box.material
using box.texture

hazard_tex {
  Path: {
    path: "apps/oreelse/etc/assets/hazard_stripes.svg", width: 256, height: 256, linear: true
  }
}

prefab HazardTag {
  Box: {1.1, 0.06, 0.3}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0.2, roughness: 0.68}
  PbrTextures: {albedo: hazard_tex}
  texture.Transform: {scale_x: 1, scale_y: -3}
}

prefab HazardTrim {
  Box: {2.04, 0.06, 0.34}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0.2, roughness: 0.68}
  PbrTextures: {albedo: hazard_tex}
  texture.Transform: {scale_x: 1, scale_y: -5}
}

prefab HazardTrimShort {
  Box: {1.08, 0.06, 0.3}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0.2, roughness: 0.68}
  PbrTextures: {albedo: hazard_tex}
  texture.Transform: {scale_x: 1, scale_y: -2.7}
}

prefab HazardBorderShort {
  Box: {4.4, 0.06, 0.34}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0.2, roughness: 0.68}
  PbrTextures: {albedo: hazard_tex}
  texture.Transform: {scale_x: 1, scale_y: -11}
}

prefab HazardBorderLong {
  Box: {5.5, 0.06, 0.34}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0.2, roughness: 0.68}
  PbrTextures: {albedo: hazard_tex}
  texture.Transform: {scale_x: 1, scale_y: -14}
}

prefab HazardBoundary {
  Box: {8, 0.06, 0.9}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0.2, roughness: 0.68}
  PbrTextures: {albedo: hazard_tex}
  texture.Transform: {scale_x: 2.5, scale_y: -22}
}

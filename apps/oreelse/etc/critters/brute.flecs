// The brute, the Brute prefab of the original: a big red body of boxes with spikes on its
// abdomen, a crested head with two glowing orange eyes, mandibles and tusks, and six legs. Its
// origin is between its feet on the ground and it faces +Z. The legs are pivots with OreLimb
// at the hips; here they stand still. OreCritters gives the prefab its gameplay data.

using flecs.script.math
using box.transform
using box.geometry
using box.material
using oreelse

const bruteShell: Rgb = {148, 62, 54}
const bruteDark: Rgb = {88, 34, 32}
const bruteLimb: Rgb = {58, 26, 26}
const bruteEye: Rgb = {255, 120, 64}
const bruteTusk: Rgb = {236, 226, 204}

prefab Brute {
  abdomen {
    Position: {0, 1.04, -0.86}
    Rotation: {0.22, 0, 0}
    Box: {1.14, 0.96, 1.24}
    Rgb: bruteDark

    spike_a {
      Position: {-0.3, 0.56, 0.1}
      Rotation: {-0.3, 0, -0.3}
      Cone: {segments: 8, smooth: true, length: 0.5, radius: 0.5}
      Scale: {0.14, 1, 0.14}
      Rgb: bruteShell
    }

    spike_b {
      Position: {0.3, 0.56, -0.16}
      Rotation: {-0.3, 0, 0.3}
      Cone: {segments: 8, smooth: true, length: 0.5, radius: 0.5}
      Scale: {0.14, 1, 0.14}
      Rgb: bruteShell
    }
  }

  thorax {
    Position: {0, 1.08, 0.16}
    Box: {1.18, 0.9, 1.0}
    Rgb: bruteShell

    carapace {
      Position: {0, 0.44, -0.06}
      Box: {1.0, 0.24, 0.84}
      Rgb: bruteDark
    }
  }

  head {
    Position: {0, 0.94, 0.88}
    Box: {0.82, 0.62, 0.7}
    Rgb: bruteDark

    crest {
      Position: {0, 0.36, -0.08}
      Box: {0.7, 0.18, 0.5}
      Rgb: bruteShell
    }

    eye_left {
      Position: {-0.24, 0.1, 0.35}
      Box: {0.18, 0.14, 0.06}
      Rgb: bruteEye
      Emissive: {strength: 2.6, color: bruteEye}
    }

    eye_right {
      Position: {0.24, 0.1, 0.35}
      Box: {0.18, 0.14, 0.06}
      Rgb: bruteEye
      Emissive: {strength: 2.6, color: bruteEye}
    }

    mandible_left {
      Position: {-0.3, -0.24, 0.44}
      Rotation: {0, 0.5, 0}
      Box: {0.14, 0.16, 0.56}
      Rgb: bruteLimb
    }

    mandible_right {
      Position: {0.3, -0.24, 0.44}
      Rotation: {0, -0.5, 0}
      Box: {0.14, 0.16, 0.56}
      Rgb: bruteLimb
    }

    tusk_left {
      Position: {-0.2, -0.34, 0.6}
      Rotation: {0.5, 0, 0}
      Cone: {segments: 8, smooth: true, length: 0.34, radius: 0.5}
      Scale: {0.09, 1, 0.09}
      Rgb: bruteTusk
    }

    tusk_right {
      Position: {0.2, -0.34, 0.6}
      Rotation: {0.5, 0, 0}
      Cone: {segments: 8, smooth: true, length: 0.34, radius: 0.5}
      Scale: {0.09, 1, 0.09}
      Rgb: bruteTusk
    }
  }

  // Three rows of legs, even ones on the left (+X), odd ones on the right
  for i in 0..6 {
    const side: f32 = 1 - 2 * (i % 2)
    const row: f32 = floor(i / 2)

    "leg_{i}" {
      Position: {side * 0.58, 0.84, 0.48 - row * 0.54}
      OreLimb: {phase: i * 1.05, swing: 0.42}

      thigh {
        Position: {side * 0.36, 0.06, 0}
        Rotation: {0, 0, side * -0.55}
        Box: {0.72, 0.16, 0.16}
        Rgb: bruteLimb
      }

      shin {
        Position: {side * 0.72, -0.36, 0}
        Box: {0.16, 0.72, 0.16}
        Rgb: bruteLimb
      }

      foot {
        Position: {side * 0.72, -0.72, 0.06}
        Box: {0.26, 0.13, 0.38}
        Rgb: bruteLimb
      }
    }
  }
}

// The bullet of the gun turret and the astronaut's pistol, the Tracer prefab of the original: a
// glowing gold streak that lights what it passes. Its origin is its center and it flies along
// +Z. It hits the nearest live critter within 0.55 on XZ and expires after 0.7 s, without
// gravity (OreProjectileFly).

using box.transform
using box.geometry
using box.material
using box.light
using oreelse

const tracerGold: Rgb = {255, 242, 188}

prefab Tracer {
  OreProjectile: {vx: 0, vy: 0, vz: 0, life: 0.7, radius: 0.55}

  core {
    Position: {0, 0, 0}
    Box: {0.08, 0.08, 0.42}
    Rgb: tracerGold
    Emissive: {strength: 3.2, color: tracerGold}
    // A moving light, left out of any bake
    PointLight: {intensity: 2.6, range: 4.5, bake: Realtime}
  }
}

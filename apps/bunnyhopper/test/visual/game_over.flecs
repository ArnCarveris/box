// The dead bunny lying on its back, the world stopped, under the game over panel of the HUD.
// The capture is 640x360: the HUD lays out for a 1280x720 window and its camera shows it at
// half size, so the capture holds the whole HUD as a 1280x720 window shows it.
include etc/bunnyhopper/bunnyhopper

using box.camera
using box.surface
using bunnyhopper

window {
  Surface: {width: 1280, height: 720}
}

hud {
  ui {
    camera {
      Camera: {ortho: true, ortho_scale: 0.5}
    }
  }
}

player {
  Bunny: {speed: 0, dead: true}
  BunnyLives: {lives_left: 0}
}

$ {
  (BunnyGameState, Over)
}

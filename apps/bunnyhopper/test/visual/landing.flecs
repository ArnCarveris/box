// A hard landing two frames in, seen from close behind the bunny: the bunny, back on the
// ground after a double jump, kicks up the high dust around its feet, which the scrolling track
// starts to carry away behind it
include apps/bunnyhopper/etc/bunnyhopper

using flecs.script.math
using box.transform
using box.camera
using bunnyhopper

player {
  Position: {-7, 0.3, 0}
  BunnyJump: {v: -18, jumps: 2}
}

// Low behind the bunny, looking at its back feet at (-7.4, 0.15, 0)
camera {
  Position: {-9, 0.6, 1.6}
  Rotation: {-atan2(0.45, sqrt(1.6 * 1.6 + 1.6 * 1.6)), -atan2(1.6, 1.6), 0}
}

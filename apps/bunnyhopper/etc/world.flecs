// The world: the static ground and track, the scenery, the bunny, the parent of the carrots and
// the BunnyGame singleton that ties them together with the carrot prefabs and the effects.

using flecs.script.math
using box.transform
using box.geometry
using box.material
using bunnyhopper

ground {
  Position: {0, -0.5, -10}
  Box: {200, 1, 90}
  Rgb: {100, 170, 85}
}

track {
  Position: {0, -0.48, 0}
  Box: {200, 1, 3.2}
  Rgb: {185, 155, 105}
}

// The scenery layout, the same for every run with the same seed
const rng: Rng = {seed: cfg.seed}

scenery {
  // Tufts on both sides of the track, in front of it for odd i and behind it for even i
  for i in 0..12 {
    "tuft_{i}" {
      (IsA, GrassTuft)
      DynamicTransform
      Position: {-30 + 5.2 * i + rng.f(3), 0, -2.5 + 4.5 * (i % 2)}
      Scale: {0.5 + rng.f(0.4), 0.25 + rng.f(0.25), 1}
    }
  }

  for i in 0..5 {
    "tree_{i}" {
      (IsA, Tree)
      DynamicTransform
      const s = 0.875 + rng.f(0.25)
      Position: {-32 + 14 * i + rng.f(6), 0, -10}
      Scale: {s, s, s}
    }
  }

  for i in 0..4 {
    "hill_{i}" {
      (IsA, Hill)
      DynamicTransform
      const s = 8 + rng.f(5)
      Position: {-40 + 22 * i + rng.f(8), 0, -32}
      Scale: {s, s, s}
    }
  }
}

// The bunny runs in place; the world scrolls past it. Its look is in player.flecs
player {
  Position: {-7, cfg.groundY, 0}
  Rotation: {0, 0, 0}
  DynamicTransform
  Bunny: {speed: cfg.initialSpeed}
  BunnyPlayer: {}
  BunnyJump: {}
  BunnyLives: {lives_left: cfg.maxLives}
}

// Parent of the spawned carrots
carrots {}

$ {
  BunnyGame: {
    max_lives: cfg.maxLives,
    speed: cfg.initialSpeed,
    next_spawn_distance: 6,
    seed: cfg.seed,
    player: player,
    carrot_parent: carrots,
    small_carrot: SmallCarrot,
    large_carrot: LargeCarrot,
    dust: LandingDust,
    dust_high: HardLandingDust,
    sparkle: CarrotSparkle,
    hit: HitBurst,
    effect_wind: effect_wind
  }
}

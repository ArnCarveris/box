// The world: the static ground and track, the scenery and the bunny. run.flecs sets up a run.

using flecs.script.math
using box.transform
using box.geometry
using box.material
using bunnyhopper

ground {
  Position: {0, -0.5, -10}
  Box: {200, 1, 90}
  Rgb: {100, 170, 85}
}

track {
  Position: {0, -0.48, 0}
  Box: {200, 1, 3.2}
  Rgb: {185, 155, 105}
}

// The scenery layout, the same for every run with the same seed
const rng: Rng = {seed: cfg.seed}

scenery {
  // Tufts on both sides of the track, in front of it for odd i and behind it for even i
  for i in 0..12 {
    "tuft_{i}" {
      (IsA, GrassTuft)
      DynamicTransform
      Position: {-30 + 5.2 * i + rng.f(3), 0, -2.5 + 4.5 * (i % 2)}
      Scale: {0.5 + rng.f(0.4), 0.25 + rng.f(0.25), 1}
    }
  }

  for i in 0..5 {
    "tree_{i}" {
      (IsA, Tree)
      DynamicTransform
      const s = 0.875 + rng.f(0.25)
      Position: {-32 + 14 * i + rng.f(6), 0, -10}
      Scale: {s, s, s}
    }
  }

  for i in 0..4 {
    "hill_{i}" {
      (IsA, Hill)
      DynamicTransform
      const s = 8 + rng.f(5)
      Position: {-40 + 22 * i + rng.f(8), 0, -32}
      Scale: {s, s, s}
    }
  }
}

// The bunny runs in place; the world scrolls past it. It is created here, so a reload of
// run.flecs, which puts it at the start of a run, keeps it. Its look is set in run.flecs
player {
  DynamicTransform
}

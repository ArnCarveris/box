// The bunny, built from boxes. It faces +x, its origin is between its feet on the ground. The
// player's Bunny component drives the props: speed tilts the ears back, dead crosses out the
// eyes and rolls the bunny on its back, hurt blinks it red while a carrot hit protects it. The
// legs are pivots with BunnyLeg that the bunnyhopper systems swing.

using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.animation
using box.transition
using bunnyhopper

$ {
  box.view.Scene: {sheen: true}
}

// Soft white fur with a sheen at grazing angles
prefab BunnyFur {
  Rgb: {240, 240, 240}
  Sheen: {color: {255, 250, 245}, roughness: 0.45}
}

// The red blink of a hurt bunny: the strength of the Tint of the pose, 0 at the start, so a
// paused animator seeked to 0 leaves the bunny untinted
bunny_hurt_blink {
  AnimationClip: {duration: 0.16}

  strength {
    AnimationTrack: {component: Tint, member: "a", curve: {keys: [{0, 0}, {0.08, 150}, {0.16, 0}]}}
  }
}

template BunnyModel {
  prop speed: f32 = 12
  prop dead: bool = false
  prop hurt: bool = false

  const eye: Rgb = {40, 40, 40}
  const earTilt = clamp((speed - 12) * 0.05, -0.45, 0.75)
  const ease: TransitionSpec = {duration: 0.45, timing_function: EaseOut}

  // The dead bunny rolls onto its back, its origin cfg.deadHeight above the ground
  pose {
    Position: {0, dead ? cfg.deadHeight : 0, 0}
    Rotation: {0, 0, dead ? cfg.deadAngle : 0}
    Transition: [Position: ease, Rotation: ease]
    Tint: {255, 60, 60, 0}
    Animator: {clip: bunny_hurt_blink, time: 0, speed: 1, mode: AnimationLoop, paused: !hurt}

    body : BunnyFur {
      Position: {-0.05, 0.55, 0}
      Box: {1, 0.75, 0.6}
      Bevel: {radius: 0.12}
    }

    head : BunnyFur {
      Position: {0.5, 1.05, 0}
      Box: {0.55, 0.55, 0.5}
      Bevel: {radius: 0.12}
    }

    for i in 0..2 {
      "ear_{i}" : BunnyFur {
        Position: {0.38, 1.54, 0.28 * i - 0.14}
        Rotation: {0, 0, earTilt}
        Transition: [Rotation: {duration: 0.35, timing_function: EaseOut}]
        Box: {0.14, 0.7, 0.14}
        Bevel: {radius: 0.06}
      }
    }

    tail : BunnyFur {
      Position: {-0.62, 0.6, 0}
      Sphere: {segments: 12, smooth: true, radius: 0.18}
    }

    nose {
      Position: {0.79, 1.0, 0}
      Box: {0.1, 0.12, 0.14}
      Bevel: {radius: 0.035}
      Rgb: {245, 150, 170}
    }

    // Open eyes, or two crossed bars per eye once the bunny is dead
    for i in 0..2 {
      const z = 0.52 * i - 0.26

      if dead {
        "eye_{i}_bar_a" {
          Position: {0.68, 1.18, z}
          Rotation: {0, 0, PI / 4}
          Box: {0.16, 0.05, 0.06}
          Rgb: eye
        }

        "eye_{i}_bar_b" {
          Position: {0.68, 1.18, z}
          Rotation: {0, 0, -PI / 4}
          Box: {0.16, 0.05, 0.06}
          Rgb: eye
        }
      } else {
        "eye_{i}" {
          Position: {0.68, 1.18, z}
          Box: {0.08, 0.1, 0.06}
          Rgb: eye
        }
      }
    }

    // Legs: a pivot at the hip holding the leg below it. Left and right run half a cycle apart
    for i in 0..2 {
      const z = 0.48 * i - 0.24

      "leg_front_{i}" {
        Position: {0.32, 0.5, z}
        Rotation: {0, 0, 0}
        BunnyLeg: {phase: PI * i, air_target: 0.9}

        leg : BunnyFur {
          Position: {0, -0.25, 0}
          Box: {0.16, 0.5, 0.16}
          Bevel: {radius: 0.05}
        }
      }

      "leg_back_{i}" {
        Position: {-0.38, 0.5, z}
        Rotation: {0, 0, 0}
        BunnyLeg: {phase: PI * (i + 1), air_target: -0.95}

        leg : BunnyFur {
          Position: {0, -0.275, 0}
          Box: {0.22, 0.55, 0.22}
          Bevel: {radius: 0.07}
        }
      }
    }
  }
}

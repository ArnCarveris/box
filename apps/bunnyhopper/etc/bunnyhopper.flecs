// Bunny hopper: an endless runner. The bunny runs on a dirt track while the world scrolls past;
// SPACE hops over the carrots that grow out of the ground, a second press in the air double
// jumps over the large ones. A carrot costs a life, every 5 carrots the run gets faster, and
// with no lives left R starts a new run.

include config
include bunny
include carrots
include particles
include scenery
include world
include run
include player
include input
include hud

using flecs.script.math
using box.transform
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.atmosphere

window {
  Surface: {width: 1280, height: 1024, vsync: true}
}

// The camera looks from (0, 5, 16) at (0, 2.8, 0)
camera {
  Position: {0, 5, 16}
  Rotation: {-atan2(5 - 2.8, 16), 0, 0}
  Camera: {fov: 60, near_: 0.5, far_: 1000}
}

// The sun shines from (0.6, 2.2, 1.4) toward the origin, its +Z along -(0.6, 2.2, 1.4), with
// the intensity of the original game (a facing white surface reflects 2 / pi of it)
sun {
  Rotation: {asin(2.2 / sqrt(0.36 + 4.84 + 1.96)), atan2(-0.6, -1.4), 0}
  DirectionalLight: {intensity: 2}
  Rgb: {255, 255, 255}
}

// A daytime sky lit by the sun. The Atmosphere singleton is also the environment source the
// world view takes its ambient light from, so there is no hemisphere AmbientLight
$ {
  Atmosphere: {sun: sun}
}

// The metering of the original game: no share of the histogram left out at the dark end and a
// wider accepted brightness range than the defaults
exposure {
  AutoExposure: {min_log_luma: -16, low_percentile: 0, min_brightness: 0.05, max_brightness: 0.55}
}

ssao {
  Ssao: {radius: 0.5}
}

bloom {
  Bloom: {}
}

// Tony McMapface, as the original, desaturates the colors as they brighten
tonemap {
  Tonemap: {auto_exposure: exposure, operator_: TonyMcMapface}
}

main_view {
  View: {
    camera: camera,
    clear: {enabled: true, color: {150, 195, 235, 255}},
    // Lit by the sky of the atmosphere at half intensity, as the ambient_intensity 0.5 of the
    // original; the atmosphere draws the sky, so the environment draws no background
    lighting: {enabled: true, baked: true, reflections: true, atmosphere: true,
      environment: {source: Atmosphere, intensity: 0.5, yaw: 0, background: false}},
    shadows: {enabled: true, max_distance: 200},
    effects: [{effect: ssao}, {effect: bloom}, {effect: tonemap}]
  }
}

// The HUD (hud.flecs), created after the world view so it draws over it
hud {
  BunnyHud: {surface: window}
}

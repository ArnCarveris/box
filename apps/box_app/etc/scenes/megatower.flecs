@tree Parent
template Tank {
  prop radius: f32 = 0.8
  prop height: f32 = 2
  prop color: Rgb = {107, 136, 139}
  { Position: {0, height / 2, 0}; Cylinder: {radius: radius, length: height, segments: 16}; Rgb: color; Weathering: {dust: 0, grime: 0, edge: 0.65}; PbrMaterial: {roughness: 0.47, metallic: 0.4} }
  for i in 0..3 {
    { Position: {0, 0.15 + (height - 0.3) * i / 2, 0}; Torus: {radius: radius + 0.01, tube: 0.045, segments: 16, rings: 5}; Rgb: iron }
  }
  { Position: {0, height + 0.13, 0}; Cylinder: {radius: radius * 0.25, length: 0.25, segments: 10}; Rgb: iron }
  { Position: {0, height / 2, radius + 0.02}; Neon: {size: {0.1, height * 0.65, 0.04}, color: cyan, power: 1.7} }
}


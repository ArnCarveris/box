@tree Parent
template ExteriorRetrofit : Retrofit {
  const kind = seed % 8
  const reach = 1.25 + (seed % 4) * 0.22
  { Position: {0, height - 0.27, reach}; Box: {width - 0.15, 0.14, 1.15}; Rgb: {85 + seed % 45, 101, 106} }
  for side in 0..2 {
    { Position: {(side * 2 - 1) * width * 0.41, height - 0.68, reach - 0.2}; Rotation: {0.48, 0, 0}; Box: {0.11, 0.94, 0.13}; Rgb: rust }
    { Position: {(side * 2 - 1) * width * 0.42, height - 0.05, reach}; Box: {0.085, 0.5, 1.2}; Rgb: iron }
  }
  { Position: {0, height - 0.192, reach + 0.5}; Rotation: {-math.PI / 2, 0, 0}; { Position: {}; Surface: {image: hazardImages[seed % 8], fit: false, width: width - 0.21, height: 0.13} } }
  for slot in 0..2 {
    {
      Position: {(slot * 2 - 1) * width * 0.235, height - 0.19, reach}
      Scale: {0.8, 0.8, 0.8}
      if kind == 0 { { Position: {}; Compressor: {seed: seed + slot} } }
      if kind == 1 { { Position: {}; BatteryBank: {seed: seed + slot} } }
      if kind == 2 { { Position: {}; Winch: {seed: seed + slot} } }
      if kind == 3 {
        { Position: {0, 0.3, 0}; Vent: {seed: seed + slot} }
        { Position: {0, 0.92, 0}; Vent: {seed: seed + slot + 3} }
        { Position: {-0.5, 0, 0}; Umbilical: {seed: seed, length: 1} }
      }
      if kind == 4 {
        { Position: {}; RelayMast: {seed: seed + slot} }
        { Position: {-0.5, 0.05, 0.1}; Junction: {seed: seed}; Scale: {0.7, 0.7, 0.7} }
      }
      if kind == 5 {
        { Position: {}; GrowTray: {seed: seed + slot, width: 1.2} }
        { Position: {0.4, 0, -0.25}; Tank: {radius: 0.23, height: 0.75, color: leaf} }
      }
      if kind == 6 {
        for c in 0..2 {
          { Position: {-0.35 + c * 0.7, 0, 0}; Tank: {radius: 0.29, height: 1, color: {135, 127, 97}} }
        }
        { Position: {0, 0.6, 0}; Junction: {seed: seed} }
      }
      if kind == 7 {
        { Position: {0, 0, 0}; Crate: {seed: seed + slot}; Scale: {0.7, 0.7, 0.7} }
        { Position: {0.1, 0.54, 0}; Crate: {seed: seed + 19}; Scale: {0.6, 0.6, 0.6} }
        { Position: {-0.42, 0, 0.12}; RelayMast: {seed: seed}; Scale: {0.6, 0.6, 0.6} }
      }
    }
  }
  { Position: {width * 0.43, height - 1.35, reach - 0.3}; Umbilical: {seed: seed, length: 0.85} }
  if seed % 3 == 0 {
    { Position: {-width * 0.39, 1.9, reach + 0.58}; Rotation: {0, -0.18, -0.06};
      { Position: {}; Box: {0.64, 1.06, 0.065}; Rgb: iron }
      { Position: {0, 0, 0.036}; Surface: {image: posterImages[seed % 16], width: 0.6, height: 1, glow: 0.6} }
    }
  }
}


using flecs.script
using box.*

const iron: Rgb = {43, 58, 67}
const concrete: Rgb = {111, 122, 127}
const rust: Rgb = {136, 76, 56}
const cyan: Rgb = {55, 226, 237}
const pink: Rgb = {255, 66, 142}
const amber: Rgb = {255, 171, 66}
const leaf: Rgb = {48, 111, 86}

$ {
  Console: {}
  ScriptSettings: {enabled: false}
  EnvironmentLight: {sky_color: {166, 189, 213}, ground_color: {78, 91, 108}, intensity: 1.1}
}

camera {
  Position: {5.854, 4.744, 47.484}
  LookAt: {5.377, 5.105, 46.683}
  Camera: {fov: 55}
  CameraController: {speed: 12}
}
marketCamera {
  Position: {48, 23, 68}
  LookAt: {5, 17, 24}
  Camera: {fov: 58}
}
gardenCamera {
  Position: {54, 239, 72}
  LookAt: {0, 214, 18}
  Camera: {fov: 55}
}
floodedCamera {
  Position: {39, -7, 43}
  LookAt: {0, -10, 0}
  Camera: {fov: 62}
}

housingCamera {
  Position: {43, 166, 51}
  LookAt: {18, 157, 28}
  Camera: {fov: 53}
}
detailCamera {
  Position: {21, 110, 38}
  LookAt: {17, 109, 30}
  Camera: {fov: 55}
}

wealthCamera {
  Position: {49, 303, 62}
  LookAt: {5, 286, 12}
  Camera: {fov: 54}
}
commonsCamera {
  Position: {12, 220, 46}
  LookAt: {-8, 210, 21}
  Camera: {fov: 60}
}

sun {
  Rotation: {0.7, 2.4, 0}
  DirectionalLight: {intensity: 1.15}
  Rgb: {188, 205, 238}
}

post {
  ao : box.effects.gtao {
    Gtao: {radius: 2, slices: 3, steps: 4, power: 1.3, temporal: true, half_res: true}
  }
  reflection : box.effects.ssr {
    Ssr: {steps: 24, thickness: 0.8, max_roughness: 0.35, intensity: 0.55, fade: 0.2}
  }
  mist : box.effects.fog {
    Fog: {color: {0.035, 0.075, 0.11}, density: 0.01, falloff: 0.001, start: 1, max_opacity: 0.8, height: 8}
  }
  bloom : box.effects.bloom {
    Bloom: {intensity: 0.4, prefilter: {threshold: 1.2, threshold_softness: 0.5}, low_frequency_boost: 0.45}
  }
  tonemap : box.effects.tonemap {
    ToneMapping: {white: 1.2, dither: true}
  }
}
view {
  View: {
    camera: camera,
    clear: {12, 21, 34},
    culling: {enabled: true, gpu_threshold: 2048, occlusion: true, min_dimension_px: 0.6},
    shadows: {enabled: true, resolution: 2048, max_distance: 850},
    bake: {enabled: true, budget: 8192, probe_spacing: 2, probe_max: 8, occluder_min_size: 4},
    material_layers: [
      {layer: box.material.layers.edge_wear, enabled: true},
      {layer: box.material.layers.dust, enabled: true},
      {layer: box.material.layers.grime, enabled: true}
    ],
    effects: [
      {effect: post.ao, enabled: true},
      {effect: post.reflection, enabled: true},
      {effect: post.mist, enabled: true},
      {effect: post.bloom, enabled: true},
      {effect: post.tonemap, enabled: true}
    ]
  }
}

signs {
  tide {
    Svg: {width: 1024, height: 256, data: `<svg xmlns='http://www.w3.org/2000/svg' width='1024' height='256'><rect width='1024' height='256' fill='#101d26'/><path d='M28 24h968v208H28z' fill='none' stroke='#39dae6' stroke-width='5'/><text x='64' y='133' font-family='sans-serif' font-size='108' font-weight='bold' fill='#a2f6ed'>TIDE / 09</text><text x='68' y='198' font-family='sans-serif' font-size='32' letter-spacing='12' fill='#39dae6'>VERTICAL COMMONS</text></svg>`}
  }
  bath {
    Position: {}
    Svg: {width: 768, height: 256, data: `<svg xmlns='http://www.w3.org/2000/svg' width='768' height='256'><rect width='768' height='256' fill='#132e2e'/><text x='40' y='137' font-family='sans-serif' font-size='100' font-weight='bold' fill='#a6f4cf'>SKY BATHS</text><text x='44' y='210' font-family='sans-serif' font-size='32' letter-spacing='9' fill='#54d1b3'>GARDENS / LEVEL 60</text></svg>`}
  }
  corp {
    Svg: {width: 768, height: 256, data: `<svg xmlns='http://www.w3.org/2000/svg' width='768' height='256'><rect width='768' height='256' fill='#122434'/><text x='52' y='160' font-family='sans-serif' font-size='136' letter-spacing='17' fill='#9cdeff'>A E O N</text><text x='58' y='216' font-family='sans-serif' font-size='26' letter-spacing='13' fill='#5d95b1'>ABOVE THE EVERYDAY</text></svg>`}
  }
  transit {
    Svg: {width: 768, height: 256, data: `<svg xmlns='http://www.w3.org/2000/svg' width='768' height='256'><rect width='768' height='256' fill='#18282d'/><text x='35' y='130' font-family='sans-serif' font-size='86' font-weight='bold' fill='#86f3e2'>09 / TIDELINE</text><path d='M40 176h670' stroke='#f5ac5b' stroke-width='8'/><circle cx='120' cy='176' r='17' fill='#e8ece2'/><circle cx='380' cy='176' r='17' fill='#e8ece2'/><circle cx='630' cy='176' r='17' fill='#e8ece2'/></svg>`}
  }
}


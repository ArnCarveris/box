template TerraceFurniture {
  prop seed: i32 = 0
  const kind = seed % 6
  if kind == 0 {
    { Position: {}; CafeTable: {seed: seed, accent: amber} }
    { Position: {0.8, 0, -0.65}; Parasol: {seed: seed, radius: 1.2} }
  }
  if kind == 1 {
    { Position: {}; ChessTable: {seed: seed, accent: cyan} }
    { Position: {0.86, 0, 0.35}; SculptedPlanter: {seed: seed, size: 0.55} }
  }
  if kind == 2 {
    { Position: {-0.47, 0, 0}; Lounger: {seed: seed} }
    { Position: {0.47, 0, 0}; Lounger: {seed: seed + 7} }
    {
      Position: {1.2, 0, -0.5}
      TeaCart: {seed: seed, accent: amber}
      Scale: {0.6, 0.6, 0.6}
    }
  }
  if kind == 3 {
    { Position: {0, 0, -0.35}; Bench: {seed: seed, accent: cyan} }
    { Position: {-1.15, 0, -0.35}; SculptedPlanter: {seed: seed, size: 0.7} }
    { Position: {1.15, 0, -0.35}; SculptedPlanter: {seed: seed + 1, size: 0.7} }
  }
  if kind == 4 {
    { Position: {}; SkyGym: {seed: seed} }
    {
      Position: {1.3, 0, 0}
      Terminal: {seed: seed, accent: cyan}
      Scale: {0.7, 0.7, 0.7}
    }
  }
  if kind == 5 {
    { Position: {-0.75, 0, 0}; TeaCart: {seed: seed, accent: amber} }
    { Position: {0.9, 0, 0}; RobotPorter: {seed: seed, accent: cyan} }
  }
}

@tree Parent
template Garden {
  prop width: f32 = 35
  prop depth: f32 = 24
  prop seed: i32 = 0
  prop facade: template Frontage[] = [BathHouse, GardenClub, FitnessClub, ListeningLounge, MusicTerrace, ReadingTerrace, OrchidPavilion]
  {
    Position: {0, -0.35, 0}
    Box: {width, 0.7, depth}
    Rgb: {124, 143, 138}
  }
  {
    Position: {0, 0.008, 0}
    Rotation: {-math.PI / 2, 0, 0}
    { Position: {}; Surface: {image: commonsTextures.paving, width: width - 0.15, height: depth - 0.15, fit: false} }
  }
  for side in 0..4 {
    {
      Rotation: {0, side * math.PI / 2, 0}
      const span = width * (1 - side % 2) + depth * (side % 2)
      const reach = depth * (1 - side % 2) + width * (side % 2)
      { Position: {0, 0, reach / 2 - 0.12}; BrassRail: {width: span - 0.25} }
      { Position: {0, -0.25, reach / 2}; Neon: {size: {span - 0.1, 0.09, 0.06}, color: {88, 229, 174}, power: 1.2} }
      const plants: i32 = span / 3.4
      for i in 0..plants {

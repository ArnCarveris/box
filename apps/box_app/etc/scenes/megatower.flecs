    { Position: {width * 0.28, 0.19, 0.65}; BottleShelf: {seed: seed, rows: 2}; Scale: {0.6, 0.6, 0.6} }
    { Position: {width * 0.28, 0.18, 1.32}; ServiceDebris: {seed: seed, accent: amber}; Scale: {0.55, 0.55, 0.55} }
  }
  if kind == 2 {
    for i in 0..3 {
      { Position: {-width * 0.29 + i * width * 0.29, 0.18, 1.4}; GrowTray: {seed: seed + i, width: width * 0.25} }
    }
    { Position: {width * 0.3, 0.18, 0.45}; Tank: {radius: 0.23, height: 1, color: {88, 127, 109}} }
    { Position: {-width * 0.3, 0.18, 0.6}; Bench: {seed: seed, accent: cyan}; Scale: {0.55, 0.8, 0.8} }
  }
  if kind == 3 {
    { Position: {-width * 0.3, 0.2, 0.44}; Shrine: {seed: seed} }
    { Position: {width * 0.28, 0.2, 0.55}; BottleShelf: {seed: seed, rows: 2}; Scale: {0.7, 0.7, 0.7} }
    { Position: {0, 0.22, 1.28}; Box: {0.8, 0.025, 0.44}; Rgb: {124, 66, 75} }
    for i in 0..7 {
      { Position: {-0.32 + i * 0.11, 0.24, 1.28}; Box: {0.045, 0.014, 0.4}; Rgb: {191, 153, 107} }
    }
  }
  if kind == 4 {
    { Position: {width * 0.3, 0.2, 0.5}; Vending: {seed: seed, accent: pink}; Scale: {0.58, 0.58, 0.58} }
    { Position: {-width * 0.28, 0.2, 0.6}; BottleShelf: {seed: seed, rows: 3}; Scale: {0.62, 0.62, 0.62} }
    { Position: {0, 0.18, 1.45}; Crate: {seed: seed}; Scale: {0.6, 0.6, 0.6} }
  }
  if kind == 5 {

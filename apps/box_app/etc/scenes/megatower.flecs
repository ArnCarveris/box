box {
  material {
    layers {
      edge_wear {
        LayerParams: {a: {0.72, 0.76, 0.8, 1}, b: {0.085, 0.28, 5, 0.7}}
      }
      dust {
        LayerParams: {a: {0.3, 0.27, 0.22, 0.8}, b: {1.4, 0.92, 2, 0}}
      }
      grime {
        LayerParams: {a: {0.08, 0.1, 0.08, 1.8}, b: {1.8, 0.9, 0.85, 0.65}}
      }
    }
  }
}

template Weathering {
  prop dust: f32 = 0.18
  prop grime: f32 = 0.3
  prop edge: f32 = 0
  prop seed: f32 = 0
  if edge > 0 {
    (MaterialLayerOn, box.material.layers.edge_wear)
  }
  if dust > 0 {
    (MaterialLayerOn, box.material.layers.dust)
  }
  if grime > 0 {
    (MaterialLayerOn, box.material.layers.grime)
  }
  MaterialLayerData: {amount0: edge, amount1: dust, amount2: grime, seed: (seed % 251) / 251, scale: 1}
}

@tree Parent
template Surface {
  prop image: entity = surfaces.screen0
  prop width: f32 = 1
  prop height: f32 = 1
  prop glow: f32 = 0
  prop fit: bool = true
  const aspect: f32 = image[Svg].width / image[Svg].height
  const fittedWidth = math.min(width, height * aspect)
  const fittedHeight = math.min(height, width / aspect)
  Rotation: {0, math.PI, 0}
  if fit {
    Quad: {fittedWidth, fittedHeight}
  } else {
    Quad: {width, height}
  }
  Rgb: {255, 255, 255}
  PbrTextures: {albedo: image}
  if glow > 0 {
    PbrTextures: {albedo: image, emissive: image}
    Emissive: {strength: glow, color: {0, 0, 0}}
  }
}

struct StreetAsset(seed: i32, accent: Rgb)
struct Frontage(width: f32, height: f32, seed: i32)

@tree Parent
template Neon {
  prop size: vec3 = {1, 0.08, 0.08}
  prop color: Rgb = {55, 226, 237}
  prop power: f32 = 3
  const nx: i32 = size.x / 3 + 1
  const ny: i32 = size.y / 3 + 1
  const nz: i32 = size.z / 3 + 1
  for x in 0..nx {
    for y in 0..ny {
      for z in 0..nz {
        {
          Position: {(x + 0.5) * size.x / nx - size.x / 2, (y + 0.5) * size.y / ny - size.y / 2, (z + 0.5) * size.z / nz - size.z / 2}
          Box: {size.x / nx, size.y / ny, size.z / nz}
          Rgb: color
          Emissive: {strength: power, color: color}
        }
      }
    }
  }
}

@tree Parent
template Billboard {
  prop image: entity = signs.tide
  prop width: f32 = 10
  prop height: f32 = 3.3
  prop color: Rgb = {55, 226, 237}
  const aspect: f32 = image[Svg].width / image[Svg].height
  const fittedWidth = math.min(width, height * aspect)
  const fittedHeight = math.min(height, width / aspect)
  { Position: {}; Box: {width + 0.4, height + 0.4, 0.5}; Rgb: iron }
  {
    Position: {0, 0, 0.27}
    Rotation: {0, math.PI, 0}
    Quad: {fittedWidth, fittedHeight}
    Rgb: {255, 255, 255}
    PbrTextures: {albedo: image, emissive: image}
    Emissive: {strength: 2, color: {0, 0, 0}}
  }
  for s in 0..2 {
    { Position: {0, (s * 2 - 1) * (height / 2 + 0.22), 0.3}; Neon: {size: {width + 0.5, 0.065, 0.08}, color: color} }
    { Position: {(s * 2 - 1) * width * 0.32, -height * 0.65, -0.5}; Box: {0.18, height * 0.6, 1.2}; Rgb: iron }
  }
}

@tree Parent
template Railing {
  prop width: f32 = 4
  prop color: Rgb = {89, 108, 113}
  for i in 0..2 {
    { Position: {0, 0.48 + i * 0.54, 0}; Box: {width, 0.065, 0.065}; Weathering: {dust: 0, grime: 0, edge: 0.55}; PbrMaterial: {metallic: 0.65, roughness: 0.55}; Rgb: color }
  }
  for i in 0..5 {
    { Position: {-width / 2 + width * i / 4, 0.5, 0}; Box: {0.065, 1, 0.065}; Weathering: {dust: 0, grime: 0, edge: 0.55}; PbrMaterial: {metallic: 0.65, roughness: 0.55}; Rgb: color }
  }
}


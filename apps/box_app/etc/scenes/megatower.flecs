@tree Parent
template Stack {
  prop facade: template Frontage[] = [WalkupHome, CapsuleFront, ShutterHome, MakerLoft, GreenHome, BayResidence, LanternHome]
  prop premiumFacade: template Frontage[] = [BronzeLoggia, ConservatoryHome, SkyMaisonette, TeaTerraceHome, PenthouseBay, PrivateSpaHome, HangingVilla]
  prop premiumStart: i32 = 9999
  prop serviceEvery: i32 = 2
  prop underdeckEvery: i32 = 2
  prop retrofit: template Retrofit = ExteriorRetrofit
  prop underdeck: template Retrofit = Underdeck
  prop furniture: template StreetAsset = PublicClutter
  prop floors: i32 = 8
  prop bays: i32 = 5
  prop seed: i32 = 1
  prop accent: Rgb = {55, 226, 237}
  prop irregular: bool = true
  prop weathering: f32 = 1
  const width = bays * 3.8
  for f in 0..floors {
    const phase = (math.floor(f / 3) + seed) % 3
    const shift = phase * 0.75
    const exposure = weathering * (f < premiumStart)
    {
      Position: {shift, f * 3.6, -shift}
      { Position: {0, 1.7, 0}; Box: {width - 0.5, 3.4, width - 0.5}; Weathering: {dust: exposure * 0.16, grime: exposure * 0.3, seed: seed + f}; Rgb: {80, 97, 106} }
      { Position: {0, 0.06, 0}; Box: {width + 0.5, 0.23, width + 0.5}; Weathering: {dust: exposure * 0.24, grime: exposure * 0.4, seed: seed + f}; Rgb: concrete }
      for side in 0..4 {
        {
          Rotation: {0, side * math.PI / 2, 0}
          for b in 0..bays {
            const key = seed * 71 + f * 31 + side * 11 + b * 7
            {
              Position: {(b - (bays - 1) * 0.5) * 3.8, 0.12, width / 2}
              if f >= premiumStart {
                premiumFacade[(math.floor(f / 2) + side * 3 + b + seed) % premiumFacade.count()]: {width: 3.8, height: 3.48, seed: key}
              } else {
                facade[(math.floor(f / 2) + side * 3 + b + seed) % facade.count()]: {width: 3.8, height: 3.48, seed: key}
              }
              if key % serviceEvery == 0 && f < premiumStart {
                { Position: {}; retrofit: {width: 3.8, height: 3.48, seed: key} }
              }
              if key % underdeckEvery == 0 || (underdeckEvery == 2 && key % 7 == 0) {
                { Position: {}; underdeck: {width: 3.8, height: 3.48, seed: key} }
              }
            }
            if irregular && key % 19 == 0 && f < premiumStart {
              {
                Position: {(b - (bays - 1) * 0.5) * 3.8, 0.2, width / 2 + 2.15}
                { Position: {0, 1.2, 0}; Box: {3.2, 2.4, 2.6}; Rgb: {96 + key % 64, 114, 112} }
                { Position: {0, 0, 1.32}; Housing: {width: 3.2, height: 2.5, seed: key} }
                { Position: {0, 2.47, 0}; Box: {3.5, 0.15, 3}; Rgb: rust }
              }
            }
          }
          if f % 4 == 0 {
            { Position: {0, 0.1, width / 2 + 0.31}; Neon: {size: {width * 0.8, 0.045, 0.05}, color: accent, power: 1.8} }
          }
        }
      }
    }
  }
  roof {
    Position: {0.8, floors * 3.6, -0.8}
    { Position: {0, 0.12, 0}; Box: {width + 1, 0.25, width + 1}; Weathering: {dust: weathering * (premiumStart >= floors) * 0.28, grime: weathering * (premiumStart >= floors) * 0.35, seed: seed}; Rgb: {95, 112, 116} }
    for side in 0..4 {
      {
        Rotation: {0, side * math.PI / 2, 0}
        { Position: {0, 0.25, width / 2}; Railing: {width: width} }
        for i in 0..3 {
          {
            Position: {-width * 0.33 + i * width * 0.33, 0.26, width * 0.33}
            furniture: {seed: seed + i, accent: accent}
          }
        }
      }
    }
    for i in 0..3 {
      { Position: {-width * 0.25 + i * 2.2, 0.25, -width * 0.19}; Tank: {radius: 0.85, height: 2.3 + i * 0.5} }
    }
    { Position: {width * 0.3, 0.25, -width * 0.25}; Dish: {size: 2} }
    if premiumStart < floors {
      { Position: {0, 0.25, width * 0.1}; RoofConservatory: {width: width * 0.48, seed: seed} }
    }
  }
}


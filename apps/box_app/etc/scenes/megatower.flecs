@tree Parent
template Housing : Frontage {
  const style = seed % 8
  if style < 4 {
    { Position: {}; Tenement: {width: width, height: height, seed: seed} }
    if seed % 4 == 0 {
      { Position: {0, 0.08, 0.83}; Box: {width, 0.16, 1.8}; Rgb: concrete }
      { Position: {0, 0.16, 1.65}; Railing: {width: width} }
    }
  }
  if style == 4 || style == 5 {
    { Position: {}; BayHome: {width: width, height: height, seed: seed} }
  }
  if style > 5 {
    { Position: {}; CapsuleHome: {width: width, height: height, seed: seed} }
  }
  { Position: {}; FacadeServices: {width: width, height: height, seed: seed} }
  { Position: {}; DomesticLife: {width: width, seed: seed} }
}


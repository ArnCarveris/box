using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light

camera {
  Position: {0, 2, -6}
  LookAt: {0, 0.5, 0}
  Camera: {fov: 55}
  Capture: {path: "/tmp/box/capture_camera.png"}
}

view { View: {camera: camera} }

sun {
  Rotation: {0.9, -0.6, 0}
  DirectionalLight: {intensity: 1}
}

floor {
  Position: {0, -0.5, 0}
  Box: {20, 0.2, 20}
  Rgb: {180, 180, 190}
}

sphere {
  Position: {0, 0.5, 0}
  Sphere: {radius: 1, segments: 32, smooth: true}
  Rgb: {80, 160, 240}
}

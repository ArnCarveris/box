using flecs.script.math
using box.transform
using box.geometry
using box.material
using yeon

ground {
  Position: {0, -0.5, -40}
  Box: {600, 1, 120}
  Rgb: {120, 140, 80}
}

madang {
  Position: {0, -0.48, 2}
  Box: {600, 1, 6}
  Rgb: {200, 180, 140}
}

wall {
  Position: {0, 0.6, -1.6}
  Box: {600, 1.2, 0.6}
  Rgb: {140, 120, 100}
}

wall_cap {
  Position: {0, 1.3, -1.6}
  Box: {600, 0.25, 0.9}
  Rgb: {62, 68, 80}
}

const rng: Rng = {seed: cfg.seed}

scenery {
  for i in 0..8 {
    "hanok_{i}" {
      Hanok: {}
      DynamicTransform
      Position: {-40 + 11 * i + rng.f(2), 0, -7 - 2 * (i % 2)}
    }
  }

  for i in 0..6 {
    "pine_{i}" {
      Pine: {}
      DynamicTransform
      const s = 0.85 + rng.f(0.4)
      Position: {-44 + 16 * i + rng.f(5), 0, -12 + rng.f(3)}
      Scale: {s, s, s}
    }
  }

  pagoda {
    (IsA, Pagoda)
    DynamicTransform
    Position: {18, 0, -20}
  }

  for i in 0..12 {
    "peak_{i}" {
      (IsA, Peak)
      DynamicTransform
      const w = 16 + rng.f(12)
      const h = 10 + rng.f(12)
      Position: {-120 + 20 * i + rng.f(8), h / 2 - 1, -60 - rng.f(10)}
      Scale: {w, h, w * 0.5}
    }
  }

  for i in 0..11 {
    "far_peak_{i}" {
      (IsA, FarPeak)
      DynamicTransform
      const w = 30 + rng.f(25)
      const h = 30 + rng.f(30)
      Position: {-220 + 40 * i + rng.f(15), h / 2 - 1, -150 - rng.f(30)}
      Scale: {w, h, w * 0.5}
    }
  }

  for i in 0..5 {
    "cloud_{i}" {
      (IsA, Cloud)
      DynamicTransform
      const s = 0.8 + rng.f(0.6)
      Position: {-70 + 32 * i + rng.f(10), 19 + rng.f(6), -32}
      Scale: {s, s, s}
    }
  }
}

player {
  DynamicTransform
}

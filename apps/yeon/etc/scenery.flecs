using flecs.script.math
using box.transform
using box.geometry
using box.material
using yeon

const giwa: Rgb = {62, 68, 80}
const giwaDark: Rgb = {45, 50, 60}
const timber: Rgb = {118, 58, 38}
const plaster: Rgb = {236, 226, 204}
const changhoji: Rgb = {248, 238, 214}
const stone: Rgb = {150, 145, 135}

hanok_roof_outline {
  Path2D: {
    start: {-0.55, -3.4},
    segments: [
      {kind: CubicBezier, end: {0.85, 0}, control1: {-0.85, -2.5}, control2: {0.55, -0.7}},
      {kind: CubicBezier, end: {-0.55, 3.4}, control1: {0.55, 0.7}, control2: {-0.85, 2.5}},
      {kind: Line, end: {-0.75, 3.35}},
      {kind: Line, end: {-0.85, 1.9}},
      {kind: Line, end: {-0.85, -1.9}},
      {kind: Line, end: {-0.75, -3.35}}
    ],
    closed: true
  }
}

hanok_roof_profile {
  Profile2D: {outer: hanok_roof_outline}
}

pine_trunk_path {
  Path3D: {
    start: {0, -0.2, 0},
    segments: [
      {kind: CatmullRom, end: {0.45, 1.3, 0}},
      {kind: CatmullRom, end: {0.2, 2.7, 0.1}},
      {kind: CatmullRom, end: {0.75, 4.1, 0}}
    ]
  }
}

pine_trunk_outline {
  Path2D: {
    start: {0.24, 0},
    segments: [
      {kind: CubicBezier, end: {0, 0.24}, control1: {0.24, 0.1325}, control2: {0.1325, 0.24}},
      {kind: CubicBezier, end: {-0.24, 0}, control1: {-0.1325, 0.24}, control2: {-0.24, 0.1325}},
      {kind: CubicBezier, end: {0, -0.24}, control1: {-0.24, -0.1325}, control2: {-0.1325, -0.24}},
      {kind: CubicBezier, end: {0.24, 0}, control1: {0.1325, -0.24}, control2: {0.24, -0.1325}}
    ],
    closed: true
  }
}

pine_trunk_profile {
  Profile2D: {outer: pine_trunk_outline}
}

template Hanok {
  YeonScenery: {parallax: 1, wrap_min: -44, wrap_span: 88}

  base {
    Position: {0, 0.3, 0}
    Box: {7.6, 0.6, 4.6}
    Rgb: stone
  }

  walls {
    Position: {0, 1.6, 0}
    Box: {6.4, 2.0, 3.4}
    Rgb: plaster
  }

  for i in 0..4 {
    "pillar_{i}" {
      Position: {-3.15 + 2.1 * i, 1.6, 1.75}
      Box: {0.26, 2.0, 0.26}
      Rgb: timber
    }
  }

  lintel {
    Position: {0, 2.55, 1.75}
    Box: {6.7, 0.26, 0.3}
    Rgb: timber
  }

  dancheong {
    Position: {0, 2.38, 1.8}
    Box: {6.5, 0.08, 0.26}
    Rgb: {40, 140, 110}
  }

  for i in 0..3 {
    "door_frame_{i}" {
      Position: {-2.1 + 2.1 * i, 1.45, 1.71}
      Box: {1.5, 1.5, 0.04}
      Rgb: timber
    }

    "door_paper_{i}" {
      Position: {-2.1 + 2.1 * i, 1.45, 1.74}
      Box: {1.3, 1.3, 0.04}
      Rgb: changhoji
    }

    "door_mullion_{i}" {
      Position: {-2.1 + 2.1 * i, 1.45, 1.77}
      Box: {0.05, 1.3, 0.03}
      Rgb: timber
    }

    "door_rail_{i}" {
      Position: {-2.1 + 2.1 * i, 1.45, 1.77}
      Box: {1.3, 0.05, 0.03}
      Rgb: timber
    }
  }

  roof {
    Position: {0, 3.45, 0}
    Rotation: {0, 0, PI / 2}
    ProfileExtrusion: {profile: hanok_roof_profile, depth: 8.6, cap_start: true, cap_end: true}
    Rgb: giwa
  }

  ridge {
    Position: {0, 4.32, 0}
    Box: {7.6, 0.32, 0.4}
    Bevel: {radius: 0.08}
    Rgb: giwaDark
  }

  for i in 0..2 {
    const side = 2 * i - 1

    "ridge_end_{i}" {
      Position: {side * 3.95, 4.5, 0}
      Rotation: {0, 0, side * 0.55}
      Box: {0.9, 0.3, 0.42}
      Bevel: {radius: 0.08}
      Rgb: giwaDark
    }
  }
}

template Pine {
  YeonScenery: {parallax: 1, wrap_min: -48, wrap_span: 96}

  trunk {
    Position: {0, 0, 0}
    Sweep: {path: pine_trunk_path, profile: pine_trunk_profile, taper: 0.55, rings: 24}
    Rgb: {120, 70, 50}
  }

  bough_low {
    Position: {-0.6, 3.4, 0}
    Scale: {2.2, 0.55, 1.6}
    Sphere: {segments: 16, smooth: true, radius: 1}
    Rgb: {38, 92, 58}
  }

  bough_mid {
    Position: {1.0, 4.4, 0}
    Scale: {1.8, 0.5, 1.4}
    Sphere: {segments: 16, smooth: true, radius: 1}
    Rgb: {44, 102, 62}
  }

  bough_top {
    Position: {0.6, 5.3, 0}
    Scale: {1.3, 0.45, 1.1}
    Sphere: {segments: 16, smooth: true, radius: 1}
    Rgb: {50, 110, 68}
  }
}

prefab Pagoda {
  YeonScenery: {parallax: 0.85, wrap_min: -70, wrap_span: 140}

  plinth {
    Position: {0, 0.6, 0}
    Box: {4.4, 1.2, 4.4}
    Rgb: stone
  }

  for i in 0..3 {
    const w = 3.0 - 0.55 * i
    const y0 = 1.2 + 1.75 * i

    "body_{i}" {
      Position: {0, y0 + 0.6, 0}
      Box: {w * 0.62, 1.2, w * 0.62}
      Rgb: {168, 162, 150}
    }

    "roof_{i}" {
      Position: {0, y0 + 1.35, 0}
      Box: {w * 1.15, 0.3, w * 1.15}
      Rgb: {140, 135, 125}
    }

    "roof_step_{i}" {
      Position: {0, y0 + 1.15, 0}
      Box: {w * 0.95, 0.15, w * 0.95}
      Rgb: {150, 145, 135}
    }
  }

  finial {
    Position: {0, 7.4, 0}
    Cylinder: {segments: 12, smooth: true, length: 1.4, radius: 0.12}
    Rgb: {120, 115, 105}
  }

  finial_ball {
    Position: {0, 7.9, 0}
    Sphere: {segments: 12, smooth: true, radius: 0.22}
    Rgb: {120, 115, 105}
  }
}

prefab Peak {
  YeonScenery: {parallax: 0.3, wrap_min: -120, wrap_span: 240}
  Cone: {segments: 7, smooth: false, length: 1, radius: 1}
  Rgb: {70, 105, 80}
}

prefab FarPeak {
  YeonScenery: {parallax: 0.12, wrap_min: -220, wrap_span: 440}
  Cone: {segments: 6, smooth: false, length: 1, radius: 1}
  Rgb: {84, 112, 112}
}

prefab Cloud {
  YeonScenery: {parallax: 0.35, wrap_min: -80, wrap_span: 160}

  puff_a {
    Position: {0, 0, 0}
    Scale: {3.2, 0.9, 1}
    Sphere: {segments: 16, smooth: true, radius: 1}
    Rgb: {255, 248, 240}
  }

  puff_b {
    Position: {1.6, 0.5, 0.2}
    Scale: {1.8, 1.0, 1}
    Sphere: {segments: 16, smooth: true, radius: 1}
    Rgb: {255, 248, 240}
  }

  puff_c {
    Position: {-1.5, 0.3, -0.2}
    Scale: {1.6, 0.8, 1}
    Sphere: {segments: 16, smooth: true, radius: 1}
    Rgb: {255, 248, 240}
  }
}

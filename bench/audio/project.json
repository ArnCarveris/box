{
    "id": "bench_audio",
    "type": "application",
    "value": {
        "description": "Benchmarks for the audio core: voices mixed through buses, a reverb and synth voices, in ns per frame",
        "public": false,
        "use": [
            "box"
        ]
    },
    "lang.c": {
        "include": [
            "../../src/audio/core"
        ]
    },
    "bench": {
        "benchsuites": [
            {
                "id": "Mix",
                "benchcases": [
                    "voices_64_buses_8",
                    "silent_64_buses_8",
                    "idle"
                ]
            },
            {
                "id": "Reverb",
                "benchcases": [
                    "one_reverb",
                    "voices_32_reverb",
                    "voices_32_dry",
                    "silent_tail"
                ]
            },
            {
                "id": "Synth",
                "benchcases": [
                    "voices_64",
                    "voices_64_filter_sweep"
                ]
            }
        ]
    }
}

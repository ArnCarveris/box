{
    "id": "bench_audio",
    "type": "application",
    "value": {
        "description": "Benchmarks for the audio core: voices mixed through buses, a reverb and synth voices, in ns per frame, and the spatial sources of box.audio, in ns per source",
        "public": false,
        "use": [
            "box"
        ]
    },
    "lang.c": {
        "include": [
            "../../src/audio/core",
            "../../src/audio"
        ]
    },
    "bench": {
        "benchsuites": [
            {
                "id": "Mix",
                "benchcases": [
                    "voices_64_buses_8",
                    "silent_64_buses_8",
                    "idle"
                ]
            },
            {
                "id": "Spatial",
                "benchcases": [
                    "sources_1000_still",
                    "sources_1000_listener_moves",
                    "sources_1000_ten_move",
                    "sources_0"
                ]
            },
            {
                "id": "Reverb",
                "benchcases": [
                    "one_reverb",
                    "voices_32_reverb",
                    "voices_32_dry",
                    "silent_tail"
                ]
            },
            {
                "id": "Synth",
                "benchcases": [
                    "voices_64",
                    "voices_64_filter_envelope",
                    "voices_64_filter_24",
                    "voices_64_fm",
                    "voices_64_curved"
                ]
            }
        ]
    }
}

{
    "id": "particle",
    "type": "application",
    "value": {
        "description": "Unit tests for the particle emitter component and the extracted emitter block",
        "public": false,
        "use": [
            "box"
        ]
    },
    "test": {
        "testsuites": [
            {
                "id": "Emitter",
                "testcases": [
                    "defaults_are_a_white_upward_stream",
                    "emitter_gets_a_transform_and_its_bookkeeping",
                    "authored_members_keep_the_other_defaults",
                    "shaders_are_created_with_the_first_emitter",
                    "a_world_without_an_emitter_compiles_no_shader"
                ]
            },
            {
                "id": "Extract",
                "testcases": [
                    "no_block_without_an_emitter",
                    "block_carries_the_world_transform",
                    "block_carries_the_shape_and_the_spread",
                    "block_carries_the_ranges_and_the_seed",
                    "color_reaches_the_block_as_linear",
                    "spawn_count_on_the_fixed_clock",
                    "fractional_rate_accumulates_over_frames",
                    "a_rate_of_zero_spawns_nothing",
                    "spawn_is_clamped_to_the_maximum",
                    "maximum_is_clamped_to_the_pool_ceiling",
                    "the_pool_resets_when_the_maximum_changes",
                    "first_counts_the_particles_spawned_before",
                    "mesh_shape_samples_the_surface",
                    "spline_shape_samples_the_curve",
                    "a_shape_without_a_table_carries_no_points",
                    "the_render_extract_fills_the_emitters"
                ]
            }
        ]
    }
}

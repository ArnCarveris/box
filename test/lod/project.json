{
    "id": "lod",
    "type": "application",
    "value": {
        "description": "Unit tests for the LOD proxy generator",
        "public": false,
        "use": [
            "box"
        ]
    },
    "test": {
        "testsuites": [
            {
                "id": "Cluster",
                "testcases": [
                    "one_primitive_is_one_box",
                    "two_groups_split_by_distance",
                    "the_budget_caps_the_shape_count",
                    "more_shapes_lower_the_error",
                    "a_shape_covers_the_bounds_of_its_inputs",
                    "a_round_cluster_becomes_a_sphere",
                    "a_tall_cluster_becomes_a_capsule",
                    "the_proxy_bounds_cover_the_subtree"
                ]
            },
            {
                "id": "Error",
                "testcases": [
                    "an_exact_box_has_no_error",
                    "a_gap_between_inputs_raises_the_error",
                    "splitting_a_gap_removes_the_error",
                    "the_error_bound_buys_more_shapes",
                    "the_error_is_the_edge_of_the_missed_volume",
                    "the_error_scales_with_the_subtree"
                ]
            },
            {
                "id": "Material",
                "testcases": [
                    "every_material_keeps_a_shape",
                    "a_shape_carries_the_material_of_its_inputs",
                    "the_budget_follows_the_volume",
                    "materials_never_share_a_shape"
                ]
            },
            {
                "id": "Determinism",
                "testcases": [
                    "the_same_input_builds_the_same_proxy",
                    "a_fresh_builder_builds_the_same_proxy",
                    "an_unrelated_build_leaves_no_trace"
                ]
            },
            {
                "id": "Degenerate",
                "testcases": [
                    "an_empty_subtree_has_no_proxy",
                    "a_zero_sized_primitive_is_finite",
                    "overlapping_primitives_become_one_shape",
                    "more_shapes_than_primitives",
                    "a_flat_primitive_keeps_its_plane",
                    "reversed_bounds_are_normalized"
                ]
            },
            {
                "id": "Screen",
                "testcases": [
                    "an_error_projects_at_the_nearest_point",
                    "twice_the_distance_halves_the_error",
                    "the_nearest_point_is_not_the_center",
                    "a_camera_inside_the_bounds_stays_finite",
                    "a_wider_fov_lowers_the_error",
                    "a_taller_viewport_raises_the_error",
                    "an_orthographic_error_ignores_the_distance",
                    "an_orthographic_error_follows_the_height",
                    "the_scale_is_the_error_of_one_unit",
                    "a_representation_without_error_is_free",
                    "zero_fields_take_the_camera_defaults",
                    "reversed_bounds_measure_the_same"
                ]
            },
            {
                "id": "Hysteresis",
                "testcases": [
                    "without_a_current_level_the_threshold_decides",
                    "a_level_holds_inside_the_band",
                    "an_error_above_the_band_goes_finer",
                    "an_error_below_the_band_goes_coarser",
                    "the_band_only_widens_the_threshold",
                    "without_a_band_the_switch_is_at_the_threshold",
                    "the_finest_level_is_the_floor",
                    "a_level_out_of_range_is_ignored",
                    "a_single_level_is_always_selected",
                    "a_coarser_threshold_selects_a_coarser_level"
                ]
            },
            {
                "id": "Walk",
                "testcases": [
                    "a_walk_towards_and_away_never_oscillates",
                    "a_hovering_camera_holds_its_level",
                    "an_orthographic_zoom_never_oscillates"
                ]
            },
            {
                "id": "Merge",
                "testcases": [
                    "one_mesh_lands_in_world_space",
                    "two_meshes_join_one_group",
                    "materials_split_into_groups",
                    "a_material_gathers_every_source",
                    "welding_joins_a_shared_edge",
                    "an_unwelded_seam_keeps_both_vertices",
                    "identical_vertices_are_shared",
                    "a_mesh_without_normals_gets_them",
                    "missing_uvs_and_colors_get_defaults",
                    "uvs_and_colors_are_kept",
                    "the_bounds_cover_every_source",
                    "an_empty_subtree_merges_to_nothing",
                    "an_index_outside_the_mesh_is_dropped",
                    "a_degenerate_triangle_is_dropped",
                    "a_source_without_vertices_is_skipped",
                    "the_same_input_merges_the_same_mesh"
                ]
            },
            {
                "id": "Simplify",
                "testcases": [
                    "a_flat_grid_loses_triangles",
                    "the_ratio_caps_the_triangles",
                    "a_ratio_of_one_keeps_the_mesh",
                    "the_error_bound_limits_the_loss",
                    "the_error_is_measured_in_world_units",
                    "a_group_keeps_its_own_triangles",
                    "unused_vertices_are_dropped",
                    "the_same_mesh_simplifies_the_same_way",
                    "an_empty_mesh_has_nothing_to_lose",
                    "a_single_triangle_survives"
                ]
            },
            {
                "id": "Reduce",
                "testcases": [
                    "the_ladder_halves_down_to_the_floor",
                    "an_uneven_count_halves_too",
                    "a_shape_at_its_floor_has_one_level",
                    "a_long_ladder_stops_at_its_levels",
                    "a_degenerate_count_has_no_ladder",
                    "a_lower_floor_buys_more_levels",
                    "the_chord_error_grows_with_the_radius",
                    "more_segments_lower_the_chord_error",
                    "a_near_shape_keeps_the_authored_level",
                    "a_distant_shape_takes_the_coarsest_level",
                    "a_quarter_arc_is_measured_as_its_circle",
                    "the_band_holds_the_level_of_the_previous_frame",
                    "a_zero_threshold_holds_the_authored_level",
                    "an_orthographic_camera_ignores_the_distance",
                    "a_ladder_of_one_level_never_moves"
                ]
            },
            {
                "id": "Tree",
                "testcases": [
                    "a_walk_visits_every_root",
                    "the_walk_visits_a_parent_before_its_children",
                    "a_node_under_the_threshold_becomes_a_proxy",
                    "a_rejected_node_stops_its_subtree",
                    "a_closed_node_opens_on_demand",
                    "a_node_without_children_falls_back_to_its_proxy",
                    "closing_a_node_releases_its_children",
                    "removing_a_node_drops_its_subtree",
                    "refresh_aggregates_the_bounds_of_a_subtree",
                    "refresh_averages_the_look_of_a_subtree",
                    "clustering_groups_loose_roots",
                    "clustering_keeps_neighbours_together",
                    "unclustering_gives_the_roots_back",
                    "a_cluster_is_rejected_as_one",
                    "visited_nodes_do_not_grow_with_the_leaves",
                    "the_band_holds_a_node_at_its_decision"
                ]
            },
            {
                "id": "Hierarchy",
                "testcases": [
                    "a_far_root_is_replaced_by_a_proxy",
                    "a_near_root_draws_its_leaves",
                    "the_traversal_leaves_the_entities_alone",
                    "settings_off_draws_every_leaf",
                    "turning_the_settings_off_shows_the_leaves_again",
                    "the_walk_reports_what_it_cost"
                ]
            }
        ]
    }
}

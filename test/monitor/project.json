{
    "id": "monitor",
    "type": "application",
    "value": {
        "description": "Unit tests for the box.monitor CPU, statistics and system monitors",
        "public": false,
        "use": [
            "box"
        ]
    },
    "test": {
        "testsuites": [
            {
                "id": "Cpu",
                "testcases": [
                    "absent_monitor_is_not_sampled",
                    "sample_reports_the_cores",
                    "busy_loop_raises_the_process_percent",
                    "system_percent_stays_in_range",
                    "short_window_follows_the_load",
                    "long_window_lags_the_load",
                    "removing_the_monitor_stops_sampling",
                    "budget_sleep_is_published",
                    "budget_slows_a_synthetic_load"
                ]
            },
            {
                "id": "Stats",
                "testcases": [
                    "setting_the_component_imports_the_addon",
                    "collects_after_the_period",
                    "period_holds_back_the_collection",
                    "entity_count_follows_the_world",
                    "frame_time_window_is_averaged",
                    "slowest_systems_are_listed",
                    "removing_the_component_stops_collection",
                    "slowest_covers_min_avg_max",
                    "collection_marks_the_component_modified",
                    "removing_the_component_disables_the_addon",
                    "setting_it_again_enables_the_addon",
                    "addon_monitors_are_not_listed"
                ]
            },
            {
                "id": "Systems",
                "testcases": [
                    "off_by_default",
                    "disabled_monitor_collects_nothing",
                    "slow_system_is_attributed_to_itself",
                    "frame_total_covers_the_systems",
                    "phase_totals_are_kept_per_phase",
                    "disabling_stops_collection",
                    "removing_the_monitor_stops_measurement"
                ]
            },
            {
                "id": "Fps",
                "testcases": [
                    "empty_ring_reports_nothing",
                    "ring_keeps_the_newest_frame_first",
                    "ring_wraps_past_its_size",
                    "ring_ignores_a_negative_frame",
                    "window_covers_one_second_of_frames",
                    "stats_summarize_the_window",
                    "singleton_exists_at_import",
                    "window_is_published_on_the_singleton",
                    "history_keeps_the_newest_frame_last",
                    "history_count_stops_at_its_size",
                    "publishing_emits_on_set",
                    "panel_is_hidden_by_default",
                    "panel_shows_while_visible",
                    "panel_label_shows_the_frame_rate",
                    "panel_draws_one_bar_per_recorded_frame",
                    "slow_frame_turns_its_bar_red",
                    "panel_follows_the_surface"
                ]
            },
            {
                "id": "Gpu",
                "testcases": [
                    "empty_collector_reports_nothing",
                    "passes_take_two_timestamps_each",
                    "a_pass_outside_a_frame_is_not_timed",
                    "a_full_frame_drops_the_passes_past_it",
                    "a_long_pass_name_is_truncated",
                    "resolve_publishes_the_milliseconds",
                    "passes_with_one_name_are_summed",
                    "a_backwards_timestamp_is_no_time",
                    "resolve_names_the_frame_it_measured",
                    "a_pending_frame_holds_back_the_next_one",
                    "a_dropped_frame_releases_the_collector",
                    "a_frame_without_passes_is_not_resolved",
                    "an_end_without_a_frame_changes_nothing",
                    "resolve_ignores_the_timestamps_it_did_not_record",
                    "absent_component_is_not_published",
                    "a_world_without_a_renderer_reports_no_passes"
                ]
            },
            {
                "id": "Spikes",
                "testcases": [
                    "empty_run_reports_nothing",
                    "run_reports_mean_and_percentiles",
                    "flat_run_has_no_spike",
                    "frame_over_the_budget_is_a_spike",
                    "budget_follows_the_factor",
                    "zero_factor_disables_the_budget",
                    "spike_keeps_the_slowest_system",
                    "spikes_are_listed_worst_first",
                    "report_keeps_the_worst_of_many_spikes",
                    "collector_grows_past_its_capacity"
                ]
            },
            {
                "id": "StatsPanels",
                "testcases": [
                    "panels_are_hidden_by_default",
                    "templates_are_loaded",
                    "showing_a_panel_adds_its_singleton",
                    "gpu_panel_adds_gpu_timings",
                    "hiding_keeps_a_singleton_added_elsewhere",
                    "removing_the_singleton_stops_counting",
                    "renderer_panel_shows_the_counts",
                    "gpu_panel_lists_the_passes",
                    "panels_stack_in_one_column",
                    "a_surface_world_publishes_the_counts",
                    "detail_panels_add_their_singletons",
                    "counting_asks_for_what_the_singletons_need",
                    "pass_panel_lists_the_passes",
                    "tables_end_with_their_total",
                    "buffer_panel_shows_the_used_classes",
                    "a_surface_world_publishes_the_details",
                    "systems_panel_imports_the_stats_addon",
                    "systems_panel_lists_ten_at_most"
                ]
            }
        ]
    }
}

using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.texture

$ {
  EnvironmentLight: {sky_color: {110, 140, 190}, ground_color: {70, 62, 55}, intensity: 0.6}
}

textures {
  checker {
    Texture: {path: "etc/textures/checker.png"}
  }
}

camera {
  Position: {0, 2.4, -9}
  LookAt: {0, 1.4, 0}
  Camera: {fov: 55}
}

sun {
  Rotation: {0.85, -0.5, 0}
  DirectionalLight: {intensity: 1}
}

floor {
  Position: {0, -0.5, 0}
  Box: {20, 0.2, 20}
  Rgb: {210, 210, 215}
  PbrMaterial: {roughness: 0.8}
  PbrTextures: {albedo: textures.checker}
  TextureTiling: {meters_x: 1, meters_y: 1}
}

wall {
  Position: {0, 2, 3}
  Box: {14, 5, 0.3}
  Rgb: {235, 235, 240}
  PbrMaterial: {roughness: 0.7}
  PbrTextures: {albedo: textures.checker}
  TextureTiling: {meters_x: 0.5, meters_y: 0.5}
}

box {
  Position: {-2.6, 1, 0.6}
  Rotation: {0, 0.5, 0}
  Box: {1.6, 2, 1.6}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0.1, roughness: 0.6}
  PbrTextures: {albedo: textures.checker}
}

ball {
  Position: {2.6, 1, 0.6}
  Sphere: {segments: 48, smooth: true, radius: 1}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0.2, roughness: 0.5}
  PbrTextures: {albedo: textures.checker}
}

frosted {
  Position: {-2.6, 1.4, -2.5}
  Quad: {3.4, 3.4}
  Rgb: {120, 150, 180}
  Opacity: {0.5}
  PbrMaterial: {roughness: 0.8}
  BlendMode: {AlphaBlend}
}

clear {
  Position: {2.6, 1.4, -2.5}
  Quad: {3.4, 3.4}
  Rgb: {120, 150, 180}
  Opacity: {0.5}
  PbrMaterial: {roughness: 0}
  BlendMode: {AlphaBlend}
}

view { box.view.View: {camera: camera} }

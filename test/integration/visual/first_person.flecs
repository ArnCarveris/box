using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.controller

sun {
  Rotation: {0.9, -0.5, 0}
  DirectionalLight: {intensity: 1.1}
}

$ { EnvironmentLight: {sky_color: {95, 120, 160}, ground_color: {45, 42, 38}, intensity: 1} }

ground {
  Position: {0, -0.25, 0}
  Box: {40, 0.5, 40}
  Rgb: {70, 74, 82}
  PbrMaterial: {roughness: 0.9}
}

level {
  wall_left {
    Position: {-4, 1.5, 6}
    Box: {0.5, 3, 8}
    Rgb: {150, 120, 100}
  }

  wall_right {
    Position: {4, 1.5, 6}
    Box: {0.5, 3, 8}
    Rgb: {150, 120, 100}
  }

  crate {
    Position: {-1.5, 0.5, 4}
    Box: {1, 1, 1}
    Rgb: {180, 150, 90}
    PbrMaterial: {roughness: 0.6}
  }

  pillar {
    Position: {1.5, 1.25, 7}
    Cylinder: {radius: 0.4, length: 2.5, segments: 24}
    Rgb: {200, 200, 205}
    PbrMaterial: {metallic: 0.8, roughness: 0.3}
  }

  ball {
    Position: {0.5, 0.6, 3}
    Sphere: {radius: 0.6, segments: 24, smooth: true}
    Rgb: {90, 160, 230}
  }
}

player {
  Position: {0, 1.7, 0}
  FirstPersonController: {}
  Camera: {fov: 65}
}

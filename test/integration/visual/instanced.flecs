using box.transform
using box.geometry
using box.material
using box.camera
using box.view

camera {
  Position: {0, 16, 26}
  Rotation: {-0.55, 0, 0}
  Camera: {fov: 50}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {24, 28, 36, 255}}}
}

floor {
  Position: {0, -0.1, 0}
  Box: {34, 0.2, 26}
  Rgb: {90, 96, 104}
}

for x in 0..32 {
  for z in 0..20 {
    {
      Position: {x - 15.5, 0.2 + (x % 4) * 0.1, z - 12}
      Box: {0.7, 0.4 + (x % 4) * 0.2, 0.7}
      Rgb: {40 + x * 6, 80 + z * 7, 200 - x * 4}
    }
  }
}

for i in 0..24 {
  {
    DynamicTransform
    Position: {i * 1.3 - 15, 2.2, 10}
    Rotation: {i * 0.13, i * 0.27, 0}
    Box: {0.8, 0.8, 0.8}
    Rgb: {250, 120 + i * 5, 60}
  }
}

for i in 0..24 {
  {
    DynamicTransform
    Position: {i * 1.3 - 15, 0.6, 12}
    Sphere: {segments: 16, smooth: true, radius: 0.5}
    Rgb: {240, 240, 250 - i * 6}
  }
}

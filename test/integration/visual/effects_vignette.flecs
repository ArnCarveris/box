using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects

tonemap {
  Tonemap: {}
}

// A strong warm vignette, centered a little left of the image, rounder than the rectangle
vignette {
  Vignette: {
    intensity: 0.7, radius: 0.45, smoothness: 0.5, roundness: 0.8,
    center: {0.45, 0.5}, color: {40, 20, 10}
  }
}

camera {
  Position: {0, 3, 9}
  Rotation: {-0.25, 0, 0}
  Camera: {fov: 50}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {200, 210, 230, 255}}, effects: [{effect: tonemap}, {effect: vignette}]}
}

sun {
  Rotation: {0.5848, 2.4751, 0}
  DirectionalLight: {intensity: 2 * flecs.script.math.PI}
  Rgb: {255, 245, 230}
}

floor {
  Position: {0, -0.1, 0}
  Box: {16, 0.2, 10}
  Rgb: {220, 220, 210}
}

for i in 0..6 {
  {
    Position: {i * 1.6 - 4, 0.6, 0}
    Sphere: {segments: 32, smooth: true, radius: 0.6}
    Rgb: {255 - i * 30, 200, 120 + i * 20}
    PbrMaterial: {roughness: 0.4}
  }
}

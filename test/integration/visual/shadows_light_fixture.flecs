// A room lit by a low sun and two point lights with shadows, each inside a LightFixture: a bulb
// sphere on the left and a lantern box on the right, whose four corner bars are no fixtures.
// Each light shines out of its own fixture, the lantern bars throw thin shadows of their own
// light on the floor, and each fixture shadows the floor for the other light and for the sun.
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light

camera {
  Position: {0, 5, 10}
  Rotation: {-0.45, 0, 0}
  Camera: {fov: 50}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {8, 8, 12, 255}}, shadows: {enabled: true}}
}

$ {
  AmbientLight: {intensity: 0.1}
}

sun {
  Rotation: {0.6, 0.4, 0}
  DirectionalLight: {intensity: 0.5 * flecs.script.math.PI}
}

floor {
  Position: {0, -0.1, 0}
  Box: {16, 0.2, 10}
  Rgb: {200, 200, 200}
}

wall {
  Position: {0, 2, -3}
  Box: {16, 4, 0.2}
  Rgb: {200, 200, 200}
}

wall_left {
  Position: {-6, 2, 1}
  Box: {0.2, 4, 8}
  Rgb: {200, 200, 200}
}

wall_right {
  Position: {6, 2, 1}
  Box: {0.2, 4, 8}
  Rgb: {200, 200, 200}
}

lamp {
  Position: {-2, 1.6, 0.5}
  PointLight: {intensity: 4 * flecs.script.math.PI, range: 8, shadows: true}

  bulb {
    Sphere: {segments: 24, smooth: true, radius: 0.35}
    Rgb: {255, 230, 180}
    Emissive: {strength: 1, color: {255, 230, 180}}
    LightFixture
  }
}

lantern {
  Position: {2, 1.2, 0.5}

  flame {
    PointLight: {intensity: 4 * flecs.script.math.PI, range: 8, shadows: true}
  }

  glass {
    Box: {0.6, 0.8, 0.6}
    Rgb: {200, 220, 255}
    Emissive: {strength: 0.5, color: {200, 220, 255}}
    LightFixture
  }

  bar_a {
    Position: {0.34, 0, 0.34}
    Box: {0.06, 0.9, 0.06}
    Rgb: {40, 40, 40}
  }

  bar_b {
    Position: {-0.34, 0, 0.34}
    Box: {0.06, 0.9, 0.06}
    Rgb: {40, 40, 40}
  }

  bar_c {
    Position: {0.34, 0, -0.34}
    Box: {0.06, 0.9, 0.06}
    Rgb: {40, 40, 40}
  }

  bar_d {
    Position: {-0.34, 0, -0.34}
    Box: {0.06, 0.9, 0.06}
    Rgb: {40, 40, 40}
  }

  cap {
    Position: {0, 0.48, 0}
    Box: {0.8, 0.06, 0.8}
    Rgb: {40, 40, 40}
  }
}

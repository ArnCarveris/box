using box.transform
using box.geometry
using box.material
using box.texture
using box.camera
using box.view

camera {
  Position: {0, 2.6, 8}
  Rotation: {-0.25, 0, 0}
  Camera: {fov: 50}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {20, 22, 28, 255}}}
}

bumps {
  Path: {path: "test/integration/visual/assets/bumps.png"}
}

stripes {
  Path: {path: "test/integration/visual/assets/stripes.png"}
}

ring {
  Path: {path: "test/integration/visual/assets/ring.png"}
}

floor {
  Position: {0, -0.1, 0}
  Box: {16, 0.2, 10}
  Rgb: {150, 150, 155}
  PbrMaterial: {roughness: 0.7}
  PbrTextures: {normal: bumps}
  texture.Transform: {scale_x: 6, scale_y: 4}
}

flat_panel {
  Position: {-4, 1.3, -0.5}
  Rotation: {0, 0.35, 0}
  Quad: {2.2, 2.2}
  Rgb: {200, 120, 80}
  PbrMaterial: {roughness: 0.5}
}

bumpy_panel {
  Position: {-1.4, 1.3, -0.5}
  Rotation: {0, 0.15, 0}
  Quad: {2.2, 2.2}
  Rgb: {200, 120, 80}
  PbrMaterial: {roughness: 0.5}
  PbrTextures: {normal: bumps}
}

bumpy_ball {
  Position: {1.3, 1.1, 0}
  Sphere: {segments: 48, smooth: true, radius: 1}
  Rgb: {90, 160, 220}
  PbrMaterial: {roughness: 0.35}
  PbrTextures: {normal: bumps}
  texture.Transform: {scale_x: 4, scale_y: 2}
}

striped_metal {
  Position: {3.9, 1.3, -0.5}
  Rotation: {0, -0.35, 0}
  Quad: {2.2, 2.2}
  Rgb: {230, 200, 150}
  PbrMaterial: {metallic: 1, roughness: 1}
  PbrTextures: {orm: stripes}
}

glowing_box {
  Position: {0, 0.45, 2.4}
  Rotation: {0, 0.5, 0}
  Box: {0.9, 0.9, 0.9}
  Rgb: {40, 40, 40}
  Emissive: {strength: 2, color: {255, 140, 40}}
  PbrTextures: {emissive: ring}
}

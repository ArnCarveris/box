using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.ui

camera {
  Position: {0, 0, -10}
  LookAt: {0, 0, 0}
  Camera: {fov: 55}
}

ui {
  Ui: {height: 540}
  Position: {0, 0, 0}
  Layout: {direction: Column, width: 920, height: 500,
           padding: 26, spacing: 22, h: Center}
  Border: {radius: 20, width: 3, color: {120, 140, 190, 255}}
  Rgb: {30, 34, 46}

  title {
    Font: {size: 30}
    Text: {value: "Box shadows"}
    Rgb: {235, 240, 255}
  }

  blurs {
    Layout: {direction: Row, width: 868, height: 150, spacing: 26,
             h: Center, v: Middle}

    blur_none {
      Rect: {180, 96}
      Border: {radius: 16}
      Rgb: {80, 120, 190}
      BoxShadow: {y: 8, color: {0, 0, 0, 190}}
    }

    blur_small {
      Rect: {180, 96}
      Border: {radius: 16}
      Rgb: {80, 120, 190}
      BoxShadow: {y: 8, blur: 10, color: {0, 0, 0, 190}}
    }

    blur_large {
      Rect: {180, 96}
      Border: {radius: 16}
      Rgb: {80, 120, 190}
      BoxShadow: {y: 8, blur: 28, color: {0, 0, 0, 190}}
    }

    blur_spread {
      Rect: {180, 96}
      Border: {radius: 16}
      Rgb: {80, 120, 190}
      BoxShadow: {y: 8, blur: 24, spread: 10, color: {0, 0, 0, 190}}
    }
  }

  offsets {
    Layout: {direction: Row, width: 868, height: 150, spacing: 26,
             h: Center, v: Middle}

    offset_left {
      Rect: {180, 96}
      Border: {radius: 48}
      Rgb: {230, 205, 120}
      BoxShadow: {x: -18, y: 14, blur: 18, color: {20, 10, 40, 200}}
    }

    offset_right {
      Rect: {180, 96}
      Border: {radius: 8}
      Rgb: {230, 140, 110}
      BoxShadow: {x: 18, y: 14, blur: 18, color: {20, 10, 40, 200}}
    }

    colored {
      Rect: {180, 96}
      Border: {radius: 16}
      Rgb: {120, 215, 170}
      BoxShadow: {y: 0, blur: 30, spread: 6, color: {80, 255, 190, 200}}
    }

    round {
      Circle: {radius: 48}
      Rgb: {200, 165, 240}
      BoxShadow: {y: 12, blur: 20, color: {0, 0, 0, 200}}
    }
  }
}

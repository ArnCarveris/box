using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.view

$ { LodSettings: {enabled: true, error_px: 2} }

$ { EnvironmentLight: {sky_color: {96, 122, 160}, ground_color: {48, 44, 40}, intensity: 1} }

camera {
  Position: {0, 6, -16}
  LookAt: {0, 2.5, 40}
  Camera: {fov: 50, far_: 500}
}

sun {
  Rotation: {0.85, -0.55, 0}
  DirectionalLight: {intensity: 1.1}
  Rgb: {255, 246, 230}
}

ground {
  Position: {0, -0.25, 80}
  Box: {200, 0.5, 500}
  Rgb: {70, 74, 80}
  PbrMaterial: {roughness: 0.9}
}

near {
  for i in 0..3 {
    _ {
      Position: {i * 9 - 9, 2.5, 0}
      Sphere: {segments: 32, smooth: false, radius: 2.2}
      Rgb: {225, 120, 80}
      PbrMaterial: {roughness: 0.45}
    }
  }
}

middle {
  for i in 0..5 {
    _ {
      Position: {i * 6 - 12, 1.5, 16}
      Sphere: {segments: 32, smooth: false, radius: 1.3}
      Rgb: {110, 190, 230}
      PbrMaterial: {roughness: 0.4}
    }
  }
}

far {
  for i in 0..7 {
    _ {
      Position: {i * 6 - 18, 1.6, 50}
      Sphere: {segments: 32, smooth: false, radius: 1.4}
      Rgb: {130, 215, 130}
      PbrMaterial: {roughness: 0.4}
    }
  }
}

distant {
  for i in 0..9 {
    _ {
      Position: {i * 7 - 28, 1.4, 150}
      Sphere: {segments: 32, smooth: false, radius: 1.2}
      Rgb: {225, 200, 110}
      PbrMaterial: {roughness: 0.4}
    }
  }
}

view { box.view.View: {camera: camera} }

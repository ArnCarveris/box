using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.surface
using box.layout
using box.text

screen_texture {}

screen_ui {
  Scene: {}

  camera {
    Position: {0, 0, 100}
    Camera: {ortho: true, ortho_scale: 1}
  }

  dashboard {
    Position: {0, 0, 0}
    Layout: {direction: Row, spacing: 16, padding: {14, 14, 18, 18}, v: Bottom}
    Item: {
      width: {mode: Fixed, value: 512}, height: {mode: Fixed, value: 160}
    }
    Rect: {1, 1}
    Rgb: {14, 22, 40}
    Border: {width: 3, color: {60, 200, 230, 255}}

    info {
      Layout: {direction: Column, spacing: 6}

      title {
        Text: {value: "REACTOR", size: 30}
        Rgb: {120, 230, 250}
      }

      status {
        Text: {value: "Output 82%", size: 18}
        Rgb: {250, 210, 90}
      }

      alert {
        Layout: {direction: Row, spacing: 6, padding: {4, 4, 8, 8}, v: Middle}
        Rect: {1, 1}
        Rgb: {150, 40, 40}
        Border: {radius: 6}

        dot {
          Circle: {5}
          Rgb: {255, 220, 220}
        }

        text {
          Text: {value: "Coolant low", size: 14}
          Rgb: {255, 255, 255}
        }
      }
    }

    chart {
      Layout: {direction: Row, spacing: 8, padding: {8, 8, 8, 8}, v: Bottom}
      Item: {width: {mode: Grow}, height: {mode: Grow}}
      Rect: {1, 1}
      Rgb: {24, 36, 60}
      Border: {radius: 8}

      bar_0 {
        Item: {width: {mode: Grow}}
        Rect: {1, 34}
        Rgb: {60, 200, 230}
        Border: {radius: 3}
      }

      bar_1 {
        Item: {width: {mode: Grow}}
        Rect: {1, 52}
        Rgb: {60, 200, 230}
        Border: {radius: 3}
      }

      bar_2 {
        Item: {width: {mode: Grow}}
        Rect: {1, 78}
        Rgb: {60, 200, 230}
        Border: {radius: 3}
      }

      bar_3 {
        Item: {width: {mode: Grow}}
        Rect: {1, 96}
        Rgb: {250, 120, 90}
        Border: {radius: 3}
      }

      bar_4 {
        Item: {width: {mode: Grow}}
        Rect: {1, 70}
        Rgb: {60, 200, 230}
        Border: {radius: 3}
      }

      bar_5 {
        Item: {width: {mode: Grow}}
        Rect: {1, 58}
        Rgb: {60, 200, 230}
        Border: {radius: 3}
      }

      bar_6 {
        Item: {width: {mode: Grow}}
        Rect: {1, 88}
        Rgb: {60, 200, 230}
        Border: {radius: 3}
      }

      bar_7 {
        Item: {width: {mode: Grow}}
        Rect: {1, 64}
        Rgb: {60, 200, 230}
        Border: {radius: 3}
      }

      bar_8 {
        Item: {width: {mode: Grow}}
        Rect: {1, 40}
        Rgb: {60, 200, 230}
        Border: {radius: 3}
      }

      bar_9 {
        Item: {width: {mode: Grow}}
        Rect: {1, 26}
        Rgb: {60, 200, 230}
        Border: {radius: 3}
      }
    }
  }
}

screen_views {
  view {
    View: {
      camera: screen_ui.camera,
      clear: {enabled: true, color: {0, 0, 0, 255}},
      lighting: {enabled: false},
      culling: {enabled: false}
    }
  }
}

screen_surface {
  Surface: {width: 512, height: 160, texture: screen_texture, view_root: screen_views}
}

camera {
  Position: {1.0, 1.9, 1.5}
  Rotation: {-0.08, 0.22, 0}
  Camera: {fov: 55}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {40, 44, 56, 255}}, shadows: {enabled: true}}
}

sun {
  Rotation: {0.4791, 1.9957, 0}
  DirectionalLight: {intensity: 1.5 * flecs.script.math.PI}
  Rgb: {255, 244, 225}
}

floor {
  Position: {0, -0.05, 0}
  Box: {24, 0.1, 24}
  Rgb: {90, 94, 104}
  PbrMaterial: {roughness: 0.8}
}

stand {
  Position: {0, 0.6, -2.45}
  Box: {0.3, 1.2, 0.3}
  Rgb: {60, 64, 74}
}

template Slice {
  prop offset: f32 = 0

  Quad: {0.305, 0.94}
  Rgb: {0, 0, 0}
  PbrMaterial: {metallic: 0, roughness: 1}
  Emissive: {strength: 1, color: {255, 255, 255}}
  PbrTextures: {albedo: screen_texture, emissive: screen_texture}
  texture.Transform: {scale_x: 0.0625, scale_y: 1, offset_x: offset, offset_y: 0}
  texture.Wrap: Clamp
}

screen {
  Position: {0, 1.6, 0.5}

  slice_0 {
    Position: {-2.0449, 0, -2.1951}
    Rotation: {0, 0.7500, 0}
    Slice: {offset: 0.0}
  }

  slice_1 {
    Position: {-1.8156, 0, -2.3883}
    Rotation: {0, 0.6500, 0}
    Slice: {offset: 0.0625}
  }

  slice_2 {
    Position: {-1.5681, 0, -2.5576}
    Rotation: {0, 0.5500, 0}
    Slice: {offset: 0.125}
  }

  slice_3 {
    Position: {-1.3049, 0, -2.7013}
    Rotation: {0, 0.4500, 0}
    Slice: {offset: 0.1875}
  }

  slice_4 {
    Position: {-1.0287, 0, -2.8181}
    Rotation: {0, 0.3500, 0}
    Slice: {offset: 0.25}
  }

  slice_5 {
    Position: {-0.7422, 0, -2.9067}
    Rotation: {0, 0.2500, 0}
    Slice: {offset: 0.3125}
  }

  slice_6 {
    Position: {-0.4483, 0, -2.9663}
    Rotation: {0, 0.1500, 0}
    Slice: {offset: 0.375}
  }

  slice_7 {
    Position: {-0.1499, 0, -2.9963}
    Rotation: {0, 0.0500, 0}
    Slice: {offset: 0.4375}
  }

  slice_8 {
    Position: {0.1499, 0, -2.9963}
    Rotation: {0, -0.0500, 0}
    Slice: {offset: 0.5}
  }

  slice_9 {
    Position: {0.4483, 0, -2.9663}
    Rotation: {0, -0.1500, 0}
    Slice: {offset: 0.5625}
  }

  slice_10 {
    Position: {0.7422, 0, -2.9067}
    Rotation: {0, -0.2500, 0}
    Slice: {offset: 0.625}
  }

  slice_11 {
    Position: {1.0287, 0, -2.8181}
    Rotation: {0, -0.3500, 0}
    Slice: {offset: 0.6875}
  }

  slice_12 {
    Position: {1.3049, 0, -2.7013}
    Rotation: {0, -0.4500, 0}
    Slice: {offset: 0.75}
  }

  slice_13 {
    Position: {1.5681, 0, -2.5576}
    Rotation: {0, -0.5500, 0}
    Slice: {offset: 0.8125}
  }

  slice_14 {
    Position: {1.8156, 0, -2.3883}
    Rotation: {0, -0.6500, 0}
    Slice: {offset: 0.875}
  }

  slice_15 {
    Position: {2.0449, 0, -2.1951}
    Rotation: {0, -0.7500, 0}
    Slice: {offset: 0.9375}
  }
}

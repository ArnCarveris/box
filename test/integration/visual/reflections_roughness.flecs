using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light

// A smooth and a rough gold ball side by side in a dark room whose walls carry bright red,
// green, blue and white panels, all in one box projected room probe. The smooth ball mirrors
// the panels sharply, the rough one, sampling a blurrier mip of the same probe, shows them as
// soft colored glows. Two small balls in front repeat both roughnesses in silver.
room {
  Scene: {}
  ReflectionBake: {resolution: 128}
  AmbientLight: {intensity: 0.05}

  camera {
    Position: {0, 1.3, 3.2}
    Rotation: {-0.12, 0, 0}
    Camera: {fov: 60}
  }

  lamp {
    Position: {0, 2.8, 1}
    PointLight: {intensity: 3 * flecs.script.math.PI, range: 10}
  }

  floor {
    Position: {0, -0.1, 0}
    Box: {6.4, 0.2, 8.4}
    Rgb: {70, 70, 74}
    PbrMaterial: {roughness: 0.5}
  }

  ceiling {
    Position: {0, 3.1, 0}
    Box: {6.4, 0.2, 8.4}
    Rgb: {40, 40, 44}
  }

  back_wall {
    Position: {0, 1.5, -4.1}
    Box: {6.4, 3, 0.2}
    Rgb: {40, 40, 44}
  }

  front_wall {
    Position: {0, 1.5, 4.1}
    Box: {6.4, 3, 0.2}
    Rgb: {40, 40, 44}
  }

  left_wall {
    Position: {-3.1, 1.5, 0}
    Box: {0.2, 3, 8}
    Rgb: {40, 40, 44}
  }

  right_wall {
    Position: {3.1, 1.5, 0}
    Box: {0.2, 3, 8}
    Rgb: {40, 40, 44}
  }

  red_panel {
    Position: {-2.95, 1.5, -1}
    Box: {0.1, 1.6, 1.2}
    Rgb: {0, 0, 0}
    Emissive: {strength: 2, color: {255, 40, 30}}
  }

  green_panel {
    Position: {2.95, 1.5, -1}
    Box: {0.1, 1.6, 1.2}
    Rgb: {0, 0, 0}
    Emissive: {strength: 2, color: {40, 255, 60}}
  }

  blue_panel {
    Position: {0, 1.6, 3.95}
    Box: {3, 0.8, 0.1}
    Rgb: {0, 0, 0}
    Emissive: {strength: 2, color: {50, 90, 255}}
  }

  white_strip {
    Position: {0, 2.95, 0}
    Box: {0.3, 0.1, 5}
    Rgb: {0, 0, 0}
    Emissive: {strength: 3, color: {255, 250, 240}}
  }

  smooth {
    Position: {-0.9, 0.8, -0.8}
    Sphere: {segments: 48, smooth: true, radius: 0.8}
    Rgb: {255, 205, 120}
    PbrMaterial: {metallic: 1, roughness: 0.05}
  }

  rough {
    Position: {0.9, 0.8, -0.8}
    Sphere: {segments: 48, smooth: true, radius: 0.8}
    Rgb: {255, 205, 120}
    PbrMaterial: {metallic: 1, roughness: 0.55}
  }

  smooth_silver {
    Position: {-0.45, 0.3, 0.6}
    Sphere: {segments: 32, smooth: true, radius: 0.3}
    Rgb: {240, 240, 245}
    PbrMaterial: {metallic: 1, roughness: 0.05}
  }

  rough_silver {
    Position: {0.45, 0.3, 0.6}
    Sphere: {segments: 32, smooth: true, radius: 0.3}
    Rgb: {240, 240, 245}
    PbrMaterial: {metallic: 1, roughness: 0.55}
  }

  probe {
    Position: {0, 1.5, 0}
    ReflectionProbe: {extent: {3.2, 1.7, 4.2}, blend: 0.2, projection: {3, 1.5, 4}}
  }
}

room_view {
  View: {camera: room.camera, clear: {enabled: true, color: {0, 0, 0, 255}}}
}

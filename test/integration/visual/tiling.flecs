using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.texture

$ {
  EnvironmentLight: {sky_color: {150, 175, 215}, ground_color: {95, 88, 80}, intensity: 1.1}
}

textures {
  checker {
    Texture: {path: "etc/textures/checker.png"}
  }
}

camera {
  Position: {0, 8, -14}
  LookAt: {0, 0.5, 1.5}
  Camera: {fov: 48}
}

sun {
  Rotation: {0.95, -0.2, 0}
  DirectionalLight: {intensity: 2.6}
}

floor {
  Position: {0, -0.1, 2}
  Box: {26, 0.2, 18}
  Rgb: {215, 215, 220}
  PbrMaterial: {roughness: 0.9}
  PbrTextures: {albedo: textures.checker}
  TextureTiling: {meters_x: 1, meters_y: 1, shape: TilingBox}
}

sizes {
  one {
    Position: {-9, 0.5, 4}
    Box: {1, 1, 1}
    Rgb: {255, 248, 232}
    PbrMaterial: {roughness: 0.6}
    PbrTextures: {albedo: textures.checker}
    TextureTiling: {meters_x: 1, meters_y: 1, shape: TilingBox}
  }

  two {
    Position: {-7, 1, 4}
    Box: {2, 2, 2}
    Rgb: {255, 248, 232}
    PbrMaterial: {roughness: 0.6}
    PbrTextures: {albedo: textures.checker}
    TextureTiling: {meters_x: 1, meters_y: 1, shape: TilingBox}
  }

  six {
    Position: {-0.5, 1.5, 4}
    Box: {6, 3, 3}
    Rgb: {255, 248, 232}
    PbrMaterial: {roughness: 0.6}
    PbrTextures: {albedo: textures.checker}
    TextureTiling: {meters_x: 1, meters_y: 1, shape: TilingBox}
  }

  column {
    Position: {5, 1.5, 4}
    Cylinder: {segments: 64, smooth: true, radius: 1, length: 3}
    Rgb: {255, 248, 232}
    PbrMaterial: {roughness: 0.55}
    PbrTextures: {albedo: textures.checker}
    TextureTiling: {meters_x: 1, meters_y: 1, shape: TilingCylinder}
  }

  ball {
    Position: {8.3, 1.3, 4}
    Sphere: {segments: 64, smooth: true, radius: 1.3}
    Rgb: {255, 248, 232}
    PbrMaterial: {roughness: 0.5}
    PbrTextures: {albedo: textures.checker}
    TextureTiling: {meters_x: 1, meters_y: 1, shape: TilingBox}
  }
}

modes {
  offset {
    Position: {-7.6, 0.8, -4}
    Box: {1.6, 1.6, 1.6}
    Rgb: {250, 232, 205}
    PbrMaterial: {roughness: 0.6}
    PbrTextures: {albedo: textures.checker}
    TextureTiling: {meters_x: 1, meters_y: 1, shape: TilingBox}
    TextureTransform: {scale_x: 1, scale_y: 1, offset_x: 0.5, offset_y: 0.5}
  }

  mirror {
    Position: {-4.5, 0.8, -4}
    Box: {1.6, 1.6, 1.6}
    Rgb: {210, 235, 250}
    PbrMaterial: {roughness: 0.6}
    PbrTextures: {albedo: textures.checker}
    TextureTiling: {meters_x: 2, meters_y: 2, shape: TilingBox}
    TextureWrap: {WrapMirror}
  }

  clamp {
    Position: {-1.5, 0.8, -4}
    Box: {1.6, 1.6, 1.6}
    Rgb: {250, 212, 208}
    PbrMaterial: {roughness: 0.6}
    PbrTextures: {albedo: textures.checker}
    TextureTiling: {meters_x: 2, meters_y: 2, shape: TilingBox}
    TextureWrap: {WrapClamp}
  }

  coarse {
    Position: {1.5, 0.8, -4}
    Box: {1.6, 1.6, 1.6}
    Rgb: {205, 245, 215}
    PbrMaterial: {roughness: 0.6}
    PbrTextures: {albedo: textures.checker}
    TextureTiling: {meters_x: 1, meters_y: 1, shape: TilingBox}
  }

  fine {
    Position: {4.5, 0.8, -4}
    Box: {1.6, 1.6, 1.6}
    Rgb: {205, 245, 215}
    PbrMaterial: {roughness: 0.6}
    PbrTextures: {albedo: textures.checker}
    TextureTiling: {meters_x: 0.5, meters_y: 0.5, shape: TilingBox}
  }

  fitted {
    Position: {7.7, 0.8, -4}
    Box: {2.6, 1.6, 1.6}
    Rgb: {235, 220, 255}
    PbrMaterial: {roughness: 0.6}
    PbrTextures: {albedo: textures.checker}
    TextureTiling: {meters_x: 1, meters_y: 1, fit: true, shape: TilingBox}
  }
}

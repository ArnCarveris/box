using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.layout
using box.text
using box.projection

$ {
  Scene: {blend_modes: true}
}

world_camera {
  Position: {0, 3, 8}
  Rotation: {-0.32, 0, 0}
  Camera: {fov: 55}
}

world_view {
  View: {
    camera: world_camera,
    clear: {enabled: true, color: {120, 150, 190, 255}},
    shadows: {enabled: true}
  }
}

sun {
  Rotation: {0.7359, 2.3726, 0}
  DirectionalLight: {intensity: 2 * flecs.script.math.PI}
  Rgb: {255, 244, 225}
}

ground {
  Position: {0, -0.05, 0}
  box.geometry.Box: {24, 0.1, 24}
  Rgb: {140, 150, 125}
  PbrMaterial: {roughness: 0.9}
}

crate {
  Position: {-2.2, 0.5, -0.5}
  Rotation: {0, 0.4, 0}
  box.geometry.Box: {1, 1, 1}
  Rgb: {200, 150, 80}
}

pillar {
  Position: {2.6, 1.25, -2}
  Cylinder: {segments: 24, smooth: true, radius: 0.4, length: 2.5}
  Rgb: {180, 180, 190}
}

hero {
  Position: {0.3, 0.9, 0.5}
  Capsule: {segments: 24, smooth: true, length: 0.8, radius: 0.45}
  Rgb: {220, 90, 60}
}

template Bar {
  prop label: string = "HP"
  prop fill: f32 = 100
  prop r: u8 = 90
  prop g: u8 = 210
  prop b: u8 = 110

  Layout: {direction: Row, spacing: 8, v: Middle}

  name {
    Item: {width: {mode: Fixed, value: 26}}
    Text: {value: label, size: 14}
    Rgb: {230, 235, 245}
  }

  track {
    Layout: {padding: {2, 2, 2, 2}}
    Item: {width: {mode: Fixed, value: 150}, height: {mode: Fixed, value: 14}}
    Rect: {1, 1}
    Rgb: {40, 44, 56}
    Border: {radius: 4}

    fill {
      Item: {h: Left, width: {mode: Fixed, value: fill}, height: {mode: Grow}}
      Rect: {1, 1}
      Rgb: {r, g, b}
      Border: {radius: 3}
    }
  }
}

hud {
  Scene: {blend_modes: true}

  camera {
    Position: {0, 0, 100}
    Camera: {ortho: true, ortho_scale: 1}
  }

  screen {
    Layout: {padding: {12, 12, 12, 12}}
    Item: {width: {mode: Fixed, value: 640}, height: {mode: Fixed, value: 360}}

    status {
      Item: {h: Left, v: Top}
      Layout: {direction: Column, spacing: 6, padding: {8, 8, 10, 10}}
      Rect: {1, 1}
      Rgb: {16, 20, 28}
      Opacity: {0.85}
      Border: {width: 1, radius: 8, color: {90, 110, 150, 255}}

      health {
        Bar: {label: "HP", fill: 104}
      }

      mana {
        Bar: {label: "MP", fill: 60, r: 80, g: 140, b: 250}
      }
    }

    minimap {
      Item: {h: Right, v: Top}
      Rect: {120, 90}
      Rgb: {30, 46, 40}
      Border: {width: 2, radius: 6, color: {200, 210, 220, 255}}

      path {
        Position: {0, 0, 0}
        Line: {x1: -8, y1: -4, x2: 30, y2: 20, width: 1}
        Rgb: {160, 190, 170}
      }

      you {
        Position: {-8, -4, 0}
        Circle: {4}
        Rgb: {250, 200, 60}
      }

      enemy {
        Position: {30, 20, 0}
        Circle: {3}
        Rgb: {230, 70, 60}
      }
    }

    crosshair {
      Item: {h: Center, v: Middle}
      Rect: {2, 2}
      Rgb: {255, 255, 255}

      left {
        Position: {0, 0, 0}
        Line: {x1: -12, y1: 0, x2: -5, y2: 0, width: 2}
        Rgb: {255, 255, 255}
      }

      right {
        Position: {0, 0, 0}
        Line: {x1: 5, y1: 0, x2: 12, y2: 0, width: 2}
        Rgb: {255, 255, 255}
      }

      up {
        Position: {0, 0, 0}
        Line: {x1: 0, y1: 5, x2: 0, y2: 12, width: 2}
        Rgb: {255, 255, 255}
      }

      down {
        Position: {0, 0, 0}
        Line: {x1: 0, y1: -5, x2: 0, y2: -12, width: 2}
        Rgb: {255, 255, 255}
      }
    }

    ammo {
      Item: {h: Right, v: Bottom}
      Layout: {direction: Row, spacing: 6, padding: {6, 6, 10, 10}, v: Bottom}
      Rect: {1, 1}
      Rgb: {16, 20, 28}
      Opacity: {0.85}
      Border: {radius: 8}

      count {
        Text: {value: "24", size: 32}
        Rgb: {255, 255, 255}
      }

      total {
        Text: {value: "/ 90", size: 16}
        Rgb: {170, 180, 200}
      }
    }
  }

  hero_plate {
    Anchor: {target: hero, view: world_view, offset: {0, 1.2, 0}}
    Layout: {direction: Column, spacing: 3, padding: {4, 4, 6, 6}, h: Center}
    Rect: {1, 1}
    Rgb: {16, 20, 28}
    Border: {radius: 5}

    name {
      Text: {value: "Hero", size: 13}
      Rgb: {255, 255, 255}
    }

    life {
      Rect: {64, 5}
      Rgb: {90, 210, 110}
    }
  }
}

hud_view {
  View: {camera: hud.camera, lighting: {enabled: false}, culling: {enabled: false}}
}

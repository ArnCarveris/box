// effects/showcase
using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.texture
using box.movement
using box.effects

$ {
  EnvironmentLight: {sky_color: {120, 150, 200}, ground_color: {82, 66, 50}, intensity: 1.7}
}

textures {
  checker {
    Texture: {path: "etc/textures/checker.png"}
  }

  rough {
    Texture: {path: "etc/textures/roughness.png"}
  }

  bumps {
    Texture: {path: "etc/textures/bumps_normal.png"}
  }
}

camera {
  Position: {0, 3.8, -12}
  LookAt: {0.4, 1.8, 5}
  Camera: {fov: 54, near_: 0.2, far_: 400}
}

sun {
  Rotation: {0.85, -0.45, 0}
  DirectionalLight: {intensity: 2}
}

floor {
  Position: {0, -0.2, 50}
  Box: {44, 0.4, 170}
  Rgb: {175, 175, 180}
  PbrMaterial: {roughness: 0.85}
  PbrTextures: {albedo: textures.checker, roughness: textures.rough}
  TextureTiling: {meters_x: 8, meters_y: 8}
}

mirror {
  Position: {-0.5, 0.04, 8}
  Box: {7, 0.08, 22}
  Rgb: {56, 58, 66}
  PbrMaterial: {roughness: 0.08, metallic: 0.3}
}

wall_left {
  Position: {-8.5, 2.6, 4}
  Box: {0.4, 5.2, 20}
  Rgb: {235, 235, 240}
  PbrMaterial: {roughness: 0.9}
  PbrTextures: {albedo: textures.checker}
  TextureTiling: {meters_x: 3, meters_y: 3}
}

crate_dust {
  Position: {-5.8, 1, 1}
  Rotation: {0, 0.3, 0}
  Box: {2, 2, 2}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0.1, roughness: 0.7}
  PbrTextures: {albedo: textures.checker}
  (MaterialLayerOn, box.material.layers.dust)
}

crate_wear {
  Position: {-5.8, 2.7, 1}
  Rotation: {0, 0.8, 0}
  Box: {1.4, 1.4, 1.4}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0.2, roughness: 0.6}
  PbrTextures: {albedo: textures.checker}
  (MaterialLayerOn, box.material.layers.edge_wear)
}

crate_grime {
  Position: {-4, 0.75, 4}
  Rotation: {0, -0.4, 0}
  Box: {1.5, 1.5, 1.5}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0.1, roughness: 0.75}
  PbrTextures: {albedo: textures.checker}
  (MaterialLayerOn, box.material.layers.grime)
}

bumped {
  Position: {-6.6, 0.8, 6.6}
  Rotation: {0, 0.5, 0}
  Box: {1.6, 1.6, 1.6}
  Rgb: {190, 200, 220}
  PbrMaterial: {metallic: 0.3, roughness: 0.35}
  PbrTextures: {normal: textures.bumps}
}

ball_wet {
  Position: {-2.8, 0.8, 7}
  Sphere: {segments: 32, smooth: true, radius: 0.8}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0.15, roughness: 0.7}
  PbrTextures: {albedo: textures.checker}
  (MaterialLayerOn, box.material.layers.wetness)
}

ball_metal {
  Position: {-1.8, 1.1, 1.4}
  Sphere: {segments: 40, smooth: true, radius: 1.1}
  Rgb: {215, 210, 200}
  PbrMaterial: {metallic: 0.95, roughness: 0.12}
}

ball_rough {
  Position: {0.4, 0.75, 5}
  Sphere: {segments: 32, smooth: true, radius: 0.75}
  Rgb: {180, 120, 95}
  PbrMaterial: {metallic: 0, roughness: 0.85}
}

spinner {
  Position: {1.4, 1.3, 2.6}
  Rotation: {0, 0.4, 0}
  AngularVelocity: {0, 1.1, 0}
  Box: {1.6, 1.6, 1.6}
  Rgb: {225, 225, 235}
  PbrMaterial: {metallic: 0.8, roughness: 0.22}
}

lamp_bar {
  Position: {0.4, 2.7, 6.4}
  Box: {4.4, 0.3, 0.3}
  Rgb: {20, 20, 20}
  Emissive: {strength: 26, color: {255, 186, 92}}
}

spark {
  Position: {-1, 4.6, 9}
  Sphere: {segments: 12, smooth: true, radius: 0.1}
  Rgb: {20, 20, 20}
  Emissive: {strength: 180, color: {255, 255, 255}}
}

crate_behind {
  Position: {2.8, 0.9, 3.2}
  Rotation: {0, 0.35, 0}
  Box: {1.8, 1.8, 1.8}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0.1, roughness: 0.65}
  PbrTextures: {albedo: textures.checker}
}

ball_behind {
  Position: {6.75, 0.7, 3}
  Sphere: {segments: 32, smooth: true, radius: 0.7}
  Rgb: {120, 190, 140}
  PbrMaterial: {metallic: 0.3, roughness: 0.4}
}

crate_glass_back {
  Position: {9.6, 1, 3.4}
  Rotation: {0, -0.3, 0}
  Box: {2, 2, 2}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0.1, roughness: 0.7}
  PbrTextures: {albedo: textures.checker}
}

lamp_ball {
  Position: {10.9, 2, 5.6}
  Sphere: {segments: 24, smooth: true, radius: 0.5}
  Rgb: {20, 20, 20}
  Emissive: {strength: 14, color: {120, 210, 255}}
}

panel_alpha {
  Position: {2.7, 1.8, -1}
  Quad: {2.4, 2.4}
  Rgb: {70, 140, 255}
  Opacity: {0.55}
  PbrMaterial: {roughness: 0.05}
  BlendMode: {AlphaBlend}
}

panel_additive {
  Position: {4.9, 1.9, -1}
  Quad: {2, 2}
  Rgb: {60, 220, 170}
  Opacity: {0.6}
  PbrMaterial: {roughness: 0.05}
  BlendMode: {Additive}
}

panel_glass {
  Position: {6.9, 1.9, -1}
  Quad: {2.6, 2.6}
  Rgb: {150, 180, 205}
  Opacity: {0.5}
  PbrMaterial: {roughness: 0.8}
  BlendMode: {AlphaBlend}
}

pillar_a {
  Position: {-11, 3.5, 16}
  Box: {1.4, 7, 1.4}
  Rgb: {210, 206, 198}
  PbrMaterial: {roughness: 0.7}
}

pillar_b {
  Position: {11, 3.5, 16}
  Box: {1.4, 7, 1.4}
  Rgb: {210, 206, 198}
  PbrMaterial: {roughness: 0.7}
}

pillar_c {
  Position: {-11, 3.5, 26}
  Box: {1.4, 7, 1.4}
  Rgb: {210, 206, 198}
  PbrMaterial: {roughness: 0.7}
}

pillar_d {
  Position: {11, 3.5, 26}
  Box: {1.4, 7, 1.4}
  Rgb: {210, 206, 198}
  PbrMaterial: {roughness: 0.7}
}

pillar_e {
  Position: {-11, 3.5, 40}
  Box: {1.4, 7, 1.4}
  Rgb: {210, 206, 198}
  PbrMaterial: {roughness: 0.7}
}

pillar_f {
  Position: {11, 3.5, 40}
  Box: {1.4, 7, 1.4}
  Rgb: {210, 206, 198}
  PbrMaterial: {roughness: 0.7}
}

pillar_g {
  Position: {-11, 3.5, 60}
  Box: {1.4, 7, 1.4}
  Rgb: {210, 206, 198}
  PbrMaterial: {roughness: 0.7}
}

pillar_h {
  Position: {11, 3.5, 60}
  Box: {1.4, 7, 1.4}
  Rgb: {210, 206, 198}
  PbrMaterial: {roughness: 0.7}
}

pillar_i {
  Position: {-11, 3.5, 88}
  Box: {1.4, 7, 1.4}
  Rgb: {210, 206, 198}
  PbrMaterial: {roughness: 0.7}
}

pillar_j {
  Position: {11, 3.5, 88}
  Box: {1.4, 7, 1.4}
  Rgb: {210, 206, 198}
  PbrMaterial: {roughness: 0.7}
}

arch {
  Position: {0, 7.4, 26}
  Box: {24, 0.8, 1.4}
  Rgb: {210, 206, 198}
  PbrMaterial: {roughness: 0.7}
}

box { effects { stack {
  gtao {
    Effect: {enabled: true}
    Gtao: {radius: 2.5, slices: 4, steps: 10, power: 2, temporal: true, half_res: true}
  }
  ssr {
    Effect: {enabled: true}
    Ssr: {steps: 32, thickness: 0.5, max_roughness: 0.6, intensity: 1, fade: 0.12}
  }
  fog {
    Effect: {enabled: true}
    Fog: {color: {0.58, 0.63, 0.72}, density: 0.03, falloff: 0.22, start: 6,
          max_opacity: 0.92, height: 1}
  }
  bloom {
    Effect: {enabled: true}
    Bloom: {intensity: 0.14, radius: 1, knee: 0, firefly_clamp: 8}
  }
  auto_exposure {
    Effect: {enabled: true}
    AutoExposure: {speed_up: 400, speed_down: 400, min_ev: -3, max_ev: 4, target: 0.18}
  }
  tonemap {
    Effect: {enabled: true}
    ToneMapping: {white: 1, dither: true}
  }
} } }

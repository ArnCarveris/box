using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light

// Billowing fog: two low layers of FogVolume of the same density lie on a dark floor between
// pillars, seen from above. The left one has noise_strength 1 and a noise_scale of 5, so its
// density breaks into billows a few units across, with the finer detail octave on top, and its
// wind drifts them; the right one has no noise and shows the constant density next to it. The
// visual runner captures the third frame with a fixed delta of 1/60 s, so the wind has moved
// the noise by the same distance on every run.

camera {
  Position: {0, 10, 11}
  Rotation: {-0.75, 0, 0}
  Camera: {fov: 50}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {20, 22, 28, 255}}, shadows: {enabled: true}}
}

$ {
  AmbientLight: {sky: {90, 96, 110}, ground: {40, 36, 32}}
}

sun {
  Rotation: {1.0, 0.5, 0}
  DirectionalLight: {intensity: 0.8 * flecs.script.math.PI}
  Rgb: {255, 240, 220}
}

floor {
  Position: {0, -0.1, 0}
  Box: {20, 0.2, 16}
  Rgb: {28, 30, 36}
}

pillar_1 {
  Position: {-6, 1.5, -3}
  Box: {0.6, 3, 0.6}
  Rgb: {200, 190, 170}
}

pillar_2 {
  Position: {-1.5, 1.5, 2}
  Box: {0.6, 3, 0.6}
  Rgb: {200, 190, 170}
}

pillar_3 {
  Position: {5, 1.5, -2}
  Box: {0.6, 3, 0.6}
  Rgb: {200, 190, 170}
}

billows {
  Position: {-3, 0.75, 0}
  FogVolume: {
    extent: {5.5, 0.75, 6}, density: 0.35, color: {240, 242, 248}, asymmetry: 0, edge_fade: 0.4,
    noise_strength: 1, noise_scale: 5, wind: {1.5, 0, 0.5}
  }
}

plain {
  Position: {5.5, 0.75, 0}
  FogVolume: {
    extent: {2.5, 0.75, 6}, density: 0.35, color: {240, 242, 248}, asymmetry: 0, edge_fade: 0.4
  }
}

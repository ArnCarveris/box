using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light

// Billowing fog: a low bank of FogVolume over a field of pillars, lit by a warm sun from the
// side and a cool ambient, with noise_strength 1 so the density breaks into billows 6 units
// across that drift with the wind. The visual runner captures the third frame with a fixed delta
// of 1/60 s, so the wind has moved the noise by the same distance on every run. A second, thin
// volume on the right without noise shows the constant density next to it.

camera {
  Position: {0, 3, 14}
  Rotation: {-0.12, 0, 0}
  Camera: {fov: 55}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {20, 24, 32, 255}}, shadows: {enabled: true}}
}

$ {
  AmbientLight: {sky: {70, 80, 100}, ground: {30, 28, 26}}
}

sun {
  Rotation: {0.45, 1.1, 0}
  DirectionalLight: {intensity: 2 * flecs.script.math.PI}
  Rgb: {255, 220, 170}
}

ground {
  Position: {0, -0.1, 0}
  Box: {40, 0.2, 40}
  Rgb: {110, 120, 90}
}

back_wall {
  Position: {0, 4, -12}
  Box: {40, 8, 0.4}
  Rgb: {150, 140, 130}
}

pillar_1 {
  Position: {-6, 2, -4}
  Box: {0.8, 4, 0.8}
  Rgb: {180, 170, 160}
}

pillar_2 {
  Position: {-2, 2, -6}
  Box: {0.8, 4, 0.8}
  Rgb: {180, 170, 160}
}

pillar_3 {
  Position: {2, 2, -3}
  Box: {0.8, 4, 0.8}
  Rgb: {180, 170, 160}
}

pillar_4 {
  Position: {6, 2, -7}
  Box: {0.8, 4, 0.8}
  Rgb: {180, 170, 160}
}

billows {
  Position: {-2, 2, -4}
  FogVolume: {
    extent: {9, 2, 7}, density: 0.35, color: {235, 238, 245}, asymmetry: 0.4, edge_fade: 1.2,
    steps: 64, noise_strength: 1, noise_scale: 6, wind: {1.5, 0, 0.5}
  }
}

plain {
  Position: {9, 1, -4}
  FogVolume: {extent: {1.5, 1, 4}, density: 0.35, color: {235, 238, 245}, edge_fade: 0.5}
}

using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.atmosphere

$ {
  Atmosphere: {units_per_km: 100, sun_disk_intensity: 20}
}

camera {
  Position: {0, 2, 12}
  Rotation: {0.12, 0, 0}
  Camera: {fov: 70, far_: 0}
}

bloom {
  Bloom: {intensity: 0.35, threshold: 1, threshold_softness: 0.5}
}

tonemap {
  Tonemap: {}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {0, 0, 0, 255}}, effects: [{effect: bloom}, {effect: tonemap}]}
}

sun {
  Rotation: {0.05236, 0.4, 0}
  DirectionalLight: {intensity: 6}
  Rgb: {255, 255, 255}
}

ground {
  Position: {0, -0.1, -4000}
  Box: {12000, 0.2, 8100}
  Rgb: {110, 130, 90}
  PbrMaterial: {roughness: 0.9}
}

// Boxes 10, 40, 160, 640 and 2560 units (0.1 to 25.6 km) in front of the camera
box_10 {
  Position: {-5.8, 1, 2}
  Box: {2, 2, 2}
  Rgb: {220, 220, 220}
}

box_40 {
  Position: {-10.7, 3, -28}
  Box: {6, 6, 6}
  Rgb: {220, 220, 220}
}

box_160 {
  Position: {0, 10, -148}
  Box: {20, 20, 20}
  Rgb: {220, 220, 220}
}

box_640 {
  Position: {171.5, 30, -628}
  Box: {60, 60, 60}
  Rgb: {220, 220, 220}
}

box_2560 {
  Position: {1478, 120, -2548}
  Box: {240, 240, 240}
  Rgb: {220, 220, 220}
}

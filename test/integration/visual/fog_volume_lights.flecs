using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light

// Fog volumes lit by point and spot lights: a street at night with four lamps on the left
// side, spot lights shining down, in a long fog volume, so each lamp draws its cone through the
// fog onto the road. A pole stands inside the cone of the second lamp, which casts shadows, and
// leaves a dark wedge in its cone. To the right a blue point light glows in a small fog volume
// of its own. There is no sun; a faint ambient keeps the fog outside the cones barely visible.

camera {
  Position: {3, 1.7, 5}
  Rotation: {-0.05, 0.18, 0}
  Camera: {fov: 55}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {6, 7, 12, 255}}, shadows: {enabled: true}}
}

$ {
  AmbientLight: {sky: {30, 34, 48}, ground: {14, 13, 12}, intensity: 0.3}
}

road {
  Position: {0, -0.1, -12}
  Box: {14, 0.2, 40}
  Rgb: {70, 70, 74}
}

sidewalk {
  Position: {-5.5, 0.05, -12}
  Box: {3, 0.3, 40}
  Rgb: {120, 116, 110}
}

wall {
  Position: {-7.2, 3, -12}
  Box: {0.4, 6, 40}
  Rgb: {110, 90, 80}
}

// Lamp heads 4.5 above the sidewalk every 7 units, each on a post behind its light
lamp_a {
  Position: {-4, 4.5, -2}
  Rotation: {1.5708, 0, 0}
  SpotLight: {intensity: 16 * flecs.script.math.PI, range: 8, inner_angle: 22, outer_angle: 34}
  Rgb: {255, 200, 140}
}

lamp_b {
  Position: {-4, 4.5, -9}
  Rotation: {1.5708, 0, 0}
  SpotLight: {intensity: 16 * flecs.script.math.PI, range: 8, inner_angle: 22, outer_angle: 34, shadows: true}
  Rgb: {255, 200, 140}
}

lamp_c {
  Position: {-4, 4.5, -16}
  Rotation: {1.5708, 0, 0}
  SpotLight: {intensity: 16 * flecs.script.math.PI, range: 8, inner_angle: 22, outer_angle: 34}
  Rgb: {255, 200, 140}
}

lamp_d {
  Position: {-4, 4.5, -23}
  Rotation: {1.5708, 0, 0}
  SpotLight: {intensity: 16 * flecs.script.math.PI, range: 8, inner_angle: 22, outer_angle: 34}
  Rgb: {255, 200, 140}
}

post_a {
  Position: {-6.4, 2.35, -2}
  Box: {0.15, 4.7, 0.15}
  Rgb: {40, 40, 44}
}

post_b {
  Position: {-6.4, 2.35, -9}
  Box: {0.15, 4.7, 0.15}
  Rgb: {40, 40, 44}
}

post_c {
  Position: {-6.4, 2.35, -16}
  Box: {0.15, 4.7, 0.15}
  Rgb: {40, 40, 44}
}

post_d {
  Position: {-6.4, 2.35, -23}
  Box: {0.15, 4.7, 0.15}
  Rgb: {40, 40, 44}
}

// The pole in the cone of lamp_b, whose shadow cuts a wedge out of its cone
pole {
  Position: {-3.4, 1.6, -9}
  Box: {0.25, 3.2, 0.25}
  Rgb: {90, 90, 96}
}

street_fog {
  Position: {-2, 2.5, -12}
  FogVolume: {extent: {4.8, 2.5, 16}, density: 0.18, color: {220, 224, 235}, asymmetry: 0.3, edge_fade: 0.5, steps: 64}
}

// A blue point light in a fog volume of its own across the road
glow {
  Position: {5, 1.5, -10}
  PointLight: {intensity: 3 * flecs.script.math.PI, range: 3}
  Rgb: {80, 150, 255}
}

glow_fog {
  Position: {5, 1.5, -10}
  FogVolume: {extent: {2, 1.5, 2}, density: 0.6, asymmetry: 0, edge_fade: 0.4, steps: 48}
}

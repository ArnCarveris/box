using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.atmosphere

tonemap {
  Tonemap: {}
}

camera {
  Position: {0, 2, 12}
  Rotation: {0.2, 0, 0}
  Camera: {fov: 60, far_: 0}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {0, 0, 0, 255}}, effects: [{effect: tonemap}]}
}

// The sun 40 degrees up behind the camera, off to one side
sun {
  Rotation: {0.6981, 2.4, 0}
  DirectionalLight: {intensity: 3}
  Rgb: {255, 255, 255}
}

// The moon 20 degrees up in front of the camera, 108 degrees from the sun: a gibbous moon
// about two thirds lit
moon {
  Rotation: {0.3491, 0, 0}
  DirectionalLight: {intensity: 1}
  Rgb: {255, 255, 255}
}

// The moon radius is enlarged so the disk is 18 pixels across a 360 high frame
$ {
  Atmosphere: {units_per_km: 100, sun: sun, moon: moon, moon_radius: 1.5, moon_disk_intensity: 8}
}

ground {
  Position: {0, -0.1, -4000}
  Box: {12000, 0.2, 8100}
  Rgb: {110, 130, 90}
  PbrMaterial: {roughness: 0.9}
}

column {
  Position: {-3, 1.5, 0}
  Box: {1, 3, 1}
  Rgb: {220, 220, 220}
}

ball {
  Position: {2.5, 1, 2}
  Sphere: {segments: 32, smooth: true, radius: 1}
  Rgb: {200, 80, 60}
}

using box.transform
using box.geometry
using box.material
using box.texture
using box.camera
using box.view
using box.light

$ {
  Scene: {texture_blend: true}
}

// Height based TextureBlend transitions: two quads blend a cobble layer (top half of the mask)
// and a grass layer (bottom half) under the mask of textures_blend.flecs, whose red and green
// weigh the cobble and blue and alpha the grass, so the border is a soft horizontal band through
// the middle of each quad. The camera is close to the inner halves of the quads, around their
// borders. Both layers have a Gen height: the stones are domes that are high in the middle
// and low in the joints, the grass is noise around the middle height. The left quad has a
// contrast of 0, the linear blend, where the grass fades over the stones as a double exposure;
// the right one a contrast of 24, where the grass fills the joints between the stones and the
// stones stand out of the grass, with no ghosting. Away from the band both quads match.

camera {
  Position: {0, 0, 2.1}
  Camera: {fov: 50}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {20, 22, 28, 255}}}
}

$ {
  AmbientLight: {sky: {60, 64, 74}, ground: {28, 26, 24}}
}

key {
  Rotation: {0.6, 2.5, 0}
  DirectionalLight: {intensity: 1.2 * flecs.script.math.PI}
  Rgb: {255, 242, 226}
}

mask {
  Path: {path: "test/integration/visual/assets/blend_mask.png"}
}

cobble_height {
  Gen: {
    width: 256, height: 256, seed: 111
    layers: [
      {kind: GenCells, count: 36, distance: GenEdge, edge: 0.14, amount: 0.5, id_amount: 0.15}
      {kind: GenCells, count: 36, distance: GenEdge, edge: 0.45, amount: 0.6}
      {kind: GenNoise, frequency: 32, octaves: 3, amount: 0.15}
    ]
  }
}

cobble {
  Gen: {source: cobble_height, output: GenAlbedo,
               colors: [{0, {72, 66, 58}}, {0.3, {120, 114, 106}}, {1, {222, 214, 202}}]}
}

cobble_n {
  Gen: {source: cobble_height, output: GenNormal, strength: 3.6}
}

grass_height {
  Gen: {
    width: 256, height: 256, seed: 23
    layers: [
      {kind: GenNoise, frequency: 64, octaves: 2, amount: 0.7}
      {kind: GenNoise, frequency: 8, octaves: 3, amount: 0.3, seed: 1}
    ]
  }
}

grass {
  Gen: {source: grass_height, output: GenAlbedo,
               colors: [{0, {34, 62, 22}}, {0.5, {70, 128, 40}}, {1, {150, 200, 80}}]}
}

grass_n {
  Gen: {source: grass_height, output: GenNormal, strength: 2}
}

cobble_layer {
  PbrTextures: {albedo: cobble, normal: cobble_n}
  TextureTransform: {scale_x: 2, scale_y: 2}
}

grass_layer {
  PbrTextures: {albedo: grass, normal: grass_n}
  TextureTransform: {scale_x: 3, scale_y: 3}
}

linear {
  Position: {-1.55, 0, 0}
  Quad: {3, 3}
  Rgb: {255, 255, 255}
  PbrMaterial: {roughness: 0.8}
  TextureBlend: {
    mask: mask
    layers: [cobble_layer, cobble_layer, grass_layer, grass_layer]
    heights: [cobble_height, cobble_height, grass_height, grass_height]
  }
}

sharp {
  Position: {1.55, 0, 0}
  Quad: {3, 3}
  Rgb: {255, 255, 255}
  PbrMaterial: {roughness: 0.8}
  TextureBlend: {
    mask: mask
    layers: [cobble_layer, cobble_layer, grass_layer, grass_layer]
    heights: [cobble_height, cobble_height, grass_height, grass_height]
    contrast: 24
  }
}

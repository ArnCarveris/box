using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light

// Bevel on the round shapes, a prism and an extrusion, each in front of its unbeveled twin.
// The sun comes in low from the side so that the rounded rims catch a highlight.

camera {
  Position: {0, 3.4, 8.2}
  Rotation: {-0.36, 0, 0}
  Camera: {fov: 50}
}

main_view {
  View: {
    camera: camera,
    clear: {enabled: true, color: {38, 44, 56, 255}},
    shadows: {enabled: true}
  }
}

sun {
  Rotation: {0.35, 1.75, 0}
  DirectionalLight: {intensity: 2 * flecs.script.math.PI}
}

$ {
  AmbientLight: {sky: {150, 175, 210}, ground: {65, 60, 55}, intensity: 0.6}
}

floor {
  Position: {0, -0.1, 0}
  Box: {14, 0.2, 6}
  Rgb: {150, 150, 160}
}

// A drum, smooth, beveled in front and plain behind
drum {
  Position: {-5, 0.5, 0.9}
  Cylinder: {segments: 32, smooth: true, length: 1, radius: 0.55}
  Bevel: {radius: 0.12}
  Rgb: {200, 150, 100}
}

drum_plain {
  Position: {-5, 0.5, -0.9}
  Cylinder: {segments: 32, smooth: true, length: 1, radius: 0.55}
  Rgb: {200, 150, 100}
}

// An 8 sided drum with flat facets: an octagonal prism with rounded rims
octagon {
  Position: {-3.5, 0.45, 0.9}
  Cylinder: {segments: 8, smooth: false, length: 0.9, radius: 0.5}
  Bevel: {top: 0.15, bottom: 0.05}
  Rgb: {90, 200, 110}
}

octagon_plain {
  Position: {-3.5, 0.45, -0.9}
  Cylinder: {segments: 8, smooth: false, length: 0.9, radius: 0.5}
  Rgb: {90, 200, 110}
}

// A parapet ring with both rims rounded, and a partial ring with its rounded ends
parapet {
  Position: {-1.8, 0.35, 0.9}
  Tube: {segments: 40, smooth: true, length: 0.7, radius: 0.65, thickness: 0.25}
  Bevel: {top: 0.1, bottom: 0.06}
  Rgb: {80, 160, 240}
}

parapet_plain {
  Position: {-1.8, 0.35, -0.9}
  Tube: {segments: 40, smooth: true, length: 0.7, radius: 0.65, thickness: 0.25}
  Rgb: {80, 160, 240}
}

arch {
  Position: {-0.2, 0.35, 0.9}
  Rotation: {0, 0.6, 0}
  Tube: {segments: 24, smooth: true, length: 0.7, radius: 0.6, thickness: 0.3, arc: 3.6}
  Bevel: {radius: 0.08}
  Rgb: {250, 120, 160}
}

arch_plain {
  Position: {-0.2, 0.35, -0.9}
  Rotation: {0, 0.6, 0}
  Tube: {segments: 24, smooth: true, length: 0.7, radius: 0.6, thickness: 0.3, arc: 3.6}
  Rgb: {250, 120, 160}
}

// A frustum skirt and a cone, whose apex stays sharp
skirt {
  Position: {1.3, 0.45, 0.9}
  Frustum: {segments: 32, smooth: true, length: 0.9, radius_bottom: 0.55, radius_top: 0.3}
  Bevel: {top: 0.1, bottom: 0.08}
  Rgb: {230, 200, 90}
}

skirt_plain {
  Position: {1.3, 0.45, -0.9}
  Frustum: {segments: 32, smooth: true, length: 0.9, radius_bottom: 0.55, radius_top: 0.3}
  Rgb: {230, 200, 90}
}

cone {
  Position: {2.6, 0.6, 0.9}
  Cone: {segments: 32, smooth: true, length: 1.2, radius: 0.5}
  Bevel: {bottom: 0.1}
  Rgb: {170, 110, 230}
}

cone_plain {
  Position: {2.6, 0.6, -0.9}
  Cone: {segments: 32, smooth: true, length: 1.2, radius: 0.5}
  Rgb: {170, 110, 230}
}

// A prism roof with all nine edges rounded
roof {
  Position: {3.9, 0.4, 0.9}
  Rotation: {0, 0.5, 0}
  TrianglePrism: {1, 0.8, 0.9}
  Bevel: {radius: 0.08}
  Rgb: {210, 90, 70}
}

roof_plain {
  Position: {3.9, 0.4, -0.9}
  Rotation: {0, 0.5, 0}
  TrianglePrism: {1, 0.8, 0.9}
  Rgb: {210, 90, 70}
}

// A tabletop with a hole, its top rim rounded and its bottom rim sharp
table_outline {
  Path2D: {
    start: {-0.55, -0.4},
    segments: [
      {kind: Line, end: {0.55, -0.4}},
      {kind: Line, end: {0.55, 0.4}},
      {kind: Line, end: {-0.55, 0.4}}
    ],
    closed: true
  }
}

table_opening {
  Path2D: {
    start: {0.2, 0},
    segments: [
      {kind: CubicBezier, end: {0, 0.2}, control1: {0.2, 0.11}, control2: {0.11, 0.2}},
      {kind: CubicBezier, end: {-0.2, 0}, control1: {-0.11, 0.2}, control2: {-0.2, 0.11}},
      {kind: CubicBezier, end: {0, -0.2}, control1: {-0.2, -0.11}, control2: {-0.11, -0.2}},
      {kind: CubicBezier, end: {0.2, 0}, control1: {0.11, -0.2}, control2: {0.2, -0.11}}
    ],
    closed: true
  }
}

table_profile {
  Profile2D: {outer: table_outline, holes: [table_opening]}
}

tabletop {
  Position: {5.3, 0.15, 0.9}
  Rotation: {0, 0.4, 0}
  ProfileExtrusion: {profile: table_profile, depth: 0.3, cap_start: true, cap_end: true}
  Bevel: {top: 0.08}
  Rgb: {180, 140, 90}
}

tabletop_plain {
  Position: {5.3, 0.15, -0.9}
  Rotation: {0, 0.4, 0}
  ProfileExtrusion: {profile: table_profile, depth: 0.3, cap_start: true, cap_end: true}
  Rgb: {180, 140, 90}
}

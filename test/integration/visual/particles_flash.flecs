// An effect with an EffectFlash against a dark wall, three frames in: a burst of orange sparks
// on the left whose flash lights a warm pool on the wall and the floor around it, and the same
// burst on the right with a flash that already faded, its sparks over an unlit wall.
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.particle

camera {
  Position: {0, 1.5, 7}
  Rotation: {-0.1, 0, 0}
  Camera: {fov: 50}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {4, 4, 6, 255}}}
}

$ {
  AmbientLight: {intensity: 0.02}
}

floor {
  Position: {0, -0.1, 0}
  Box: {16, 0.2, 8}
  Rgb: {90, 90, 90}
  PbrMaterial: {roughness: 1}
}

wall {
  Position: {0, 2.5, -1.5}
  Box: {16, 5, 0.2}
  Rgb: {90, 90, 90}
  PbrMaterial: {roughness: 1}
}

prefab Blast {
  sparks {
    Position: {0, 0, 0}
    ParticleEmitter: {
      max: 200, rate: 0, shape: EmitterSphere, radius: 0.1, spread: 180,
      speed: {2, 4}, lifetime: {1, 1}, size: {0.05, 0.1}, opacity: {1, 1},
      color: {255, 170, 60}, seed: 4
    }
    ParticleAppearance: {blend: ParticleAdditive}
    ParticleBurst: {count: 150}
  }

  light {
    Position: {0, 0, 0.3}
    PointLight: {intensity: flecs.script.math.PI, range: 5}
    Rgb: {255, 160, 70}
    EffectFlash: {intensity: 6 * flecs.script.math.PI, seconds: 0.5}
  }
}

prefab Faded : Blast {
  light {
    EffectFlash: {intensity: 6 * flecs.script.math.PI, seconds: 0.01}
  }
}

const lit: entity = box.particle.burst_at(Blast, {-2.5, 1, 0}, 1)
const faded: entity = box.particle.burst_at(Faded, {2.5, 1, 0}, 1)

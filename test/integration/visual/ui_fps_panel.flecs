// The fps panel at the top right over the default scene, with a fixed window of frame samples
// that the engine does not add to (hold): mostly a steady 60 fps with vsync jitter (green), some
// frames under 60 fps (yellow), some under 30 fps (red) and one long hitch clamped at the top of
// the chart. The newest sample is on the right, the text line shows the mean and the last frame.

using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.app
using box.fps

camera {
  Position: {0, 2.5, 6}
  Rotation: {-0.35, 0, 0}
  Camera: {fov: 60}
}

main_view {

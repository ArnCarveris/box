using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.effects

ssao {
  Ssao: {radius: 0.8, intensity: 2}
}

camera {
  Position: {0, 3.2, 7}
  Rotation: {-0.35, 0, 0}
  Camera: {fov: 50}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {150, 170, 200, 255}}, effects: [{effect: ssao}]}
}

floor {
  Position: {0, -0.1, 0}
  Box: {14, 0.2, 10}
  Rgb: {210, 210, 205}
}

wall {
  Position: {0, 1.5, -2}
  Box: {14, 3, 0.2}
  Rgb: {210, 205, 200}
}

for i in 0..4 {
  {
    Position: {-3.5, 0.25 + i * 0.5, -1.4 + i * 0.6}
    Box: {1.6, 0.5, 0.6}
    Rgb: {200, 200, 200}
  }
}

pillar {
  Position: {-0.5, 1, -1.4}
  Box: {0.6, 2, 0.6}
  Rgb: {200, 200, 200}
}

ring {
  Position: {1.6, 0.18, 0.6}
  Torus: {segments: 32, rings: 16, smooth: true, radius: 0.6, tube: 0.18}
  Rgb: {200, 200, 200}
}

ball {
  Position: {3.4, 0.6, -0.6}
  Sphere: {segments: 32, smooth: true, radius: 0.6}
  Rgb: {200, 200, 200}
}

stack_a {
  Position: {0.8, 0.4, -1.5}
  Box: {0.8, 0.8, 0.8}
  Rgb: {200, 200, 200}
}

stack_b {
  Position: {0.9, 1.1, -1.5}
  Rotation: {0, 0.4, 0}
  Box: {0.6, 0.6, 0.6}
  Rgb: {200, 200, 200}
}

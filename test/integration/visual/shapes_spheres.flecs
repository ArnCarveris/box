// The round shapes of the town (etc/scenes/town_content.flecs) up close with the view of
// etc/scenes/town.flecs: a cherry tree crown, a planter with blossoms, a lantern whose outer ribs sit
// inside its 8 segment sphere, and a flat shaded 8 segment sphere.

using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects

$ {
  AmbientLight: {sky: {150, 178, 210}, ground: {60, 56, 50}, intensity: 0.25}
}

sun {
  Rotation: {0.9, -0.6, 0}
  DirectionalLight: {intensity: 1.1}
  Rgb: {255, 255, 255}
}

ssao {
  Ssao: {radius: 2.5, bias: 0.025, intensity: 1}
}

tonemap {
  Tonemap: {}
}

camera {
  Position: {0.6, 1.7, -3.2}
  Rotation: {0.3, 3.1416, 0}
  Camera: {fov: 55, near_: 0.1}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {150, 178, 210, 255}}, lighting: {enabled: true}, shadows: {enabled: true, cascades: 4, resolution: 2048, max_distance: 200, split_lambda: 0.7, depth_bias: 2, normal_offset: 1.5, filter_size: 3, fade: 0.2}, effects: [{enabled: true, effect: ssao}, {enabled: true, effect: tonemap}]}
}

floor {
  Position: {0, -0.05, 0}
  Box: {12, 0.1, 8}
  Rgb: {196, 190, 178}
}

tree {
  Position: {-1.3, 0, -0.6}
  {
    Position: {0, 0.95, 0}
    Cylinder: {radius: 0.12, length: 1.9, segments: 9}
    Rgb: {91, 65, 57}
  }
  for i in 0..5 {
    {
      Position: {math.cos(i * 1.26) * 0.48, 2.05 + (i % 2) * 0.3, math.sin(i * 1.26) * 0.48}
      Sphere: {radius: 0.66, segments: 8, smooth: true}
      Rgb: {243, 179 + i * 5, 196 + i * 4}
    }
  }
}

planter {
  Position: {0.9, 0, 0.6}
  {
    Position: {0, 0.16, 0}
    Cylinder: {radius: 0.21, length: 0.32, segments: 10}
    Rgb: {186, 116, 89}
  }
  {
    Position: {0, 0.31, 0}
    Torus: {radius: 0.2, tube: 0.035, segments: 12, rings: 6}
    Rgb: {214, 145, 112}
  }
  {
    Position: {0, 0.46, 0}
    Sphere: {radius: 0.28, segments: 8, smooth: true}
    Rgb: {112, 158, 109}
  }
  for i in 0..5 {
    {
      Position: {math.cos(i * 1.26) * 0.19, 0.64, math.sin(i * 1.26) * 0.19}
      Sphere: {radius: 0.07, segments: 8, smooth: true}
      Rgb: {242, 178, 191}
    }
  }
}

lantern {
  Position: {1.6, 1.1, -1.2}
  {
    Position: {0, 0.31, 0}
    Cylinder: {radius: 0.025, length: 0.26, segments: 8}
    Rgb: {62, 77, 80}
  }
  {
    Position: {}
    Sphere: {radius: 0.25, segments: 8, smooth: true}
    Rgb: {241, 116, 91}
    Emissive: {2, {241, 116, 91}}
  }
  for i in 0..3 {
    {
      Position: {0, (i - 1) * 0.12, 0}
      Torus: {radius: 0.22 - math.abs(i - 1) * 0.035, tube: 0.014, segments: 16, rings: 4}
      Rgb: {182, 67, 58}
    }
  }
  {
    Position: {0, -0.23, 0}
    Cylinder: {radius: 0.1, length: 0.07, segments: 12}
    Rgb: {91, 65, 57}
  }
}

flat {
  Position: {0.2, 0.5, -1.4}
  Sphere: {radius: 0.5, segments: 8, smooth: false}
  Rgb: {200, 200, 205}
}

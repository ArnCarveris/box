using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.layout
using box.text

camera {
  Position: {0, 0, 100}
  Camera: {ortho: true, ortho_scale: 1}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {236, 238, 242, 255}}}
}

template Chip {
  prop label: string = "Chip"
  prop size: f32 = 16

  Layout: {direction: Row, padding: {4, 4, 10, 10}, v: Middle}
  Rect: {1, 1}
  Rgb: {60, 90, 160}
  Border: {radius: 6}

  text {
    Position: {0, 0, 1}
    Text: {value: label, size: size}
    Rgb: {255, 255, 255}
  }
}

bar {
  Position: {0, 60, 0}
  Layout: {direction: Row, spacing: 8, padding: {8, 8, 8, 8}, v: Middle}
  Rect: {1, 1}
  Rgb: {40, 44, 56}
  Border: {width: 2, radius: 10, color: {120, 140, 200, 255}}

  a {
    Position: {0, 0, 1}
    Chip: {label: "Short", size: 14}
  }

  b {
    Position: {0, 0, 1}
    Chip: {label: "A longer label", size: 18}
  }

  c {
    Position: {0, 0, 1}
    Chip: {label: "Big", size: 32}
  }

  d {
    Position: {0, 0, 1}
    Circle: {10}
    Rgb: {250, 190, 60}
  }
}

column {
  Position: {0, -60, 0}
  Layout: {direction: Column, spacing: 4, padding: {8, 8, 8, 8}, h: Left}
  Rect: {1, 1}
  Rgb: {255, 255, 255}
  Border: {width: 1, radius: 6, color: {150, 150, 160, 255}}

  first {
    Position: {0, 0, 1}
    Text: {value: "Each line is a Text element", size: 16}
    Rgb: {30, 30, 40}
  }

  second {
    Position: {0, 0, 1}
    Text: {value: "sized by its TextBounds", size: 16}
    Rgb: {30, 30, 40}
  }

  third {
    Position: {0, 0, 1}
    Text: {value: "Two lines\nin one element", size: 12}
    Rgb: {200, 60, 60}
  }
}

// The curve table of the particles: jets whose curves the draw reads from baked rows. On the
// left a jet that shrinks and swells and cools over its life, in the middle one without
// ParticleCurves, white and the same size throughout, and on the right two jets with equal curves
// that share their rows, fading from magenta to cyan. At the start of the second frame SetAt
// changes the gradient of the left jet, which bakes new rows, and gives six emitters out of view
// gradients of their own, so the table outgrows its first 32 rows and is created again: the jets
// render from the new table.
using box.transform
using box.camera
using box.view
using box.app
using box.particle

camera {
  Position: {0, 2, 9}
  Rotation: {-0.12, 0, 0}
  Camera: {fov: 50}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {20, 22, 30, 255}}}
}

template Jet {
  prop seed = 1

  ParticleEmitter: {
    max: 600, rate: 12000, shape: EmitterDisc, radius: 0.15, spread: 6,
    speed: {70, 80}, lifetime: {0.045, 0.05}, size: {0.2, 0.25}, opacity: {1, 1},
    color: {255, 255, 255}, seed: seed
  }
  ParticleAppearance: {}
}

// Holds a pool and rows but no particle, out of view
template Filler {
  Position: {0, -1000, 0}
  ParticleEmitter: {max: 1, rate: 0}
}

jet {
  Position: {-2.5, -1, 0}
  Jet: {seed: 3}
  ParticleCurves: {
    size: {0.5, 1.6, 1.6, 0.4},
    color: {start: {255, 255, 255}, early: {255, 220, 60}, late: {255, 90, 20},
      end: {120, 20, 10}}
  }
}

plain {
  Position: {0, -1, 0}
  Jet: {seed: 5}
}

twin_a {
  Position: {2, -1, 0}
  Jet: {seed: 7}
  ParticleCurves: {
    opacity: {1, 1, 0.8, 0.2},
    color: {start: {255, 40, 220}, early: {200, 80, 255}, late: {80, 160, 255},
      end: {40, 255, 255}}
  }
}

twin_b {
  Position: {3, -1, 0}
  Jet: {seed: 9}
  ParticleCurves: {
    opacity: {1, 1, 0.8, 0.2},
    color: {start: {255, 40, 220}, early: {200, 80, 255}, late: {80, 160, 255},
      end: {40, 255, 255}}
  }
}

filler_1 { Filler: {} }
filler_2 { Filler: {} }
filler_3 { Filler: {} }
filler_4 { Filler: {} }
filler_5 { Filler: {} }
filler_6 { Filler: {} }

change_jet {
  SetAt: {frame: 1, entity: jet}
  ParticleCurves: {
    size: {0.5, 1.6, 1.6, 0.4},
    color: {start: {200, 255, 200}, early: {60, 255, 80}, late: {20, 160, 255},
      end: {10, 30, 160}}
  }
}

change_1 {
  SetAt: {frame: 1, entity: filler_1}
  ParticleCurves: {color: {start: {255, 0, 0}, end: {0, 0, 0}}}
}

change_2 {
  SetAt: {frame: 1, entity: filler_2}
  ParticleCurves: {color: {start: {0, 255, 0}, end: {0, 0, 0}}}
}

change_3 {
  SetAt: {frame: 1, entity: filler_3}
  ParticleCurves: {color: {start: {0, 0, 255}, end: {0, 0, 0}}}
}

change_4 {
  SetAt: {frame: 1, entity: filler_4}
  ParticleCurves: {color: {start: {255, 255, 0}, end: {0, 0, 0}}}
}

change_5 {
  SetAt: {frame: 1, entity: filler_5}
  ParticleCurves: {color: {start: {0, 255, 255}, end: {0, 0, 0}}}
}

change_6 {
  SetAt: {frame: 1, entity: filler_6}
  ParticleCurves: {color: {start: {255, 0, 255}, end: {0, 0, 0}}}
}

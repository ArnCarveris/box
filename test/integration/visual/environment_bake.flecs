using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light

$ {
  Scene: {baked: true, environment: true}
}

// A baked room on the left next to an exterior on the right, both under the environment
// sky.hdr, which the first view draws as the background. The room is a `Scene` with
// `LightBake`, open toward the camera and lit only by a warm point light inside; the exterior is
// a `Scene` without one, lit only by the environment. The irradiance grid wins in the room: its
// floor, walls and white box are lit warm by the lamp and its bounce, and the outer faces of its
// walls are black, not blue from the sky, because the captures see the black hemisphere ambient
// of the room where nothing covers them. The mirror ball in the room reflects the sky through
// the opening, scaled by the grid. Outside, a mirror ball and a white ball on a grey slab are lit
// by the sky: blue from above, the mirror ball showing the sky, the bright horizon band and the
// brown ground.
room {
  Scene: {baked: true, environment: true}
  LightBake: {probe_spacing: 0.5, bounces: 1, bounds_padding: 0.5}
  AmbientLight: {sky: {0, 0, 0}, ground: {0, 0, 0}, intensity: 0}

  darkness {
    DirectionalLight: {intensity: 0}
  }

  camera {
    Position: {0, 1.8, 7}
    Rotation: {-0.15, 0, 0}
    Camera: {fov: 55}
  }

  lamp {
    Position: {-2.6, 2.1, -0.6}
    Rgb: {255, 210, 160}
    PointLight: {intensity: 3 * flecs.script.math.PI, range: 6}
  }

  floor {
    Position: {-2.6, -0.1, 0}
    Box: {3.4, 0.2, 3.4}
    Rgb: {200, 200, 200}
  }

  ceiling {
    Position: {-2.6, 2.7, 0}
    Box: {3.4, 0.2, 3.4}
    Rgb: {200, 200, 200}
  }

  back_wall {
    Position: {-2.6, 1.3, -1.6}
    Box: {3.4, 2.6, 0.2}
    Rgb: {200, 200, 200}
  }

  left_wall {
    Position: {-4.2, 1.3, 0}
    Box: {0.2, 2.6, 3.4}
    Rgb: {200, 200, 200}
  }

  right_wall {
    Position: {-1, 1.3, 0}
    Box: {0.2, 2.6, 3.4}
    Rgb: {200, 200, 200}
  }

  white_box {
    Position: {-3.3, 0.4, -0.6}
    Box: {0.8, 0.8, 0.8}
    Rgb: {230, 230, 230}
  }

  mirror {
    Position: {-2.1, 0.5, 0.4}
    Sphere: {segments: 48, smooth: true, radius: 0.5}
    Rgb: {240, 240, 245}
    PbrMaterial: {metallic: 1, roughness: 0.05}
  }
}

outside {
  Scene: {baked: true, environment: true}
  AmbientLight: {sky: {0, 0, 0}, ground: {0, 0, 0}, intensity: 0}

  sky {
    Environment: {resolution: 128}
    EnvironmentImage: {path: "test/assets/environments/sky.hdr"}
  }

  darkness {
    DirectionalLight: {intensity: 0}
  }

  camera {
    Position: {0, 1.8, 7}
    Rotation: {-0.15, 0, 0}
    Camera: {fov: 55}
  }

  slab {
    Position: {2.6, -0.1, 0}
    Box: {3.4, 0.2, 3.4}
    Rgb: {160, 160, 160}
  }

  mirror {
    Position: {2, 0.7, 0}
    Sphere: {segments: 48, smooth: true, radius: 0.7}
    Rgb: {240, 240, 245}
    PbrMaterial: {metallic: 1, roughness: 0.05}
  }

  white_ball {
    Position: {3.4, 0.5, 0.6}
    Sphere: {segments: 48, smooth: true, radius: 0.5}
    Rgb: {230, 230, 230}
    PbrMaterial: {metallic: 0, roughness: 0.5}
  }
}

room_view {
  View: {
    camera: room.camera,
    clear: {enabled: true, color: {0, 0, 0, 255}},
    lighting: {enabled: true, baked: true, reflections: true, atmosphere: true,
      environment: {source: outside.sky, intensity: 1, yaw: 0, background: true}}
  }
}

outside_view {
  View: {
    camera: outside.camera,
    lighting: {enabled: true, baked: true, reflections: true, atmosphere: true,
      environment: {source: outside.sky, intensity: 1, yaw: 0, background: false}}
  }
}

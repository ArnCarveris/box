// The in game console with lines longer than its panel, open over a plain scene: a long
// command wraps between words with its syntax colors (value, numbers, extra arguments) on every
// row and its continuation rows after the prompt, its long error and a long help line wrap
// between words, and an entity path longer than a row breaks inside the word.
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.console

camera {
  Position: {0, 2.5, 6}
  Rotation: {-0.35, 0, 0}
  Camera: {fov: 60}
}

main_view {
  View: {
    camera: camera,
    clear: {enabled: true, color: {120, 150, 190, 255}}
  }
}

sun {
  Rotation: {0.7359, 2.3726, 0}
  DirectionalLight: {intensity: 2 * flecs.script.math.PI}
  Rgb: {255, 244, 225}
}

cube {
  Position: {0, 0.5, 0}
  Rotation: {0, 0.4, 0}
  Box: {1, 1, 1}
  Rgb: {220, 90, 60}
  PbrMaterial: {roughness: 0.4, metallic: 0}
}

paths {
  an_entity_name_much_longer_than_one_row_of_the_console_that_breaks_inside_the_word {}
}

const long_command: string = box.console.run("set cube box.transform.Position \{x: 0, y: 0.5, z: 0} with extra arguments that wrap")
const long_output: string = box.console.run("help cls")
const long_word: string = box.console.run("ls paths")

$ {
  Console: {open: true}
}

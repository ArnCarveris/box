using box.transform
using box.geometry
using box.material
using box.camera
using box.light

camera {
  Position: {0, 8, -20}
  LookAt: {0, 2, 0}
  Camera: {fov: 50}
}

sun {
  Rotation: {0.9, -0.6, 0}
  DirectionalLight: {intensity: 1.6}
}

$ { EnvironmentLight: {sky_color: {120, 135, 165}, ground_color: {60, 58, 55}, intensity: 0.6} }

ground {
  Position: {0, -0.25, 0}
  Box: {60, 0.5, 60}
  Rgb: {120, 120, 125}
  PbrMaterial: {roughness: 0.9}
}

reference {
  Position: {-7.5, 1, -4.5}
  Box: {1.5, 1.5, 1.5}
  Rgb: {215, 215, 215}
}

single_red {
  Position: {-2.5, 1, -4.5}
  Box: {1.5, 1.5, 1.5}
  Rgb: {215, 215, 215}
  Tint: {255, 0, 0, 128}
}

single_green {
  Position: {2.5, 1, -4.5}
  Box: {1.5, 1.5, 1.5}
  Rgb: {215, 215, 215}
  Tint: {0, 255, 0, 128}
}

single_blue {
  Position: {7.5, 1, -4.5}
  Box: {1.5, 1.5, 1.5}
  Rgb: {215, 215, 215}
  Tint: {0, 0, 255, 128}
}

childof_tree {
  Position: {-7.5, 1, 2}
  Box: {1.5, 1.5, 1.5}
  Rgb: {215, 215, 215}
  Tint: {0, 0, 255, 128}

  child {
    Position: {0, 2, 0}
    Sphere: {segments: 24, smooth: true, radius: 0.7}
    Rgb: {215, 215, 215}
    Tint: {0, 0, 0, 128}

    grandchild {
      Position: {0, 1.5, 0}
      Box: {1, 1, 1}
      Rgb: {215, 215, 215}
    }
  }
}

@tree Parent

parent_tree {
  Position: {-2.5, 1, 2}
  Box: {1.5, 1.5, 1.5}
  Rgb: {215, 215, 215}
  Tint: {0, 0, 255, 128}

  child {
    Position: {0, 2, 0}
    Sphere: {segments: 24, smooth: true, radius: 0.7}
    Rgb: {215, 215, 215}
    Tint: {0, 0, 0, 128}

    grandchild {
      Position: {0, 1.5, 0}
      Box: {1, 1, 1}
      Rgb: {215, 215, 215}
    }
  }
}

childof_under_parent {
  Position: {2.5, 1, 2}
  Box: {1.5, 1.5, 1.5}
  Rgb: {215, 215, 215}
  Tint: {0, 0, 255, 128}

  child {
    Position: {0, 2, 0}
    Sphere: {segments: 24, smooth: true, radius: 0.7}
    Rgb: {215, 215, 215}
    Tint: {0, 0, 0, 128}

    @tree ChildOf

    grandchild {
      Position: {0, 1.5, 0}
      Box: {1, 1, 1}
      Rgb: {215, 215, 215}
    }
  }
}

@tree ChildOf

parent_under_childof {
  Position: {7.5, 1, 2}
  Box: {1.5, 1.5, 1.5}
  Rgb: {215, 215, 215}
  Tint: {0, 0, 255, 128}

  child {
    Position: {0, 2, 0}
    Sphere: {segments: 24, smooth: true, radius: 0.7}
    Rgb: {215, 215, 215}
    Tint: {0, 0, 0, 128}

    @tree Parent

    grandchild {
      Position: {0, 1.5, 0}
      Box: {1, 1, 1}
      Rgb: {215, 215, 215}
    }
  }
}

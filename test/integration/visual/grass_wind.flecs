using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.atmosphere
using box.grass

// A meadow of Grass 1 s into a strong gusty Wind toward +x, seen across the wind: the gusts lean
// the blades over in bands that roll along the wind, the blades in a gust show their lighter
// faces, and a row of red poles with WindSway leans with the grass at their feet.
//
// frames: 60
$ {
  Scene: {wind: true}
  Wind: {direction: {1, 0}, speed: 9, gust: 0.6, gust_scale: 6}
}

camera {
  Position: {0, 2.2, 6}
  Rotation: {-0.22, 0, 0}
  Camera: {fov: 60, near_: 0.05, far_: 2000}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {120, 160, 210, 255}},
    shadows: {enabled: true}}
}

sun {
  Rotation: {0.7, 2.6, 0}
  DirectionalLight: {intensity: 3 * flecs.script.math.PI}
  Rgb: {255, 245, 225}
}

sky {
  AmbientLight: {intensity: 0.5}
}

ground {
  Position: {0, -0.05, 0}
  Box: {2000, 0.1, 2000}
  Rgb: {70, 55, 35}
}

meadow {
  Grass: {density: 64, min_height: 0.3, max_height: 0.7, lod: [20, 60, 200],
    clump_size: 1.2, clump_follow: 0.8, variation: 0.8}
}

prefab Pole {
  Box: {0.08, 2, 0.08}
  Rgb: {200, 70, 50}
  WindSway: {bend: 0.05, height: 2, base: 0}
}

pole_1 : Pole {
  Position: {-6, 1, -3}
}
pole_2 : Pole {
  Position: {-3, 1, -3}
}
pole_3 : Pole {
  Position: {0, 1, -3}
}
pole_4 : Pole {
  Position: {3, 1, -3}
}
pole_5 : Pole {
  Position: {6, 1, -3}
}

using box.transform
using box.geometry
using box.material
using box.texture
using box.camera
using box.view
using box.light

$ {
  Scene: {water: true, texture_scroll: true}
}

// A pond (Water) in a sandy terrain bowl turned on a Lathe, seen from above at an angle and lit
// by a low sun from the left. The water is shallow and teal toward the sloping shore and dark
// blue in the middle, where the bowl is 2.4 deep; near the shore the sand shows through. A white
// foam ring broken up by a generated noise texture runs where the bowl meets the water, and
// around the three rocks that break the surface. The waves are a generated normal map scrolled by
// TextureScroll, with a second finer ripple sample moving the other way, and the sun leaves a
// glint on them.
// frames: 60
water {
  Scene: {water: true, texture_scroll: true}
  AmbientLight: {sky: {150, 175, 210}, ground: {70, 64, 52}, intensity: 0.7}

  sun {
    Rotation: {-0.55, -1.1, 0}
    DirectionalLight: {intensity: 3}
    Rgb: {255, 244, 226}
  }

  camera {
    Position: {0, 7.5, 11}
    Rotation: {-0.58, 0, 0}
    Camera: {fov: 50}
  }

  main_view {
    View: {camera: camera, clear: {enabled: true, color: {120, 150, 190, 255}}}
  }

  waves_height {
    Gen: {
      width: 256, height: 256, seed: 7
      layers: [
        {kind: GenNoise, frequency: 4, octaves: 4, amount: 1}
      ]
    }
  }

  waves {
    Gen: {source: waves_height, output: GenNormal, strength: 2}
  }

  foam_noise {
    Gen: {
      width: 256, height: 256, seed: 3
      layers: [
        {kind: GenNoise, frequency: 8, octaves: 3, amount: 1}
      ]
    }
  }

  bowl_profile {
    Path2D: {
      start: {0, -2.4},
      segments: [
        {kind: CubicBezier, end: {7.5, 0.9}, control1: {3.5, -2.4}, control2: {5.8, -0.4}}
      ],
      closed: false
    }
  }

  bowl {
    Position: {0, 0, 0}
    Lathe: {profile: bowl_profile, segments: 96, rings: 32}
    BackFaceMode: BackFacePlain
    Rgb: {196, 176, 136}
    PbrMaterial: {roughness: 0.95}
  }

  rock_1 {
    Position: {1.8, -0.2, 0.8}
    Rotation: {0.3, 0.7, 0.1}
    Scale: {1.2, 0.8, 1}
    IcoSphere: {segments: 1, radius: 0.7}
    Rgb: {110, 106, 100}
    PbrMaterial: {roughness: 0.9}
  }

  rock_2 {
    Position: {-2.4, -0.5, -1.2}
    Rotation: {0.1, 1.9, 0.2}
    Scale: {1, 1.1, 1.3}
    IcoSphere: {segments: 1, radius: 0.9}
    Rgb: {96, 94, 90}
    PbrMaterial: {roughness: 0.9}
  }

  rock_3 {
    Position: {-0.6, -0.1, 2.6}
    Rotation: {0.5, 0.2, 0}
    IcoSphere: {segments: 1, radius: 0.4}
    Rgb: {120, 114, 104}
    PbrMaterial: {roughness: 0.9}
  }

  pond {
    Position: {0, 0, 0}
    Rotation: {-1.5708, 0, 0}
    NGon: {sides: 64, radius: 7.2}
    Rgb: {255, 255, 255}
    PbrMaterial: {metallic: 0, roughness: 0.08}
    PbrTextures: {normal: waves}
    TextureTransform: {scale_x: 3, scale_y: 3, offset_x: 0, offset_y: 0}
    TextureScroll: {velocity: {0.01, 0.004}, normal_velocity: {0.02, 0.01}}
    Water: {
      shallow_color: {60, 170, 160}
      deep_color: {8, 40, 64}
      depth: 2
      visibility: 1.5
      refraction: 0.02
      foam_color: {240, 245, 245}
      foam_width: 0.25
      foam_texture: foam_noise
      foam_scale: 2
      ripple_scale: 2.7
      ripple_velocity: {-0.03, 0.02}
    }
  }
}

using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.spline
using box.particle

camera {
  Position: {0, 2.6, -11}
  LookAt: {0, 1.5, 0}
  Camera: {fov: 55}
}

sun {
  Rotation: {0.9, -0.6, 0}
  DirectionalLight: {intensity: 1.5}
}

$ { EnvironmentLight: {sky_color: {120, 135, 165}, ground_color: {60, 58, 55}, intensity: 0.6} }

ground {
  Position: {0, -0.25, 0}
  Box: {44, 0.5, 44}
  Rgb: {105, 108, 112}
  PbrMaterial: {roughness: 0.9}
}

point_stream {
  Position: {-7.5, 0.3, 0}
  ParticleEmitter: {
    max: 6000, rate: 24000, shape: EmitterPoint,
    direction: {0, 1, 0}, spread: 10,
    speed: {min: 4, max: 26},
    lifetime: {min: 1, max: 2},
    size: {min: 0.1, max: 0.18},
    opacity: {min: 0.7, max: 1},
    color: {250, 180, 70},
    seed: 11
  }
}

sphere_stream {
  Position: {-4.5, 1.4, 0}
  ParticleEmitter: {
    max: 6000, rate: 24000, shape: EmitterSphere, radius: 0.7,
    direction: {0, 0, 0}, spread: 6,
    speed: {min: 3, max: 14},
    lifetime: {min: 1, max: 2},
    size: {min: 0.1, max: 0.18},
    opacity: {min: 0.7, max: 1},
    color: {235, 80, 70},
    seed: 12
  }
}

box_stream {
  Position: {-1.5, 0.3, 0}
  ParticleEmitter: {
    max: 6000, rate: 24000, shape: EmitterBox, extents: {0.9, 0.1, 0.9},
    direction: {0, 1, 0}, spread: 4,
    speed: {min: 4, max: 24},
    lifetime: {min: 1, max: 2},
    size: {min: 0.1, max: 0.18},
    opacity: {min: 0.7, max: 1},
    color: {110, 220, 120},
    seed: 13
  }
}

disc_stream {
  Position: {1.5, 0.3, 0}
  ParticleEmitter: {
    max: 6000, rate: 24000, shape: EmitterDisc, radius: 1,
    direction: {0, 0, 0}, spread: 8,
    speed: {min: 3, max: 16},
    lifetime: {min: 1, max: 2},
    size: {min: 0.1, max: 0.18},
    opacity: {min: 0.7, max: 1},
    color: {90, 170, 245},
    seed: 14
  }
}

fan {
  Position: {4.5, 0.3, 0}
  Mesh3: {
    vertices: [
      {-1, 0, -0.6}, {0, 1.6, 0}, {1, 0, -0.6},
      {1, 0, -0.6}, {0, 1.6, 0}, {1, 0, 0.6},
      {1, 0, 0.6}, {0, 1.6, 0}, {-1, 0, 0.6},
      {-1, 0, 0.6}, {0, 1.6, 0}, {-1, 0, -0.6}
    ]
  }
  Rgb: {80, 78, 90}
  PbrMaterial: {roughness: 0.6}
  ParticleEmitter: {
    max: 6000, rate: 24000, shape: EmitterMesh, source: fan,
    direction: {0, 0, 0}, spread: 10,
    speed: {min: 3, max: 13},
    lifetime: {min: 1, max: 2},
    size: {min: 0.1, max: 0.18},
    opacity: {min: 0.7, max: 1},
    color: {200, 130, 245},
    seed: 15
  }
}

wire {
  Spline: {
    points: [
      {-1.2, 0.2, -0.8}, {-0.4, 1.4, 0.6}, {0.4, 0.4, -0.6}, {1.2, 1.6, 0.8}
    ]
  }
}

spline_stream {
  Position: {7.5, 0.3, 0}
  ParticleEmitter: {
    max: 6000, rate: 24000, shape: EmitterSpline, source: wire,

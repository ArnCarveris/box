using box.transform
using box.geometry
using box.material
using box.texture
using box.camera
using box.view
using box.light

// Texture graphs evaluated on the GPU and sampled by materials, lit by a sun and an ambient
// light. On the left the plating example: the coordinates halved and tinted, red growing to the
// right and green growing down from a dark brown at the top left. In the middle a per channel mix
// of a red and a blue constant by the coordinates (u, v, 0, 1), clamped and stored as computed
// (GraphLinear), which the albedo layer reads as display encoded: red flat over the left half and
// falling to near black at the right. On the right a sphere whose albedo is the sphere domain
// direction mapped from -1..1 to 0..1, laid out as the environment images are (-z at u 0.5):
// on the Sphere mesh the side facing the camera is teal and the left side yellow. Below, a panel
// whose emission is an HDR graph of green 4 v, black at its top and brightest at its bottom.
// frames: 30

graphs {
  AmbientLight: {sky: {120, 140, 170}, ground: {40, 40, 40}, intensity: 0.8}

  sun {
    Rotation: {-0.6, 0.8, 0}
    DirectionalLight: {intensity: 3}
  }

  camera {
    Position: {0, 0, 8}
    Camera: {fov: 50}
  }

  main_view {
    View: {camera: camera, clear: {enabled: true, color: {30, 34, 44, 255}}}
  }

  plating {
    uv     { nodes.Coords: {} }
    bright { nodes.Math: {op: MathMultiply, a: uv, b_value: {0.5, 0.5, 0.5, 1}} }
    tinted { nodes.Math: {op: MathAdd, a: bright, b_value: {0.2, 0.1, 0.05, 0}} }
    Graph: {output: tinted, width: 256}
  }

  bands {
    uv    { nodes.Coords: {} }
    red   { nodes.Constant: {value: {0.9, 0.1, 0.1, 1}} }
    blue  { nodes.Constant: {value: {0.1, 0.2, 0.9, 1}} }
    mixed { nodes.Math: {op: MathMix, a: red, b: blue, c: uv} }
    edge  { nodes.Math: {op: MathClamp, a: mixed, b_value: {0, 0, 0, 1}, c_value: {0.5, 1, 1, 1}} }
    Graph: {output: edge, width: 128, format: GraphLinear}
  }

  globe {
    dir    { nodes.Coords: {} }
    half   { nodes.Math: {op: MathMultiply, a: dir, b_value: {0.5, 0.5, 0.5, 1}} }
    shift  { nodes.Math: {op: MathAdd, a: half, b_value: {0.5, 0.5, 0.5, 0}} }
    Graph: {output: shift, width: 256, height: 128, domain: DomainSphere}
  }

  glow {
    uv     { nodes.Coords: {} }
    bright { nodes.Math: {op: MathMultiply, a: uv, b_value: {0, 4, 2, 1}} }
    Graph: {output: bright, width: 64, format: GraphHdr}
  }

  plating_quad {
    Position: {-3, 0.8, 0}
    Quad: {2.4, 2.4}
    Rgb: {255, 255, 255}
    PbrMaterial: {roughness: 0.8}
    PbrTextures: {albedo: plating}
  }

  bands_quad {
    Position: {0, 0.8, 0}
    Quad: {2.4, 2.4}
    Rgb: {255, 255, 255}
    PbrMaterial: {roughness: 0.8}
    PbrTextures: {albedo: bands}
  }

  globe_sphere {
    Position: {3, 0.8, 0}
    Sphere: {segments: 48, smooth: true, radius: 1.2}
    Rgb: {255, 255, 255}
    PbrMaterial: {roughness: 0.6}
    PbrTextures: {albedo: globe}
  }

  glow_panel {
    Position: {0, -2, 0}
    Quad: {6, 1.2}
    Rgb: {0, 0, 0}
    PbrMaterial: {metallic: 1, roughness: 1}
    Emissive: {strength: 1, color: {255, 255, 255}}
    PbrTextures: {emissive: glow}
  }
}

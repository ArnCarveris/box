using box.transform
using box.geometry
using box.material
using box.texture
using box.camera
using box.view
using box.light

$ {
  Scene: {water: true, planar_reflections: true, texture_scroll: true}
}

// The pond of materials_water (Water) with a PlanarReflection, in a sandy terrain bowl turned on
// a Lathe, seen from above at an angle and lit by a low sun from the left. On the far shore a red
// hut, a tree, a white post and a yellow ball stand on the sand; the water mirrors them sharply,
// the mirror images rippled by the scrolled normal map, while the sky color of the clear and the
// near shore still come from the ambient, which the reflection fades to where it shows nothing.
// The water is shallow and teal toward the shore and dark blue in the middle, with a foam ring
// where the bowl meets the water and around the rocks.
// frames: 60
water {
  Scene: {water: true, planar_reflections: true, texture_scroll: true}
  AmbientLight: {sky: {150, 175, 210}, ground: {70, 64, 52}, intensity: 0.7}

  sun {
    Rotation: {-0.55, -1.1, 0}
    DirectionalLight: {intensity: 3}
    Rgb: {255, 244, 226}
  }

  camera {
    Position: {0, 7.5, 11}
    Rotation: {-0.58, 0, 0}
    Camera: {fov: 50}
  }

  main_view {
    View: {camera: camera, clear: {enabled: true, color: {120, 150, 190, 255}}}
  }

  waves_height {
    Gen: {
      width: 256, height: 256, seed: 7
      layers: [
        {kind: GenNoise, frequency: 4, octaves: 4, amount: 1}
      ]
    }
  }

  waves {
    Gen: {source: waves_height, output: GenNormal, strength: 2}
  }

  foam_noise {
    Gen: {
      width: 256, height: 256, seed: 3
      layers: [
        {kind: GenNoise, frequency: 8, octaves: 3, amount: 1}
      ]
    }
  }

  bowl_profile {
    Path2D: {
      start: {0, -2.4},
      segments: [
        {kind: CubicBezier, end: {7.5, 0.9}, control1: {3.5, -2.4}, control2: {5.8, -0.4}}
      ],
      closed: false
    }
  }

  bowl {
    Position: {0, 0, 0}
    Lathe: {profile: bowl_profile, segments: 96, rings: 32}
    BackFaceMode: BackFacePlain
    Rgb: {196, 176, 136}
    PbrMaterial: {roughness: 0.95}
  }

  rock_1 {
    Position: {1.8, -0.2, 0.8}
    Rotation: {0.3, 0.7, 0.1}
    Scale: {1.2, 0.8, 1}
    IcoSphere: {segments: 1, radius: 0.7}
    Rgb: {110, 106, 100}
    PbrMaterial: {roughness: 0.9}
  }

  rock_2 {
    Position: {-2.4, -0.5, -1.2}
    Rotation: {0.1, 1.9, 0.2}
    Scale: {1, 1.1, 1.3}
    IcoSphere: {segments: 1, radius: 0.9}
    Rgb: {96, 94, 90}
    PbrMaterial: {roughness: 0.9}
  }

  rock_3 {
    Position: {-0.6, -0.1, 2.6}
    Rotation: {0.5, 0.2, 0}
    IcoSphere: {segments: 1, radius: 0.4}
    Rgb: {120, 114, 104}
    PbrMaterial: {roughness: 0.9}
  }

  hut {
    Position: {-1.6, 1.2, -6.2}
    Rotation: {0, 0.35, 0}
    Box: {1.6, 1.4, 1.2}
    Rgb: {190, 50, 40}
    PbrMaterial: {roughness: 0.7}
  }

  hut_roof {
    Position: {-1.6, 2.3, -6.2}
    Rotation: {0, 0.35, 0}
    Cone: {segments: 4, length: 0.8, radius: 1.3}
    Rgb: {70, 50, 40}
    PbrMaterial: {roughness: 0.8}
  }

  trunk {
    Position: {2.4, 1.2, -5.8}
    Cylinder: {segments: 16, smooth: true, length: 1.6, radius: 0.15}
    Rgb: {90, 60, 40}
    PbrMaterial: {roughness: 0.9}
  }

  crown {
    Position: {2.4, 2.8, -5.8}
    Cone: {segments: 16, smooth: true, length: 2.2, radius: 0.9}
    Rgb: {40, 120, 50}
    PbrMaterial: {roughness: 0.8}
  }

  post {
    Position: {0.6, 1.1, -6.6}
    Box: {0.2, 2.2, 0.2}
    Rgb: {240, 240, 240}
    PbrMaterial: {roughness: 0.5}
  }

  ball {
    Position: {4.4, 0.9, -4.4}
    Sphere: {segments: 32, smooth: true, radius: 0.6}
    Rgb: {240, 200, 40}
    PbrMaterial: {roughness: 0.4}
  }

  pond {
    Position: {0, 0, 0}
    Cylinder: {segments: 64, length: 0.02, radius: 7.2}
    Rgb: {255, 255, 255}
    PbrMaterial: {metallic: 0, roughness: 0.08}
    PbrTextures: {normal: waves}
    texture.Transform: {scale_x: 3, scale_y: 3, offset_x: 0, offset_y: 0}
    texture.Scroll: {velocity: {0.01, 0.004}, normal_velocity: {0.02, 0.01}}
    Water: {
      shallow_color: {60, 170, 160}
      deep_color: {8, 40, 64}
      depth: 2
      visibility: 1.5
      refraction: 0.02
      foam_color: {240, 245, 245}
      foam_width: 0.25
      foam_texture: foam_noise
      foam_scale: 2
      ripple_scale: 2.7
      ripple_velocity: {-0.03, 0.02}
    }
    PlanarReflection: {resolution: 0.5, distortion: 0.03}
  }
}

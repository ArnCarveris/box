using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.effects

camera {
  Position: {0, 4, -11}
  LookAt: {0, 1.2, 0}
  Camera: {fov: 55}
}

sun {
  Rotation: {0.9, -0.6, 0}
  DirectionalLight: {intensity: 1}
}

$ { EnvironmentLight: {sky_color: {110, 130, 165}, ground_color: {55, 52, 50}, intensity: 0.8} }

ground {
  Position: {0, -0.25, 0}
  Box: {40, 0.5, 40}
  Rgb: {120, 120, 125}
  PbrMaterial: {roughness: 0.9}
}

sphere {
  Position: {-3.2, 1.2, 0}
  Sphere: {segments: 32, smooth: true, radius: 1.2}
  Rgb: {220, 90, 70}
}

crate {
  Position: {0, 1.1, 0}
  Rotation: {0, 0.6, 0}
  Box: {2.2, 2.2, 2.2}
  Rgb: {80, 160, 240}
}

cylinder {
  Position: {3.2, 1.2, 0}
  Cylinder: {segments: 32, smooth: true, radius: 1, length: 2.4}
  Rgb: {90, 210, 130}
}

grade {
  Effect: {shader: box.effects.shaders.color_grade, order: 100, scale: 1, enabled: true, color: true}
  ColorGrade: {exposure: 0.7, saturation: 1.8}
}

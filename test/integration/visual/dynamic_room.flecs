using box.transform
using box.geometry
using box.material
using box.camera
using box.light

$ {
  BakeSettings: {enabled: true}
  EnvironmentLight: {sky_color: {40, 50, 70}, ground_color: {30, 26, 22}, intensity: 0.35}
}

camera {
  Position: {0, 7, -19}
  LookAt: {0, 2, 2}
  Camera: {fov: 55}
}

sun {
  Rotation: {0.9, -0.4, 0}
  DirectionalLight: {intensity: 0.15}
  Rgb: {190, 200, 230}
}

floor {
  for i in 0..100 {
    _ {
      Position: {(i % 10) * 2 - 9, -0.2, (i / 10) * 2 - 9}
      Box: {2, 0.4, 2}
      Rgb: {150, 146, 140}
      PbrMaterial: {roughness: 0.85}
    }
  }
}

back_wall {
  for i in 0..30 {
    _ {
      Position: {(i % 10) * 2 - 9, (i / 10) * 2 + 1, 10.2}
      Box: {2, 2, 0.4}
      Rgb: {130, 134, 145}
      PbrMaterial: {roughness: 0.9}
    }
  }
}

left_wall {
  for i in 0..30 {
    _ {
      Position: {-10.2, (i / 10) * 2 + 1, (i % 10) * 2 - 9}
      Box: {0.4, 2, 2}
      Rgb: {128, 120, 112}
      PbrMaterial: {roughness: 0.9}
    }
  }
}

right_wall {
  for i in 0..30 {
    _ {
      Position: {10.2, (i / 10) * 2 + 1, (i % 10) * 2 - 9}
      Box: {0.4, 2, 2}
      Rgb: {128, 120, 112}
      PbrMaterial: {roughness: 0.9}
    }
  }
}

pillar {
  for i in 0..3 {
    _ {
      Position: {0, i * 2 + 1, 5}
      Box: {1.4, 2, 1.4}
      Rgb: {110, 108, 104}
      PbrMaterial: {roughness: 0.8}
    }
  }
}

emissive {
  lamp_warm {
    Position: {-6, 1.2, -2}
    Box: {1.2, 1.2, 1.2}
    Rgb: {255, 180, 90}
    Emissive: {strength: 8, color: {255, 150, 60}}
  }

  lamp_cool {
    Position: {6, 1.2, -2}
    Box: {1.2, 1.2, 1.2}
    Rgb: {120, 180, 255}
    Emissive: {strength: 8, color: {80, 160, 255}}
  }

  lamp_green {
    Position: {-6, 1.2, 7}
    Box: {1.2, 1.2, 1.2}
    Rgb: {140, 255, 150}
    Emissive: {strength: 6, color: {70, 255, 110}}
  }
}

lights {
  a {
    DynamicTransform
    Position: {0, 4, -1}
    PointLight: {intensity: 50, range: 20}
    Rgb: {255, 240, 220}
  }

  b {
    DynamicTransform
    Position: {-7, 4.5, 2}
    PointLight: {intensity: 26, range: 14}
    Rgb: {255, 200, 170}
  }

  c {
    DynamicTransform
    Position: {7, 4.5, 2}
    PointLight: {intensity: 26, range: 14}
    Rgb: {190, 210, 255}
  }
}

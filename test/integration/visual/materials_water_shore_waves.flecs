using box.transform
using box.geometry
using box.material
using box.texture
using box.camera
using box.view
using box.light

$ {
  Scene: {water: true, texture_scroll: true}
}

// A sandy beach that slopes gently into the sea toward the back, seen from above at an angle and
// lit by an afternoon sun from the left. Water.shore_period makes waves lap at the beach every
// 4 seconds: a thin line of foam forms where the water is shore_reach (0.6) deep, rolls in toward
// the waterline, breaks into foam there and washes back. The phase varies slowly along the beach,
// so in one frame the lines stand at different distances from the shore and are not parallel to
// it. A generated noise foam texture breaks the lines and the band up into lace; the waves are a
// generated normal map scrolled by texture.Scroll.
// frames: 90
water_shore_waves {
  Scene: {water: true, texture_scroll: true}
  AmbientLight: {sky: {150, 175, 210}, ground: {80, 72, 58}, intensity: 0.7}

  sun {
    Rotation: {0.7, 0.9, 0}
    DirectionalLight: {intensity: 3}
    Rgb: {255, 244, 226}
  }

  camera {
    Position: {0, 5, 9}
    Rotation: {-0.5, 0, 0}
    Camera: {fov: 50}
  }

  main_view {
    View: {camera: camera, clear: {enabled: true, color: {120, 150, 190, 255}}}
  }

  waves_height {
    Gen: {
      width: 256, height: 256, seed: 7
      layers: [
        {kind: GenNoise, frequency: 4, octaves: 4, amount: 1}
      ]
    }
  }

  waves {
    Gen: {source: waves_height, output: GenNormal, strength: 2}
  }

  foam_noise {
    Gen: {
      width: 256, height: 256, seed: 3
      layers: [
        {kind: GenNoise, frequency: 8, octaves: 3, amount: 1}
      ]
    }
  }

  // The beach: y = 0 at z = 4, falling by 0.1 per unit toward -z
  beach_tilt {
    Position: {0, 0, 4}
    Rotation: {-0.0997, 0, 0}

    sand {
      Position: {0, 0, -20}
      Rotation: {-1.5708, 0, 0}
      Quad: {60, 48}
      Rgb: {206, 186, 146}
      PbrMaterial: {roughness: 0.95}
    }
  }

  sea {
    Position: {0, 0, -10}
    Rotation: {-1.5708, 0, 0}
    Quad: {60, 40}
    Rgb: {255, 255, 255}
    PbrMaterial: {metallic: 0, roughness: 0.08}
    PbrTextures: {normal: waves}
    texture.Transform: {scale_x: 12, scale_y: 8, offset_x: 0, offset_y: 0}
    texture.Scroll: {velocity: {0.004, 0.002}, normal_velocity: {0.01, 0.006}}
    Water: {
      shallow_color: {60, 170, 160}
      deep_color: {8, 40, 64}
      depth: 2
      visibility: 1.5
      refraction: 0.02
      foam_color: {240, 245, 245}
      foam_width: 0.08
      foam_texture: foam_noise
      foam_scale: 3
      shore_period: 4
      shore_reach: 0.6
    }
  }
}

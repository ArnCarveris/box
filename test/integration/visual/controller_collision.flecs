using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.controller

sun {
  Rotation: {0.9, -0.5, 0}
  DirectionalLight: {intensity: 1.1}
}

$ { EnvironmentLight: {sky_color: {95, 120, 160}, ground_color: {45, 42, 38}, intensity: 1} }

ground {
  Position: {0, -0.25, 0}
  Box: {40, 0.5, 40}
  Rgb: {70, 74, 82}
  PbrMaterial: {roughness: 0.9}
}

level {
  wall {
    Position: {0.75, 1.5, 2}
    Box: {0.5, 3, 6}
    Rgb: {150, 120, 100}
  }

  crate {
    Position: {0, 0.5, 0}
    Box: {2, 1, 2}
    Rgb: {180, 150, 90}
    PbrMaterial: {roughness: 0.6}
  }

  step_low {
    Position: {-1, 0.15, 3}
    Box: {2.5, 0.3, 1}
    Rgb: {120, 170, 130}
  }

  step_mid {
    Position: {-1, 0.3, 4}
    Box: {2.5, 0.6, 1}
    Rgb: {110, 160, 150}
  }

  step_high {
    Position: {-1, 0.45, 5}
    Box: {2.5, 0.9, 1}
    Rgb: {100, 150, 170}
  }

  pillar {
    Position: {-2.5, 1.25, 6}
    Cylinder: {radius: 0.4, length: 2.5, segments: 24}
    Rgb: {200, 200, 205}
    PbrMaterial: {metallic: 0.8, roughness: 0.3}
  }

  ball {
    Position: {-1.5, 0.6, 7}
    Sphere: {radius: 0.6, segments: 24, smooth: true}
    Rgb: {90, 160, 230}
  }
}

player {
  Position: {0.7, 2.7, 0}
  FirstPersonController: {}
  Camera: {fov: 65}
}

view { box.view.View: {camera: player} }

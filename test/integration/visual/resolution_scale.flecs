using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.texture
using box.surface
using box.ui

$ {
  Surface: {resolution_scale: 2}
  EnvironmentLight: {sky_color: {120, 145, 190}, ground_color: {75, 66, 58}, intensity: 0.7}
}

camera {
  Position: {0, 4, -11}
  LookAt: {0, 1, 0}
  Camera: {fov: 55}
}

sun {
  Rotation: {0.85, -0.45, 0}
  DirectionalLight: {intensity: 2.4}
}

textures {
  checker {
    Texture: {path: "etc/textures/checker.png"}
  }
}

floor {
  Position: {0, -0.5, 0}
  Box: {28, 0.2, 20}
  Rgb: {255, 255, 255}
  PbrMaterial: {roughness: 0.85}
  PbrTextures: {albedo: textures.checker}
  TextureTiling: {meters_x: 2, meters_y: 2}
}

crate {
  Position: {-3.4, 1.2, 0}
  Rotation: {0, 0.4, 0}
  Box: {2.4, 2.4, 2.4}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0.15, roughness: 0.6}
  PbrTextures: {albedo: textures.checker}
}

ball {
  Position: {0.8, 1.1, 0}
  Sphere: {segments: 40, smooth: true, radius: 1.1}
  Rgb: {90, 160, 235}
  PbrMaterial: {metallic: 0.3, roughness: 0.3}
}

post {
  Position: {4.2, 1.6, 0}
  Box: {0.5, 3.2, 0.5}
  Rgb: {225, 120, 90}
  PbrMaterial: {roughness: 0.5}
}

ui {
  Ui: {}
  Position: {0, -170, 0}
  Rect: {560, 120}
  Border: {radius: 16, width: 3, color: {130, 150, 200, 255}}
  Rgb: {30, 34, 46}

  bar {
    Position: {0, 26, 0}
    Rect: {500, 22}
    Border: {radius: 11}
    Rgb: {150, 170, 215}
  }

  dot {
    Position: {-210, -22, 0}
    Circle: {radius: 22}
    Rgb: {245, 205, 95}
  }

  line {
    Position: {-160, -22, 0}
    Line: {x1: 0, y1: 0, x2: 360, y2: 0, thickness: 6}
    Rgb: {200, 225, 240}
  }
}

// Material prefabs and their material ids, one column per case, left to right:
// - shared: three instances of one material prefab, which render with its slot;
// - override: instances that set their own Rgb, Emissive or PbrMaterial and keep the fields
//   they do not set from the prefab;
// - nested: a prefab of the prefab that sets its own emission and keeps the color, and one that
//   sets nothing and shares the slot of its base;
// - tinted: instances with their own Tint and below a tinted parent, next to an entity that
//   owns the same material and Tint.
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light

camera {
  Position: {0, 3.4, 10}
  Rotation: {-0.3, 0, 0}
  Camera: {fov: 50}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {30, 34, 44, 255}}}
}

sun {
  Rotation: {-0.9, 0.5, 0}
  DirectionalLight: {intensity: 3}
}

floor {
  Position: {0, -0.1, 0}
  Box: {18, 0.2, 8}
  Rgb: {200, 200, 205}
}

prefab Copper {
  Sphere: {segments: 32, smooth: true, radius: 0.5}
  Rgb: {225, 140, 80}
  PbrMaterial: {metallic: 1, roughness: 0.3}
}

prefab Glowing : Copper {
  Emissive: {strength: 2, color: {255, 60, 20}}
}

prefab Plain : Copper {
}

shared {
  Position: {-5.4, 0, 0}
  a : Copper { Position: {0, 0.5, 1.5} }
  b : Copper { Position: {0, 0.5, 0} }
  c : Copper { Position: {0, 0.5, -1.5} }
}

override {
  Position: {-1.8, 0, 0}
  green : Copper {
    Position: {0, 0.5, 1.5}
    Rgb: {60, 200, 90}
  }
  glow : Copper {
    Position: {0, 0.5, 0}
    Emissive: {strength: 1.5, color: {40, 120, 255}}
  }
  matte : Copper {
    Position: {0, 0.5, -1.5}
    PbrMaterial: {metallic: 0, roughness: 1}
  }
}

nested {
  Position: {1.8, 0, 0}
  a : Glowing { Position: {0, 0.5, 1.5} }
  b : Glowing { Position: {0, 0.5, 0} }
  c : Plain { Position: {0, 0.5, -1.5} }
}

tinted {
  Position: {5.4, 0, 0}
  own : Copper {
    Position: {0, 0.5, 1.5}
    Tint: {r: 40, g: 80, b: 255, a: 128}
  }
  parent {
    Position: {0, 0, 0}
    Tint: {r: 40, g: 80, b: 255, a: 128}
    child : Copper { Position: {0, 0.5, 0} }
  }
  owner {
    Position: {0, 0.5, -1.5}
    Sphere: {segments: 32, smooth: true, radius: 0.5}
    Rgb: {225, 140, 80}
    PbrMaterial: {metallic: 1, roughness: 0.3}
    Tint: {r: 40, g: 80, b: 255, a: 128}
  }
}

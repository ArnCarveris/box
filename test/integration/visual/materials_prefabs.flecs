// Material prefabs and their material ids, one column per case, left to right, front to back:
// - shared: three instances of one material prefab, which render with its slot;
// - override: instances that set their own Rgb, Emissive or PbrMaterial and keep the fields
//   they do not set from the prefab;
// - nested: a prefab of the prefab that sets its own emission and keeps the color, and one that
//   sets nothing and shares the slot of its base;
// - tinted: an instance with its own Tint, one below a tinted parent and an entity that owns the
//   same material and Tint, which all look the same.
using box.transform
using box.geometry
using box.material
using box.camera
using box.view

camera {
  Position: {0, 7.5, 8}
  Rotation: {-0.75, 0, 0}
  Camera: {fov: 50}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {30, 34, 44, 255}}}
}

floor {
  Position: {0, -0.1, 0}
  Box: {18, 0.2, 8}
  Rgb: {200, 200, 205}
}

prefab Clay {
  Sphere: {segments: 32, smooth: true, radius: 0.6}
  Rgb: {225, 140, 80}
  PbrMaterial: {metallic: 0, roughness: 0.35}
}

prefab Glowing : Clay {
  Emissive: {strength: 2, color: {255, 60, 20}}
}

prefab Plain : Clay {
}

shared {
  Position: {-5.4, 0, 0}
  a : Clay { Position: {0, 0.6, 1.8} }
  b : Clay { Position: {0, 0.6, 0} }
  c : Clay { Position: {0, 0.6, -1.8} }
}

override {
  Position: {-1.8, 0, 0}
  green : Clay {
    Position: {0, 0.6, 1.8}
    Rgb: {60, 200, 90}
  }
  glow : Clay {
    Position: {0, 0.6, 0}
    Emissive: {strength: 1.5, color: {40, 120, 255}}
  }
  metal : Clay {
    Position: {0, 0.6, -1.8}
    PbrMaterial: {metallic: 1, roughness: 0.3}
  }
}

nested {
  Position: {1.8, 0, 0}
  a : Glowing { Position: {0, 0.6, 1.8} }
  b : Glowing { Position: {0, 0.6, 0} }
  c : Plain { Position: {0, 0.6, -1.8} }
}

tinted {
  Position: {5.4, 0, 0}
  own : Clay {
    Position: {0, 0.6, 1.8}
    Tint: {r: 40, g: 80, b: 255, a: 128}
  }
  parent {
    Position: {0, 0, 0}
    Tint: {r: 40, g: 80, b: 255, a: 128}
    child : Clay { Position: {0, 0.6, 0} }
  }
  owner {
    Position: {0, 0.6, -1.8}
    Sphere: {segments: 32, smooth: true, radius: 0.6}
    Rgb: {225, 140, 80}
    PbrMaterial: {metallic: 0, roughness: 0.35}
    Tint: {r: 40, g: 80, b: 255, a: 128}
  }
}

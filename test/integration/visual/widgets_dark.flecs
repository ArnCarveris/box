// The widget gallery of test/assets/ui/gallery.flecs in the dark theme with every section in view:
// the window is made tall enough for the page not to scroll and the cameras of the gallery show
// all of it in the capture. The form has its Name field focused with "idg" selected and the caret
// on, and its Shape dropdown open with Sphere highlighted over the sliders.
include test/assets/ui/gallery

using flecs.script
using box.camera
using box.surface
using box.ui
using box.widgets

$ {
  box.view.Scene: {blend_modes: true}
}

window {
  Surface: {width: 2048, height: 1152}
}

backdrop {
  camera {
    Camera: {ortho: true, ortho_scale: 0, ortho_height: 1152}
  }
}

gallery {
  hud {
    camera {
      Camera: {ortho: true, ortho_scale: 0, ortho_height: 1152}
    }

    root {
      page {
        bottom {
          form {
            body {
              controls {
                name {
                  field {
                    TextEditStatus: {caret: 4, anchor: 1}
                  }
                }

                shape_row {
                  shape {
                    Dropdown.mut: {open: true, highlight: 1}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// Focus the field once the gallery runs; a focus by script shows the caret like a click
async {
  const controls = gallery.lookup("hud").lookup("root").lookup("page").lookup("bottom")
    .lookup("form").lookup("body").lookup("controls")
  await focus(controls.lookup("name").lookup("field"))
}

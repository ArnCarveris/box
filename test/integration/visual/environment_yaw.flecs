using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light

// The balls of environment_spheres lit by axes.hdr (a color per axis direction: +X red, -X
// cyan, +Y green, -Y magenta, +Z blue, -Z yellow) turned 45 degrees about +Y, which sky.hdr would
// not show. The camera looks along the seam of +X and -Z, so the background splits into yellow
// on the left and red on the right at the center of the image. The metal balls mirror cyan,
// blue, green and magenta around their rims, the smooth one sharply and the rough ones blurred;
// the dielectric balls are lit green from above and magenta from below.
spheres {
  Scene: {}
  AmbientLight: {sky: {0, 0, 0}, ground: {0, 0, 0}, intensity: 0}

  axes {
    Environment: {resolution: 128}
    EnvironmentImage: {path: "etc/environments/axes.hdr"}
  }

  darkness {
    DirectionalLight: {intensity: 0}
  }

  camera {
    Position: {0, 1.4, 5.5}
    Rotation: {-0.12, 0, 0}
    Camera: {fov: 55}
  }

  metal_smooth {
    Position: {-2.2, 1.6, -0.8}
    Sphere: {segments: 48, smooth: true, radius: 0.8}
    Rgb: {240, 240, 245}
    PbrMaterial: {metallic: 1, roughness: 0.05}
  }

  metal_mid {
    Position: {0, 1.6, -0.8}
    Sphere: {segments: 48, smooth: true, radius: 0.8}
    Rgb: {240, 240, 245}
    PbrMaterial: {metallic: 1, roughness: 0.4}
  }

  metal_rough {
    Position: {2.2, 1.6, -0.8}
    Sphere: {segments: 48, smooth: true, radius: 0.8}
    Rgb: {240, 240, 245}
    PbrMaterial: {metallic: 1, roughness: 0.8}
  }

  dielectric_smooth {
    Position: {-2.2, 0.2, 0.8}
    Sphere: {segments: 48, smooth: true, radius: 0.6}
    Rgb: {230, 230, 230}
    PbrMaterial: {metallic: 0, roughness: 0.05}
  }

  dielectric_mid {
    Position: {0, 0.2, 0.8}
    Sphere: {segments: 48, smooth: true, radius: 0.6}
    Rgb: {230, 230, 230}
    PbrMaterial: {metallic: 0, roughness: 0.4}
  }

  dielectric_rough {
    Position: {2.2, 0.2, 0.8}
    Sphere: {segments: 48, smooth: true, radius: 0.6}
    Rgb: {230, 230, 230}
    PbrMaterial: {metallic: 0, roughness: 0.8}
  }
}

spheres_view {
  View: {
    camera: spheres.camera,
    clear: {enabled: true, color: {0, 0, 0, 255}},
    lighting: {enabled: true, baked: true, reflections: true, atmosphere: true,
      environment: {source: spheres.axes, intensity: 1, yaw: 0.7854, background: true}}
  }
}

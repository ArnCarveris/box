using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.atmosphere

$ {
  Scene: {aerial_perspective: true}
}

camera {
  Position: {0, 500, 0}
  Rotation: {-0.25, 0, 0}
  Camera: {fov: 70, far_: 0}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {0, 0, 0, 255}}}
}

sun {
  Rotation: {0.8, 0.9, 0}
  DirectionalLight: {intensity: 3 * flecs.script.math.PI}
  Rgb: {255, 255, 255}
}

$ {
  Atmosphere: {units_per_km: 100, sun: sun}
}

ground {
  Position: {0, -0.1, -20000}
  Box: {80000, 0.2, 60000}
  Rgb: {110, 130, 90}
  PbrMaterial: {roughness: 1}
}

for i in 0..8 {
  {
    Position: {(i % 2) * 1200 - 600, 60, -800 - i * i * 400}
    Box: {240, 120, 240}
    Rgb: {200, 70, 50}
  }
}

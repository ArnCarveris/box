spans_dark {
  Position: {-160, -115, 0}
  Rect: {316, 110}
  Rgb: {244, 226, 186}

  spectral_13 {
    Position: {0, 30, 1}
    Text: {value: "Red ink, green and blue lines", size: 13, font: spectral}
    Rgb: {58, 36, 20}
    Spans: {spans: [
      {start: 0, end: 3, color: {150, 30, 20, 255}},
      {start: 9, end: 14, color: {30, 90, 40, 255}},
      {start: 19, end: 23, color: {30, 50, 130, 255}}

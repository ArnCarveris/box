using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.text

// Small text in ink on parchment-like panels next to the same text in parchment on ink panels,
// at 11, 13, 15, 18 and 24 px, in a thin serif (Spectral) and a sans (B612). The edges of the
// glyphs blend in linear light; the coverage of dark text is corrected for it so both columns
// of a font look equally heavy. Below them colored Spans, dark on light and light on dark.

spectral {
  Font: {path: "test/assets/fonts/Spectral-Regular.ttf"}
}

b612 {
  Font: {path: "test/assets/fonts/B612-Regular.ttf"}
}

camera {
  Position: {0, 0, 100}
  Camera: {ortho: true, ortho_scale: 1}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {120, 120, 120, 255}}}
}

spectral_dark {
  Position: {-240, 60, 0}
  Rect: {156, 230}
  Rgb: {244, 226, 186}

  size_11 {
    Position: {0, 90, 1}
    Text: {value: "Quill ink", size: 11, font: spectral}
    Rgb: {58, 36, 20}
  }

  size_13 {
    Position: {0, 55, 1}
    Text: {value: "Quill ink", size: 13, font: spectral}
    Rgb: {58, 36, 20}
  }

  size_15 {
    Position: {0, 18, 1}
    Text: {value: "Quill ink", size: 15, font: spectral}
    Rgb: {58, 36, 20}
  }

  size_18 {
    Position: {0, -22, 1}
    Text: {value: "Quill ink", size: 18, font: spectral}
    Rgb: {58, 36, 20}
  }

  size_24 {
    Position: {0, -75, 1}
    Text: {value: "Quill ink", size: 24, font: spectral}
    Rgb: {58, 36, 20}
  }
}

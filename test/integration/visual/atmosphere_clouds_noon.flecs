using box.transform
using box.geometry
using box.material
using box.texture
using box.camera
using box.view
using box.light
using box.atmosphere

// A layer of cumulus at 1.5 km over a field at noon: a seamless fbm noise (Gen, the
// red channel as stored) repeats every 15 km, threshold 0.5 and softness 0.12 leave about half
// the sky covered. Overhead the clouds are white with gray bases; toward the horizon the plane
// grazes the view, the texture filters through its mips and the clouds fade into the haze.

$ {
  Scene: {aerial_perspective: true}
}

camera {
  Position: {0, 2, 12}
  Rotation: {0.3, 0, 0}
  Camera: {fov: 70, far_: 0}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {0, 0, 0, 255}}}
}

sun {
  Rotation: {1.1, 0.5, 0}
  DirectionalLight: {intensity: 3 * flecs.script.math.PI}
  Rgb: {255, 255, 255}
}

$ {
  Atmosphere: {units_per_km: 100, sun: sun}
}

cloud_noise {
  Gen: {
    width: 512, height: 512, seed: 7
    layers: [
      {kind: GenNoise, frequency: 10, octaves: 5, gain: 0.5}
    ]
  }
}

clouds {
  CloudLayer: {texture: cloud_noise, size: 1500, altitude: 150, threshold: 0.5, softness: 0.12, velocity: {2, 1}}
}

ground {
  Position: {0, -0.1, -4000}
  Box: {12000, 0.2, 8100}
  Rgb: {110, 130, 90}
  PbrMaterial: {roughness: 0.9}
}

box_40 {
  Position: {-10.7, 3, -28}
  Box: {6, 6, 6}
  Rgb: {200, 70, 50}
}

box_160 {
  Position: {14, 10, -148}
  Box: {20, 20, 20}
  Rgb: {200, 70, 50}
}

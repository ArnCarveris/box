using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light

camera {
  Position: {0, 4, 9}
  Rotation: {-0.4, 0, 0}
  Camera: {fov: 50}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {40, 44, 52, 255}}, shadows: {enabled: true}}
}

sun {
  Rotation: {-0.35, 2.2, 0}
  DirectionalLight: {intensity: 1.5}
}

floor {
  Position: {0, -0.1, 0}
  Box: {20, 0.2, 12}
  Rgb: {180, 180, 185}
}

ramp {
  Position: {-2, 0.9, -1}
  Rotation: {0, 0, 0.35}
  Box: {6, 0.2, 4}
  Rgb: {210, 200, 170}
}

cube {
  Position: {-2.64, 1.2, -1}
  Rotation: {0, 0, 0.35}
  Box: {0.8, 0.8, 0.8}
  Rgb: {220, 90, 70}
}

block {
  Position: {3, 0.5, 0}
  Box: {1, 1, 1}
  Rgb: {90, 160, 220}
}

slab {
  Position: {3, 0.05, 2.5}
  Box: {2, 0.1, 1}
  Rgb: {230, 210, 90}
}

ball {
  Position: {1, 0.5, 2}
  Sphere: {segments: 32, smooth: true, radius: 0.5}
  Rgb: {230, 230, 230}
}

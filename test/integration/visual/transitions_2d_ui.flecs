// 2D shape and UI element transitions, frozen in the middle. SetAt changes the values at the
// start of the second frame, with linear durations of 0.05 s (three frames at the fixed delta of
// 1/60 s), so the render of the third frame shows each a third of the way:
// - card: a rounded 2D rect that moves right, turns and goes from orange to blue, between its
//   grey start outline and its green target outline
// - button: a UI element in a layout whose Rgb goes from dark to a light green, with its label,
//   whose text Rgb goes from white to black
// - toast: a UI panel with a text child whose Opacity goes from 1 to 0, blended at 0.7
// - shadow_card: a white rounded rect with a BoxShadow that moves left, turns, grows from a
//   Scale of 1 to 1.3 and fades from an Opacity of 1 to 0.4: its shadow keeps its offset and
//   blur relative to the card, a third of the way, fades with it (0.8) and is cut out under
//   the card by the alpha the card renders at, with no seam along its edge
// - lift_card: a white rounded rect lifted as on hover: it rises from a y of 10 to 16 while its
//   BoxShadow goes from close and sharp (offset_y -2, blur 4, alpha 120) to far and soft
//   (offset_y -14, blur 28, spread 2, alpha 180), so a third of the way its shadow has an
//   offset_y of -6, a blur of 12, a spread of 0.67 and an alpha of 140
// - ring_field: a white rounded rect whose Border goes from 1 wide and grey to 3 wide and blue
//   as on focus, so a third of the way it is 1.67 wide and a third of the way to blue
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.layout
using box.text
using box.app
using box.transition

$ {
  Scene: {blend_modes: true}
}

camera {
  Position: {0, 0, 100}
  Camera: {ortho: true, ortho_scale: 1}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {236, 238, 242, 255}}}
}

start_outline {
  Position: {-200, 90, 0}
  Rect: {104, 64}
  Rgb: {236, 238, 242}
  Border: {width: 2, radius: 12, color: {150, 150, 150, 255}}
}

target_outline {
  Position: {200, 90, 0}
  Rect: {104, 64}
  Rgb: {236, 238, 242}
  Border: {width: 2, radius: 12, color: {60, 200, 90, 255}}
}

card {
  Position: {-200, 90, 1}
  Rotation: {0, 0, 0}
  Rect: {100, 60}
  Rgb: {250, 150, 50}
  Border: {radius: 10}
  Transition: [
    Position: {duration: 0.05},
    Rotation: {duration: 0.05},
    Rgb: {duration: 0.05}
  ]
}

shadow_card {
  Position: {200, 10, 1}
  Rotation: {0, 0, 0}
  Scale: {1, 1, 1}
  Rect: {90, 50}
  Rgb: {255, 255, 255}
  Opacity: {1}
  Border: {radius: 10}
  BoxShadow: {offset_x: 8, offset_y: -8, blur: 10, color: {20, 30, 60, 200}}
  Transition: [
    Position: {duration: 0.05},
    Rotation: {duration: 0.05},
    Scale: {duration: 0.05},
    Opacity: {duration: 0.05}
  ]
}

lift_card {
  Position: {-100, 10, 1}
  Rect: {80, 50}
  Rgb: {255, 255, 255}
  Border: {radius: 8}
  BoxShadow: {offset_y: -2, blur: 4, color: {20, 30, 60, 120}}
  Transition: [
    Position: {duration: 0.05},
    BoxShadow: {duration: 0.05}
  ]
}

ring_field {
  Position: {-200, -150, 1}
  Rect: {140, 30}
  Rgb: {255, 255, 255}
  Border: {width: 1, radius: 8, color: {150, 150, 150, 255}}
  Transition: [Border: {duration: 0.05}]
}

ui {
  Layout: {direction: Row, spacing: 24, padding: {12, 12, 12, 12}}
  LayoutItem: {width: {mode: Fixed, value: 520}}
  Position: {0, -80, 0}
  Rect: {1, 1}
  Rgb: {40, 44, 56}
  Border: {width: 1, radius: 8, color: {90, 110, 150, 255}}

  button {
    Position: {0, 0, 1}
    Layout: {padding: {8, 8, 14, 14}, h: Center, v: Middle}
    LayoutItem: {v: Middle}
    Rect: {1, 1}
    Rgb: {30, 60, 40}
    Border: {radius: 6}
    Transition: [Rgb: {duration: 0.05}]

    label {
      Position: {0, 0, 1}
      Text: {value: "Apply", size: 22}
      Rgb: {255, 255, 255}
      Transition: [Rgb: {duration: 0.05}]
    }
  }

  toast {
    Position: {0, 0, 1}
    Layout: {padding: {8, 8, 14, 14}, h: Center, v: Middle}
    LayoutItem: {v: Middle}
    Rect: {1, 1}
    Rgb: {200, 60, 60}
    Border: {radius: 6}
    Opacity: {1}
    Transition: [Opacity: {duration: 0.05}]

    message {
      Position: {0, 0, 1}
      Text: {value: "Saved", size: 22}
      Rgb: {255, 255, 255}
    }
  }
}

change_card {
  SetAt: {frame: 1, entity: card}
  Position: {200, 90, 1}
  Rotation: {0, 0, 1.2}
  Rgb: {60, 110, 240}
}

change_button {
  SetAt: {frame: 1, entity: ui.button}
  Rgb: {150, 230, 160}
}

change_label {
  SetAt: {frame: 1, entity: ui.button.label}
  Rgb: {0, 0, 0}
}

change_toast {
  SetAt: {frame: 1, entity: ui.toast}
  Opacity: {0}
}

change_shadow_card {
  SetAt: {frame: 1, entity: shadow_card}
  Position: {-200, 10, 1}
  Rotation: {0, 0, -0.9}
  Scale: {1.3, 1.3, 1}
  Opacity: {0.4}
}

change_lift_card {
  SetAt: {frame: 1, entity: lift_card}
  Position: {-100, 16, 1}
  BoxShadow: {offset_y: -14, blur: 28, spread: 2, color: {20, 30, 60, 180}}
}

change_ring_field {
  SetAt: {frame: 1, entity: ring_field}
  Border: {width: 3, radius: 8, color: {40, 110, 240, 255}}
}

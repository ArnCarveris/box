using box.transform
using box.geometry
using box.material
using box.camera
using box.view

$ {
  Scene: {blend_modes: true}
}

camera {
  Position: {0, 4, 9}
  Rotation: {-0.4, 0, 0}
  Camera: {fov: 50}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {36, 40, 52, 255}}}
}

floor {
  Position: {0, -0.1, 0}
  Box: {16, 0.2, 8}
  Rgb: {200, 200, 205}
}

pillar {
  Position: {-3, 1.2, -2.5}
  Box: {0.6, 2.4, 0.6}
  Rgb: {40, 60, 200}
}

red_pane {
  Position: {-4, 1.1, -1}
  Box: {1.6, 1.8, 0.2}
  Rgb: {230, 40, 40}
  Opacity: {value: 0.5}
}

green_pane {
  Position: {-3.3, 0.9, 0}
  Box: {1.6, 1.8, 0.2}
  Rgb: {40, 220, 60}
  Opacity: {value: 0.5}
}

blue_pane {
  Position: {-2.6, 0.7, 1}
  Box: {1.6, 1.4, 0.2}
  Rgb: {50, 90, 240}
  Opacity: {value: 0.5}
}

faded_group {
  Position: {0.4, 0, 0}
  Opacity: {value: 0.4}
  left {
    Position: {-0.5, 0.7, 0}
    Sphere: {segments: 32, smooth: true, radius: 0.7}
    Rgb: {250, 200, 40}
  }
  right {
    Position: {0.5, 0.7, 0.4}
    Sphere: {segments: 32, smooth: true, radius: 0.7}
    Rgb: {240, 80, 200}
  }
}

additive {
  Position: {3, 0.8, -0.5}
  Sphere: {segments: 32, smooth: true, radius: 0.8}
  Rgb: {40, 120, 255}
  BlendMode: {Additive}
  Opacity: {value: 0.8}
}

multiply {
  Position: {3.6, 0.6, 1.2}
  Box: {1.6, 1.2, 0.3}
  Rgb: {255, 200, 60}
  BlendMode: {Multiply}
}

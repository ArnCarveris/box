using box.transform
using box.geometry
using box.material
using box.texture
using box.camera
using box.view
using box.light

// texture.Layers: a wet layer without textures (albedo times 0.6 grey, roughness times 0.3, a
// 0.3 flat normal, porosity 1, everywhere). Back row dry, front row wet: the rock and the bark
// darken and gloss, the glossy leaf changes little, the metal torus does not change.
//
// frames: 10
$ {
  Scene: {alpha_cutout: true, texture_layers: true}
}

camera {
  Position: {0, 3.4, 7.5}
  Rotation: {-0.36, 0, 0}
  Camera: {fov: 50}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {120, 130, 150, 255}},
    shadows: {enabled: true}}
}

$ {
  AmbientLight: {sky: {140, 150, 170}, ground: {60, 58, 54}, intensity: 0.6}
}

// A low sun from the side and behind, so the wet gloss shows as highlights toward the camera
sun {
  Rotation: {0.5, 1.2, 0}
  DirectionalLight: {intensity: 1.5 * flecs.script.math.PI}
  Rgb: {255, 240, 220}
}

stripes { Path: {path: "test/integration/visual/assets/stripes.png"} }
bumps { Path: {path: "test/integration/visual/assets/bumps.png"} }
orm { Path: {path: "test/integration/visual/assets/orm.png"} }
leaf_tex { Path: {path: "test/integration/visual/assets/leaf.png"} }

wet {
  texture.Layer: {amount: 1, facing: 0, albedo: LayerMultiply, roughness: LayerMultiply,
    metallic: LayerKeep, occlusion: LayerKeep, normal: 0.3, porosity: 1}
  Rgb: {153, 153, 153}
  PbrMaterial: {roughness: 0.3}
}

floor {
  Position: {0, -0.1, 0}
  Box: {14, 0.2, 8}
  Rgb: {110, 110, 105}
  PbrMaterial: {roughness: 0.8}
}

prefab Rock {
  IcoSphere: {segments: 2, radius: 0.6}
  Rgb: {160, 150, 140}
  PbrMaterial: {roughness: 0.9}
  PbrTextures: {orm: orm, normal: bumps}
}

prefab Bark {
  Cylinder: {length: 1.8, radius: 0.35, smooth: true, segments: 32}
  Rgb: {150, 105, 70}
  PbrMaterial: {roughness: 0.95}
  PbrTextures: {albedo: stripes}
}

prefab Leaf {
  Quad: {1.3, 1.3}
  Rgb: {90, 160, 70}
  PbrMaterial: {roughness: 0.35}
  PbrTextures: {albedo: leaf_tex}
  AlphaCutoff: {value: 0.5}
  BackFaceMode: {BackFacePlain}
}

prefab Metal {
  Torus: {radius: 0.45, tube: 0.16, smooth: true}
  Rgb: {220, 190, 140}
  PbrMaterial: {metallic: 1, roughness: 0.35}
}

dry_rock : Rock { Position: {-3.6, 0.5, -1.4} }
dry_bark : Bark { Position: {-1.2, 0.9, -1.4} }
dry_leaf : Leaf { Position: {1.2, 0.8, -1.4}; Rotation: {-0.3, 0, 0} }
dry_metal : Metal { Position: {3.6, 0.6, -1.4}; Rotation: {1.2, 0, 0} }

wet_rock : Rock { Position: {-3.6, 0.5, 1}; texture.Layers: {layers: [wet]} }
wet_bark : Bark { Position: {-1.2, 0.9, 1}; texture.Layers: {layers: [wet]} }
wet_leaf : Leaf { Position: {1.2, 0.8, 1}; Rotation: {-0.3, 0, 0}; texture.Layers: {layers: [wet]} }
wet_metal : Metal {
  Position: {3.6, 0.6, 1}
  Rotation: {1.2, 0, 0}
  texture.Layers: {layers: [wet]}
}

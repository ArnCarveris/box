using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.texture

$ {
  EnvironmentLight: {sky_color: {110, 140, 190}, ground_color: {70, 62, 55}, intensity: 0.6}
}

textures {
  checker {
    Texture: {path: "etc/textures/checker.png"}
  }

  bumps {
    Texture: {path: "etc/textures/bumps_normal.png"}
  }

  rough {
    Texture: {path: "etc/textures/roughness.png"}
  }
}

camera {
  Position: {0, 3.2, -8.5}
  LookAt: {0, 0.9, 0}
  Camera: {fov: 55}
}

sun {
  Rotation: {0.85, -0.5, 0}
  DirectionalLight: {intensity: 3}
}

floor {
  Position: {0, -0.5, 0}
  Box: {16, 0.2, 16}
  Rgb: {210, 210, 215}
  PbrMaterial: {roughness: 0.8}
  PbrTextures: {albedo: textures.checker, roughness: textures.rough}
}

box {
  Position: {-3, 1, 0}
  Rotation: {0, 0.5, 0}
  Box: {2, 2, 2}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0.1, roughness: 0.6}
  PbrTextures: {albedo: textures.checker}
}

sphere {
  Position: {0, 1, 0}
  Sphere: {segments: 48, smooth: true, radius: 1}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0.2, roughness: 0.5}
  PbrTextures: {albedo: textures.checker, roughness: textures.rough}
}

bumped {
  Position: {3.2, 1, 0}
  Rotation: {0, 0.5, 0}
  Box: {2, 2, 2}
  Rgb: {190, 200, 220}
  PbrMaterial: {metallic: 0.3, roughness: 0.35}
  PbrTextures: {normal: textures.bumps}
}

panel {
  Position: {0, 1.6, 4.5}
  Quad: {9, 4}
  Rgb: {235, 235, 240}
  PbrMaterial: {metallic: 0.9, roughness: 1}
  PbrTextures: {roughness: textures.rough}
}

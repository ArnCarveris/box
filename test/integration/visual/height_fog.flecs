// effects/height_fog
using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.effects

camera {
  Position: {0, 2.2, -14}
  LookAt: {0, 2.2, 0}
  Camera: {fov: 60}
}

sun {
  Rotation: {0.75, -0.5, 0}
  DirectionalLight: {intensity: 1.4}
}

$ { EnvironmentLight: {sky_color: {150, 170, 200}, ground_color: {70, 68, 62}, intensity: 0.9} }

floor {
  Position: {0, -0.1, 60}
  Box: {60, 0.2, 180}
  Rgb: {150, 148, 145}
  PbrMaterial: {roughness: 0.9}
}


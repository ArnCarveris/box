}

post_effects { fog : box.effects.fog {
  Fog: {color: {0.62, 0.66, 0.74}, density: 0.055, falloff: 0.45, start: 2,
        max_opacity: 0.97, height: 0.5}
} }
view { box.view.View: {camera: camera, effects: [{effect: post_effects.fog, enabled: true}]} }

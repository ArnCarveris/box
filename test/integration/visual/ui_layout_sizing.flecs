using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.ui

camera {
  Position: {0, 0, -10}
  LookAt: {0, 0, 0}
  Camera: {fov: 55}
}

ui {
  Ui: {height: 540}
  Position: {0, 0, 0}
  Layout: {direction: Column, width: 900, height: 500,
           padding: 16, spacing: 12, h: Left}
  Border: {radius: 20, width: 3, color: {120, 140, 190, 255}}
  Rgb: {30, 34, 46}

  toolbar {
    Layout: {direction: Row, height: 48, padding: 8, spacing: 8, v: Middle}
    Grow: {width: 1}
    Border: {radius: 12}
    Rgb: {52, 66, 100}

    logo {
      Rect: {32, 32}
      Border: {radius: 16}
      Rgb: {245, 205, 95}
    }

    search {
      Rect: {0, 28}
      Grow: {width: 1}
      Border: {radius: 14}
      Rgb: {190, 205, 240}
    }

    action_one {
      Rect: {80, 28}
      Border: {radius: 14}
      Rgb: {235, 120, 95}
    }

    action_two {
      Rect: {80, 28}
      Border: {radius: 14}
      Rgb: {110, 160, 235}
    }
  }

  weights {
    Layout: {direction: Row, height: 40, spacing: 8}
    Grow: {width: 1}

    one {
      Rect: {0, 40}
      Grow: {width: 1}
      Border: {radius: 8}
      Rgb: {74, 96, 138}
    }

    two {
      Rect: {0, 40}
      Grow: {width: 2}
      Border: {radius: 8}
      Rgb: {96, 122, 170}
    }

    capped {
      Layout: {height: 40, max_width: 90}
      Rect: {0, 0}
      Grow: {width: 1}
      Border: {radius: 8}
      Rgb: {170, 140, 210}
    }
  }

  body {
    Layout: {direction: Row, spacing: 12}
    Grow: {width: 1, height: 1}

    sidebar {
      Layout: {direction: Column, width: 200, padding: 6,
               padding_left: 24, padding_top: 16, spacing: 6, h: Left}
      Grow: {height: 1}
      Border: {radius: 14, width: 2, color: {95, 115, 160, 255}}
      Rgb: {44, 52, 70}

      item_one {
        Rect: {150, 26}
        Border: {radius: 8}
        Rgb: {74, 96, 138}
      }

      item_two {
        Rect: {0, 26}
        Grow: {width: 1}
        Border: {radius: 8}
        Rgb: {96, 122, 170}
      }

      item_three {
        Rect: {110, 26}
        Border: {radius: 8}
        Rgb: {74, 96, 138}
      }
    }

    card {
      Layout: {direction: Column, padding: 14, spacing: 10, h: Left}
      Grow: {width: 1, height: 1}
      Border: {radius: 14, width: 2, color: {95, 115, 160, 255}}
      Rgb: {38, 60, 58}

      card_title {
        Font: {size: 22}
        Text: {value: "Grow, bounds and wrapping"}
        Rgb: {235, 240, 255}
      }

      card_body {
        Font: {size: 15}
        Text: {value: "This paragraph has no width of its own. It wraps at the width the card leaves it, and the card takes the room the sidebar and the menu leave in the row.",
               wrap: true}
        Rgb: {205, 215, 235}
      }

      card_row {
        Layout: {direction: Row, spacing: 8, v: Top}
        Grow: {width: 1}

        card_icon {
          Rect: {24, 24}
          Border: {radius: 12}
          Rgb: {120, 215, 170}
        }

        card_note {
          Font: {size: 15}
          Text: {value: "Beside an icon the lines wrap at the room the icon leaves in the row.",
                 wrap: true}
          Rgb: {170, 225, 200}
        }
      }

      card_fill {
        Rect: {0, 0}
        Grow: {width: 1, height: 1}
        Border: {radius: 10}
        Rgb: {70, 130, 110}
      }
    }

    menu {
      Layout: {direction: Column, width: 220, padding: 10, spacing: 10, h: Center}
      Grow: {height: 1}
      Border: {radius: 14, width: 2, color: {95, 115, 160, 255}}
      Rgb: {56, 46, 68}

      menu_button {
        Rect: {160, 30}
        Border: {radius: 8}
        Rgb: {132, 104, 172}

        dropdown {
          Anchor: {h: Left, v: Top, parent_h: Left, parent_v: Bottom, y: -4}
          Rect: {160, 96}
          Border: {radius: 8, width: 2, color: {200, 180, 240, 255}}
          Rgb: {80, 64, 104}
        }
      }

      spacer {
        Grow: {height: 1}
      }

      tip_button {
        Rect: {100, 30}
        Border: {radius: 15}
        Rgb: {170, 140, 210}

        tooltip {
          Anchor: {h: Right, v: Middle, parent_h: Left, x: -8}
          Rect: {120, 26}
          Border: {radius: 6}
          Rgb: {245, 205, 95}
        }
      }
    }
  }

  footer {
    Layout: {direction: Row, padding: 6, min_width: 260, h: Center, v: Middle}
    Border: {radius: 12}
    Rgb: {44, 50, 66}

    footer_note {
      Font: {size: 14}
      Text: {value: "min_width 260"}
      Rgb: {150, 170, 215}
    }
  }
}

view { box.view.View: {camera: camera} }

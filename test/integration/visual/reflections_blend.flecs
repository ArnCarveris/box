using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light

$ {
  Scene: {reflections: true}
}

// A closed hall, blue on the left half and orange on the right, with a row of mirror balls on a
// glossy floor and the camera inside. A probe of priority 0 captures near the blue half of the
// wall behind the camera and covers the whole hall, a probe of priority 1 captures near its
// orange half and covers the right side, fading out over 3 units toward the middle: the middle
// ball is at half weight. Without box projection each ball reflects the wall behind the camera
// as its probe saw it: blue on the left, orange on the right and a blend of both in the middle.
hall {
  Scene: {reflections: true}
  ReflectionBake: {resolution: 128, scene_probe: false}
  AmbientLight: {intensity: 0.2}

  camera {
    Position: {0, 2.2, 7.5}
    Rotation: {-0.2, 0, 0}
    Camera: {fov: 55}
  }

  left_lamp {
    Position: {-3, 2.9, 3}
    PointLight: {intensity: 5 * flecs.script.math.PI, range: 12}
  }

  right_lamp {
    Position: {3, 2.9, 3}
    PointLight: {intensity: 5 * flecs.script.math.PI, range: 12}
  }

  floor {
    Position: {0, -0.1, 3.4}
    Box: {12.4, 0.2, 11.6}
    Rgb: {50, 50, 56}
    PbrMaterial: {metallic: 0, roughness: 0.1}
  }

  ceiling {
    Position: {0, 3.3, 3.4}
    Box: {12.4, 0.2, 11.6}
    Rgb: {220, 220, 220}
  }

  back_left {
    Position: {-3, 1.6, -2.3}
    Box: {6, 3.2, 0.2}
    Rgb: {40, 80, 210}
  }

  back_right {
    Position: {3, 1.6, -2.3}
    Box: {6, 3.2, 0.2}
    Rgb: {240, 130, 30}
  }

  front_left {
    Position: {-3, 1.6, 9.1}
    Box: {6, 3.2, 0.2}
    Rgb: {40, 80, 210}
  }

  front_right {
    Position: {3, 1.6, 9.1}
    Box: {6, 3.2, 0.2}
    Rgb: {240, 130, 30}
  }

  left_end {
    Position: {-6.1, 1.6, 3.4}
    Box: {0.2, 3.2, 11.6}
    Rgb: {40, 80, 210}
  }

  right_end {
    Position: {6.1, 1.6, 3.4}
    Box: {0.2, 3.2, 11.6}
    Rgb: {240, 130, 30}
  }

  for i in 0..7 {
    {
      Position: {i * 1.6 - 4.8, 0.55, 0}
      Sphere: {segments: 32, smooth: true, radius: 0.55}
      Rgb: {255, 255, 255}
      PbrMaterial: {metallic: 1, roughness: 0}
    }
  }

  blue_probe {
    Position: {-3, 1.6, 3.4}
    ReflectionProbe: {extent: {9.5, 5, 9}, blend: 0.5, priority: 0, projection: {0, 0, 0},
      offset: {0, 0, 5}}
  }

  orange_probe {
    Position: {4.5, 1.6, 3.4}
    ReflectionProbe: {extent: {6, 5, 9}, blend: 3, priority: 1, projection: {0, 0, 0},
      offset: {-1.5, 0, 5}}
  }
}

hall_view {
  View: {camera: hall.camera, clear: {enabled: true, color: {0, 0, 0, 255}}}
}

using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.particle

camera {
  Position: {0, 2.2, -13}
  LookAt: {0, 1.6, 0}
  Camera: {fov: 60}
}

sun {
  Rotation: {0.9, -0.6, 0}
  DirectionalLight: {intensity: 1.4}
}

$ { EnvironmentLight: {sky_color: {120, 135, 165}, ground_color: {60, 58, 55}, intensity: 0.6} }

ground {
  Position: {0, -0.25, 0}
  Box: {40, 0.5, 40}
  Rgb: {105, 108, 112}
  PbrMaterial: {roughness: 0.9}
}

blast {
  Position: {-6, 1.6, 0}
  ParticleEmitter: {
    max: 4000, rate: 0, shape: EmitterSphere, radius: 0.05,
    direction: {0, 0, 0}, spread: 180,
    speed: {min: 34, max: 40},
    lifetime: {min: 1, max: 1},
    size: {min: 0.12, max: 0.18},
    opacity: {min: 0.14, max: 0.2},
    color: {255, 190, 120},
    seed: 61
  }
  ParticleBurst: {count: 1600}
  ParticleAppearance: { shape: ParticleCircle, blend: ParticleAdditive }
}

pulses {
  Position: {-2, 1.6, 0}
  ParticleEmitter: {
    max: 4000, rate: 0, shape: EmitterSphere, radius: 0.05,
    direction: {0, 0, 0}, spread: 180,
    speed: {min: 26, max: 30},
    lifetime: {min: 1, max: 1},
    size: {min: 0.12, max: 0.18},
    opacity: {min: 0.14, max: 0.2},
    color: {140, 200, 255},
    seed: 62
  }
  ParticleBurst: {count: 600, at: 0.016, repeat: 2}
  ParticleAppearance: { shape: ParticleCircle, blend: ParticleAdditive }
}

stream {
  Position: {2, 0.4, 0}
  ParticleEmitter: {
    max: 4000, rate: 2400, shape: EmitterDisc, radius: 0.9,
    direction: {0, 1, 0}, spread: 16,
    speed: {min: 9, max: 16},
    lifetime: {min: 1, max: 1},
    size: {min: 0.22, max: 0.32},
    opacity: {min: 0.12, max: 0.18},
    color: {180, 255, 190},
    seed: 63
  }
  ParticlePlayback: {state: ParticlePlaying}
  ParticleAppearance: { shape: ParticleCircle, blend: ParticleAdditive }
}

halted {
  Position: {6, 0.4, 0}
  ParticleEmitter: {
    max: 4000, rate: 2400, shape: EmitterDisc, radius: 0.9,
    direction: {0, 1, 0}, spread: 16,
    speed: {min: 9, max: 16},
    lifetime: {min: 1, max: 1},
    size: {min: 0.22, max: 0.32},
    opacity: {min: 0.12, max: 0.18},
    color: {255, 160, 210},
    seed: 64
  }
  ParticlePlayback: {state: ParticleStopped}
  ParticleAppearance: { shape: ParticleCircle, blend: ParticleAdditive }
}

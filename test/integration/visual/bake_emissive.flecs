using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light

room {
  Scene: {}
  LightBake: {probe_spacing: 0.75, bounds_padding: 0}
  AmbientLight: {sky: {0, 0, 0}, ground: {0, 0, 0}, intensity: 0}

  camera {
    Position: {0, 2, 3.6}
    Rotation: {-0.25, 0, 0}
    Camera: {fov: 70}
  }

  darkness {
    DirectionalLight: {intensity: 0}
  }

  floor {
    Position: {0, -0.1, 0}
    Box: {8.4, 0.2, 8.4}
    Rgb: {210, 210, 210}
  }

  ceiling {
    Position: {0, 4.1, 0}
    Box: {8.4, 0.2, 8.4}
    Rgb: {210, 210, 210}
  }

  back {
    Position: {0, 2, -4.1}
    Box: {8.4, 4, 0.2}
    Rgb: {200, 200, 200}
  }

  front {
    Position: {0, 2, 4.1}
    Box: {8.4, 4, 0.2}
    Rgb: {200, 200, 200}
  }

  left {
    Position: {-4.1, 2, 0}
    Box: {0.2, 4, 8.4}
    Rgb: {220, 120, 100}
  }

  right {
    Position: {4.1, 2, 0}
    Box: {0.2, 4, 8.4}
    Rgb: {100, 140, 220}
  }

  lamp {
    Position: {0, 0.6, -1.5}
    Box: {1.2, 1.2, 1.2}
    Rgb: {255, 255, 255}
    Emissive: {strength: 6, color: {255, 210, 150}}
  }
}

main_view {
  View: {camera: room.camera, clear: {enabled: true, color: {0, 0, 0, 255}}}
}

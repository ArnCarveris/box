using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.layout
using box.text

$ {
  Scene: {blend_modes: true}
}

world_camera {
  Position: {0, 2.5, 7}
  Rotation: {-0.3, 0, 0}
  Camera: {fov: 55}
}

world_view {
  View: {camera: world_camera, clear: {enabled: true, color: {120, 150, 190, 255}}}
}

sun {
  Rotation: {0.7359, 2.3726, 0}
  DirectionalLight: {intensity: 2 * flecs.script.math.PI}
  Rgb: {255, 244, 225}
}

ground {
  Position: {0, -0.05, 0}
  Box: {24, 0.1, 24}
  Rgb: {140, 150, 125}
}

crate {
  Position: {-3.2, 0.5, 0}
  Rotation: {0, 0.4, 0}
  Box: {1, 1, 1}
  Rgb: {200, 150, 80}
}

ball {
  Position: {3.2, 0.6, -0.5}
  Sphere: {segments: 24, smooth: true, radius: 0.6}
  Rgb: {80, 140, 220}
}

hud {
  Scene: {blend_modes: true}

  camera {
    Position: {0, 0, 100}
    Camera: {ortho: true, ortho_scale: 1}
  }

  score {
    Position: {-230, 150, 0}
    Layout: {direction: Row, spacing: 8, padding: {6, 6, 10, 10}, v: Middle}
    Rect: {1, 1}
    Rgb: {16, 20, 28}
    Border: {radius: 8}

    label {
      Text: {value: "Score", size: 14}
      Rgb: {170, 180, 200}
    }

    value {
      Text: {value: "1250", size: 20}
      Rgb: {255, 220, 90}
    }
  }

  health {
    Position: {220, 150, 0}
    Rect: {160, 16}
    Rgb: {40, 44, 56}
    Border: {radius: 4}

    fill {
      Position: {-20, 0, 0}
      Rect: {116, 10}
      Rgb: {90, 210, 110}
      Border: {radius: 3}
    }
  }
}

hud_view {
  View: {camera: hud.camera, lighting: {enabled: false}, culling: {enabled: false}}
}

template Button {
  prop label: string = "Button"
  prop r: u8 = 60
  prop g: u8 = 70
  prop b: u8 = 96

  Layout: {direction: Row, padding: {8, 8, 12, 12}, h: Center, v: Middle}
  Item: {width: {mode: Grow}}
  Rect: {1, 1}
  Rgb: {r, g, b}
  Border: {radius: 8}

  text {
    Text: {value: label, size: 18}
    Rgb: {255, 255, 255}
  }
}

menu {
  Scene: {blend_modes: true}

  camera {
    Position: {0, 0, 100}
    Camera: {ortho: true, ortho_scale: 1}
  }

  dim {
    Position: {0, 0, 0}
    Rect: {640, 360}
    Rgb: {0, 0, 0}
    Opacity: {0.55}
  }

  panel {
    Position: {0, -10, 0}
    Layout: {direction: Column, spacing: 10, padding: {16, 16, 20, 20}, h: Center}
    Item: {width: {mode: Fixed, value: 240}}
    Rect: {1, 1}
    Rgb: {34, 38, 50}
    Border: {width: 2, radius: 14, color: {120, 140, 200, 255}}

    title {
      Text: {value: "Paused", size: 28}
      Rgb: {255, 255, 255}
    }

    resume {
      Button: {label: "Resume", r: 70, g: 150, b: 90}
    }

    settings {
      Button: {label: "Settings"}
    }

    quit {
      Button: {label: "Quit", r: 170, g: 70, b: 60}
    }
  }
}

menu_view {
  View: {camera: menu.camera, lighting: {enabled: false}, culling: {enabled: false}}
}

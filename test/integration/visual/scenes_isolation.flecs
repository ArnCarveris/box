using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light

warm {
  Scene: {}
  AmbientLight: {sky: {40, 30, 24}, ground: {20, 16, 12}, intensity: 0.5}

  camera {
    Position: {0, 4, 10}
    Rotation: {-0.35, 0, 0}
    Camera: {fov: 50}
  }

  lamp {
    Position: {0, 2.2, 1.5}
    PointLight: {intensity: 8, range: 9}
    Rgb: {255, 150, 60}
  }

  floor {
    Position: {0, -0.1, 0}
    Box: {16, 0.2, 10}
    Rgb: {220, 220, 220}
  }

  wall {
    Position: {0, 2, -3}
    Box: {16, 4, 0.2}
    Rgb: {220, 220, 220}
  }

  pillar_left {
    Position: {-3, 1, 0}
    Box: {1, 2, 1}
    Rgb: {230, 230, 230}
  }

  pillar_right {
    Position: {3, 1, 0}
    Box: {1, 2, 1}
    Rgb: {230, 230, 230}
  }

  moved {
    Position: {0, 0.7, 1.5}
    Sphere: {segments: 32, smooth: true, radius: 0.7}
    Rgb: {240, 240, 240}
  }
}

warm_view {
  View: {camera: warm.camera, clear: {enabled: true, color: {10, 10, 14, 255}}}
}

cool {
  Scene: {}
}

warm {
  moved {
    (ChildOf, cool)
  }
}

cool {
  AmbientLight: {sky: {20, 30, 50}, ground: {10, 12, 20}, intensity: 0.5}

  camera {
    Position: {0, 4, 10}
    Rotation: {-0.35, 0, 0}
    Camera: {fov: 50}
  }

  sun {
    Rotation: {0.662, 2.4293, 0}
    DirectionalLight: {intensity: 1.5}
    Rgb: {90, 150, 255}
  }

  ball_left {
    Position: {-3, 2.3, 0}
    Sphere: {segments: 32, smooth: true, radius: 0.7}
    Rgb: {240, 240, 240}
  }

  ball_right {
    Position: {3, 2.3, 0}
    Sphere: {segments: 32, smooth: true, radius: 0.7}
    Rgb: {240, 240, 240}
  }

  inner {
    Scene: {}

    camera {
      Position: {0, 4, 10}
      Rotation: {-0.35, 0, 0}
      Camera: {fov: 50}
    }

    glow {
      Position: {5, 3.4, 0.5}
      PointLight: {intensity: 6, range: 4}
      Rgb: {80, 255, 120}
    }

    cube {
      Position: {5, 2.8, -0.5}
      Rotation: {0.3754, 0.7649, 0.3384}
      Box: {1, 1, 1}
      Rgb: {240, 240, 240}
    }
  }
}

cool_view {
  View: {camera: cool.camera}
}

inner_view {
  View: {camera: cool.inner.camera}
}

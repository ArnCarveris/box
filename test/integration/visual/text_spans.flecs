using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.layout
using box.text

camera {
  Position: {0, 0, 100}
  Camera: {ortho: true, ortho_scale: 1}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {30, 32, 40, 255}}}
}

command {
  Position: {0, 110, 0}
  Text: {value: "spawn box.geometry.Box --size 2 --color red", size: 22}
  Rgb: {220, 220, 220}
  TextSpans: {spans: [
    {start: 0, end: 5, color: {250, 180, 60, 255}},
    {start: 6, end: 22, color: {120, 200, 250, 255}},
    {start: 23, end: 29, color: {160, 160, 160, 255}},
    {start: 30, end: 31, color: {200, 120, 250, 255}},
    {start: 32, end: 39, color: {160, 160, 160, 255}},
    {start: 40, end: 43, color: {250, 90, 90, 255}}
  ]}
}

label {
  Position: {0, 50, 0}
  Text: {value: "Score: 1250 (best 980)", size: 32}
  Rgb: {255, 255, 255}
  TextSpans: {spans: [
    {start: 7, end: 11, color: {90, 230, 120, 255}},
    {start: 13, end: 21, color: {255, 255, 255, 110}},
    {start: 18, end: 21, color: {250, 200, 60, 160}}
  ]}
}

paragraph {
  Position: {0, -70, 0}
  Text: {
    value: "Spans keep their colors when a paragraph wraps: red words, green words and blue words flow across the lines.",
    size: 20,
    width: 360,
    align: Center
  }
  Rgb: {230, 230, 230}
  TextSpans: {spans: [
    {start: 48, end: 57, color: {240, 80, 80, 255}},
    {start: 59, end: 70, color: {80, 220, 110, 255}},
    {start: 75, end: 85, color: {90, 150, 255, 255}},
    {start: -5, end: 5, color: {250, 200, 60, 255}},
    {start: 100, end: 500, color: {200, 120, 250, 255}}
  ]}
}

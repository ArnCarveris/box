using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light

// Sheen (Sheen) over dark rough cloth like bases, lit by a low sun from the side and behind the
// camera and by the environment sky.hdr, which the view also draws as its background. The top
// row of dark red balls has a white sheen of roughness 0.1, 0.3, 0.5, 0.75 and 1 from left to
// right: a thin bright rim at the silhouette that broadens toward the center. The middle row of
// dark gray balls has a sheen of roughness 0.5 and color black (none), pale gold, rose, teal and
// white: the rim takes the color of the sheen. Below, a deep blue velvet cushion, a fat torus
// tipped toward the camera, with a pale blue sheen, next to the same cushion without one, which
// stays a flat matte blue.
velvet {
  Scene: {}
  AmbientLight: {sky: {0, 0, 0}, ground: {0, 0, 0}, intensity: 0}

  sky {
    Environment: {resolution: 128}
    EnvironmentImage: {path: "test/assets/environments/sky.hdr"}
  }

  sun {
    Rotation: {0.45, 2.5, 0}
    DirectionalLight: {intensity: 3}
  }

  camera {
    Position: {0, 1.9, 6}
    Rotation: {-0.12, 0, 0}
    Camera: {fov: 55}
  }

  floor {
    Position: {0, -0.1, 0}
    Box: {14, 0.2, 10}
    Rgb: {60, 58, 56}
    PbrMaterial: {roughness: 0.9}
  }

  roughness_0 {
    Position: {-3, 3.1, 0}
    Sphere: {segments: 48, smooth: true, radius: 0.55}
    Rgb: {90, 12, 18}
    Sheen: {color: {255, 255, 255}, roughness: 0.1}
  }

  roughness_1 {
    Position: {-1.5, 3.1, 0}
    Sphere: {segments: 48, smooth: true, radius: 0.55}
    Rgb: {90, 12, 18}
    Sheen: {color: {255, 255, 255}, roughness: 0.3}
  }

  roughness_2 {
    Position: {0, 3.1, 0}
    Sphere: {segments: 48, smooth: true, radius: 0.55}
    Rgb: {90, 12, 18}
    Sheen: {color: {255, 255, 255}, roughness: 0.5}
  }

  roughness_3 {
    Position: {1.5, 3.1, 0}
    Sphere: {segments: 48, smooth: true, radius: 0.55}
    Rgb: {90, 12, 18}
    Sheen: {color: {255, 255, 255}, roughness: 0.75}
  }

  roughness_4 {
    Position: {3, 3.1, 0}
    Sphere: {segments: 48, smooth: true, radius: 0.55}
    Rgb: {90, 12, 18}
    Sheen: {color: {255, 255, 255}, roughness: 1}
  }

  color_0 {
    Position: {-3, 1.8, 0}
    Sphere: {segments: 48, smooth: true, radius: 0.55}
    Rgb: {40, 40, 44}
    Sheen: {color: {0, 0, 0}}
  }

  color_1 {
    Position: {-1.5, 1.8, 0}
    Sphere: {segments: 48, smooth: true, radius: 0.55}
    Rgb: {40, 40, 44}
    Sheen: {color: {255, 215, 120}}
  }

  color_2 {
    Position: {0, 1.8, 0}
    Sphere: {segments: 48, smooth: true, radius: 0.55}
    Rgb: {40, 40, 44}
    Sheen: {color: {255, 120, 170}}
  }

  color_3 {
    Position: {1.5, 1.8, 0}
    Sphere: {segments: 48, smooth: true, radius: 0.55}
    Rgb: {40, 40, 44}
    Sheen: {color: {90, 230, 210}}
  }

  color_4 {
    Position: {3, 1.8, 0}
    Sphere: {segments: 48, smooth: true, radius: 0.55}
    Rgb: {40, 40, 44}
    Sheen: {color: {255, 255, 255}}
  }

  velvet_cushion {
    Position: {-1.4, 0.35, 1.2}
    Rotation: {0.9, 0.2, 0}
    Torus: {segments: 64, rings: 32, smooth: true, radius: 0.45, tube: 0.3}
    Rgb: {20, 30, 110}
    Sheen: {color: {170, 190, 255}, roughness: 0.6}
  }

  plain_cushion {
    Position: {1.4, 0.35, 1.2}
    Rotation: {0.9, -0.2, 0}
    Torus: {segments: 64, rings: 32, smooth: true, radius: 0.45, tube: 0.3}
    Rgb: {20, 30, 110}
  }
}

velvet_view {
  View: {
    camera: velvet.camera,
    clear: {enabled: true, color: {0, 0, 0, 255}},
    lighting: {enabled: true, baked: true, reflections: true, atmosphere: true,
      environment: {source: velvet.sky, intensity: 1, yaw: 0, background: true}}
  }
}

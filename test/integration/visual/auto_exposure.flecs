// effects/exposure_tonemap
using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.effects

camera {
  Position: {0, 3.5, -11}
  LookAt: {0, 1, 0}
  Camera: {fov: 55}
}

sun {
  Rotation: {0.9, -0.6, 0}
  DirectionalLight: {intensity: 0.12}
}

$ { EnvironmentLight: {sky_color: {30, 36, 48}, ground_color: {18, 16, 14}, intensity: 0.1} }

floor {
  Position: {0, -0.5, 0}
  Box: {24, 0.2, 24}
  Rgb: {150, 150, 160}
  PbrMaterial: {roughness: 0.9}
}

wall {
  Position: {0, 3, 7}
  Box: {24, 7, 0.4}
  Rgb: {140, 132, 125}
  PbrMaterial: {roughness: 0.85}
}

crate {
  Position: {-4.5, 0.75, 0}
  Rotation: {0, 0.4, 0}
  Box: {1.6, 1.5, 1.6}
  Rgb: {210, 90, 70}
}

sphere {
  Position: {-1.5, 1, 0}
  Sphere: {segments: 32, smooth: true, radius: 1}
  Rgb: {90, 160, 235}
  PbrMaterial: {metallic: 0.2, roughness: 0.35}
}

cylinder {
  Position: {1.5, 0.9, 0}
  Cylinder: {segments: 24, smooth: true, length: 1.8, radius: 0.6}
  Rgb: {95, 200, 115}
}

cone {
  Position: {4.5, 0.85, 0}
  Cone: {segments: 24, smooth: true, length: 1.7, radius: 0.8}
  Rgb: {235, 195, 75}
}

pillar {
  Position: {-7, 1.6, 2}
  Box: {1, 3.4, 1}
  Rgb: {170, 170, 175}
  PbrMaterial: {roughness: 0.6}
}

lamp {
  Position: {7, 1.4, 2}
  Sphere: {segments: 16, smooth: true, radius: 0.4}
  Rgb: {30, 30, 30}
  Emissive: {strength: 1.5, color: {255, 190, 120}}
}

post_effects { auto_exposure : box.effects.auto_exposure {
  AutoExposure: {speed_up: 400, speed_down: 400, min_ev: -4, max_ev: 6, target: 0.25}
} }
view { box.view.View: {camera: camera, effects: [{effect: post_effects.auto_exposure, enabled: true}]} }

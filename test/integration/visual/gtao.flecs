// effects/gtao
using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.effects

camera {
  Position: {6.5, 4, -7}
  LookAt: {-0.8, 1.2, 1.2}
  Camera: {fov: 50}
}

sun {
  Rotation: {0.9, -0.5, 0}
  DirectionalLight: {intensity: 0.45}
}

$ { EnvironmentLight: {sky_color: {130, 150, 185}, ground_color: {80, 70, 60}, intensity: 1.1} }

floor {
  Position: {0, -0.1, 0}
  Box: {16, 0.2, 16}
  Rgb: {160, 158, 152}
  PbrMaterial: {roughness: 0.95}
}

wall_left {
  Position: {-5, 3, 0}
  Box: {0.3, 6, 16}
  Rgb: {155, 150, 142}
  PbrMaterial: {roughness: 0.95}
}

wall_back {
  Position: {0, 3, 5}
  Box: {16, 6, 0.3}
  Rgb: {150, 152, 156}
  PbrMaterial: {roughness: 0.95}
}

crate_a {
  Position: {-3.4, 0.9, 3.2}
  Rotation: {0, 0.25, 0}
  Box: {1.8, 1.8, 1.8}
  Rgb: {175, 100, 78}
  PbrMaterial: {roughness: 0.8}
}

crate_b {
  Position: {-3.4, 2.5, 3.2}
  Rotation: {0, 0.6, 0}
  Box: {1.3, 1.3, 1.3}
  Rgb: {120, 140, 175}
  PbrMaterial: {roughness: 0.8}
}

crate_c {
  Position: {-1.2, 0.6, 4.1}
  Box: {1.2, 1.2, 1.2}
  Rgb: {140, 155, 110}
  PbrMaterial: {roughness: 0.85}
}

ball_a {
  Position: {0.6, 0.9, 2.4}
  Sphere: {segments: 32, smooth: true, radius: 0.9}
  Rgb: {175, 168, 150}
  PbrMaterial: {roughness: 0.7}
}

ball_b {
  Position: {2.2, 0.55, 0.9}
  Sphere: {segments: 32, smooth: true, radius: 0.55}
  Rgb: {150, 145, 180}
  PbrMaterial: {roughness: 0.6}
}

ball_c {
  Position: {-2.2, 0.7, 0.4}
  Sphere: {segments: 32, smooth: true, radius: 0.7}
  Rgb: {180, 170, 130}
  PbrMaterial: {roughness: 0.75}
}

pillar {
  Position: {-4.1, 1.6, -2.2}
  Box: {0.9, 3.2, 0.9}
  Rgb: {155, 155, 158}
  PbrMaterial: {roughness: 0.9}
}

box { effects { stack {
  gtao {
    Effect: {enabled: true}
    Gtao: {radius: 2.5, slices: 4, steps: 10, power: 2, temporal: true, half_res: true}
  }
  tonemap {
    Effect: {enabled: true}
    ToneMapping: {white: 1, dither: true}
  }
} } }

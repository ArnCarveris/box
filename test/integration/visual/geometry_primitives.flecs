using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.surface
using box.controllers

window {
    Surface: {width: 960, height: 600, write_to_file: "geometry-primitives.png"}
}

camera {
    Position: {9, 8, 15}
    Rotation: {-0.38, 0.54, 0}
    Camera: {fov: 48}
    CameraController: {}
}

main_view {
    View: {
        camera: camera,
        clear: {enabled: true, color: {28, 34, 45, 255}},
        shadows: {enabled: true}
    }
}

sun {
    Rotation: {0.7, 2.4, 0}
    DirectionalLight: {intensity: 2 * flecs.script.math.PI}
}

$ {
    AmbientLight: {sky: {150, 175, 210}, ground: {65, 60, 55}, intensity: 0.7}
}

floor {
    Position: {0, -0.25, 0}
    Box: {13, 0.2, 9}
    Rgb: {70, 77, 90}
}


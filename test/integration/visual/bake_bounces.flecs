three {
  Scene: {baked: true}
  Bake: {probe_spacing: 0.5, bounds_padding: -0.5, bounces: 3}
  AmbientLight: {sky: {0, 0, 0}, ground: {0, 0, 0}, intensity: 0}

  camera {
    Position: {0, 14.5, 3.19}
    Rotation: {-1.35, 0, 0}
    Camera: {fov: 50}
  }

  darkness {
    DirectionalLight: {intensity: 0}
  }

  ceiling {
    Position: {0, 2.4, 3.4}
    Rotation: {1.5708, 0, 0}
    Quad: {6.4, 2.8}
    Rgb: {250, 250, 250}
  }

  floor {
    Position: {0, -0.1, 3.4}
    Box: {6.4, 0.2, 2.8}
    Rgb: {250, 250, 250}
  }

  near_wall {
    Position: {0, 1.2, 4.7}
    Box: {6.4, 2.4, 0.2}
    Rgb: {250, 250, 250}
  }

  far_wall {
    Position: {0, 1.2, 2.1}
    Box: {6.4, 2.4, 0.2}
    Rgb: {250, 250, 250}
  }

  end_wall {
    Position: {3.1, 1.2, 3.4}

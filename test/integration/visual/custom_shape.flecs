using box.transform
using box.geometry
using box.material
using box.camera
using box.light

camera {
  Position: {0, 2.6, -13}
  LookAt: {0, 2.6, 0}
  Camera: {fov: 50}
}

sun {
  Rotation: {0.5, -0.6, 0}
  DirectionalLight: {intensity: 2.2}
}

$ { EnvironmentLight: {sky_color: {120, 135, 165}, ground_color: {70, 68, 64}, intensity: 0.85} }

ground {
  Position: {0, -0.25, 0}
  Box: {40, 0.5, 40}
  Rgb: {120, 120, 125}

using box.transform
using box.geometry
using box.material
using box.texture
using box.camera
using box.view
using box.light

$ {
  Scene: {cookies: true}
}

// Cloud shadows: the sun carries a LightCookie of the seamless fbm noise (CookieNoise, the
// 256 texel copy of the tests, loaded single_channel so its stored values are read), projected
// along the sun onto a plane 30 units up and repeating every 60 units. Threshold 0.4 and
// softness 0.12 leave a few soft edged clouds in view, drifting with a slow wind. The cookie
// scales only the direct sunlight, so the shadowed ground and the sides of the shapes away from
// the sun keep their ambient light.

camera {
  Position: {0, 9, 22}
  Rotation: {-0.42, 0, 0}
  Camera: {fov: 55}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {130, 170, 215, 255}}, shadows: {enabled: true}}
}

$ {
  AmbientLight: {sky: {120, 140, 170}, ground: {70, 66, 60}, intensity: 0.8}
}

clouds {
  TexturePath: {path: "test/assets/textures/cloud_noise_256.png", single_channel: true}
}

sun {
  Rotation: {0.85, 0.5, 0}
  DirectionalLight: {intensity: 1.6 * flecs.script.math.PI}
  Rgb: {255, 244, 228}
  LightCookie: {texture: clouds, size: 60, height: 30, threshold: 0.4, softness: 0.12, velocity: {1.5, 0.5}}
}

ground {
  Position: {0, -0.1, 0}
  Box: {80, 0.2, 80}
  Rgb: {150, 168, 120}
}

ball {
  Position: {-4, 1.2, 2}
  Sphere: {segments: 32, smooth: true, radius: 1.2}
  Rgb: {230, 230, 230}
}

block {
  Position: {1, 1, -1}
  Rotation: {0, 0.5, 0}
  Box: {2, 2, 2}
  Rgb: {200, 96, 72}
}

tower {
  Position: {6, 2, -6}
  Box: {1.5, 4, 1.5}
  Rgb: {210, 205, 190}
}

slab {
  Position: {-8, 0.4, -8}
  Box: {5, 0.8, 3}
  Rgb: {120, 130, 160}
}

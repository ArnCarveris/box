using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.atmosphere

tonemap {
  Tonemap: {}
}

camera {
  Position: {0, 2, 12}
  Rotation: {0.2, 0, 0}
  Camera: {fov: 60, far_: 0}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {0, 0, 0, 255}}, shadows: {enabled: true}, effects: [{effect: tonemap}]}
}

sun {
  Rotation: {3.5779, 0.5, 0}
  DirectionalLight: {intensity: 6}
  Rgb: {255, 255, 255}
}

moon {
  Rotation: {0.4363, 0.5, 0}
  DirectionalLight: {intensity: 1.5}
  Rgb: {255, 255, 255}
}

// A night with the sun 25 degrees below the horizon behind the camera and the full moon 25
// degrees up ahead of it and 29 degrees off to the side, opposite the sun. The moon radius is
// enlarged so the disk is 18 pixels across a 360 high frame.
$ {
  Atmosphere: {units_per_km: 100, sun: sun, moon: moon, moon_radius: 1.5, moon_disk_intensity: 6}
}

ground {
  Position: {0, -0.1, -40}
  Box: {120, 0.2, 120}
  Rgb: {110, 130, 90}
  PbrMaterial: {roughness: 0.9}
}

column {
  Position: {-3, 1.5, 0}
  Box: {1, 3, 1}
  Rgb: {220, 220, 220}
}

ball {
  Position: {2.5, 1, 2}
  Sphere: {segments: 32, smooth: true, radius: 1}
  Rgb: {200, 80, 60}
}

crate {
  Position: {0.5, 0.75, -4}
  Box: {1.5, 1.5, 1.5}
  Rgb: {80, 140, 210}
}

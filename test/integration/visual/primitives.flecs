using box.transform
using box.geometry
using box.material
using box.camera
using box.view

camera {
  Position: {0, 5, 10}
  Rotation: {-0.42, 0, 0}
  Camera: {fov: 50}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {38, 44, 56, 255}}}
}

floor {
  Position: {0, -0.1, 0}
  Box: {16, 0.2, 8}
  Rgb: {150, 150, 160}
}

box {
  Position: {-6, 0.6, -2}
  Rotation: {0, 0.5, 0}
  Box: {1.2, 1.2, 1.2}
  Rgb: {220, 80, 60}
}

rounded_box {
  Position: {-4, 0.6, -2}
  Rotation: {0, 0.5, 0}
  RoundedBox: {1.3, 1.2, 1.3, radius: 0.3, segments: 4}
  Rgb: {250, 120, 160}
}

triangle_prism {
  Position: {-2, 0.6, -2}
  Rotation: {0, 0.4, 0}
  TrianglePrism: {1.4, 1.2, 1}
  Rgb: {120, 220, 160}
}

right_triangle_prism {
  Position: {0, 0.6, -2}
  Rotation: {0, 0.4, 0}
  RightTrianglePrism: {1.4, 1.2, 1}
  Rgb: {90, 200, 230}
}

sphere {
  Position: {2, 0.7, -2}
  Sphere: {segments: 32, smooth: true, radius: 0.7}
  Rgb: {80, 160, 240}
}

hemisphere {
  Position: {3, 0, 2}
  HemiSphere: {segments: 24, smooth: true, radius: 0.8}
  Rgb: {240, 200, 140}
}

icosphere {
  Position: {4, 0.7, -2}
  IcoSphere: {segments: 1, smooth: false, radius: 0.7}
  Rgb: {60, 200, 200}
}

cone {
  Position: {-5, 0.7, 2}
  Cone: {segments: 24, smooth: true, length: 1.4, radius: 0.7}
  Rgb: {250, 200, 60}
}

cylinder {
  Position: {-3, 0.7, 2}
  Cylinder: {segments: 24, smooth: true, length: 1.4, radius: 0.6}
  Rgb: {90, 200, 110}
}

frustum {
  Position: {-1, 0.7, 2}
  Frustum: {segments: 24, smooth: true, length: 1.4, radius_bottom: 0.7, radius_top: 0.3}
  Rgb: {140, 140, 240}
}

tube {
  Position: {1, 0.7, 2}
  Tube: {segments: 32, smooth: true, length: 1.4, radius: 0.7, thickness: 0.2}
  Rgb: {230, 140, 80}
}

capsule {
  Position: {6, 0.9, -2}
  Capsule: {segments: 16, smooth: true, length: 0.8, radius: 0.5}
  Rgb: {240, 240, 240}
}

torus {
  Position: {5, 0.7, 2}
  Rotation: {1.1, 0, 0}
  Torus: {segments: 32, rings: 16, smooth: true, radius: 0.6, tube: 0.22}
  Rgb: {200, 100, 220}
}

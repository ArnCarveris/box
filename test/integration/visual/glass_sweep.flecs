using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.texture

$ {
  EnvironmentLight: {sky_color: {110, 140, 190}, ground_color: {70, 62, 55}, intensity: 0.6}
}

textures {
  checker {
    Texture: {path: "etc/textures/checker.png"}
  }
}

camera {
  Position: {0, 1.8, -13}
  LookAt: {0, 1.8, 0}
  Camera: {fov: 55}
}

sun {
  Rotation: {0.85, -0.5, 0}
  DirectionalLight: {intensity: 1}
}

floor {
  Position: {0, -0.6, 0}
  Box: {40, 0.2, 24}
  Rgb: {210, 210, 215}
  PbrMaterial: {roughness: 0.8}
  PbrTextures: {albedo: textures.checker}
  TextureTiling: {meters_x: 1, meters_y: 1}
}


using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light

camera {
  Position: {0, 9, 13}
  Rotation: {-0.6, 0, 0}
  Camera: {fov: 50}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {6, 6, 10, 255}}}
}

$ {
  AmbientLight: {intensity: 0.05}
}

floor {
  Position: {0, -0.1, 0}
  Box: {22, 0.2, 22}
  Rgb: {210, 210, 210}
}

for x in 0..5 {
  for z in 0..5 {
    {
      Position: {x * 4 - 8, 0.75, z * 4 - 8}
      Box: {0.6, 1.5, 0.6}
      Rgb: {230, 230, 230}
    }
  }
}

for x in 0..20 {
  for z in 0..20 {
    {
      Position: {x - 9.5, 0.4, z - 9.5}
      PointLight: {intensity: 0.15, range: 1.6}
      Rgb: {60 + (x % 4) * 60, 240 - (z % 4) * 60, 120 + ((x + z) % 3) * 60}
    }
  }
}

using box.transform
using box.geometry
using box.material
using box.camera
using box.view

world_camera {
  Position: {0, 4, 10}
  Rotation: {-0.35, 0, 0}
  Camera: {fov: 50}
}

world_view {
  View: {camera: world_camera, clear: {enabled: true, color: {30, 40, 70, 255}}}
}

floor {
  Position: {0, -0.1, 0}
  Box: {16, 0.2, 10}
  Rgb: {120, 128, 110}
}

wall {
  Position: {0, 1.5, -3}
  Box: {10, 3, 0.4}
  Rgb: {200, 190, 170}
}

column_0 {
  Position: {-3, 1, 0}
  Cylinder: {segments: 24, smooth: true, length: 2, radius: 0.5}
  Rgb: {220, 80, 60}
}

column_1 {
  Position: {0, 1, 0}
  Cylinder: {segments: 24, smooth: true, length: 2, radius: 0.5}
  Rgb: {90, 200, 110}
}

column_2 {
  Position: {3, 1, 0}
  Cylinder: {segments: 24, smooth: true, length: 2, radius: 0.5}
  Rgb: {80, 160, 240}
}

overlay {
  Scene: {}

  overlay_camera {
    Position: {0, 0, 6}
    Camera: {fov: 40}
  }

  marker_box {
    Position: {-1.6, -0.6, 0}
    Rotation: {0.3754, 0.7649, 0.3384}
    Box: {1, 1, 1}
    Rgb: {250, 200, 60}
  }

  marker_ball {
    Position: {0, -0.5, -40}
    Sphere: {segments: 32, smooth: true, radius: 2}
    Rgb: {250, 120, 200}
  }

  marker_ring {
    Position: {1.6, -0.6, 0}
    Rotation: {1.2, 0, 0}
    Torus: {segments: 32, rings: 16, smooth: true, radius: 0.5, tube: 0.18}
    Rgb: {60, 220, 220}
  }
}

overlay_view {
  View: {camera: overlay.overlay_camera}
}

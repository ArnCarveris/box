using box.transform
using box.geometry
using box.material
using box.texture
using box.camera
using box.view
using box.light

$ {
  Scene: {shader_features: {Extended: {triplanar: true}}}
}

// World space and triplanar texture mapping (texture.Mapping MappingWorld and blend).
// On the left a 6 x 6 board of touching tiles like the castle board, every other one turned by
// 90 degrees around y, with one grass-like texture projected from the world position
// (MappingWorld) and normal mapped with the bumps: the grass and the bumps run across the tiles
// with no seam. On the right, from back to front: a sphere and a cone with a triplanar blend
// (blend 0.5), which have no hard seams where the axis of the projection changes, and the same
// sphere with blend 0, whose projection changes axis with a hard seam.

camera {
  Position: {0, 7.5, 9}
  Rotation: {-0.7, 0, 0}
  Camera: {fov: 50}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {120, 160, 210, 255}}, shadows: {enabled: true}}
}

$ {
  AmbientLight: {sky: {150, 170, 200}, ground: {70, 64, 56}, intensity: 0.5}
}

sun {
  Rotation: {0.8, 0.5, 0}
  DirectionalLight: {intensity: 1.4 * flecs.script.math.PI}
  Rgb: {255, 245, 230}
}

grass_height {
  Gen: {
    width: 256, height: 256, seed: 7
    layers: [
      {kind: GenNoise, frequency: 24, octaves: 4, amount: 0.7}
      {kind: GenNoise, frequency: 4, octaves: 3, amount: 0.3, seed: 3}
    ]
  }
}

grass {
  Gen: {source: grass_height, output: GenAlbedo,
               colors: [{0, {44, 82, 30}}, {0.5, {82, 132, 48}}, {1, {150, 186, 82}}]}
}

bumps {
  Path: {path: "test/integration/visual/assets/bumps.png"}
}

checker {
  Path: {path: "test/integration/visual/assets/checker.png"}
}

floor {
  Position: {0, -0.6, 0}
  Box: {24, 0.2, 16}
  Rgb: {90, 94, 104}
  PbrMaterial: {roughness: 0.9}
}

board {
  Position: {-3.6, 0, 0}

  for row in 0..6 {
    for col in 0..6 {
      {
        Position: {col * 1.2 - 3, -0.25, row * 1.2 - 3}
        Rotation: {0, ((row + col) % 2) * 0.5 * flecs.script.math.PI, 0}
        Box: {1.2, 0.5, 1.2}
        Rgb: {255, 255, 255}
        PbrMaterial: {roughness: 0.9}
        PbrTextures: {albedo: grass, normal: bumps}
        texture.Mapping: {mode: MappingWorld, size: 1.7}
      }
    }
  }
}

sphere_blend {
  Position: {2.6, 0.9, -2.4}
  Sphere: {radius: 0.9, smooth: true, segments: 48}
  Rgb: {255, 255, 255}
  PbrMaterial: {roughness: 0.6}
  PbrTextures: {albedo: checker, normal: bumps}
  texture.Mapping: {mode: MappingWorld, size: 0.9, blend: 0.5}
}

cone_blend {
  Position: {5.2, 0.9, -1.2}
  Cone: {radius: 0.9, length: 1.8, smooth: true, segments: 48}
  Rgb: {255, 255, 255}
  PbrMaterial: {roughness: 0.6}
  PbrTextures: {albedo: checker, normal: bumps}
  texture.Mapping: {mode: MappingWorld, size: 0.9, blend: 0.5}
}

sphere_hard {
  Position: {2.6, 0.9, 1.4}
  Sphere: {radius: 0.9, smooth: true, segments: 48}
  Rgb: {255, 255, 255}
  PbrMaterial: {roughness: 0.6}
  PbrTextures: {albedo: checker, normal: bumps}
  texture.Mapping: {mode: MappingWorld, size: 0.9}
}

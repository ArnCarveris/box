using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.atmosphere

// A planet lit from the side: the haze over the day side thickens toward the limb, the glow of
// the limb fades out past the terminator and the night side is dark.

camera {
  Position: {0, 0, 3.6}
  Camera: {fov: 60}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {0, 0, 0, 255}}}
}

sun {
  Rotation: {-0.2, -2.0, 0}
  DirectionalLight: {intensity: 6}
  Rgb: {255, 255, 255}
}

planet {
  Position: {0, 0, 0}
  Sphere: {segments: 96, smooth: true, radius: 1}
  Rgb: {90, 110, 80}
  PbrMaterial: {roughness: 0.9}
  PlanetAtmosphere: {sun: sun, radius: 1, planet_radius: 1000, thickness: 100}
}

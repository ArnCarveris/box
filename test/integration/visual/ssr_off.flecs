// effects/ssr
using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.effects

camera {
  Position: {0, 1.3, -9}
  LookAt: {0, 1.1, 1}
  Camera: {fov: 52}
}

sun {
  Rotation: {1.0, -0.7, 0}
  DirectionalLight: {intensity: 1.2}
}

$ { EnvironmentLight: {sky_color: {70, 100, 160}, ground_color: {40, 34, 28}, intensity: 1.4} }

floor {
  Position: {0, -0.05, 0}
  Box: {40, 0.1, 40}
  Rgb: {36, 38, 44}
  PbrMaterial: {roughness: 0.08, metallic: 0.1}
}

red {
  Position: {-3.4, 1, 1.5}
  Box: {1.6, 2, 1.6}
  Rgb: {220, 70, 55}
  PbrMaterial: {roughness: 0.55}
}

green {
  Position: {-1.1, 0.7, 0.2}
  Box: {1.2, 1.4, 1.2}
  Rgb: {80, 205, 110}
  PbrMaterial: {roughness: 0.5}
}

yellow {
  Position: {1.3, 1.3, 1.2}
  Box: {1.4, 2.6, 1.4}
  Rgb: {245, 205, 70}
  PbrMaterial: {roughness: 0.45}
}

blue {
  Position: {3.6, 0.9, 0}
  Box: {1.5, 1.8, 1.5}
  Rgb: {70, 120, 235}
  PbrMaterial: {roughness: 0.5}
}

lamp {
  Position: {0.1, 2.4, 3.2}
  Sphere: {segments: 24, smooth: true, radius: 0.45}
  Rgb: {20, 20, 20}
  Emissive: {strength: 6, color: {255, 200, 140}}
}

sphere {
  Position: {5.6, 1.1, 2.6}
  Sphere: {segments: 32, smooth: true, radius: 1.1}
  Rgb: {200, 200, 210}
  PbrMaterial: {roughness: 0.15, metallic: 0.9}
}

post_effects {
  ssr : box.effects.ssr {
    Ssr: {steps: 32, thickness: 0.5, max_roughness: 0.6, intensity: 1, fade: 0.12}
  }
  tonemap : box.effects.tonemap {
    ToneMapping: {white: 1, dither: true}
  }
}
view { box.view.View: {camera: camera, effects: [
  {effect: post_effects.ssr, enabled: false},
  {effect: post_effects.tonemap, enabled: true}
]} }

using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light

zero {
  Scene: {}
  LightBake: {probe_spacing: 0.5, bounds_padding: -0.5, bounces: 0}
  AmbientLight: {sky: {0, 0, 0}, ground: {0, 0, 0}, intensity: 0}

  camera {
    Position: {0, 4.6, 19}
    Rotation: {-0.14, 0, 0}
    Camera: {fov: 28}
  }

  darkness {
    DirectionalLight: {intensity: 0}
  }

  opening {
    Position: {-5, 2, 2}
    Rotation: {0, 3.1416, 0}
    Quad: {4.4, 4.4}
    Rgb: {235, 235, 230}
  }

  floor {
    Position: {-5, -0.1, 0}
    Box: {4.4, 0.2, 4.4}
    Rgb: {235, 235, 230}
  }

  ceiling {
    Position: {-5, 4.1, 0}
    Box: {4.4, 0.2, 4.4}
    Rgb: {235, 235, 230}
  }

  back {
    Position: {-5, 2, -2.1}
    Box: {4.4, 4, 0.2}
    Rgb: {235, 235, 230}
  }

  red_wall {
    Position: {-7.1, 2, 0}
    Box: {0.2, 4, 4}
    Rgb: {210, 30, 25}
  }

  green_wall {
    Position: {-2.9, 2, 0}
    Box: {0.2, 4, 4}
    Rgb: {30, 200, 40}
  }

  tall_block {
    Position: {-5.7, 0.65, -0.6}
    Rotation: {0, 0.3, 0}
    Box: {1.1, 1.3, 1.1}
    Rgb: {235, 235, 230}
  }

  short_block {
    Position: {-4.25, 0.35, 0.6}
    Rotation: {0, -0.3, 0}
    Box: {1.1, 0.7, 1.1}
    Rgb: {235, 235, 230}
  }

  lamp {
    Position: {-5, 3.98, 0}
    Box: {0.6, 0.04, 0.6}
    Rgb: {255, 255, 255}
    Emissive: {strength: 0.9, color: {255, 255, 255}}
  }

  spot {
    Position: {-5, 3.9, 0}
    Rotation: {1.5708, 0, 0}
    SpotLight: {intensity: 8, range: 10, inner_angle: 15, outer_angle: 25}
    Rgb: {255, 255, 255}
  }
}


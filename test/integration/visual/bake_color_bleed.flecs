zero_texture {}

zero_views {
  view {
    View: {camera: zero.camera, clear: {enabled: true, color: {0, 0, 0, 255}}, effects: [{effect: tonemap}]}
  }
}

zero_surface {
  Surface: {width: 204, height: 204, texture: zero_texture, view_root: zero_views}
}

one_texture {}

one_views {
  view {
    View: {camera: one.camera, clear: {enabled: true, color: {0, 0, 0, 255}}, effects: [{effect: tonemap}]}
  }
}

one_surface {
  Surface: {width: 204, height: 204, texture: one_texture, view_root: one_views}
}

three_texture {}

three_views {
  view {
    View: {camera: three.camera, clear: {enabled: true, color: {0, 0, 0, 255}}, effects: [{effect: tonemap}]}
  }
}

three_surface {
  Surface: {width: 204, height: 204, texture: three_texture, view_root: three_views}
}

gallery {
  Scene: {baked: true}

  camera {
    Position: {0, 0, 100}
    Camera: {ortho: true, ortho_scale: 1}
  }

  zero_tile {
    Position: {-212, 20, 0}
    Quad: {204, 204}
    Rgb: {0, 0, 0}
    Emissive: {strength: 1, color: {255, 255, 255}}
    PbrTextures: {albedo: zero_texture, emissive: zero_texture}
  }

  zero_label {
    Position: {-212, -104, 0}
    Text: {value: "bounces: 0", size: 18, align: Center}
    Rgb: {200, 200, 200}
  }

  one_tile {
    Position: {0, 20, 0}
    Quad: {204, 204}
    Rgb: {0, 0, 0}
    Emissive: {strength: 1, color: {255, 255, 255}}
    PbrTextures: {albedo: one_texture, emissive: one_texture}
  }

  one_label {
    Position: {0, -104, 0}
    Text: {value: "bounces: 1", size: 18, align: Center}
    Rgb: {200, 200, 200}
  }

  three_tile {
    Position: {212, 20, 0}
    Quad: {204, 204}
    Rgb: {0, 0, 0}
    Emissive: {strength: 1, color: {255, 255, 255}}
    PbrTextures: {albedo: three_texture, emissive: three_texture}
  }

  three_label {
    Position: {212, -104, 0}
    Text: {value: "bounces: 3", size: 18, align: Center}
    Rgb: {200, 200, 200}
  }
}

gallery_view {
  View: {camera: gallery.camera, clear: {enabled: true, color: {0, 0, 0, 255}}, lighting: {enabled: false}}
}

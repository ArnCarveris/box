using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.perf

// The worst case of Polygon2D: 12 overlapping polygons of 512 curved edges each, a ring with a
// hole, each covering most of the view, so every pixel lies over 6,000 edges (a quarter of them
// blended over others), of which it tests the chunks of 14 near it and those its ray crosses. It
// bounds the edges and the screen area a map can spend on polygons.
camera {
  Camera: {fov: 50}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {24, 28, 38, 255}}}
}

star_outer {
  Path2D: {start: {10, 0}, closed: true, segments: [
    {kind: CatmullRom, end: {6.467, 2.679}},
    {kind: CatmullRom, end: {7.071, 7.071}},
    {kind: CatmullRom, end: {2.679, 6.467}},
    {kind: CatmullRom, end: {0.000, 10.000}},
    {kind: CatmullRom, end: {-2.679, 6.467}},
    {kind: CatmullRom, end: {-7.071, 7.071}},
    {kind: CatmullRom, end: {-6.467, 2.679}},
    {kind: CatmullRom, end: {-10.000, 0.000}},
    {kind: CatmullRom, end: {-6.467, -2.679}},
    {kind: CatmullRom, end: {-7.071, -7.071}},
    {kind: CatmullRom, end: {-2.679, -6.467}},
    {kind: CatmullRom, end: {-0.000, -10.000}},
    {kind: CatmullRom, end: {2.679, -6.467}},
    {kind: CatmullRom, end: {7.071, -7.071}},
    {kind: CatmullRom, end: {6.467, -2.679}}
  ]}
}

star_hole {
  Path2D: {start: {3, 0}, closed: true, segments: [
    {kind: CatmullRom, end: {2.772, 1.148}},
    {kind: CatmullRom, end: {2.121, 2.121}},
    {kind: CatmullRom, end: {1.148, 2.772}},
    {kind: CatmullRom, end: {0.000, 3.000}},
    {kind: CatmullRom, end: {-1.148, 2.772}},
    {kind: CatmullRom, end: {-2.121, 2.121}},
    {kind: CatmullRom, end: {-2.772, 1.148}},
    {kind: CatmullRom, end: {-3.000, 0.000}},
    {kind: CatmullRom, end: {-2.772, -1.148}},
    {kind: CatmullRom, end: {-2.121, -2.121}},
    {kind: CatmullRom, end: {-1.148, -2.772}},
    {kind: CatmullRom, end: {-0.000, -3.000}},
    {kind: CatmullRom, end: {1.148, -2.772}},
    {kind: CatmullRom, end: {2.121, -2.121}},
    {kind: CatmullRom, end: {2.772, -1.148}}
  ]}
}

ring { Profile2D: {outer: star_outer, holes: [star_hole]} }

shapes {
  Position: {0, 0.01, 0}
  Rotation: {-1.5708, 0, 0}

  for i in 0..12 {
    "s_{i}" {
      Position: {0, 0, i * 0.01}
      Rotation: {0, 0, i * 0.26}
      Polygon2D: {path: ring, scale: {1 + i * 0.05, 1 + i * 0.05}}
      Rgb: {90 + i * 12, 160, 250 - i * 12}
      Opacity: {0.6}
      Border: {width: 0.2, color: {255, 255, 255, 255}}
    }
  }
}

$ {
  PerfRun: {fps: 60, frames: 300, warmup: 60, period: 5, elevation: 60, camera: camera}
}

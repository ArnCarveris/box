using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.perf

camera {
  Camera: {fov: 50}

  // A narrow lens turned away from the center: as the camera orbits, its view sweeps a ring
  // around the center, so boxes enter and leave the frustum every frame.
  eye {
    Position: {0, 0, 0}
    Rotation: {0.12, 0.22, 0}
    Camera: {fov: 12}
  }
}

main_view {
  View: {camera: camera.eye, clear: {enabled: true, color: {24, 28, 36, 255}}}
}

floor {
  Position: {0, -0.1, 0}
  Box: {204, 0.2, 129}
  Rgb: {90, 96, 104}
}

for x in 0..400 {
  for z in 0..250 {
    {
      Position: {x * 0.5 - 99.75, 0.3 + (x % 5) * 0.1, z * 0.5 - 62.25}
      Box: {0.35, 0.6 + (x % 5) * 0.2, 0.35}
      Rgb: {40 + (x % 50) * 4, 80 + (z % 25) * 6, 220 - (x % 50) * 3}
    }
  }
}

$ {
  PerfRun: {fps: 120, frames: 600, warmup: 120, period: 5, elevation: 30, camera: camera}
}

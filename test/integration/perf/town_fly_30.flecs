// The town of etc/scenes/town.flecs at 30 FPS for a minute, flown by its CameraController with
// synthetic input (forward and turning left held, boost toggled every 2 s), in the retina window
// of that scene (1280x720 points, 2560x1440 pixels) presenting to a simulated 120 Hz vsync
// display, each frame shown for 4 refreshes.

include town_content

using box.transform
using box.camera
using box.view
using box.effects
using box.surface
using box.perf
using box.controllers

perf_surface {
  Surface: {width: 1280, height: 720, pixel_ratio: 2}
}

ssao {
  Ssao: {radius: 2.5, bias: 0.025, intensity: 1}
}

tonemap {
  Tonemap: {}
}

camera {
  Position: {-12.8, 9.455, 25.806}
  Rotation: {-0.4219, -0.4942, 0}
  Camera: {fov: 55, near_: 0.1}
  CameraController: {speed: 14, boost: 4, sensitivity: 0.003}
}

view {
  View: {camera: camera, clear: {enabled: true, color: {150, 178, 210, 255}}, lighting: {enabled: true}, shadows: {enabled: true, cascades: 4, resolution: 2048, max_distance: 200, split_lambda: 0.7, depth_bias: 2, normal_offset: 1.5, filter_size: 3, fade: 0.2}, culling: {enabled: true, occlusion: true, min_dimension_px: 4}, effects: [{enabled: true, effect: ssao}, {enabled: true, effect: tonemap}]}
}

$ {
  PerfRun: {fps: 30, frames: 1800, warmup: 30, period: 0, elevation: 30, camera: camera, refresh: 120, fly: true}
}

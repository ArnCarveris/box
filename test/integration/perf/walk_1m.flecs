using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.input
using box.controllers
using box.perf

// The walk holds Forward and turns by a fixed Look delta every frame: actions that are
// disabled keep the ActionState the scene gives them, as no binding resolves them.
walk {
  Forward {
    ActionState: {down: true}
    flecs.core.Disabled
  }

  Look {
    ActionState: {down: true, delta: {2, 0}}
    flecs.core.Disabled
  }
}

player {
  Position: {0.75, 1.7, 0.75}
  Camera: {fov: 70}
  FirstPersonController: {actions: walk}
}

orbit {
  Position: {0, 0, 0}
}

main_view {
  View: {camera: player, clear: {enabled: true, color: {24, 28, 36, 255}}}
}

floor {
  Position: {0, -0.1, 0}
  Box: {1504, 0.2, 1504}
  Rgb: {90, 96, 104}
}

// Named entities: anonymous ones in a for loop are tracked in a list flecs searches linearly.
for x in 0..500 {
  for z in 0..500 {
    "b_{x}_{z}" {
      Position: {x * 3 - 750, 0.125 + (x % 8) * 0.125, z * 3 - 750}
      Box: {0.3 + (z % 5) * 0.08, 0.25 + (x % 8) * 0.25, 0.3 + (z % 5) * 0.08}
      Rgb: {200, 90 + (x % 40) * 4, 60}
    }

    "s_{x}_{z}" {
      Position: {x * 3 - 748.5, 0.15 + (z % 5) * 0.04, z * 3 - 750}
      IcoSphere: {segments: 0, radius: 0.15 + (z % 5) * 0.04}
      Rgb: {70, 150, 210 - (z % 40) * 3}
    }

    "c_{x}_{z}" {
      Position: {x * 3 - 750, 0.25 + (z % 8) * 0.125, z * 3 - 748.5}
      Cylinder: {segments: 6, radius: 0.15 + (x % 5) * 0.04, length: 0.5 + (z % 8) * 0.25}
      Rgb: {110, 190, 90 + (x % 40) * 3}
    }

    "k_{x}_{z}" {
      Position: {x * 3 - 748.5, 0.3 + (x % 6) * 0.1, z * 3 - 748.5}
      Cone: {segments: 6, radius: 0.15 + (x % 5) * 0.04, length: 0.6 + (x % 6) * 0.2}
      Rgb: {220, 200, 80 + (z % 40) * 3}
    }
  }
}

$ {
  PerfRun: {fps: 60, frames: 300, warmup: 60, camera: orbit}
}

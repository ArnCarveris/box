// The scene of the browser check of the audio tone (audio_tone.mjs). The page opens a window
// only for a scene with a Surface; its 640x480 points fill the viewport of the check. A box
// turns all the time so every frame draws, which the check counts while the tone plays.
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.movement
using box.surface

window {
  Surface: {width: 640, height: 480}
}

camera {
  Position: {0, 0, 100}
  Camera: {ortho: true, ortho_scale: 1}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {10, 12, 20, 255}}}
}

spinner {
  Position: {0, 0, 0}
  Rotation: {0, 0, 0}
  Box: {120, 120, 120}
  Rgb: {80, 160, 255}
  AngularVelocity: {0.4, 0.9, 0}
}

marker {
  Position: {0, -170, 0}
  Rect: {40, 12}
  Rgb: {255, 200, 60}
}

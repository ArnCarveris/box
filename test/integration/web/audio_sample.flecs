// The scene of the browser check of sound files (audio_sample.mjs). The page preloads the files
// of test/assets/audio with ?preload=, the scene decodes one second of 440 Hz at 44100 Hz and a
// loop; the check plays them after a gesture with script_write. A box turns all the time so
// every frame draws, which the check counts and times.
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.movement
using box.surface
using box.audio

window {
  Surface: {width: 640, height: 480}
}

camera {
  Position: {0, 0, 100}
  Camera: {ortho: true, ortho_scale: 1}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {10, 12, 20, 255}}}
}

spinner {
  Position: {0, 0, 0}
  Rotation: {0, 0, 0}
  Box: {120, 120, 120}
  Rgb: {80, 160, 255}
  AngularVelocity: {0.4, 0.9, 0}
}

tone {
  SoundFile: {path: "test/assets/audio/tone_44100.wav"}
}

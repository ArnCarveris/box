// The scene of the browser check of the synth (audio_synth.mjs): a beep of 660 Hz that the
// check plays from a script after a gesture, and a hum of three layers through a filter envelope
// for the load of 64 voices. A box turns all the time so every frame draws, which the check
// counts.
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.movement
using box.surface
using box.audio
using box.audio.synth

window {
  Surface: {width: 640, height: 480}
}

camera {
  Position: {0, 0, 100}
  Camera: {ortho: true, ortho_scale: 1}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {10, 12, 20, 255}}}
}

spinner {
  Position: {0, 0, 0}
  Rotation: {0, 0, 0}
  Box: {120, 120, 120}
  Rgb: {80, 160, 255}
  AngularVelocity: {0.4, 0.9, 0}
}

// 660 Hz at 0.5: 10 ms up, 300 ms held, 50 ms down, 0.36 s in all at any rate
prefab Beep {
  Sound: {}
  Envelope: {attack: 0.01, sustain: 1, hold: 0.3, release: 0.05}
  Oscillator: {wave: Sine, frequency: 660, level: 0.5}
}

prefab Hum {
  Sound: {seed: 3}
  Envelope: {attack: 0.05, decay: 0.2, sustain: 0.6, hold: 2, release: 0.2}
  Filter: {kind: LowPass, cutoff: 400, resonance: 0.6}
  FilterEnvelope: {attack: 2, sustain: 1, hold: 0.46, amount: 3.907}
  saw { Oscillator: {wave: Saw, frequency: 110, frequency_end: 220, sweep: 2, level: 0.4} }
  square {
    Oscillator: {wave: Square, frequency: 330, level: 0.2}
    Envelope: {attack: 0.005, decay: 0.3, sustain: 0.3, hold: 2, release: 0.1}
  }
  noise { Oscillator: {wave: Noise, level: 0.1} }
}

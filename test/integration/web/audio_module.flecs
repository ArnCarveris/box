// The scene of the browser check of the box.audio module (audio_module.mjs). It only uses the
// module and script: a looping 440 Hz tone at a peak of 0.25 on the bus music, and a click
// that box.audio.play plays once at load, before any gesture, so the page drops it. A box
// turns all the time so every frame draws, which the check counts.
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.movement
using box.surface
using box.audio

window {
  Surface: {width: 640, height: 480}
}

camera {
  Position: {0, 0, 100}
  Camera: {ortho: true, ortho_scale: 1}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {10, 12, 20, 255}}}
}

spinner {
  Position: {0, 0, 0}
  Rotation: {0, 0, 0}
  Box: {120, 120, 120}
  Rgb: {80, 160, 255}
  AngularVelocity: {0.4, 0.9, 0}
}

// One period of a sine in 20 samples at 8800 Hz plays at 440 Hz at any rate of the output
tone {
  Pcm: {
    samples: [0, 0.0772542, 0.146946, 0.202254, 0.237764, 0.25, 0.237764, 0.202254, 0.146946,
      0.0772542, 0, -0.0772542, -0.146946, -0.202254, -0.237764, -0.25, -0.237764, -0.202254,
      -0.146946, -0.0772542],
    sample_rate: 8800
  }
}

// Three seconds of a constant 0.1, which would still play right after a gesture if it had
// not been dropped
click {
  Pcm: {samples: [0.1, 0.1, 0.1, 0.1], sample_rate: 1}
}

music {
  Bus: {volume: 1}
}

tone_source {
  Source: {sound: tone, loop: true}
  Output: {bus: music}
}

const early: bool = box.audio.play(click, 1.0)

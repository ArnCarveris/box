sphere	box.transform.Position, box.transform.WorldTransform, box.transform.AABB, box.material.Rgb, box.render.RenderMesh, box.render.RenderInstance, box.geometry.Sphere, (flecs.script.Script,test.integration.command.shell\.flecs)


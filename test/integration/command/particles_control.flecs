using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.particle
using box.command

camera {
  Position: {0, 2, -10}
  LookAt: {0, 1, 0}
  Camera: {fov: 55}
}

sun {
  Rotation: {0.9, -0.6, 0}
  DirectionalLight: {intensity: 1.2}
}

ground {
  Position: {0, -0.25, 0}
  Box: {20, 0.5, 20}
  Rgb: {120, 120, 125}
}

effects {
  fountain {
    Position: {0, 0.4, 0}
    ParticleEmitter: {
      max: 2000, rate: 600, shape: EmitterDisc, radius: 0.3,
      direction: {0, 1, 0}, spread: 18,
      speed: {min: 4, max: 7},
      lifetime: {min: 0.8, max: 1.2},
      color: {200, 220, 255},
      seed: 71
    }
    ParticlePlayback: {state: ParticleStopped}

    puffs {
      ParticleBurst: {count: 120, at: 0.25}
    }
  }
}

terminals {
  agent0 {
    Terminal: {}
    CommandScript: {path: "../../test/integration/command/particles_control.cmd"}
  }
}

view { box.view.View: {camera: camera} }

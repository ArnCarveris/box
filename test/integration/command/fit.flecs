using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.view
using box.command
using box.surface

$ {
  Surface: {width: 1280, height: 720, vsync: true}
}

camera {
  Position: {0, 2, -3}
  LookAt: {0, 0.5, 0}
  Camera: {fov: 55}
}

main {
  View: {camera: camera}
}

sun {
  Rotation: {0.9, -0.6, 0}
  DirectionalLight: {intensity: 1}
}

ground {
  Position: {0, -0.05, 0}
  Box: {16, 0.1, 8}
  Rgb: {90, 110, 90}
}

left {
  Position: {-7, 0.5, 3}
  Box: {1, 1, 1}
  Rgb: {220, 120, 60}
}

right {
  Position: {7, 1.5, -3}
  Box: {1, 3, 1}
  Rgb: {60, 120, 220}
}

center {
  Position: {0, 0.5, 0}
  Rotation: {0, 0.4, 0}
  Box: {1, 1, 1}
  Rgb: {220, 200, 60}
}

terminals {
  agent0 {
    Terminal: {}
    CommandScript: {path: "../../test/integration/command/fit.cmd"}
  }
}

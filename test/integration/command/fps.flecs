using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.view
using box.command

camera {
  Position: {0, 4, -12}
  LookAt: {0, 0.5, 0}
  Camera: {fov: 55}
}

main {
  View: {camera: camera}
}

sun {
  Rotation: {0.9, -0.6, 0}
  DirectionalLight: {intensity: 1}
}

crate {
  Position: {0, 0.5, 0}
  Rotation: {0, 0.4, 0}
  Box: {1, 1, 1}
  Rgb: {220, 120, 60}
}

terminals {
  agent0 {
    Terminal: {}
    CommandScript: {path: "../../test/integration/command/fps.cmd"}
  }
}

// The in game console driven through the input commands. One session presses
// the grave key, which opens the overlay through the action layer, and another
// types a line into it with key.type: the newline the typed text ends in
// submits the line, the console runs it on its own session and fires
// actions.ConsoleLine, which is what the agent awaits before it reads the
// console back and captures the screen.
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.input
using box.ui
using box.command

camera {
  Position: {0, 3, -9}
  LookAt: {0, 0.5, 0}
  Camera: {fov: 55}
}

sun {
  Rotation: {0.9, -0.6, 0}
  DirectionalLight: {intensity: 1}
}

ground {
  Position: {0, -0.5, 0}
  Box: {14, 0.5, 14}
  Rgb: {80, 90, 110}
}

crate {
  Position: {0, 0.75, 0}
  Box: {1.5, 1.5, 1.5}
  Rgb: {200, 120, 70}
}

// The console installs these two actions and the map that fires the first one
// with the grave key. The scene names them here so the template below can await
// them, because a script resolves its references before it runs.
actions {
  Console { InputAction: {description: "Open and close the in game console"} }
  ConsoleLine { InputAction: {description: "A line was submitted in the console"} }
}

$ {
  Console: {}
}

template Watcher {
  mut ran = 0

  async {
    await on.pressed(actions.ConsoleLine)
    ran = 1
  }

  if ran == 1 {
    CommandScript: {path: "../../test/integration/command/console.cmd"}
  }
}

terminals {
  agent0 {
    Terminal: {}
    TerminalInput: {line: "key.press Grave"}
    Watcher
  }

  typist {
    Terminal: {}
    TerminalInput: {line: "key.type \"man capture\n\""}
  }
}

using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.transition

struct BenchSingle(value: f32)

struct BenchPair(a: f32, b: f32)

struct BenchTriple(x: f32, y: f32, z: f32)

struct BenchQuad(x: f32, y: f32, z: f32, w: f32)

BenchSingle { Transitionable }
BenchPair { Transitionable }
BenchTriple { Transitionable }
BenchQuad { Transitionable }

sun {
  Rotation: {0.9, -0.6, 0}
  DirectionalLight: {intensity: 1}
}

camera {
  Position: {0, 60, -160}
  LookAt: {0, 0, 0}
  Camera: {fov: 60}
}

for i in 0..10000 {
  _ {
    Position: {(i % 100) * 3 - 150, ((i / 100) % 20) * 3, (i / 2000) * 6 - 15}
    Rotation: {0, 0, 0}
    Scale: {1, 1, 1}
    Box: {0.8, 0.8, 0.8}
    Rgb: {40, 60, 90}
    Emissive: {strength: 0, color: {255, 200, 50}}
    Tint: {255, 255, 255, 0}
    BenchSingle: {0}
    BenchPair: {0, 0}
    BenchTriple: {0, 0, 0}
    BenchQuad: {0, 0, 0, 0}
    Transition: [
      Position: {duration: 1, timing_function: Linear},
      Rotation: {duration: 1, timing_function: Linear},
      Scale: {duration: 1, timing_function: Linear},
      Rgb: {duration: 1, timing_function: Linear},
      Emissive: {duration: 1, timing_function: Linear},
      Tint: {duration: 1, timing_function: Linear},
      BenchSingle: {duration: 1, timing_function: Linear},
      BenchPair: {duration: 1, timing_function: Linear},
      BenchTriple: {duration: 1, timing_function: Linear},
      BenchQuad: {duration: 1, timing_function: Linear}
    ]

    Position: {(i % 100) * 3 - 150, ((i / 100) % 20) * 3 + 1, (i / 2000) * 6 - 15}
    Rotation: {(i % 100) * 0.01, (i % 100) * 0.02, 0}
    Scale: {1.4, 1.4, 1.4}
    Rgb: {200, 180, 120}
    Emissive: {strength: 2, color: {255, 200, 50}}
    Tint: {255, 200, 200, 60}
    BenchSingle: {1}
    BenchPair: {1, 1}
    BenchTriple: {1, 1, 1}
    BenchQuad: {1, 1, 1, 1}
  }
}

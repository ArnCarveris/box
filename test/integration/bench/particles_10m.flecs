using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.particle

$ { ParticleSettings: {max_total: 10000000, spawn_per_frame: 200000, cull: true} }

camera {
  Position: {0, 34, -150}
  LookAt: {0, 26, 0}
  Camera: {fov: 62}
}

sun {
  Rotation: {0.9, -0.6, 0}
  DirectionalLight: {intensity: 1.2}
}

$ { EnvironmentLight: {sky_color: {110, 125, 155}, ground_color: {55, 54, 52}, intensity: 0.5} }

ground {
  Position: {0, -0.25, 0}
  Box: {320, 0.5, 320}
  Rgb: {96, 99, 104}
  PbrMaterial: {roughness: 0.9}
}

columns {
  for i in 0..10 {
    _ {
      Position: {(i % 5) * 46 - 92, 0.5, (i / 5) * 60 - 30}
      ParticleEmitter: {
        max: 1000000, rate: 500000, shape: EmitterDisc, radius: 9,
        direction: {0, 1, 0}, spread: 26,
        speed: {min: 8, max: 24},
        lifetime: {min: 1.9, max: 2},
        size: {min: 0.05, max: 0.11},
        opacity: {min: 0.05, max: 0.09},
        acceleration: {0, -1.6, 0},
        color: {220, 190, 150},
        color_variance: {30, 20, 40},
        seed: 100 + i
      }
      ParticleAppearance: { shape: ParticleCircle, blend: ParticleAdditive }
    }
  }
}

view { box.view.View: {camera: camera} }

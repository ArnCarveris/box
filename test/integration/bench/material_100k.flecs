using box.transform
using box.geometry
using box.material
using box.camera
using box.movement

camera {
  Position: {0, 60, -160}
  LookAt: {0, 0, 0}
  Camera: {fov: 60}
}

for i in 0..100000 {
  static_box() {
    Position: {(i % 400) - 200, ((i / 400) % 25) * 2, (i / 10000) * 6 - 30}
    Box: {0.8, 0.8, 0.8}
    Rgb: {(i * 37) % 256, (i * 91) % 256, (i * 53) % 256}
    PbrMaterial: {metallic: (i % 1000) / 1000.0, roughness: ((i * 7) % 1000) / 1000.0}
  }
}

for i in 0..10000 {
  changing_box() {
    Position: {(i % 100) - 50, 60, (i / 100) - 50}
    DynamicMaterial
    Box: {0.8, 0.8, 0.8}
    Rgb: {255, 200, 50}
    Emissive: {strength: 1, color: {255, 100, 0}}
  }
}

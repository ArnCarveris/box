using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.texture
using box.particle

camera {
  Position: {0, 6, -26}
  LookAt: {0, 6, 0}
  Camera: {fov: 65}
}

sun {
  Rotation: {0.9, -0.6, 0}
  DirectionalLight: {intensity: 1.3}
}

$ { EnvironmentLight: {sky_color: {120, 135, 165}, ground_color: {60, 58, 55}, intensity: 0.6} }

ground {
  Position: {0, -0.25, 0}
  Box: {120, 0.5, 120}
  Rgb: {100, 103, 108}
  PbrMaterial: {roughness: 0.9}
}

pillars {
  for i in 0..12 {
    _ {
      Position: {(i % 6) * 9 - 22.5, 5, (i / 6) * 18 - 9}
      Box: {1.4, 10, 1.4}
      Rgb: {150, 150, 158}
      PbrMaterial: {roughness: 0.6}
    }
  }
}

puff {
  Svg: {
    data: "<svg xmlns='http://www.w3.org/2000/svg' width='64' height='64'><defs><radialGradient id='g'><stop offset='20%' stop-color='white' stop-opacity='1'/><stop offset='100%' stop-color='white' stop-opacity='0'/></radialGradient></defs><circle cx='32' cy='32' r='32' fill='url(#g)'/></svg>"
    width: 256
    height: 256
  }
}

smoke {
  Position: {0, 5, 0}
  ParticleEmitter: {
    max: 6400, rate: 1600, shape: EmitterBox, extents: {14, 5, 9},
    direction: {0, 1, 0}, spread: 80,
    speed: {min: 0.4, max: 1.2},
    lifetime: {min: 3.9, max: 4},
    size: {min: 9, max: 16},
    rotation: {min: 0, max: 180},
    opacity: {min: 0.04, max: 0.07},
    color: {210, 208, 215},
    seed: 91
  }
  ParticleCurves: {
    size: {start: 0.6, early: 1, late: 1.3, end: 1.5}
    opacity: {start: 0, early: 1, late: 1, end: 0}
  }
  ParticleAppearance: {
    shape: ParticleSprite, blend: ParticleAlpha, texture: puff, softness: 1.2
  }
}

haze {
  Position: {0, 7, -8}
  ParticleEmitter: {
    max: 4800, rate: 1200, shape: EmitterBox, extents: {12, 4, 6},
    direction: {0, 1, 0}, spread: 90,
    speed: {min: 0.3, max: 0.9},
    lifetime: {min: 3.9, max: 4},
    size: {min: 8, max: 14},
    opacity: {min: 0.03, max: 0.05},
    color: {255, 205, 160},
    seed: 92
  }
  ParticleCurves: {
    opacity: {start: 0, early: 1, late: 1, end: 0}
  }
  ParticleAppearance: {
    shape: ParticleSprite, blend: ParticleAdditive, texture: puff, softness: 1.2
  }
}

// effects/pyramids
using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.effects

camera {
  Position: {0, 2.6, -13}
  LookAt: {0, 1.8, 0}
  Camera: {fov: 55}
}

sun {
  Rotation: {0.85, -0.5, 0}
  DirectionalLight: {intensity: 0.4}
}

$ { EnvironmentLight: {sky_color: {60, 70, 90}, ground_color: {30, 28, 26}, intensity: 0.4} }

floor {
  Position: {0, -0.6, 0}
  Box: {40, 0.2, 24}
  Rgb: {160, 160, 170}
  PbrMaterial: {roughness: 0.5}
}

for i in 0..6 {
  _ {
    Position: {i * 3 - 7.5, 1.2, 1.5}
    Box: {1.4, 1.4, 1.4}
    Rgb: {20, 20, 20}
    Emissive: {strength: i * 6 + 1, color: {255, 190, 90}}
  }

  _ {
    Position: {i * 3 - 7.5, 1.8, -2}
    Quad: {2.8, 3.4}
    Rgb: {120, 150, 180}
    Opacity: {0.5}
    PbrMaterial: {roughness: i * 0.2}
    BlendMode: {AlphaBlend}
  }
}

post_effects { bloom : box.effects.bloom {
  Bloom: {intensity: 0.22, firefly_clamp: 8}
} }

view { box.view.View: {camera: camera, effects: [{effect: post_effects.bloom, enabled: true}]} }

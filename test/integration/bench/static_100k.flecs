using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.movement

sun {
  Rotation: {0.9, -0.6, 0}
  DirectionalLight: {intensity: 1}
}

camera {
  Position: {0, 60, -160}
  LookAt: {0, 0, 0}
  Camera: {fov: 60}
}

for i in 0..100000 {
  _ {
    Position: {(i % 400) - 200, ((i / 400) % 25) * 2, (i / 10000) * 6 - 30}
    Box: {0.8, 0.8, 0.8}
    Rgb: {(i * 37) % 256, (i * 91) % 256, (i * 53) % 256}
  }
}

for i in 0..10000 {
  _ {
    Position: {(i % 100) - 50, 60, (i / 100) - 50}
    Velocity: {0, -1, 0}
    AngularVelocity: {0, 1, 0}
    Sphere: {segments: 8, smooth: true, radius: 0.4}
    Rgb: {255, 200, 50}
  }
}

view { box.view.View: {camera: camera} }

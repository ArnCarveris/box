{
    "id": "script",
    "type": "application",
    "value": {
        "description": "Unit tests for incremental template instantiation",
        "public": false,
        "use": [
            "box"
        ]
    },
    "test": {
        "testsuites": [
            {
                "id": "Incremental",
                "testcases": [
                    "templates_are_marked_manual",
                    "instances_are_pending",
                    "non_template_entities_appear_immediately",
                    "count_budget_per_frame",
                    "time_budget_stops_a_frame",
                    "instance_is_complete_when_it_appears",
                    "every_instance_is_expanded_eventually",
                    "disabled_expands_everything_at_once",
                    "disabled_expands_nested_templates",
                    "stats_report_the_queue",
                    "stats_report_the_worst_frame",
                    "template_declared_before_import_is_marked"
                ]
            },
            {
                "id": "Order",
                "testcases": [
                    "nearest_to_the_camera_first",
                    "reorder_when_the_camera_moves",
                    "nearest_first_off_keeps_script_order",
                    "no_camera_keeps_script_order",
                    "instance_without_position_goes_first",
                    "world_position_orders_a_child_instance"
                ]
            },
            {
                "id": "Reload",
                "testcases": [
                    "rewritten_file_is_reloaded",
                    "parse_error_keeps_the_scene",
                    "reloaded_instances_are_pending"
                ]
            }
        ]
    }
}

{
    "id": "render",
    "type": "application",
    "value": {
        "description": "Unit tests for the box.render extract path and the material module",
        "public": false,
        "use": [
            "box"
        ]
    },
    "test": {
        "testsuites": [
            {
                "id": "Extract",
                "testcases": [
                    "mesh_uploaded_once",
                    "static_entity_gets_slot_and_update",
                    "unchanged_entity_not_reextracted",
                    "position_change_reextracts_static",
                    "color_change_reextracts_static",
                    "delete_swaps_last_into_slot",
                "delete_before_first_extract",
                "delete_before_first_extract_empty_batch",
                    "dynamic_entity_extracted_every_frame",
                    "dynamic_child_of_dynamic_parent",
                    "static_to_dynamic_releases_slot",
                    "dynamic_to_static_gets_slot",
                    "instance_transform_includes_shape_scale",
                    "aabb_written_for_static",
                    "camera_fills_view",
                    "default_camera_without_entity",
                    "sun_from_directional_light",
                    "mesh_shared_between_same_shapes",
                    "different_segments_different_mesh"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "Lights",
                "testcases": [
                    "point_light_extracted",
                    "point_light_color_is_linear",
                    "spot_light_direction_and_cone",
                    "point_light_is_not_a_spot_cone",
                    "light_behind_camera_culled",
                    "light_far_to_the_side_culled",
                    "light_beyond_far_plane_culled",
                    "light_inside_frustum_kept",
                    "range_reaches_into_the_frustum",
                    "directional_light_stays_the_sun",
                    "settings_copied_into_view",
                    "settings_override_copied_into_view",
                    "camera_range_is_the_cluster_depth",
                    "cluster_index_of_view_center",
                    "cluster_index_follows_screen_position",
                    "cluster_slices_grow_with_depth",
                    "lights_land_in_expected_clusters",
                    "moved_light_is_reextracted"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "Environment",
                "testcases": [
                    "defaults_without_component",
                    "colors_are_linear",
                    "intensity_copied_into_view",
                    "zero_intensity_is_one",
                    "generation_stable_without_change",
                    "generation_changes_on_change",
                    "removed_component_restores_defaults",
                    "source_is_reserved"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "Capture",
                "testcases": [
                    "component_consumed_by_extract",
                    "camera_becomes_the_view",
                    "two_cameras_over_two_frames",
                    "overrides_write_to_file",
                    "write_to_file_kept_without_component",
                    "active_camera_is_the_first_camera",
                    "active_camera_without_camera_entity",
                    "removed_after_a_deferred_extract"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "Material",
                "testcases": [
                    "tint_resolves_to_children",
                    "child_with_own_tint_keeps_it",
                    "tint_removed_falls_back_to_parent",
                    "new_child_inherits_tint",
                    "instance_color_uses_tint_and_opacity",
                    "emissive_scaled_by_strength",
                    "pbr_defaults"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "Movement",
                "testcases": [
                    "velocity_integrates_position",
                    "angular_velocity_integrates_rotation",
                    "velocity_marks_dynamic"
                ]
            }
        ]
    }
}

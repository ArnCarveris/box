{
    "id": "view",
    "type": "application",
    "value": {
        "description": "Unit tests for the box.view module and its render targets",
        "public": false,
        "use": [
            "box"
        ]
    },
    "test": {
        "testsuites": [
            {
                "id": "View",
                "testcases": [
                    "defaults_of_a_new_view",
                    "camera_fills_the_view",
                    "views_render_in_priority_order",
                    "synthesized_view_matches_an_explicit_one",
                    "disabled_view_is_skipped",
                    "view_without_camera_is_skipped",
                    "view_with_a_dead_camera_is_skipped",
                    "impl_holds_the_view_index",
                    "environment_of_a_view_overrides_the_singleton",
                    "environment_falls_back_to_the_singleton",
                    "equal_environments_share_a_generation",
                    "cluster_settings_of_a_view_override_the_singleton",
                    "cluster_settings_fall_back_to_the_singleton",
                    "material_layers_toggle_reaches_the_view",
                    "clear_color_of_a_view_is_linear",
                    "lights_are_culled_per_view",
                    "sorted_draws_are_sorted_per_view",
                    "depth_precision_at_100k"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "Target",
                "testcases": [
                    "surface_view_has_no_target",
                    "target_reaches_the_packet_as_a_create_command",
                    "view_names_the_target_handle_and_size",
                    "resize_resends_the_create_command",
                    "unchanged_target_is_sent_once",
                    "deleted_target_is_destroyed",
                    "two_targets_get_two_handles"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "Layers",
                "testcases": [
                    "membership_assigns_a_bit",
                    "entity_in_two_layers_has_both_bits",
                    "entity_without_a_layer_has_no_bits",
                    "empty_view_list_shows_everything",
                    "view_list_restricts_the_mask",
                    "static_slots_are_grouped_by_mask",
                    "leaving_a_layer_regroups_the_slots",
                    "dynamic_instances_are_filtered_per_view",
                    "transparent_entries_are_filtered_per_view",
                    "lights_are_restricted_to_a_layer",
                    "two_views_show_their_own_layer",
                    "view_list_holds_eight_entries",
                    "past_the_bit_limit_get_no_bit",
                    "prefab_layer_is_inherited",
                    "caster_mask_comes_from_shadow_layers",
                    "scene_without_layers_keeps_its_packet",
                    "strict_view_defaults_to_off",
                    "strict_view_hides_unlayered_static_runs",
                    "strict_view_hides_unlayered_dynamic",
                    "strict_view_hides_unlayered_transparent",
                    "strict_view_hides_unlayered_lights",
                    "strict_view_without_layers_shows_everything",
                    "parent_subtree_requeued_on_change"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "Shadows",
                "testcases": [
                    "splits_are_uniform_at_lambda_zero",
                    "splits_are_logarithmic_at_lambda_one",
                    "default_splits_blend_both",
                    "cascades_cover_the_camera_range",
                    "cascade_holds_the_slice_corners",
                    "texel_snapping_keeps_the_matrix",
                    "casters_exclude_no_shadow",
                    "casters_exclude_transparent",
                    "casters_respect_shadow_layers",
                    "settings_fall_back_to_the_singleton",
                    "settings_are_clamped",
                    "view_without_shadows_has_no_cascades",
                    "world_without_a_sun_has_no_cascades",
                    "static_delta_inside_a_cascade_marks_it_dirty",
                    "static_delta_outside_a_cascade_keeps_it",
                    "camera_rotation_marks_every_cascade"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "Frustum",
                "testcases": [
                    "planes_of_a_known_projection",
                    "infinite_far_keeps_a_distant_point",
                    "sphere_at_the_boundary",
                    "aabb_at_the_boundary",
                    "static_instance_carries_its_bounds",
                    "dynamic_instance_carries_its_bounds",
                    "bounds_refresh_when_the_entity_changes",
                    "settings_fall_back_to_the_singleton",
                    "settings_of_a_view_override_the_singleton",
                    "view_without_settings_culls_by_default",
                    "sorted_draws_behind_the_camera_are_culled",
                    "disabled_culling_keeps_every_sorted_draw"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "HiZ",
                "testcases": [
                    "levels_of_a_view",
                    "reduction_of_a_four_by_four_block",
                    "reduction_covers_an_odd_edge",
                    "sphere_on_the_axis_projects_to_the_center",
                    "sphere_off_the_axis_projects_beside_it",
                    "sphere_across_the_near_plane_takes_the_view",
                    "mip_holds_the_rectangle_in_two_texels",
                    "pyramid_hides_a_sphere_behind_a_wall",
                    "pyramid_keeps_a_sphere_in_front_of_a_wall",
                    "pyramid_keeps_a_sphere_that_straddles_a_wall",
                    "a_clamped_rectangle_is_never_hidden",
                    "settings_fall_back_to_the_singleton",
                    "view_without_settings_occludes_by_default",
                    "disabled_culling_disables_occlusion"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "Effects",
                "testcases": [
                    "builtin_grade_is_off_by_default",
                    "chain_runs_in_order",
                    "disabled_effect_is_skipped",
                    "enabling_an_effect_rebuilds_the_chain",
                    "effect_without_a_shader_is_skipped",
                    "view_list_overrides_the_stack",
                    "view_without_a_list_runs_the_stack",
                    "view_toggle_skips_the_chain",
                    "inputs_are_the_union_of_the_passes",
                    "disabled_pass_does_not_ask_for_its_inputs",
                    "parameters_come_from_the_parameter_component",
                    "two_passes_of_one_scale_share_a_target_size",
                    "half_scale_pass_asks_for_half_the_target",
                    "two_views_keep_their_own_range",
                    "histogram_bins_map_the_log_range",
                    "histogram_average_skips_the_black_bin",
                    "exposure_adapts_at_the_speed_of_its_direction",
                    "exposure_stays_inside_its_range",
                    "pinned_exposure_keeps_its_value",
                    "builtin_exposure_and_tonemap_are_off",
                    "tonemap_parameters_reach_the_pass",
                    "exposure_pass_declares_its_input",
                    "bloom_pyramid_stops_above_the_minimum",
                    "bloom_levels_follow_the_radius",
                    "karis_weight_falls_with_the_luminance",
                    "builtin_bloom_is_off_by_default",
                    "bloom_parameters_reach_the_pass"
                ],
                "setup": true,
                "teardown": true
            }
        ]
    }
}

{
    "id": "controller",
    "type": "application",
    "value": {
        "description": "Unit tests for the box.controller camera and character controllers",
        "public": false,
        "use": [
            "box"
        ]
    },
    "test": {
        "testsuites": [
            {
                "id": "Camera",
                "testcases": [
                    "the_module_binds_the_movement_actions",
                    "forward_moves_along_the_view",
                    "back_moves_against_the_view",
                    "strafing_moves_sideways",
                    "up_and_down_move_the_height",
                    "the_fast_modifier_multiplies_the_speed",
                    "the_mouse_turns_the_camera_while_captured",
                    "the_mouse_is_ignored_without_capture",
                    "the_look_action_turns_without_capture",
                    "sensitivity_scales_the_turn",
                    "pitch_stops_short_of_straight_down",
                    "yaw_turns_the_movement_with_the_view",
                    "clearance_keeps_the_camera_above_the_terrain",
                    "a_scene_rebinds_an_action",
                    "the_controller_writes_orientation_and_lookat",
                    "the_move_velocity_follows_the_smoothing_curve",
                    "sprint_scales_the_mouse_yaw",
                    "the_turn_actions_follow_the_angular_smoothing_curve",
                    "sprint_scales_the_turn_action_yaw",
                    "the_wheel_gives_an_impulse_along_the_view",
                    "the_wheel_is_ignored_while_the_ui_holds_the_mouse",
                    "the_turn_coasts_to_a_stop_after_the_button_releases",
                    "the_angular_velocity_zeroes_at_the_pitch_clamp",
                    "the_controller_starts_facing_an_authored_lookat",
                    "the_controller_starts_facing_an_authored_rotation",
                    "the_controller_starts_facing_a_scripted_lookat",
                    "collision_keeps_the_camera_out_of_geometry",
                    "disabling_collision_flies_through_geometry"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "Person",
                "testcases": [
                    "the_module_binds_the_character_actions",
                    "the_character_stands_at_eye_height",
                    "gravity_pulls_the_character_down",
                    "walking_moves_in_the_view_plane",
                    "running_is_faster_than_walking",
                    "a_jump_rises_and_lands",
                    "a_jump_needs_the_ground",
                    "crouching_lowers_the_eye",
                    "the_fly_toggle_switches_to_free_flight",
                    "the_terrain_sets_the_ground",
                    "the_ground_height_holds_the_character",
                    "the_controller_writes_orientation_and_lookat",
                    "a_wall_stops_the_character",
                    "walking_into_a_wall_slides_along_it",
                    "a_step_up_climbs_a_small_ledge",
                    "standing_on_geometry_holds_the_character",
                    "falling_off_geometry_lands_on_the_ground",
                    "disabling_collision_walks_through_geometry"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "Follow",
                "testcases": [
                    "the_module_binds_the_zoom_actions",
                    "the_camera_sits_at_the_offset_of_its_target",
                    "the_camera_follows_a_target_that_moves",
                    "the_glide_lags_behind_a_target_that_jumps",
                    "a_camera_without_a_target_is_left_alone",
                    "a_preset_replaces_the_offset_of_the_controller",
                    "the_wheel_steps_to_the_next_preset",
                    "the_zoom_actions_step_the_preset",
                    "a_held_zoom_action_steps_once",
                    "the_level_clamps_to_the_presets_that_are_authored",
                    "a_camera_without_presets_keeps_its_level_at_zero",
                    "the_wheel_is_ignored_while_the_ui_holds_the_mouse",
                    "the_terrain_keeps_the_camera_above_its_bounds"
                ],
                "setup": true,
                "teardown": true
            }
        ]
    }
}

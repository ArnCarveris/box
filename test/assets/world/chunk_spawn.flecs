// A streamed forest cell for the ChunkSpawn bench of bench/render/src/ChunkSpawn.c, comparable to
// a cell of the forest scene: ten trees of Sweeps along shared paths with IcoSphere crowns and
// leaf cards, a few boulders and logs, and about 2000 grass cards that are IsA instances of a
// few prefabs. A cell at level 0 is full, at level 1 its trees are cheap and it has no grass.

using flecs.script.math
using box.transform
using box.geometry
using box.material

// Seeded hash of an index, 0..1
fn spawn_hash(i: f64, seed: f64) -> f64 {
  const v = sin(i * 12.9898 + seed * 78.233 + 4.1414) * 43758.5453
  v - floor(v)
}

// A round profile of radius 1 for trunks and limbs
prefab SpawnRoundShape {
  Path2D: {
    start: {1, 0},
    segments: [
      {kind: CatmullRom, end: {0.5, 0.866}},
      {kind: CatmullRom, end: {-0.5, 0.866}},
      {kind: CatmullRom, end: {-1, 0}},
      {kind: CatmullRom, end: {-0.5, -0.866}},
      {kind: CatmullRom, end: {0.5, -0.866}}
    ],
    closed: true
  }
}

prefab SpawnRoundProfile { Profile2D: {outer: SpawnRoundShape} }

// A trunk path, 20 units up with a bend of variant
template SpawnTrunkPath {
  prop variant: f32 = 0

  Path3D: {
    start: {0, 0, 0},
    segments: [
      {kind: CatmullRom, end: {0.1 * variant, 5, 0.05}},
      {kind: CatmullRom, end: {0.2 * variant, 10, -0.1}},
      {kind: CatmullRom, end: {0.1, 15, 0.1 * variant}},
      {kind: CatmullRom, end: {0, 20, 0}}
    ]
  }
}

// A limb path, 4 units out with a curve of kind
template SpawnLimbPath {
  prop kind: f32 = 0

  Path3D: {
    start: {0, 0, 0},
    segments: [
      {kind: CatmullRom, end: {0.2 * kind, 1.3, 0.1}},
      {kind: CatmullRom, end: {0.4 * kind, 2.7, -0.1 * kind}},
      {kind: CatmullRom, end: {0.3 * kind, 4, 0}}
    ]
  }
}

SpawnTrunkPath spawn_trunk_path_0(variant: 0)
SpawnTrunkPath spawn_trunk_path_1(variant: 1)
SpawnLimbPath spawn_limb_path_0(kind: 0)
SpawnLimbPath spawn_limb_path_1(kind: 1)
SpawnLimbPath spawn_limb_path_2(kind: 2)

prefab SpawnBark {
  Rgb: {92, 74, 60}
  PbrMaterial: {roughness: 0.9}
}

prefab SpawnStone {
  Rgb: {128, 126, 120}
  PbrMaterial: {roughness: 0.8}
}

prefab SpawnLeaf {
  Quad: {1, 1}
  Rgb: {70, 120, 40}
  PbrMaterial: {roughness: 0.75}
}

prefab SpawnLeafB : SpawnLeaf {
  Rgb: {90, 130, 45}
}

prefab SpawnCore {
  IcoSphere: {radius: 1, segments: 1, smooth: true}
  Rgb: {30, 50, 20}
  PbrMaterial: {roughness: 1}
}

prefab SpawnGrass {
  Quad: {0.5, 0.6}
  Rgb: {100, 140, 50}
  PbrMaterial: {roughness: 0.8}
}

prefab SpawnGrassB : SpawnGrass {
  Rgb: {120, 140, 60}
}

prefab SpawnPlant {
  Quad: {0.8, 0.7}
  Rgb: {60, 110, 50}
  PbrMaterial: {roughness: 0.8}
}

// A trunk: a Sweep along a trunk path, scaled to the tree
template SpawnTrunk {
  prop variant: i32 = 0
  prop detail: i32 = 0

  const seg: i32 = detail == 0 ? 3 : 1
  const rings: i32 = detail == 0 ? 16 : 6

  if variant == 0 {
    Sweep: {path: spawn_trunk_path_0, profile: SpawnRoundProfile, scale: {0.5, 0.5}, taper: 0.3, segments: seg, rings: rings}
  } else {
    Sweep: {path: spawn_trunk_path_1, profile: SpawnRoundProfile, scale: {0.5, 0.5}, taper: 0.3, segments: seg, rings: rings}
  }

  (IsA, SpawnBark)
}

// A limb or twig: a Sweep along a limb path of one of a few girths
template SpawnLimb {
  prop kind: i32 = 0
  prop girth: i32 = 0
  prop detail: i32 = 0

  const r = 0.04 * pow(1.5, girth)
  const seg: i32 = detail == 0 ? 2 : 1
  const rings: i32 = detail == 0 ? 8 : 4

  if kind == 0 {
    Sweep: {path: spawn_limb_path_0, profile: SpawnRoundProfile, scale: {r, r}, taper: 0.3, segments: seg, rings: rings}
  } else if kind == 1 {
    Sweep: {path: spawn_limb_path_1, profile: SpawnRoundProfile, scale: {r, r}, taper: 0.3, segments: seg, rings: rings}
  } else {
    Sweep: {path: spawn_limb_path_2, profile: SpawnRoundProfile, scale: {r, r}, taper: 0.3, segments: seg, rings: rings}
  }

  (IsA, SpawnBark)
}

// A lobe of count leaf cards around x y z
template SpawnLobe {
  prop seed: f32 = 0
  prop count: i32 = 6
  prop spread: f32 = 0.5
  prop card: f32 = 1
  prop x: f32 = 0
  prop y: f32 = 0
  prop z: f32 = 0

  for c in 0..count {
    const h1 = spawn_hash(c * 7 + 1, seed)
    const h2 = spawn_hash(c * 7 + 2, seed)
    const h3 = spawn_hash(c * 7 + 3, seed)
    const s = card * (0.8 + 0.4 * spawn_hash(c * 7 + 4, seed))
    if spawn_hash(c * 7 + 5, seed) < 0.5 {
      _ : SpawnLeaf {
        Position: {x + (h1 * 2 - 1) * spread, y + (h2 - 0.5) * spread, z + (h3 * 2 - 1) * spread}
        Rotation: {h2 * 1.5 - 0.75, h1 * 6.28, 0}
        Scale: {s, s, s}
      }
    } else {
      _ : SpawnLeafB {
        Position: {x + (h1 * 2 - 1) * spread, y + (h2 - 0.5) * spread, z + (h3 * 2 - 1) * spread}
        Rotation: {h2 * 1.5 - 0.75, h1 * 6.28, 0}
        Scale: {s, s, s}
      }
    }
  }
}

// A broadleaf tree height meters tall: a trunk, limbs with twigs, lobes of cards at the tips
// of the limbs and over the crown, and a core in a cheap tree
template SpawnTree {
  prop seed: f32 = 1
  prop height: f32 = 20
  prop detail: i32 = 0

  const full = detail == 0
  const n: i32 = full ? 8 : 4
  const ns: i32 = full ? 2 : 0
  const nc: i32 = full ? 8 : 5
  const k = height * 0.8 / 20
  const kr = height * 0.016 / 0.5
  const tv: i32 = spawn_hash(1, seed) < 0.5 ? 0 : 1

  SpawnTrunk trunk(variant: tv, detail: detail) {
    Position: {0, -0.3, 0}
    Scale: {kr, k, kr}
  }

  for i in 0..n {
    const fi = (i + 0.0) / max(n - 1, 1)
    const h1 = spawn_hash(i * 11 + 1, seed)
    const h2 = spawn_hash(i * 11 + 2, seed)
    const ya = height * (0.4 + 0.4 * fi)
    const ll = height * 0.3 * (1 - 0.45 * fi) * (0.85 + 0.3 * h1)
    const s = ll / 4
    const p = 1 - 0.5 * fi + (h2 - 0.5) * 0.3
    const w = i * 2.39996 + seed * 0.77
    const lk: i32 = floor(h1 * 3)
    const lv: i32 = floor(4 - 3 * fi)

    SpawnLimb "limb_{i}"(kind: lk, girth: lv, detail: detail) {
      Position: {0, ya, 0}
      Rotation: {p, w, 0}
      Scale: {s, s, s}

      for j in 0..ns {
        SpawnLimb(kind: (lk + j + 1) % 3, girth: max(lv - 2, 0), detail: detail) {
          Position: {0, 1.5 + j * 1.2, 0}
          Rotation: {0.7, j * 2.4 + 1.2, 0}
          Scale: {0.55, 0.55, 0.55}
        }
      }
    }

    const tx = sin(w) * sin(p) * ll
    const ty = ya + cos(p) * ll
    const tz = cos(w) * sin(p) * ll
    SpawnLobe(seed: seed * 97 + i * 13, count: nc, spread: height * 0.04, card: height * 0.06, x: tx, y: ty, z: tz)
    for j in 0..ns {
      SpawnLobe(seed: seed * 97 + i * 13 + j + 5, count: nc - 2, spread: height * 0.03, card: height * 0.05, x: tx * (0.5 + 0.2 * j), y: ty - 0.5 - j, z: tz * (0.5 + 0.2 * j))
    }
  }

  // Lobes over the shell of the crown
  const nsh: i32 = full ? 10 : 4
  for m in 0..nsh {
    const cy = 0.85 - 1.5 * (m + 0.5) / nsh
    const sr = sqrt(max(1 - cy * cy, 0))
    const a = m * 2.39996 + seed * 0.37
    SpawnLobe(seed: seed * 97 + m * 7 + 400, count: nc, spread: height * 0.04, card: height * 0.055, x: sin(a) * sr * height * 0.22, y: height * 0.62 + cy * height * 0.2, z: cos(a) * sr * height * 0.22)
  }

  if !full {
    core : SpawnCore {
      Position: {0, height * 0.62, 0}
      Scale: {height * 0.18, height * 0.2, height * 0.18}
    }
  }
}

// A cell: ten trees, boulders and logs, and at level 0 a meadow of grass and plant cards
template ChunkSpawnCell {
  prop cell_x: i32 = 0
  prop cell_z: i32 = 0
  prop level: i32 = 0
  prop size: f32 = 32
  prop seed: i32 = 0

  box.spatial.Ignore

  const cs = cell_x * 7919 + cell_z * 104729 + seed

  for t in 0..10 {
    const x = size * (0.05 + 0.9 * spawn_hash(t * 3 + 1, cs))
    const z = size * (0.05 + 0.9 * spawn_hash(t * 3 + 2, cs))
    SpawnTree "tree_{t}"(seed: floor(spawn_hash(t * 3 + 3, cs) * 64), height: 14 + 10 * spawn_hash(t, cs), detail: level) {
      Position: {x, 0, z}
      Rotation: {0, spawn_hash(t + 40, cs) * 6.28, 0}
    }
  }

  for b in 0..6 {
    const s = 0.4 + 0.8 * spawn_hash(b + 60, cs)
    "boulder_{b}" : SpawnStone {
      Position: {size * spawn_hash(b + 70, cs), s * 0.3, size * spawn_hash(b + 80, cs)}
      Scale: {s, s * 0.7, s * 1.2}
      IcoSphere: {radius: 1, segments: 2, smooth: true}
    }
  }

  for l in 0..2 {
    "log_{l}" : SpawnBark {
      Position: {size * spawn_hash(l + 90, cs), 0.3, size * spawn_hash(l + 95, cs)}
      Rotation: {1.5708, spawn_hash(l + 99, cs) * 6.28, 0}
      Cylinder: {segments: 12, smooth: true, length: 4 + 2 * spawn_hash(l + 97, cs), radius: 0.3}
    }
  }

  if level == 0 {
    for g in 0..2000 {
      const x = size * spawn_hash(g * 4 + 1, cs)
      const z = size * spawn_hash(g * 4 + 2, cs)
      const h = spawn_hash(g * 4 + 3, cs)
      const yaw = spawn_hash(g * 4 + 4, cs) * 6.2832
      if h < 0.45 {
        "grass_{g}" : SpawnGrass {
          Position: {x, 0, z}
          Rotation: {0, yaw, 0}
          Scale: {0.6 + h, 0.5 + h, 0.6 + h}
        }
      } else if h < 0.9 {
        "sedge_{g}" : SpawnGrassB {
          Position: {x, 0, z}
          Rotation: {0, yaw, 0}
          Scale: {h, 0.6 + h * 0.5, h}
        }
      } else {
        "plant_{g}" : SpawnPlant {
          Position: {x, 0, z}
          Rotation: {0, yaw, 0}
        }
      }
    }
  }
}

// A 2 by 2 quad in the XY plane whose albedo is a white disc on a transparent background, alpha
// tested, for the coverage of the impostor tests: seen along +Z only the disc covers the view.

using box.geometry
using box.material
using box.texture

impostor_disc {
  Path: {path: "test/assets/impostor/disc.svg", width: 128, height: 128}
}

prefab DiscCard {
  Quad: {2, 2}
  Rgb: {255, 255, 255}
  PbrTextures: {albedo: impostor_disc}
  AlphaCutoff: {value: 0.5}
}

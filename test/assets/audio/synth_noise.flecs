// The sounds the SynthNoise suite of test/cpu/audio measures colored noise from script with.
using box.audio
using box.audio.synth

// Wind: pink noise that swells and fades
prefab Wind {
  Sound: {seed: 3}
  Envelope: {attack: 0.05, sustain: 1, hold: 0.2, release: 0.1}
  Oscillator: {wave: Noise, color: NoisePink, level: 0.3}
}

// Rumble: brown noise in three unison voices across the width
prefab Rumble {
  Sound: {seed: 4}
  Envelope: {attack: 0.01, sustain: 1, hold: 0.2, release: 0.1}
  Oscillator: {wave: Noise, color: NoiseBrown, level: 0.3}
  Unison: {voices: 3, width: 1}
}

// The default: white noise
prefab Hiss {
  Sound: {}
  Envelope: {attack: 0.005, sustain: 1, hold: 0.1, release: 0.05}
  Oscillator: {wave: Noise, level: 0.2}
}

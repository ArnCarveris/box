// The sounds the SynthNoise suite of test/cpu/audio measures colored noise from script with.
using box.audio

// Wind: pink noise that swells and fades
prefab Wind {
  SynthSound: {seed: 3}
  SynthEnvelope: {attack: 0.05, sustain: 1, hold: 0.2, release: 0.1}
  SynthOscillator: {wave: SynthNoise, color: SynthNoisePink, level: 0.3}
}

// Rumble: brown noise in three unison voices across the width
prefab Rumble {
  SynthSound: {seed: 4}
  SynthEnvelope: {attack: 0.01, sustain: 1, hold: 0.2, release: 0.1}
  SynthOscillator: {wave: SynthNoise, color: SynthNoiseBrown, level: 0.3}
  SynthUnison: {voices: 3, width: 1}
}

// The default: white noise
prefab Hiss {
  SynthSound: {}
  SynthEnvelope: {attack: 0.005, sustain: 1, hold: 0.1, release: 0.05}
  SynthOscillator: {wave: SynthNoise, level: 0.2}
}

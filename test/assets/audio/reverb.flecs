// A reverb bus set by a scene, for the Script suite of test/cpu/audio: the hall reverb in the
// first insert slot of its own bus, which the bus world reaches through its send at 0.3, and a
// click on world.
using box.audio

hall { Bus: {output: master, effects: [hall]}; Reverb: {decay: 2.4, damping: 0.4, predelay: 0.02} }
world { Bus: {output: master, sends: [{bus: hall, level: 0.3}]} }

// Silence over the start ramp of a voice, then one sample of 0.5
click {
  Pcm: {samples: [0, 0, 0, 0, 0.5], sample_rate: 400}
}

click_source {
  Source: {sound: click}
  Output: {bus: world}
}

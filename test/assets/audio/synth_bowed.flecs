// The sounds the SynthBowedWorld suite of test/cpu/audio compiles the bowed string from script
// with.
using box.audio
using box.audio.synth

// A violin: a bowed string whose bow presses harder with the pressure of the note
prefab Violin {
  Sound: {seed: 11}
  Envelope: {attack: 0.08, decay: 0.2, sustain: 0.9, release: 0.25}
  Oscillator: {wave: Bowed, frequency: 440, level: 0.5}
  Bow: {pressure: 0.45, speed: 0.6, position: 0.1, brightness: 0.6, noise: 0.15, velocity: 0.5}
  swell { ModRoute: {source: SourcePressure, target: TargetBowPressure, amount: 0.4} }
}

// A bowed string without a Bow, which takes the defaults
prefab Plain {
  Sound: {}
  Envelope: {attack: 0.05, sustain: 1, hold: 0.3, release: 0.2}
  Oscillator: {wave: Bowed, frequency: 220, level: 0.5}
}

// Synth sounds with analog drift for the SynthDrift suite of test/cpu/audio.
using box.audio
using box.audio.synth

// A pad of three detuned saws that drift apart, through a lowpass whose cutoff drifts too,
// each play starting its oscillators at random phases
prefab DriftPad {
  Sound: {seed: 5, drift: 12, free_phase: true}
  Envelope: {attack: 0.05, sustain: 1, hold: 0.5, release: 0.2}
  Filter: {kind: LowPass, cutoff: 1200, resonance: 0.2}
  Oscillator: {wave: Saw, frequency: 220, level: 0.4}
  Unison: {voices: 3, detune: 8, width: 0.6}
}

// A plucked string that drifts as it rings
prefab DriftPluck {
  Sound: {seed: 3, drift: 8}
  Oscillator: {wave: Pluck, frequency: 196, level: 0.6}
  String: {decay: 1}
}

// The defaults: no drift, every play from phase 0
prefab Steady {
  Sound: {}
  Envelope: {attack: 0.005, sustain: 1, hold: 0.1, release: 0.05}
  Oscillator: {frequency: 440, level: 0.5}
}

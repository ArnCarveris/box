// A quantized play for the Quantize suite of test/cpu/audio: the transport starts at beat 0.5
// at 120 quarter notes per minute, and a hit of 0.5 is played on the next beat.
//
// A beat lasts 24000 frames at 48 kHz, so the hit starts 12000 frames after the clock of the
// frame the script ran in, silent before.
using box.audio

$ {
  Transport: {tempo: 120, position: 0.5, playing: true}
}

hit {
  AudioPcm: {samples: [0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5]}
}

const played: bool = box.audio.play_quantized(hit, 1.0, AudioQuantizeBeat)

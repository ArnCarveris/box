using box.audio
using box.audio.synth

ringing_group {
  Bus: {}
}

prefab ringing_tone {
  Sound: {}
  Envelope: {attack: 0.005, decay: 30, curve: 0.2}
  Oscillator: {wave: Sine, frequency: 440, level: 0.4}
}

ringing_inst { Instrument: {sound: ringing_tone, gate: false} }

prefab ringing_notes {
  NoteClip: {length: 64, notes: [
    {start: 0, duration: 32, pitch: 69, velocity: 1}
  ]}
}

ringing_bell {
  Track: {instrument: ringing_inst}
  Bus: {output: ringing_group}
  Meter: {}
  hit { ClipPlacement: {clip: ringing_notes, start: 0} }
}

$ { Song: {title: "Ringing", tempo: 120, beats: 64, lanes: [{name: "Bell", bus: ringing_bell}]} }

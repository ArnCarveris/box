// A song of the audio.check tests in the Shell suite of test/cpu/command: a held A3 at a peak of
// 0.5 on a track whose output is the bus check_hot at a volume of 4, so check_hot peaks at about
// +6 dBFS from the first beat. 2 bars of 4/4 at 120 bpm.
using box.audio
using box.audio.synth

prefab check_clip_tone {
  Sound: {}
  Envelope: {attack: 0.005, decay: 0.05, sustain: 1, release: 0.05}
  Oscillator: {wave: Sine, frequency: 440, level: 0.5}
}

check_clip_inst { Instrument: {sound: check_clip_tone} }

prefab check_clip_notes {
  NoteClip: {length: 4, notes: [{start: 0, duration: 4, pitch: 57, velocity: 1}]}
}

check_hot {
  Bus: {volume: 4}
}

check_clip_track {
  Track: {instrument: check_clip_inst}
  Bus: {output: check_hot}
  part { ClipPlacement: {clip: check_clip_notes, start: 0, duration: 4} }
}

$ {
  Song: {
    title: "Check clip", tempo: 120, beats_per_bar: 4, beat_unit: 4, beats: 8,
    lanes: [{name: "Hot", bus: check_hot}]
  }
}

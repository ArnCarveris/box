    {start: 9, duration: 4, pitch: 98, velocity: 0.5},
    {start: 9, duration: 4, pitch: 99, velocity: 0.5}
  ]}
}

check_voices {
  Track: {instrument: check_voice_inst}
  AudioBus: {}
  part { ClipPlacement: {clip: check_voice_notes, start: 0, duration: 16} }
}

$ {
  Song: {
    title: "Check voices", tempo: 120, beats_per_bar: 4, beat_unit: 4, beats: 16,
    lanes: [{name: "Voices", bus: check_voices}]
  }
}

// A song of the audio.check tests in the Shell suite of test/cpu/command: two single notes in
// bars 1 and 2, then 70 held notes of 70 pitches that start together at beat 9, bar 3 beat 2, more
// than the 64 voices of the core, so the voices are stolen from bar 3 on. 4 bars of 4/4 at 120
// bpm.
using box.audio

prefab check_voice_tone {
  SynthSound: {}
  SynthEnvelope: {attack: 0.005, decay: 0.05, sustain: 1, release: 0.05}
  SynthOscillator: {wave: SynthSine, frequency: 440, level: 0.01}
}

check_voice_inst { Instrument: {sound: check_voice_tone} }

prefab check_voice_notes {
  NoteClip: {length: 16, notes: [
    {start: 0, duration: 1, pitch: 60, velocity: 0.5},
    {start: 4, duration: 1, pitch: 62, velocity: 0.5},
    {start: 9, duration: 4, pitch: 30, velocity: 0.5},
    {start: 9, duration: 4, pitch: 31, velocity: 0.5},
    {start: 9, duration: 4, pitch: 32, velocity: 0.5},
    {start: 9, duration: 4, pitch: 33, velocity: 0.5},
    {start: 9, duration: 4, pitch: 34, velocity: 0.5},
    {start: 9, duration: 4, pitch: 35, velocity: 0.5},
    {start: 9, duration: 4, pitch: 36, velocity: 0.5},
    {start: 9, duration: 4, pitch: 37, velocity: 0.5},
    {start: 9, duration: 4, pitch: 38, velocity: 0.5},
    {start: 9, duration: 4, pitch: 39, velocity: 0.5},
    {start: 9, duration: 4, pitch: 40, velocity: 0.5},
    {start: 9, duration: 4, pitch: 41, velocity: 0.5},
    {start: 9, duration: 4, pitch: 42, velocity: 0.5},
    {start: 9, duration: 4, pitch: 43, velocity: 0.5},
    {start: 9, duration: 4, pitch: 44, velocity: 0.5},
    {start: 9, duration: 4, pitch: 45, velocity: 0.5},
    {start: 9, duration: 4, pitch: 46, velocity: 0.5},
    {start: 9, duration: 4, pitch: 47, velocity: 0.5},
    {start: 9, duration: 4, pitch: 48, velocity: 0.5},
    {start: 9, duration: 4, pitch: 49, velocity: 0.5},
    {start: 9, duration: 4, pitch: 50, velocity: 0.5},
    {start: 9, duration: 4, pitch: 51, velocity: 0.5},
    {start: 9, duration: 4, pitch: 52, velocity: 0.5},
    {start: 9, duration: 4, pitch: 53, velocity: 0.5},
    {start: 9, duration: 4, pitch: 54, velocity: 0.5},
    {start: 9, duration: 4, pitch: 55, velocity: 0.5},
    {start: 9, duration: 4, pitch: 56, velocity: 0.5},
    {start: 9, duration: 4, pitch: 57, velocity: 0.5},
    {start: 9, duration: 4, pitch: 58, velocity: 0.5},
    {start: 9, duration: 4, pitch: 59, velocity: 0.5},
    {start: 9, duration: 4, pitch: 60, velocity: 0.5},
    {start: 9, duration: 4, pitch: 61, velocity: 0.5},
    {start: 9, duration: 4, pitch: 62, velocity: 0.5},
    {start: 9, duration: 4, pitch: 63, velocity: 0.5},
    {start: 9, duration: 4, pitch: 64, velocity: 0.5},
    {start: 9, duration: 4, pitch: 65, velocity: 0.5},
    {start: 9, duration: 4, pitch: 66, velocity: 0.5},
    {start: 9, duration: 4, pitch: 67, velocity: 0.5},
    {start: 9, duration: 4, pitch: 68, velocity: 0.5},
    {start: 9, duration: 4, pitch: 69, velocity: 0.5},
    {start: 9, duration: 4, pitch: 70, velocity: 0.5},
    {start: 9, duration: 4, pitch: 71, velocity: 0.5},
    {start: 9, duration: 4, pitch: 72, velocity: 0.5},
    {start: 9, duration: 4, pitch: 73, velocity: 0.5},
    {start: 9, duration: 4, pitch: 74, velocity: 0.5},
    {start: 9, duration: 4, pitch: 75, velocity: 0.5},

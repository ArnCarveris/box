    {start: 9, duration: 4, pitch: 83, velocity: 0.5},
    {start: 9, duration: 4, pitch: 84, velocity: 0.5},
    {start: 9, duration: 4, pitch: 85, velocity: 0.5},
    {start: 9, duration: 4, pitch: 86, velocity: 0.5},
    {start: 9, duration: 4, pitch: 87, velocity: 0.5},
    {start: 9, duration: 4, pitch: 88, velocity: 0.5},
    {start: 9, duration: 4, pitch: 89, velocity: 0.5},
    {start: 9, duration: 4, pitch: 90, velocity: 0.5},
    {start: 9, duration: 4, pitch: 91, velocity: 0.5},
    {start: 9, duration: 4, pitch: 92, velocity: 0.5},

// The sounds of the SynthModMatrix suite of test/cpu/audio: a saw lead whose mod envelope
// sweeps its cutoff and whose first LFO pans it, with a square layer that a route of its own
// makes softer at a high velocity.
using box.audio

matrix_lead {
  SynthSound: {seed: 7}
  SynthEnvelope: {attack: 0.005, sustain: 1, hold: 0.5, release: 0.05}
  SynthFilter: {kind: SynthLowPass, cutoff: 500}
  SynthModEnvelope: {attack: 0.1, decay: 0.2, sustain: 0.3, release: 0.1}
  SynthOscillator: {wave: SynthSaw, frequency: 220, level: 0.4}
  SynthLfo: {rate: 3}
  sweep { SynthModRoute: {source: SynthSourceModEnvelope, target: SynthTargetCutoff, amount: 3} }
  wobble { SynthModRoute: {source: SynthSourceLfo1, target: SynthTargetPan, amount: 0.5} }
  fifth {
    SynthOscillator: {wave: SynthSquare, frequency: 330, level: 0.2}
    soft { SynthModRoute: {source: SynthSourceVelocity, target: SynthTargetLevel, amount: -0.5} }
  }
}

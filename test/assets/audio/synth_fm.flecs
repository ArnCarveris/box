// Modulators for the Synth suite of test/cpu/audio: a carrier on the root with a modulator
// child that has its own envelope and a ring modulator of its own, a layer with feedback, and
// a modulator whose parent is not a layer.
using box.audio
using box.audio.synth

prefab FmBell {
  Sound: {}
  Envelope: {attack: 0.001, decay: 0.5}
  Oscillator: {frequency: 500, level: 0.5}
  bright {
    Oscillator: {frequency: 700, modulation: Phase, index: 2}
    Envelope: {attack: 0.001, decay: 0.3}
    deep { Oscillator: {frequency: 300, modulation: Ring, index: 0.5} }
  }
  tone { Oscillator: {frequency: 1000, level: 0.2, feedback: 0.5} }
}

// The root has no oscillator, so its modulator has no carrier
prefab Orphan {
  Sound: {}
  Envelope: {attack: 0.001, decay: 0.1}
  m { Oscillator: {frequency: 400, modulation: Phase} }
  c { Oscillator: {frequency: 200, level: 0.3} }
}

// The sounds the SynthCombWorld suite of test/cpu/audio compiles the comb filter from script
// with.
using box.audio
using box.audio.synth

// A pluck from a noise burst: a short burst of noise rings on in a comb at the note after its
// envelope ends, damped at 6 kHz
prefab NoisePluck {
  Sound: {}
  Envelope: {attack: 0.001, decay: 0.02, sustain: 0, release: 0.01}
  Filter: {kind: Comb, cutoff: 6000, feedback: 0.95}
  Oscillator: {wave: Noise, frequency: 220, level: 0.5}
}

// A hollow resonator an octave up: negative feedback, undamped, the defaults of the rest
prefab Hollow {
  Sound: {}
  Envelope: {attack: 0.01, sustain: 1, hold: 0.5, release: 0.2}
  Filter: {kind: Comb, cutoff: 24000, feedback: -0.8, tune: 2}
  Oscillator: {wave: Saw, frequency: 110, level: 0.5}
}

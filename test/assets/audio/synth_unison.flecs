// A unison example, then the sounds the Synth suite of
// test/cpu/audio measures unison from script with.
using box.audio
using box.audio.synth

music { Bus: {volume: 1} }

// A wide pad: a saw of five voices over 20 cents across most of the stereo field and a fifth
// of three voices across all of it, over a sine sub in the center, 2.1 s
prefab WidePad {
  Output: {bus: music}
  Sound: {seed: 3}
  Envelope: {attack: 0.4, decay: 0.3, sustain: 0.7, hold: 0.6, release: 0.8, curve: 2.5, attack_curve: 1.5}
  Filter: {kind: LowPass, cutoff: 1400, resonance: 0.1, slope: Slope24}
  saw {
    Oscillator: {wave: Saw, frequency: 220, level: 0.2}
    Unison: {voices: 5, detune: 20, width: 0.8}
  }
  fifth {
    Oscillator: {wave: Saw, frequency: 330, level: 0.12}
    Unison: {voices: 3, detune: 14, width: 1}
  }
  sub { Oscillator: {wave: Sine, frequency: 110, level: 0.15} }
}

// The defaults of Unison on the root layer: 3 voices over 10 cents, in the center
prefab Thick {
  Sound: {}
  Envelope: {attack: 0.01, sustain: 1, hold: 0.3, release: 0.05}
  Oscillator: {wave: Saw, frequency: 220, level: 0.3}
  Unison: {}
}

// A wide tone in space: three sines across the whole width, at full level up to 50 units
prefab WideBeep {
  Sound: {seed: 4}
  Envelope: {attack: 0.005, sustain: 1, hold: 0.5, release: 0.01}
  Oscillator: {frequency: 500, level: 0.4}
  Unison: {voices: 3, detune: 30, width: 1}
  Spatial: {min_distance: 1, max_distance: 50, rolloff: 0}
}

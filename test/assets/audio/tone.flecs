// A 440 Hz tone at a peak of 0.25 on a music bus, for test/integration/e2e/audio.py and the
// browser check test/integration/web/audio_module.mjs. One period of a sine in 20 samples at
// 8800 Hz plays at 440 Hz whatever the rate of the output.
using box.audio

tone {
  Pcm: {
    samples: [0, 0.0772542, 0.146946, 0.202254, 0.237764, 0.25, 0.237764, 0.202254, 0.146946,
      0.0772542, 0, -0.0772542, -0.146946, -0.202254, -0.237764, -0.25, -0.237764, -0.202254,
      -0.146946, -0.0772542],
    sample_rate: 8800
  }
}

music {
  Bus: {volume: 1}
}

tone_source {
  Source: {sound: tone, loop: true}
  Output: {bus: music}
}

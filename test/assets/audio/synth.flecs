// Synth sounds for the Synth suite of test/cpu/audio: the click of docs/audio.md on a ui bus,
// and a steady tone whose frequency the suite changes between two plays.
using box.audio
using box.audio.synth

ui {
  Bus: {volume: 1}
}

prefab UiClick {
  Output: {bus: ui}
  Sound: {pitch_variance: 0.05}
  Envelope: {attack: 0.001, decay: 0.03}
  noise { Oscillator: {wave: Noise, level: 0.6} }
  tone { Oscillator: {wave: Sine, frequency: 1800, frequency_end: 900, sweep: 0.03, level: 0.4} }
}

// A sine of 440 Hz at 0.5 for 0.2 seconds
prefab Beep {
  Sound: {}
  Envelope: {attack: 0.005, sustain: 1, hold: 0.2, release: 0.005}
  Oscillator: {wave: Sine, frequency: 440, level: 0.5}
}

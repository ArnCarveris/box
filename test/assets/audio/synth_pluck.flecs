// Pluck examples and the harp of the Mossvale score: the
// Synth suite of test/cpu/audio checks that they parse, compile without errors, play and end.
using box.audio
using box.audio.synth

music { Bus: {volume: 1} }

// A guitar: a steel string on G3 plucked with a pick, through the lowpass of its body, 3 s,
// with a vibrato of 10 cents at 5.5 Hz that the finger brings in once the note is held
prefab Guitar {
  Output: {bus: music}
  Sound: {level_variance: 0.05}
  Filter: {kind: LowPass, cutoff: 4500}
  string {
    Oscillator: {wave: Pluck, frequency: 196, level: 0.6}
    String: {decay: 3, brightness: 0.6, hardness: 0.9}
    Lfo: {rate: 5.5, delay: 0.4, fade: 0.5, pitch: 10}
  }
}

// A 12 string guitar: G3 strung as a pair of steel strings 6 cents apart across half of the
// stereo field, with a quieter octave string in the center, 3 strings, 3 s
prefab TwelveString {
  Output: {bus: music}
  Sound: {level_variance: 0.05}
  Filter: {kind: LowPass, cutoff: 5000}
  string {
    Oscillator: {wave: Pluck, frequency: 196, level: 0.6}
    Unison: {voices: 2, detune: 6, width: 0.5}
    String: {decay: 3, brightness: 0.6, hardness: 0.9}
  }
  octave {
    Oscillator: {wave: Pluck, frequency: 392, level: 0.2}
    String: {decay: 2, brightness: 0.7, hardness: 0.9}
  }
}

// A koto: a bright silk string on D4 plucked with a hard pick, pressed up a semitone after
// the pluck, and a quieter string an octave up that dies sooner, 1.5 s
prefab Koto {
  Output: {bus: music}
  Sound: {}
  string {
    Oscillator: {wave: Pluck, frequency: 293.66, frequency_end: 311.13, sweep: 0.25, level: 0.5}
    String: {decay: 1.5, brightness: 0.8, hardness: 1}
  }
  octave {
    Oscillator: {wave: Pluck, frequency: 587.33, frequency_end: 622.25, sweep: 0.25, level: 0.12}
    String: {decay: 0.6, brightness: 0.7, hardness: 1}
  }
}

// The harp of the Mossvale score (etc/scenes/mossvale/music.flecs): a gut string plucked with
// a finger, which rings out on its own, over a soft sine for the body of the soundboard
template Harp {
  prop f: f32 = 220
  Output: {bus: music}
  Sound: {level_variance: 0.1}
  Filter: {kind: LowPass, cutoff: 3500, resonance: 0.05}
  pluck { Oscillator: {wave: Pluck, frequency: f, level: 0.45}; String: {decay: 2.2, brightness: 0.35, hardness: 0.45} }
  body { Oscillator: {wave: Sine, frequency: f, level: 0.12}; Envelope: {attack: 0.004, decay: 1.2, curve: 4.5} }
}

Harp hp_c3(f: 130.81)
Harp hp_a4(f: 440)

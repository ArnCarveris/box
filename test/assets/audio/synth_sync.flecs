// The sounds the SynthSync suite of test/cpu/audio measures hard sync from script with.
using box.audio
using box.audio.synth

// A sync lead: a saw at 220 Hz synced at a ratio of 2.5, which an LFO sweeps by an octave
prefab SyncLead {
  Sound: {}
  Envelope: {attack: 0.005, decay: 0.1, sustain: 0.7, hold: 0.3, release: 0.1}
  Oscillator: {wave: Saw, frequency: 220, level: 0.3, sync: 2.5}
  Lfo: {wave: LfoTriangle, rate: 2, hard_sync: 12}
}

// The defaults: no sync
prefab Plain {
  Sound: {}
  Envelope: {attack: 0.005, sustain: 1, hold: 0.1, release: 0.05}
  Oscillator: {frequency: 440, level: 0.3}
}

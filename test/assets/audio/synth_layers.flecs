// Layers for the Synth suite of test/cpu/audio: a sound with BOX_AUDIO_SYNTH_LAYERS (8) layers,
// the root and seven children, and one with a ninth, which logs one error and is left out.
using box.audio
using box.audio.synth

prefab Octet {
  Sound: {}
  Envelope: {attack: 0.01, decay: 0.2}
  Oscillator: {frequency: 100, level: 0.05}
  b { Oscillator: {frequency: 200, level: 0.05} }
  c { Oscillator: {frequency: 300, level: 0.05} }
  d { Oscillator: {frequency: 400, level: 0.05} }
  e { Oscillator: {frequency: 500, level: 0.05} }
  f { Oscillator: {frequency: 600, level: 0.05} }
  g { Oscillator: {frequency: 700, level: 0.05} }
  h { Oscillator: {frequency: 800, level: 0.05} }
}

prefab Wide {
  Sound: {}
  Envelope: {attack: 0.01, decay: 0.1}
  a { Oscillator: {frequency: 100, level: 0.05} }
  b { Oscillator: {frequency: 200, level: 0.05} }
  c { Oscillator: {frequency: 300, level: 0.05} }
  d { Oscillator: {frequency: 400, level: 0.05} }
  e { Oscillator: {frequency: 500, level: 0.05} }
  f { Oscillator: {frequency: 600, level: 0.05} }
  g { Oscillator: {frequency: 700, level: 0.05} }
  h { Oscillator: {frequency: 800, level: 0.05} }
  i { Oscillator: {frequency: 900, level: 0.05} }
}

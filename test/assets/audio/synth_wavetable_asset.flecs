// The sounds the SynthWavetableAsset suite of test/cpu/audio loads wavetables from a file with.
using box.audio

// 8 frames of 2048 samples from a saw to a square, written by make_sounds.py
SawSquareFile {
  SoundFile: {path: "test/assets/audio/wavetable_saw_square.wav"}
}

// The table of the file at its frames of 2048 samples
prefab SawSquare {
  Wavetable: {sound: SawSquareFile}
}

// The same file cut into frames of 1024 samples, twice the frames
prefab SawSquareHalf {
  Wavetable: {sound: SawSquareFile, frame_size: 1024}
}

// A note of 200 Hz on frame 0 of the table, the saw
prefab Morph {
  SynthSound: {}
  SynthEnvelope: {attack: 0.005, sustain: 1, hold: 0.2, release: 0.01}
  SynthOscillator: {wave: SynthWavetable, frequency: 200, level: 0.3}
  SynthTable: {table: SawSquare, position: 0}
}

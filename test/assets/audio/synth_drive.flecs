// The sounds the SynthPreDrive suite of test/cpu/audio measures the drive of the mix from
// script with.
using box.audio
using box.audio.synth

// A growling bass: a saw and a square driven hard and a little asymmetric, into a lowpass
prefab Growl {
  Sound: {}
  Drive: {drive: 0.8, asymmetry: 0.25}
  Envelope: {attack: 0.005, decay: 0.1, sustain: 0.8, hold: 0.3, release: 0.1}
  Filter: {kind: LowPass, cutoff: 900, resonance: 0.3}
  Oscillator: {wave: Saw, frequency: 55, level: 0.6}
  square { Oscillator: {wave: Square, frequency: 110, level: 0.3} }
}

// The defaults: a drive of 0.3, symmetric, without a filter
prefab Warm {
  Sound: {}
  Drive: {}
  Envelope: {attack: 0.005, sustain: 1, hold: 0.1, release: 0.05}
  Oscillator: {frequency: 220, level: 0.5}
}

// No drive at all
prefab Clean {
  Sound: {}
  Envelope: {attack: 0.005, sustain: 1, hold: 0.1, release: 0.05}
  Oscillator: {frequency: 220, level: 0.5}
}

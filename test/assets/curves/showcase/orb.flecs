// A magic orb: a glowing ball whose halo and light pulse together every 1.2 s, and motes that
// rise around it on helices, two turns over their life, each on a radius of its own.

using box.curve
using box.light
using box.material
using box.transform
using box.geometry
using box.particle

orb {
  ball {
    Position: {0, 1.2, 0}
    Sphere: {segments: 32, smooth: true, radius: 0.22}
    Rgb: {150, 190, 255}
    Emissive: {strength: 3, color: {120, 170, 255}}
  }

  // The halo and the light share the period of 1.2 s. The light is a smooth loop: a Bezier
  // with flat slopes at the ends and at the peak, so the wrap has no corner. The rate of the
  // halo follows the same shape, so the halo thickens as the light brightens.
  halo {
    Position: {0, 1.2, 0}
    Rgb: {120, 160, 255}
    PointLight: {intensity: 3, range: 5}
    ParticleLight: {
      intensity: 3, period: 1.2, loop: true
      curve: {kind: CurveBezier, keys: [
        {time: 0, value: 0.4, out: 0}, {time: 0.5, value: 1.3, in: 0, out: 0},
        {time: 1, value: 0.4, in: 0}
      ]}
    }
    ParticleEmitter: {
      max: 200, rate: 80, shape: EmitterSphere, radius: 0.05, spread: 180,
      speed: {0.05, 0.1}, lifetime: {0.5, 0.7}, size: {0.6, 0.9},
      opacity: {0.2, 0.3}, color: {90, 140, 255}, seed: 31
    }
    ParticleForces: {gravity: {0, 0, 0}}
    ParticleAppearance: {blend: ParticleAdditive}
    ParticleTimeline: {
      period: 1.2, loop: true
      rate: {kind: CurveBezier, keys: [
        {time: 0, value: 0.2, out: 0}, {time: 0.5, value: 1, in: 0, out: 0},
        {time: 1, value: 0.2, in: 0}
      ]}
    }
    ParticleCurves: {
      size: {kind: CurveCatmullRom, keys: [{0, 0.6}, {0.5, 1}, {1, 1.2}]}
      opacity: {keys: [{0, 0}, {0.3, 1}, {1, 0}]}
    }
  }

  // The motes live exactly 2 s, so the velocity curves turn exactly two circles. A velocity
  // of amplitude A around a circle of angular speed w = 2 pi turns/s traces a radius A / w:
  // keys at quarter turns, cos on x and sin on z, with the slope of the sine, 4 pi A, at the
  // zero crossings. keys trace a radius of 0.25 (A = 1.57), max_keys 0.4 (A = 2.51), and each
  // mote takes its own radius between them, the same for both axes. The emitter lifts them
  // slowly while they turn, so each draws a helix.
  motes {
    Position: {0, 1.2, 0}
    ParticleEmitter: {
      max: 300, rate: 30, shape: EmitterSphere, radius: 0.45, spread: 15,
      speed: {0.15, 0.3}, lifetime: {2, 2}, size: {0.05, 0.08}, seed: 32
    }
    ParticleForces: {gravity: {0, 0, 0}}
    ParticleAppearance: {blend: ParticleAdditive, stretch: 0.03}
    ParticleMotion: {
      velocity_x: {
        kind: CurveBezier
        keys: [
          {time: 0, value: 1.57}, {time: 0.125, value: 0, in: -19.74, out: -19.74},
          {time: 0.25, value: -1.57}, {time: 0.375, value: 0, in: 19.74, out: 19.74},
          {time: 0.5, value: 1.57}, {time: 0.625, value: 0, in: -19.74, out: -19.74},
          {time: 0.75, value: -1.57}, {time: 0.875, value: 0, in: 19.74, out: 19.74},
          {time: 1, value: 1.57}
        ]
        max_keys: [
          {time: 0, value: 2.51}, {time: 0.125, value: 0, in: -31.55, out: -31.55},
          {time: 0.25, value: -2.51}, {time: 0.375, value: 0, in: 31.55, out: 31.55},
          {time: 0.5, value: 2.51}, {time: 0.625, value: 0, in: -31.55, out: -31.55},
          {time: 0.75, value: -2.51}, {time: 0.875, value: 0, in: 31.55, out: 31.55},
          {time: 1, value: 2.51}
        ]
      }
      velocity_z: {
        kind: CurveBezier
        keys: [
          {time: 0, value: 0, out: 19.74}, {time: 0.125, value: 1.57},
          {time: 0.25, value: 0, in: -19.74, out: -19.74}, {time: 0.375, value: -1.57},
          {time: 0.5, value: 0, in: 19.74, out: 19.74}, {time: 0.625, value: 1.57},
          {time: 0.75, value: 0, in: -19.74, out: -19.74}, {time: 0.875, value: -1.57},
          {time: 1, value: 0, in: 19.74}
        ]
        max_keys: [
          {time: 0, value: 0, out: 31.55}, {time: 0.125, value: 2.51},
          {time: 0.25, value: 0, in: -31.55, out: -31.55}, {time: 0.375, value: -2.51},
          {time: 0.5, value: 0, in: 31.55, out: 31.55}, {time: 0.625, value: 2.51},
          {time: 0.75, value: 0, in: -31.55, out: -31.55}, {time: 0.875, value: -2.51},
          {time: 1, value: 0, in: 31.55}
        ]
      }
    }
    ParticleCurves: {
      color: {keys: [{0, {200, 230, 255}}, {0.5, {140, 170, 255}}, {1, {150, 90, 255}}]}
      size: {kind: CurveBezier, keys: [
        {time: 0, value: 1, out: 0}, {time: 1, value: 0.2, in: -2.4}
      ]}
      opacity: {keys: [{0, 0}, {0.15, 1}, {0.75, 1}, {1, 0}]}
    }
  }
}

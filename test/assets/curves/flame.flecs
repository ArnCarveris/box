// Flame to smoke: particles are born white hot, turn yellow and orange as they rise, darken to
// red and end as grey smoke that grows and fades, alpha blended so the smoke can darken.
using box.curve
using box.particle
using box.transform

flame {
  Position: {0, 0, 0}
  Emitter: {
    max: 600, rate: 120, shape: EmitterDisc, radius: 0.15, spread: 10,
    speed: {0.8, 1.2}, lifetime: {1.2, 1.8}, size: {0.25, 0.35}, seed: 4
  }
  Forces: {gravity: {0, 0.6, 0}, turbulence: 1.5}
  Curves: {
    color: {keys: [
      {0, {255, 255, 230}}, {0.15, {255, 210, 90}}, {0.35, {250, 120, 30}},
      {0.55, {120, 40, 20}}, {0.7, {60, 55, 55}}, {1, {45, 45, 45}}
    ]}
    size: {kind: CurveCatmullRom, keys: [{0, 0.6}, {0.4, 1}, {1, 2.5}]}
    opacity: {keys: [{0, 0}, {0.05, 1}, {0.6, 0.8}, {1, 0}]}
  }
}

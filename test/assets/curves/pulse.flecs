// Pulsing emission: the emitter breathes once a second, from nothing to 200 particles a second
// and back, and the particles of the peak leave twice as fast as those of the quiet part.
using box.curve
using box.particle
using box.transform

pulse {
  Position: {0, 0, 0}
  Emitter: {
    max: 1000, rate: 200, spread: 180, speed: {1, 1}, lifetime: {1, 1},
    size: {0.05, 0.05}, color: {120, 220, 255}, seed: 6
  }
  Forces: {gravity: {0, 0, 0}}
  Timeline: {
    period: 1, loop: true,
    rate: {kind: CurveCatmullRom, keys: [{0, 0}, {0.5, 1}, {1, 0}]}
    speed: {kind: CurveCatmullRom, keys: [{0, 0.5}, {0.5, 1}, {1, 0.5}]}
  }
}

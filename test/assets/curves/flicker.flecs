// Flicker on a light: the point light of a small fire wavers irregularly between 70% and 120% of
// its intensity, repeating every 0.7 s; the light goes out with the emitter when it stops.
using box.curve
using box.light
using box.material
using box.particle
using box.transform

campfire {
  Position: {0, 0, 0}
  Rgb: {255, 150, 60}
  PointLight: {intensity: 3, range: 6}
  ParticleEmitter: {
    rate: 60, shape: EmitterDisc, radius: 0.2, speed: {0.5, 1}, lifetime: {0.6, 0.9},
    size: {0.15, 0.25}, color: {255, 160, 60}, seed: 7
  }
  ParticleAppearance: {blend: ParticleAdditive}
  ParticleLight: {
    intensity: 3, period: 0.7, loop: true, fade: 0.3
    curve: {kind: CurveCatmullRom, keys: [
      {0, 1}, {0.12, 0.75}, {0.25, 1.1}, {0.4, 0.85}, {0.55, 1.2}, {0.7, 0.7}, {0.85, 1.05}, {1, 1}
    ]}
  }
}

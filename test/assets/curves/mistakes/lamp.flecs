// max_keys on a light, which has no random draw to blend two curves by
using box.curve
using box.light
using box.particle
using box.transform

lamp {
  Position: {0, 0, 0}
  PointLight: {}
  ParticleEmitter: {rate: 10}
  ParticleLight: {period: 1, curve: {keys: [{0, 1}, {1, 0}], max_keys: [{0, 2}, {1, 0}]}}
}

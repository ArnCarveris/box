// A scene whose async block copies box.app.Status.delta_time to delta_seen. core_tick is an async
// function of the test that resolves in the next frame; the engine writes box.app.Status at the end of
// a frame, so the block reads it in the second frame.
using box.app

export mut delta_seen: f64 = 0

async {
  await core_tick()
  delta_seen = box.app.Status[box.app.Status].delta_time
}

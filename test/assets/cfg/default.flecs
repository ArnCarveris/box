include hud

using flecs.script
using box.transform
using box.camera
using box.view
using box.effects
using box.surface
using box.controllers
using box.geometry
using box.material
using box.light
using box.atmosphere
using box.layout
using box.text
using box.input
using box.picking
using box.ui
using box.widgets

window {
  Surface: {width: 1280, height: 720, vsync: true}
}

gtao {
  Gtao: {radius: 0.6, final_value_power: 2.2}
}

sun {
  DirectionalLight: {intensity: 1.4 * math.PI}
  Rgb: {255, 255, 255}
}

sky {
  Atmosphere: {
    sun: sun,
    units_per_km: 100,
    rayleigh: {scale_height: 8, scattering_scale: 3},
    ozone_scale: 4,
    sun_disk_intensity: 10,
    sun_radius: 0.75
  }

  TimeOfDay: {
    hour: hud.screen.options.body.hour[Slider.mut].current,
    day_of_year: hud.screen.options.body.day_of_year[Slider.mut].current,
    latitude: hud.screen.options.body.latitude[Slider.mut].current,
    north: hud.screen.options.body.north[Slider.mut].current,
    sun: sun
  }

  HeightFog: {
    density: hud.screen.options.body.fog[Slider.mut].current,
    falloff: 0.1,
    base_height: 0,
    max_opacity: 0.25,
    atmosphere: sky
  }
}

exposure {
  AutoExposure: {min_log_luma: -10.8}
}

bloom {
  Bloom: {intensity: 0.25, threshold: 1, threshold_softness: 0.5}
}

tonemap {
  Tonemap: {auto_exposure: exposure}
}

smaa {
  Smaa: {}
}

camera {
  Camera: {fov: 55, near_: 0.1}
  CameraController: {speed: 14, boost: 4, sensitivity: 0.003}
}

view {
  View: {
    camera: camera,
    clear: {enabled: true, color: {150, 178, 210, 255}},
    lighting: {
      enabled: true,
      baked: hud.screen.options.body.baked[Checkbox.mut].current,
      reflections: true,
      atmosphere: true,
      environment: {source: sky, intensity: 0.5, yaw: 0, background: false}
    },
    shadows: {
      enabled: hud.screen.options.body.shadows[Checkbox.mut].current,
      cascades: 4,
      resolution: 2048,
      max_distance: 200,
      split_lambda: 0.7,
      depth_bias: 2,
      normal_offset: 2,
      filter_size: 3,
      fade: 0.2,
      blend: 0.1
    },
    culling: {enabled: true, occlusion: true, min_dimension_px: 4},
    effects: [
      {enabled: hud.screen.options.body.gtao[Checkbox.mut].current, effect: gtao},
      {enabled: true, effect: sky},
      {enabled: true, effect: bloom},
      {enabled: true, effect: tonemap},
      {enabled: true, effect: smaa}
    ]
  }
}

$ {
  Bake: {environment: sky, probe_spacing: 1, bounds_padding: -0.3, capture_size: 16, bounces: 0, budget_ms: 8}
}

// Fixed description of a GenBlocks height field with a two-tone checker, jittered and staggered,
// with its albedo through a palette and a ramp and its normal map, whose bytes the Gen
// tests hash so a change of the output is noticed.

using box.texture

blocks_tones_height {
  Gen: {
    width: 64, height: 48, seed: 5
    layers: [
      {kind: GenBlocks, courses: 4, per_course: 4, gap: 0.04, jitter: 0.2, stagger: 0.5,
       tones: 2, tone_order: GenToneChecker, tone_amount: 0.1, amount: 0.8, id_amount: 0.1}
      {kind: GenNoise, frequency: 8, octaves: 2, amount: 0.1}
    ]
  }
}

blocks_tones_albedo {
  Gen: {source: blocks_tones_height, output: GenAlbedo,
               palette: [{92, 103, 101}, {39, 53, 55}],
               colors: [{0, {120, 120, 120}}, {0.6, {235, 235, 235}}, {1, {255, 255, 255}}]}
}

blocks_tones_normal {
  Gen: {source: blocks_tones_height, output: GenNormal, strength: 2}
}

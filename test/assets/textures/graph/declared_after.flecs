// A graph whose output node is declared before the graph and gets its node component after it.

using box.texture

panel {
  tinted {}
  Graph: {output: tinted, width: 64, height: 32, format: GraphLinear}
  uv { nodes.Coords: {scale: 2} }
  tinted { nodes.Mix: {a: uv, b_value: {1, 0, 0, 1}, factor_value: {0.5, 0.5, 0.5, 0.5}} }
}

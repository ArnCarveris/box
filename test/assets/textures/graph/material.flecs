// A quad that shows the emission of a texture graph: a black metal with a white emission that
// the image of a constant red graph multiplies, framed by a camera over a black clear.

using box.transform
using box.geometry
using box.material
using box.texture
using box.camera
using box.view

graph_material {
  camera {
    Position: {0, 0, 4}
    Camera: {fov: 60}
  }

  view {
    View: {camera: camera, clear: {enabled: true, color: {0, 0, 0, 255}}}
  }

  image {
    red { TexConstant: {value: {1, 0, 0, 1}} }
    TextureGraph: {output: red, width: 16}
  }

  quad {
    Position: {0, 0, 0}
    Quad: {6, 6}
    Rgb: {0, 0, 0}
    PbrMaterial: {metallic: 1, roughness: 1}
    Emissive: {strength: 1, color: {255, 255, 255}}
    PbrTextures: {emissive: image}
  }
}

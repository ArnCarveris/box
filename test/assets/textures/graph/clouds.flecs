// A cloud layer as a template: a static sky gradient, and coordinates that drift with the world
// clock at a speed of its own, the brighter of the two. The sky and the coordinates are static
// stages, so every layer of one size shares their cached values, whatever its speed; only the
// output stage runs at each update.

using flecs.script
using box.texture

clouds {
  @tree Parent
  template CloudLayer {
    prop speed: f32 = 0.02
    prop rate: f32 = 30
    prop size: i32 = 512

    uv { nodes.Coords: {scale: 1} }
    sky { nodes.Mix: {a_value: {0.35, 0.55, 0.85, 1}, b_value: {0.8, 0.9, 1, 1}, factor: uv} }
    time { nodes.Time: {scale: speed, offset: 0} }
    drift { nodes.Splat: {in: time} }
    moved { nodes.Add: {a: uv, b: drift} }
    puffs { nodes.Multiply: {a: moved, b_value: {0.9, 0.9, 0.95, 1}} }
    out { nodes.Max: {a: sky, b: puffs} }
    Graph: {output: out, width: size, height: size, domain: DomainPlane, format: GraphColor, rate: rate}
  }
}

// The face of a cooling fan, the FanDisc of the original: the blades texture and its normal map
// on a quad. The factory wears it, a face_front and a face_back back to back.
//
// The blades are a round fan on a transparent background. The original has no alpha test, so its
// transparent corners draw (and cast shadows) as a solid square; here the quad is alpha tested
// (AlphaCutoff, as the flora), so the fan draws round in the opaque pass and casts a round shadow.

using box.geometry
using box.material
using box.texture

fan_tex {
  Path: {
    path: "test/assets/materials/fan_blades.svg", width: 256, height: 256, linear: true
  }
}

fan_norm {
  Path: {path: "test/assets/materials/fan_blades_normal.svg", width: 256, height: 256}
}

prefab FanDisc {
  Quad: {1.02, 1.02}
  Rgb: {255, 255, 255}
  PbrMaterial: {metallic: 0.62, roughness: 0.34}
  PbrTextures: {albedo: fan_tex, normal: fan_norm}
  AlphaCutoff: {value: 0.5}
}

using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.animation
using box.curve
using state
using assets

state {
  // Scenery recycles over SCENERY_SPAN units: it scrolls toward +Z with distance and jumps
  // back up the lagoon once it passes SCENERY_BEHIND, behind the camera. Near the far end it
  // grows in over SCENERY_FADE units, so a recycled section never pops in sight
  export const SCENERY_SPAN: f32 = 252
  export const SCENERY_BEHIND: f32 = 18
  export const SCENERY_FADE: f32 = 70
  export const SECTIONS: i32 = 6
  export const SECTION_LEN: f32 = 42
  // The outer shore of a bank, from the bank line: beyond it lies the open sea
  export const SEA_U: f32 = 34
  // A stilt hut: the stilts stand HUT_STILT_X to either side of its origin, the deck is at
  // HUT_DECK_Y. Its water side stilts stand in the wet sand just up from the waterline
  export const HUT_STILT_X: f32 = 1.5
  export const HUT_STILT_R: f32 = 0.1
  export const HUT_DECK_Y: f32 = 1.7
  export const HUT_U: f32 = BANK_WATER_U + HUT_STILT_X + HUT_STILT_R + 0.25
  // Beached rocks keep ROCK_DRY clear of the waterline
  export const ROCK_DRY: f32 = 0.15

  // The far islands out at sea scroll by FAR_PARALLAX of distance over a longer span
  export const FAR_SPAN: f32 = 1100
  export const FAR_BEHIND: f32 = 60
  export const FAR_FADE: f32 = 220
  export const FAR_PARALLAX: f32 = 0.3
  export const FAR_ISLANDS: i32 = 10

  export const PALM_SWAY_TIME: f32 = 6
  export const FROND_FLUTTER_TIME: f32 = 2.4

  // Z of scenery placed at base along the lagoon, scrolled by distance and wrapped
  fn scroll_z(base: f64, d: f64) -> f64 {
    SCENERY_BEHIND - SCENERY_SPAN * fract((base - d) / SCENERY_SPAN)
  }

  // Scale of scenery at z: 0 at the far end of the span, 1 once SCENERY_FADE nearer
  fn scenery_fade(z: f64) -> f64 {
    const t = clamp((z - SCENERY_BEHIND + SCENERY_SPAN) / SCENERY_FADE, 0, 1)
    max(0.01, t * t * (3 - 2 * t))
  }

  fn far_z(base: f64, d: f64) -> f64 {
    FAR_BEHIND - FAR_SPAN * fract((base - d * FAR_PARALLAX) / FAR_SPAN)
  }

  fn far_fade(z: f64) -> f64 {
    const t = clamp((z - FAR_BEHIND + FAR_SPAN) / FAR_FADE, 0, 1)
    max(0.01, t * t * (3 - 2 * t))
  }
}

assets {
  prefab LgSandIsle {
    Rgb: {255, 255, 255}
    PbrMaterial: {roughness: 1}
    PbrTextures: {albedo: lg_sand_dry_a, normal: lg_sand_n}
    texture.Mapping: {mode: MappingObject, size: 6, blend: 0.3}
  }

  prefab LgSandIsleWet {
    Rgb: {255, 255, 255}
    PbrMaterial: {roughness: 0.7}
    PbrTextures: {albedo: lg_sand_wet_a, normal: lg_sand_n}
    texture.Mapping: {mode: MappingObject, size: 6, blend: 0.3}
  }

  prefab LgBeachRock {
    Rgb: {200, 196, 190}
    PbrMaterial: {roughness: 0.9}
    PbrTextures: {albedo: lg_coral_a, normal: lg_coral_n}
    texture.Mapping: {mode: MappingObject, size: 1.5, blend: 0.3}
  }

  prefab LgBushLeaf {
    Rgb: {62, 140, 50}
    PbrMaterial: {roughness: 0.8}
    DiffuseTransmission: {factor: 0.35, color: {170, 230, 100}}
  }

  prefab LgBushDark {
    Rgb: {40, 104, 44}
    PbrMaterial: {roughness: 0.85}
    DiffuseTransmission: {factor: 0.3, color: {150, 210, 100}}
  }

  prefab LgHibiscusRed {
    Rgb: {216, 34, 50}
    PbrMaterial: {roughness: 0.6}
    Sheen: {color: {255, 150, 150}, roughness: 0.4}
    DiffuseTransmission: {factor: 0.4, color: {255, 90, 90}}
  }

  prefab LgHibiscusYellow {
    Rgb: {248, 196, 36}
    PbrMaterial: {roughness: 0.6}
    Sheen: {color: {255, 236, 150}, roughness: 0.4}
    DiffuseTransmission: {factor: 0.4, color: {255, 220, 90}}
  }

  prefab LgHutWall {
    Rgb: {190, 152, 96}
    PbrMaterial: {roughness: 0.95}
    Sheen: {color: {255, 230, 180}, roughness: 0.5}
  }

  prefab LgHutDark { Rgb: {58, 40, 28}; PbrMaterial: {roughness: 0.9} }
  prefab LgFarSand { Rgb: {222, 206, 168}; PbrMaterial: {roughness: 1} }
  prefab LgFarGreen { Rgb: {52, 100, 56}; PbrMaterial: {roughness: 1} }
  prefab LgFarPalm { Rgb: {40, 82, 44}; PbrMaterial: {roughness: 1} }

  // The crown of a palm rocks slowly in the breeze
  prefab lg_palm_sway {
    Clip: {duration: PALM_SWAY_TIME}
    roll { Track: {component: Rotation, member: "z", curve: {kind: CurveCatmullRom, keys: [
      {0, 0}, {1, 0.07}, {2.5, -0.03}, {3.5, -0.075}, {5, 0.04}, {6, 0}
    ]}} }
    pitch { Track: {component: Rotation, member: "x", curve: {kind: CurveCatmullRom, keys: [
      {0, 0}, {1.5, 0.05}, {3, 0}, {4.5, -0.05}, {6, 0}
    ]}} }
  }

  // Each frond flaps up and down on its own beat
  prefab lg_frond_flutter {
    Clip: {duration: FROND_FLUTTER_TIME}
    lift { Track: {component: Rotation, member: "x", curve: {kind: CurveCatmullRom, keys: [
      {0, 0}, {0.6, -0.12}, {1.2, -0.01}, {1.8, 0.07}, {2.4, 0}
    ]}} }
  }

  // A palm frond: a strip folded down along its midrib, swept along an arch that rises out of
  // the crown and droops at the tip. Two arches so the crowns do not all look alike
  prefab LgFrondLeaf {
    Rgb: {64, 132, 52}
    PbrMaterial: {roughness: 0.8}
    DiffuseTransmission: {factor: 0.4, color: {190, 240, 110}}
    BackFaceMode: {BackFacePlain}
  }

  prefab lg_frond_fold {
    Path2D: {
      start: {-0.5, 0.12},
      segments: [{kind: Line, end: {0, 0}}, {kind: Line, end: {0.5, 0.12}}]
    }
  }

  prefab lg_frond_arch_a { Path3D: {start: {0, 0, 0}, segments: [
    {kind: CatmullRom, end: {0, 0.35, 1.1}}, {kind: CatmullRom, end: {0, 0.3, 2.2}},
    {kind: CatmullRom, end: {0, -0.3, 3.1}}, {kind: CatmullRom, end: {0, -1.1, 3.6}}
  ]} }
  prefab lg_frond_arch_b { Path3D: {start: {0, 0, 0}, segments: [
    {kind: CatmullRom, end: {0, 0.15, 1.2}}, {kind: CatmullRom, end: {0, -0.1, 2.3}},
    {kind: CatmullRom, end: {0, -0.8, 3.1}}, {kind: CatmullRom, end: {0, -1.6, 3.4}}
  ]} }
  prefab lg_trunk_round { Path2D: {start: {1, 0}, closed: true, segments: [
    {kind: CatmullRom, end: {0, -1}},
    {kind: CatmullRom, end: {-1, 0}},
    {kind: CatmullRom, end: {0, 1}}
  ]} }
  prefab lg_trunk_profile { Profile2D: {outer: lg_trunk_round} }

  // A palm of height whose curved trunk leans sideways by lean * height at the top, with a
  // crown of drooping fronds and a cluster of coconuts. Seed varies the crown and the sway phase
  template LgPalm {
    prop height: f32 = 7
    prop lean: f32 = 0.25
    prop fronds: i32 = 8
    prop seed: i32 = 1
    const rng: flecs.script.math.Rng = {seed: seed}
    const yaw = rng.f(6.28)
    const phase = rng.f(1)
    const nuts = 2 + floor(rng.f(2.99))

    trunk_path {
      Path3D: {start: {0, 0, 0}, segments: [
        {kind: CatmullRom, end: {lean * height * 0.0625, height * 0.25, 0}},
        {kind: CatmullRom, end: {lean * height * 0.25, height * 0.5, 0}},
        {kind: CatmullRom, end: {lean * height * 0.5625, height * 0.75, 0}},
        {kind: CatmullRom, end: {lean * height, height, 0}}
      ]}
    }

    trunk : LgPalmBark {
      Position: {0, 0, 0}
      Sweep: {
        path: trunk_path,
        profile: lg_trunk_profile,
        scale: {0.24, 0.24},
        taper: 0.6,
        segments: 7,
        rings: 10,
        cap_start: false
      }
    }

    crown {
      Position: {lean * height, height, 0}
      sway {
        Rotation: {0, 0, 0}
        Animator: {clip: lg_palm_sway, time: phase * PALM_SWAY_TIME, speed: 0.8 + phase * 0.4}
        spin {
          Rotation: {0, yaw, 0}
          top : LgFrondDark {
            Position: {0, 0.02, 0}
            Scale: {1, 0.7, 1}
            Sphere: {radius: 0.3, segments: 8}
          }

          for c in 0..4 {
            if c < nuts {
              "nut_{c}" : LgCoconut {
                Position: {0.24 * cos(c * 1.9), -0.26 - 0.06 * (c % 2), 0.24 * sin(c * 1.9)}
                Sphere: {radius: 0.16, segments: 8, smooth: true}
              }
            }
          }

          for f in 0..fronds {
            const fs = 0.85 + 0.3 * hash(seed * 5 + f)
            "frond_{f}" {
              Rotation: {0, f * 6.2832 / fronds + 0.25 * sin(f * 1.7 + yaw), 0}
              droop {
                Rotation: {0.25 * hash(seed * 13 + f) - 0.1, 0, 0}
                flutter {
                  Rotation: {0, 0, 0}
                  Animator: {
                    clip: lg_frond_flutter,
                    time: fract(phase + f * 0.37) * FROND_FLUTTER_TIME,
                    speed: 0.9 + 0.25 * hash(seed + f * 7)
                  }

                  if (f + seed) % 2 == 0 {
                    leaf : LgFrondLeaf {
                      Scale: {fs, fs, fs}
                      Sweep: {
                        path: lg_frond_arch_a,
                        contour: lg_frond_fold,
                        scale: {1.1, 1.1},
                        taper: 0.15,
                        segments: 2,
                        rings: 10
                      }
                    }
                  } else {
                    leaf : LgFrondLeaf {
                      Scale: {fs, fs, fs}
                      Sweep: {
                        path: lg_frond_arch_b,
                        contour: lg_frond_fold,
                        scale: {1.1, 1.1},
                        taper: 0.15,
                        segments: 2,
                        rings: 10
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  // A rounded tropical bush dotted with hibiscus flowers, red or yellow
  template LgBush {
    prop size: f32 = 1
    prop seed: i32 = 1
    const rng: flecs.script.math.Rng = {seed: seed}
    const red = rng.f(1) < 0.6
    const a = rng.f(6.28)

    body : LgBushLeaf {
      Position: {0, 0.45 * size, 0}
      Scale: {1.2, 0.8, 1}
      Sphere: {radius: 0.75 * size, segments: 8, smooth: true}
    }

    side : LgBushDark {
      Position: {0.6 * size * cos(a), 0.3 * size, 0.6 * size * sin(a)}
      Sphere: {radius: 0.5 * size, segments: 8, smooth: true}
    }

    for k in 0..3 {
      const fa = a + 1.2 + k * 2.1
      const fr = 0.55 * size

      if red {
        "flower_{k}" : LgHibiscusRed {
          Position: {fr * cos(fa), (0.62 + 0.12 * (k % 2)) * size, fr * sin(fa)}
          Scale: {1, 0.5, 1}
          Sphere: {radius: 0.16, segments: 6}
          NoShadow
        }
      } else {
        "flower_{k}" : LgHibiscusYellow {
          Position: {fr * cos(fa), (0.62 + 0.12 * (k % 2)) * size, fr * sin(fa)}
          Scale: {1, 0.5, 1}
          Sphere: {radius: 0.16, segments: 6}
          NoShadow
        }
      }
    }
  }

  // A thatched hut on stilts standing at the waterline. Along -X, toward the water, at the
  // origin; the gangway reaches back to the beach along +X. The water side stilts are
  // HUT_STILT_X from the origin, below the deck at HUT_DECK_Y nothing reaches further out
  template LgStiltHut {
    const DECK_Y: f32 = HUT_DECK_Y

    for k in 0..4 {
      const sx = k % 2 == 0 ? 0 - HUT_STILT_X : HUT_STILT_X
      const sz = k < 2 ? -1.3 : 1.3
      "stilt_{k}" : LgCanoeDark {
        Position: {sx, DECK_Y / 2 - 0.6, sz}
        Cylinder: {length: DECK_Y + 1.2, radius: HUT_STILT_R, segments: 6}
      }
    }

    deck : LgCanoeWood { Position: {0, DECK_Y, 0}; Box: {3.8, 0.16, 3.4} }
    walls : LgHutWall { Position: {0.2, DECK_Y + 0.78, 0}; Box: {2.6, 1.4, 2.4} }
    door : LgHutDark { Position: {-1.11, DECK_Y + 0.62, 0.3}; Box: {0.04, 1.05, 0.7} }
    window : LgHutDark { Position: {-1.11, DECK_Y + 0.9, -0.65}; Box: {0.04, 0.45, 0.5} }
    roof : LgStraw {
      Position: {0.2, DECK_Y + 2.25, 0}
      Rotation: {0, 0.785, 0}
      Cone: {length: 1.6, radius: 2.5, segments: 4}
    }

    peak : LgStraw {
      Position: {0.2, DECK_Y + 3.15, 0}
      Cone: {length: 0.4, radius: 0.12, segments: 5}
    }

    for k in 0..2 {
      "rail_{k}" : LgCanoeDark {
        Position: {-1.85, DECK_Y + 0.4, k == 0 ? -1.6 : 1.6}
        Box: {0.08, 0.7, 0.08}
      }
    }

    gangway : LgCanoeWood {
      Position: {3.4, DECK_Y - 0.6, 0.9}
      Rotation: {0, 0, -0.38}
      Box: {3.4, 0.1, 0.8}
    }
  }

  // A small sandy islet with one palm, a rock and a bush, about radius across
  template LgIslet {
    prop radius: f32 = 1.7
    prop seed: i32 = 1
    const rng: flecs.script.math.Rng = {seed: seed}
    const lean = 0.15 + rng.f(0.2)
    const ra = rng.f(6.28)

    shallows : LgSandIsleWet {
      Position: {0, -0.22, 0}
      Scale: {1.3, 0.1, 1.15}
      Sphere: {radius: radius, segments: 16, smooth: true}
      NoShadow
    }

    mound : LgSandIsle {
      Position: {0, -0.12, 0}
      Scale: {1, 0.22, 0.9}
      Sphere: {radius: radius, segments: 16, smooth: true}
    }

    palm {
      Position: {0, 0.15, 0}
      Rotation: {0, rng.f(6.28), 0}
      LgPalm tree(height: 5 + rng.f(2), lean: lean, fronds: 7, seed: seed * 5 + 3)
    }

    rock : LgBeachRock {
      Position: {radius * 0.7 * cos(ra), 0.05, radius * 0.7 * sin(ra)}
      Rotation: {0.3, ra, 0.2}
      Scale: {1.2, 0.7, 1}
      Sphere: {radius: 0.35, segments: 6}
    }

    bush {
      Position: {radius * 0.45 * cos(ra + 2.4), 0.1, radius * 0.45 * sin(ra + 2.4)}
      LgBush b(size: 0.6, seed: seed * 3 + 1)
    }
  }

  // One stretch of bank, SECTION_LEN long toward +Z from its origin on the bank line of side
  // (-1 left, 1 right). Local X is mirrored by side, so -X points to the water. The water stays
  // clear: rocks lie on the wet slope, the hut stands at the waterline, the islet out at sea
  template LgBankSection {
    prop side: f32 = 1
    prop seed: i32 = 1
    prop hut: bool = false
    prop islet: bool = false
    const rng: flecs.script.math.Rng = {seed: seed}
    const palms = hut ? 1 : (rng.f(1) < 0.35 ? 3 : 2)

    for p in 0..3 {
      if p < palms {
        const pz = (p + 0.15 + rng.f(0.7)) * SECTION_LEN / palms
        // The palm of a hut section stands inland of the hut and its gangway
        "palm_{p}" {
          Position: {side * (hut ? 5.4 + rng.f(2.6) : 1.2 + rng.f(6)), BEACH_Y - 0.08, pz}
          Rotation: {0, side * (rng.f(0.9) - 0.45), 0}
          LgPalm tree(
            height: 5.5 + rng.f(3.5),
            lean: (0 - side) * (0.12 + rng.f(0.22)),
            fronds: 6 + floor(rng.f(1.99)),
            seed: seed * 17 + p
          )
        }
      }
    }

    for b in 0..3 {
      const bs = 0.7 + rng.f(0.7)
      "bush_{b}" {
        Position: {side * (2 + rng.f(9)), BEACH_Y - 0.05, (b + 0.1 + rng.f(0.8)) * SECTION_LEN / 3}
        Rotation: {0, rng.f(6.28), 0}
        LgBush plant(size: bs, seed: seed * 11 + b)
      }
    }

    flowers {
      const fx = side * (4 + rng.f(6))
      const fz = rng.f(SECTION_LEN)
      Position: {fx, BEACH_Y - 0.03, fz}
      grass : LgBushDark {
        Position: {0, 0.02, 0}
        Scale: {1.6, 0.18, 1}
        Sphere: {radius: 0.9, segments: 8, smooth: true}
        NoShadow
      }

      for k in 0..4 {
        const fa = k * 1.57 + rng.f(1)

        if k % 2 == 0 {
          "bloom_{k}" : LgHibiscusRed {
            Position: {0.8 * cos(fa), 0.22, 0.5 * sin(fa)}
            Scale: {1, 0.5, 1}
            Sphere: {radius: 0.14, segments: 6}
            NoShadow
          }
        } else {
          "bloom_{k}" : LgHibiscusYellow {
            Position: {0.8 * cos(fa), 0.22, 0.5 * sin(fa)}
            Scale: {1, 0.5, 1}
            Sphere: {radius: 0.14, segments: 6}
            NoShadow
          }
        }
      }
    }

    const rocks = 1 + floor(rng.f(1.99))

    for r in 0..2 {
      if r < rocks {
        const rr = 0.4 + rng.f(0.5)
        // Out of the water on the wet slope: the widest reach of the rock, 1.3 rr, stays
        // ROCK_DRY above the waterline. Sunk to half its height into the slope
        const ru = BANK_WATER_U + ROCK_DRY + 1.3 * rr + rng.f(0.9)
        "rock_{r}" : LgBeachRock {
          Position: {
            side * ru,
            (ru - BANK_WATER_U) * tan(BANK_SLOPE),
            (r + 0.1 + rng.f(0.8)) * SECTION_LEN / 2
          }
          Rotation: {rng.f(0.6), rng.f(6.28), rng.f(0.6)}
          Scale: {1.3, 0.65, 1}
          Sphere: {radius: rr, segments: 6}
        }
      }
    }

    if hut {
      stilt_hut {
        Position: {side * HUT_U, 0, SECTION_LEN * 0.55}
        Rotation: {0, side < 0 ? 3.1416 : 0, 0}
        LgStiltHut house()
      }
    }

    if islet {
      const ir = 1.4 + rng.f(0.4)
      isle {
        // Out at sea, its shallows clear of the outer shore of the bank
        Position: {
          side * (SEA_U + 0.6 + ir * 1.3 + rng.f(2.5)),
          0,
          SECTION_LEN * (0.3 + rng.f(0.4))
        }
        LgIslet land(radius: ir, seed: seed * 7 + 5)
      }
    }
  }

  // A far island out at sea: sand ring, green hill and a few palm silhouettes
  template LgFarIsland {
    prop size: f32 = 20
    prop seed: i32 = 1
    const rng: flecs.script.math.Rng = {seed: seed}
    const hy = 0.25 + rng.f(0.25)

    beach : LgFarSand {
      Position: {0, -0.4, 0}
      Scale: {1.25, 0.04, 1}
      Sphere: {radius: size, segments: 20, smooth: true}
      NoShadow
    }

    hill : LgFarGreen {
      Position: {(rng.f(0.4) - 0.2) * size, 0, 0}
      Scale: {1, hy, 0.85}
      Sphere: {radius: size * 0.85, segments: 20, smooth: true}
      NoShadow
    }

    for k in 0..2 {
      const a = rng.f(6.28)
      const ph = 0.06 * size + rng.f(0.03 * size)
      "palm_{k}" {
        Position: {1.05 * size * cos(a), 0, 0.9 * size * sin(a)}
        trunk : LgPalmBark {
          Position: {0, ph / 2, 0}
          Rotation: {0, 0, rng.f(0.3) - 0.15}
          Frustum: {length: ph, radius_bottom: 0.03 * size, radius_top: 0.02 * size, segments: 5}
          NoShadow
        }

        top : LgFarPalm {
          Position: {0, ph, 0}
          Scale: {1, 0.45, 1}
          Sphere: {radius: 0.08 * size, segments: 6}
          NoShadow
        }
      }
    }
  }
}

banks {
  // The banks are long strips that scroll by whole texture repeats (step), with the sand
  // projected in the space of the strip, so it flows past with the scenery and the jump back
  // does not show. A wet beach rises from the waterline, then come the dry beach and dunes.
  //
  // The gentle wet slope meets the dry beach at BEACH_Y without a step (a steep one read as
  // water on the bank facing away from the low sun); under the water a shelf drops to the floor
  const step = 12
  const WATER_U: f32 = BANK_WATER_U
  const SLOPE: f32 = BANK_SLOPE
  const SLOPE_U: f32 = WATER_U + BEACH_Y / tan(SLOPE)
  const SLOPE_START: f32 = WATER_U - 0.4
  const SLOPE_LEN: f32 = (SLOPE_U - SLOPE_START) / cos(SLOPE)
  const SHELF: f32 = 0.32
  const SHELF_LEN: f32 = 1.4
  const STRIP_H: f32 = 0.3
  const TOP_LEN: f32 = 30.5

  for s in 0..2 {
    const side = s == 0 ? -1.0 : 1.0
    "bank_{s}" {
      Position: {side * BANK_X, 0, -530 + step * fract(distance / step)}
      texture.Frame
      beach : LgBankSandWet {
        Position: {
          side * ((SLOPE_START + SLOPE_U) / 2 + STRIP_H / 2 * sin(SLOPE)),
          (BEACH_Y + (SLOPE_START - WATER_U) * tan(SLOPE)) / 2 - STRIP_H / 2 * cos(SLOPE),
          0
        }
        Rotation: {0, 0, side * SLOPE}
        Box: {SLOPE_LEN, STRIP_H, 1140}
      }

      shelf : LgBankSandWet {
        Position: {
          side * (WATER_U - SHELF_LEN / 2 * cos(SHELF) + STRIP_H / 2 * sin(SHELF)),
          0 - SHELF_LEN / 2 * sin(SHELF) - STRIP_H / 2 * cos(SHELF),
          0
        }
        Rotation: {0, 0, side * SHELF}
        Box: {SHELF_LEN, STRIP_H, 1140}
      }

      top : LgBankSandDry {
        Position: {side * (SLOPE_U + TOP_LEN / 2), BEACH_Y - 0.25, 0}
        Box: {TOP_LEN, 0.5, 1140}
      }

      dune : LgBankSandDry {
        Position: {side * 22, 0.6, 0}
        Rotation: {0, 0, side * -0.08}
        Box: {16, 0.6, 1140}
      }

      shore : LgBankSandWet {
        Position: {side * 32.6, -0.05, 0}
        Rotation: {0, 0, side * -0.3}
        Box: {2.6, 0.3, 1140}
      }
    }
  }
}

sections {
  for s in 0..2 {
    const side = s == 0 ? -1.0 : 1.0

    for i in 0..SECTIONS {
      const base = (i + s * 0.5) * SECTION_LEN
      "sec_{s}_{i}" {
        Position: {side * BANK_X, 0, scroll_z(base, distance)}
        Scale: {
          scenery_fade(scroll_z(base, distance)),
          scenery_fade(scroll_z(base, distance)),
          scenery_fade(scroll_z(base, distance))
        }
        LgBankSection stretch(
          side: side,
          seed: 101 + s * 53 + i * 7,
          hut: i == 2 + s * 3,
          islet: i % 3 == s
        )
      }
    }
  }
}

jungle {
  // A band of undergrowth along each dune, scrolled with the banks, and low green hills on it
  const step = 12

  for s in 0..2 {
    const side = s == 0 ? -1.0 : 1.0
    "band_{s}" : LgBushDark {
      Position: {side * (BANK_X + 16), 0.2, -530 + step * fract(distance / step)}
      Scale: {8, 3, 570}
      Sphere: {radius: 1, segments: 24, smooth: true}
      NoShadow
    }
  }

  for i in 0..20 {
    const side = i % 2 == 0 ? -1.0 : 1.0
    const base = i * (SCENERY_SPAN / 20) + hash(i * 13) * 8
    const x = side * (BANK_X + 13 + hash(i * 17) * 4)
    const r = 3.5 + hash(i * 19) * 3
    const z = scroll_z(base, distance)
    const g = scenery_fade(z)

    if i % 3 == 0 {
      "hill_{i}" : LgBushLeaf {
        Position: {x, 0.6, z}
        Scale: {1.4 * g, 0.6 * g, g}
        Sphere: {radius: r, segments: 12, smooth: true}
        NoShadow
      }
    } else {
      "hill_{i}" : LgFrondDark {
        Position: {x, 0.4, z}
        Scale: {1.4 * g, 0.55 * g, g}
        Sphere: {radius: r, segments: 12, smooth: true}
        NoShadow
      }
    }
  }
}

far_islands {
  // Islands out at sea beyond the banks drift past slower than the banks
  for i in 0..FAR_ISLANDS {
    const side = i % 2 == 0 ? -1.0 : 1.0
    const base = i * (FAR_SPAN / FAR_ISLANDS) + hash(i * 23 + 5) * 60
    "island_{i}" {
      Position: {side * (110 + hash(i * 29 + 1) * 120), 0, far_z(base, distance)}
      Scale: {
        far_fade(far_z(base, distance)),
        far_fade(far_z(base, distance)),
        far_fade(far_z(base, distance))
      }
      LgFarIsland land(size: 16 + hash(i * 31 + 2) * 22, seed: 700 + i * 13)
    }
  }
}

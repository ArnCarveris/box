// The scene of the transition e2e cases (test/integration/e2e/transitions.py): an orthographic
// camera that shows one logical pixel per unit, a white square that the cases move from the start
// marker towards the target marker, and a red square that they turn blue, both with a linear
// transition of 1 s. The reference squares show the start and target colors without a
// transition; the markers show where the square starts and where its target is, in a row of
// their own so they never overlap it. Flat 2D shapes, so the captured colors are the colors.
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.transition

camera {
  Position: {0, 0, 100}
  Camera: {ortho: true, ortho_scale: 1}
}

main_view {
  View: {camera: camera, clear: {enabled: true, color: {10, 12, 20, 255}}}
}

start_marker {
  Position: {-100, -50, 0}
  Rect: {10, 10}
  Rgb: {128, 128, 128}
}

target_marker {
  Position: {100, -50, 0}
  Rect: {10, 10}
  Rgb: {0, 200, 0}
}

mover {
  Position: {-100, 0, 0}
  Rect: {20, 20}
  Rgb: {255, 255, 255}
  Transition: [Position: {duration: 1}]
}

start_color {
  Position: {-60, 50, 0}
  Rect: {20, 20}
  Rgb: {255, 0, 0}
}

shifter {
  Position: {0, 50, 0}
  Rect: {20, 20}
  Rgb: {255, 0, 0}
  Transition: [Rgb: {duration: 1}]
}

target_color {
  Position: {60, 50, 0}
  Rect: {20, 20}
  Rgb: {0, 0, 255}
}

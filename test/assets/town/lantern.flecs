include materials
using flecs.script
using box.transform
using box.geometry
using box.material

assets {
  @tree Parent
  template Lantern {
    {
      Position: {0, 0.31, 0}
      Cylinder: {radius: 0.025, length: 0.26, segments: 8}
      Rgb: TownIron
    }
    {
      Position: {}
      Sphere: {radius: 0.25, segments: 8, smooth: true}
      Rgb: {241, 116, 91}
      Emissive: {2, {241, 116, 91}}
    }
    for i in 0..3 {
      {
        Position: {0, (i - 1) * 0.12, 0}
        Torus: {radius: 0.2 - math.abs(i - 1) * 0.015, tube: 0.014, segments: 16, rings: 4}
        Rgb: {182, 67, 58}
      }
    }
    {
      Position: {0, -0.23, 0}
      Cylinder: {radius: 0.1, length: 0.07, segments: 12}
      Rgb: TownTimber
    }
  }
}

{
    "id": "input",
    "type": "application",
    "value": {
        "description": "Unit tests for the box.input device and action layers",
        "public": false,
        "use": [
            "box"
        ]
    },
    "test": {
        "testsuites": [
            {
                "id": "Input",
                "testcases": [
                    "defaults_of_the_singleton",
                    "press_is_set_for_one_frame",
                    "held_key_keeps_its_state",
                    "release_clears_the_state",
                    "press_and_release_in_one_frame_keeps_the_press",
                    "mouse_buttons_use_their_own_slots",
                    "text_buffer_holds_the_characters_of_the_frame",
                    "text_buffer_encodes_utf8",
                    "text_buffer_stops_at_its_size",
                    "scroll_accumulates_over_frames",
                    "mouse_window_position_follows_the_events",
                    "mouse_delta_is_the_movement_of_the_frame",
                    "mouse_view_and_normalized_come_from_the_surface",
                    "mouse_center_is_the_origin_of_the_view"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "Focus",
                "testcases": [
                    "a_new_world_is_focused",
                    "focus_loss_clears_the_key_state",
                    "refocus_presses_nothing",
                    "refocus_does_not_jump_the_cursor",
                    "platform_keys_are_ignored_while_unfocused",
                    "platform_keys_are_ignored_while_minimized",
                    "injected_keys_are_applied_while_unfocused",
                    "minimize_event_sets_and_clears_the_flag"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "Inject",
                "testcases": [
                    "a_press_of_one_frame_releases_the_next_frame",
                    "a_press_with_a_duration_holds_the_key",
                    "a_down_without_a_duration_stays_down",
                    "delay_postpones_the_event",
                    "platform_events_are_applied_before_injected",
                    "events_of_one_frame_keep_their_order",
                    "a_sweep_walks_the_cursor_over_frames",
                    "pending_counts_the_queued_events",
                    "reset_empties_the_queue_and_clears_the_state"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "Codes",
                "testcases": [
                    "printable_keys_are_ascii",
                    "mouse_buttons_are_128_and_129",
                    "spare_codes_are_unique_and_fit_the_table",
                    "keys_are_exported_as_script_constants",
                    "family_modifiers_are_reserved_above_the_slots",
                    "glfw_printable_keys_map_to_themselves",
                    "glfw_named_keys_map_to_spare_codes",
                    "glfw_unknown_keys_map_to_none",
                    "reflection_describes_the_singleton"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "Actions",
                "testcases": [
                    "a_binding_presses_holds_and_releases",
                    "a_modifier_binding_matches_its_side",
                    "a_family_modifier_matches_either_side",
                    "a_more_specific_binding_wins",
                    "a_pure_modifier_binding_fires_while_it_is_held",
                    "a_key_binding_claims_the_modifier_of_a_pure_binding",
                    "two_actions_share_one_mask",
                    "two_masks_share_one_action",
                    "rebinding_moves_the_action_to_another_key",
                    "unbinding_releases_the_action",
                    "a_disabled_map_stops_its_bindings",
                    "a_key_pair_on_a_map_binds_an_action",
                    "emitting_fires_an_action_without_a_key",
                    "the_event_list_holds_the_phases_of_the_frame",
                    "a_script_authors_the_map",
                    "the_scene_map_binds_its_actions"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "Layers",
                "testcases": [
                    "a_binding_that_consumes_keeps_the_key_from_a_lower_map",
                    "a_higher_map_that_does_not_consume_leaves_the_lower_one_alone",
                    "a_map_that_consumes_covers_its_key_pairs",
                    "a_disabled_consuming_map_lets_the_key_through",
                    "a_consuming_map_keeps_only_the_keys_it_binds",
                    "maps_of_one_priority_both_resolve",
                    "a_binding_without_a_map_sits_at_the_base_layer",
                    "the_events_of_a_frame_start_at_the_highest_map",
                    "consuming_an_action_takes_its_key_from_the_maps_below",
                    "consuming_leaves_the_maps_above_and_beside_it_alone",
                    "a_script_handler_consumes_the_key_of_the_map_below",
                    "a_script_handler_that_does_not_consume_leaves_the_map_below",
                    "stopping_outside_a_raise_does_nothing",
                    "consuming_an_action_clears_it_for_the_frame",
                    "consuming_drops_the_events_of_the_frame",
                    "consuming_a_held_action_does_not_press_it_again",
                    "consuming_an_idle_action_reports_nothing",
                    "a_drag_raises_after_the_threshold",
                    "a_drag_stops_when_the_action_is_released",
                    "a_script_follows_a_drag_with_on_dragged",
                    "a_script_consumes_an_action"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "AnyKey",
                "testcases": [
                    "a_key_fires_the_any_binding",
                    "a_mouse_button_fires_the_any_binding",
                    "a_modifier_fires_the_any_binding",
                    "the_event_carries_the_key_that_fired_it",
                    "the_key_that_went_down_this_frame_is_the_one_reported",
                    "a_frame_without_a_key_does_not_fire",
                    "the_key_family_leaves_the_mouse_buttons_alone",
                    "the_mouse_family_leaves_the_keys_alone",
                    "a_binding_with_a_modifier_needs_the_modifier",
                    "a_higher_map_that_consumes_keeps_the_key_from_an_any_binding",
                    "an_any_binding_that_consumes_keeps_its_key_from_a_lower_map",
                    "a_key_pair_of_a_map_binds_the_any_family",
                    "the_binding_list_of_the_action_holds_the_family"
                ],
                "setup": true,
                "teardown": true
            },
            {
                "id": "Events",
                "testcases": [
                    "a_script_resumes_on_the_pressed_frame",
                    "on_down_resumes_while_the_action_is_held",
                    "on_up_resumes_when_the_action_is_released",
                    "several_waiters_resume_on_one_action",
                    "an_emitted_action_resumes_a_waiter",
                    "the_wait_carries_the_source",
                    "deleting_the_entity_of_a_task_cancels_the_wait",
                    "a_waiter_registered_at_scene_load_catches_the_press"
                ],
                "setup": true,
                "teardown": true
            }
        ]
    }
}

                    "settings_that_are_off_keep_the_authored_mesh",
                    "a_world_without_settings_keeps_the_authored_mesh",
                    "a_world_without_a_view_keeps_the_authored_mesh",
                    "a_view_without_settings_holds_the_finest_level",
                    "a_receding_camera_coarsens_the_level",
                    "the_band_holds_a_level_over_a_frame",
                    "a_level_change_moves_the_instance_to_its_batch",
                    "a_cylinder_follows_the_metric",

{
    "id": "checkpoint",
    "type": "application",
    "value": {
        "description": "Unit tests for writing script based checkpoints",
        "public": false,
        "use": [
            "box"
        ]
    },
    "test": {
        "testsuites": [
            {
                "id": "Write",
                "testcases": [
                    "writes_a_file_per_script",
                    "values_are_updated",
                    "layout_and_comments_are_preserved",
                    "derived_components_are_left_out",
                    "component_added_at_runtime_is_written",
                    "script_without_a_file_uses_its_name",
                    "entity_without_a_statement_is_reported",
                    "template_body_entities_are_reported",
                    "checkpoint_reloads_into_the_same_state"
                ]
            },
            {
                "id": "Folder",
                "testcases": [
                    "folder_is_under_the_process_folder",
                    "folder_is_removed_when_the_instance_stops",
                    "repeated_checkpoints_get_their_own_folder",
                    "named_checkpoint_uses_the_name",
                    "dir_overrides_the_process_folder"
                ]
            },
            {
                "id": "Restore",
                "testcases": [
                    "last_checkpoint_is_restored",
                    "named_checkpoint_is_restored",
                    "every_script_is_restored",
                    "entity_added_after_the_checkpoint_is_removed",
                    "entity_deleted_after_the_checkpoint_is_back",
                    "unowned_entity_is_left_alone_and_reported",
                    "entity_handles_change",
                    "kept_entity_keeps_its_script",
                    "counters_survive_a_restore",
                    "restore_without_a_checkpoint_fails",
                    "unknown_name_fails",
                    "corrupt_checkpoint_keeps_the_world",
                    "corrupt_checkpoint_names_the_file",
                    "command_restores_the_last_checkpoint",
                    "command_takes_a_name",
                    "command_reports_an_unknown_name"
                ]
            },
            {
                "id": "Survive",
                "testcases": [
                    "render_slots_are_rebuilt",
                    "collider_is_rebuilt",
                    "root_bounds_are_rebuilt",
                    "controller_keeps_driving_the_entity"
                ]
            },
            {
                "id": "Report",
                "testcases": [
                    "unowned_entity_is_reported",
                    "owned_entity_is_not_reported",
                    "entity_without_a_value_is_not_reported",
                    "command_returns_the_folder",
                    "command_reports_an_unowned_entity",
                    "command_takes_a_name"
                ]
            }
        ]
    }
}

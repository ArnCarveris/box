{
    "id": "checkpoint",
    "type": "application",
    "value": {
        "description": "Unit tests for writing script based checkpoints",
        "public": false,
        "use": [
            "box"
        ]
    },
    "test": {
        "testsuites": [
            {
                "id": "Write",
                "testcases": [
                    "writes_a_file_per_script",
                    "values_are_updated",
                    "layout_and_comments_are_preserved",
                    "derived_components_are_left_out",
                    "component_added_at_runtime_is_written",
                    "script_without_a_file_uses_its_name",
                    "entity_without_a_statement_is_reported",
                    "template_body_entities_are_reported",
                    "checkpoint_reloads_into_the_same_state"
                ]
            },
            {
                "id": "Folder",
                "testcases": [
                    "folder_is_under_the_process_folder",
                    "folder_is_removed_when_the_instance_stops",
                    "repeated_checkpoints_get_their_own_folder",
                    "named_checkpoint_uses_the_name",
                    "dir_overrides_the_process_folder"
                ]
            },
            {
                "id": "Report",
                "testcases": [
                    "unowned_entity_is_reported",
                    "owned_entity_is_not_reported",
                    "entity_without_a_value_is_not_reported",
                    "command_returns_the_folder",
                    "command_reports_an_unowned_entity",
                    "command_takes_a_name"
                ]
            }
        ]
    }
}

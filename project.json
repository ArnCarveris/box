{
    "id": "box",
    "type": "package",
    "value": {
        "use": [{
            "name": "flecs",
            "defines": [
                "FLECS_SCRIPT_MATH",
                "FLECS_CREATE_MEMBER_ENTITIES"
            ]
        }]
    },
    "rules": [{
        "ext": "src/audio/core/core.c",
        "command": "python3 {project}/tools/audio_core.py {input} {out_dir} {project}"
    }],
    "lint": {
        "command": "python3 tools/lint.py",
        "action": "log"
    },
    "lang.c": {
        "c-standard": "c11",
        "${os Darwin}": {
            "defines": [
                "BOX_PLATFORM_GLFW",
                "BOX_RENDER_WGPU"
            ]
        },
        "${os Emscripten}": {
            "defines": [
                "BOX_RENDER_WGPU",
                "_GNU_SOURCE"
            ],
            "cflags": [
                "--use-port=emdawnwebgpu",
                "-msimd128"
            ]
        },
        "${os Linux}": {
            "defines": [
                "BOX_RENDER_WGPU",
                "_GNU_SOURCE"
            ]
        }
    },
    "dependee": {
        "lang.c": {
            "defines": [
                "FLECS_SCRIPT_MATH",
                "FLECS_CREATE_MEMBER_ENTITIES"
            ],
            "${os Darwin}": {
                "lib": [
                    "m"
                ],
                "ldflags": [
                    "-framework Cocoa",
                    "-framework QuartzCore",
                    "-framework Metal",
                    "-framework IOKit",
                    "-framework CoreVideo",
                    "-framework CoreFoundation",
                    "-framework CoreGraphics",
                    "-framework Foundation",
                    "-framework AppKit"
                ]
            },
            "${os Emscripten}": {
                "cflags": [
                    "--use-port=emdawnwebgpu",
                    "-msimd128"
                ],
                "ldflags": [
                    "--use-port=emdawnwebgpu",
                    "-msimd128",
                    "-sDEFAULT_TO_CXX=1",
                    "-sSTACK_SIZE=8388608"
                ]
            },
            "${os Linux}": {
                "lib": [
                    "m",
                    "dl",
                    "pthread"
                ]
            }
        }
    },
    "bundle": {
        "cglm": {
            "repository": "https://github.com/recp/cglm.git",
            "tag": "v0.9.2",
            "library": "cglm",
            "cmake-args": [
                "-DCGLM_SHARED=OFF",
                "-DCGLM_STATIC=ON",
                "-DCGLM_USE_TEST=OFF"
            ]
        },
        "stb": {
            "repository": "https://github.com/nothings/stb.git",
            "commit": "28d546d5eb77d4585506a20480f4de2e706dff4c",
            "header-only": true
        }
    },
    "${os Darwin}": {
        "bundle": {
            "miniaudio": {
                "repository": "https://github.com/mackron/miniaudio.git",
                "tag": "0.11.26",
                "header-only": true
            },
            "glfw": {
                "repository": "https://github.com/glfw/glfw.git",
                "tag": "3.4",
                "library": "glfw3",
                "cmake-args": [
                    "-DGLFW_BUILD_EXAMPLES=OFF",
                    "-DGLFW_BUILD_TESTS=OFF",
                    "-DGLFW_BUILD_DOCS=OFF"
                ]
            },
            "wgpu_native": {
                "repository": "https://github.com/gfx-rs/wgpu-native.git",
                "tag": "v29.0.1.1",
                "build-system": "cargo",
                "library": "wgpu_native",
                "include": [
                    "ffi",
                    "ffi/webgpu-headers"
                ]
            },
            "resvg": {
                "repository": "https://github.com/linebender/resvg.git",
                "tag": "v0.47.0",
                "subdir": "crates/c-api",
                "build-system": "cargo",
                "library": "resvg",
                "cargo-args": [
                    "--no-default-features",
                    "--features=text,system-fonts,memmap-fonts"
                ],
                "include": [
                    "."
                ]
            }
        }
    },
    "${os Emscripten}": {
        "bundle": {
            "resvg": {
                "repository": "https://github.com/linebender/resvg.git",
                "tag": "v0.47.0",
                "subdir": "crates/c-api",
                "build-system": "cargo",
                "library": "resvg",
                "cargo-args": [
                    "--no-default-features",
                    "--features=text,system-fonts,memmap-fonts"
                ],
                "include": [
                    "."
                ]
            }
        }
    },
    "${os Linux}": {
        "bundle": {
            "miniaudio": {
                "repository": "https://github.com/mackron/miniaudio.git",
                "tag": "0.11.26",
                "header-only": true
            },
            "wgpu_native": {
                "repository": "https://github.com/gfx-rs/wgpu-native.git",
                "tag": "v29.0.1.1",
                "build-system": "cargo",
                "library": "wgpu_native",
                "include": [
                    "ffi",
                    "ffi/webgpu-headers"
                ]
            },
            "resvg": {
                "repository": "https://github.com/linebender/resvg.git",
                "tag": "v0.47.0",
                "subdir": "crates/c-api",
                "build-system": "cargo",
                "library": "resvg",
                "cargo-args": [
                    "--no-default-features",
                    "--features=text,system-fonts,memmap-fonts"
                ],
                "include": [
                    "."
                ]
            }
        }
    }
}

{
    "id": "box",
    "type": "package",
    "value": {
        "use": []
    },
    "lint": {
        "command": "python3 tools/lint.py",
        "action": "log"
    },
    "lang.c": {
        "c-standard": "c11",
        "defines": [
            "FLECS_SCRIPT_MATH",
            "FLECS_CREATE_MEMBER_ENTITIES"
        ]
    },
    "dependee": {
        "lang.c": {
            "defines": [
                "FLECS_SCRIPT_MATH",
                "FLECS_CREATE_MEMBER_ENTITIES"
            ],
            "${os Darwin}": {
                "lib": [
                    "m"
                ]
            }
        }
    },
    "bundle": {
        "flecs": {
            "repository": "../../flecs",
            "library": "flecs_static",
            "cmake-args": [
                "-DCMAKE_C_FLAGS=-DFLECS_SCRIPT_MATH -DFLECS_CREATE_MEMBER_ENTITIES",
                "-DFLECS_SHARED=OFF",
                "-DFLECS_STATIC=ON",
                "-DFLECS_TESTS=OFF",
                "-DCMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE=ON"
            ]
        },
        "cglm": {
            "repository": "https://github.com/recp/cglm.git",
            "tag": "v0.9.2",
            "library": "cglm",
            "cmake-args": [
                "-DCGLM_SHARED=OFF",
                "-DCGLM_STATIC=ON",
                "-DCGLM_USE_TEST=OFF"
            ]
        }
    }
}

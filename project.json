{
    "id": "box",
    "type": "package",
    "value": {
        "use": ["flecs"]
    },
    "lint": {
        "command": "python3 tools/lint.py",
        "action": "log"
    },
    "bundle": {
        "cglm": {
            "repository": "https://github.com/recp/cglm.git",
            "tag": "v0.9.2",
            "library": "cglm",
            "cmake-args": ["-DCGLM_SHARED=OFF", "-DCGLM_STATIC=ON", "-DCGLM_USE_TEST=OFF"]
        }
    }
}

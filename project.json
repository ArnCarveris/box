{
    "id": "box",
    "type": "package",
    "value": {
        "use": []
    },
    "lint": {
        "command": "python3 tools/lint.py",
        "action": "log"
    },
    "lang.c": {
        "c-standard": "c11",
        "defines": [
            "FLECS_SCRIPT_MATH",
            "FLECS_CREATE_MEMBER_ENTITIES"
        ],
        "${os Darwin}": {
            "defines": [
                "BOX_PLATFORM_GLFW",
                "BOX_RENDER_WGPU"
            ]
        },
        "${os Emscripten}": {
            "defines": [
                "BOX_RENDER_WGPU",
                "_GNU_SOURCE"
            ],
            "cflags": [
                "--use-port=emdawnwebgpu"
            ]
        }
    },
    "dependee": {
        "lang.c": {
            "defines": [
                "FLECS_SCRIPT_MATH",
                "FLECS_CREATE_MEMBER_ENTITIES"
            ],
            "${os Darwin}": {
                "lib": [
                    "m"
                ],
                "ldflags": [
                    "-framework Cocoa",
                    "-framework QuartzCore",
                    "-framework Metal",
                    "-framework IOKit",
                    "-framework CoreVideo",
                    "-framework CoreFoundation",
                    "-framework CoreGraphics",
                    "-framework Foundation",
                    "-framework AppKit"
                ]
            },
            "${os Emscripten}": {
                "cflags": [
                    "--use-port=emdawnwebgpu"
                ],
                "ldflags": [
                    "--use-port=emdawnwebgpu",
                    "-sDEFAULT_TO_CXX=1",
                    "-sSTACK_SIZE=8388608"
                ]
            }
        }
    },
    "bundle": {
        "flecs": {
            "repository": "../../flecs",
            "library": "flecs_static",
            "cmake-args": [
                "-DCMAKE_C_FLAGS=-DFLECS_SCRIPT_MATH -DFLECS_CREATE_MEMBER_ENTITIES",
                "-DFLECS_SHARED=OFF",
                "-DFLECS_STATIC=ON",
                "-DFLECS_TESTS=OFF",
                "-DCMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE=ON"
            ]
        },
        "cglm": {
            "repository": "https://github.com/recp/cglm.git",
            "tag": "v0.9.2",
            "library": "cglm",
            "cmake-args": [
                "-DCGLM_SHARED=OFF",
                "-DCGLM_STATIC=ON",
                "-DCGLM_USE_TEST=OFF"
            ]
        },
        "stb": {
            "repository": "https://github.com/nothings/stb.git",
            "commit": "28d546d5eb77d4585506a20480f4de2e706dff4c",
            "header-only": true
        }
    },
    "${os Darwin}": {
        "bundle": {
            "glfw": {
                "repository": "https://github.com/glfw/glfw.git",
                "tag": "3.4",
                "library": "glfw3",
                "cmake-args": [
                    "-DGLFW_BUILD_EXAMPLES=OFF",
                    "-DGLFW_BUILD_TESTS=OFF",
                    "-DGLFW_BUILD_DOCS=OFF"
                ]
            },
            "wgpu_native": {
                "repository": "https://github.com/gfx-rs/wgpu-native.git",
                "tag": "v29.0.1.1",
                "build-system": "cargo",
                "library": "wgpu_native",
                "include": [
                    "ffi",
                    "ffi/webgpu-headers"
                ]
            }
        }
    }
}

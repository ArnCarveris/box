{
    "id": "box",
    "type": "package",
    "value": {
        "author": "Sander Mertens",
        "description": "Data-driven 2D/3D game framework built on flecs and WebGPU",
        "public": true
    },
    "lint": {
        "command": "python3 tools/lint.py",
        "action": "log"
    },
    "lang.c": {
        "c-standard": "c11",
        "defines": ["FLECS_SCRIPT_MATH", "FLECS_SCRIPT_PLATFORM", "FLECS_CREATE_MEMBER_ENTITIES"],
        "${os Darwin}": {
            "defines": ["GLFW_EXPOSE_NATIVE_COCOA", "BOX_PLATFORM_GLFW"]
        },
        "${os Windows}": {
            "defines": ["GLFW_EXPOSE_NATIVE_WIN32", "BOX_PLATFORM_GLFW", "_CRT_SECURE_NO_WARNINGS", "flecs_STATIC"],
            "include": ["src/platform/win32"],
            "cflags": ["/FIbox_win32.h"]
        },
        "${os Emscripten}": {
            "defines": ["BOX_PLATFORM_WEB"],
            "cflags": ["--use-port=emdawnwebgpu"]
        }
    },
    "dependee": {
        "lang.c": {
            "defines": ["FLECS_SCRIPT_MATH", "FLECS_SCRIPT_PLATFORM", "FLECS_CREATE_MEMBER_ENTITIES"],
            "${os Darwin}": {
                "lib": ["m"],
                "ldflags": [
                    "-framework Cocoa",
                    "-framework QuartzCore",
                    "-framework Metal",
                    "-framework IOKit",
                    "-framework CoreVideo",
                    "-framework CoreFoundation",
                    "-framework CoreGraphics",
                    "-framework Foundation",
                    "-framework AppKit"
                ]
            },
            "${os Windows}": {
                "defines": ["flecs_STATIC"],
                "lib": [
                    "user32", "gdi32", "shell32", "ole32", "oleaut32", "advapi32",
                    "ws2_32", "userenv", "bcrypt", "ntdll", "opengl32", "propsys",
                    "runtimeobject", "d3d12", "dxgi", "d3dcompiler", "dbghelp"
                ]
            },
            "${os Emscripten}": {
                "cflags": ["--use-port=emdawnwebgpu"],
                "ldflags": [
                    "--use-port=emdawnwebgpu",
                    "-sDEFAULT_TO_CXX=1",
                    "-sALLOW_MEMORY_GROWTH=1",
                    "-sSTACK_SIZE=8388608",
                    "-sEXPORTED_FUNCTIONS=['_main','_box_request']",
                    "-sEXPORTED_RUNTIME_METHODS=['ccall','cwrap']"
                ]
            }
        }
    },
    "bundle": {
        "flecs": {
            "repository": "../flecs",
            "library": "flecs_static",
            "cmake-args": [
                "-DCMAKE_C_FLAGS=-DFLECS_SCRIPT_MATH -DFLECS_SCRIPT_PLATFORM -DFLECS_CREATE_MEMBER_ENTITIES",
                "-DFLECS_SHARED=OFF",
                "-DFLECS_STATIC=ON",
                "-DFLECS_TESTS=OFF",
                "-DCMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE=ON"
            ]
        },
        "stb": {
            "repository": "https://github.com/nothings/stb.git",
            "commit": "28d546d5eb77d4585506a20480f4de2e706dff4c",
            "header-only": true
        },
        "cgltf": {
            "repository": "https://github.com/jkuhlmann/cgltf.git",
            "commit": "85cd62382dfea638278962690cf515023f33ed00",
            "header-only": true
        },
        "meshoptimizer": {
            "repository": "https://github.com/zeux/meshoptimizer.git",
            "tag": "v0.25",
            "library": "meshoptimizer",
            "lib": ["c++"],
            "cmake-args": [
                "-DMESHOPT_BUILD_DEMO=OFF",
                "-DMESHOPT_BUILD_GLTFPACK=OFF",
                "-DMESHOPT_BUILD_SHARED_LIBS=OFF"
            ]
        },
        "resvg": {
            "repository": "https://github.com/linebender/resvg.git",
            "tag": "v0.47.0",
            "subdir": "crates/c-api",
            "build-system": "cargo",
            "library": "resvg",
            "cargo-args": ["--no-default-features", "--features=text,system-fonts,memmap-fonts"],
            "include": ["."]
        }
    },
    "${os Darwin}": {
        "bundle": {
            "glfw": {
                "repository": "https://github.com/glfw/glfw.git",
                "tag": "3.4",
                "library": "glfw3",
                "cmake-args": ["-DGLFW_BUILD_EXAMPLES=OFF", "-DGLFW_BUILD_TESTS=OFF", "-DGLFW_BUILD_DOCS=OFF"]
            },
            "wgpu_native": {
                "repository": "https://github.com/gfx-rs/wgpu-native.git",
                "tag": "v29.0.1.1",
                "build-system": "cargo",
                "library": "wgpu_native",
                "include": ["ffi", "ffi/webgpu-headers"]
            }
        }
    },
    "${os Windows}": {
        "bundle": {
            "glfw": {
                "repository": "https://github.com/glfw/glfw.git",
                "tag": "3.4",
                "library": "glfw3",
                "cmake-args": ["-DGLFW_BUILD_EXAMPLES=OFF", "-DGLFW_BUILD_TESTS=OFF", "-DGLFW_BUILD_DOCS=OFF"]
            },
            "wgpu_native": {
                "repository": "https://github.com/gfx-rs/wgpu-native.git",
                "tag": "v29.0.1.1",
                "build-system": "cargo",
                "library": "wgpu_native",
                "include": ["ffi", "ffi/webgpu-headers"]
            }
        }
    }
}

  NoteClip: {length: 8, notes: [
    {start: 0, duration: 0.5, pitch: 69}, {start: 0.5, duration: 0.5, pitch: 72, velocity: 0.6},
    {start: 1, duration: 0.5, pitch: 76, velocity: 0.8}, {start: 1.5, duration: 0.5, pitch: 72, velocity: 0.6},
    {start: 2, duration: 0.5, pitch: 69}, {start: 2.5, duration: 0.5, pitch: 72, velocity: 0.6},
    {start: 3, duration: 0.5, pitch: 76, velocity: 0.8}, {start: 3.5, duration: 0.5, pitch: 79, velocity: 0.6},
    {start: 4, duration: 0.5, pitch: 69}, {start: 4.5, duration: 0.5, pitch: 72, velocity: 0.6},
    {start: 5, duration: 0.5, pitch: 77, velocity: 0.8}, {start: 5.5, duration: 0.5, pitch: 72, velocity: 0.6},
    {start: 6, duration: 0.5, pitch: 69}, {start: 6.5, duration: 0.5, pitch: 72, velocity: 0.6},
    {start: 7, duration: 0.5, pitch: 77, velocity: 0.8}, {start: 7.5, duration: 0.5, pitch: 81, velocity: 0.6}
  ]}

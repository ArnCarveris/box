  NoteClip: {length: 16, notes: [
    {start: 0, duration: 2, pitch: 81, velocity: 0.7}, {start: 6, duration: 1, pitch: 84, velocity: 0.5},
    {start: 8, duration: 2, pitch: 79, velocity: 0.7}, {start: 14, duration: 1, pitch: 76, velocity: 0.5}
  ]}
}


using flecs.script
using flecs.script.math

fn price_of(sys: i32, g: i32, t: f32) -> f32 {
  good_base(g) * sys_price_k(sys, g) * (1 + 0.16 * sin(t * 0.07 + sys * 1.7 + g * 2.3) + 0.08 * sin(t * 0.19 + sys * 4.1 + g * 0.9))
}

fn standing_k(sys: i32) -> f32 {
  0.85 + standing[sys_faction(sys)] * 0.3
}

fn sell_price(sys: i32, g: i32, t: f32) -> f32 {
  price_of(sys, g, t) * standing_k(sys)
}

fn buy_price(sys: i32, g: i32, t: f32) -> f32 {
  price_of(sys, g, t) * (2 - standing_k(sys))
}

fn lane_security(e: i32) -> f32 {
  clamp(lane_sec(e) + patrol[e] * 18, 0, 100)
}

proc mining_step(dt: f32) {
  mut any: bool = false
  for r in 0..rig_count {
    const c = rig_site[r]
    mut y: f32 = 0
    if c >= 0 && main_on && rig_wear[r] < 1 && claim_left[c] > 0 && stock[G_ORE] < cap[G_ORE] {
      y = claim_rich(c) * kn[KN_DRILL] * 0.62 * hub_eff * (1 - rig_wear[r] * 0.6)
      const got = min(min(y * dt, claim_left[c]), cap[G_ORE] - stock[G_ORE])
      stock[G_ORE] = stock[G_ORE] + got
      claim_left[c] = claim_left[c] - got
      mined_total += got
      rig_wear[r] = min(1, rig_wear[r] + kn[KN_DRILL] * kn[KN_DRILL] * 0.0016 * dt)
      if rig_wear[r] >= 1 {
        alarm = 0.6
        log_add("RIG {r + 1} SEIZED. SERVICE REQUIRED.")
      }
      if claim_left[c] <= 0 {
        log_add("CLAIM {claim_name(c)} WORKED OUT")
        rig_site[r] = -1
      }
    }
    if abs(rig_yield[r] - y) > 0.01 {
      rig_yield[r] = y
    }
  }
  if scan_t > 0 {
    scan_t = max(0, scan_t - dt)
    if scan_t <= 0 {
      mut found: bool = false
      for c in 0..CLAIMS {
        if !claim_known[c] && !found {
          claim_known[c] = true
          found = true
          log_add("SURVEY: VEIN AT {claim_name(c)}, {claim_rich(c) * 100:.0}% GRADE")
        }
      }
    }
  }
}

proc refinery_step(dt: f32) {
  mut power: f32 = 0
  for s in 0..SLOTS {
    if slot_kind[s] == M_REFINERY && slot_build[s] >= 1 {
      power += slot_eff[s]
    }
  }
  mut rate: f32 = 0
  if power > 0 && kn[KN_VALVE] > 0.01 && stock[G_ORE] > 0 && stock[G_CELL] < cap[G_CELL] {
    rate = power * kn[KN_VALVE] * 1.1
    const use = min(min(rate * dt, stock[G_ORE]), (cap[G_CELL] - stock[G_CELL]) * 2.5)
    stock[G_ORE] = stock[G_ORE] - use
    stock[G_CELL] = stock[G_CELL] + use / 2.5
    cells_total += use / 2.5
  }
  if abs(refine_rate - rate) > 0.01 {
    refine_rate = rate
  }
}

proc cargo_step(dt: f32) {
  mut t: f32 = 0
  for g in 0..GOODS {
    if jettison[g] && stock[g] > 0 {
      stock[g] = max(0, stock[g] - 6 * dt)
    }
    t += stock[g]
  }
  stock_total = t
  recompute_capacity()
}

proc trade_step(dt: f32) {
  market_t += dt
  for e in 0..LANES {
    if lane_alert[e] > 0 {
      lane_alert[e] = max(0, lane_alert[e] - dt)
    }
  }
  for i in 0..ROUTES {
    if routes[i].active {
      const ph = routes[i].phase
      if ph == RT_LOADING {
        routes[i].wait = routes[i].wait + dt
        if routes[i].exporting {
          const g = routes[i].good
          const want = min(min(5 * dt, stock[g]), 40 - routes[i].load)
          if want > 0 {
            stock[g] = stock[g] - want
            routes[i].load = routes[i].load + want
          }
          if routes[i].load >= 39.9 || (routes[i].wait > 30 && routes[i].load >= 6) {
            routes[i].phase = RT_OUT
            routes[i].t = 0
            routes[i].hop = 0
            routes[i].wait = 0
          }
        } else if routes[i].wait > 4 {
          routes[i].phase = RT_OUT
          routes[i].t = 0
          routes[i].hop = 0
          routes[i].wait = 0
        }
      } else {
        const d = routes[i].dest
        const e = path_lane(d, routes[i].hop)
        const was = routes[i].t
        routes[i].t = was + dt / (lane_len(e) * 0.42 + 3)
        if was == 0 && routes[i].load > 0 {
          rs += 1
          const risk = max(0, 60 - lane_security(e)) * 0.0058
          if rnd(rs) < risk {
            rs += 1
            const lost = routes[i].load * (0.4 + rnd(rs) * 0.6)
            routes[i].load = routes[i].load - lost
            raids += 1
            lane_alert[e] = 8
            alarm = 0.4
            standing[F_ASH] = clamp01(standing[F_ASH] - 0.005)
            log_add("RAID ON {sys_name(lane_a(e))}-{sys_name(lane_b(e))}: {lost:.0} T {good_name(routes[i].good)} GONE")
          }
        }
        if routes[i].t >= 1 {
          routes[i].t = 0
          if ph == RT_OUT {
            if routes[i].hop + 1 < path_len(d) {
              routes[i].hop = routes[i].hop + 1
            } else {
              const g = routes[i].good
              if routes[i].exporting {
                const pay = routes[i].load * sell_price(d, g, market_t)
                earn(pay)
                shipments += 1
                standing[sys_faction(d)] = clamp01(standing[sys_faction(d)] + 0.008)
                log_add("{sys_name(d)} PAID {pay:.0} CR FOR {routes[i].load:.0} T {good_name(g)}")
                routes[i].load = 0
              } else {
                const unit = buy_price(d, g, market_t)
                const qty = min(min(40, creds / unit), max(0, cap[g] - stock[g]))
                creds -= qty * unit
                routes[i].load = qty
                standing[sys_faction(d)] = clamp01(standing[sys_faction(d)] + 0.003)
                log_add("BOUGHT {qty:.0} T {good_name(g)} AT {sys_name(d)}")
              }
              routes[i].phase = RT_BACK
            }
          } else {
            if routes[i].hop > 0 {
              routes[i].hop = routes[i].hop - 1
            } else {
              if !routes[i].exporting {
                const g = routes[i].good
                const room = max(0, cap[g] - stock[g])
                stock[g] = stock[g] + min(room, routes[i].load)
                if routes[i].load > 0 {
                  shipments += 1
                }
              }
              routes[i].load = 0
              routes[i].phase = RT_LOADING
              routes[i].wait = 0
            }
          }
        }
      }
    }
  }
}

proc settlement_step(dt: f32) {
  mut hab: f32 = 0
  mut bazaar: f32 = 0
  mut dome: f32 = 0
  for s in 0..SLOTS {
    if slot_build[s] >= 1 {
      const k = slot_kind[s]
      if k == M_HABITAT {
        hab += slot_eff[s]
      } else if k == M_COMMERCE {
        bazaar += slot_eff[s]
      } else if k == M_LEISURE {
        dome += slot_eff[s]
      }
    }
  }
  pop_cap = 12 + hab * 120
  const fed = stock[G_FOOD] > 0.01
  hungry = !fed
  const want = match fed { true: min(pop_cap, 8 + visitors * 7 + hab * 90 + bazaar * 16 + dome * 22); _: pop * 0.5 }
  pop += (want - pop) * clamp(dt * 0.02, 0, 1)
  stock[G_FOOD] = max(0, stock[G_FOOD] - (pop + visitors * 3) * 0.0016 * dt)
  const crowd = pop + visitors * 8
  mut flow: f32 = pop * 0.05 * dt
  flow += bazaar * crowd * 0.07 * dt
  flow += dome * crowd * 0.15 * dt
  const quiet = match lockdown { true: 0.35; _: 1 }
  earn(flow * quiet)
  mut wages: f32 = guards * 0.42 * dt
  for e in 0..LANES {
    wages += patrol[e] * 0.9 * dt
  }
  creds -= wages
}

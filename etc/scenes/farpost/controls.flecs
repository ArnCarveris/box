using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.layout
using box.text
using box.spatial
using box.picking
using box.input
using box.transition

export const K_AMBER: Rgb = {255, 150, 30}
export const K_GREEN: Rgb = {110, 255, 160}
export const K_RED: Rgb = {255, 60, 36}
export const K_ICE: Rgb = {255, 190, 90}
export const K_TY: Rgb = {180, 136, 255}
export const PAINT: Rgb = {214, 206, 184}

template Stencil {
  prop text: string = ""
  prop size: f32 = 12
  prop ink: Rgb = LUM_DIM
  prop x: f32 = 0
  prop y: f32 = 0
  prop z: f32 = 3

  Position: {x, y, z}
  Text: {value: text, size: size, font: font_head, align: Center}
  Rgb: ink
  Emissive: {strength: 1.4, color: ink}
  BlendMode: Additive
  SpatialIgnore
}

template Etch {
  prop text: string = ""
  prop size: f32 = 26
  prop x: f32 = 0
  prop y: f32 = 0
  prop z: f32 = 1
  prop tone: Rgb = {40, 36, 32}

  Position: {x, y, z}
  Text: {value: text, size: size, font: font_plate, align: Center}
  Rgb: tone
  SpatialIgnore
}

template Screw {
  prop x: f32 = 0
  prop y: f32 = 0
  prop turn: f32 = 0.4
  prop r: f32 = 4

  Position: {x, y, 0.5}
  SpatialIgnore
  head : Steel { Position: {0, 0, 0}; Rotation: {PI / 2, 0, 0}; Cylinder: {radius: r, length: 2, segments: 8, smooth: true}; Rgb: {90, 86, 80} }
}

template Led {
  prop lit: bool = false
  prop hue: Rgb = K_RED
  prop r: f32 = 2.4
  prop power: f32 = 7

  dome {
    Position: {0, 0, 0.6}
    Scale: {r, r, r * 0.6}
    Sphere: {radius: 1, segments: 8, smooth: true}
    Rgb: {hue.r * 0.2, hue.g * 0.2, hue.b * 0.2}
    PbrMaterial: {metallic: 0, roughness: 0.25}
    if lit {
      Emissive: {strength: power, color: hue}
    } else {
      Emissive: {strength: 0.02, color: hue}
    }
    NoShadow
  }
  SpatialIgnore
}

template Tap {
  prop legend: string = ""
  prop sub: string = ""
  prop hue: Rgb = NEON
  prop lit: bool = false
  prop w: f32 = 84
  prop h: f32 = 30
  prop size: f32 = 12
  prop op: i32 = 0
  prop a: i32 = 0
  prop b: i32 = 0
  prop x: f32 = 0
  prop y: f32 = 0
  prop enabled: bool = true
  prop c: f32 = 7

  mut down = false
  mut hover = false
  const dim = match enabled { true: 1; _: 0.3 }

  Position: {x, y, match down { true: 1.5; _: 5 }}
  Transition: [Position: {duration: 0.05}]
  Interactive
  Cursor: {CursorPointer}

  ChamferFill plate(w: w, h: h, c1: c, c2: 0, c3: c, c4: 0, hue: hue, glow: match lit { true: 0.78; _: match hover && enabled { true: 0.2; _: 0.05 } })
  ChamferRing ring(w: w, h: h, c1: c, c2: 0, c3: c, c4: 0, t: match lit || hover { true: 1.7; _: 1.1 }, hue: hue, glow: match lit { true: 5; _: match hover && enabled { true: 4; _: 1.7 * dim } })
  words {
    Position: {0, match sub == "" { true: 0; _: size * 0.4 }, 2}
    Text: {value: legend, size: size, font: font_head, align: Center}
    if lit {
      Rgb: {30, 12, 2}
    } else {
      Rgb: {hue.r * dim, hue.g * dim, hue.b * dim}
      Emissive: {strength: 1.5 * dim, color: hue}
      BlendMode: Additive
    }
    SpatialIgnore
  }
  if sub != "" {
    minor {
      Position: {0, 0 - size * 0.56, 2}
      Text: {value: sub, size: size * 0.74, font: font_glass, align: Center}
      if lit {
        Rgb: {30, 12, 2}
      } else {
        Rgb: {hue.r * dim * 0.8, hue.g * dim * 0.8, hue.b * dim * 0.8}
        BlendMode: Additive
      }
      SpatialIgnore
    }
  }

  async {
    while true {
      await on.enter(this)
      hover = true
      await on.leave(this)
      hover = false
    }
  }

  async {
    while true {
      await on.press(this)
      down = true
      await on.release(this)
      down = false
    }
  }

  async {
    while true {
      await on.click(this)
      emit Cmd(op: op, a: a, b: b)
    }
  }
}

template Latch {
  prop on: bool = false
  prop label: string = ""
  prop op: i32 = 0
  prop a: i32 = 0
  prop x: f32 = 0
  prop y: f32 = 0
  prop w: f32 = 66
  prop h: f32 = 62

  mut hover = false
  const hue: Rgb = match on { true: MINT; _: NEON }

  Position: {x, y, 5}
  Interactive
  Cursor: {CursorPointer}

  ChamferFill plate(w: w, h: h, c1: 9, c2: 0, c3: 9, c4: 0, hue: hue, glow: match on { true: 0.16; _: match hover { true: 0.14; _: 0.03 } })
  ChamferRing ring(w: w, h: h, c1: 9, c2: 0, c3: 9, c4: 0, t: 1.3, hue: hue, glow: match hover { true: 4; _: 2 })
  Stencil name(text: label, size: 11, y: h / 2 - 11, ink: hue)
  Hair lead_a(x1: -22, y1: -6, x2: -10, y2: -6, w: 1.6, hue: hue, glow: 2)
  Hair lead_b(x1: 22, y1: -6, x2: 10, y2: -6, w: 1.6, hue: hue, glow: 2)
  blade {
    Position: {-10, -6, 1}
    Rotation: {0, 0, match on { true: 0; _: 0.62 }}
    Transition: [Rotation: {duration: 0.12, timing_function: EaseIn}]
    bar { Position: {10, 0, 0}; Rect: {20, 2.2}; Rgb: hue; Emissive: {strength: 3.4, color: hue}; BlendMode: Additive; SpatialIgnore }
  }
  dot_a { Position: {-10, -6, 1}; Circle: {2.6}; Rgb: hue; BlendMode: Additive; SpatialIgnore }
  dot_b { Position: {10, -6, 1}; Circle: {2.6}; Rgb: hue; BlendMode: Additive; SpatialIgnore }

  async {
    while true {
      await on.enter(this)
      hover = true
      await on.leave(this)
      hover = false
    }
  }

  async {
    while true {
      await on.click(this)
      emit Cmd(op: op, a: a, b: 0)
    }
  }
}

template BreakerTile {
  prop on: bool = false
  prop label: string = ""
  prop sub: string = ""
  prop op: i32 = 0
  prop a: i32 = 0
  prop x: f32 = 0
  prop y: f32 = 0
  prop usable: bool = true
  prop w: f32 = 70
  prop h: f32 = 46

  mut hover = false
  const live = on && usable
  const hue: Rgb = match !usable { true: LUM_FAINT; _: match on { true: MINT; _: ALERT } }

  Position: {x, y, 5}
  Interactive
  Cursor: {CursorPointer}

  ChamferFill plate(w: w, h: h, c1: 7, c2: 0, c3: 7, c4: 0, hue: hue, glow: match live { true: 0.1; _: match hover { true: 0.12; _: 0.02 } })
  ChamferRing ring(w: w, h: h, c1: 7, c2: 0, c3: 7, c4: 0, t: 1.1, hue: hue, glow: match hover { true: 4; _: 1.7 })
  Stencil name(text: label, size: 10, y: 9, ink: hue)
  Stencil code(text: match usable { true: sub; _: "---" }, size: 12, y: -8, ink: match usable { true: LUMEN; _: LUM_FAINT })

  async {
    while true {
      await on.enter(this)
      hover = true
      await on.leave(this)
      hover = false
    }
  }

  async {
    while true {
      await on.click(this)
      emit Cmd(op: op, a: a, b: 0)
    }
  }
}

template ArcTicks {
  prop r: f32 = 40
  prop value: f32 = 0
  prop hue: Rgb = NEON
  prop red_from: f32 = 2
  prop red_to: f32 = 3
  prop count: i32 = 24

  const sweep = 4.6
  const a0 = sweep / 2 + PI / 2

  SpatialIgnore
  for i in 0..count {
    const f = i / (count - 1.0)
    const a = a0 - f * sweep
    const on = value > 0.002 && f <= value
    const danger = f >= red_from && f <= red_to
    const tone: Rgb = match danger { true: ALERT; _: hue }
    "t_{i}" {
      Position: {cos(a) * r, sin(a) * r, 0}
      Rotation: {0, 0, a}
      Rect: {r * 0.2, r * 0.055}
      Rgb: match on { true: tone; _: {tone.r * 0.16, tone.g * 0.16, tone.b * 0.16} }
      Emissive: {strength: match on { true: 2.8; _: 0 }, color: tone}
      BlendMode: Additive
    }
  }
}

template ArcDial {
  prop label: string = ""
  prop sig: i32 = 0
  prop r: f32 = 36
  prop lo: string = ""
  prop hi: string = ""
  prop x: f32 = 0
  prop y: f32 = 0
  prop speed: f32 = 0.0042

  mut hover = false
  const v = kn[sig]

  Position: {x, y, 5}
  Interactive
  Cursor: {CursorPointer}

  hit { Position: {0, 0, 0}; Circle: {r * 1.2}; Rgb: {NEON.r * 0.02, NEON.g * 0.02, NEON.b * 0.02}; BlendMode: Additive; Border: {width: match hover { true: 1.4; _: 0 }, color: {NEON.r, NEON.g, NEON.b, 255}} }
  ArcTicks ticks(r: r, value: v) { Position: {0, 0, 1} }
  value_ { Position: {0, 1, 2}; Text: {value: "{v * 100:.0}", size: r * 0.56, font: font_head, align: Center}; Rgb: LUMEN; Emissive: {strength: 2, color: NEON}; BlendMode: Additive; SpatialIgnore }
  Stencil name(text: label, size: 11, y: 0 - r * 1.42, ink: LUM_DIM)
  Stencil lo_t(text: lo, size: 8, x: 0 - r * 0.72, y: 0 - r * 0.92, ink: LUM_FAINT)
  Stencil hi_t(text: hi, size: 8, x: r * 0.72, y: 0 - r * 0.92, ink: LUM_FAINT)

  async {
    while true {
      await on.enter(this)
      hover = true
      await on.leave(this)
      hover = false
    }
  }

  async {
    while true {
      const e = await on.drag(this)
      kn[sig] = clamp(kn[sig] + (e.delta_x - e.delta_y) * speed, 0, 1)
    }
  }

  async {
    while true {
      const e = await on.scroll(this)
      kn[sig] = clamp(kn[sig] + e.delta_y * 0.02, 0, 1)
    }
  }
}

template ArcGauge {
  prop label: string = ""
  prop unit: string = ""
  prop value: f32 = 0
  prop text: string = ""
  prop r: f32 = 40
  prop hue: Rgb = NEON
  prop red_from: f32 = 0.82
  prop red_to: f32 = 1
  prop x: f32 = 0
  prop y: f32 = 0

  Position: {x, y, 5}
  SpatialIgnore
  ArcTicks ticks(r: r, value: value, hue: hue, red_from: red_from, red_to: red_to) { Position: {0, 0, 0} }
  shown { Position: {0, 2, 1}; Text: {value: match text == "" { true: "{clamp(value, 0, 9.99) * 100:.0}"; _: text }, size: r * 0.46, font: font_head, align: Center}; Rgb: LUMEN; Emissive: {strength: 2, color: hue}; BlendMode: Additive }
  Stencil name(text: label, size: 10, y: 0 - r * 1.28, ink: LUM_DIM)
}

template Readout {
  prop value: i32 = 0
  prop label: string = ""
  prop x: f32 = 0
  prop y: f32 = 0
  prop size: f32 = 26
  prop hue: Rgb = LUMEN

  Position: {x, y, 5}
  SpatialIgnore
  Stencil name(text: label, size: 10, y: size * 0.92)
  shown { Position: {0, 0, 1}; Text: {value: "{value}", size: size, font: font_head, align: Center}; Rgb: hue; Emissive: {strength: 2.2, color: NEON}; BlendMode: Additive }
}

template Fader {
  prop label: string = ""
  prop sig: i32 = 0
  prop top: string = ""
  prop low: string = ""
  prop travel: f32 = 150
  prop x: f32 = 0
  prop y: f32 = 0
  prop speed: f32 = 0.0056
  prop w: f32 = 46

  mut hover = false
  const v = kn[sig]

  Position: {x, y, 5}
  Interactive
  Cursor: {CursorPointer}

  hit { Position: {0, 0, 0}; Rect: {w, travel + 26}; Rgb: {NEON.r * 0.012, NEON.g * 0.012, NEON.b * 0.012}; BlendMode: Additive; SpatialIgnore }
  pad { Position: {0, 0, 0.2}; Rect: {w, travel + 26}; Rgb: {0, 0, 0}; BlendMode: Additive }
  Stencil name(text: label, size: 10, y: travel / 2 + 22)
  Stencil u(text: top, size: 8, y: travel / 2 + 8, ink: LUM_FAINT)
  Stencil d(text: low, size: 8, y: 0 - travel / 2 - 8, ink: LUM_FAINT)
  rail { Position: {0, 0, 1}; Rect: {2, travel}; Rgb: LUM_FAINT; BlendMode: Additive; SpatialIgnore }
  run {
    Position: {0, (v - 1) * travel / 2, 1.2}
    Scale: {1, max(v, 0.002), 1}
    Transition: [Position: {duration: 0.05}, Scale: {duration: 0.05}]
    Rect: {4, travel}
    Rgb: NEON
    Emissive: {strength: 3, color: NEON}
    BlendMode: Additive
    SpatialIgnore
  }
  thumb {
    Position: {0, (v - 0.5) * travel, 3}
    Transition: [Position: {duration: 0.05}]
    ChamferRing ring(w: w - 8, h: 15, c1: 4, c2: 0, c3: 4, c4: 0, t: 1.5, hue: LUMEN, glow: match hover { true: 6; _: 3.4 }, z: 0)
  }

  async {
    while true {
      await on.enter(this)
      hover = true
      await on.leave(this)
      hover = false
    }
  }

  async {
    while true {
      const e = await on.drag(this)
      kn[sig] = clamp(kn[sig] - e.delta_y * speed, 0, 1)
    }
  }

  async {
    while true {
      const e = await on.scroll(this)
      kn[sig] = clamp(kn[sig] + e.delta_y * 0.02, 0, 1)
    }
  }
}

template SegColumn {
  prop label: string = ""
  prop value: f32 = 0
  prop hue: Rgb = NEON
  prop h: f32 = 200
  prop w: f32 = 28
  prop x: f32 = 0
  prop y: f32 = 0
  prop count: i32 = 22

  Position: {x, y, 5}
  SpatialIgnore
  ChamferRing ring(w: w + 8, h: h + 8, c1: 6, c2: 0, c3: 6, c4: 0, t: 1, hue: LUM_FAINT, glow: 1.2, z: 0)
  for i in 0..count {
    const f = (i + 0.5) / count
    const on = value > 0.004 && f <= value
    "s_{i}" {
      Position: {0, (f - 0.5) * h, 1}
      Rect: {w - 4, h / count * 0.68}
      Rgb: match on { true: hue; _: {hue.r * 0.07, hue.g * 0.07, hue.b * 0.07} }
      Emissive: {strength: match on { true: 2.6; _: 0 }, color: hue}
      BlendMode: Additive
    }
  }
  Stencil name(text: label, size: 10, y: h / 2 + 15)
}

template MainTile {
  prop x: f32 = 0
  prop y: f32 = 0
  prop w: f32 = 150
  prop h: f32 = 160

  mut hover = false
  const on_ = main_on
  const hue: Rgb = match on_ { true: MINT; _: NEON }
  const beat = !on_ && slow

  Position: {x, y, 5}
  Interactive
  Cursor: {CursorPointer}

  ChamferFill plate(w: w, h: h, c1: 18, c2: 0, c3: 18, c4: 0, hue: hue, glow: match beat { true: 0.8; _: match hover { true: 0.4; _: 0.14 } })
  ChamferRing ring(w: w, h: h, c1: 18, c2: 0, c3: 18, c4: 0, t: 2.8, hue: hue, glow: match beat { true: 9; _: 4.2 })
  glyph {
    Position: {0, 12, 2}
    circle { Position: {0, 0, 0}; Circle: {30}; Rgb: {0, 0, 0}; BlendMode: Additive; Border: {width: 4, color: {hue.r, hue.g, hue.b, 255}}; SpatialIgnore }
    bar { Position: {0, 14, 1}; Rect: {5, 34}; Rgb: hue; Emissive: {strength: 4, color: hue}; BlendMode: Additive; SpatialIgnore }
  }
  Stencil name(text: "MAIN BUS", size: 15, y: -38, ink: LUMEN)
  Stencil state(text: match on_ { true: "ONLINE"; _: "TAP TO CLOSE" }, size: 10, y: -56, ink: hue)

  async {
    while true {
      await on.enter(this)
      hover = true
      await on.leave(this)
      hover = false
    }
  }

  async {
    while true {
      await on.click(this)
      emit Cmd(op: OP_MAIN, a: 0, b: 0)
    }
  }
}

template MicroBank {
  prop w: f32 = 300
  prop h: f32 = 90
  prop label: string = ""
  prop seed: i32 = 0
  prop tone: Rgb = {120, 112, 100}
  prop live: bool = true

  plate { Position: {0, 0, 0}; RoundedBox: {w, h, 8, 3, segments: 1}; Rgb: tone; PbrMaterial: {metallic: 1, roughness: 1}; PbrTextures: {albedo: tex_stain, orm: tex_stain_orm, normal: tex_stain_normal}; TextureTransform: {scale_x: w / 700, scale_y: h / 700} }
  handle_a : Steel { Position: {6 - w / 2, 0, 8}; Box: {3, h * 0.5, 3}; Rgb: {60, 58, 54} }
  handle_b : Steel { Position: {w / 2 - 6, 0, 8}; Box: {3, h * 0.5, 3}; Rgb: {60, 58, 54} }
  if label != "" {
    Etch name(text: label, size: 21, y: h / 2 - 17, z: 4.2, tone: {22, 20, 18})
  }
  for j in 0..3 {
    for i in 0..9 {
      const r = rnd(seed * 3.1 + i * 7.3 + j * 13.7)
      const lx = (i - 4) * (w - 60) / 8.5
      const ly = (j - 1) * (h - 50) / 3 - 14
      if r < 0.28 {
        "sw_{i}_{j}" : Chrome { Position: {lx, ly, 6}; Rotation: {match r < 0.14 { true: 0.6; _: -0.6 }, 0, 0}; Box: {6, 6, 26}; Rgb: {170, 170, 170} }
      } else if r < 0.72 {
        Led "led_{i}_{j}"(lit: live && rnd(seed + i * 2.3 + j * 5.1) < 0.66, hue: match floor(r * 40) % 4 { 0: {255, 60, 36}; 1: {110, 255, 140}; 2: {255, 170, 40}; _: {255, 220, 150} }, r: 8, power: 9) { Position: {lx, ly, 4} }
      } else if r < 0.84 {
        "cap_{i}_{j}" { Position: {lx, ly, 4.2}; Box: {34, 22, 3}; Rgb: {18, 16, 14}; Emissive: {strength: match live && r < 0.8 { true: 1.2; _: 0.02 }, color: {255, 180, 80}} }
      }
    }
  }
  SpatialIgnore
}

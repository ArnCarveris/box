using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.light
using box.spatial
using box.particle
using box.text
using box.transition

fn kind_hue(k: i32) -> Rgb {
  match k { 1: {255, 150, 90}; 2: {120, 170, 255}; 3: {255, 214, 120}; 4: {210, 200, 170}; 5: {190, 140, 255}; 6: {160, 255, 220}; 7: {160, 220, 255}; 8: {120, 180, 255}; 9: {255, 120, 190}; _: {255, 90, 170} }
}

template HoloMod {
  prop s: i32 = 0
  const k = slot_kind[s]
  const b = slot_build[s]
  const j = slot_junction(s)
  const hue: Rgb = kind_hue(k)
  const power = match slot_eff[s] > 0.2 { true: 2.6; _: 0.5 }

  if k != M_NONE {
    Position: {slot_x(s) * 1.4, slot_y(s) - SPINE_Y, junction_z(j) + 130}
    Rotation: {0, 0, slot_roll(s)}
    stalk { Position: {0, 7, 0}; Box: {0.8, 14, 0.8}; Rgb: {hue.r * 0.25, hue.g * 0.25, hue.b * 0.25}; Emissive: {strength: power * 0.6, color: hue}; BlendMode: Additive; NoShadow }
    blob {
      Position: {0, 22, 0}
      Scale: {b, b, b}
      if k == M_HABITAT {
        Rotation: {PI / 2, 0, 0}
        Torus: {radius: 13, tube: 2, segments: 24, rings: 8}
      } else if k == M_REACTOR {
        Sphere: {radius: 7, segments: 16}
      } else if k == M_SOLAR {
        Box: {26, 14, 0.6}
      } else if k == M_DOCK {
        Box: {26, 3, 3}
      } else if k == M_REFINERY {
        Cylinder: {radius: 5, length: 16, segments: 10}
      } else if k == M_RELAY {
        Cone: {radius: 8, length: 6, segments: 14}
      } else if k == M_LEISURE {
        HemiSphere: {radius: 11, segments: 18}
      } else {
        Box: {13, 10, 10}
      }
      Rgb: {hue.r * 0.3, hue.g * 0.3, hue.b * 0.3}
      Emissive: {strength: power, color: hue}
      BlendMode: Additive
      Transition: [Emissive: {duration: 0.6}]
      NoShadow
    }
  }
}

holo_plinth {
  SpatialIgnore
  Position: {0, 0, -1.02}

  base : Iron { Position: {0, 0.26, 0}; Rotation: {0, 0.3, 0}; Cylinder: {radius: 0.22, length: 0.52, segments: 8}; Rgb: {70, 70, 72}; TextureTransform: {scale_x: 0.6, scale_y: 0.4} }
  top : Anod { Position: {0, 0.55, 0}; Cylinder: {radius: 0.3, length: 0.06, segments: 32, smooth: true} }
  rim : Brass { Position: {0, 0.585, 0}; Tube: {radius: 0.31, thickness: 0.018, length: 0.02, segments: 40, smooth: true}; Rgb: {150, 116, 60} }
  lens : Optic { Position: {0, 0.6, 0}; Scale: {0.26, 0.05, 0.26}; Sphere: {radius: 1, segments: 24, smooth: true}; Transmission: {transmission_factor: 1, ior: 1.5, thickness_factor: 0.04, attenuation_distance: 0.4, attenuation_color: {255, 190, 110}} }
  lens_glow { Position: {0, 0.58, 0}; Cylinder: {radius: 0.12, length: 0.01, segments: 24}; Rgb: {10, 10, 20}; Emissive: {strength: 3 * bool_f(main_on), color: NEON}; Transition: [Emissive: {duration: 1.4}]; NoShadow }
  uplight { Position: {0, 0.62, 0}; PointLight: {intensity: 0.1 * bool_f(main_on), range: 1.8}; Rgb: NEON }

  if main_on {
    cone_a { Position: {0, 0.86, 0}; Rect: {0.56, 0.5}; Rotation: {0, 0.5, 0}; Image: {texture: tex_fan, v0: 1, v1: 0}; Rgb: {96, 52, 12}; BlendMode: Additive; NoShadow }
    cone_b { Position: {0, 0.86, 0}; Rect: {0.56, 0.5}; Rotation: {0, 2.07, 0}; Image: {texture: tex_fan, v0: 1, v1: 0}; Rgb: {96, 52, 12}; BlendMode: Additive; NoShadow }

    model {
      Position: {0, 0.98, 0}
      Rotation: {0, slow_turn * 0.25, 0}
      Scale: {0.0026, 0.0026, 0.0026}
      Transition: [Rotation: {duration: 7200, timing_function: Linear}]
      spine_h { Position: {0, 0, 0}; Box: {3, 3, 260}; Rgb: {60, 30, 8}; Emissive: {strength: 1.2, color: NEON}; BlendMode: Additive; NoShadow }
      hub_h { Position: {0, 0, 110}; Box: {16, 16, 40}; Rgb: {60, 30, 8}; Emissive: {strength: 1.1, color: NEON}; BlendMode: Additive; NoShadow }
      for j in 0..JUNCS {
        "drum_{j}" { Position: {0, 0, junction_z(j) + 130}; Rotation: {PI / 2, 0, 0}; Cylinder: {radius: 8, length: 12, segments: 10}; Rgb: {70, 36, 10}; Emissive: {strength: match j_factor[isl[j]] > 0.1 { true: 1.8; _: 0.3 }, color: {255, 190, 90}}; BlendMode: Additive; NoShadow }
      }
      for s in 0..SLOTS {
        HoloMod "mod_{s}"(s: s)
      }
      for i in 0..SHIPS {
        if ships[i].state == SH_DOCKED || ships[i].state == SH_APPROACH {
          "ship_{i}" {
            Position: {berth_x(ships[i].berth) * 1.2, berth_y(ships[i].berth) - SPINE_Y + 8, berth_z(ships[i].berth) + 130}
            Rotation: {0, PI / 4, 0}
            Box: {4, 2, 12}
            Rgb: {255, 240, 200}
            Emissive: {strength: 3, color: {255, 240, 200}}
            BlendMode: Additive
            NoShadow
          }
        }
      }
    }
    motes {
      Position: {0, 0.98, 0}
      ParticleEmitter: {max: 400, rate: 90, shape: EmitterSphere, radius: 0.3, direction: {0, 1, 0}, spread: 180, speed: {0.002, 0.02}, lifetime: {2, 4}, size: {0.002, 0.005}, color: {255, 190, 110}, opacity: {0.3, 0.9}, seed: 12}
      ParticleForces: {gravity: {0, 0, 0}, turbulence: 0.02}
      ParticleAppearance: {shape: ParticleCircle, blend: ParticleAdditive}
      ParticleCurves: {opacity: {0, 1, 1, 0}}
    }
  }
}

template PlinthTabs {
  Position: {0, 0.7, -0.98}
  Rotation: {-0.56, 0, 0}
  Scale: {0.001, 0.001, 0.001}

  for i in 0..7 {
    const cold_hint = !main_on && i == ST_POWER
    Tap "tab_{i}"(legend: st_name(i), hue: st_accent(i), lit: cold_hint && slow, w: 92, h: 30, size: 11, op: OP_VIEW, a: i, x: (i - 3) * 100, y: 0)
  }
}

plinth_ui {
  if station == ST_OVERVIEW {
    PlinthTabs tabs()
  }
}

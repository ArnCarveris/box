using box.material
using box.geometry

prefab Iron { Rgb: {150, 146, 138}; PbrMaterial: {metallic: 1, roughness: 1}; PbrTextures: {albedo: tex_iron, orm: tex_iron_orm, normal: tex_iron_normal} }
prefab IronDark : Iron { Rgb: {58, 58, 60} }
prefab IronBone : Iron { Rgb: {176, 168, 148} }
prefab IronOxide : Iron { Rgb: {126, 62, 38} }
prefab IronMustard : Iron { Rgb: {178, 130, 46} }
prefab IronTeal : Iron { Rgb: {52, 88, 88} }
prefab Hull { Rgb: {164, 158, 146}; PbrMaterial: {metallic: 1, roughness: 1}; PbrTextures: {albedo: tex_plate, orm: tex_plate_orm, normal: tex_plate_normal} }
prefab HullDark : Hull { Rgb: {84, 84, 86} }
prefab HullBone : Hull { Rgb: {196, 188, 168} }
prefab HullOxide : Hull { Rgb: {134, 70, 44} }
prefab HullMustard : Hull { Rgb: {176, 132, 56} }
prefab HullTeal : Hull { Rgb: {64, 104, 106} }
prefab Deck { Rgb: {164, 160, 152}; PbrMaterial: {metallic: 1, roughness: 1}; PbrTextures: {albedo: tex_deck, orm: tex_deck_orm, normal: tex_deck_normal} }
prefab Grate { Rgb: {150, 146, 138}; PbrMaterial: {metallic: 1, roughness: 0.6}; PbrTextures: {albedo: tex_grate}; AlphaCutoff: {0.5}; BackFaceMode: BackFacePlain }
prefab Soot { Rgb: {18, 18, 20}; PbrMaterial: {metallic: 0.7, roughness: 0.62} }
prefab Rubber { Rgb: {14, 14, 15}; PbrMaterial: {metallic: 0, roughness: 0.84} }
prefab Anod { Rgb: {24, 24, 27}; PbrMaterial: {metallic: 0.9, roughness: 0.4}; SpecularAnisotropy: {strength: 0.6} }
prefab Steel { Rgb: {168, 168, 172}; PbrMaterial: {metallic: 1, roughness: 0.3}; SpecularAnisotropy: {strength: 0.7} }
prefab Chrome { Rgb: {214, 214, 220}; PbrMaterial: {metallic: 1, roughness: 0.14} }
prefab Brass { Rgb: {180, 140, 72}; PbrMaterial: {metallic: 1, roughness: 0.3} }
prefab Copper { Rgb: {186, 106, 62}; PbrMaterial: {metallic: 1, roughness: 0.36} }
prefab Bakelite { Rgb: {30, 22, 18}; PbrMaterial: {metallic: 0, roughness: 0.24}; ClearCoat: {strength: 0.8, roughness: 0.1} }
prefab SignalRed { Rgb: {170, 30, 22}; PbrMaterial: {metallic: 0.1, roughness: 0.3}; ClearCoat: {strength: 0.6, roughness: 0.2} }
prefab Lacquer { Rgb: {176, 132, 52}; PbrMaterial: {metallic: 0.2, roughness: 0.34}; ClearCoat: {strength: 1, roughness: 0.06} }
prefab Optic {
  Rgb: {226, 240, 246}
  PbrMaterial: {metallic: 0, roughness: 0.04}
  Transmission: {transmission_factor: 1, ior: 1.46, thickness_factor: 1, attenuation_distance: 60, attenuation_color: {186, 226, 240}}
  NoShadow
}
prefab Rock { Rgb: {168, 160, 152}; PbrMaterial: {metallic: 1, roughness: 1}; PbrTextures: {albedo: tex_rock, orm: tex_rock_orm, normal: tex_rock_normal}; TextureTransform: {scale_x: 1, scale_y: 1} }
prefab TyRock : Rock { Emissive: {strength: 3.6, color: {255, 255, 255}}; PbrTextures: {albedo: tex_rock, orm: tex_rock_orm, normal: tex_rock_normal, emissive: tex_veins} }
prefab Stained { Rgb: {168, 160, 146}; PbrMaterial: {metallic: 1, roughness: 1}; PbrTextures: {albedo: tex_stain, orm: tex_stain_orm, normal: tex_stain_normal} }
prefab StainedDark : Stained { Rgb: {92, 86, 78} }
prefab StainedSoot : Stained { Rgb: {48, 45, 42} }
prefab Trim : Stained { Rgb: {232, 104, 22} }
prefab TrimYellow : Stained { Rgb: {240, 170, 30} }
prefab WetFloor { Rgb: {200, 196, 186}; PbrMaterial: {metallic: 1, roughness: 1}; PbrTextures: {albedo: tex_floor, orm: tex_floor_orm, normal: tex_floor_normal, emissive: tex_floor_glow}; Emissive: {strength: 2.4, color: {255, 255, 255}} }
prefab BlackGlass { Rgb: {4, 3, 3}; PbrMaterial: {metallic: 0, roughness: 0.62} }

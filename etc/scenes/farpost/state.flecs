}

fn milestone_goal(m: i32) -> string {
  match m {
    0: "PULL MAIN BUS, SEND A RIG TO A CLAIM, OPEN A ROUTE. LAND ONE SHIPMENT."
    1: "EARN 9,000 CR LIFETIME. A SOLAR MAST WOULD NOT HURT."
    2: "BUILD A REFINERY. PRODUCE 30 TY CELLS AND SHIP THEM."
    3: "CLEAR 8 FREELANCERS THROUGH THE DOCKS."
    4: "HOUSE 120 RESIDENTS. KEEP AVERAGE CRIME UNDER 45."
    5: "EARN 150,000 CR LIFETIME."
    6: "FILL ALL 12 SLOTS. 400,000 CR LIFETIME. CRIME UNDER 30."
    _: "THE CORRIDOR IS OPEN. FARPOST-9 IS A FREE PORT."
  }
}


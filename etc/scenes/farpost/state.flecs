  match k { 0: "---"; 1: "RCT"; 2: "SOL"; 3: "DOC"; 4: "HLD"; 5: "RFN"; 6: "HAB"; 7: "RLY"; 8: "WCH"; 9: "BZR"; _: "DOM" }
}

fn mod_cost(k: i32) -> f32 {
  match k { 1: 14000; 2: 1800; 3: 5200; 4: 2200; 5: 7800; 6: 9600; 7: 6400; 8: 4800; 9: 16000; 10: 26000; _: 0 }
}

fn mod_parts(k: i32) -> f32 {
  match k { 1: 60; 2: 8; 3: 22; 4: 10; 5: 30; 6: 40; 7: 24; 8: 16; 9: 44; 10: 60; _: 0 }
}

fn mod_time(k: i32) -> f32 {
  match k { 1: 42; 2: 14; 3: 24; 4: 16; 5: 30; 6: 36; 7: 26; 8: 20; 9: 34; 10: 44; _: 1 }
}

fn mod_load(k: i32) -> f32 {
  match k { 1: 0; 2: 0; 3: 10; 4: 4; 5: 34; 6: 22; 7: 14; 8: 9; 9: 26; 10: 38; _: 0 }
}

fn mod_output(k: i32) -> f32 {
  match k { 1: 130; 2: 42; _: 0 }
}

fn mod_unlock(k: i32) -> i32 {
  match k { 1: 3; 2: 1; 3: 2; 4: 1; 5: 2; 6: 3; 7: 2; 8: 3; 9: 4; 10: 5; _: 99 }
}

fn mod_blurb(k: i32) -> string {
  match k {
    1: "130 MW. BURNS FUEL."
    2: "42 MW. FREE, IF WEAK."
    3: "TWO MORE BERTHS."
    4: "+240 T OF HOLD."
    5: "2.5 ORE TO 1 CELL."
    6: "120 RESIDENTS. RENT."
    7: "+1 TRADE ROUTE."
    8: "+6 GUARD BUNKS."
    9: "SPENDS VISITOR CREDS."
    _: "BIG MONEY. BIG CRIME."
  }
}

fn slot_junction(s: i32) -> i32 {
  s / 3
}

fn milestone_name(m: i32) -> string {
  match m {
    0: "COLD HULL"

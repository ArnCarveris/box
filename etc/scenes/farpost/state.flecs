fn sys_name(s: i32) -> string {
  match s { 0: "FARPOST-9"; 1: "CAIRN"; 2: "OSTRAVA"; 3: "VESPER"; 4: "KESTREL GATE"; 5: "NAUR"; 6: "TOLLIVER"; _: "CINDER YARD" }
}

fn sys_x(s: i32) -> f32 {
  match s { 0: -300; 1: -130; 2: 50; 3: -160; 4: 90; 5: 300; 6: -20; _: 310 }
}

fn sys_y(s: i32) -> f32 {
  match s { 0: 10; 1: 120; 2: 155; 3: -80; 4: -30; 5: 110; 6: -160; _: -130 }
}

fn sys_faction(s: i32) -> i32 {
  match s { 0: 1; 1: 1; 2: 0; 3: 1; 4: 3; 5: 0; 6: 2; _: 2 }
}

fn sys_price_k(s: i32, g: i32) -> f32 {
  match s * 5 + g {
    5: 1.1; 6: 0.86; 7: 0.92; 8: 0.95; 9: 0.9
    10: 1.28; 11: 1.0; 12: 1.25; 13: 0.72; 14: 1.1
    15: 0.86; 16: 1.2; 17: 0.74; 18: 1.2; 19: 0.74
    20: 1.0; 21: 1.42; 22: 1.1; 23: 0.86; 24: 1.28
    25: 1.5; 26: 1.3; 27: 1.4; 28: 0.66; 29: 1.2
    30: 0.8; 31: 1.7; 32: 1.3; 33: 0.9; 34: 0.62
    35: 1.3; 36: 1.86; 37: 0.68; 38: 0.54; 39: 1.1
    _: 1
  }
}

fn lane_a(e: i32) -> i32 {
  match e { 0: 0; 1: 1; 2: 1; 3: 0; 4: 3; 5: 2; 6: 4; 7: 3; 8: 4; _: 6 }
}

fn lane_b(e: i32) -> i32 {
  match e { 0: 1; 1: 2; 2: 3; 3: 3; 4: 4; 5: 5; 6: 5; 7: 6; 8: 7; _: 7 }
}

fn lane_sec(e: i32) -> f32 {
  match e { 0: 72; 1: 58; 2: 40; 3: 34; 4: 26; 5: 62; 6: 22; 7: 14; 8: 8; _: 18 }
}

fn lane_len(e: i32) -> f32 {
  sqrt(sqr(sys_x(lane_a(e)) - sys_x(lane_b(e))) + sqr(sys_y(lane_a(e)) - sys_y(lane_b(e)))) / 7
}

fn path_len(d: i32) -> i32 {
  match d { 1: 1; 2: 2; 3: 1; 4: 2; 5: 3; 6: 2; _: 3 }
}

fn path_lane(d: i32, i: i32) -> i32 {
  match d * 3 + i {
    3: 0
    6: 0; 7: 1
    9: 3
    12: 3; 13: 4
    15: 0; 16: 1; 17: 5
    18: 3; 19: 7
    21: 3; 22: 4; 23: 8
    _: 0
  }
}

fn path_node(d: i32, i: i32) -> i32 {
  match d * 3 + i {
    3: 1
    6: 1; 7: 2
    9: 3
    12: 3; 13: 4
    15: 1; 16: 2; 17: 5
    18: 3; 19: 6
    21: 3; 22: 4; 23: 7
    _: 0
  }
}


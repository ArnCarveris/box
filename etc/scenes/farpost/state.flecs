fn fract(x: f64) -> f64 {
  x - floor(x)
}

fn rnd(s: f64) -> f64 {
  fract(sin(s * 12.9898 + 78.233) * 43758.5453)
}

fn clamp01(x: f64) -> f64 {
  clamp(x, 0, 1)
}

fn imax(a: i32, b: i32) -> i32 {
  match a > b { true: a; _: b }
}

fn imin(a: i32, b: i32) -> i32 {
  match a < b { true: a; _: b }
}

fn bool_f(b: bool) -> f32 {
  match b { true: 1; _: 0 }
}

fn pct(x: f32) -> i32 {
  floor(clamp(x, 0, 1) * 100 + 0.5)
}

fn good_name(g: i32) -> string {
  match g { 0: "TY ORE"; 1: "TY CELLS"; 2: "RATIONS"; 3: "PARTS"; _: "FUEL" }
}

fn good_code(g: i32) -> string {
  match g { 0: "ORE"; 1: "CEL"; 2: "RAT"; 3: "PRT"; _: "FUL" }
}

fn good_base(g: i32) -> f32 {
  match g { 0: 24; 1: 150; 2: 15; 3: 44; _: 28 }
}

fn mod_name(k: i32) -> string {
  match k {
    0: "EMPTY"
    1: "FUSION CORE"
    2: "SOLAR MAST"
    3: "DOCK ARM"
    4: "CARGO STACK"
    5: "REFINERY"
    6: "HAB RING"
    7: "LANE RELAY"
    8: "WATCH POST"
    9: "BAZAAR"
    _: "PLEASURE DOME"
  }
}


using box.text
using box.texture
using box.surface
using box.light

window { Surface: {width: 1920, height: 1080, vsync: true, anisotropy: High} }

font_glass { Font: {path: "etc/scenes/farpost/assets/fonts/IBMPlexMono-Light.ttf"} }
font_data { Font: {path: "etc/scenes/farpost/assets/fonts/IBMPlexMono-Regular.ttf"} }
font_head { Font: {path: "etc/scenes/farpost/assets/fonts/Oxanium.ttf"} }
font_plate { Font: {path: "etc/scenes/farpost/assets/fonts/SairaStencilOne-Regular.ttf"} }

tex_iron { TexturePath: {path: "etc/scenes/farpost/assets/iron_albedo.jpg"} }

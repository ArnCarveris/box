tex_stain { TexturePath: {path: "etc/scenes/farpost/assets/stain_albedo.jpg"} }
tex_stain_orm { TexturePath: {path: "etc/scenes/farpost/assets/stain_orm.jpg"} }
tex_stain_normal { TexturePath: {path: "etc/scenes/farpost/assets/stain_normal.jpg"} }
tex_grate { TexturePath: {path: "etc/scenes/farpost/assets/grate.png"} }

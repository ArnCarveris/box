tex_rings { TexturePath: {path: "etc/scenes/farpost/assets/rings.png"} }
tex_halo { TexturePath: {path: "etc/scenes/farpost/assets/halo.png"} }
tex_limb { TexturePath: {path: "etc/scenes/farpost/assets/limb.png"} }
tex_flare { TexturePath: {path: "etc/scenes/farpost/assets/flare.png"} }

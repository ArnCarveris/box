using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.text
using box.layout
using box.spatial
using box.picking
using box.transition

fn sec_hue_r(s: f32) -> f32 {
  lerp(255, 110, clamp01(s / 70))
}

fn sec_hue_g(s: f32) -> f32 {
  lerp(84, 255, clamp01(s / 70))
}

fn sec_hue_b(s: f32) -> f32 {
  lerp(62, 206, clamp01(s / 70))
}

fn route_status(i: i32) -> string {
  match routes[i].phase { 1: "LOADING"; 2: "OUTBOUND"; 3: "INBOUND"; _: "IDLE" }
}

fn route_arrow(e: bool) -> string {
  match e { true: ">"; _: "<" }
}

template LaneLine {
  prop e: i32 = 0
  const ax = sys_x(lane_a(e))
  const ay = sys_y(lane_a(e))
  const bx = sys_x(lane_b(e))
  const by = sys_y(lane_b(e))
  const sec = lane_security(e)
  const raid = lane_alert[e] > 0
  const chosen = sel_lane == e
  const hue: Rgb = {sec_hue_r(sec), sec_hue_g(sec), sec_hue_b(sec)}
  const mx = (ax + bx) / 2
  const my = (ay + by) / 2
  const len = sqrt(sqr(bx - ax) + sqr(by - ay))
  const ang = atan2(by - ay, bx - ax)

  Hair line(x1: ax, y1: ay, x2: bx, y2: by, w: match chosen { true: 3.4; _: 1.5 }, hue: match raid && pulse { true: ALERT; _: hue }, glow: match chosen { true: 2.6; _: 1.2 })
  lane_hit {
    Position: {mx, my, 8}
    Rotation: {0, 0, ang}
    Pick pad(w: len * 0.5, h: 14, op: OP_SELECT_LANE, a: e, selected: chosen, tone: hue)
  }
  for w in 0..4 {
    if patrol[e] > w {
      "wing_{w}" { Position: {mx + cos(ang) * (w - 1.5) * 15, my + sin(ang) * (w - 1.5) * 15 + 10, 6}; Rotation: {0, 0, PI / 4}; Rect: {6.4, 6.4}; Rgb: MINT; Emissive: {strength: 2.2, color: MINT}; BlendMode: Additive; SpatialIgnore }
    }
  }
}

template SysNode {
  prop s: i32 = 0
  const home = s == 0
  const chosen = sel_sys == s && !home
  const fac = sys_faction(s)

  group {
    Position: {sys_x(s), sys_y(s), 10}
    ring { Position: {0, 0, 0}; Circle: {match home { true: 13; _: 9 }}; Rgb: match home { true: {TY_INK.r * 0.4, TY_INK.g * 0.4, TY_INK.b * 0.4}; _: {4, 8, 12} }; BlendMode: Additive; Border: {width: 1.6, color: match home { true: {TY_INK.r, TY_INK.g, TY_INK.b, 255}; _: match chosen { true: {255, 255, 255, 255}; _: {LUM_DIM.r, LUM_DIM.g, LUM_DIM.b, 255} } }}; SpatialIgnore }
    if chosen {
      Hair t_a(x1: -22, y1: 0, x2: -13, y2: 0, w: 1.4, hue: LUMEN, z: 0)
      Hair t_b(x1: 22, y1: 0, x2: 13, y2: 0, w: 1.4, hue: LUMEN, z: 0)
      Hair t_c(x1: 0, y1: 22, x2: 0, y2: 13, w: 1.4, hue: LUMEN, z: 0)
      Hair t_d(x1: 0, y1: -22, x2: 0, y2: -13, w: 1.4, hue: LUMEN, z: 0)
    }
    Ink name(text: sys_name(s), size: 13, hue: match chosen || home { true: LUMEN; _: LUM_DIM }, x: 0, y: -22, align: Center, font: font_data)
    Ink f_t(text: faction_code(fac), size: 9.5, hue: match fac { 2: ALERT; 3: K_ICE; _: LUM_FAINT }, x: 0, y: -35, align: Center)
    if !home {
      Pick hit(w: 54, h: 54, op: OP_SELECT_SYS, a: s, selected: false)
    }
  }
}

template RouteToken {
  prop i: i32 = 0
  const on = routes[i].active && routes[i].phase >= RT_OUT
  if on {
    const d = routes[i].dest
    const out = routes[i].phase == RT_OUT
    const h = routes[i].hop
    const f = match out { true: routes[i].t; _: 1 - routes[i].t }
    const a = match h { 0: 0; _: path_node(d, h - 1) }
    const b = path_node(d, h)
    token {
      Position: {lerp(sys_x(a), sys_x(b), f), lerp(sys_y(a), sys_y(b), f), 12}
      Transition: [Position: {duration: 0.3}]
      Rotation: {0, 0, PI / 4}
      Rect: {8.4, 8.4}
      Rgb: GOLD
      Emissive: {strength: 3.4, color: GOLD}
      BlendMode: Additive
      SpatialIgnore
    }
  }
}

template RouteRow {
  prop i: i32 = 0
  prop y: f32 = 0
  const on = routes[i].active
  const licensed = i < route_slots

  if on {
    Ink a(text: "{good_code(routes[i].good)} {route_arrow(routes[i].exporting)} {sys_name(routes[i].dest)}", size: 13, hue: LUMEN, x: -368, y: y, font: font_data)
    Ink b(text: route_status(i), size: 11, hue: match routes[i].phase { 1: WARM; 2: GOLD; _: MINT }, x: -130, y: y)
    Ink c(text: "{routes[i].load:.0} T", size: 12, hue: LUM_DIM, x: -40, y: y, font: font_data)
    Meter m(x: 90, y: y, w: 130, h: 7, value: match routes[i].phase { 1: routes[i].load / 40; _: (routes[i].hop + routes[i].t) / path_len(routes[i].dest) }, ticks: 1, hue: GOLD)
    Pick close(x: 192, y: y, w: 48, h: 22, op: OP_CLOSE_ROUTE, a: i, tone: ALERT)
    Ink x_(text: "CLOSE", size: 10, hue: ALERT, x: 192, y: y, align: Center, z: 12)
  } else if licensed {
    Ink a(text: "LICENCE {i + 1} OPEN", size: 12, hue: LUM_FAINT, x: -368, y: y)
  } else {
    Hair h_(x1: -368, y1: y, x2: 230, y2: y, w: 0.6, hue: LUM_WIRE)
  }
}

Console console_trade(st: ST_TRADE) {
  GlassLayer ui() {
    Ink map_t(text: "CORRIDOR CHART", size: 13, hue: LUM_DIM, x: -384, y: 190, font: font_data)
    grid {
      Position: {-60, 30, -6}
      for i in 0..15 {
        Hair "gx_{i}"(x1: (i - 7) * 48, y1: -165, x2: (i - 7) * 48, y2: 165, w: 0.6, hue: LUM_WIRE, z: 0)
      }
      for i in 0..8 {
        Hair "gy_{i}"(x1: -336, y1: (i - 3.5) * 44, x2: 336, y2: (i - 3.5) * 44, w: 0.6, hue: LUM_WIRE, z: 0)
      }
    }
    map {
      Position: {-68, 30, 4}
      for e in 0..LANES {
        LaneLine "lane_{e}"(e: e)
      }
      for s in 0..SYSTEMS {
        SysNode "sys_{s}"(s: s)
      }
      for i in 0..ROUTES {
        RouteToken "tok_{i}"(i: i)
      }
    }
    Hair div(x1: 256, y1: 200, x2: 256, y2: -258, hue: LUM_WIRE)
    market {
      Position: {330, 60, 8}
      Ink name(text: sys_name(sel_sys), size: 16, font: font_head, hue: LUMEN, x: -66, y: 128, glow: 2)
      Ink fac(text: faction_name(sys_faction(sel_sys)), size: 10, hue: LUM_DIM, x: -66, y: 110)
      Ink h_a(text: "SELL", size: 10, hue: MINT, x: 30, y: 92, align: Right, width: 40)
      Ink h_b(text: "BUY", size: 10, hue: WARM, x: 72, y: 92, align: Right, width: 40)
      for g in 0..GOODS {
        Ink "n_{g}"(text: good_code(g), size: 13, font: font_data, hue: match sel_good == g { true: LUMEN; _: LUM_DIM }, x: -66, y: 70 - g * 22)
        Ink "s_{g}"(text: "{sell_price(sel_sys, g, market_t):.0}", size: 13, font: font_data, hue: MINT, x: 30, y: 70 - g * 22, align: Right, width: 40)
        Ink "b_{g}"(text: "{buy_price(sel_sys, g, market_t):.0}", size: 13, font: font_data, hue: WARM, x: 72, y: 70 - g * 22, align: Right, width: 40)
      }
      Hair r_a(x1: -66, y1: -44, x2: 66, y2: -44, hue: LUM_FAINT)
      Ink lane_t(text: "LANE", size: 10, hue: LUM_DIM, x: -66, y: -58)
      Ink lane_n(text: "{sys_name(lane_a(sel_lane))} -", size: 11, hue: LUMEN, x: -66, y: -74)
      Ink lane_n2(text: sys_name(lane_b(sel_lane)), size: 11, hue: LUMEN, x: -66, y: -88)
      Meter sec(x: 0, y: -108, w: 132, h: 9, value: lane_security(sel_lane) / 100, hue: {sec_hue_r(lane_security(sel_lane)), sec_hue_g(lane_security(sel_lane)), sec_hue_b(lane_security(sel_lane))})
      Ink sec_t(text: "SEC {lane_security(sel_lane):.0}  WINGS {patrol[sel_lane]}", size: 10, hue: LUM_DIM, x: -66, y: -124)
    }
    Hair r_list(x1: -384, y1: -142, x2: 250, y2: -142, hue: LUM_FAINT)
    routes_list {
      Position: {0, 0, 6}
      for i in 0..ROUTES {
        RouteRow "row_{i}"(i: i, y: -158 - i * 20)
      }
    }
    Ink raids_t(text: "RAIDS {raids}  SHIPMENTS {shipments}", size: 11, hue: match raids > 0 { true: WARM; _: LUM_DIM }, x: 268, y: -240)
  }

  HwLayer hardware() {
    Stencil c1(text: "COMMODITY", size: 12, y: 250)
    for g in 0..GOODS {
      Tap "good_{g}"(legend: good_code(g), lit: sel_good == g, w: 50, h: 32, size: 12, op: OP_SELECT_GOOD, a: g, x: (g - 2) * 56, y: 222, c: 5)
    }
    Tap ex(legend: "EXPORT", hue: K_GREEN, lit: sel_export, w: 134, h: 34, size: 14, op: OP_SELECT_DIR, a: 1, x: -68, y: 176)
    Tap im(legend: "IMPORT", hue: WARM, lit: !sel_export, w: 134, h: 34, size: 14, op: OP_SELECT_DIR, a: 0, x: 68, y: 176)
    Tap open_(legend: "OPEN ROUTE", sub: "{good_code(sel_good)} TO {sys_name(sel_sys)}", w: 276, h: 58, size: 20, op: OP_OPEN_ROUTE, y: 122, c: 12)
    Hair r_a(x1: -135, y1: 78, x2: 135, y2: 78, hue: LUM_FAINT)
    Stencil c2(text: "ESCORT WINGS ON SELECTED LANE", size: 11, y: 62)
    Tap sub_(legend: "-", hue: K_RED, w: 66, h: 40, size: 22, op: OP_PATROL_SUB, x: -102, y: 26)
    Readout wings(value: patrol[sel_lane], label: "WINGS", x: 0, y: 18, size: 28)
    Tap add_(legend: "+", sub: "500 CR", hue: K_GREEN, w: 66, h: 40, size: 18, op: OP_PATROL_ADD, x: 102, y: 26)
    Hair r_b(x1: -135, y1: -14, x2: 135, y2: -14, hue: LUM_FAINT)
    ArcGauge sec(label: "LANE SECURITY", value: lane_security(sel_lane) / 100, r: 52, red_from: 0, red_to: 0.3, x: -68, y: -84)
    Readout raid_n(value: raids, label: "RAIDS", x: 72, y: -58, size: 26, hue: match raids > 0 { true: ALERT; _: LUMEN })
    Readout ship_n(value: shipments, label: "SHIPPED", x: 72, y: -116, size: 26)
    Hair r_c(x1: -135, y1: -166, x2: 135, y2: -166, hue: LUM_FAINT)
    Ink h_a(text: "LOW SECURITY LANES", size: 11, hue: LUM_DIM, x: -135, y: -184)
    Ink h_b(text: "EAT FREIGHTERS. HIRE WINGS.", size: 11, hue: WARM, x: -135, y: -204)
    Ink h_c(text: "LICENCES {route_slots} OF {ROUTES}", size: 11, hue: LUM_DIM, x: -135, y: -228)
  }
}

using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.light
using box.spatial

export const SUN_PITCH: f32 = 0.3
export const SUN_YAW: f32 = 1.24

sky_root {
  SpatialIgnore

  dome {
    EllipsoidShell: {radius: {26000, 26000, 26000}, longitude_start: 0, longitude_end: 2 * PI, latitude_start: 0 - PI / 2, latitude_end: PI / 2, thickness: 1, segments: 96, rings: 48}
    Rgb: {0, 0, 0}
    PbrMaterial: {metallic: 1, roughness: 0.03}
    Emissive: {strength: 0.42, color: {255, 255, 255}}
    PbrTextures: {emissive: tex_sky}
    NoShadow
  }

  sun {
    Rotation: {SUN_PITCH, SUN_YAW, 0}
    DirectionalLight: {intensity: 7, bake: Realtime}
    Rgb: {255, 238, 214}

    disc {
      Position: {0, 0, -24000}
      Glow halo(r: 1500, hue: {255, 214, 170}, power: 0.5, tex: tex_halo)
      Glow streak(r: 7600, hue: {255, 214, 170}, power: 0.3, tex: tex_flare, at: {0, 0, 2})
      core { Position: {0, 0, 4}; Circle: {230}; Rgb: {255, 250, 240}; Emissive: {strength: 10, color: {255, 236, 210}}; NoShadow }
    }
  }

  harrow {
    Position: {8200, -2500, -12400}
    Rotation: {0.32, 0.5, 0.26}

    body {
      Position: {0, 0, 0}
      Sphere: {radius: 6400, segments: 128, smooth: true}
      Rgb: {255, 255, 255}
      PbrMaterial: {metallic: 0, roughness: 0.95}
      PbrTextures: {albedo: tex_giant}
      NoShadow
    }
    ring_plane {
      Rotation: {PI / 2 + 0.14, 0, 0}
      Rect: {23600, 23600}
      Image: {texture: tex_rings}
      Rgb: {150, 132, 126}
      BlendMode: AlphaBlend
      NoShadow
    }
  }

  harrow_limb {
    Position: {8200, -2500, -12400}
    Rotation: {0 - atan2(2500, sqrt(8200 * 8200 + 12400 * 12400)), atan2(-8200, 12400), 0}
    Rect: {15200, 15200}
    Image: {texture: tex_limb}
    Rgb: {96, 60, 76}
    BlendMode: Additive
    NoShadow
  }
}

using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.light
using box.spatial
using box.particle
using box.text
using box.layout
using box.picking
using box.transition

export const ROOM_R: f32 = 3.5
export const ROOM_SIDES: i32 = 32
export const SILL: f32 = 1.12
export const HEAD: f32 = 2.62
export const CEIL: f32 = 3.2

fn facet_a(i: i32) -> f32 {
  (i + 0.5) * 2 * PI / ROOM_SIDES - PI
}

fn facet_w() -> f32 {
  2 * ROOM_R * tan(PI / ROOM_SIDES) * 1.012
}

fn is_window(i: i32) -> bool {
  abs(facet_a(i)) < 1.06
}

template WallFacet {
  prop i: i32 = 0
  const a = facet_a(i)
  const w = facet_w()
  const win = is_window(i)

  Position: {sin(a) * ROOM_R, 0, 0 - cos(a) * ROOM_R}
  Rotation: {0, 0 - a, 0}
  if win {
    apron : StainedDark { Position: {0, SILL / 2, -0.06}; Box: {w, SILL, 0.12}; TextureTransform: {scale_x: 0.5, scale_y: 0.8, offset_x: i * 0.37} }
    header : StainedDark { Position: {0, (HEAD + CEIL) / 2 + 0.02, -0.06}; Box: {w, CEIL - HEAD + 0.04, 0.12}; TextureTransform: {scale_x: 0.5, scale_y: 0.3, offset_x: i * 0.29} }
    pane { Position: {0, (SILL + HEAD) / 2, -0.08}; Quad: {w, HEAD - SILL}; Rgb: {110, 96, 80}; PbrMaterial: {metallic: 0, roughness: 0.05}; BlendMode: AlphaBlend; Opacity: {0.06}; NoShadow }
    grime { Position: {0, (SILL + HEAD) / 2, -0.05}; Quad: {w, HEAD - SILL}; Rgb: {120, 100, 80}; BlendMode: AlphaBlend; PbrMaterial: {metallic: 0, roughness: 0.9}; PbrTextures: {albedo: tex_grime}; TextureTransform: {scale_x: 1, scale_y: 1, offset_x: i * 0.37, offset_y: i * 0.61}; NoShadow }
    col : StainedDark { Position: {w / 2, (SILL + HEAD) / 2, -0.03}; Box: {0.11, HEAD - SILL + 0.04, 0.2}; TextureTransform: {scale_x: 0.1, scale_y: 0.8} }
    col_trim : Trim { Position: {w / 2, (SILL + HEAD) / 2, 0.075}; Box: {0.024, HEAD - SILL - 0.1, 0.012}; TextureTransform: {scale_x: 0.02, scale_y: 0.7} }
    gusset_a : Trim { Position: {w / 2 - 0.13, HEAD - 0.1, -0.03}; Rotation: {0, 0, 0.78}; Box: {0.34, 0.05, 0.1}; TextureTransform: {scale_x: 0.2, scale_y: 0.02} }
    gusset_b : Trim { Position: {w / 2 + 0.13 - w, HEAD - 0.1, -0.03}; Rotation: {0, 0, -0.78}; Box: {0.34, 0.05, 0.1}; TextureTransform: {scale_x: 0.2, scale_y: 0.02} }
    sill_ : Stained { Position: {0, SILL, 0.04}; Box: {w + 0.02, 0.07, 0.26}; Rgb: {96, 90, 82}; TextureTransform: {scale_x: 0.3, scale_y: 0.05} }
    lintel : StainedSoot { Position: {0, HEAD, 0.05}; Box: {w + 0.02, 0.1, 0.26}; TextureTransform: {scale_x: 0.3, scale_y: 0.05} }
  } else {
    plate : StainedSoot { Position: {0, CEIL / 2, -0.06}; Box: {w, CEIL, 0.12}; TextureTransform: {scale_x: 0.5, scale_y: 1.1, offset_x: i * 0.41} }
    inset : StainedDark { ChamferBlock: {w: w * 0.84, h: 1.28, c1: 0.1, c2: 0.1, c3: 0.1, c4: 0.1, depth: 0.03, z: 0.012}; Position: {0, 1.86, 0.012}; TextureTransform: {scale_x: 0.5, scale_y: 0.8, offset_x: i * 0.23} }
    frame_ { Position: {0, 1.86, 0.03}; ChamferRing ring(w: w * 0.84, h: 1.28, c1: 0.1, c2: 0.1, c3: 0.1, c4: 0.1, t: 0.014, hue: {232, 104, 22}, glow: 0.3, z: 0) }
    if i % 3 == 0 {
      grill { Position: {0, 0.62, 0.012}; Scale: {0.001, 0.001, 0.001}
        back_ : Trim { Position: {0, 0, 0}; Box: {470, 420, 12}; TextureTransform: {scale_x: 0.5, scale_y: 0.5} }
        for k in 0..8 {
          "slat_{k}" : StainedSoot { Position: {0, (k - 3.5) * 48, 9}; Box: {430, 26, 8}; TextureTransform: {scale_x: 0.5, scale_y: 0.03} }
        }
      }
    }
    if i % 4 == 1 {
      lamp_ { Position: {0, 2.72, 0.02}; Box: {w * 0.5, 0.03, 0.02}; Rgb: {30, 26, 20}; Emissive: {strength: match main_on { true: 7; _: 0.1 }, color: {255, 200, 130}}; Transition: [Emissive: {duration: 1}]; NoShadow }
    }
    col : StainedSoot { Position: {w / 2, CEIL / 2, 0}; Box: {0.09, CEIL, 0.18}; TextureTransform: {scale_x: 0.1, scale_y: 1} }
    skirt : Trim { Position: {0, 0.1, 0.01}; Box: {w, 0.05, 0.02}; TextureTransform: {scale_x: 0.3, scale_y: 0.02} }
    rail_ : StainedSoot { Position: {0, 1.08, 0.04}; Box: {w, 0.06, 0.1}; TextureTransform: {scale_x: 0.3, scale_y: 0.02} }
  }
}

template DeskBase {
  prop st: i32 = 0
  const a = st_angle(st)

  Position: {sin(a) * 2.36, 0, 0 - cos(a) * 2.36}
  Rotation: {0, 0 - a, 0}
  body : Stained { Position: {0, 0.37, 0}; Box: {1.22, 0.74, 0.5}; Rgb: {112, 106, 96}; TextureTransform: {scale_x: 1, scale_y: 0.6, offset_x: st * 0.27} }
  plinth : StainedSoot { Position: {0, 0.05, 0.03}; Box: {1.3, 0.1, 0.56}; TextureTransform: {scale_x: 1, scale_y: 0.1} }
  for i in 0..3 {
    "door_{i}" : Stained { Position: {-0.4 + i * 0.4, 0.42, 0.254}; Box: {0.34, 0.5, 0.012}; Rgb: match (i + st) % 3 { 0: {84, 84, 78}; 1: {120, 112, 96}; _: {96, 88, 76} }; TextureTransform: {scale_x: 0.3, scale_y: 0.4, offset_x: i * 0.3 + st * 0.2} }
    "pull_{i}" : Trim { Position: {-0.4 + i * 0.4, 0.58, 0.262}; Box: {0.09, 0.016, 0.006}; TextureTransform: {scale_x: 0.1, scale_y: 0.02} }
  }
  Etch mark(text: "ORION HULLWORKS", size: 0.024, x: 0, y: 0.72, z: 0.255, tone: {30, 28, 26})
}

template StripLight {
  prop x: f32 = 0
  prop y: f32 = 1.8
  prop h: f32 = 1.1
  prop a: f32 = 0
  prop level: f32 = 1.3

  Position: {sin(a) * (ROOM_R - 0.1), y, 0 - cos(a) * (ROOM_R - 0.1)}
  Rotation: {0, 0 - a, 0}
  housing : Trim { Position: {0, 0, 0}; RoundedBox: {0.14, h + 0.14, 0.05, 0.03, segments: 1}; TextureTransform: {scale_x: 0.1, scale_y: 0.4} }
  tube { Position: {-0.022, 0, 0.03}; Box: {0.014, h, 0.014}; Rgb: {60, 60, 60}; Emissive: {strength: match main_on { true: 16; _: 0.3 }, color: {255, 244, 226}}; Transition: [Emissive: {duration: 1, delay: 0.2}]; NoShadow }
  tube_b { Position: {0.022, 0, 0.03}; Box: {0.014, h, 0.014}; Rgb: {60, 60, 60}; Emissive: {strength: match main_on { true: 16; _: 0.3 }, color: {255, 244, 226}}; Transition: [Emissive: {duration: 1, delay: 0.3}]; NoShadow }
  shine { Position: {0, 0, 0.22}; PointLight: {intensity: match main_on { true: level; _: 0 }, range: 6}; Rgb: {255, 236, 210} }
}

template CeilLamp {
  prop x: f32 = 0
  prop z: f32 = 0
  prop level: f32 = 2
  prop yaw: f32 = 0

  Position: {x, CEIL - 0.24, z}
  Rotation: {0, yaw, 0}
  can : StainedSoot { Position: {0, 0, 0}; Box: {0.3, 0.05, 0.16}; TextureTransform: {scale_x: 0.2, scale_y: 0.1} }
  lens { Position: {0, -0.03, 0}; Box: {0.24, 0.01, 0.1}; Rgb: {60, 54, 44}; Emissive: {strength: match main_on { true: 14; _: 0.1 }, color: {255, 226, 180}}; Transition: [Emissive: {duration: 1.2, delay: 0.5}]; NoShadow }
  beam { Position: {0, -0.05, 0}; Rotation: {PI / 2, 0, 0}; SpotLight: {intensity: match main_on { true: level; _: 0 }, range: 7.5, inner_angle: 54, outer_angle: 84}; Rgb: {255, 216, 170} }
}

template LedStack {
  prop a: f32 = 1.2
  prop seed: i32 = 0
  prop base: f32 = 1.22

  Position: {sin(a) * (ROOM_R - 0.12), base, 0 - cos(a) * (ROOM_R - 0.12)}
  Rotation: {0, 0 - a, 0}
  Scale: {0.001, 0.001, 0.001}
  for k in 0..4 {
    MicroBank "bank_{k}"(w: 640, h: 190, seed: seed * 7 + k, live: main_on, tone: match (k + seed) % 3 { 0: {190, 178, 156}; 1: {150, 142, 128}; _: {206, 186, 150} }, label: match (k + seed) % 5 { 0: "FIRE SUPPRESSION"; 1: "EMRG POWER GRID"; 2: "MANUAL OVERRIDE"; 3: "LIFE SUPPORT"; _: "HULL PRESSURE" }) { Position: {0, k * 212, 0} }
  }
  wash { Position: {0, 780, 240}; Rotation: {1.2, 3.14159, 0}; SpotLight: {intensity: match main_on { true: 1.3; _: 0 }, range: 2.2, inner_angle: 40, outer_angle: 70}; Rgb: {255, 226, 190} }
}

template SchematicPane {
  prop a: f32 = 1.2
  prop y: f32 = 1.5
  prop w: f32 = 480
  prop h: f32 = 340
  prop seed: i32 = 0

  const on_ = main_on
  Position: {sin(a) * (ROOM_R - 0.13), y, 0 - cos(a) * (ROOM_R - 0.13)}
  Rotation: {0, 0 - a, 0}
  Scale: {0.001, 0.001, 0.001}
  SpatialIgnore

  frame_ : StainedSoot { Position: {0, 0, 0}; RoundedBox: {w + 34, h + 34, 12, 12, segments: 2}; TextureTransform: {scale_x: 0.5, scale_y: 0.5} }
  glass_ { Position: {0, 0, 6.4}; Rect: {w, h}; Rgb: {8, 16, 26}; Border: {radius: 10, width: 2, color: {120, 200, 255, 255}}; Emissive: {strength: match on_ { true: 0.5; _: 0 }, color: {30, 60, 90}} }
  if on_ {
    ship {
      Position: {-70, 0, 7}
      for i in 0..8 {
        "ln_{i}" { Position: {0, 0, 0}; Line: {x1: 0 - (20 + rnd(seed + i) * 80), y1: (i - 4) * 28, x2: 20 + rnd(seed + i * 2) * 80, y2: (i - 4) * 28, width: 2}; Rgb: {110, 255, 170}; Emissive: {strength: 2, color: {110, 255, 170}}; BlendMode: Additive }
      }
      spine_ { Position: {0, 0, 0}; Rect: {6, 230}; Rgb: {110, 255, 170}; Emissive: {strength: 2.4, color: {110, 255, 170}}; BlendMode: Additive }
      ring_ { Position: {0, 34, 0}; Circle: {62}; Rgb: {0, 0, 0}; BlendMode: Additive; Border: {width: 2.4, color: {110, 255, 170, 255}} }
      ring_b { Position: {0, -70, 0}; Circle: {26}; Rgb: {0, 0, 0}; BlendMode: Additive; Border: {width: 2, color: {255, 70, 60, 255}} }
    }
    for i in 0..12 {
      "row_{i}" {
        Position: {w / 2 - 92, h / 2 - 22 - i * 25, 7}
        Rect: {60 + rnd(seed + i * 3.3) * 90, 9}
        Rgb: match i % 5 { 0: {255, 70, 60}; 1: {255, 200, 90}; _: {226, 240, 255} }
        Emissive: {strength: 1.2, color: {255, 255, 255}}
        BlendMode: Additive
      }
    }
    title { Position: {-70, h / 2 - 22, 7}; Text: {value: match seed % 3 { 0: "HULL INTEGRITY"; 1: "ATMOS LOOP B"; _: "DOCK CLAMPS" }, size: 17, font: font_data, align: Center}; Rgb: {226, 240, 255}; Emissive: {strength: 1.4, color: {226, 240, 255}}; BlendMode: Additive }
  }
  tint_light { Position: {0, 0, 280}; PointLight: {intensity: 0.12 * bool_f(on_), range: 1.8}; Rgb: {130, 190, 255} }
}

template Hatch {
  prop a: f32 = 2.5
  prop tag: string = "A-SEAL"

  Position: {sin(a) * (ROOM_R - 0.16), 1.24, 0 - cos(a) * (ROOM_R - 0.16)}
  Rotation: {0, 0 - a, 0}
  Scale: {0.001, 0.001, 0.001}
  SpatialIgnore

  jamb : Trim { ChamferBlock: {w: 1460, h: 2420, c1: 300, c2: 300, c3: 300, c4: 300, depth: 40, z: 0}; TextureTransform: {scale_x: 1.6, scale_y: 2} }
  gap_ : StainedSoot { ChamferBlock: {w: 1360, h: 2320, c1: 270, c2: 270, c3: 270, c4: 270, depth: 40, z: 6}; TextureTransform: {scale_x: 1, scale_y: 2} }
  leaf : Stained { ChamferBlock: {w: 1260, h: 2220, c1: 240, c2: 240, c3: 240, c4: 240, depth: 70, z: 22}; Rgb: {168, 164, 150}; TextureTransform: {scale_x: 1.2, scale_y: 2} }
  ChamferRing neon_(w: 1400, h: 2360, c1: 284, c2: 284, c3: 284, c4: 284, t: 9, hue: NEON, glow: match main_on { true: 3.4; _: 0.1 }, z: 26)
  strap_a : Trim { Position: {-340, -560, 60}; Box: {90, 520, 10}; TextureTransform: {scale_x: 0.1, scale_y: 0.4} }
  strap_b : Trim { Position: {340, -560, 60}; Box: {90, 520, 10}; TextureTransform: {scale_x: 0.1, scale_y: 0.4} }
  clip_a : TrimYellow { Position: {-340, 500, 60}; Box: {90, 110, 16}; TextureTransform: {scale_x: 0.1, scale_y: 0.1} }
  clip_b : TrimYellow { Position: {340, 500, 60}; Box: {90, 110, 16}; TextureTransform: {scale_x: 0.1, scale_y: 0.1} }
  seam_d : StainedSoot { Position: {0, 0, 58}; Rotation: {0, 0, 0.42}; Box: {1400, 14, 4} }
  plate_a : StainedDark { Position: {0, 560, 58}; Box: {640, 360, 8}; TextureTransform: {scale_x: 0.5, scale_y: 0.3} }
  vent : StainedSoot { Position: {0, -760, 60}; Rotation: {PI / 2, 0, 0}; Cylinder: {radius: 150, length: 14, segments: 24, smooth: true} }
  label_ {
    Position: {820, 120, 26}
    ChamferFill plate(w: 180, h: 280, c1: 30, c2: 0, c3: 30, c4: 0, hue: NEON, glow: match main_on { true: 0.9; _: 0.02 })
    ChamferRing ring(w: 180, h: 280, c1: 30, c2: 0, c3: 30, c4: 0, t: 7, hue: GOLD, glow: match main_on { true: 6; _: 0.1 })
    words { Position: {0, 34, 2}; Text: {value: "AIR\nLOCK", size: 56, font: font_head, align: Center}; Rgb: {30, 12, 2} }
    code { Position: {0, -86, 2}; Text: {value: tag, size: 26, font: font_data, align: Center}; Rgb: {30, 12, 2} }
  }
}

template Beacon {
  prop x: f32 = 0
  prop z: f32 = 0
  prop on: bool = false
  prop hue: Rgb = K_RED

  Position: {x, CEIL - 0.3, z}
  Scale: {0.6, 0.6, 0.6}
  base : StainedSoot { Position: {0, 0.05, 0}; Cylinder: {radius: 0.07, length: 0.05, segments: 12} }
  dome { Position: {0, 0, 0}; Sphere: {radius: 0.06, segments: 12}; Rgb: {hue.r * 0.3, hue.g * 0.3, hue.b * 0.3}; Emissive: {strength: match on { true: 22; _: 0.2 }, color: hue}; Transition: [Emissive: {duration: 0.1}] }
  glow { Position: {0, -0.1, 0}; PointLight: {intensity: match on { true: 4.5; _: 0 }, range: 6}; Rgb: hue }
}

template FloorSmear {
  prop st: i32 = 0
  const a = st_angle(st)
  const k = match main_on { true: clamp01(hub_eff + 0.25); _: 0 }

  Position: {sin(a) * 1.48, 0.012, 0 - cos(a) * 1.48}
  Rotation: {-1.5707963, 0 - a, 0}
  SpatialIgnore
  smear { Position: {0, 0, 0}; Rect: {1.5, 1.5}; Image: {texture: tex_halo}; Rgb: {255 * 0.2 * k, 110 * 0.2 * k, 20 * 0.2 * k}; BlendMode: Additive; Transition: [Rgb: {duration: 1}]; NoShadow }
  bar { Position: {0, 0.55, 0.001}; Rect: {1.04, 0.5}; Image: {texture: tex_flare}; Rgb: {255 * 0.5 * k, 140 * 0.5 * k, 40 * 0.5 * k}; BlendMode: Additive; Transition: [Rgb: {duration: 1}]; NoShadow }
}

template FeedPlate {
  prop tex: entity = 0
  prop which: i32 = 0
  prop a: i32 = 0
  prop x: f32 = 0

  Position: {x, 2.32, -2.62}
  Rotation: {0.08, 0 - x * 0.3, 0}
  Scale: {0.001, 0.001, 0.001}

  hanger_a : StainedSoot { Position: {-340, 390, -10}; Box: {24, 340, 24}; TextureTransform: {scale_x: 0.1, scale_y: 0.4} }
  hanger_b : StainedSoot { Position: {340, 390, -10}; Box: {24, 340, 24}; TextureTransform: {scale_x: 0.1, scale_y: 0.4} }
  plate_ : BlackGlass { ChamferBlock: {w: 900, h: 500, c1: 60, c2: 10, c3: 60, c4: 10, depth: 6, z: -8} }
  ChamferRing neon_(w: 900, h: 500, c1: 60, c2: 10, c3: 60, c4: 10, t: 4, hue: NEON, glow: match main_on { true: 5; _: 0.05 }, z: -3)
  if main_on {
    picture { Position: {0, 0, 0}; Rect: {830, 450}; Image: {texture: tex}; Rgb: {236, 228, 216}; SpatialIgnore }
    Ink name(text: feed_name(which), size: 21, font: font_head, hue: LUMEN, x: -380, y: 200, z: 12, glow: 2.4)
    Ink live(text: match pulse { true: "LIVE"; _: "" }, size: 18, font: font_data, hue: ALERT, x: 340, y: 202, z: 12)
    Tap prev(legend: "<", w: 62, h: 34, size: 20, op: OP_FEED_PREV, a: a, x: -360, y: -200)
    Tap next(legend: ">", w: 62, h: 34, size: 20, op: OP_FEED_NEXT, a: a, x: -288, y: -200)
  }
}

template OpsPlate {
  prop x: f32 = 0

  Position: {x, 2.32, -2.62}
  Rotation: {0.08, 0 - x * 0.3, 0}
  Scale: {0.001, 0.001, 0.001}
  SpatialIgnore

  hanger_a : StainedSoot { Position: {-340, 390, -10}; Box: {24, 340, 24}; TextureTransform: {scale_x: 0.1, scale_y: 0.4} }
  hanger_b : StainedSoot { Position: {340, 390, -10}; Box: {24, 340, 24}; TextureTransform: {scale_x: 0.1, scale_y: 0.4} }
  plate_ : BlackGlass { ChamferBlock: {w: 900, h: 500, c1: 10, c2: 60, c3: 10, c4: 60, depth: 6, z: -8} }
  ChamferRing neon_(w: 900, h: 500, c1: 10, c2: 60, c3: 10, c4: 60, t: 4, hue: NEON, glow: match main_on { true: 5; _: 0.05 }, z: -3)
  if main_on {
    Ink t_(text: "OPS BOARD", size: 26, font: font_head, hue: LUMEN, x: -410, y: 206, z: 4, glow: 2.6)
    Ink ms(text: milestone_name(milestone), size: 20, font: font_head, hue: GOLD, x: 410, y: 206, z: 4, align: Right, width: 400, glow: 2.2)
    Hair r_(x1: -420, y1: 184, x2: 420, y2: 184, w: 2, hue: NEON, z: 4, glow: 2.6)
    Ink g_(text: milestone_goal(milestone), size: 17, hue: LUMEN, x: -410, y: 156, z: 4, width: 820)
    Ink l0(text: log0, size: 20, font: font_data, hue: LUMEN, x: -410, y: 112, z: 4)
    Ink l1(text: log1, size: 18, hue: LUM_DIM, x: -410, y: 84, z: 4)
    Ink l2(text: log2, size: 18, hue: LUM_DIM, x: -410, y: 58, z: 4)
    Ink l3(text: log3, size: 18, hue: LUM_FAINT, x: -410, y: 32, z: 4)
    Ink l4(text: log4, size: 18, hue: LUM_FAINT, x: -410, y: 6, z: 4)
    Hair r_b(x1: -420, y1: -16, x2: 420, y2: -16, w: 1.2, hue: LUM_FAINT, z: 4)
    for g in 0..GOODS {
      Ink "n_{g}"(text: good_code(g), size: 17, font: font_data, hue: LUM_DIM, x: -410 + g * 168, y: -40, z: 4)
      Ink "v_{g}"(text: "{stock[g]:.0} T", size: 26, font: font_head, hue: LUMEN, x: -410 + g * 168, y: -70, z: 4, glow: 2)
      Meter "m_{g}"(x: -350 + g * 168, y: -98, w: 136, h: 8, value: stock[g] / max(cap[g], 1), ticks: 1, z: 4, hue: NEON)
    }
    Hair r_c(x1: -420, y1: -122, x2: 420, y2: -122, w: 1.2, hue: LUM_FAINT, z: 4)
    for d in 0..DECKS {
      Ink "d_{d}"(text: deck_name(d), size: 15, hue: LUM_DIM, x: -410 + d * 212, y: -146, z: 4)
      Meter "c_{d}"(x: -320 + d * 212, y: -172, w: 180, h: 10, value: crime[d] / 100, ticks: 5, z: 4, hue: match crime[d] > 45 { true: ALERT; _: MINT })
    }
    Ink f_(text: "BERTHS {visitors}/{berth_count}   ROUTES {route_slots}   RAIDS {raids}   RIGS {rig_count}   TRIPS {trips}", size: 17, font: font_data, hue: LUM_DIM, x: -410, y: -212, z: 4)
  }
}

template StatusSign {
  const hot = alarm > 0.05 || incidents_active > 0
  Position: {0, 2.94, -3.34}
  Rotation: {0.14, 0, 0}
  Scale: {0.001, 0.001, 0.001}
  SpatialIgnore

  case_ : StainedSoot { Position: {0, 0, -14}; RoundedBox: {760, 136, 26, 16, segments: 2}; TextureTransform: {scale_x: 0.5, scale_y: 0.2} }
  face { Position: {0, 0, 0}; Rect: {716, 100}; Rgb: {50, 12, 8}; Border: {radius: 12, width: 6, color: {255, 214, 180, 255}}; Emissive: {strength: match main_on { true: match hot && pulse { true: 3.4; _: 0.9 }; _: 0 }, color: {255, 50, 30}} }
  words { Position: {0, 0, 2}; Text: {value: match !main_on { true: "NO POWER"; _: match hot { true: "ALERT"; _: "NOT ALERT" } }, size: 66, font: font_head, align: Center}; Rgb: {255, 244, 226}; Emissive: {strength: match main_on { true: 3; _: 0.06 }, color: {255, 236, 214}} }
  shine { Position: {0, -60, 90}; PointLight: {intensity: 0.05 * bool_f(main_on), range: 1.6}; Rgb: {255, 80, 50} }
}

template HeaderShards {
  Position: {0, 2.5, -3.0}
  SpatialIgnore
  Scale: {0.001, 0.001, 0.001}
  Rotation: {0.12, 0, 0}
  if main_on {
    left_ {
      Position: {-1740, -200, 500}
      Rotation: {0, 0.3, 0}
      ChamferRing ring(w: 520, h: 180, c1: 34, c2: 0, c3: 34, c4: 0, t: 3.4, hue: NEON, glow: 4.5)
      ChamferFill wash(w: 516, h: 176, c1: 34, c2: 0, c3: 34, c4: 0, hue: NEON, glow: 0.05)
      Ink cash(text: "{creds:.0} CR", size: 52, font: font_head, hue: match creds < 0 { true: ALERT; _: GOLD }, x: 0, y: 26, align: Center, glow: 2.6)
      Ink rate(text: "{shown_rate:+.0} CR/MIN  /  {milestone_name(milestone)}", size: 20, hue: LUM_DIM, x: 0, y: -42, align: Center)
    }
    right_ {
      Position: {1740, -200, 500}
      Rotation: {0, -0.3, 0}
      ChamferRing ring(w: 520, h: 180, c1: 0, c2: 34, c3: 0, c4: 34, t: 3.4, hue: NEON, glow: 4.5)
      ChamferFill wash(w: 516, h: 176, c1: 0, c2: 34, c3: 0, c4: 34, hue: NEON, glow: 0.05)
      Ink pw(text: "{supply_total:.0} / {demand_total:.0} MW", size: 36, font: font_head, hue: match hub_eff < 0.99 { true: ALERT; _: MINT }, x: 0, y: 34, align: Center, glow: 2.4)
      Ink cr(text: "CRIME {crime_avg:.0}  /  {pop:.0} SOULS  /  {visitors} DOCKED", size: 20, hue: match crime_avg > 45 { true: ALERT; _: LUM_DIM }, x: 0, y: -28, align: Center)
      Ink ms(text: log0, size: 15, hue: LUM_DIM, x: 0, y: -60, align: Center)
    }
  } else {
    hint {
      Position: {1740, -200, 500}
      Rotation: {0, -0.3, 0}
      ChamferRing ring(w: 520, h: 140, c1: 0, c2: 30, c3: 0, c4: 30, t: 3.4, hue: NEON, glow: match slow { true: 7; _: 2 })
      Ink a(text: "MAIN BUS OPEN", size: 34, font: font_head, hue: LUMEN, x: 0, y: 22, align: Center, glow: 2.6)
      Ink b(text: "LOOK RIGHT. POWER CONSOLE.", size: 19, hue: WARM, x: 0, y: -26, align: Center)
    }
  }
}

control_room {
  SpatialIgnore

  floor_ : WetFloor { Position: {0, -0.1, 0}; Box: {7.4, 0.2, 7.4}; TextureTransform: {scale_x: 2, scale_y: 2} }
  ceiling : StainedSoot { Position: {0, CEIL + 0.04, 0}; Box: {7.4, 0.08, 7.4}; TextureTransform: {scale_x: 3, scale_y: 3} }
  ceil_pits { Position: {0, CEIL - 0.004, 0}; Rotation: {PI / 2, 0, 0}; Quad: {7.2, 7.2}; Rgb: {30, 28, 24}; PbrMaterial: {metallic: 0.6, roughness: 0.5}; PbrTextures: {emissive: tex_floor_glow}; Emissive: {strength: match main_on { true: 1.2; _: 0.1 }, color: {255, 200, 120}}; TextureTransform: {scale_x: 2.5, scale_y: 2.5, offset_x: 0.3, offset_y: 0.7}; Transition: [Emissive: {duration: 1.4}]; NoShadow }

  for i in 0..ROOM_SIDES {
    WallFacet "wall_{i}"(i: i)
  }

  for i in 0..5 {
    "beam_x_{i}" : StainedDark { Position: {0, CEIL - 0.16, -2.6 + i * 1.3}; Box: {7, 0.26, 0.2}; TextureTransform: {scale_x: 3, scale_y: 0.1, offset_y: i * 0.2} }
  }
  for i in 0..3 {
    "beam_z_{i}" : StainedSoot { Position: {-2 + i * 2, CEIL - 0.1, 0}; Box: {0.2, 0.16, 7}; TextureTransform: {scale_x: 0.1, scale_y: 3} }
  }
  for i in 0..4 {
    "panel_{i}" : Trim { Position: {match i % 2 { 0: -1; _: 1 }, CEIL - 0.02, -1.95 + floor(i / 2) * 2.6}; Box: {1.2, 0.03, 0.8}; TextureTransform: {scale_x: 0.5, scale_y: 0.4, offset_x: i * 0.4} }
  }

  duct_a : Stained { Position: {-1.4, CEIL - 0.34, 0}; Rotation: {PI / 2, 0, 0}; Cylinder: {radius: 0.16, length: 7, segments: 16, smooth: true}; Rgb: {92, 86, 72}; TextureTransform: {scale_x: 1, scale_y: 4} }
  duct_b : Stained { Position: {1.5, CEIL - 0.3, 0}; Rotation: {PI / 2, 0, 0}; Cylinder: {radius: 0.12, length: 7, segments: 16, smooth: true}; Rgb: {120, 96, 56}; TextureTransform: {scale_x: 1, scale_y: 4} }
  for k in 0..6 {
    "duct_ring_a_{k}" : StainedSoot { Position: {-1.4, CEIL - 0.34, -3 + k * 1.2}; Rotation: {PI / 2, 0, 0}; Cylinder: {radius: 0.178, length: 0.05, segments: 16, smooth: true} }
    "duct_ring_b_{k}" : StainedSoot { Position: {1.5, CEIL - 0.3, -2.6 + k * 1.2}; Rotation: {PI / 2, 0, 0}; Cylinder: {radius: 0.136, length: 0.05, segments: 16, smooth: true} }
  }
  for i in 0..5 {
    Rod3 "pipe_{i}"(a: {-3.3, CEIL - 0.42 - (i % 2) * 0.05, 1.3 + i * 0.13}, b: {3.3, CEIL - 0.42 - (i % 2) * 0.05, 1.3 + i * 0.13}, r: 0.03 + (i % 2) * 0.014, tone: match i % 3 { 0: {120, 90, 56}; 1: {80, 80, 76}; _: {170, 90, 30} })
  }
  Cable3 c_a(a: {-1.2, CEIL - 0.1, -2.4}, b: {-3.1, 2.5, -1.2}, sag: 0.34, thick: 0.03)
  Cable3 c_b(a: {1.4, CEIL - 0.1, -2.2}, b: {3.1, 2.4, -1.1}, sag: 0.38, thick: 0.03, tone: {60, 30, 24})
  Cable3 c_d(a: {3.1, 1.9, 1.0}, b: {2.6, 0.1, 1.8}, sag: 0.1, thick: 0.05, tone: {120, 100, 76}, metal: 1, rough: 0.4)
  Cable3 c_e(a: {-3.1, 2.2, 1.0}, b: {-2.5, 0.1, 2.0}, sag: 0.12, thick: 0.04, tone: {60, 44, 30})

  for s in 0..7 {
    DeskBase "desk_{s}"(st: s)
    FloorSmear "smear_{s}"(st: s)
  }

  CeilLamp lamp_a(x: 0, z: -1.2, level: 6)
  CeilLamp lamp_b(x: -1.8, z: -0.2, level: 5, yaw: 0.6)
  CeilLamp lamp_c(x: 1.8, z: -0.2, level: 5, yaw: -0.6)
  CeilLamp lamp_d(x: -1.3, z: 1.5, level: 4)
  CeilLamp lamp_e(x: 1.3, z: 1.5, level: 4)

  StripLight strip_a(a: -1.14, y: 1.92, h: 1)
  StripLight strip_b(a: 1.14, y: 1.92, h: 1)
  StripLight strip_c(a: -2.92, y: 1.8, h: 1.2)
  StripLight strip_d(a: 2.92, y: 1.8, h: 1.2)

  LedStack stack_a(a: -1.34, seed: 1)
  LedStack stack_b(a: -1.74, seed: 3)
  LedStack stack_c(a: 1.74, seed: 7)
  SchematicPane sch_a(a: 1.34, y: 1.86, seed: 0)
  SchematicPane sch_b(a: -2.14, y: 1.86, seed: 1)
  SchematicPane sch_c(a: 2.14, y: 1.86, seed: 2)

  Hatch hatch_a(a: 2.6, tag: "A-SEAL")
  Hatch hatch_b(a: -2.6, tag: "B-SEAL")

  Beacon alarm_a(x: -2.3, z: -2.5, on: alarm > 0.08 && pulse)
  Beacon alarm_b(x: 2.3, z: -2.5, on: alarm > 0.08 && !pulse)
  Beacon gold_a(x: 0, z: -3.1, on: flash_gold > 0.05 && pulse, hue: {255, 200, 90})

  emergency { Position: {0, 2.4, -1.5}; PointLight: {intensity: match main_on { true: 0; _: 1.1 }, range: 6}; Rgb: {255, 96, 40} }

  StatusSign sign()
  HeaderShards header()

  dust {
    Position: {0, 1.5, -0.6}
    ParticleEmitter: {max: 900, rate: 110, shape: EmitterBox, extents: {3, 1.4, 2.4}, direction: {0, 0, 0}, speed: {0, 0}, lifetime: {5, 10}, size: {0.0016, 0.004}, color: {255, 226, 180}, opacity: {0.2, 0.7}, seed: 77}
    ParticleForces: {gravity: {0, 0, 0}, turbulence: 0.03, drag: 0.6}
    ParticleAppearance: {shape: ParticleCircle, blend: ParticleAdditive, lit: 1}
    ParticleCurves: {opacity: {0, 1, 1, 0}}
  }

  haze {
    Position: {0, 1.62, -0.2}
    FogVolume: {extent: {3.4, 1.62, 3.4}, density: 0.0045, color: {226, 196, 160}, absorption: 0.1, asymmetry: 0.45, edge_fade: 0.3, sun_inscatter: 0.3, ambient_inscatter: 0.1, light_inscatter: 0.35, steps: 12, noise_strength: 0.2, noise_scale: 1.6, wind: {0.05, 0.02, 0.03}}
  }

  room_probe {
    Position: {0, 1.3, 0}
    ReflectionProbe: {extent: {3.6, 1.8, 3.6}, blend: 0.3, priority: 1, projection: {3.6, 1.8, 3.6}, offset: {0, 0, 0}}
  }
}

room_ui {
  FeedPlate feed_plate_a(tex: tex_feed_a, which: feed_a, a: 0, x: -0.76)
  OpsPlate ops_plate(x: 0.76)
}

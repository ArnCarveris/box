using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.text
using box.layout
using box.spatial
using box.picking
using box.transition

template DeckRow {
  prop d: i32 = 0
  prop y: f32 = 0
  const c = crime[d]

  Ink name(text: deck_name(d), size: 13, font: font_data, hue: LUMEN, x: -100, y: y + 14)
  Meter m(x: -8, y: y - 6, w: 184, h: 10, value: c / 100, hue: match c > 60 { true: ALERT; _: match c > 30 { true: WARM; _: MINT } })
  Ink guard_t(text: "{deck_guards[d]}", size: 18, font: font_head, hue: LUMEN, x: 138, y: y + 2, align: Center)
  Pick sub_(x: 110, y: y + 2, w: 24, h: 26, op: OP_GUARD_SUB, a: d, tone: WARM)
  Ink sub_t(text: "-", size: 16, hue: WARM, x: 110, y: y + 2, align: Center, z: 12)
  Pick add_(x: 166, y: y + 2, w: 24, h: 26, op: OP_GUARD_ADD, a: d, tone: MINT)
  Ink add_t(text: "+", size: 16, hue: MINT, x: 166, y: y + 2, align: Center, z: 12)
}

template IncidentRow {
  prop i: i32 = 0
  prop y: f32 = 0
  const on = incidents[i].active
  const chosen = sel_incident == i && on

  if on {
    Pick hit(x: -130, y: y, w: 494, h: 22, op: OP_SELECT_INCIDENT, a: i, selected: chosen, tone: ALERT)
    Ink a(text: incident_name(incidents[i].kind), size: 13, font: font_data, hue: ALERT, x: -370, y: y, glow: 2)
    Ink b(text: deck_name(incidents[i].deck), size: 12, hue: LUMEN, x: -190, y: y)
    Ink c(text: match incidents[i].helped { true: "TEAM ON SITE"; _: match deck_guards[incidents[i].deck] > 0 { true: "GUARDS ENGAGED"; _: "NO COVER" } }, size: 11, hue: match deck_guards[incidents[i].deck] > 0 || incidents[i].helped { true: MINT; _: WARM }, x: -66, y: y)
    Meter m(x: 66, y: y, w: 90, h: 6, value: 1 - incidents[i].t / 60, hue: ALERT, ticks: 1)
  } else {
    Hair h_(x1: -370, y1: y, x2: 110, y2: y, w: 0.6, hue: LUM_WIRE)
  }
}

Console console_security(st: ST_SECURITY) {
  GlassLayer ui() {
    if station == ST_SECURITY {
      plate_feed {
        Position: {-130, 38, 0}
        Rect: {500, 300}
        Image: {texture: tex_cctv}
        Rgb: {226, 234, 240}
        SpatialIgnore
      }
    } else {
      Ink standby(text: "CCTV STANDBY", size: 22, font: font_head, hue: LUM_FAINT, x: -130, y: 38, align: Center)
    }
    Outline frame(x: -130, y: 38, w: 504, h: 304, hue: LUM_DIM, z: 2)
    Corners crop(x: -130, y: 38, w: 470, h: 270, hue: LUMEN, z: 18, len: 22)
    Ink cam_t(text: "CAM {cam + 1} / {cam_name(cam)}", size: 15, font: font_data, hue: LUMEN, x: -366, y: 172, z: 22)
    Ink cam_r(text: match pulse { true: "LIVE"; _: "" }, size: 14, font: font_data, hue: ALERT, x: 96, y: 172, z: 22)
    Ink crime_a(text: "CRIME INDEX", size: 13, hue: LUM_DIM, x: 134, y: 190, font: font_data)
    decks {
      Position: {258, 0, 6}
      for d in 0..DECKS {
        DeckRow "deck_{d}"(d: d, y: 152 - d * 62)
      }
    }
    Ink g_a(text: "GUARDS {guards}", size: 16, font: font_head, hue: LUMEN, x: 134, y: -112, glow: 2)
    Ink g_b(text: "OFF SHIFT {guards_free()}  BUNKS {guard_cap()}", size: 11, hue: LUM_DIM, x: 134, y: -132)
    Ink g_c(text: "WON {incidents_won}  LOST {incidents_lost}", size: 11, hue: LUM_DIM, x: 134, y: -148)
    Hair r_a(x1: -384, y1: -128, x2: 120, y2: -128, hue: LUM_FAINT)
    Ink i_t(text: "INCIDENT LOG", size: 12, hue: LUM_DIM, x: -384, y: -142, font: font_data)
    log_ {
      Position: {0, 0, 4}
      for i in 0..INCIDENTS {
        IncidentRow "inc_{i}"(i: i, y: -160 - i * 20)
      }
    }
    if lockdown {
      Plate lock_bar(x: 258, y: -200, w: 240, h: 60, hue: {ALERT.r * 0.3, ALERT.g * 0.2, ALERT.b * 0.2}, z: 2)
      Ink lock_t(text: match pulse { true: "LOCKDOWN"; _: "" }, size: 26, font: font_head, hue: ALERT, x: 258, y: -200, align: Center, z: 6, glow: 3)
    }
  }

  HwLayer hardware() {
    Stencil c1(text: "CAMERA BANK", size: 12, y: 250)
    Tap prev(legend: "<", w: 74, h: 36, size: 20, op: OP_CAM_PREV, x: -96, y: 218)
    Readout cam_d(value: cam + 1, label: "", x: 0, y: 214, size: 28)
    Tap next(legend: ">", w: 74, h: 36, size: 20, op: OP_CAM_NEXT, x: 96, y: 218)
    Hair r_a(x1: -135, y1: 184, x2: 135, y2: 184, hue: LUM_FAINT)
    ArcGauge gauge(label: "CRIME INDEX", value: crime_avg / 100, r: 62, x: 0, y: 106, red_from: 0.45)
    Tap disp(legend: "DISPATCH", sub: "150 CR", lit: sel_incident >= 0 && pulse, w: 276, h: 52, size: 20, op: OP_DISPATCH, y: -6, hue: K_RED, c: 12)
    Tap hire(legend: "HIRE", sub: "400 CR", hue: K_GREEN, w: 134, h: 42, size: 14, op: OP_GUARD_HIRE, x: -68, y: -64)
    Tap fire_(legend: "RELEASE", hue: WARM, w: 134, h: 42, size: 13, op: OP_GUARD_FIRE, x: 68, y: -64)
    Latch lock_sw(on: lockdown, label: "LOCKDOWN", op: OP_LOCKDOWN, w: 134, h: 74, x: -68, y: -136)
    Led alarm_led(lit: alarm > 0.08 && pulse, hue: K_RED, r: 7, power: 14) { Position: {68, -118, 6} }
    Tap ack(legend: "ACK ALARM", hue: WARM, w: 134, h: 30, size: 11, op: OP_ACK, x: 68, y: -156)
    Readout won_r(value: incidents_won, label: "CONTAINED", x: -68, y: -212, size: 22)
    Readout lost_r(value: incidents_lost, label: "RAN WILD", x: 68, y: -212, size: 22, hue: ALERT)
  }
}

using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.light
using box.spatial
using box.particle
using box.transition

template Burner {
  prop r: f32 = 1
  prop power: f32 = 1
  prop hue: Rgb = {150, 200, 255}

  cone : Soot { Position: {0, 0, 0}; Rotation: {PI / 2, 0, 0}; Frustum: {radius_bottom: r, radius_top: r * 0.6, length: r * 1.4, segments: 12} }
  plasma { Position: {0, 0, r * 0.7}; Circle: {r * 0.92}; Rgb: {hue.r, hue.g, hue.b}; Emissive: {strength: 6 * power, color: hue}; BlendMode: Additive; NoShadow; SpatialIgnore }
  Glow flare(r: r * 5, hue: hue, power: 0.5 * power, at: {0, 0, r * 0.8})
}

template HullSkiff {
  prop tone: Rgb = {150, 120, 80}

  core { Position: {0, 0, 0}; Rotation: {PI / 2, 0, 0}; Capsule: {radius: 2, length: 8, segments: 12, smooth: true}; Rgb: tone; PbrMaterial: {metallic: 1, roughness: 1}; PbrTextures: {albedo: tex_plate, orm: tex_plate_orm, normal: tex_plate_normal}; TextureTransform: {scale_x: 1, scale_y: 1} }
  cockpit { Position: {0, 1.1, -5}; Sphere: {radius: 1.2, segments: 12, smooth: true}; Scale: {1, 0.6, 1.5}; Rgb: {10, 18, 26}; PbrMaterial: {metallic: 0.9, roughness: 0.08}; Emissive: {strength: 1, color: {120, 200, 255}} }
  wing_a : HullDark { Position: {4.6, -0.2, 1.4}; Rotation: {0, 0, -0.2}; Box: {6.6, 0.4, 3.6} }
  wing_b : HullDark { Position: {-4.6, -0.2, 1.4}; Rotation: {0, 0, 0.2}; Box: {6.6, 0.4, 3.6} }
  Burner e_a(r: 0.9) { Position: {1.1, 0, 6.6} }
  Burner e_b(r: 0.9) { Position: {-1.1, 0, 6.6} }
  Strobe nav_a(big: 0.9, hue: NAV_RED, phase: true) { Position: {-7.8, -1, 1.4} }
  Strobe nav_b(big: 0.9, hue: NAV_GREEN, phase: false) { Position: {7.8, -1, 1.4} }
}

template HullHauler {
  prop tone: Rgb = {120, 110, 90}

  spine : HullDark { Position: {0, 0, 0}; Box: {1.6, 1.6, 34}; TextureTransform: {scale_x: 0.2, scale_y: 2} }
  bridge { Position: {0, 2.4, -15}; RoundedBox: {6.4, 3.8, 5.6, 0.7, segments: 2}; Rgb: tone; PbrMaterial: {metallic: 1, roughness: 1}; PbrTextures: {albedo: tex_plate, orm: tex_plate_orm, normal: tex_plate_normal}; TextureTransform: {scale_x: 0.5, scale_y: 0.4} }
  glass { Position: {0, 3, -17.84}; Box: {4.8, 0.9, 0.1}; Rgb: {10, 16, 22}; Emissive: {strength: 2.4, color: {255, 200, 130}} }
  for i in 0..4 {
    for k in 0..2 {
      Container "c_{i}_{k}"(x: 0, y: k * 2.9 - 1.5, z: i * 6.4 - 10, tone: i * 3 + k + floor(tone.r))
    }
  }
  Burner e_a(r: 1.6) { Position: {1.8, 0, 17.4} }
  Burner e_b(r: 1.6) { Position: {-1.8, 0, 17.4} }
  Strobe nav_a(big: 1.3, hue: NAV_RED, phase: true) { Position: {-3.4, 4.4, -15} }
  Strobe nav_b(big: 1.3, hue: NAV_GREEN, phase: false) { Position: {3.4, 4.4, -15} }
}

template HullTanker {
  prop tone: Rgb = {176, 170, 150}

  spine : Iron { Position: {0, 0, 0}; Box: {1, 1, 34} }
  for i in 0..3 {
    "tank_{i}" { Position: {0, 0, i * 9.6 - 8}; Sphere: {radius: 4.4, segments: 24, smooth: true}; Rgb: tone; PbrMaterial: {metallic: 0.8, roughness: 0.46}; PbrTextures: {orm: tex_iron_orm, normal: tex_iron_normal}; ClearCoat: {strength: 0.4, roughness: 0.3} }
  }
  nose { Position: {0, 0, -16}; RoundedBox: {4.4, 3.6, 5, 0.8, segments: 2}; Rgb: {90, 84, 76}; PbrMaterial: {metallic: 1, roughness: 1}; PbrTextures: {albedo: tex_plate, orm: tex_plate_orm, normal: tex_plate_normal}; TextureTransform: {scale_x: 0.5, scale_y: 0.4} }
  Burner e_a(r: 1.8) { Position: {0, 0, 17.4} }
  Strobe nav_a(big: 1.3, hue: NAV_RED, phase: true) { Position: {-4.6, 0, -8} }
  Strobe nav_b(big: 1.3, hue: NAV_GREEN, phase: false) { Position: {4.6, 0, -8} }
}

template HullCutter {
  prop tone: Rgb = {60, 66, 80}

  blade { Position: {0, 0, 0}; BeveledPrism: {footprint: [{-5, 13}, {0, -15}, {5, 13}], depth: 2.6, inset: 1.2, bevel: 0.3}; Rgb: tone; PbrMaterial: {metallic: 1, roughness: 1}; PbrTextures: {albedo: tex_plate, orm: tex_plate_orm, normal: tex_plate_normal}; TextureTransform: {scale_x: 0.5, scale_y: 0.8} }
  fin : HullDark { Position: {0, 2.8, 9}; Box: {0.4, 4, 6} }
  strip { Position: {0, 1.42, 0}; Box: {0.6, 0.06, 16}; Rgb: {10, 20, 30}; Emissive: {strength: 7, color: {110, 180, 255}}; NoShadow }
  Burner e_a(r: 1.2, hue: {120, 170, 255}) { Position: {2, 0, 13.6} }
  Burner e_b(r: 1.2, hue: {120, 170, 255}) { Position: {-2, 0, 13.6} }
  Strobe nav_a(big: 1.4, hue: {80, 150, 255}, phase: true) { Position: {-5.4, 0, 10} }
  Strobe nav_b(big: 1.4, hue: NAV_RED, phase: false) { Position: {5.4, 0, 10} }
}

fn hold_x(i: i32) -> f32 {
  (i % 5 - 2) * 92 + rnd(i * 3.3) * 24
}

fn hold_y(i: i32) -> f32 {
  34 + (i % 3) * 22
}

fn hold_z(i: i32) -> f32 {
  0 - 390 - (i % 4) * 46
}

fn jump_x(i: i32) -> f32 {
  (rnd(i * 5.7 + 2) - 0.5) * 2600
}

fn jump_y(i: i32) -> f32 {
  180 + rnd(i * 7.1) * 420
}

fn jump_z(i: i32) -> f32 {
  0 - 2200 - rnd(i * 9.3) * 800
}

template VisitorCraft {
  prop i: i32 = 0
  const st = ships[i].state
  const b = ships[i].berth
  const k = ships[i].kind
  const fx = match st { 1: jump_x(i); 2: hold_x(i); 3: berth_x(b); 4: berth_x(b); _: jump_x(i + 3) }
  const fy = match st { 1: jump_y(i); 2: hold_y(i); 3: berth_y(b) + 9; 4: berth_y(b) + 9; _: jump_y(i + 3) }
  const fz = match st { 1: jump_z(i); 2: hold_z(i); 3: berth_z(b); 4: berth_z(b); _: jump_z(i + 3) }
  const lookz = match st { 2: 0 - 90; 3: 0 - 6000; 4: 0 - 6000; _: fz }
  const secs = match st { 1: 0; 2: 13; 3: 18; 4: 5; _: 16 }
  const wiggle = sin(i * 3.1) * 0.3

  Position: {fx, fy, fz}
  Rotation: {0, match st { 2: 3.14 + wiggle; 3: wiggle * 0.3; 4: 0; _: wiggle }, 0}
  Transition: [
    Position: {duration: secs, timing_function: EaseInOut},
    Rotation: {duration: 6, timing_function: EaseInOut}
  ]

  if k == 0 {
    HullSkiff hull(tone: match ships[i].faction { 0: {196, 188, 168}; 1: {176, 132, 56}; 2: {66, 40, 40}; _: {64, 104, 106} })
  } else if k == 1 {
    HullHauler hull(tone: match ships[i].faction { 0: {196, 188, 168}; 1: {176, 132, 56}; 2: {90, 56, 40}; _: {64, 104, 106} })
  } else if k == 2 {
    HullTanker hull()
  } else {
    HullCutter hull()
  }
}

template Freighter {
  prop i: i32 = 0
  const on = routes[i].active
  const home = routes[i].phase == RT_LOADING
  const hx = (i - 2.5) * 34
  const hy = -36 - (i % 2) * 8
  const hz = 0 - 96 - (i % 3) * 56

  if on {
    craft {
      Position: {match home { true: hx; _: hx * 12 }, match home { true: hy; _: 260 + i * 40 }, match home { true: hz; _: -2600 }}
      Rotation: {match home { true: 0; _: -0.1 }, match home { true: 3.14 * (i % 2); _: 0 }, 0}
      Scale: {match home { true: 1.6; _: 0.2 }, match home { true: 1.6; _: 0.2 }, match home { true: 1.6; _: 6 }}
      Transition: [
        Position: {duration: 12, timing_function: EaseIn},
        Rotation: {duration: 4, timing_function: EaseInOut},
        Scale: {duration: 0.5, delay: match home { true: 0; _: 11.5 }}
      ]
      HullHauler hull(tone: match i % 3 { 0: {196, 188, 168}; 1: {176, 132, 56}; _: {134, 70, 44} })
    }
  }
}

template MiningRig {
  prop r: i32 = 0
  const site = rig_site[r]
  const active = site >= 0 && rig_yield[r] > 0.001
  const owned = rig_count > r
  const sx = match site >= 0 { true: claim_x(site); _: 40 + r * 22 }
  const sy = match site >= 0 { true: claim_y(site) + claim_r(site) * 0.2; _: -30 }
  const sz = match site >= 0 { true: claim_z(site) + claim_r(site) * 1.14 + r * 3; _: -150 - r * 12 }
  const off = (r - 1.5) * 16

  if owned {
    craft {
      Position: {sx + off, sy, sz}
      Rotation: {match site >= 0 { true: 0.2; _: 0 }, 0, 0}
      Transition: [Position: {duration: 22, timing_function: EaseInOut}, Rotation: {duration: 8}]
      hull : HullMustard { Position: {0, 0, 0}; RoundedBox: {8, 5, 16, 1, segments: 2}; TextureTransform: {scale_x: 1, scale_y: 1} }
      drum : Iron { Position: {0, 0, -9.4}; Rotation: {PI / 2, 0, 0}; Frustum: {radius_bottom: 3.6, radius_top: 1.4, length: 4.4, segments: 14}; TextureTransform: {scale_x: 1, scale_y: 0.3} }
      arm_a : IronDark { Position: {5.8, 0, -2}; Box: {4, 1, 1} }
      arm_b : IronDark { Position: {-5.8, 0, -2}; Box: {4, 1, 1} }
      Burner e_a(r: 1.4, power: match site >= 0 && !active { true: 1; _: 0.2 }) { Position: {0, 0, 9} }
      Strobe nav(big: 2.2, phase: r % 2 == 0, hue: {255, 180, 60}) { Position: {0, 3, 5} }
      if active {
        const len = claim_r(site) * 0.34 + 10
        laser {
          Position: {0, 0, -11.8 - len / 2}
          Rotation: {PI / 2, 0, 0}
          Cylinder: {radius: 0.4 + clamp01(rig_yield[r]) * 0.5, length: len, segments: 8}
          Rgb: {100, 80, 180}
          Emissive: {strength: 26, color: {214, 180, 255}}
          BlendMode: Additive
          NoShadow
        }
        Glow muzzle(r: 9, hue: {190, 150, 255}, power: 0.9, at: {0, 0, -12})
        impact {
          Position: {0, 0, -12 - len}
          ParticleEmitter: {max: 900, rate: 200, shape: EmitterSphere, radius: 1.4, direction: {0, 0, 1}, spread: 70, speed: {5, 34}, lifetime: {0.5, 2.8}, size: {0.3, 1.1}, color: {214, 170, 255}, color_variance: {40, 40, 10}, opacity: {0.6, 1}, seed: 40 + r}
          ParticleForces: {gravity: {0, 0, 0}, drag: 0.3}
          ParticleAppearance: {shape: ParticleCircle, blend: ParticleAdditive, stretch: 0.03}
          ParticleCurves: {size: {1, 1, 0.7, 0.2}, opacity: {1, 1, 0.5, 0}}
          PointLight: {intensity: 1800, range: 110}
          Rgb: {190, 150, 255}
        }
      }
    }
    tug {
      const out = rig_trip[r] % 2 == 1 && site >= 0
      Position: {match out { true: sx + off + 18; _: 26 + r * 12 }, match out { true: sy + 6; _: -26 }, match out { true: sz + 6; _: -70 - r * 8 }}
      Rotation: {0, match out { true: 0; _: 3.14 }, 0}
      Transition: [Position: {duration: 15, timing_function: EaseInOut}, Rotation: {duration: 3}]
      box_ : Iron { Position: {0, 0, 0}; RoundedBox: {3.4, 2.6, 7, 0.5, segments: 2} }
      pod : HullOxide { Position: {0, 2.2, 1}; Box: {3, 2, 5} }
      Burner e_a(r: 0.8) { Position: {0, 0, 4} }
      Strobe nav(big: 1, phase: r % 2 == 1, hue: {255, 180, 60}) { Position: {0, 3.4, 1} }
    }
  }
}

traffic_root {
  SpatialIgnore
  for i in 0..SHIPS {
    if ships[i].state != SH_NONE {
      VisitorCraft "ship_{i}"(i: i)
    }
  }
  for i in 0..ROUTES {
    Freighter "freighter_{i}"(i: i)
  }
  for r in 0..RIGS {
    MiningRig "rig_{r}"(r: r)
  }
}

using flecs.script
using flecs.script.math

proc spawn_visitor() {
  mut slot: i32 = -1
  for i in 0..SHIPS {
    if ships[i].state == SH_NONE && slot < 0 {
      slot = i
    }
  }
  if slot >= 0 {
    rs += 1
    const a = rnd(rs)
    rs += 1
    const b = rnd(rs)
    rs += 1
    const c = rnd(rs)
    rs += 1
    const d = rnd(rs)
    const f: i32 = match a < 0.26 { true: F_COMBINE; _: match a < 0.66 { true: F_UNION; _: match a < 0.86 { true: F_ASH; _: F_WARDEN } } }
    const shady = match f { 2: 0.72; 3: 0.02; 0: 0.08; _: 0.2 }
    const kind: i32 = match f == F_WARDEN { true: 3; _: floor(b * 3) }
    name_serial += 1 + floor(d * 5)
    ships[slot].state = SH_ARRIVE
    ships[slot].name = name_serial
    ships[slot].faction = f
    ships[slot].kind = kind
    ships[slot].cred = match c < shady * 0.5 { true: CRED_FORGED; _: match c < 0.1 + shady * 0.6 { true: CRED_EXPIRED; _: CRED_VALID } }
    ships[slot].contraband = d < shady
    ships[slot].scanned = false
    ships[slot].scan_t = 0
    ships[slot].t = 0
    ships[slot].berth = 0
    ships[slot].stay = 45 + b * 90
    ships[slot].fee = 160 + kind * 180 + b * 260 + bool_f(d < shady) * 320
    ships[slot].good = match floor(c * 5) { 0: G_FOOD; 1: G_PARTS; 2: G_FUEL; 3: G_PARTS; _: G_FOOD }
    ships[slot].tons = match b > 0.45 { true: 8 + c * 24; _: 0 }
    if sel_ship < 0 {
      sel_ship = slot
    }
    log_add("INBOUND: {ship_name(name_serial)} / {faction_code(f)}")
  }
}

proc pick_next_ship() {
  mut found: i32 = -1
  for i in 0..SHIPS {
    if ships[i].state == SH_HOLD && found < 0 {
      found = i
    }
  }
  sel_ship = found
}

proc free_berth(b: i32) {
  berth_of[b] = 0
}

proc traffic_step(dt: f32) {
  if berth_count > 0 && main_on {
    traffic_t -= dt
    if traffic_t <= 0 {
      rs += 1
      traffic_t = max(14, 46 - milestone * 5) + rnd(rs) * 18
      spawn_visitor()
    }
  }
  mut docked: i32 = 0
  for i in 0..SHIPS {
    const st = ships[i].state
    if st != SH_NONE {
      ships[i].t = ships[i].t + dt
      const t = ships[i].t
      if st == SH_ARRIVE && t > 0.6 {
        ships[i].state = SH_HOLD
        ships[i].t = 0
      } else if st == SH_HOLD {
        if ships[i].scan_t > 0 {
          ships[i].scan_t = max(0, ships[i].scan_t - dt)
          if ships[i].scan_t <= 0 {
            ships[i].scanned = true
          }
        }
        if t > 120 {
          standing[ships[i].faction] = clamp01(standing[ships[i].faction] - 0.03)
          log_add("{ship_name(ships[i].name)} GAVE UP WAITING")
          ships[i].state = SH_TURNED
          ships[i].t = 0
          if sel_ship == i {
            pick_next_ship()
          }
        }
      } else if st == SH_APPROACH && t > 19 {
        ships[i].state = SH_DOCKED
        ships[i].t = 0
        docked_total += 1
        earn(ships[i].fee)
        if ships[i].tons > 0 {
          const g = ships[i].good
          const room = max(0, cap[g] - stock[g])
          const q = min(room, ships[i].tons)
          const unit = good_base(g) * 0.7
          const cost = min(q * unit, max(0, creds))
          stock[g] = stock[g] + cost / unit
          creds -= cost
        }
        if ships[i].contraband {
          crime[0] = min(100, crime[0] + 7)
          crime[1] = min(100, crime[1] + 3)
          standing[F_WARDEN] = clamp01(standing[F_WARDEN] - 0.012)
          standing[F_ASH] = clamp01(standing[F_ASH] + 0.012)
        }
      } else if st == SH_DOCKED {
        docked += 1
        if t > ships[i].stay {
          free_berth(ships[i].berth)
          ships[i].state = SH_LEAVE
          ships[i].t = 0
          standing[ships[i].faction] = clamp01(standing[ships[i].faction] + 0.008)
        }
      } else if (st == SH_LEAVE || st == SH_TURNED) && t > 17 {
        ships[i].state = SH_NONE
      }
    }
  }
  if docked != visitors {
    visitors = docked
  }
}

proc grant_ship() {
  const i = sel_ship
  if i >= 0 && ships[i].state == SH_HOLD {
    mut b: i32 = -1
    for s in 0..SLOTS {
      if slot_kind[s] == M_DOCK && slot_build[s] >= 1 && slot_eff[s] > 0.2 {
        for k in 0..2 {
          if berth_of[s * 2 + k] == 0 && b < 0 {
            b = s * 2 + k
          }
        }
      }
    }
    if b < 0 {
      log_add("NO FREE, POWERED BERTH")
    } else {
      berth_of[b] = i + 1
      ships[i].berth = b
      ships[i].state = SH_APPROACH
      ships[i].t = 0
      standing[ships[i].faction] = clamp01(standing[ships[i].faction] + 0.012)
      if ships[i].cred == CRED_FORGED {
        crime[0] = min(100, crime[0] + 10)
        standing[F_WARDEN] = clamp01(standing[F_WARDEN] - 0.02)
      }
      if ships[i].faction == embargo {
        standing[F_WARDEN] = clamp01(standing[F_WARDEN] - 0.02)
        standing[F_COMBINE] = clamp01(standing[F_COMBINE] - 0.01)
      }
      log_add("{ship_name(ships[i].name)} CLEARED FOR BERTH {b + 1}")
      pick_next_ship()
    }
  }
}

proc deny_ship() {
  const i = sel_ship
  if i >= 0 && ships[i].state == SH_HOLD {
    const dirty = ships[i].cred != CRED_VALID || ships[i].contraband
    if dirty {
      standing[F_WARDEN] = clamp01(standing[F_WARDEN] + 0.02)
      denied_ok += 1
      standing[ships[i].faction] = clamp01(standing[ships[i].faction] - 0.012)
    } else {
      standing[ships[i].faction] = clamp01(standing[ships[i].faction] - 0.04)
    }
    log_add("{ship_name(ships[i].name)} DENIED")
    ships[i].state = SH_TURNED
    ships[i].t = 0
    pick_next_ship()
  }
}

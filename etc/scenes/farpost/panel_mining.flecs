using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.text
using box.layout
using box.spatial
using box.picking
using box.transition

fn plot_x(c: i32) -> f32 {
  claim_x(c) * 0.3 - 200 + 80
}

fn plot_y(c: i32) -> f32 {
  (claim_z(c) + 620) * -0.24 - 110
}

fn rig_price_text(r: i32) -> string {
  match r < RIGS { true: "{rig_cost(r):.0} CR"; _: "FLEET FULL" }
}

fn survey_text(t: f32) -> string {
  match t > 0 { true: "{t:.0} S"; _: "600 CR" }
}

template ClaimBlip {
  prop c: i32 = 0
  const known = claim_known[c]
  const worked = claim_left[c] <= 0
  const chosen = rig_site[sel_rig] == c
  const r = 7 + claim_r(c) * 0.09

  group {
    Position: {plot_x(c), plot_y(c), 8}
    if known {
      body { Position: {0, 0, 0}; Circle: {r}; Rgb: match worked { true: {10, 10, 10}; _: {TY_INK.r * 0.32, TY_INK.g * 0.32, TY_INK.b * 0.32} }; BlendMode: Additive; Border: {width: 1.4, color: match chosen { true: {255, 255, 255, 255}; _: {TY_INK.r, TY_INK.g, TY_INK.b, 255} }}; SpatialIgnore }
      Ink name(text: claim_name(c), size: 12, hue: LUM_DIM, x: 0, y: 0 - r - 12, align: Center, font: font_data)
      Pick hit(w: r * 4, h: r * 4, op: OP_ASSIGN_RIG, a: c, tone: TY_INK, selected: false)
    } else {
      Ink unk(text: "?", size: 18, hue: LUM_FAINT, x: 0, y: 0, align: Center, font: font_data)
    }
  }
}

template RigTether {
  prop r: i32 = 0
  const c = rig_site[r]
  if c >= 0 && rig_count > r {
    Hair tether(x1: -120, y1: 170, x2: plot_x(c), y2: plot_y(c), w: match sel_rig == r { true: 2; _: 1 }, hue: match sel_rig == r { true: GOLD; _: LUM_DIM }, z: 4)
    if rig_yield[r] > 0.01 {
      Plate pulse_dot(x: lerp(-120, plot_x(c), match pulse { true: 0.35; _: 0.7 }), y: lerp(170, plot_y(c), match pulse { true: 0.35; _: 0.7 }), w: 5, h: 5, hue: TY_INK, z: 6, glow: 3)
    }
  }
}

template RigCard {
  prop r: i32 = 0
  prop y: f32 = 0
  const own = rig_count > r
  const c = rig_site[r]
  const worn = rig_wear[r]

  Pick hit(y: y, x: 0, w: 268, h: 88, op: OP_SELECT_RIG, a: r, selected: sel_rig == r && own, usable: own)
  if own {
    Ink title(text: "RIG {r + 1}", size: 16, font: font_head, hue: LUMEN, x: -124, y: y + 26, glow: 2)
    Ink at(text: match c >= 0 { true: claim_name(c); _: "PARKED" }, size: 13, font: font_data, hue: match c >= 0 { true: TY_INK; _: LUM_DIM }, x: -62, y: y + 26)
    Ink k1(text: "YIELD", size: 10, hue: LUM_DIM, x: -124, y: y + 6)
    Ink v1(text: "{rig_yield[r] * 60:.0} T/MIN", size: 13, font: font_data, hue: LUMEN, x: -82, y: y + 6)
    Ink k2(text: "WEAR", size: 10, hue: LUM_DIM, x: -124, y: y - 18)
    Meter m(x: 26, y: y - 18, w: 196, h: 9, value: worn, hue: match worn > 0.75 { true: ALERT; _: match worn > 0.5 { true: WARM; _: MINT } })
    if worn >= 1 {
      Ink dead(text: "SEIZED", size: 12, hue: ALERT, x: 96, y: y + 6)
    }
  } else {
    Ink none(text: match rig_unlocked(r) { true: "RIG {r + 1}: {rig_cost(r):.0} CR"; _: "RIG {r + 1} NOT LICENSED" }, size: 13, hue: LUM_FAINT, x: 0, y: y, align: Center)
  }
}

Console console_mining(st: ST_MINING) {
  GlassLayer ui() {
    Ink t_a(text: "HARROW BELT: TACHYRITE CLAIMS", size: 13, hue: LUM_DIM, x: -384, y: 190, font: font_data)
    plot {
      Position: {-110, 0, 2}
      for i in 0..6 {
        Hair "arc_{i}"(x1: -270, y1: 170 - i * 66, x2: 270, y2: 170 - i * 66, w: 0.6, hue: LUM_WIRE, z: -6)
      }
      for i in 0..7 {
        Hair "col_{i}"(x1: (i - 3) * 90, y1: 180, x2: (i - 3) * 90, y2: -250, w: 0.6, hue: LUM_WIRE, z: -6)
      }
      home { Position: {-120, 170, 4}; Rotation: {0, 0, PI / 4}; Rect: {13, 13}; Rgb: {0, 0, 0}; BlendMode: Additive; Border: {width: 1.6, color: {MINT.r, MINT.g, MINT.b, 255}}; SpatialIgnore }
      Ink home_t(text: "FARPOST-9", size: 11, hue: MINT, x: -94, y: 170, font: font_data)
      for r in 0..RIGS {
        RigTether "teth_{r}"(r: r)
      }
      for c in 0..CLAIMS {
        ClaimBlip "blip_{c}"(c: c)
      }
    }
    Ink help(text: "SELECT A RIG. CLICK A CLAIM TO SEND IT.", size: 11, hue: WARM, x: -384, y: -246)
    Hair div(x1: 172, y1: 200, x2: 172, y2: -258, hue: LUM_WIRE)
    Ink t_r(text: "RIGS", size: 13, hue: LUM_DIM, x: 184, y: 190, font: font_data)
    cards {
      Position: {288, 0, 6}
      for r in 0..RIGS {
        RigCard "card_{r}"(r: r, y: 138 - r * 96)
      }
    }
    Ink t_q(text: "CLAIM {claim_name(rig_site[sel_rig] * bool_f(rig_site[sel_rig] >= 0))}", size: 11, hue: LUM_DIM, x: 184, y: -226)
    Meter q(x: 288, y: -242, w: 200, h: 9, value: match rig_site[sel_rig] >= 0 { true: claim_left[rig_site[sel_rig]] / claim_max(rig_site[sel_rig]); _: 0 }, hue: TY_INK)
  }

  HwLayer hardware() {
    ArcDial drill(label: "DRILL RATE", sig: KN_DRILL, r: 58, lo: "GENTLE", hi: "HOT", x: -56, y: 174)
    ArcGauge output(label: "ORE T/MIN", value: (rig_yield[0] + rig_yield[1] + rig_yield[2] + rig_yield[3]) * 60 / 240, text: "{(rig_yield[0] + rig_yield[1] + rig_yield[2] + rig_yield[3]) * 60:.0}", r: 40, hue: TY_INK, x: 84, y: 186)
    Hair r_a(x1: -135, y1: 86, x2: 135, y2: 86, hue: LUM_FAINT)
    Tap recall(legend: "RECALL RIG", hue: WARM, w: 134, h: 42, size: 13, op: OP_RECALL_RIG, x: -68, y: 54)
    Tap service(legend: "SERVICE", sub: "{200 + rig_wear[sel_rig] * 900:.0} CR", hue: K_GREEN, w: 134, h: 42, size: 13, op: OP_SERVICE_RIG, x: 68, y: 54)
    Tap buy(legend: "BUY RIG", sub: rig_price_text(rig_count), hue: K_TY, w: 134, h: 42, size: 13, op: OP_BUY_RIG, x: -68, y: 2, enabled: rig_count < RIGS && rig_unlocked(rig_count))
    Tap scan(legend: "DEEP SURVEY", sub: survey_text(scan_t), lit: scan_t > 0, w: 134, h: 42, size: 13, op: OP_SCAN_BELT, x: 68, y: 2)
    Hair r_b(x1: -135, y1: -36, x2: 135, y2: -36, hue: LUM_FAINT)
    Ink l_t(text: "TACHYRITE", size: 22, font: font_head, hue: TY_INK, x: -135, y: -58, glow: 2.6)
    Ink l_a(text: "ELEMENT 141 / TY", size: 11, hue: LUM_DIM, x: -135, y: -80)
    Ink l_b(text: "FOLDS FTL FIELDS. HARROW", size: 11, hue: LUM_DIM, x: -135, y: -98)
    Ink l_c(text: "IS THE ONLY RICH VEIN", size: 11, hue: LUM_DIM, x: -135, y: -114)
    Ink l_d(text: "THIS SIDE OF THE RIM.", size: 11, hue: LUM_DIM, x: -135, y: -130)
    Readout mined(value: floor(mined_total), label: "MINED T", x: -68, y: -182, size: 26)
    Readout left(value: floor(stock[G_ORE]), label: "IN BAY T", x: 68, y: -182, size: 26, hue: TY_INK)
  }
}

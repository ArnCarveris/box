using flecs.script
using flecs.script.math

proc log_add(m: string) {
  log4 = log3
  log3 = log2
  log2 = log1
  log1 = log0
  log0 = m
  log_serial += 1
}

proc earn(amount: f32) {
  creds += amount
  lifetime += amount
  income_rate += amount
}

proc recompute_capacity() {
  mut total: f32 = 200
  mut bunks: i32 = 4
  mut berths: i32 = 0
  mut relays: i32 = 1
  mut count: i32 = 0
  for s in 0..SLOTS {
    if slot_kind[s] != M_NONE && slot_build[s] >= 1 {
      count += 1
      if slot_kind[s] == M_HOLD {
        total += 240
      }
      if slot_kind[s] == M_DOCK {
        berths += 2
      }
      if slot_kind[s] == M_RELAY {
        relays += 1
      }
    }
  }
  built_count = count
  cap_total = total
  berth_count = berths
  route_slots = imin(relays + imin(milestone / 2, 1), ROUTES)
  mut share: f32 = 0
  for g in 0..GOODS {
    share += max(kn[KN_BAY + g], 0.02)
  }
  for g in 0..GOODS {
    cap[g] = total * max(kn[KN_BAY + g], 0.02) / share
  }
}

proc power_step(dt: f32) {
  for j in 0..JUNCS {
    isl[j] = j
  }
  for pass in 0..4 {
    for j in 0..JUNCS {
      const n = (j + 1) % JUNCS
      if tie[j] {
        const low = imin(isl[j], isl[n])
        isl[j] = low
        isl[n] = low
      }
    }
  }
  mut burn_total: f32 = 0
  for j in 0..JUNCS {
    j_supply[j] = 0
    j_demand[j] = 0
  }
  j_demand[isl[0]] = j_demand[isl[0]] + 10
  mut active_rigs: f32 = 0
  for r in 0..rig_count {
    if rig_site[r] >= 0 && rig_wear[r] < 1 {
      active_rigs += 1
    }
  }
  j_demand[isl[0]] = j_demand[isl[0]] + active_rigs * 11 * kn[KN_DRILL]
  for s in 0..SLOTS {
    const k = slot_kind[s]
    if k != M_NONE && slot_build[s] >= 1 && slot_on[s] {
      const root = isl[slot_junction(s)]
      if k == M_REACTOR {
        if stock[G_FUEL] > 0.01 {
          j_supply[root] = j_supply[root] + mod_output(k) * kn[KN_BURN]
          burn_total += kn[KN_BURN]
        }
      } else if k == M_SOLAR {
        j_supply[root] = j_supply[root] + mod_output(k)
      } else {
        j_demand[root] = j_demand[root] + mod_load(k)
      }
    }
  }
  fuel_rate = burn_total * 0.05
  stock[G_FUEL] = max(0, stock[G_FUEL] - fuel_rate * dt)
  mut sup_all: f32 = 0
  mut dem_all: f32 = 0
  for j in 0..JUNCS {
    if isl[j] == j {
      sup_all += j_supply[j]
      dem_all += j_demand[j]
      j_factor[j] = match j_demand[j] <= 0.01 { true: match j_supply[j] > 0 { true: 1; _: 0 }; _: min(1, j_supply[j] / j_demand[j]) }
      if j_supply[j] > 0 && j_demand[j] > j_supply[j] * 1.18 {
        j_over[j] = j_over[j] + dt
      } else {
        j_over[j] = max(0, j_over[j] - dt * 2)
      }
      if j_over[j] > 9 {
        j_over[j] = 0
        mut victim: i32 = -1
        mut worst: f32 = 0
        for s in 0..SLOTS {
          if isl[slot_junction(s)] == j && slot_on[s] && slot_build[s] >= 1 && mod_load(slot_kind[s]) > worst {
            victim = s
            worst = mod_load(slot_kind[s])
          }
        }
        if victim >= 0 {
          slot_on[victim] = false
          trips += 1
          alarm = 1
          log_add("BREAKER TRIP: {mod_name(slot_kind[victim])} / BAY {victim + 1} SHED")
        }
      }
    }
  }
  supply_total = sup_all
  demand_total = dem_all
  hub_eff = match main_on { true: j_factor[isl[0]]; _: 0 }
  for s in 0..SLOTS {
    if slot_kind[s] != M_NONE && slot_build[s] >= 1 && slot_on[s] && main_on {
      const v = j_factor[isl[slot_junction(s)]]
      if abs(slot_eff[s] - v) > 0.02 {
        slot_eff[s] = v
      }
    } else if slot_eff[s] != 0 {
      slot_eff[s] = 0
    }
  }
}

proc build_step(dt: f32) {
  for s in 0..SLOTS {
    if slot_kind[s] != M_NONE && slot_build[s] < 1 {
      const was = slot_build[s]
      slot_build[s] = min(1, was + dt / mod_time(slot_kind[s]))
      if slot_build[s] >= 1 {
        log_add("{mod_name(slot_kind[s])} ONLINE AT BAY {s + 1}")
        recompute_capacity()
        flash_gold = 0.5
      }
    }
  }
}

proc milestone_step() {
  mut hit: bool = false
  if milestone == 0 && shipments >= 1 {
    hit = true
  } else if milestone == 1 && lifetime >= 9000 {
    hit = true
  } else if milestone == 2 && cells_total >= 30 {
    hit = true
  } else if milestone == 3 && docked_total >= 8 {
    hit = true
  } else if milestone == 4 && pop >= 120 && crime_avg < 45 {
    hit = true
  } else if milestone == 5 && lifetime >= 150000 {
    hit = true
  } else if milestone == 6 && built_count >= SLOTS && lifetime >= 400000 && crime_avg < 30 {
    hit = true
  }
  if hit {
    milestone += 1
    flash_gold = 1
    acked = false
    log_add("MILESTONE: {milestone_name(milestone)}")
    if milestone < 7 {
      log_add("UNLOCKED: {milestone_unlocks(milestone)}")
    } else {
      won = true
      log_add("CHARTER GRANTED. FARPOST-9 IS A FREE PORT.")
    }
    recompute_capacity()
  }
}

using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.light
using box.spatial
using box.particle
using box.text
using box.transition

export const SPINE_Y: f32 = -18

fn junction_z(j: i32) -> f32 {
  0 - 64 - j * 56
}

fn slot_roll(s: i32) -> f32 {
  match s % 3 { 0: 1.32; 1: 0; _: -1.32 }
}

fn slot_x(s: i32) -> f32 {
  match s % 3 { 0: -8; 1: 0; _: 8 }
}

fn slot_y(s: i32) -> f32 {
  SPINE_Y + match s % 3 { 1: 8; _: 1.8 }
}

fn berth_x(b: i32) -> f32 {
  const s = b / 2
  const side = (b % 2) * 2 - 1
  const lx = side * 20
  const ly = 30
  slot_x(s) + cos(slot_roll(s)) * lx - sin(slot_roll(s)) * ly
}

fn berth_y(b: i32) -> f32 {
  const s = b / 2
  const side = (b % 2) * 2 - 1
  const lx = side * 20
  const ly = 30
  slot_y(s) + sin(slot_roll(s)) * lx + cos(slot_roll(s)) * ly
}

fn berth_z(b: i32) -> f32 {
  junction_z(slot_junction(b / 2))
}

template Scaffold {
  prop h: f32 = 22
  for i in 0..4 {
    const a = i * PI / 2 + PI / 4
    "post_{i}" : Iron { Position: {cos(a) * 12, h / 2, sin(a) * 12}; Box: {0.4, h, 0.4} }
  }
  for k in 0..4 {
    const y = 3 + k * h / 4
    "ring_{k}" : Iron { Position: {0, y, 0}; Rotation: {PI / 2, PI / 4, 0}; Tube: {radius: 12.2, thickness: 0.3, length: 0.4, segments: 4} }
  }
}

template WeldSparks {
  prop seed: i32 = 0
  Position: {cos(seed * 1.3) * 7, 10, sin(seed * 2.1) * 7}
  ParticleEmitter: {max: 320, rate: 70, shape: EmitterSphere, radius: 0.6, direction: {0, 1, 0}, spread: 80, speed: {3, 14}, lifetime: {0.3, 1.2}, size: {0.1, 0.34}, color: {255, 214, 150}, color_variance: {0, 30, 50}, opacity: {0.8, 1}, seed: seed + 5}
  ParticleForces: {gravity: {0, 0, 0}, drag: 0.8}
  ParticleAppearance: {shape: ParticleCircle, blend: ParticleAdditive, stretch: 0.04}
  ParticleCurves: {color: {start: {255, 240, 210}, early: {255, 200, 120}, late: {255, 130, 60}, end: {200, 50, 20}}}
  PointLight: {intensity: 260, range: 40}
  Rgb: {255, 200, 130}
}

template SlotBay {
  prop s: i32 = 0
  const k = slot_kind[s]
  const b = slot_build[s]
  const eff = slot_eff[s]
  const size = 0.12 + clamp01(b) * 0.88

  Position: {slot_x(s), slot_y(s), junction_z(slot_junction(s))}
  Rotation: {0, 0, slot_roll(s)}

  socket : Iron { Position: {0, 0.3, 0}; Cylinder: {radius: 3.4, length: 1.2, segments: 16, smooth: true} }

  if k != 0 {
    body {
      Position: {0, 0, 0}
      Scale: {size, size, size}
      Transition: [Scale: {duration: 0.8, timing_function: EaseOut}]
      if k == M_REACTOR {
        ModReactor m(live: eff)
      } else if k == M_SOLAR {
        ModSolar m(live: eff, seed: s)
      } else if k == M_DOCK {
        ModDock m(live: eff)
      } else if k == M_HOLD {
        ModHold m(live: eff, seed: s)
      } else if k == M_REFINERY {
        ModRefinery m(live: eff)
      } else if k == M_HABITAT {
        ModHabitat m(live: eff, seed: s)
      } else if k == M_RELAY {
        ModRelay m(live: eff, seed: s)
      } else if k == M_SECURITY {
        ModSecurity m(live: eff, seed: s)
      } else if k == M_COMMERCE {
        ModCommerce m(live: eff, seed: s)
      } else {
        ModLeisure m(live: eff, seed: s)
      }
    }
    if b < 1 {
      Scaffold scaffold()
      WeldSparks spark_a(seed: s)
      WeldSparks spark_b(seed: s + 40)
    }
  }
}

template Junction {
  prop j: i32 = 0
  const lit = j_factor[isl[j]] > 0.3 && main_on

  Position: {0, SPINE_Y, junction_z(j)}

  drum : HullBone { Position: {0, 0, 0}; Rotation: {PI / 2, 0, 0}; Cylinder: {radius: 11, length: 18, segments: 12}; TextureTransform: {scale_x: 3, scale_y: 1.4} }
  cap_a : HullOxide { Position: {0, 0, 10.4}; Rotation: {PI / 2, 0, 0}; Frustum: {radius_bottom: 11, radius_top: 7, length: 3, segments: 12}; TextureTransform: {scale_x: 2, scale_y: 0.3} }
  cap_b : HullOxide { Position: {0, 0, -10.4}; Rotation: {-1.5708, 0, 0}; Frustum: {radius_bottom: 11, radius_top: 7, length: 3, segments: 12}; TextureTransform: {scale_x: 2, scale_y: 0.3} }
  band {
    Position: {0, 0, 0}
    Rotation: {PI / 2, 0, 0}
    Tube: {radius: 11.12, thickness: 0.2, length: 3.2, segments: 12}
    Rgb: {12, 11, 10}
    Emissive: {strength: match lit { true: 3.4; _: 0.08 }, color: {255, 214, 170}}
    PbrTextures: {emissive: tex_hull_lights}
    TextureTransform: {scale_x: 3, scale_y: 0.14}
    Transition: [Emissive: {duration: 1.2}]
    NoShadow
  }
  Strobe s_a(big: 3, phase: j % 2 == 0, power: bool_f(lit)) { Position: {0, 12, 4} }
  Flood lamp(power: 1100, range: 70, on: lit) { Position: {6, 9.4, 8}; Rotation: {-0.5, 0.2, 0} }
  Flood lamp_b(power: 1100, range: 70, on: lit) { Position: {-6, 9.4, 8}; Rotation: {-0.5, -0.2, 0} }
}

template SpineSection {
  prop j: i32 = 0
  const z = junction_z(j) - 28

  tube : Hull { Position: {0, SPINE_Y, z}; Rotation: {PI / 2, 0, 0}; Cylinder: {radius: 5, length: 40, segments: 12}; TextureTransform: {scale_x: 2, scale_y: 3} }
  pipe_a : Copper { Position: {4.2, SPINE_Y + 4.2, z}; Rotation: {PI / 2, 0, 0}; Cylinder: {radius: 0.7, length: 40, segments: 8, smooth: true} }
  pipe_b : Iron { Position: {-4.8, SPINE_Y + 3.6, z}; Rotation: {PI / 2, 0, 0}; Cylinder: {radius: 1, length: 40, segments: 8, smooth: true} }
  rail_a : IronMustard { Position: {0, SPINE_Y + 5.2, z}; Box: {1.4, 0.3, 40} }
  for i in 0..4 {
    "rib_{i}" : Iron { Position: {0, SPINE_Y, z - 15 + i * 10}; Rotation: {PI / 2, 0, 0}; Tube: {radius: 5.5, thickness: 0.6, length: 1, segments: 12} }
  }
}

template TowerHead {
  mast : Hull { Position: {0, -11, -6}; Cylinder: {radius: 2.6, length: 18, segments: 16, smooth: true}; TextureTransform: {scale_x: 2, scale_y: 1.6} }
  neck : HullDark { Position: {0, -1.8, 0}; Frustum: {radius_bottom: 2.6, radius_top: 4.3, length: 3, segments: 24}; TextureTransform: {scale_x: 3, scale_y: 0.5} }
  hub : HullBone { Position: {0, SPINE_Y, -32}; Rotation: {PI / 2, 0, 0}; Cylinder: {radius: 12, length: 44, segments: 16}; TextureTransform: {scale_x: 3, scale_y: 2} }
  rear : HullDark { Position: {0, SPINE_Y, -2}; Rotation: {PI / 2, 0, 0}; Frustum: {radius_bottom: 6, radius_top: 12, length: 16, segments: 16}; TextureTransform: {scale_x: 3, scale_y: 1} }
  roof : Hull { Position: {0, 3.5, 0}; Frustum: {radius_bottom: 4.4, radius_top: 1.6, length: 1, segments: 24}; TextureTransform: {scale_x: 3, scale_y: 0.4} }
  for i in 0..3 {
    "ant_{i}" : Steel { Position: {cos(i * 2.1) * 1.2, 7, sin(i * 2.1) * 1.2 + 1}; Cylinder: {radius: 0.05, length: 6 + i * 2, segments: 6} }
  }
  Strobe tip(big: 1.2, phase: false) { Position: {cos(2.1) * 1.2, 11.1, sin(2.1) * 1.2 + 1} }
}

station {
  SpatialIgnore
  TowerHead tower()
  for j in 0..JUNCS {
    Junction "junction_{j}"(j: j)
    SpineSection "spine_{j}"(j: j)
  }
  for s in 0..SLOTS {
    SlotBay "slot_{s}"(s: s)
  }
  rail_nose : HullDark { Position: {0, SPINE_Y, junction_z(3) - 30}; Rotation: {PI / 2, 0, 0}; Frustum: {radius_bottom: 7, radius_top: 2.4, length: 14, segments: 12}; TextureTransform: {scale_x: 2, scale_y: 1} }
  Strobe nose_lamp(big: 7, phase: true) { Position: {0, SPINE_Y, junction_z(3) - 39} }
}

    } else if n == "leaf_bank" {
      props.leaf_bank = v
    } else if n == "card_bend" {
      props.card_bend = v
    } else if n == "needle_cards" {
      props.needle_cards = v
    } else if n == "needle_width" {
      props.needle_width = v
    } else if n == "needle_droop" {
      props.needle_droop = v
    } else if n == "crown_normals" {

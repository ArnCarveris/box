using flecs.script
using flecs.script.math
using box.material
using box.mesh
using box.input
using trees

// The state of the editor: the props of the edited tree, which every control of the panel
// writes, and the settings of the view around it.
tree_editor {
  export const PANEL_W: f32 = 372
  export const ROW_W: f32 = 318

  export const PRESETS = ["Beech", "Oak", "Birch", "Spruce", "Fir", "Pine", "Willow", "Snag"]
  export const BARKS = ["Beech", "Oak", "Birch", "Spruce", "Fir", "Pine", "Willow", "Dead"]
  export const LEAVES = [
    "Beech leaf", "Oak leaf", "Birch leaf", "Willow leaf", "Spruce needle", "Fir needle",
    "Pine needle", "Dead twig"
  ]
  export const DISTRIBUTIONS = ["Alternate", "Opposite", "Whorled", "Spiral"]
  export const ENVELOPES = ["None", "Ellipsoid", "Cone", "Cylinder"]
  export const PLACEMENTS = ["Twigs", "Tips", "Levels"]
  export const ORIENTATIONS = ["Along", "Face up", "Face out"]
  export const CARDS = ["Quad", "Bent", "Cross"]
  export const CROWN_SHAPES = ["Ellipsoid", "Density"]
  export const NEEDLE_STYLES = ["Fir", "Spruce"]
  export const LOD_MODES = ["Auto", "LOD 0", "LOD 1", "LOD 2", "LOD 3"]

  // The distances of the levels of detail while the view picks them
  export const LOD_AUTO: f32 = 30

  // The props of the edited tree: those of the preset it was loaded from, then every edit
  export mut props: Tree = {}

  // The props the tree grows from: the props, copied when they changed and the tree is not
  // growing, so that a drag regrows it as fast as the graph evaluates and no faster
  export mut grown: Tree = {}
  export mut edits: i32 = 0

  // The preset the props were loaded from, its age (the fraction of the mature height) and
  // the seed it was loaded with
  export mut preset: i32 = 0
  export mut age: f32 = 1
  export mut source_seed: i32 = 1

  // Season: 0 spring, 1 summer, 2 autumn, 3 winter
  export mut season: f32 = 1
  export mut wind: f32 = 3
  export mut hour: f32 = 15

  // 0 lets the view pick the level of detail, 1 to 4 show level 0 to 3
  export mut lod: i32 = 0

  export mut show_bark = true
  export mut show_foliage = true
  export mut show_skeleton = false
  export mut turntable = false
  export mut spin: f32 = 0

  // The orbit of the camera around the trunk: yaw and pitch in radians, meters to the target,
  // the height of the target
  export mut yaw: f32 = 0.5
  export mut pitch: f32 = 0.12
  export mut dist: f32 = 40
  export mut target_y: f32 = 12

  export mut panel_shown = true

  // The script of the edited tree, which Print writes to the console and the clipboard
  export mut snippet: string = ""
  export mut printed: i32 = 0

  // The outcome of the last evaluations of the bark and the foliage, and the frame rate
  export mut bark_status: Status = {}
  export mut foliage_status: Status = {}
  export mut fps: f32 = 0

  actions {
    fit {
      Action: {description: "Fit the view to the tree"}
      Binding: {key: F}
    }

    randomize {
      Action: {description: "Grow the tree from another seed"}
      Binding: {key: R}
    }

    print {
      Action: {description: "Print the tree as script to the console and copy it"}
      Binding: {key: P}
    }

    reset {
      Action: {description: "Reload the preset at its age and the seed"}
    }

    toggle_panel {
      Action: {description: "Hide or show the panel"}
      Binding: {key: H}
    }
  }

  // Meters from the camera to the trunk that fit a tree of a height in the view, and the
  // height the camera looks at
  fn fit_dist(height: f32, width: f32) -> f32 {
    max(height * 1.9, height * width * 4) + 4
  }

  fn fit_target(height: f32) -> f32 {
    height * 0.5
  }

  // The LOD settings of the view: picked by distance, or every level up to the forced one at
  // distance 0 and the others out of reach
  fn lod_distance(mode: i32, level: i32) -> f32 {
    match mode {
      0: LOD_AUTO * (pow(2.2, level) - 1) / 1.2
      _: level < mode ? 0 : 1000000
    }
  }

  // The level the view shows: the forced one, or the one the distance of the camera to the
  // bounding sphere of the tree picks
  fn lod_shown(mode: i32, d: f32, height: f32) -> i32 {
    const near = max(d - height * 0.6, 0)
    match mode {
      0: near >= lod_distance(0, 3) ? 3 : near >= lod_distance(0, 2) ? 2 :
        near >= lod_distance(0, 1) ? 1 : 0
      _: mode - 1
    }
  }

  // Season
  fn season_name(s: f32) -> string {
    s < 0.5 ? "Spring" : s < 1.5 ? "Summer" : s < 2.5 ? "Autumn" : "Winter"
  }

  fn mix_rgb(a: Rgb, b: Rgb, t: f32) -> Rgb {
    const k = clamp(t, 0, 1)
    {a.r + (b.r - a.r) * k, a.g + (b.g - a.g) * k, a.b + (b.b - a.b) * k}
  }

  // The leaves over the year from base, the color of the summer: fresh in spring, yellow to
  // orange and brown in autumn, brown in winter; needles darken a little in winter
  fn season_rgb(base: Rgb, s: f32, needles: bool) -> Rgb {
    const spring: Rgb = {168, 206, 86}
    const gold: Rgb = {214, 150, 46}
    const rust: Rgb = {176, 82, 34}
    const brown: Rgb = {112, 74, 44}
    const dull: Rgb = {58, 72, 58}

    match needles {
      true: s < 1 ? mix_rgb(base, spring, (1 - s) * 0.3) :
        s < 2 ? base : mix_rgb(base, dull, (s - 2) * 0.35)
      _: s < 1 ? mix_rgb(base, spring, (1 - s) * 0.55) :
        s < 1.5 ? base :
        s < 2 ? mix_rgb(base, gold, (s - 1.5) * 2) :
        s < 2.5 ? mix_rgb(gold, rust, (s - 2) * 2) : mix_rgb(rust, brown, (s - 2.5) * 2)
    }
  }

  // The fraction of the leaves the season takes away: a crown filling out in spring, the
  // leaves falling through autumn; needles stay
  fn season_thin(s: f32, needles: bool) -> f32 {
    match needles {
      true: 0
      _: s < 1 ? (1 - s) * 0.45 : s < 2 ? 0 : clamp(pow(s - 2, 1.6), 0, 1)
    }
  }

  // The props the tree grows with: those of the panel, thinned by the season
  fn seasoned(p: Tree, s: f32) -> Tree {
    mut r = p
    r.thin = max(p.thin, season_thin(s, p.needles))
    r
  }

  // The bend of the wind sway of a tree, as the Tree computes it
  fn tree_sway(p: Tree) -> f32 {
    p.height * 0.0028 * (1.4 - p.stiffness)
  }

  // Materials by index, the order of BARKS and LEAVES
  fn bark_of(i: i32) -> entity {
    match i {
      1: TreeBarkOak
      2: TreeBarkBirch
      3: TreeBarkSpruce
      4: TreeBarkFir
      5: TreeBarkPine
      6: TreeBarkWillow
      7: TreeBarkDead
      _: TreeBarkBeech
    }
  }

  fn bark_index(e: entity) -> i32 {
    match e.name() {
      "TreeBarkOak": 1
      "TreeBarkBirch": 2
      "TreeBarkSpruce": 3
      "TreeBarkFir": 4
      "TreeBarkPine": 5
      "TreeBarkWillow": 6
      "TreeBarkDead": 7
      _: 0
    }
  }

  fn leaf_of(i: i32) -> entity {
    match i {
      1: TreeLeafOak
      2: TreeLeafBirch
      3: TreeLeafWillow
      4: TreeNeedleSpruce
      5: TreeNeedleFir
      6: TreeNeedlePine
      7: TreeTwigDead
      _: TreeLeafBeech
    }
  }

  fn leaf_index(e: entity) -> i32 {
    match e.name() {
      "TreeLeafOak": 1
      "TreeLeafBirch": 2
      "TreeLeafWillow": 3
      "TreeNeedleSpruce": 4
      "TreeNeedleFir": 5
      "TreeNeedlePine": 6
      "TreeTwigDead": 7
      _: 0
    }
  }

  // Enums by index, the order of the option lists
  fn distribution_index(d: BranchDistribution) -> i32 {
    match "{d}" {
      "Opposite": 1
      "Whorled": 2
      "Spiral": 3
      _: 0
    }
  }

  fn envelope_index(e: EnvelopeShape) -> i32 {
    match "{e}" {
      "Ellipsoid": 1
      "Cone": 2
      "Cylinder": 3
      _: 0
    }
  }

  fn placement_index(p: LeafPlacement) -> i32 {
    match "{p}" {
      "Tips": 1
      "Levels": 2
      _: 0
    }
  }

  fn orientation_index(o: LeafOrientation) -> i32 {
    match "{o}" {
      "FaceUp": 1
      "FaceOut": 2
      _: 0
    }
  }

  fn card_index(c: CardShape) -> i32 {
    match "{c}" {
      "Bent": 1
      "Cross": 2
      _: 0
    }
  }

  fn crown_shape_index(c: CrownShape) -> i32 {
    match "{c}" {
      "Density": 1
      _: 0
    }
  }

  fn needle_style_index(n: NeedleStyle) -> i32 {
    match "{n}" {
      "Spruce": 1
      _: 0
    }
  }

  // The level of branches a panel group edits, by its name
  fn branch_level(group: string) -> i32 {
    match group {
      "b1": 1
      "b2": 2
      "b3": 3
      "b4": 4
      _: 0
    }
  }


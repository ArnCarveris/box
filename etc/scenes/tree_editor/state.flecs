  // Writes the distribution of a level of branches
  fn set_distribution(level: i32, i: i32) {
    if level == 1 {
      if i == 0 {
        props.b1.distribution = Alternate
      } else if i == 1 {
        props.b1.distribution = Opposite
      } else if i == 2 {
        props.b1.distribution = Whorled
      } else {
        props.b1.distribution = Spiral
      }
    } else if level == 2 {
      if i == 0 {
        props.b2.distribution = Alternate
      } else if i == 1 {
        props.b2.distribution = Opposite
      } else if i == 2 {
        props.b2.distribution = Whorled
      } else {
        props.b2.distribution = Spiral
      }
    } else if level == 3 {
      if i == 0 {
        props.b3.distribution = Alternate
      } else if i == 1 {
        props.b3.distribution = Opposite
      } else if i == 2 {
        props.b3.distribution = Whorled
      } else {
        props.b3.distribution = Spiral
      }
    } else if level == 4 {
      if i == 0 {
        props.b4.distribution = Alternate
      } else if i == 1 {
        props.b4.distribution = Opposite
      } else if i == 2 {
        props.b4.distribution = Whorled
      } else {
        props.b4.distribution = Spiral
      }
    }
  }

  // Writes the option a dropdown named after a prop of the tree picked
  fn set_choice(n: string, i: i32) {
    if n == "bark_material" {
      props.bark_material = bark_of(i)
    } else if n == "leaf_material" {
      props.leaf_material = leaf_of(i)
    } else if n == "crown" {
      if i == 0 {
        props.crown = None
      } else if i == 1 {
        props.crown = Ellipsoid
      } else if i == 2 {
        props.crown = Cone
      } else {
        props.crown = Cylinder
      }
    } else if n == "leaf_placement" {
      if i == 0 {
        props.leaf_placement = Twigs
      } else if i == 1 {
        props.leaf_placement = Tips
      } else {
        props.leaf_placement = Levels
      }
    } else if n == "leaf_orientation" {
      if i == 0 {
        props.leaf_orientation = Along
      } else if i == 1 {
        props.leaf_orientation = FaceUp
      } else {
        props.leaf_orientation = FaceOut
      }
    } else if n == "card" {
      if i == 0 {
        props.card = Quad
      } else if i == 1 {
        props.card = Bent
      } else {
        props.card = Cross
      }
    } else if n == "crown_shape" {
      if i == 0 {
        props.crown_shape = Ellipsoid
      } else {
        props.crown_shape = Density
      }
    } else if n == "needle_style" {
      if i == 0 {
        props.needle_style = Fir
      } else {
        props.needle_style = Spruce
      }
    } else if n == "lod" {
      lod = i
    }
  }

  // Writes the flag a switch named after a prop of the tree or a setting of the view set
  fn set_flag(n: string, v: bool) {
    if n == "prune" {
      props.prune = v
    } else if n == "needles" {
      props.needles = v
    } else if n == "show_bark" {
      show_bark = v
    } else if n == "show_foliage" {
      show_foliage = v
    } else if n == "show_skeleton" {
      show_skeleton = v
    } else if n == "turntable" {
      turntable = v
    }
  }

  // The script of a level of branches and of a tree: a Tree instance with every prop, which
  // grows the same tree in another scene that includes trees/generator
  fn branch_snippet(b: TreeBranches) -> string {
    "\{count: {b.count}, density: {b.density:.3}, start: {b.start:.3}, end: {b.end:.3}, " +
    "distribution: {b.distribution}, whorl: {b.whorl}, phyllotaxis: {b.phyllotaxis:.3}, " +
    "down: {b.down:.3}, down_end: {b.down_end:.3}, length: {b.length:.3}, " +
    "length_end: {b.length_end:.3}, gravity: {b.gravity:.3}, light: {b.light:.3}, " +
    "noise: {b.noise:.3}, curve: {b.curve:.3}, curve_back: {b.curve_back:.3}, " +
    "kink: {b.kink:.3}}"
  }

  fn tree_snippet(p: Tree) -> string {
    "trees.Tree tree(seed: {p.seed}, height: {p.height:.3}, radius: {p.radius:.3}, " +
    "taper: {p.taper:.3}, bend: {p.bend:.3}, lean: {p.lean:.3}, twist: {p.twist:.3}, " +
    "flutes: {p.flutes}, flare: {p.flare:.3}, flare_height: {p.flare_height:.3}, " +
    "pipe: {p.pipe:.3}, twig: {p.twig:.3}, " +
    "bark_material: {p.bark_material}, " +
    "b1: " + branch_snippet(p.b1) + ", b2: " + branch_snippet(p.b2) + ", " +
    "b3: " + branch_snippet(p.b3) + ", b4: " + branch_snippet(p.b4) + ", " +
    "crown: {p.crown}, crown_base: {p.crown_base:.3}, crown_top: {p.crown_top:.3}, " +
    "crown_width: {p.crown_width:.3}, prune: {p.prune}, bark_drop: {p.bark_drop:.3}, " +
    "needles: {p.needles}, leaf_material: {p.leaf_material}, leaf_size: {p.leaf_size:.3}, " +
    "leaf_density: {p.leaf_density:.3}, leaf_placement: {p.leaf_placement}, " +
    "leaf_count: {p.leaf_count}, leaf_per_node: {p.leaf_per_node}, " +
    "leaf_start: {p.leaf_start:.3}, leaf_levels: {p.leaf_levels}, " +
    "leaf_angle: {p.leaf_angle:.3}, leaf_orientation: {p.leaf_orientation}, " +
    "leaf_tilt: {p.leaf_tilt:.3}, leaf_bank: {p.leaf_bank:.3}, card: {p.card}, " +
    "card_bend: {p.card_bend:.3}, needle_style: {p.needle_style}, " +
    "needle_cards: {p.needle_cards}, needle_width: {p.needle_width:.3}, " +
    "needle_droop: {p.needle_droop:.3}, crown_shape: {p.crown_shape}, " +
    "crown_normals: {p.crown_normals:.3}, occlusion: {p.occlusion:.3}, thin: {p.thin:.3}, " +
    "growth: {p.growth:.3}, stiffness: {p.stiffness:.3}, flutter: {p.flutter:.3}, " +
    "sway_branch: {p.sway_branch:.3}, ground: {p.ground:.3}, lods: {p.lods}) " +
    "\{ box.transform.Position: \{0, 0, 0} }"
  }
}

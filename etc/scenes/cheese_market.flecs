    Cone: {radius: 0.27, length: 0.17, segments: 4}
    Rgb: iron
  }
}

@tree Parent
template CheeseCounter {
  prop variant: i32 = 0

  const labels = ["FARMHOUSE / AGED & HANDMADE", "ALPINE / CAVE AGED WHEELS", "CREMERIE / FRESH EVERY DAY"]

  for i in 0..14 {
    {
      Position: {(i - 6.5) * 0.28, 0.65, 0}
      Box: {0.265, 1.13, 1.12}
      Rgb: {145 + i % 3 * 9, 95 + i % 3 * 6, 52}
    }
  }
  for i in 0..2 {
    {
      Position: {0, 0.23 + i * 0.76, 0.59}
      Box: {4, 0.09, 0.09}
      Rgb: oak
    }
  }
  top {
    Position: {0, 1.26, 0}
    RoundedBox: {4.12, 0.14, 1.42, 0.035}
    Rgb: honey
  }
  cloth {
    Position: {0.6, 1.34, 0.12}
    Box: {1.7, 0.018, 1.1}
    Rgb: cream
  }
  cloth_drop {
    Position: {0.6, 1.1, 0.7}
    Box: {1.7, 0.49, 0.018}
    Rgb: cream
  }
  for i in 0..9 {
    {
      Position: {-0.17 + i * 0.19, 1.1, 0.712}
      Box: {0.025, 0.49, 0.01}
      Rgb: sage
    }
  }
  for i in 0..3 {
    CheeseWheel(radius: 0.46 - i * 0.06, height: 0.23, tint: {211 + i * 9, 145 + i * 12, 48 + i * 9 + variant * 8}) {
      Position: {-1.22, 1.34 + i * 0.25, -0.06}
      Rotation: {0, i * 0.4, 0}
    }
  }
  CheeseWedge() { Position: {-0.38, 1.35, 0.14}; Rotation: {0, 0.4, 0} }
  CheeseWedge(tint: {248, 226, 153}) {
    Position: {0.47, 1.35, 0.02}
    Rotation: {0, -0.7, 0}
    Scale: {0.85, 0.8, 0.85}
  }
  for i in 0..3 {
    Brie(radius: 0.25) { Position: {1.28, 1.43 + i * 0.15, -0.13} }
  }
  for i in 0..3 {
    MarketLabel(label: "{8 + i * 4} / kg", width: 0.52, size: 0.085) {
      Position: {-1.2 + i * 1.2, 1.48, 0.77}
      Rotation: {-0.2, 0, 0}
    }
  }
  MarketLabel(label: labels[variant % 3], width: 3.3, size: 0.14) {
    Position: {0, 0.64, 0.62}
  }
}

@tree Parent
template MarketAwning {
  prop tint: Rgb = {163, 65, 52}

  for i in 0..12 {
    const stripe = [tint, cream]
    {
      Position: {(i - 5.5) * 0.38, 2.93, 0}
      Rotation: {0.14, 0, 0}
      Box: {0.38, 0.045, 2.45}
      Rgb: stripe[i % 2]
    }
    {
      Position: {(i - 5.5) * 0.38, 2.64, 1.2}
      RoundedBox: {0.375, 0.35, 0.055, 0.09}
      Rgb: stripe[i % 2]
    }
  }
  for side in 0..2 {
    {
      Position: {(side - 0.5) * 4.25, 1.48, 1.03}
      Cylinder: {radius: 0.055, length: 2.96, segments: 12}
      Rgb: oak
    }
    {
      Position: {(side - 0.5) * 4.25, 3.02, 1.03}
      Sphere: {radius: 0.09, segments: 12, smooth: true}
      Rgb: honey
    }
    MarketBeam(ax: (side - 0.5) * 4.25, ay: 2.73, az: 1.12,
      bx: (side - 0.5) * 4.25, by: 3.13, bz: -1.2, radius: 0.045, tint: oak)
  }
  beam {
    Position: {0, 2.73, 1.03}
    Box: {4.4, 0.07, 0.08}
    Rgb: oak
  }
}

@tree Parent
template CheeseStall {
  prop tint: Rgb = {163, 65, 52}
  prop variant: i32 = 0

  MarketAwning(tint: tint) { Position: {} }
  CheeseCounter(variant: variant) { Position: {0, 0, 0.42} }
  MarketLantern() { Position: {-1.78, 2.17, 0.4} }
  for side in 0..2 {
    {
      Position: {(side - 0.5) * 4.22, 1.48, -1.04}
      Box: {0.09, 2.96, 0.09}
      Rgb: oak
    }
  }
  for shelf in 0..2 {
    {
      Position: {0, 0.85 + shelf * 0.8, -0.92}
      Box: {3.95, 0.085, 0.5}
      Rgb: honey
    }
    for i in 0..5 {
      CheeseWheel(radius: 0.26, height: 0.18, tint: {159, 62 + i % 2 * 21, 43}, wax: true) {
        Position: {(i - 2) * 0.72, 0.9 + shelf * 0.8, -0.92}
      }
    }
  }
  MarketCrate() { Position: {-1.1, 0, -0.7} }
  MilkCan() { Position: {1.28, 0, -0.6} }
}


using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.text

const oak: Rgb = {116, 73, 43}
const honey: Rgb = {184, 127, 68}
const cream: Rgb = {250, 234, 196}
const iron: Rgb = {53, 66, 63}
const sage: Rgb = {81, 124, 111}
const rind: Rgb = {222, 157, 48}
const stone: Rgb = {189, 172, 144}

@tree Parent
template MarketBeam {
  prop ax: f32 = 0
  prop ay: f32 = 0
  prop az: f32 = 0
  prop bx: f32 = 0
  prop by: f32 = 1
  prop bz: f32 = 0
  prop radius: f32 = 0.035
  prop tint: Rgb = {53, 66, 63}

  const dx = bx - ax
  const dy = by - ay
  const dz = bz - az
  const length = math.sqrt(dx * dx + dy * dy + dz * dz)
  Position: {(ax + bx) / 2, (ay + by) / 2, (az + bz) / 2}
  Rotation: {math.acos(dy / length), math.atan2(dx, dz), 0}
  Cylinder: {radius: radius, length: length, segments: 8}
  Rgb: tint
}

@tree Parent
template MarketLabel {
  prop label: string = "FARMHOUSE"
  prop width: f32 = 1.1
  prop size: f32 = 0.12
  prop tint: Rgb = {250, 234, 196}

  board {
    Position: {}
    Box: {width, 0.3, 0.045}
    Rgb: iron
  }
  lettering {
    Position: {0, 0, 0.026}
    Scale: {0.01, 0.01, 0.01}
    Text: {value: label, size: size * 100}
    Rgb: tint
  }
}

@tree Parent
template CheeseWheel {
  prop radius: f32 = 0.42
  prop height: f32 = 0.24
  prop tint: Rgb = {222, 157, 48}
  prop wax: bool = false

  body {
    Position: {0, height / 2, 0}
    Cylinder: {radius: radius, length: height, segments: 32, smooth: true}
    Rgb: tint
    PbrMaterial: {roughness: 0.72}
  }
  for side in 0..2 {
    {
      Position: {0, 0.018 + side * (height - 0.036), 0}
      Torus: {radius: radius - 0.018, tube: 0.024, segments: 32, rings: 6}
      Rgb: tint
    }
  }
  top {
    Position: {0, height + 0.003, 0}
    Cylinder: {radius: radius * 0.9, length: 0.012, segments: 32}
    Rgb: {245, 208, 116}
  }
  if wax {
    seal {
      Position: {0, height + 0.014, 0}
      Cylinder: {radius: radius * 0.35, length: 0.012, segments: 20}
      Rgb: cream
    }
    seal_ring {
      Position: {0, height + 0.023, 0}
      Torus: {radius: radius * 0.24, tube: 0.009, segments: 20, rings: 4}
      Rgb: tint
    }
  } else {
    for i in 0..11 {
      const angle = i * 2.4
      const reach = radius * (0.23 + i % 3 * 0.22)
      {
        Position: {math.sin(angle) * reach, height + 0.011, math.cos(angle) * reach}
        Scale: {1, 0.14, 0.8}
        Sphere: {radius: radius * (0.055 + i % 3 * 0.018), segments: 10, smooth: true}
        Rgb: {187, 129, 47}
      }
    }
    for i in 0..18 {
      const angle = i * math.PI / 9
      {
        Position: {math.sin(angle) * (radius + 0.001), height * 0.51, math.cos(angle) * (radius + 0.001)}
        Rotation: {0, angle, 0}
        Box: {0.018, height * 0.65, 0.008}
        Rgb: {196, 135, 43}
      }
    }
  }
}

@tree Parent
template CheeseWedge {
  prop tint: Rgb = {255, 214, 99}

  flesh {
    Position: {}
    Mesh3: {
      vertices: [{-0.42, 0, -0.3}, {0.42, 0, -0.3}, {0, 0, 0.58}, {-0.42, 0.34, -0.3}, {0.42, 0.34, -0.3}, {0, 0.34, 0.58}],
      indices: [0, 1, 2, 3, 5, 4, 0, 3, 4, 0, 4, 1, 1, 4, 5, 1, 5, 2, 2, 5, 3, 2, 3, 0]
    }
    Rgb: tint
    PbrMaterial: {roughness: 0.8}
  }
  rind_strip {
    Position: {0, 0.17, -0.315}
    RoundedBox: {0.86, 0.35, 0.045, 0.015}
    Rgb: rind
  }
  for i in 0..6 {
    {
      Position: {(i % 2 - 0.5) * (0.34 - i * 0.035), 0.342, -0.17 + i * 0.095}
      Scale: {1, 0.12, 0.8}
      Sphere: {radius: 0.035 + i % 3 * 0.012, segments: 12, smooth: true}
      Rgb: {187, 130, 49}
    }
  }
  for i in 0..3 {
    {
      Position: {-0.335 + i * 0.105, 0.13 + i % 2 * 0.1, -0.13 + i * 0.22}
      Rotation: {0, -0.445, 0}
      Scale: {0.11, 0.8, 1}
      Sphere: {radius: 0.052, segments: 12, smooth: true}
      Rgb: {185, 126, 41}
    }
  }
}

@tree Parent
template Brie {
  prop radius: f32 = 0.27

  body {
    Position: {}
    Cylinder: {radius: radius, length: 0.14, segments: 28, smooth: true}
    Rgb: {246, 238, 208}
    PbrMaterial: {roughness: 0.95}
  }
  for i in 0..6 {
    {
      Position: {0, 0.075, (i - 2.5) * radius * 0.24}
      Box: {radius * 1.5, 0.008, 0.012}
      Rgb: {219, 212, 177}
    }
  }
}

@tree Parent
template MarketCrate {
  prop filled: bool = true

  for side in 0..2 {
    for row in 0..3 {
      {
        Position: {0, 0.12 + row * 0.17, (side - 0.5) * 0.76}
        Box: {1.13, 0.13, 0.055}
        Rgb: {165 + row * 8, 111 + row * 5, 62}
      }
      {
        Position: {(side - 0.5) * 1.08, 0.12 + row * 0.17, 0}
        Box: {0.055, 0.13, 0.8}
        Rgb: honey
      }
    }
    for end in 0..2 {
      {
        Position: {(end - 0.5) * 0.99, 0.29, (side - 0.5) * 0.66}
        Box: {0.085, 0.58, 0.085}
        Rgb: oak
      }
      for nail in 0..2 {
        {
          Position: {(end - 0.5) * 0.99, 0.15 + nail * 0.3, (side - 0.5) * 0.825}
          Sphere: {radius: 0.018, segments: 6}
          Rgb: iron
        }
      }
    }
  }
  for i in 0..5 {
    {
      Position: {(i - 2) * 0.21, 0.045, 0}
      Box: {0.2, 0.08, 0.72}
      Rgb: honey
    }
  }
  if filled {
    for i in 0..3 {
      CheeseWheel(radius: 0.23, height: 0.16, tint: {177, 74, 45}, wax: true) {
        Position: {(i - 1) * 0.32, 0.34, 0}
        Rotation: {0, i * 0.7, 0.15}
      }
    }
  }
}

@tree Parent
template MarketBarrel {
  for i in 0..16 {
    const angle = i * math.PI / 8
    {
      Rotation: {0, angle, 0}
      {
        Position: {0, 0.52, 0.38}
        RoundedBox: {0.155, 0.96, 0.1, 0.035}
        Rgb: {137 + i % 3 * 13, 87 + i % 3 * 9, 48 + i % 3 * 4}
      }
    }
  }
  for i in 0..3 {
    {
      Position: {0, 0.13 + i * 0.38, 0}
      Tube: {radius: 0.445, thickness: 0.025, length: 0.07, segments: 32}
      Rgb: iron
      PbrMaterial: {metallic: 0.65, roughness: 0.4}
    }
  }
  lid {
    Position: {0, 0.99, 0}
    Cylinder: {radius: 0.4, length: 0.055, segments: 24}
    Rgb: honey
  }
  for i in 0..5 {
    {
      Position: {(i - 2) * 0.135, 1.02, 0}
      Box: {0.012, 0.007, 0.56}
      Rgb: oak
    }
  }
}


include cheese_market/materials
include cheese_market/cheese_shop
include cheese_market/cheese_stall
include cheese_market/fountain
include cheese_market/cheese_counter
include cheese_market/cheese_scale
include cheese_market/chalk_board
include cheese_market/crate
include cheese_market/baguette
include cheese_market/milk_can
include cheese_market/flower_pot
include cheese_market/cheese_cart
include cheese_market/tasting_table
include cheese_market/tree
include cheese_market/barrel
include cheese_market/cheese_wheel
include cheese_market/lantern
include cheese_market/bunting
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.text
using box.atmosphere
using assets

$ {
  box.app.FpsTarget: {60}
  Scene: {baked: true, reflections: true, environment: true, aerial_perspective: true,
    transmission: true, sheen: true, clear_coat: true, anisotropy: true,
    diffuse_transmission: true}
}

window {
  Surface: {width: 1440, height: 960, vsync: true}
}

camera {
  Position: {-23.5, 20, 29}
  Rotation: {-0.48, -0.681, 0}
  Camera: {fov: 43, near_: 0.1, far_: 150}
  CameraController: {speed: 10}
}

sky {
  Rotation: {0.85, -2.4, 0}
  DirectionalLight: {intensity: 1.8 * math.PI}
  Rgb: {255, 236, 208}
  Atmosphere: {
    sun: sky,
    units_per_km: 60,
    rayleigh: {scale_height: 8, scattering_scale: 1.6},
    mie: {scale_height: 1.4, anisotropy: 0.76, scattering_scale: 2.2, tint: {255, 232, 196}},
    ground_albedo: {92, 110, 118},
    sun_disk_intensity: 6,
    sun_radius: 0.6
  }
  HeightFog: {density: 0.004, falloff: 0.12, base_height: 0, max_opacity: 0.2, atmosphere: sky}
}

$ {
  AmbientLight: {sky: {171, 193, 211}, ground: {119, 99, 72}, intensity: 0.35}
  Bake: {
    environment: sky,
    probe_spacing: 1,
    bounds_padding: 0.3,
    bounces: 1,
    capture_size: 64,
    budget_ms: 8
  }
  ReflectionBake: {
    resolution: 128,
    budget_ms: 2,
    scene_probe: true,
    scene_probe_height: 2.5,
    environment: sky
  }
}

cheese_market {
  island {
    Position: {0, -0.48, 0}
    RoundedBox: {28, 0.95, 24, 0.35}
    Rgb: {132, 119, 100}
  }

  mortar {
    Position: {0, 0.01, 0}
    RoundedBox: {27.6, 0.14, 23.6, 0.25}
    Rgb: {147, 139, 117}
  }

  for row in 0..44 {
    for col in 0..39 {
      const tone = (row * 17 + col * 13) % 5
      {
        Position: {-13.3 + col * 0.69 + row % 2 * 0.24, 0.095, -11.35 + row * 0.525}
        Rotation: {0, math.sin(row * 12 + col * 7) * 0.025, 0}
        RoundedBox: {0.65, 0.13, 0.48, 0.055}
        Rgb: {173 + tone * 7, 162 + tone * 6, 139 + tone * 5}
        PbrMaterial: {roughness: 0.94}
      }
    }
  }

  for side in 0..2 {
    for i in 0..40 {
      {
        Position: {(side - 0.5) * 27.5, 0.13, (i - 19.5) * 0.59}
        RoundedBox: {0.3, 0.28, 0.56, 0.04}
        Rgb: MarketStone
      }
    }

    for i in 0..46 {
      {
        Position: {(i - 22.5) * 0.59, 0.13, (side - 0.5) * 23.5}
        RoundedBox: {0.56, 0.28, 0.3, 0.04}
        Rgb: MarketStone
      }
    }
  }

  CheeseShop(label: "LA FROMAGERIE", height: 5.6) { Position: {-7.1, 0.18, -8.6} }
  CheeseShop(label: "MAISON DU COMTE", tint: {215, 157, 120}, awning: {81, 124, 111}, height: 6.3) {
    Position: {-0.6, 0.18, -8.6}
  }

  CheeseShop(label: "BEURRE & CREME", tint: {231, 212, 166}, awning: {210, 157, 60}, height: 4.9) {
    Position: {5.9, 0.18, -8.6}
  }

  CheeseStall(tint: {81, 124, 111}) { Position: {-10.3, 0.18, -0.7}; Rotation: {0, 0.28, 0} }
  CheeseStall(tint: {179, 91, 57}, variant: 1) {
    Position: {8.9, 0.18, -1.1}
    Rotation: {0, -math.PI / 2, 0}
  }

  CheeseStall(tint: {211, 163, 64}, variant: 2) {
    Position: {8.9, 0.18, 5.1}
    Rotation: {0, -math.PI / 2, 0}
  }

  fountain_court {
    Position: {-0.3, 0.18, 0.8}
    paving {
      Position: {0, 0, 0}
      Cylinder: {radius: 2.65, length: 0.08, segments: 48}
      Rgb: {149, 149, 124}
    }

    for i in 0..40 {
      {
        Position: {math.sin(i * math.PI / 20) * 2.48, 0.055, math.cos(i * math.PI / 20) * 2.48}
        Rotation: {0, i * math.PI / 20, 0}
        Box: {0.34, 0.045, 0.23}
        Rgb: MarketCream
      }
    }

    MarketFountain() { Position: {0, 0.08, 0} }
  }

  cheese_tasting {
    Position: {-4.65, 0.18, 5.9}
    Rotation: {0, -0.15, 0}
    CheeseCounter() { Position: {} }
    CheeseScale() { Position: {0.45, 1.34, -0.43}; Scale: {0.7, 0.7, 0.7} }
    knife {
      Position: {0.85, 1.37, 0.48}
      Rotation: {0, 0.35, 0}
      blade {
        Position: {0, 0, 0}
        Box: {0.11, 0.018, 0.36}
        Rgb: {203, 211, 201}
        PbrMaterial: {metallic: 0.8, roughness: 0.2}
        SpecularAnisotropy: {strength: 0.6, rotation: 0}
      }

      handle {
        Position: {0, 0.008, -0.28}
        RoundedBox: {0.08, 0.055, 0.21, 0.02}
        Rgb: MarketOak
      }
    }

    ChalkBoard() { Position: {2.5, 0, 0.2}; Rotation: {0, -0.3, 0} }
    MarketCrate() { Position: {-2.55, 0, -0.1}; Rotation: {0, 0.2, 0} }
    MarketCrate(filled: false) { Position: {-2.53, 0.58, -0.08}; Rotation: {0, -0.08, 0} }

    for i in 0..3 {
      Baguette() { Position: {-2.8 + i * 0.25, 0.99, -0.07}; Rotation: {-0.3, -0.2, 0} }
    }

    MilkCan() { Position: {-1.75, 0, -0.95} }
    MilkCan() { Position: {-1.2, 0, -0.9}; Scale: {0.8, 0.8, 0.8} }
    FlowerPot(size: 1.2) { Position: {2.65, 0, -1} }
  }

  CheeseCart() { Position: {-10.2, 0.18, 5.1}; Rotation: {0, -0.4, 0} }
  CheeseCart() { Position: {11.45, 0.18, -7.5}; Rotation: {0, 0.3, 0}; Scale: {0.85, 0.85, 0.85} }

  TastingTable() { Position: {2.8, 0.18, 7.45} }
  TastingTable() { Position: {5, 0.18, 3.9}; Rotation: {0, 0.5, 0} }
  TastingTable() { Position: {-5.5, 0.18, 0.4}; Rotation: {0, -0.5, 0} }

  MarketTree(variant: 0) { Position: {-11.9, 0.18, -7.8} }
  MarketTree(variant: 1) { Position: {11.65, 0.18, -3.6} }
  MarketTree(variant: 2) { Position: {11.65, 0.18, 9.4} }
  MarketTree(variant: 3) { Position: {-10.8, 0.18, 9.3}; Scale: {0.9, 0.9, 0.9} }

  for i in 0..3 {
    MarketBarrel() { Position: {-4.15 + i * 0.9, 0.18, -4.1} }
    CheeseWheel(radius: 0.35, height: 0.22) { Position: {-4.15 + i * 0.9, 1.21, -4.1} }
    MarketCrate() { Position: {10.8, 0.18 + i * 0.58, 1}; Rotation: {0, 0.05 + i * 0.06, 0} }
  }

  MarketBarrel() { Position: {6.8, 0.18, 8.7} }
  MarketBarrel() { Position: {7.7, 0.18, 9.1} }
  FlowerPot(size: 1.3) { Position: {7.7, 1.21, 9.1} }
  MilkCan() { Position: {6.3, 0.18, 9.5} }
  MilkCan() { Position: {6.75, 0.18, 9.8}; Scale: {0.8, 0.8, 0.8} }
  ChalkBoard(label: "DEGUSTATION\n\nCHEESE\n& BREAD\n\nBON APPETIT") {
    Position: {0.4, 0.18, 7.1}
    Rotation: {0, -0.35, 0}
  }

  ChalkBoard() { Position: {-4.1, 0.18, -3.35} }

  for row in 0..2 {
    for side in 0..2 {
      {
        Position: {(side - 0.5) * 20.4, 2.38, -3.5 + row * 10.2}
        Cylinder: {radius: 0.065, length: 4.4, segments: 12}
        Rgb: MarketOak
      }

      MarketLantern() { Position: {(side - 0.5) * 20.4, 4.24, -3.5 + row * 10.2} }
    }

    MarketBunting(length: 20.4, flags: 28) { Position: {0, 4.4, -3.5 + row * 10.2} }
  }

  MarketBunting(length: 10.2, flags: 16) {
    Position: {10.2, 4.4, 1.6}
    Rotation: {0, math.PI / 2, 0}
  }

  for side in 0..2 {
    for i in 0..4 {
      {
        Position: {-5.8 + i * 3.85, 0.6, (side - 0.5) * 22.6}
        RoundedBox: {3.5, 0.9, 0.4, 0.06}
        Rgb: MarketStone
      }

      {
        Position: {-5.8 + i * 3.85, 1.09, (side - 0.5) * 22.6}
        Box: {3.65, 0.14, 0.55}
        Rgb: {222, 206, 173}
      }

      FlowerPot(size: 0.8, tint: {206, 143, 167}) {
        Position: {-5.8 + i * 3.85, 1.16, (side - 0.5) * 22.6}
      }
    }
  }

  courtyard_reflection {
    Position: {-0.3, 1.8, 1.6}
    ReflectionProbe: {
      extent: {6.9, 3, 6},
      blend: 1,
      priority: 1,
      projection: {7.6, 2.8, 6.8},
      offset: {0, -0.2, 0}
    }
  }

  fountain_reflection {
    Position: {-0.3, 1.2, 0.8}
    ReflectionProbe: {
      extent: {2, 1.4, 2},
      blend: 0.5,
      priority: 2,
      projection: {7.5, 3.4, 6.5},
      offset: {0, -0.35, 0.9}
    }
  }
}

view {
  gtao {
    Gtao: {radius: 0.5, final_value_power: 2}
  }

  bloom {
    Bloom: {intensity: 0.12, threshold: 1.4}
  }

  tonemap {
    Tonemap: {}
  }

  smaa {
    Smaa: {}
  }

  View: {
    camera: camera,
    clear: {enabled: true, color: {91, 112, 123, 255}},
    lighting: {
      enabled: true,
      baked: true,
      reflections: true,
      atmosphere: true,
      environment: {source: sky, intensity: 0.6, yaw: 0, background: false}
    },
    shadows: {enabled: true, resolution: 2048, max_distance: 90},
    effects: [
      {effect: gtao},
      {effect: sky},
      {effect: bloom},
      {effect: tonemap},
      {effect: smaa}
    ]
  }
}

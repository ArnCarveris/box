include materials
include roof
include tiled_roof
include window
using flecs.script
using box.transform
using box.geometry
using box.material

assets {
  template DormerRoof : Roof {
    TiledRoof(width: width, depth: depth, color: color) { Position: {} }

    {
      Position: {0, 1.08, depth / 2 - 0.48}
      Box: {1.5, 0.86, 1.2}
      Rgb: TownCream
      Window(width: 1.18, height: 0.6, panes: 3) {
        Position: {0, 0.04, 0.64}
      }

      {
        Position: {0, 0.65, 0}
        TrianglePrism: {1.85, 0.5, 1.55}
        Rgb: color
      }

      {
        Position: {0, 0.93, 0}
        Rotation: {math.PI / 2, 0, 0}
        Cylinder: {radius: 0.07, length: 1.7, segments: 10}
        Rgb: color
      }
    }
  }
}

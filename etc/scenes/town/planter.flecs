include materials
using flecs.script
using box.transform
using box.geometry
using box.material

assets {
  @tree Parent
  template Planter {
    prop blossoms: bool = false

    {
      Position: {0, 0.16, 0}
      Cylinder: {radius: 0.21, length: 0.32, segments: 10}
      Rgb: {186, 116, 89}
    }
    {
      Position: {0, 0.31, 0}
      Torus: {radius: 0.2, tube: 0.035, segments: 12, rings: 6}
      Rgb: {214, 145, 112}
    }
    {
      Position: {0, 0.46, 0}
      Sphere: {radius: 0.28, segments: 8, smooth: true}
      Rgb: TownLeaf
    }
    if blossoms {
      for i in 0..5 {
        {
          Position: {math.cos(i * 1.26) * 0.19, 0.64, math.sin(i * 1.26) * 0.19}
          Sphere: {radius: 0.07, segments: 8, smooth: true}
          Rgb: TownPink
        }
      }
    }
  }
}

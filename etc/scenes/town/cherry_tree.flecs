include materials
using flecs.script
using box.transform
using box.geometry
using box.material
using box.particle

assets {
  template CherryTree {
    {
      Position: {0, 0.95, 0}
      Cylinder: {radius: 0.12, length: 1.9, segments: 9}
      Rgb: TownTimber
    }

    for i in 0..5 {
      {
        Position: {math.cos(i * 1.26) * 0.48, 2.05 + (i % 2) * 0.3, math.sin(i * 1.26) * 0.48}
        (IsA, TownBlossom)
        Sphere: {radius: 0.66, segments: 8, smooth: true}
        Rgb: {243, 179 + i * 5, 196 + i * 4}
      }
    }

    petals {
      Position: {0, 2.2, 0}
      Emitter: {
        max: 80, rate: 9, shape: EmitterSphere, radius: 0.8,
        direction: {0, -1, 0}, spread: 60, speed: {0.05, 0.2},
        lifetime: {3, 5}, size: {0.045, 0.07}, opacity: {0.8, 1},
        color: {250, 196, 210}, seed: 5
      }
      Forces: {
        gravity: {0, -0.4, 0},
        wind: {0.35, 0, 0.15},
        drag: 1.2,
        turbulence: 0.6,
        turbulence_scale: 2
      }
      Collision: {height: 0.24, bounce: 0, friction: 1}
      Appearance: {lit: 0.85}
      Curves: {opacity: {keys: [{0, 0}, {0.1, 1}, {0.85, 1}, {1, 0}]}}
    }

    {
      Position: {0, 0.07, 0}
      Cylinder: {radius: 0.66, length: 0.14, segments: 12}
      Rgb: {159, 177, 139}
    }
  }
}

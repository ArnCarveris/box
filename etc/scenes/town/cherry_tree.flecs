include materials
using flecs.script
using box.transform
using box.geometry
using box.material

assets {
  @tree Parent
  template CherryTree {
    {
      Position: {0, 0.95, 0}
      Cylinder: {radius: 0.12, length: 1.9, segments: 9}
      Rgb: TownTimber
    }
    for i in 0..5 {
      {
        Position: {math.cos(i * 1.26) * 0.48, 2.05 + (i % 2) * 0.3, math.sin(i * 1.26) * 0.48}
        Sphere: {radius: 0.66, segments: 8, smooth: true}
        Rgb: {243, 179 + i * 5, 196 + i * 4}
      }
    }
    {
      Position: {0, 0.07, 0}
      Cylinder: {radius: 0.66, length: 0.14, segments: 12}
      Rgb: {159, 177, 139}
    }
  }
}

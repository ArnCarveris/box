include materials
include facade
include window
using flecs.script
using box.transform
using box.geometry
using box.material

assets {
  template BayFacade : Facade {
    {
      Position: {0, height / 2, 0}
      Box: {width, height - 0.08, 0.18}
      Rgb: color
    }
    {
      Position: {0, height * 0.56, 0.38}
      Box: {width * 0.66, height * 0.64, 0.65}
      Rgb: TownCream
      Window(width: width * 0.61, height: height * 0.49, frame: TownCream, panes: 3) {
        Position: {0, 0.04, 0.37}
      }
      for side in 0..2 {
        Window(width: 0.42, height: height * 0.49, frame: TownCream) {
          Position: {(side * 2 - 1) * width * 0.33, 0.04, 0}
          Rotation: {0, (side * 2 - 1) * math.PI / 2, 0}
        }
      }
    }
    {
      Position: {0, height * 0.9, 0.46}
      Rotation: {0.12, 0, 0}
      Box: {width * 0.72, 0.13, 1.02}
      Rgb: {115, 145, 133}
    }
    for side in 0..2 {
      {
        Position: {(side * 2 - 1) * width * 0.25, height * 0.2, 0.34}
        Box: {0.12, 0.25, 0.45}
        Rgb: TownTimber
      }
    }
  }
}

include materials
using flecs.script
using box.transform
using box.geometry
using box.material

assets {
  @tree Parent
  template PowerSpan {
    prop length: f32 = 8

    for wire in 0..3 {
      for i in 0..16 {
        const x0 = length * i / 16
        const x1 = length * (i + 1) / 16
        const y0 = 7.16 - 0.65 * 4 * (x0 / length) * (1 - x0 / length)
        const y1 = 7.16 - 0.65 * 4 * (x1 / length) * (1 - x1 / length)
        {
          Position: {(x0 + x1) / 2, (y0 + y1) / 2, (wire - 1) * 0.53}
          Rotation: {0, 0, math.atan((y1 - y0) / (x1 - x0)) - math.PI / 2}
          Cylinder: {radius: 0.018, length: math.sqrt((x1 - x0) * (x1 - x0) + (y1 - y0) * (y1 - y0)), segments: 6}
          Rgb: TownIron
        }
      }
    }
  }
}

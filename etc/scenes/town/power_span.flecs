include materials
using flecs.script
using box.transform
using box.geometry
using box.material

assets {
  template PowerSpan {
    prop length: f32 = 8

    route {
      Path3D: {
        start: {0, 7.16, 0},
        segments: [
          {kind: CatmullRom, end: {length * 0.25, 7.16 - 0.65 * 0.75, 0}},
          {kind: CatmullRom, end: {length * 0.5, 7.16 - 0.65, 0}},
          {kind: CatmullRom, end: {length * 0.75, 7.16 - 0.65 * 0.75, 0}},
          {kind: CatmullRom, end: {length, 7.16, 0}}
        ]
      }
    }

    for wire in 0..3 {
      {
        Position: {0, 0, (wire - 1) * 0.53}
        Sweep: {path: route, profile: TownWireProfile, scale: {0.018, 0.018}, rings: 48}
        Rgb: TownIron
      }
    }
  }
}

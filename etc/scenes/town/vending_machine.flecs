include materials
using flecs.script
using box.transform
using box.geometry
using box.material

assets {
  template VendingMachine {
    prop color: Rgb = {206, 71, 70}

    {
      Position: {0, 0.93, 0}
      Box: {1.05, 1.86, 0.72}
      Rgb: color
    }

    {
      Position: {-0.09, 1.22, 0.38}
      Box: {0.74, 0.91, 0.05}
      Rgb: {220, 242, 234}
      Emissive: {2, {220, 242, 234}}
    }

    for row in 0..3 {
      for col in 0..4 {
        {
          Position: {-0.36 + col * 0.18, 0.95 + row * 0.28, 0.43}
          Cylinder: {radius: 0.055, length: 0.17, segments: 8}
          Rgb: (row + col) % 2 == 0 ? {242, 178, 73} : {81, 159, 158}
        }

        {
          Position: {-0.36 + col * 0.18, 0.83 + row * 0.28, 0.44}
          Box: {0.07, 0.035, 0.02}
          Rgb: TownCream
        }
      }
    }

    {
      Position: {0.39, 1.07, 0.39}
      Box: {0.13, 0.39, 0.045}
      Rgb: TownIron
    }

    {
      Position: {0, 0.35, 0.38}
      Box: {0.67, 0.24, 0.055}
      Rgb: TownIron
    }

    {
      Position: {0, 1.77, 0.39}
      Box: {0.86, 0.1, 0.04}
      Rgb: TownCream
    }
  }
}

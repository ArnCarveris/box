      Rotation: {0, 0.785, 0}
      Rgb: {96, 70, 52}
      PbrMaterial: {metallic: 0.6, roughness: 0.6}
    }

    for k in 0..4 {
      const wx = match k % 2 { 0: -0.5; _: 0.5 }
      const wz = k < 2 ? 3.6 : 4.4
      "cart_wheel_{k}" : MvIron {
        Position: {wx, 0.3, wz}
        Rotation: {0, 0, HALF_PI}
        Cylinder: {length: 0.08, radius: 0.18, segments: 10}

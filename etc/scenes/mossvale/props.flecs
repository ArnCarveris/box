  template Tree {
    prop seed: f32 = 0
    prop kind: i32 = 0
    prop s: f32 = 1

    const sz = s * (0.85 + fract(seed * 13.7) * 0.4)
    const lean = (fract(seed * 5.3) - 0.5) * 0.12
    const shade = 0.88 + fract(seed * 3.1) * 0.24

    tree {
      Rotation: {lean, seed * 6.283, lean * 0.5}
      Scale: {sz, sz, sz}

      if kind == 1 {
        trunk : MvBark {
          Position: {0, 0, 0}
          Scale: {0.55, 0.6, 0.55}
          Lathe: {profile: MvTrunkShape, cap_end: true, segments: 7, rings: 6}
        }

        skirt : MvLeafPine {
          Position: {0, 0.7, 0}
          Scale: {2.1, 1.9, 2.1}
          Rgb: {50 * shade, 96 * shade, 66 * shade}
          Lathe: {profile: MvPineTierShape, cap_start: true, segments: 10, rings: 6}
        }

        low : MvLeafPine {
          Position: {0, 1.75, 0}
          Rotation: {0, 0.4, 0}
          Scale: {1.7, 1.75, 1.7}
          Lathe: {profile: MvPineTierShape, cap_start: true, segments: 10, rings: 6}
        }

        mid : MvLeafPine {
          Position: {0, 2.8, 0}
          Rotation: {0, 0.9, 0}
          Scale: {1.3, 1.55, 1.3}
          Rgb: {62 * shade, 112 * shade, 76 * shade}
          Lathe: {profile: MvPineTierShape, cap_start: true, segments: 10, rings: 6}
        }

        tip : MvLeafPine {
          Position: {0, 3.75, 0}
          Rotation: {0, 1.6, 0}
          Scale: {0.85, 1.5, 0.85}
          Rgb: {70 * shade, 122 * shade, 82 * shade}
          Lathe: {profile: MvPineTierShape, cap_start: true, segments: 10, rings: 6}
        }
      } else if kind == 2 {
        trunk : MvBirchBark {
          Position: {0, 0, 0}
          Scale: {0.36, 1.45, 0.36}
          Lathe: {profile: MvTrunkShape, cap_end: true, segments: 8, rings: 6}
        }

        branch : MvBirchBark {
          Position: {0.25, 2.6, 0}
          Rotation: {0, 0, -0.6}
          Frustum: {length: 1.2, radius_bottom: 0.07, radius_top: 0.03, segments: 5}
        }

        crown : MvLeafLight {
          Position: {0, 3.9, 0}
          Scale: {1, 1.3, 1}
          Sphere: {radius: 1.05, segments: 12, smooth: true}
        }

        crown_b : MvLeafLight {
          Position: {0.7, 3.2, 0.3}
          Sphere: {radius: 0.75, segments: 10, smooth: true}
          Rgb: {160 * shade, 200, 92 * shade}
        }

        crown_c : MvLeafLight {
          Position: {-0.55, 3.35, -0.3}
          Sphere: {radius: 0.7, segments: 10, smooth: true}
          Rgb: {132, 182 * shade, 72}
        }

        crown_d : MvLeafLight {
          Position: {0.1, 4.8, 0.1}
          Sphere: {radius: 0.6, segments: 10, smooth: true}
        }
      } else {
        trunk : MvBark {
          Position: {0, 0, 0}
          Lathe: {profile: MvTrunkShape, cap_end: true, segments: 9, rings: 8}
        }

        bough_a : MvBark {
          Position: {0.42, 2.35, 0.05}
          Rotation: {0.1, 0, -0.75}
          Frustum: {length: 1.3, radius_bottom: 0.16, radius_top: 0.08, segments: 6}
        }

        bough_b : MvBark {
          Position: {-0.36, 2.45, -0.1}
          Rotation: {-0.2, 0, 0.7}
          Frustum: {length: 1.2, radius_bottom: 0.14, radius_top: 0.07, segments: 6}
        }

        if kind == 3 {
          crown : MvLeafAutumn {
            Position: {0, 3.3, 0}
            Scale: {1.1, 0.92, 1.1}
            Sphere: {radius: 1.55, segments: 14, smooth: true}
          }

          crown_b : MvLeafRed {
            Position: {0.95, 3.0, 0.35}
            Sphere: {radius: 1.0, segments: 12, smooth: true}
          }

          crown_c : MvLeafAutumn {
            Position: {-0.95, 3.15, -0.3}
            Sphere: {radius: 1.05, segments: 12, smooth: true}
            Rgb: {226, 140 * shade, 54}
          }

          crown_d : MvLeafRed {
            Position: {0.2, 4.25, -0.2}
            Sphere: {radius: 0.95, segments: 12, smooth: true}
            Rgb: {222, 118 * shade, 60}
          }

          crown_e : MvLeafAutumn {
            Position: {-0.2, 2.8, 1.0}
            Sphere: {radius: 0.8, segments: 10, smooth: true}
          }
        } else {
          crown : MvLeaf {
            Position: {0, 3.3, 0}
            Scale: {1.1, 0.92, 1.1}
            Sphere: {radius: 1.55, segments: 14, smooth: true}
            Rgb: {104 * shade, 160 * shade, 66}
          }

          crown_b : MvLeafLight {
            Position: {0.95, 3.0, 0.35}
            Sphere: {radius: 1.0, segments: 12, smooth: true}
          }

          crown_c : MvLeafDark {
            Position: {-0.95, 3.15, -0.3}
            Sphere: {radius: 1.05, segments: 12, smooth: true}
          }

          crown_d : MvLeaf {
            Position: {0.2, 4.25, -0.2}
            Sphere: {radius: 0.95, segments: 12, smooth: true}
            Rgb: {122 * shade, 172, 70}
          }

          crown_e : MvLeafLight {
            Position: {-0.2, 2.8, 1.0}
            Sphere: {radius: 0.8, segments: 10, smooth: true}
            Rgb: {150, 194 * shade, 84}
          }

          if fract(seed * 17.3) > 0.7 {
            for f in 0..5 {
              const a = seed * 40 + f * 1.3
              "fruit_{f}" {
                Position: {sin(a) * 1.45, 2.9 + fract(a) * 1.1, cos(a) * 1.45}
                Sphere: {radius: 0.12, segments: 8, smooth: true}
                Rgb: {214, 52, 44}
                PbrMaterial: {roughness: 0.35}
              }
            }
          }
        }
      }
    }
  }

  template Bush {
    prop seed: f32 = 0
    prop s: f32 = 1
    const shade = 0.9 + fract(seed * 4.3) * 0.2
    Rotation: {0, seed * 6.283, 0}
    a : MvLeafDark {
      Position: {0, 0.42 * s, 0}
      Scale: {1.25 * s, 0.85 * s, 1.05 * s}
      Sphere: {radius: 0.7, segments: 12, smooth: true}
      Rgb: {62 * shade, 116 * shade, 64}
    }

    b : MvLeaf {
      Position: {0.5 * s, 0.38 * s, 0.25 * s}
      Scale: {s, 0.9 * s, s}
      Sphere: {radius: 0.5, segments: 10, smooth: true}
    }

    c : MvLeafLight {
      Position: {-0.35 * s, 0.6 * s, -0.15 * s}
      Scale: {s, 0.9 * s, s}
      Sphere: {radius: 0.45, segments: 10, smooth: true}
      Rgb: {130 * shade, 180, 74}
    }

    if fract(seed * 7.1) > 0.6 {
      berries {
        for i in 0..6 {
          const a = seed * 20 + i * 1.1
          "b_{i}" {
            Position: {sin(a) * 0.72 * s, (0.45 + fract(a) * 0.35) * s, cos(a) * 0.6 * s}
            Sphere: {radius: 0.07, segments: 6, smooth: true}
            Rgb: {206, 46, 72}
            PbrMaterial: {roughness: 0.3}
          }
        }
      }
    } else if fract(seed * 7.1) > 0.35 {
      blossoms {
        for i in 0..7 {
          const a = seed * 30 + i * 0.95
          "b_{i}" : MvPetalWhite {
            Position: {sin(a) * 0.75 * s, (0.4 + fract(a * 1.7) * 0.45) * s, cos(a) * 0.62 * s}
            Scale: {1, 0.6, 1}
            Sphere: {radius: 0.08, segments: 6}
          }
        }
      }
    }
  }

  template Rock {
    prop seed: f32 = 0
    prop s: f32 = 1
    r : MvRock {
      Position: {0, 0.26 * s, 0}
      Rotation: {seed * 0.4, seed * 5, seed * 0.3}
      Scale: {1.3 * s, 0.75 * s, 1.0 * s}
      IcoSphere: {radius: 0.8, segments: 1}
    }

    moss : MvLeafDark {
      Position: {0.05 * s, 0.62 * s, -0.05 * s}
      Rotation: {0, seed * 5, 0}
      Scale: {1.0 * s, 0.22 * s, 0.75 * s}
      Sphere: {radius: 0.62, segments: 10, smooth: true}
      Rgb: {104, 140, 70}
      texture.Transform: {2, 1, 0, 0}
    }

    if fract(seed * 3.3) > 0.5 {
      r2 : MvRock {
        Position: {0.75 * s, 0.14 * s, 0.45 * s}
        Rotation: {seed * 2, seed, 0}
        Scale: {s, 0.8 * s, s}
        IcoSphere: {radius: 0.4, segments: 1}
        Rgb: {150, 144, 132}
      }
    }

    if fract(seed * 9.1) > 0.55 {
      r3 : MvRock {
        Position: {-0.7 * s, 0.1 * s, -0.4 * s}
        Rotation: {seed, seed * 3, 0}
        Scale: {s, 0.6 * s, s}
        IcoSphere: {radius: 0.3, segments: 1}
      }
    }
  }

  template Flowers {
    prop seed: f32 = 0
    const pick = floor(fract(seed * 11.1) * 4)
    const head: Rgb = match pick {
      0: {240, 128, 172}
      1: {250, 210, 76}
      2: {252, 248, 238}
      _: {136, 150, 238}
    }
    const eye: Rgb = match pick { 2: {250, 200, 60}; 1: {150, 90, 40}; _: {255, 236, 150} }
    leaves : MvLeaf {
      Position: {0, 0.08, 0}
      Scale: {1, 0.35, 1}
      Sphere: {radius: 0.38, segments: 8, smooth: true}
    }

    for f in 0..6 {
      const a = seed * 50 + f * 1.26
      const r = 0.12 + fract(a * 3.3) * 0.45
      const ht = 0.26 + fract(a * 1.9) * 0.18
      "stem_{f}" : MvLeaf {
        Position: {sin(a) * r, ht / 2, cos(a) * r}
        Cylinder: {length: ht, radius: 0.018, segments: 4}
      }

      "head_{f}" {
        Position: {sin(a) * r, ht + 0.02, cos(a) * r}
        Rotation: {0.3 * sin(a), a, 0.3 * cos(a)}
        Scale: {1, 0.42, 1}
        Sphere: {radius: 0.09, segments: 7}
        Rgb: head
        PbrMaterial: {roughness: 0.7}
        DiffuseTransmission: {factor: 0.3, color: head}
      }

      "eye_{f}" {
        Position: {sin(a) * r, ht + 0.055, cos(a) * r}
        Sphere: {radius: 0.035, segments: 5}
        Rgb: eye
        PbrMaterial: {roughness: 0.8}
      }
    }
  }

  template Tuft {
    prop seed: f32 = 0

    for b in 0..6 {
      const a = seed * 30 + b * 1.05
      "blade_{b}" : MvGrassDark {
        Position: {sin(a) * 0.13, 0.2, cos(a) * 0.13}
        Rotation: {sin(a) * 0.45, a, cos(a) * 0.45}
        Rgb: {96 + fract(a) * 40, 146 + fract(a * 1.3) * 30, 66}
        Cone: {length: 0.4 + fract(a) * 0.25, radius: 0.06, segments: 3}
      }
    }
  }

  template Reeds {
    prop seed: f32 = 0

    for b in 0..7 {
      const a = seed * 30 + b * 1.1
      const r = 0.1 + fract(a * 2.1) * 0.5
      const ht = 1.2 + fract(a) * 0.6
      "reed_{b}" : MvCrop {
        Position: {sin(a) * r, ht / 2, cos(a) * r}
        Rotation: {sin(a) * 0.15, 0, cos(a) * 0.15}
        Cylinder: {length: ht, radius: 0.025, segments: 4}
        Rgb: {120, 160, 70}
      }

      if b % 2 == 0 {
        "cat_{b}" : MvBark {
          Position: {
            sin(a) * r + sin(a) * 0.15 * ht * 0.5,
            ht - 0.15,
            cos(a) * r + cos(a) * 0.15 * ht * 0.5
          }
          Rotation: {sin(a) * 0.15, 0, cos(a) * 0.15}
          Capsule: {length: 0.2, radius: 0.045, segments: 6, smooth: true}
          Rgb: {120, 76, 44}
        }
      } else {
        "blade_{b}" : MvCrop {
          Position: {sin(a) * r, 0.4, cos(a) * r}
          Rotation: {sin(a + 1) * 0.5, a, cos(a + 1) * 0.5}
          Box: {0.06, 0.8, 0.01}
          Rgb: {104, 150, 70}
        }
      }
    }
  }


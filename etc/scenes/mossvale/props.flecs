    scroll : MvIron {
      Position: {0.18, 2.42, 0}
      Rotation: {HALF_PI, 0, 0}
      TorusShell: {
        radius: 0.18,
        tube: 0.022,
        ring_start: 0,
        ring_end: 4.2,
        tube_start: 0,
        tube_end: 6.283,
        segments: 12,
        rings: 4
      }
    }

    hook : MvIron { Position: {0.55, 2.52, 0}; Box: {0.03, 0.2, 0.03} }
    roof_ : MvIron {
      Position: {0.55, 2.38, 0}
      Rotation: {0, 0.785, 0}
      Cone: {length: 0.22, radius: 0.27, segments: 4}
    }

    if on {
      glass : MvGlow {
        Position: {0.55, 2.13, 0}
        Rotation: {0, 0.785, 0}
        Frustum: {length: 0.36, radius_bottom: 0.13, radius_top: 0.19, segments: 4}
      }

      flame : MvFlame {
        Position: {0.55, 2.1, 0}
        Scale: {1, 1.6, 1}
        Sphere: {radius: 0.05, segments: 6}
      }
    } else {
      glass {
        Position: {0.55, 2.13, 0}
        Rotation: {0, 0.785, 0}
        Frustum: {length: 0.36, radius_bottom: 0.13, radius_top: 0.19, segments: 4}
        Rgb: {70, 76, 70}
        PbrMaterial: {roughness: 0.1}
        ClearCoat: {strength: 1, roughness: 0.05}
      }

      candle : MvPetalWhite {
        Position: {0.55, 2.02, 0}
        Cylinder: {length: 0.14, radius: 0.035, segments: 6}
      }
    }

    for k in 0..4 {
      const a = k * HALF_PI + 0.785
      "rib_{k}" : MvIron {
        Position: {0.55 + cos(a) * 0.16, 2.13, sin(a) * 0.16}
        Rotation: {0, 0 - a, 0}
        Box: {0.03, 0.38, 0.03}
      }
    }

    base_ : MvIron {
      Position: {0.55, 1.93, 0}
      Rotation: {0, 0.785, 0}
      Frustum: {length: 0.06, radius_bottom: 0.12, radius_top: 0.17, segments: 4}
      NoShadow
    }

    finial : MvIron { Position: {0.55, 2.52, 0}; Sphere: {radius: 0.04, segments: 6} }
  }

  template Windmill {
    prop spin: bool = false
    base : MvRubble {
      Position: {0, 0.5, 0}
      Cylinder: {length: 1.0, radius: 3.0, segments: 18}
      texture.Transform: {5, 0.5, 0, 0}
    }

    body : MvPlaster {
      Position: {0, 4.5, 0}
      Frustum: {length: 7.0, radius_bottom: 2.6, radius_top: 1.8, segments: 18}
      texture.Transform: {4, 2, 0, 0}
    }

    for k in 0..6 {
      const a = k * 1.0472 + 0.5
      "rib_{k}" : MvTimber {
        Position: {cos(a) * 2.22, 4.5, sin(a) * 2.22}
        Rotation: {sin(a) * 0.114, 0, 0 - cos(a) * 0.114}
        Box: {0.16, 7.0, 0.16}
      }
    }

    band : MvTimber { Position: {0, 8.0, 0}; Cylinder: {length: 0.3, radius: 1.95, segments: 18} }
    gallery : MvTimber {
      Position: {0, 5.0, 0}
      Tube: {length: 0.12, radius: 3.0, thickness: 0.8, segments: 20}
    }

    for k in 0..12 {
      const a = k * 0.5236
      "baluster_{k}" : MvTimber {
        Position: {cos(a) * 2.9, 5.35, sin(a) * 2.9}
        Box: {0.06, 0.6, 0.06}
      }
    }

    railing : MvTimber {
      Position: {0, 5.65, 0}
      Torus: {radius: 2.9, tube: 0.04, segments: 24, rings: 4}
    }

    cap : MvThatch {
      Position: {0, 8.15, 0}
      Scale: {2.25, 2.4, 2.25}
      Lathe: {profile: MvCapShape, cap_start: true, segments: 18, rings: 8}
      texture.Transform: {6, 1, 0, 0}
    }

    door : MvWood {
      Position: {0, 1.6, 2.5}
      Rotation: {-0.1, 0, HALF_PI}
      Box: {2.0, 1.1, 0.1}
      Rgb: {84, 120, 80}
    }

    door_top : MvWood {
      Position: {0, 2.6, 2.4}
      Rotation: {HALF_PI - 0.1, 0, 0}
      Cylinder: {length: 0.1, radius: 0.55, segments: 12}
      Rgb: {84, 120, 80}
    }

    win : MvWindowLit { Position: {0, 5.9, 2.2}; Rotation: {-0.1, 0, 0}; Box: {0.6, 0.7, 0.08} }
    win_frame : MvTimber { Position: {0, 5.9, 2.17}; Rotation: {-0.1, 0, 0}; Box: {0.8, 0.9, 0.06} }
    win_b : MvWindowLit { Position: {0, 3.3, 2.38}; Rotation: {-0.1, 0, 0}; Box: {0.5, 0.6, 0.08} }
    sails {
      Position: {0, 8.4, 2.2}
      Rotation: {0, 0, 0}

      if spin {
        AngularVelocity: {0, 0, 1.2}
      }

      hub : MvTimber {
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {length: 1.0, radius: 0.4, segments: 10}
      }

      boss : MvIron {
        Position: {0, 0, 0.5}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {length: 0.2, radius: 0.25, segments: 10}
      }

      for b in 0..4 {
        "blade_{b}" {
          Rotation: {0, 0, b * HALF_PI}
          spar : MvTimber { Position: {0, 3.4, 0.2}; Box: {0.2, 6.8, 0.15} }
          cloth : MvCloth {
            Position: {0.65, 4.1, 0.22}
            Box: {1.05, 5.2, 0.03}
            texture.Transform: {2, 6, 0, 0}
          }

          edge : MvTimber { Position: {1.2, 4.1, 0.24}; Box: {0.07, 5.2, 0.07} }

          for r in 0..6 {
            "lath_{r}" : MvTimber { Position: {0.62, 1.6 + r * 1.0, 0.26}; Box: {1.25, 0.05, 0.05} }
          }
        }
      }
    }
  }

  template Pen {
    prop w: f32 = 10
    prop d: f32 = 8
    Fence north(len: w) { Position: {0, 0, -d / 2} }
    Fence south_a(len: w / 2 - 1.2) { Position: {-w / 4 - 0.6, 0, d / 2} }
    Fence south_b(len: w / 2 - 1.2) { Position: {w / 4 + 0.6, 0, d / 2} }
    Fence west(len: d) { Position: {-w / 2, 0, 0}; Rotation: {0, HALF_PI, 0} }
    Fence east(len: d) { Position: {w / 2, 0, 0}; Rotation: {0, HALF_PI, 0} }
  }


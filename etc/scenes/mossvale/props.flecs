      Rotation: {0, 0.785, 0}
      Cone: {length: 0.14, radius: 0.1, segments: 4}
    }
  }

  template Fence {
    prop len: f32 = 4
    const n = max(1, floor(len / 2))

    for i in 0..(n + 1) {
      const sway = (fract(i * 0.73 + len) - 0.5) * 0.08
      "post_{i}" : MvOldWood {
        Position: {-len / 2 + i * len / n, 0.52, 0}
        Rotation: {sway, 0, sway}
        Box: {0.14, 1.04, 0.14}
        Bevel: {radius: 0.02, segments: 1}
        texture.Transform: {0.2, 1, 0, 0}
      }

      "tip_{i}" : MvOldWood {
        Position: {-len / 2 + i * len / n, 1.1, 0}
        Rotation: {0, 0.785, 0}
        Cone: {length: 0.14, radius: 0.1, segments: 4}
      }
    }

    rail_a : MvOldWood {
      Position: {0, 0.78, 0.08}
      Rotation: {0, 0, 0.015}
      Box: {len, 0.1, 0.05}
      Bevel: {radius: 0.015, segments: 1}
      texture.Transform: {len / 2, 0.2, 0, 0}
    }

    rail_b : MvOldWood {
      Position: {0, 0.38, 0.08}
      Rotation: {0, 0, -0.012}
      Box: {len, 0.1, 0.05}
      Bevel: {radius: 0.015, segments: 1}
      texture.Transform: {len / 2, 0.2, 0, 0}
    }
  }


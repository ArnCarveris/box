  template Woodpile {
    for r in 0..3 {
      for c in 0..(4 - r) {
        "log_{r}_{c}" : MvBark {
          Position: {
            (c - (3 - r) / 2.0) * 0.32,
            0.15 + r * 0.27,
            (fract(r * 0.7 + c * 0.37) - 0.5) * 0.16
          }
          Rotation: {HALF_PI, 0, 0}
          Cylinder: {length: 1.4, radius: 0.15, segments: 8}
        }

        "end_{r}_{c}" : MvWood {
          Position: {
            (c - (3 - r) / 2.0) * 0.32,
            0.15 + r * 0.27,
            0.71 + (fract(r * 0.7 + c * 0.37) - 0.5) * 0.16
          }
          Rotation: {HALF_PI, 0, 0}
          Cylinder: {length: 0.01, radius: 0.135, segments: 8}
          Rgb: {214, 170, 116}
        }
      }
    }

    axe_block : MvBark {
      Position: {1.0, 0.25, 0.3}
      Cylinder: {length: 0.5, radius: 0.3, segments: 9}
    }

    axe_top : MvWood {
      Position: {1.0, 0.505, 0.3}
      Cylinder: {length: 0.01, radius: 0.27, segments: 9}
      Rgb: {214, 170, 116}
    }
  }

  template FencePost {
    post : MvOldWood {
      Position: {0, 0.5, 0}
      Box: {0.14, 1.0, 0.14}
      Bevel: {radius: 0.02, segments: 1}
    }

    tip : MvOldWood {

  template Campfire {
    prop on: bool = false

    for i in 0..8 {
      const a = i * 0.785
      "stone_{i}" : MvRock {
        Position: {sin(a) * 0.72, 0.12, cos(a) * 0.72}
        Rotation: {i, i * 2, 0}
        Scale: {1, 0.7, 1}
        IcoSphere: {radius: 0.22, segments: 1}
      }
    }

    log_a : MvBark {
      Position: {0, 0.2, 0}
      Rotation: {0.3, 0.5, HALF_PI}
      Cylinder: {length: 1.1, radius: 0.1, segments: 7}
    }

    log_b : MvBark {
      Position: {0, 0.2, 0}
      Rotation: {0.3, -0.7, HALF_PI}
      Cylinder: {length: 1.1, radius: 0.1, segments: 7}
    }

    log_c : MvBark {
      Position: {0, 0.22, 0}
      Rotation: {-0.3, 1.9, HALF_PI}
      Cylinder: {length: 1.0, radius: 0.09, segments: 7}
    }

    if on {
      flame : MvFlame {
        Position: {0, 0.55, 0}
        Scale: {1, 1, 1}
        Animator: {clip: mv_flicker_tall}
        Cone: {length: 0.8, radius: 0.32, segments: 8}
      }

      flame_b : MvFlame {
        Position: {0.12, 0.45, 0.08}
        Scale: {1, 1, 1}
        Animator: {clip: mv_flicker_tall, time: 0.15}
        Cone: {length: 0.55, radius: 0.18, segments: 7}
        Rgb: {255, 230, 140}
      }

      light { Position: {0, 1.2, 0}; PointLight: {intensity: 6, range: 10}; Rgb: {255, 160, 80} }
      sparks {
        Position: {0, 0.6, 0}
        Emitter: {
          max: 40, rate: 14, shape: EmitterSphere, radius: 0.2,
          direction: {0, 1, 0}, spread: 18, speed: {0.8, 1.8},
          lifetime: {0.5, 1.1}, size: {0.06, 0.14}, opacity: {0.8, 1},
          color: {255, 170, 70}, color_variance: {0, 40, 30}, seed: 5
        }
        Appearance: {blend: Additive}
      }
    } else {
      ash : MvAsh { Position: {0, 0.08, 0}; Cylinder: {length: 0.06, radius: 0.5, segments: 12} }
    }
  }

  template Mushroom {
    prop s: f32 = 1
    stem : MvPetalWhite {
      Position: {0, 0, 0}
      Scale: {0.3 * s, 0.32 * s, 0.3 * s}
      Lathe: {profile: MvTrunkShape, cap_end: true, segments: 8, rings: 5}
      Rgb: {244, 236, 216}
    }

    cap : MvMushroom {
      Position: {0, 0.26 * s, 0}
      Scale: {0.42 * s, 0.5 * s, 0.42 * s}
      Lathe: {profile: MvCapShape, cap_start: true, segments: 12, rings: 6}
      PbrMaterial: {roughness: 0.45}
      ClearCoat: {strength: 0.4, roughness: 0.2}
    }

    for k in 0..5 {
      const a = k * 1.3 + s * 3
      "spot_{k}" : MvPetalWhite {
        Position: {sin(a) * 0.12 * s, (0.36 + fract(a) * 0.05) * s, cos(a) * 0.12 * s}
        Scale: {1, 0.4, 1}
        Sphere: {radius: 0.03 * s, segments: 5}
      }
    }
  }

  template Grave {
    stone : MvStone {
      Position: {0, 0.5, 0}
      Box: {0.6, 1.0, 0.2}
      Bevel: {top_front: 0.25, top_back: 0.25, segments: 2}
    }
  }
}

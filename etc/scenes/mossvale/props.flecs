        Rotation: {k, k * 2, 0}
        IcoSphere: {radius: 0.09, segments: 0}
        Rgb: {140, 200, 255}
        PbrMaterial: {roughness: 0.1}
        Emissive: {strength: 0.8, color: {120, 200, 255}}
      }
    }

    async {
      block_rect(x - 10, z - 7, x + 10, z + 0.2)
      block_rect(x - 1, z + 3, x + 1, z + 5)
    }
  }

  template Dock {
    prop x: f32 = 0
    prop z: f32 = 0
    prop len: f32 = 8
    Position: {x, 0, z}

    for k in 0..floor(len / 0.5) {
      "plank_{k}" : MvWood {
        Position: {-0.25 - k * 0.5, 0.32 + (fract(k * 0.37) - 0.5) * 0.02, 0}
        Rotation: {0, HALF_PI, (fract(k * 0.61) - 0.5) * 0.02}
        Box: {2.4, 0.08, 0.46}
        Rgb: {170 + fract(k * 0.7) * 30, 130, 92}
        texture.Transform: {1.5, 0.2, 0, 0}
      }
    }

    for i in 0..4 {
      "pile_a_{i}" : MvTimber {
        Position: {-i * len / 3, 0.2, 1.15}
        Cylinder: {length: 1.0, radius: 0.16, segments: 8}
      }

      "pile_b_{i}" : MvTimber {
        Position: {-i * len / 3, 0.2, -1.15}
        Cylinder: {length: 1.0, radius: 0.16, segments: 8}
      }
    }

    bollard : MvTimber {
      Position: {-len + 0.3, 0.55, 0.9}
      Cylinder: {length: 0.4, radius: 0.12, segments: 8}
    }

    coil : MvHay {
      Position: {-len + 0.8, 0.4, 0.7}
      Torus: {radius: 0.18, tube: 0.05, segments: 12, rings: 4}
      Rgb: {200, 170, 120}
    }

    lamp_post : MvTimber { Position: {-len + 0.3, 1.2, -1.0}; Box: {0.12, 1.8, 0.12} }
    lamp : MvGlow { Position: {-len + 0.3, 2.0, -0.85}; Sphere: {radius: 0.12, segments: 8} }
    async { unblock_rect(x - len, z - 1.2, x + 0.5, z + 1.2) }
  }


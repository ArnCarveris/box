  template Stall {
    prop x: f32 = 0
    prop z: f32 = 0
    prop cloth: i32 = 0
    prop rot: f32 = 0
    const cc: Rgb = match cloth { 0: {196, 62, 54}; 1: {70, 100, 176}; _: {236, 190, 70} }
    Position: {x, 0, z}
    Rotation: {0, rot, 0}
    counter : MvWood {
      Position: {0, 0.5, 0.1}
      Box: {2.8, 1.0, 1.0}
      Bevel: {radius: 0.03, segments: 1}
      texture.Transform: {2, 1, 0, 0}
    }

    top_ : MvOldWood {
      Position: {0, 1.03, 0.15}
      Box: {3.0, 0.08, 1.2}
      Bevel: {radius: 0.02, segments: 1}
      texture.Transform: {2, 1, 0, 0}
    }

    skirt {
      Position: {0, 0.62, 0.62}
      Box: {2.8, 0.5, 0.03}
      Rgb: cc
      PbrMaterial: {roughness: 0.9}
      PbrTextures: {albedo: mv_tex_cloth, normal: mv_tex_cloth_n}
    }

    for p in 0..4 {
      const sx = match p % 2 { 0: -1.35; _: 1.35 }
      const sz = p < 2 ? -0.55 : 0.55
      "pole_{p}" : MvTimber {
        Position: {sx, 1.3 + (p < 2 ? 0.25 : 0), sz}
        Box: {0.1, 2.6 + (p < 2 ? 0.5 : 0), 0.1}
        Bevel: {radius: 0.02, segments: 1}
      }
    }

    for s in 0..7 {
      const stripe: Rgb = match s % 2 { 0: cc; _: {246, 238, 220} }
      "awning_{s}" {
        Position: {-1.35 + s * 0.45, 2.85, 0.05}
        Rotation: {0.32, 0, 0}
        Box: {0.45, 0.05, 1.75}
        Rgb: stripe
        PbrMaterial: {roughness: 0.9}
        PbrTextures: {albedo: mv_tex_cloth, normal: mv_tex_cloth_n}
      }

      "flap_{s}" {
        Position: {-1.35 + s * 0.45, 2.42, 0.94}
        Scale: {1, 1, 0.3}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {length: 0.05, radius: 0.225, segments: 10}
        Rgb: stripe
        PbrMaterial: {roughness: 0.9}
      }
    }

    basket_a : MvHay {
      Position: {-0.85, 1.17, 0.15}
      Frustum: {length: 0.22, radius_bottom: 0.25, radius_top: 0.32, segments: 12}
      Rgb: {190, 150, 90}
    }

    for i in 0..5 {
      const a = i * 1.26
      "apple_{i}" {
        Position: {-0.85 + sin(a) * 0.15, 1.3 + fract(a) * 0.06, 0.15 + cos(a) * 0.15}
        Sphere: {radius: 0.09, segments: 8, smooth: true}
        Rgb: match i % 2 { 0: {200, 46, 40}; _: {176, 200, 70} }
        PbrMaterial: {roughness: 0.35}
      }
    }

    goods_a : MvPumpkin {
      Position: {-0.15, 1.24, 0.25}
      Scale: {1, 0.75, 1}
      Sphere: {radius: 0.2, segments: 10, smooth: true}
    }

    goods_a_stem : MvTimber {
      Position: {-0.15, 1.4, 0.25}
      Cylinder: {length: 0.08, radius: 0.025, segments: 5}
      Rgb: {80, 100, 50}
    }

    goods_b : MvCabbage {
      Position: {0.3, 1.22, 0.3}
      Sphere: {radius: 0.16, segments: 10, smooth: true}
    }

    goods_c : MvWheat {
      Position: {0.85, 1.14, -0.05}
      Rotation: {0, 0.3, HALF_PI}
      Cylinder: {length: 0.5, radius: 0.09, segments: 8}
      Rgb: {214, 156, 82}
    }

    goods_d : MvWheat {
      Position: {0.9, 1.14, 0.25}
      Rotation: {0, -0.2, HALF_PI}
      Cylinder: {length: 0.45, radius: 0.08, segments: 8}
      Rgb: {200, 140, 70}
    }

    jar : MvGlass {
      Position: {0.45, 1.2, -0.25}
      Cylinder: {length: 0.28, radius: 0.1, segments: 10}
      Rgb: {220, 150, 40}
      PbrMaterial: {roughness: 0.1}
      ClearCoat: {strength: 1, roughness: 0.05}
    }

    sign_ : MvWood {
      Position: {0, 2.25, 0.62}
      Box: {1.0, 0.3, 0.05}
      Bevel: {radius: 0.03, segments: 1}
      Rgb: {236, 220, 180}
    }

    Crate box_a(s: 0.5) { Position: {1.75, 0, -0.2}; Rotation: {0, 0.3, 0} }
    Barrel barrel_a { Position: {-1.8, 0, -0.3}; Scale: {0.8, 0.8, 0.8} }

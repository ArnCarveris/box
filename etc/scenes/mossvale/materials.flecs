using flecs.script
using box.material
using box.text

mv_font_display { Font: {path: "etc/scenes/mossvale/fonts/Cinzel.ttf"} }
mv_font_body { Font: {path: "etc/scenes/mossvale/fonts/Spectral-Regular.ttf"} }


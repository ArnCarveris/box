  export mut clock: f64 = 0
  export mut dt: f32 = 0.016

  export mut px: f32 = -10.6
  export mut pz: f32 = 14.6
  export mut pyaw: f32 = 3.14159
  export mut moving = false
  export mut sprinting = false
  export mut walk_phase: f32 = 0
  export mut cast_anim: f32 = 0

  export mut cam_x: f32 = -4
  export mut cam_z: f32 = 11
  export mut cam_dist: f32 = 30
  export mut cam_pitch: f32 = 1.02

  export mut aim_x: f32 = 0
  export mut aim_z: f32 = 0
  export mut aim_on = false

  export mut spell: i32 = 1
  export mut known: bool[] = MV_SPELLS.map((s) -> { false })
  export mut mana: f32 = 100
  export mut mana_max: f32 = 100

  export mut orb_on = false
  export mut orb_spell: i32 = 1
  export mut orb_x: f32 = 0
  export mut orb_y: f32 = 0
  export mut orb_z: f32 = 0

  export mut qs: i32[] = MV_QUESTS.map((q) -> { QS_LOCKED })
  export mut qp: i32[] = MV_QUESTS.map((q) -> { 0 })
  export mut done_count: i32 = 0
  export mut ts: i32[TARGETS] = {}
  export mut t_x: f32[TARGETS] = {}
  export mut t_z: f32[TARGETS] = {}
  export mut t_sp: i32[TARGETS] = {}
  export mut t_q: i32[TARGETS] = {}
  export mut t_lv: i32[TARGETS] = {}
  export mut t_req: i32[TARGETS] = {}
  export mut t_on: bool[TARGETS] = {}
  export mut delivered: bool[] = MV_NPCS.map((n) -> { false })

  export mut npc_mark: i32[] = MV_NPCS.map((n) -> { 0 })
  export mut near_npc: i32 = -1
  export mut talk_npc: i32 = -1
  export mut talk_topic: i32 = 0
  export mut talk_line: i32 = 0

  export mut mote_got: bool[] = MV_WISPS.map((w) -> { false })
  export mut obj_on = false
  export mut obj_x: f32 = 0
  export mut obj_z: f32 = 0
  export mut obj_q: i32 = -1
  export mut obj_npc = false
  export mut motes: i32 = 0

  export mut blocked: bool[GRID_N * GRID_N] = {}

  export mut hour: f32 = 8.5
  export mut hour_goal: f32 = 8.5

  export mut toast: string = ""
  export mut toast_until: f64 = 0
  export mut banner: string = ""
  export mut banner_sub: string = ""
  export mut banner_until: f64 = 0

  export const TRACK_ROWS: i32 = 4
  export mut track_t: string[TRACK_ROWS] = {}
  export mut track_s: string[TRACK_ROWS] = {}
  export mut track_n: i32 = 0

  fn block_rect(x0: f32, z0: f32, x1: f32, z1: f32) {
    for z in floor(z0)..ceil(z1) {
      for x in floor(x0)..ceil(x1) {
        if x >= -GRID_HALF && x < GRID_HALF && z >= -GRID_HALF && z < GRID_HALF {
          blocked[(z + GRID_HALF) * GRID_N + x + GRID_HALF] = true
        }
      }
    }
  }

  fn unblock_rect(x0: f32, z0: f32, x1: f32, z1: f32) {
    for z in floor(z0)..ceil(z1) {
      for x in floor(x0)..ceil(x1) {
        if x >= -GRID_HALF && x < GRID_HALF && z >= -GRID_HALF && z < GRID_HALF {
          blocked[(z + GRID_HALF) * GRID_N + x + GRID_HALF] = false
        }
      }
    }
  }

  fn block_disc(cx: f32, cz: f32, r: f32) {
    for z in floor(cz - r)..ceil(cz + r) {
      for x in floor(cx - r)..ceil(cx + r) {
        if (x + 0.5 - cx) * (x + 0.5 - cx) + (z + 0.5 - cz) * (z + 0.5 - cz) <= r * r {
          if x >= -GRID_HALF && x < GRID_HALF && z >= -GRID_HALF && z < GRID_HALF {
            blocked[(z + GRID_HALF) * GRID_N + x + GRID_HALF] = true
          }
        }
      }
    }
  }

  fn say(text: string) {
    toast = text
    toast_until = clock + 4.5
  }

  fn announce(title: string, sub: string) {
    banner = title
    banner_sub = sub
    banner_until = clock + 4.5
  }
}

using flecs.script
using flecs.script.math
using box.transform
using box.transition
using box.light
using box.geometry
using box.material

template QuestMark {
  prop kind: i32 = 0
  mut up = false
  Position: {0, match up { true: 3.35; _: 3.1 }, 0}
  Rotation: {-0.55, 0, 0}
  Scale: {1.6, 1.6, 1.6}
  Transition: [Position: {duration: 0.7, timing_function: EaseInOut}]
  if kind == 1 {
    bar : MvGold { Position: {0, 0.35, 0}; Capsule: {length: 0.35, radius: 0.11, segments: 8}; Emissive: {strength: 1.2, color: {255, 200, 80}} }
    dot : MvGold { Position: {0, -0.12, 0}; Sphere: {radius: 0.12, segments: 8}; Emissive: {strength: 1.2, color: {255, 200, 80}} }
  } else if kind == 2 {
    hook { Position: {0, 0.42, 0}; Rotation: {HALF_PI, 0, 0}; Torus: {radius: 0.2, tube: 0.08, segments: 16, rings: 6}; Rgb: {120, 200, 255}; Emissive: {strength: 1.5, color: {120, 200, 255}} }
    stem { Position: {0, 0.12, 0}; Capsule: {length: 0.08, radius: 0.08, segments: 8}; Rgb: {120, 200, 255}; Emissive: {strength: 1.5, color: {120, 200, 255}} }
    dot { Position: {0, -0.15, 0}; Sphere: {radius: 0.1, segments: 8}; Rgb: {120, 200, 255}; Emissive: {strength: 1.5, color: {120, 200, 255}} }
  }
  async {
    while true {
      up = !up
      await delay(0.7)
    }
  }
}

template Npc {
  prop id: i32 = 0
  prop x: f32 = 0
  prop z: f32 = 0
  prop face: f32 = 0

  mut yaw: f32 = 0
  mut nod = false
  mut breath = false

  const kid = id == N_TAM
  const sc = match kid { true: 0.68; _: 1.0 }
  const outfit: Rgb = match id {
    0: {70, 104, 70}
    1: {176, 60, 52}
    2: {96, 140, 84}
    3: {96, 70, 52}
    4: {196, 96, 120}
    5: {70, 110, 190}
    6: {120, 92, 60}
    7: {120, 80, 140}
    8: {170, 50, 46}
    9: {130, 128, 120}
    10: {220, 186, 60}
    11: {70, 66, 70}
    _: {80, 120, 180}
  }
  const hair: Rgb = match id {
    0: {236, 232, 224}
    1: {120, 70, 40}
    2: {90, 50, 30}
    3: {40, 30, 26}
    4: {226, 190, 110}
    5: {170, 100, 50}
    6: {130, 100, 70}
    7: {200, 200, 206}
    8: {150, 80, 40}
    9: {210, 210, 214}
    10: {190, 190, 190}
    11: {70, 60, 56}
    _: {190, 140, 80}
  }
  const skin = match id { 3: 2; 6: 1; 8: 1; 11: 1; 12: 1; _: 0 }
  const hat = match id { 1: 4; 5: 3; 6: 1; 7: 4; 8: 3; 9: 2; 10: 6; 11: 5; 12: 1; _: 0 }
  const beard = id == 0 || id == 3 || id == 6 || id == 8 || id == 9 || id == 10 || id == 11
  const apron = id == 1 || id == 3 || id == 4
  const dress = id == 1 || id == 2 || id == 4 || id == 7 || id == 12

  Position: {x, 0, z}
  Rotation: {0, yaw, 0}
  Transition: [Rotation: {duration: 0.45, timing_function: EaseOut}]

  body {
    Scale: {sc, sc * match breath { true: 1.025; _: 1 }, sc}
    Transition: [Scale: {duration: 1.1, timing_function: EaseInOut}]
    leg_a : MvDark { Position: {-0.16, 0.4, 0}; Box: {0.2, 0.8, 0.22} }
    leg_b : MvDark { Position: {0.16, 0.4, 0}; Box: {0.2, 0.8, 0.22} }
    if dress {
      skirt { Position: {0, 0.55, 0}; Frustum: {length: 1.0, radius_bottom: 0.48, radius_top: 0.3, segments: 10}; Rgb: outfit; PbrMaterial: {roughness: 0.95} }
    }
    torso { Position: {0, 1.25, 0}; Frustum: {length: 0.75, radius_bottom: 0.34, radius_top: 0.28, segments: 10}; Rgb: outfit; PbrMaterial: {roughness: 0.95} }
    if apron {
      apron_ : MvCloth { Position: {0, 0.95, 0.3}; Box: {0.55, 1.0, 0.05} }
    }
    belt : MvTimber { Position: {0, 0.95, 0}; Cylinder: {length: 0.1, radius: 0.33, segments: 10} }
    arm_a {
      Position: {-0.38, 1.3, 0}
      Rotation: {match nod { true: -0.5; _: 0 }, 0, 0.15}
      Transition: [Rotation: {duration: 0.3}]
      sleeve { Position: {0, -0.25, 0}; Box: {0.17, 0.6, 0.18}; Rgb: outfit; PbrMaterial: {roughness: 0.95} }
      if skin == 0 {
        hand : MvSkin { Position: {0, -0.6, 0}; Sphere: {radius: 0.1, segments: 8} }
      } else if skin == 1 {
        hand : MvSkinTan { Position: {0, -0.6, 0}; Sphere: {radius: 0.1, segments: 8} }
      } else {
        hand : MvSkinDark { Position: {0, -0.6, 0}; Sphere: {radius: 0.1, segments: 8} }
      }
    }
    arm_b {
      Position: {0.38, 1.3, 0}
      Rotation: {0, 0, -0.15}
      sleeve { Position: {0, -0.25, 0}; Box: {0.17, 0.6, 0.18}; Rgb: outfit; PbrMaterial: {roughness: 0.95} }
      if skin == 0 {
        hand : MvSkin { Position: {0, -0.6, 0}; Sphere: {radius: 0.1, segments: 8} }
      } else if skin == 1 {
        hand : MvSkinTan { Position: {0, -0.6, 0}; Sphere: {radius: 0.1, segments: 8} }
      } else {
        hand : MvSkinDark { Position: {0, -0.6, 0}; Sphere: {radius: 0.1, segments: 8} }
      }
    }
    head {
      Position: {0, 1.92, 0}
      Rotation: {match nod { true: 0.12; _: -0.04 }, 0, match nod { true: 0.06; _: 0 }}
      Transition: [Rotation: {duration: 0.3}]
      if skin == 0 {
        face_ : MvSkin { Position: {0, 0, 0}; Sphere: {radius: 0.3, segments: 14, smooth: true} }
        nose : MvSkin { Position: {0, -0.02, 0.29}; Sphere: {radius: 0.06, segments: 6} }
      } else if skin == 1 {
        face_ : MvSkinTan { Position: {0, 0, 0}; Sphere: {radius: 0.3, segments: 14, smooth: true} }
        nose : MvSkinTan { Position: {0, -0.02, 0.29}; Sphere: {radius: 0.06, segments: 6} }
      } else {
        face_ : MvSkinDark { Position: {0, 0, 0}; Sphere: {radius: 0.3, segments: 14, smooth: true} }
        nose : MvSkinDark { Position: {0, -0.02, 0.29}; Sphere: {radius: 0.06, segments: 6} }
      }
      eye_a : MvDark { Position: {-0.1, 0.05, 0.26}; Sphere: {radius: 0.04, segments: 6} }
      eye_b : MvDark { Position: {0.1, 0.05, 0.26}; Sphere: {radius: 0.04, segments: 6} }
      if id != 0 && id != 3 {
        hair_ { Position: {0, 0.06, -0.04}; HemiSphere: {radius: 0.32, segments: 12}; Rgb: hair; PbrMaterial: {roughness: 1} }
      }
      if beard {
        beard_ { Position: {0, -0.22, 0.14}; Scale: {1, 1.3, 0.8}; Sphere: {radius: 0.2, segments: 10}; Rgb: hair; PbrMaterial: {roughness: 1} }
      }
      if hat == 1 {
        brim : MvHay { Position: {0, 0.2, 0}; Cylinder: {length: 0.05, radius: 0.6, segments: 14} }
        crown : MvHay { Position: {0, 0.36, 0}; Frustum: {length: 0.3, radius_bottom: 0.3, radius_top: 0.24, segments: 12} }
      } else if hat == 2 {
        hood { Position: {0, 0.05, -0.03}; Scale: {1.1, 1.15, 1.1}; HemiSphere: {radius: 0.36, segments: 12}; Rgb: outfit; PbrMaterial: {roughness: 1} }
      } else if hat == 3 {
        cap { Position: {0, 0.22, 0}; Scale: {1, 0.5, 1}; Sphere: {radius: 0.32, segments: 12}; Rgb: {60, 60, 70}; PbrMaterial: {roughness: 1} }
        visor { Position: {0, 0.2, 0.3}; Box: {0.4, 0.04, 0.2}; Rgb: {60, 60, 70}; PbrMaterial: {roughness: 1} }
      } else if hat == 4 {
        scarf : MvCloth { Position: {0, 0.12, -0.03}; Scale: {1.05, 0.9, 1.05}; HemiSphere: {radius: 0.34, segments: 12} }
      } else if hat == 5 {
        helmet : MvBrass { Position: {0, 0.12, 0}; HemiSphere: {radius: 0.36, segments: 12} }
        lamp : MvGlow { Position: {0, 0.28, 0.3}; Cylinder: {length: 0.1, radius: 0.08, segments: 8}; Rotation: {HALF_PI, 0, 0} }
      } else if hat == 6 {
        brim : MvClothYellow { Position: {0, 0.18, 0}; Rotation: {-0.15, 0, 0}; Cylinder: {length: 0.05, radius: 0.5, segments: 14} }
        crown : MvClothYellow { Position: {0, 0.3, 0}; HemiSphere: {radius: 0.3, segments: 12} }
      }
    }
    if id == 0 || id == 9 {
      cane : MvTimber { Position: {0.52, 0.9, 0.15}; Box: {0.08, 1.8, 0.08} }
    }
    if id == 12 {
      crook : MvTimber { Position: {0.52, 1.1, 0.15}; Box: {0.08, 2.2, 0.08} }
      crook_top : MvTimber { Position: {0.42, 2.2, 0.15}; Rotation: {0, 0, HALF_PI}; Torus: {radius: 0.15, tube: 0.04, segments: 10, rings: 4} }
    }
  }

  if npc_mark[id] == 1 {
    QuestMark mark(kind: 1)
  } else if npc_mark[id] == 2 {
    QuestMark mark(kind: 2)
  }

  async {
    await delay(fract(id * 0.37) * 1.2)
    while true {
      breath = !breath
      await delay(1.2)
    }
  }

  async {
    npc_x[id] = x
    npc_z[id] = z
    yaw = face
    block_disc(x, z, 0.55)
    while true {
      await delay(0.25)
      const d = dist2(px, pz, x, z)
      if talk_npc == id {
        nod = !nod
      } else {
        nod = false
      }
      if d < 7 * 7 {
        yaw = atan2(px - x, pz - z)
      } else {
        yaw = face
      }
    }
  }
}

template Villager {
  prop seed: f32 = 0
  prop x0: f32 = 0
  prop z0: f32 = 0
  prop x1: f32 = 0
  prop z1: f32 = 0
  prop period: f32 = 10

  mut back = false
  mut step = false

  const yaw = atan2(x1 - x0, z1 - z0)
  const outfit: Rgb = match floor(fract(seed * 7.7) * 5) {
    0: {150, 70, 60}
    1: {80, 120, 80}
    2: {80, 100, 160}
    3: {170, 140, 90}
    _: {120, 90, 130}
  }

  Position: match back { true: {x0, 0, z0}; _: {x1, 0, z1} }
  Rotation: {0, match back { true: yaw + PI; _: yaw }, 0}
  Transition: [Position: {duration: period}]

  bob {
    Position: {0, match step { true: 0.08; _: 0 }, 0}
    Transition: [Position: {duration: 0.25}]
    leg_a : MvDark { Position: {-0.15, 0.4, 0}; Box: {0.18, 0.8, 0.2} }
    leg_b : MvDark { Position: {0.15, 0.4, 0}; Box: {0.18, 0.8, 0.2} }
    torso { Position: {0, 1.2, 0}; Frustum: {length: 0.8, radius_bottom: 0.32, radius_top: 0.26, segments: 10}; Rgb: outfit; PbrMaterial: {roughness: 0.95} }
    head : MvSkin { Position: {0, 1.85, 0}; Sphere: {radius: 0.27, segments: 12, smooth: true} }
    hair_ { Position: {0, 1.92, -0.03}; HemiSphere: {radius: 0.29, segments: 10}; Rgb: {100, 70, 40}; PbrMaterial: {roughness: 1} }
  }

  async {
    await delay(fract(seed * 3.1) * 2 + 0.1)
    while true {
      back = !back
      await delay(period)
    }
  }

  async {
    while true {
      step = !step
      await delay(0.25)
    }
  }
}

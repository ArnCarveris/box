  prefab MoteBurst {
    glints {
      Position: {0, 0, 0}
      box.particle.Emitter: {
        max: 60,
        rate: 0,
        shape: EmitterSphere,
        radius: 0.3,
        direction: {0, 1, 0},
        spread: 180,
        speed: {1.5, 3.5},
        lifetime: {0.6, 1.2},
        size: {0.08, 0.14},
        opacity: {1, 1},
        color: {170, 230, 255},
        seed: 17
      }
      Appearance: {blend: Additive}
      Burst: {count: 50}
      Forces: {drag: 2}
    }
  }

  prefab Firework {
    sparks {
      Position: {0, 0, 0}
      box.particle.Emitter: {
        max: 180, rate: 0, shape: EmitterSphere, radius: 0.1,
        direction: {0, 0, 0}, radial: {6, 9},
        lifetime: {1.4, 2.2}, size: {0.18, 0.3}, opacity: {1, 1},
        color: {255, 200, 90}, color_variance: {0, 60, 120}, seed: 23
      }
      Appearance: {blend: Additive, stretch: 0.05}
      Burst: {count: 160}
      Forces: {gravity: {0, -3, 0}, drag: 1.1}
      Curves: {
        opacity: {keys: [{0, 1}, {0.6, 0.8}, {1, 0}]},
        color: {
          keys: [
            {0, {255, 255, 255}},
            {0.3, {255, 220, 160}},
            {0.7, {255, 120, 160}},
            {1, {120, 90, 255}}
          ]
        }
      }
    }
  }
}

state {
  fn impact_y(s: i32) -> f32 {
    match s { 6: 0.3; 3: 0.8; _: 0.7 }
  }

  export mut sfx_on: bool[] = MV_SPELLS.map((s) -> { false })
  export mut sfx_x: f32[] = MV_SPELLS.map((s) -> { 0 })
  export mut sfx_z: f32[] = MV_SPELLS.map((s) -> { 0 })
  export mut sfx_until: f64[] = MV_SPELLS.map((s) -> { 0 })
}

mossvale {
  mv_spell_sounds {
    crackles {
      if sfx_on[SP_SPARK] {
        Position: {sfx_x[SP_SPARK], 0.7, sfx_z[SP_SPARK]}
        box.audio.Emitter: {
          sound: assets.SfxFireCrackle,
          interval_min: 0.02,
          interval_max: 0.14,
          shape: EmitterSphere,
          radius: 0.8,
          volume_min: 0.25,
          volume_max: 1,
          pitch_min: 0.6,
          pitch_max: 1.6
        }
      }
    }

    raindrops {
      if sfx_on[SP_SPLASH] {
        Position: {sfx_x[SP_SPLASH], 0.7, sfx_z[SP_SPLASH]}
        box.audio.Emitter: {
          sound: assets.SfxRainDrop,
          interval_min: 0.012,
          interval_max: 0.06,
          shape: EmitterDisc,
          radius: 2.5,
          volume_min: 0.2,
          volume_max: 0.9,
          pitch_min: 0.7,
          pitch_max: 1.4
        }
      }
    }

    branches {
      if sfx_on[SP_BLOOM] {
        Position: {sfx_x[SP_BLOOM], 0.7, sfx_z[SP_BLOOM]}
        box.audio.Emitter: {
          sound: assets.SfxWoodCrack,
          interval_min: 0.06,
          interval_max: 0.25,
          shape: EmitterSphere,
          radius: 1,
          volume_min: 0.25,
          volume_max: 0.7,
          pitch_min: 0.7,
          pitch_max: 1.3
        }
      }
    }

    ice {
      if sfx_on[SP_FROST] {
        Position: {sfx_x[SP_FROST], 0.7, sfx_z[SP_FROST]}
        box.audio.Emitter: {
          sound: assets.SfxIceCrack,
          interval_min: 0.03,
          interval_max: 0.12,
          shape: EmitterSphere,
          radius: 1.2,
          volume_min: 0.25,
          volume_max: 0.8,
          pitch_min: 0.7,
          pitch_max: 1.4
        }
      }
    }

    glints {
      if sfx_on[SP_LIFT] {
        Position: {sfx_x[SP_LIFT], 1.2, sfx_z[SP_LIFT]}
        box.audio.Emitter: {
          sound: assets.SfxLiftGlint,
          interval_min: 0.06,
          interval_max: 0.2,
          shape: EmitterHemisphere,
          radius: 1.2,
          volume_min: 0.3,
          volume_max: 0.8,
          pitch_min: 0.75,
          pitch_max: 1.5
        }
      }
    }
  }
}

async {
  while true {
    const e = await Impact
    const y = impact_y(e.spell)

    if e.spell == SP_SPARK {
      const b = box.particle.burst_at(SparkBurst, {e.x, y, e.z}, 1)
      const a = box.audio.play_at(SfxFireWhoomp, {e.x, y, e.z}, 0.9)
      const c = box.audio.play_at(SfxFireBed, {e.x, y, e.z}, 0.8)
    } else if e.spell == SP_SPLASH {
      const b = box.particle.burst_at(SplashBurst, {e.x, y, e.z}, 1)
      const a = box.audio.play_at(SfxSplash, {e.x, y, e.z}, 0.7)
      const c = box.audio.play_at(SfxRainHiss, {e.x, y, e.z}, 0.8)
    } else if e.spell == SP_GUST {
      const b = box.particle.burst_at(GustBurst, {e.x, y, e.z}, 1)
      const a = box.audio.play_at(SfxGust, {e.x, y, e.z}, 0.9)
    } else if e.spell == SP_BLOOM {
      const b = box.particle.burst_at(BloomBurst, {e.x, y, e.z}, 1)
      const a = box.audio.play_at(SfxWoodCrack, {e.x, y, e.z}, 0.75)
      const d = box.audio.play_at(SfxWoodSplinter, {e.x, y, e.z}, 0.7)
    } else if e.spell == SP_FROST {
      const b = box.particle.burst_at(FrostBurst, {e.x, y, e.z}, 1)
      const a = box.audio.play_at(SfxFrost, {e.x, y, e.z}, 0.8)
    } else if e.spell == SP_LIFT {
      const b = box.particle.burst_at(LiftBurst, {e.x, y, e.z}, 1)
      const a = box.audio.play_at(SfxLift, {e.x, y, e.z}, 0.8)
    }

    if e.spell != SP_GUST {
      sfx_x[e.spell] = e.x
      sfx_z[e.spell] = e.z
      sfx_until[e.spell] = clock + (e.spell == SP_BLOOM ? 1.0 : 0.8)
      sfx_on[e.spell] = true
    }
  }
}

async {
  while true {
    await next_frame()

    for s in 1..MV_SPELLS.count() {
      if sfx_on[s] && clock > sfx_until[s] {
        sfx_on[s] = false
      }
    }
  }
}

async {
  while true {
    const e = await CastStart

    if e.spell == SP_SPARK {
      const a = box.audio.play(SfxCastFire, 0.5)
    } else if e.spell == SP_SPLASH {
      const a = box.audio.play(SfxCastWater, 0.5)
    } else if e.spell == SP_GUST {
      const a = box.audio.play(SfxCastWind, 0.5)
    } else if e.spell == SP_BLOOM {
      const a = box.audio.play(SfxCastWood, 0.5)
    } else if e.spell == SP_FROST {
      const a = box.audio.play(SfxCastFrost, 0.5)
    } else if e.spell == SP_LIFT {
      const a = box.audio.play(SfxCastLift, 0.5)
    }
  }
}

async {
  while true {
    const e = await Fizzle
    const b = box.particle.burst_at(FizzleBurst, {e.x, 2.4, e.z}, 1)
    const a = box.audio.play(SfxFizzle, 0.6)
  }
}


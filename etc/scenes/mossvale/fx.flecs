using flecs.script
using flecs.script.math
using box.audio
using box.audio.synth
using box.particle
using box.transform
using state
using assets

assets {
  mv_hall {
    Bus: {output: master, kind: ChannelReturn, effects: [mv_hall]}
    Reverb: {decay: 1.4, damping: 0.5, predelay: 0.02, size: 0.6}
  }

  mv_sfx {
    Bus: {output: master, kind: ChannelSfx, volume: 0.85, sends: [{bus: mv_hall, level: 0.18}]}
  }

  mv_spell {
    Bus: {output: master, kind: ChannelSfx, volume: 0.64, sends: [{bus: mv_hall, level: 0.18}]}
  }

  mv_ui { Bus: {output: master, kind: ChannelSfx, volume: 0.6} }
  mv_music { Bus: {output: master, volume: 0.42, sends: [{bus: mv_hall, level: 0.3}]} }
}

$ {
  box.particle.Settings: {effect_max: 24, effect_total: 96, effect_overflow: EffectRecycle}
}


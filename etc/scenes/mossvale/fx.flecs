mossvale {
  mv_water_sounds {
    for i in 0..9 {
      const zz = -88 + i * 22
      "river_{i}" {
        Position: {river_x(zz), 0.5, zz}
        Source: {sound: assets.SfxWater, loop: true, volume: 0.5}
        Spatial: {min_distance: 4, max_distance: 22}
      }
    }

    lake_a {
      Position: {LAKE_X + 8, 0.5, LAKE_Z + 6}
      Source: {sound: assets.SfxWater, loop: true, volume: 0.3}
      Spatial: {min_distance: 8, max_distance: 30}
    }

    wind {
      Source: {sound: assets.SfxWind, loop: true, volume: 0.6}
    }
  }
}

async {
  mut last_step: i32 = 0

  while true {
    await next_frame()

    if moving {
      const k = floor(walk_phase / PI)

      if k != last_step {
        last_step = k
        const a = box.audio.play(assets.SfxStep, sprinting ? 0.55 : 0.4)
      }
    }
  }
}

async {
  while true {
    await delay(1.2 + hash(clock * 3.7) * 3.5)

    if game_state >= 1 {
      const night = hour > 19 || hour < 6
      const ox = (hash(clock * 1.3) - 0.5) * 24
      const oz = (hash(clock * 2.1) - 0.5) * 16

      if night {
        for i in 0..3 {
          const c = box.audio.play_at(assets.SfxCricket, {px + ox, 0.3, pz + oz}, 0.5)
          await delay(0.06)
        }
      } else if pz > WALL_N1 + 2 || hash(clock) > 0.5 {
        if hash(clock * 5.1) > 0.45 {
          const n = 2 + floor(hash(clock * 7.7) * 3)

          for i in 0..n {
            const c = box.audio.play_at(assets.SfxBirdA, {px + ox, 3, pz + oz}, 0.6)
            await delay(0.11 + hash(i + clock) * 0.06)
          }
        } else {
          const c = box.audio.play_at(assets.SfxBirdB, {px + ox, 3, pz + oz}, 0.5)
          await delay(0.3)
          const d = box.audio.play_at(assets.SfxBirdB, {px + ox, 3, pz + oz}, 0.4)
        }
      }
    }
  }
}

async {
  while true {
    await PickSpell
    const a = box.audio.play(assets.SfxSelect, 0.5)
  }
}

using flecs.script
using flecs.script.math
using box.transform
using box.material
using box.light
using box.effects
using box.atmosphere
using state
using assets

state {
  export const LATITUDE: f32 = 16
  export const NORTH: f32 = 228

  export const CLOUD_SIZE: f32 = 5000
  export const CLOUD_ALTITUDE: f32 = 1400

  fn forest_cloud_threshold(season: f64, p: f64) -> f64 {
    forest_seasonal(season, 0.62, 0.64, 0.6, 0.6) - 0.34 * p
  }

  fn forest_cloud_drift_x(w: f64) -> f64 {
    w * 2.6 * WIND_DIR_X
  }

  fn forest_cloud_drift_z(w: f64) -> f64 {
    w * 2.6 * WIND_DIR_Z
  }

  export mut cloud_velocity_x: f32 = forest_cloud_drift_x(START_WIND)
  export mut cloud_velocity_z: f32 = forest_cloud_drift_z(START_WIND)

  fn forest_sun_declination(season: f64) -> f64 {
    23.44 * sin(forest_season_wrap(season) * PI / 2)
  }

  fn forest_sun_elevation(season: f64, hour: f64) -> f64 {
    const d = forest_sun_declination(season) * PI / 180
    const l = LATITUDE * PI / 180
    const h = (hour - 12) * PI / 12
    asin(sin(l) * sin(d) + cos(l) * cos(d) * cos(h)) * 180 / PI
  }

  fn forest_sunrise(season: f64) -> f64 {
    const d = forest_sun_declination(season) * PI / 180
    const l = LATITUDE * PI / 180
    12 - acos(clamp(0 - tan(l) * tan(d), -1, 1)) * 12 / PI
  }

  fn forest_sunset(season: f64) -> f64 {
    24 - forest_sunrise(season)
  }

  fn forest_beam(season: f64, hour: f64) -> f64 {
    const e = forest_sun_elevation(season, hour)
    forest_smooth(-1, 4, e) * (0.12 + 0.88 * (1 - forest_smooth(14, 44, e)))
  }

  fn forest_daylight(season: f64, hour: f64) -> f64 {
    forest_smooth(-6, 3, forest_sun_elevation(season, hour))
  }

  fn forest_haze(season: f64, hour: f64) -> f64 {
    0.6 + 0.4 * (1 - forest_smooth(12, 40, forest_sun_elevation(season, hour)))
  }
}

sun {
  DirectionalLight: {intensity: 3.1 * PI * (1 - 0.94 * min(1, precipitation * 1.6))}
  Rgb: {
    255,
    forest_seasonal(season, 250, 247, 240, 248),
    forest_seasonal(season, 238, 230, 216, 246)
  }
  Cookie: {
    texture: forest_clouds,
    size: CLOUD_SIZE,
    height: CLOUD_ALTITUDE,
    threshold: forest_cloud_threshold(season, precipitation),
    softness: 0.14,
    strength: 0.35 + 0.55 * precipitation,
    velocity: {cloud_velocity_x, cloud_velocity_z}
  }
}

moon {
  DirectionalLight: {intensity: 0.4 * PI}
  Rgb: {190, 210, 255}
}

sky {
  Atmosphere: {
    sun: sun,
    moon: moon,
    units_per_km: 1000,
    sea_level: 0,
    ground_altitude: 0,
    rayleigh: {scale_height: 8, scattering_scale: 1.05},
    mie: {
      scale_height: 1.1,
      anisotropy: 0.76,
      scattering_scale: forest_seasonal(season, 0.85, 0.95, 1.05, 0.9) + 1.1 * precipitation,
      tint: {255, 250 + 4 * precipitation, 244 + 10 * precipitation}
    },
    ozone_scale: 1,
    ground_albedo: {
      forest_seasonal(season, 34, 36, 40, 44),
      forest_seasonal(season, 64, 64, 62, 62),
      forest_seasonal(season, 70, 68, 66, 72)
    },
    night_intensity: 0.03,
    sun_disk_intensity: 6,
    sun_radius: 0.6,
    moon_disk_intensity: 12,
    moon_radius: 0.6
  }
  TimeOfDay: {
    hour: hour,
    day_of_year: forest_day_of_year(season),
    latitude: LATITUDE,
    north: NORTH,
    sun: sun,
    moon: moon
  }
  HeightFog: {
    density: forest_seasonal(season, 0.0009, 0.0008, 0.0013, 0.0012) * forest_haze(season, hour) +
      0.012 * precipitation,
    falloff: 0.012,
    base_height: 0,
    max_opacity: forest_seasonal(season, 0.3, 0.28, 0.36, 0.34) + 0.35 * precipitation,
    atmosphere: sky
  }
}

cloud_low {
  CloudLayer: {
    texture: forest_clouds,
    size: CLOUD_SIZE,
    altitude: CLOUD_ALTITUDE,
    threshold: forest_cloud_threshold(season, precipitation),
    softness: 0.14,
    density: 0.85 + 0.15 * precipitation,
    velocity: {cloud_velocity_x, cloud_velocity_z}
  }
}

cloud_high {
  CloudLayer: {
    texture: forest_clouds,
    size: 16000,
    altitude: 7000,
    threshold: 0.72 - 0.2 * precipitation,
    softness: 0.18,
    density: 0.4,
    offset: {900, 400},
    velocity: {cloud_velocity_x * 2, cloud_velocity_z * 2}
  }
}

$ {
  AmbientLight: {
    sky: {118, 134, 156},
    ground: {72, 78, 70},
    intensity: (0.025 + 0.975 * forest_daylight(season, hour)) * (1 - 0.3 * precipitation)
  }
}

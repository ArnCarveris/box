using flecs.script
using flecs.script.math
using box.world
using box.grass
using state
using assets

state {
  export const GRASS_DENSITY: f32 = 40
  export const GRASS_LOD_0: f32 = 16
  export const GRASS_LOD_1: f32 = 48
  export const GRASS_LOD_2: f32 = 160
  export const GRASS_SHADOW: f32 = 20

  fn island_grass_tall(season: f64) -> f64 {
    forest_seasonal(season, 0.8, 1, 0.9, 0.65)
  }
}

island {
  undergrowth {
    ChunkGrid: {
      template: IslandUnderCell,
      cell_size: {UNDER_CELL, 0, UNDER_CELL},
      levels: [UNDER_NEAR, UNDER_FAR],
      hysteresis: 4,
      budget: UNDER_BUDGET,
      budget_ms: UNDER_BUDGET_MS
    }
  }

  meadow {
    Grass: {
      terrain: island.land,
      mask: 1,
      density: GRASS_DENSITY,
      min_height: 0.3 * island_grass_tall(season),
      max_height: 0.85 * island_grass_tall(season),
      fold_height: 0.3,
      min_width: 0.03,
      max_width: 0.06,
      base_color: {
        forest_seasonal(season, 30, 24, 52, 56),
        forest_seasonal(season, 64, 54, 58, 52),
        forest_seasonal(season, 16, 13, 22, 28)
      },
      tip_color: {
        forest_seasonal(season, 110, 92, 150, 132),
        forest_seasonal(season, 150, 126, 136, 114),
        forest_seasonal(season, 44, 36, 64, 74)
      },
      clump_size: 1.4,
      clump_follow: 0.7,
      variation: 0.7,
      lod: [GRASS_LOD_0, GRASS_LOD_1, GRASS_LOD_2],
      shadow_distance: GRASS_SHADOW,
      seed: 4
    }
  }
}

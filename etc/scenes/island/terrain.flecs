using flecs.script
using flecs.script.math
using box.material
using box.texture
using box.terrain
using box.render
using state
using assets

island {
  land {
    place { nodes.Center: {} }
    center { nodes.Divide: {a: place, b_value: {ISLAND_K, ISLAND_K, ISLAND_K, ISLAND_K}} }
    shape_n {
      nodes.Noise: {channels: 3, frequency: 0.00045 / ISLAND_K, octaves: 1, seed: 11}
    }

    reach { nodes.Length: {input: center} }
    shape_amount {
      nodes.Curve: {input: reach, curve: {keys: [{0, 0}, {300, 160}, {1300, 1900}, {9000, 1900}]}}
    }

    shaped { nodes.Warp: {coords: center, offset: shape_n, amount: shape_amount} }
    lobe_n { nodes.Noise: {channels: 3, frequency: 0.0014 / ISLAND_K, octaves: 2, seed: 13} }
    lobe_amount {
      nodes.Curve: {input: reach, curve: {keys: [{0, 0}, {250, 100}, {900, 620}, {9000, 620}]}}
    }

    lobed { nodes.Warp: {coords: shaped, offset: lobe_n, amount: lobe_amount} }
    bend_n { nodes.Noise: {channels: 3, frequency: 0.004 / ISLAND_K, octaves: 2, seed: 12} }
    bend_amount {
      nodes.Curve: {input: reach, curve: {keys: [{0, 0}, {200, 70}, {9000, 70}]}}
    }

    bent { nodes.Warp: {coords: lobed, offset: bend_n, amount: bend_amount} }
    radius { nodes.Length: {input: bent} }

    cone {
      nodes.Curve: {input: radius, curve: {kind: CurveCatmullRom, keys: [
        {0, 588}, {90, 592}, {190, 700}, {250, 672}, {360, 602}, {520, 502}, {700, 400},
        {880, 310}, {1050, 235}, {1220, 170}, {1400, 112}, {1560, 70}, {1700, 40}, {1820, 20},
        {1920, 7}, {1980, 1.5}, {2010, 0}, {2060, -1.5}, {2200, -5}, {2400, -14}, {2700, -50},
        {3400, -140}, {4200, -200}, {9000, -240}
      ]}}
    }

    IslandStreamRay stream_0(coords: bent, angle: 0.35, spring: 760)
    IslandStreamRay stream_1(coords: bent, prev: stream_0, angle: 1.25, spring: 640)
    IslandStreamRay stream_2(coords: bent, prev: stream_1, angle: 2.05, spring: 820)
    IslandStreamRay stream_3(coords: bent, prev: stream_2, angle: 2.9, spring: 700)
    IslandStreamRay stream_4(coords: bent, prev: stream_3, angle: 3.75, spring: 880)
    IslandStreamRay stream_5(coords: bent, prev: stream_4, angle: 4.6, spring: 660)
    IslandStreamRay stream_6(coords: bent, prev: stream_5, angle: 5.5, spring: 780)

    stream_m { nodes.Multiply: {a: stream_6, b_value: {ISLAND_K, ISLAND_K, ISLAND_K, ISLAND_K}} }
    stream_g { nodes.Gradient: {height: stream_m} }
    stream_gl { nodes.Length: {input: stream_g} }
    stream_gb { nodes.Blur: {input: stream_gl, radius: 3} }
    stream_gc {
      nodes.Clamp: {
        input: stream_gb,
        min_value: {0.6, 0.6, 0.6, 0.6},
        max_value: {1.7, 1.7, 1.7, 1.7}
      }
    }

    stream_d { nodes.Divide: {a: stream_m, b: stream_gc} }

    stream_far {
      nodes.Smoothstep: {input: stream_d, edge0_value: {70 * ISLAND_K, 0, 0, 0},
        edge1_value: {260 * ISLAND_K, 0, 0, 0}}
    }

    stream_open {
      nodes.Smoothstep: {input: stream_d, edge0_value: {24, 0, 0, 0}, edge1_value: {90, 0, 0, 0}}
    }

    lump_n { nodes.Noise: {frequency: 0.0016 / ISLAND_K, octaves: 3, seed: 21} }
    lump_amp {
      nodes.Curve: {input: cone, curve: {keys: [
        {-300, 0}, {0, 0}, {30, 5}, {200, 40}, {560, 70}, {700, 20}
      ]}}
    }

    head_n { nodes.Noise: {frequency: 0.0019 / ISLAND_K, octaves: 2, seed: 23} }
    head_in {
      nodes.Smoothstep: {input: head_n, edge0_value: {0.5, 0, 0, 0}, edge1_value: {0.62, 0, 0, 0}}
    }

    head_amp {
      nodes.Curve: {input: cone, curve: {keys: [
        {-300, 0}, {-9, 0}, {-3, 12}, {8, 30}, {60, 18}, {160, 0}, {900, 0}
      ]}}
    }

    head { nodes.Multiply: {a: head_in, b: head_amp} }
    lump_a { nodes.Multiply: {a: lump_n, b: lump_amp} }
    lump_b { nodes.Add: {a: lump_a, b: head} }
    outer {
      nodes.Smoothstep: {input: radius, edge0_value: {150, 0, 0, 0}, edge1_value: {240, 0, 0, 0}}
    }

    lump_c { nodes.Multiply: {a: lump_b, b: stream_far} }
    lumps { nodes.Multiply: {a: lump_c, b: outer} }
    rough { nodes.Add: {a: cone, b: lumps} }
    rough_m { nodes.Multiply: {a: rough, b_value: {ISLAND_H, ISLAND_H, ISLAND_H, ISLAND_H}} }

    rough_g { nodes.Gradient: {height: rough_m} }
    gullies {
      nodes.Erosion: {
        slope: rough_g,
        frequency: 0.005 / ISLAND_K,
        octaves: 4,
        gain: 0.42,
        scale: 3.2,
        seed: 31
      }
    }

    gully_c {
      nodes.Remap: {input: gullies, from_min: -1, from_max: 1, to_min: -1, to_max: 0.7}
    }

    gully_s { nodes.Mix: {a_value: {-1, -1, -1, -1}, b: gully_c, factor: stream_open} }
    gully_amp {
      nodes.Curve: {input: cone, curve: {keys: [
        {-300, 0}, {0, 0}, {15, 1.5}, {150, 14}, {480, 36}, {620, 24}, {700, 8}
      ]}}
    }

    worn_a { nodes.Multiply: {a: gully_s, b: gully_amp} }
    worn { nodes.Multiply: {a: worn_a, b: outer} }

    bump_n { nodes.Noise: {frequency: 0.02, octaves: 3, seed: 22} }
    bump_c { nodes.Remap: {input: bump_n, from_min: 0, from_max: 1, to_min: -1, to_max: 1} }
    bump_amp {
      nodes.Curve: {input: cone, curve: {keys: [
        {-300, 0.4}, {0, 0.2}, {6, 0.3}, {40, 2.4}, {700, 4}
      ]}}
    }

    bump_a { nodes.Multiply: {a: bump_c, b: bump_amp} }
    bumps { nodes.Multiply: {a: bump_a, b: stream_open} }

    h0 { nodes.Add: {a: rough, b: worn} }
    h1 { nodes.Multiply: {a: h0, b_value: {ISLAND_H, ISLAND_H, ISLAND_H, ISLAND_H}} }
    h2 { nodes.Add: {a: h1, b: bumps} }

    falls {
      nodes.Curve: {input: cone, curve: {keys: [
        {-300, 0}, {0, 0}, {44, 9}, {45, 0}, {60, 0}, {129, 14}, {130.5, 0}, {160, 0},
        {256, 18}, {258, 0}, {900, 0}
      ]}}
    }

    bed_a { nodes.Subtract: {a: cone, b: gully_amp} }
    bed_b { nodes.Subtract: {a: bed_a, b: falls} }
    bed_c { nodes.Multiply: {a: bed_b, b_value: {ISLAND_H, ISLAND_H, ISLAND_H, ISLAND_H}} }
    stream_bed { nodes.Subtract: {a: bed_c, b_value: {STREAM_SINK, 0, 0, 0}} }
    bed_q {
      nodes.Divide: {a: stream_bed, b_value: {STREAM_STEP, STREAM_STEP, STREAM_STEP, STREAM_STEP}}
    }

    bed_qf { nodes.Floor: {input: bed_q} }
    bed_steps {
      nodes.Multiply: {a: bed_qf, b_value: {STREAM_STEP, STREAM_STEP, STREAM_STEP, STREAM_STEP}}
    }

    bank_rise {
      nodes.Curve: {input: stream_d, curve: {kind: CurveCatmullRom, keys: [
        {0, -0.5}, {0.9, -0.42}, {1.5, 0.1}, {2.2, 0.6}, {3, 1}, {4.5, 1.35}, {8, 1.9},
        {14, 3.2}, {22, 5}, {32, 9}, {45, 20}, {60, 60}, {80, 300}, {100, 2000}
      ]}}
    }

    bank { nodes.Add: {a: stream_bed, b: bank_rise} }
    stream_cut { nodes.Max: {a: bed_steps, b: bank} }
    height { nodes.Min: {a: h2, b: stream_cut} }

    slope { nodes.Slope: {height: height} }
    steep {
      nodes.Smoothstep: {input: slope, edge0_value: {0.82, 0, 0, 0}, edge1_value: {1.2, 0, 0, 0}}
    }

    alt_n { nodes.Noise: {frequency: 0.006, octaves: 3, seed: 41} }
    alt_d { nodes.Remap: {input: alt_n, from_min: 0, from_max: 1, to_min: -50 * ISLAND_H,
      to_max: 50 * ISLAND_H} }
    alt { nodes.Add: {a: height, b: alt_d} }
    barren {
      nodes.Smoothstep: {input: alt, edge0_value: {ASH_LINE - 40 * ISLAND_H, 0, 0, 0},
        edge1_value: {ASH_LINE + 40 * ISLAND_H, 0, 0, 0}}
    }

    rock { nodes.Max: {a: steep, b: barren} }
    open { nodes.Subtract: {a_value: {1, 1, 1, 1}, b: rock} }

    beach {
      nodes.Smoothstep: {input: height, edge0_value: {BEACH_TOP + 1, 0, 0, 0},
        edge1_value: {BEACH_TOP - 1.5, 0, 0, 0}}
    }

    shore { nodes.Multiply: {a: beach, b: open} }
    rest_s { nodes.Subtract: {a: open, b: shore} }
    bank_m {
      nodes.Smoothstep: {input: stream_d, edge0_value: {5.5, 0, 0, 0}, edge1_value: {2.4, 0, 0, 0}}
    }

    bank_w { nodes.Multiply: {a: bank_m, b: rest_s} }
    rest_a { nodes.Subtract: {a: rest_s, b: bank_w} }
    bank_low {
      nodes.Smoothstep: {input: height, edge0_value: {14, 0, 0, 0}, edge1_value: {6, 0, 0, 0}}
    }

    bank_sand { nodes.Multiply: {a: bank_w, b: bank_low} }
    bank_rock { nodes.Subtract: {a: bank_w, b: bank_sand} }
    sand_w { nodes.Add: {a: shore, b: bank_sand} }
    rock_w { nodes.Add: {a: rock, b: bank_rock} }

    alpine {
      nodes.Smoothstep: {input: alt, edge0_value: {TREE_LINE - 30 * ISLAND_H, 0, 0, 0},
        edge1_value: {TREE_LINE + 20 * ISLAND_H, 0, 0, 0}}
    }

    coords { nodes.Coords: {} }
    glade_bend { nodes.Noise: {channels: 3, frequency: 0.005, octaves: 2, seed: 51} }
    glade_coords { nodes.Warp: {coords: coords, offset: glade_bend, amount_value: 40} }
    glade_cells {
      nodes.Cells: {distance: CellsNearest, size: 260, seed: 52, coords: glade_coords}
    }

    glade_d { nodes.Split: {input: glade_cells, channel: ChannelR} }
    glade_r { nodes.Split: {input: glade_cells, channel: ChannelB} }
    glade_in {
      nodes.Smoothstep: {input: glade_d, edge0_value: {0.2, 0, 0, 0}, edge1_value: {0.12, 0, 0, 0}}
    }

    glade_kept {
      nodes.Smoothstep: {input: glade_r, edge0_value: {0.42, 0, 0, 0}, edge1_value: {0.38, 0, 0, 0}}
    }

    glade { nodes.Multiply: {a: glade_in, b: glade_kept} }

    dune_lo {
      nodes.Smoothstep: {input: height, edge0_value: {BEACH_TOP - 1, 0, 0, 0},
        edge1_value: {BEACH_TOP + 1.5, 0, 0, 0}}
    }

    dune_hi {
      nodes.Smoothstep: {input: height, edge0_value: {16, 0, 0, 0}, edge1_value: {9, 0, 0, 0}}
    }

    dune { nodes.Multiply: {a: dune_lo, b: dune_hi} }
    meadow_a { nodes.Max: {a: alpine, b: glade} }
    meadow { nodes.Max: {a: meadow_a, b: dune} }
    grass_w { nodes.Multiply: {a: meadow, b: rest_a} }
    floor_w { nodes.Subtract: {a: rest_a, b: grass_w} }
    masks { nodes.Combine: {r: floor_w, g: grass_w, b: sand_w, a: rock_w} }

    Terrain: {
      height: height,
      masks: masks,
      tile_size: TERRAIN_TILE,
      resolution: TERRAIN_RESOLUTION,
      levels: TERRAIN_LEVELS,
      lod_distance: TERRAIN_DETAIL,
      extent: ISLAND_EXTENT,
      min_height: GROUND_MIN,
      max_height: GROUND_MAX,
      budget: TERRAIN_BUDGET,
      query_spacing: TERRAIN_QUERY_SPACING,
      query_radius: TERRAIN_QUERY_RADIUS,
      query_hold: TERRAIN_QUERY_HOLD
    }

    texture.Blend: {
      layers: [island_floor, island_grass, island_sand, island_rock],
      heights: [moss_height, island_grass_height, island_sand_height, island_basalt_height],
      contrast: 6,
      variation: 0.4
    }

    texture.Mapping: {mode: MappingWorld, size: GROUND_MAP_SIZE, blend: 0.15}
    texture.Layers: {layers: [island_peak_snow, layer_wet]}
    Rgb: {212, 206, 196}
    PbrMaterial: {roughness: 0.95}

    far_h { nodes.Subtract: {a: height, b_value: {FAR_DATA_DROP, 0, 0, 0}} }
    stream_data_h { nodes.Subtract: {a: height, b_value: {STREAM_DATA_DROP, 0, 0, 0}} }
    stream_data { nodes.Combine: {r: stream_d, g: stream_bed} }
  }

  streams {
    Terrain: {
      height: island.land.stream_data_h,
      masks: island.land.stream_data,
      tile_size: 1024,
      resolution: 5,
      levels: 1,
      lod_distance: 3072,
      extent: ISLAND_EXTENT,
      min_height: GROUND_MIN - STREAM_DATA_DROP,
      max_height: GROUND_MAX - STREAM_DATA_DROP,
      budget: TERRAIN_BUDGET,
      query_spacing: 1,
      query_radius: 96,
      query_only: true,
      query_hold: TERRAIN_QUERY_HOLD
    }
  }

  far {
    Terrain: {
      height: island.land.far_h,
      masks: island.land.masks,
      tile_size: 1024,
      resolution: 5,
      levels: 1,
      lod_distance: 3072,
      extent: ISLAND_EXTENT,
      min_height: GROUND_MIN - FAR_DATA_DROP,
      max_height: GROUND_MAX - FAR_DATA_DROP,
      budget: TERRAIN_BUDGET,
      query_spacing: 8,
      query_radius: 1024,
      query_only: true,
      query_hold: TERRAIN_QUERY_HOLD
    }
  }
}

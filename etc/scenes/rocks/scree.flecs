using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.mesh
using rocks

// Scree and outcrops. A RockScree is one MeshGraph shape: stones of three shapes, each a small
// displaced and split pebble, scattered over a mound (PointsOnMesh), turned and sized at random
// (Jitter) and copied onto the points (InstanceOnPoints), merged with the mound under them. A
// RockCluster is an outcrop: a few large Rocks leaning together with a skirt of scree around
// them.
rocks {
  // A heap of scree stones of radius meters, height times as high, the mound showing between
  // the stones; a low height spreads them as a skirt of loose stones
  template RockScree {
    prop seed: i32 = 1
    prop radius: f32 = 1.5       // Meters from the center to the foot of the heap
    prop height: f32 = 0.45      // Height of the heap as a fraction of its radius
    prop stones: i32 = 160       // Stones of each of the three shapes, at most
    prop stone_size: f32 = 0.09  // Size of the largest stones as a fraction of the radius
    prop mound: bool = true      // Show the mound of grit under the stones
    prop moss: f32 = 0
    prop stone: i32 = ROCK_GRANITE

    // The mound, also the surface the stones settle on
    sphere { nodes.Shape: {entity: RockSphere} }
    squashed { nodes.Transform: {input: sphere, scale: {1, height, 1}} }
    lobed { nodes.Displace: {mesh: squashed, amount: 0.22, frequency: 0.9, octaves: 2, seed: seed} }
    lumpy { nodes.Displace: {mesh: lobed, amount: height * 0.12, frequency: 1.8, octaves: 3, seed: seed + 1} }
    heap { nodes.Cut: {mesh: lumpy, position: {0, 0, 0}, normal: {0, -1, 0}} }

    // The apron of stones that rolled off the heap, a flat lobed disc around its foot
    apron_s { nodes.Transform: {input: sphere, scale: {1.35, 0.02, 1.35}} }
    apron { nodes.Displace: {mesh: apron_s, amount: 0.3, frequency: 0.8, octaves: 2, seed: seed + 2} }
    heap_n { nodes.Normals: {mesh: heap} }

    // Three stones: a blocky one, a flat one and a long one, each split on one side
    pebble { nodes.Shape: {entity: RockPebble} }
    block_s { nodes.Transform: {input: pebble, scale: {1, 0.7, 0.85}} }
    block_d { nodes.Displace: {mesh: block_s, amount: 0.22, frequency: 1.3, octaves: 2, seed: seed + 11} }
    block_c { nodes.Cut: {mesh: block_d, position: {0.45, 0, 0}, normal: {1, 0.3, 0.2}} }
    block_b { nodes.Cut: {mesh: block_c, position: {0, -0.4, 0}, normal: {0, -1, 0}} }
    block { nodes.Normals: {mesh: block_b, angle: 0.6} }
    flat_s { nodes.Transform: {input: pebble, scale: {1, 0.38, 0.75}} }
    flat_d { nodes.Displace: {mesh: flat_s, amount: 0.16, frequency: 1.5, octaves: 2, seed: seed + 12} }
    flat_c { nodes.Cut: {mesh: flat_d, position: {-0.5, 0, 0}, normal: {-1, 0, 0.4}} }
    flat { nodes.Normals: {mesh: flat_c, angle: 0.6} }
    long_s { nodes.Transform: {input: pebble, scale: {1.3, 0.55, 0.6}} }
    long_d { nodes.Displace: {mesh: long_s, amount: 0.2, frequency: 1.2, octaves: 2, seed: seed + 13} }
    long_c { nodes.Cut: {mesh: long_d, position: {0, 0, 0.3}, normal: {0.3, 0.2, 1}} }
    long { nodes.Normals: {mesh: long_c, angle: 0.6} }

    // Where they lie: spread over the mound, turned about its normal, tilted and sized
    spots_a { nodes.PointsOnMesh: {mesh: heap, count: stones, min_spacing: stone_size * 1.1, seed: seed + 21} }
    spots_b { nodes.PointsOnMesh: {mesh: heap, count: stones, min_spacing: stone_size * 1.1, seed: seed + 22} }
    spots_c { nodes.PointsOnMesh: {mesh: heap, count: stones, min_spacing: stone_size * 1.1, seed: seed + 23} }
    turned_a { nodes.Jitter: {points: spots_a, spin: 3.14, tilt: 0.35, scale_min: stone_size * 0.4, scale_max: stone_size, seed: seed + 31} }
    turned_b { nodes.Jitter: {points: spots_b, spin: 3.14, tilt: 0.3, scale_min: stone_size * 0.5, scale_max: stone_size * 1.1, seed: seed + 32} }
    turned_c { nodes.Jitter: {points: spots_c, spin: 3.14, tilt: 0.45, scale_min: stone_size * 0.35, scale_max: stone_size * 0.9, seed: seed + 33} }
    stones_a { nodes.InstanceOnPoints: {points: turned_a, instance: block} }
    stones_b { nodes.InstanceOnPoints: {points: turned_b, instance: flat} }
    stones_c { nodes.InstanceOnPoints: {points: turned_c, instance: long} }
    spill_p { nodes.PointsOnMesh: {mesh: apron, count: stones / 2, min_spacing: stone_size * 1.4, seed: seed + 24} }
    spill_t { nodes.Jitter: {points: spill_p, spin: 3.14, tilt: 0.2, scale_min: stone_size * 0.3, scale_max: stone_size * 0.8, seed: seed + 34} }
    spill { nodes.InstanceOnPoints: {points: spill_t, instance: block} }

    if mound {
      all { nodes.Merge: {inputs: [heap_n, stones_a, stones_b, stones_c, spill]} }
      placed { nodes.Transform: {input: all, scale: {radius, radius, radius}} }
      Graph: {output: placed}
    } else {
      all { nodes.Merge: {inputs: [stones_a, stones_b, stones_c]} }
      placed { nodes.Transform: {input: all, scale: {radius, radius, radius}} }
      Graph: {output: placed}
    }

    Rgb: {255, 255, 255}
    if stone == ROCK_SANDSTONE {
      PbrMaterial: {roughness: 0.95}
      PbrTextures: {albedo: rock_sandstone_albedo, normal: rock_sandstone_normal, orm: rock_sandstone_orm}
      texture.Mapping: {mode: MappingObject, size: ROCK_MAP_SIZE * 0.6, blend: 0.4}
    } else if stone == ROCK_FOREST {
      PbrMaterial: {roughness: 0.9}
      PbrTextures: {albedo: rock_forest_albedo, normal: rock_forest_normal, orm: rock_forest_orm}
      texture.Mapping: {mode: MappingObject, size: ROCK_MAP_SIZE * 0.6, blend: 0.4}
    } else {
      PbrMaterial: {roughness: 0.85}
      PbrTextures: {albedo: rock_granite_albedo, normal: rock_granite_normal, orm: rock_granite_orm}
      texture.Mapping: {mode: MappingObject, size: ROCK_MAP_SIZE * 0.6, blend: 0.4}
    }

    if moss > 0 {
      RockMossLayer moss_layer(amount: moss)
      texture.Layers: {layers: [moss_layer]}
    }
  }

  // An outcrop: a tall rock with two leaning against it and a smaller one in front, split along
  // joints, and a skirt of scree fallen from them. size is meters across the tallest rock.
  template RockCluster {
    prop seed: i32 = 1
    prop size: f32 = 2.5
    prop roundness: f32 = 0.2
    prop strata: f32 = 0.2
    prop cracks: f32 = 0.7
    prop moss: f32 = 0
    prop stone: i32 = ROCK_GRANITE

    const rng: flecs.script.math.Rng = {seed: seed}
    const a = rng.f(6.28)
    const b = a + 2 + rng.f(0.8)
    const c = b + 1.8 + rng.f(0.8)

    Rock main(seed: seed, size: size, roundness: roundness, strata: strata, cracks: cracks, flatness: 0, strength: 0.55, moss: moss, stone: stone) {
      Rotation: {0, 0, 0.08}
      Scale: {1, 1.35, 1}
    }

    Rock left(seed: seed + 1, size: size * 0.7, roundness: roundness, strata: strata, cracks: cracks, flatness: 0.15, strength: 0.5, moss: moss, stone: stone) {
      Position: {cos(a) * size * 0.5, 0, sin(a) * size * 0.5}
      Rotation: {sin(a) * 0.25, 0, 0 - cos(a) * 0.25}
    }

    Rock right(seed: seed + 2, size: size * 0.6, roundness: roundness, strata: strata, cracks: cracks, flatness: 0.3, strength: 0.5, moss: moss, stone: stone) {
      Position: {cos(b) * size * 0.48, 0, sin(b) * size * 0.48}
      Rotation: {sin(b) * 0.2, 0, 0 - cos(b) * 0.2}
    }

    Rock small(seed: seed + 3, size: size * 0.38, roundness: roundness + 0.1, strata: strata, cracks: cracks * 0.6, flatness: 0.3, strength: 0.5, moss: moss, stone: stone) {
      Position: {cos(c) * size * 0.62, 0, sin(c) * size * 0.62}
    }

    RockScree skirt(seed: seed + 4, radius: size * 1.15, height: 0.015, stones: 90, stone_size: 0.05, mound: false, moss: 0, stone: stone) { Position: {0, 0, 0} }
  }
}

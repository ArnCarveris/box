include paris/state
include paris/clock
include paris/materials
include paris/world
include paris/building
include paris/city
include paris/street
include paris/eiffel
include paris/landmarks
using flecs.script
using box.view
using box.surface

$ {
  box.app.FpsTarget: {60}
  Scene: {baked: true, reflections: true, punctual_shadows: true, environment: true,
    aerial_perspective: true, sheen: true, clear_coat: true, water: true, texture_scroll: true,
    blend_modes: true, planar_reflections: true}
}

window { Surface: {width: 1600, height: 1000, vsync: true} }

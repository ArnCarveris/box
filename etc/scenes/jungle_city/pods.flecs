using flecs.script
using box.transform
using box.geometry
using box.material

@tree Parent
template CanopyPods {
  prop floors: i32 = 5
  prop variant: i32 = 0
  prop wall: Rgb = {225, 224, 199}
  prop timber: Rgb = {143, 91, 48}
  prop roof_style: i32 = 0
  prop facade_style: i32 = 0
  const windows: math.Rng = {seed: variant + 314159}
  const height = floors * 3.2
  spine : CanopyWood { Position: {0, height / 2 + 1.2, 0}; Box: {1.5, height, 2}; Rgb: timber }
  for f in 0..floors {
    for side in 0..2 {
      const x = (side - 0.5) * 4.2
      const z = (f % 2 - 0.5) * 1.8
      { (IsA, CanopyIvory); Position: {x, 2.6 + f * 3.2, z}; RoundedBox: {3.8, 2.7, 5.8, 0.8}; Rgb: wall }
      { (IsA, CanopyGlass); Position: {x, 2.6 + f * 3.2, z + 2.91}; RoundedBox: {2.9, 1.8, 0.07, 0.35} }
      if windows.f(1) > 0.5 {
        { (IsA, CanopyWindow); Position: {x, 2.6 + f * 3.2, z + 2.96}; RoundedBox: {2.3, 1.3, 0.03, 0.2} }
      }
      { (IsA, CanopyLeaf); Position: {x, 4 + f * 3.2, z}; RoundedBox: {3.5, 0.15, 5.4, 0.6} }
      CanopyVine(length: 1.8, phase: variant + f) { Position: {x + 1.5, 4.1 + f * 3.2, z + 2.8} }
      for i in 0..3 + facade_style {
        { (IsA, CanopyWood); Position: {x - 1.2 + i * 2.4 / (2 + facade_style), 2.6 + f * 3.2, z + 3}; Box: {0.1, 2.2, 0.15}; Rgb: timber }
      }
    }
  }
  CanopyRoof(style: roof_style, variant: variant) { Position: {0, height + 1.3, 0} }
  entrance : CanopyWood { Position: {0, 4.4, 4.5}; Box: {3, 0.2, 2.6} }
}

using flecs.script
using box.transform
using box.geometry
using box.material

@tree Parent
template CanopySpire {
  prop floors: i32 = 5
  prop variant: i32 = 0
  prop wall: Rgb = {226, 235, 211}
  prop timber: Rgb = {143, 91, 48}
  prop roof_style: i32 = 0
  prop facade_style: i32 = 0
  const windows: math.Rng = {seed: variant + 314159}
  const height = floors * 3.2 + 4
  core : CanopyGlass { Position: {0, height / 2 + 1.2, 0}; Frustum: {radius_bottom: 2.9, radius_top: 1.8, length: height, segments: 8} }
  for i in 0..8 + facade_style * 4 {
    const a = i * math.PI * 2 / (8 + facade_style * 4)
    { (IsA, CanopyWood); Rgb: timber; Position: {math.sin(a) * 2.4, height / 2 + 1.2, math.cos(a) * 2.4}; Rotation: {-math.sin(a) * 0.04, a, math.cos(a) * 0.04}; Box: {0.22, height, 0.3} }
  }
  for f in 0..floors {
    const y = 2.8 + f * 3.2
    const radius = 2.9 - (y - 1.2) / height * 1.1
    for side in 0..4 {
      const a = side * math.PI / 2 + math.PI / 8
      if windows.f(1) > 0.55 {
        { (IsA, CanopyWindow); Position: {math.sin(a) * radius * 0.94, y, math.cos(a) * radius * 0.94}; Rotation: {-0.04, a, 0}; Box: {0.65, 1.5, 0.06} }
      }
    }
  }
  for f in 0..3 {
    const y = 4.4 + f * (height - 3.2) / 2
    { (IsA, CanopyIvory); Rgb: wall; Position: {0, y, 0}; Cylinder: {radius: 4.3 - f * 0.3, length: 0.35, segments: 8} }
    { (IsA, CanopyLeaf); Position: {0, y + 0.35, 0}; Tube: {radius: 4.05 - f * 0.3, thickness: 0.6, length: 0.3, segments: 16} }
    for i in 0..4 {
      const a = i * math.PI / 2
      CanopyVine(length: 2.8, phase: variant) { Position: {math.sin(a) * (4.3 - f * 0.3), y + 0.3, math.cos(a) * (4.3 - f * 0.3)} }
    }
  }
  if roof_style == 3 {
    crown : CanopyWood { Position: {0, height + 2.7, 0}; Frustum: {radius_bottom: 2, radius_top: 4.6, length: 1.4, segments: 12} }
    solar_canopy : CanopySolar { Position: {0, height + 3.45, 0}; Cylinder: {radius: 4.65, length: 0.14, segments: 12} }
    rim : CanopyIvory { Position: {0, height + 3.48, 0}; Torus: {radius: 4.65, tube: 0.1, segments: 12, rings: 6} }
    for i in 0..6 {
      const a = i * math.PI / 3
      { (IsA, CanopyIvory); Rgb: wall; Position: {math.sin(a) * 2.3, height + 3.55, math.cos(a) * 2.3}; Rotation: {0, a, 0}; Box: {0.06, 0.05, 4.5} }
    }
  } else {
    CanopyRoof(style: roof_style, variant: variant) { Position: {0, height + 1.5, 0} }
  }
  entrance : CanopyWood { Position: {0, 4.4, 4.5}; Box: {2.2, 0.2, 2.6} }
  lift : CanopyIvory { Position: {3.6, 2.2, 4.3}; RoundedBox: {0.9, 4.4, 0.9, 0.2} }
}

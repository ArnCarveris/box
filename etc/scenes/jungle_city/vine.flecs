using flecs.script
using box.transform
using box.geometry
using box.material

@tree Parent
template CanopyVine {
  prop length: f32 = 3
  prop phase: f32 = 0
  { (IsA, CanopyJade); Position: {0, -length / 2, 0}; Cylinder: {radius: 0.035, length: length, segments: 5} }
  for i in 0..7 {
    { (IsA, CanopyLeaf); Position: {math.sin(i * 2.4 + phase) * 0.19, -i * length / 7, 0.08}; Rotation: {0, i * 2.4, 0.4}; Scale: {0.28, 0.42, 0.15}; IcoSphere: {radius: 1, segments: 0} }
  }
}

using flecs.script
using box.transform
using box.geometry
using box.material

@tree Parent
template CanopyBridge {
  prop length: f32 = 16
  prop width: f32 = 2.2
  { (IsA, CanopyWood); Position: {0, -0.12, 0}; Box: {length, 0.24, width} }
  for side in 0..2 {
    const z = (side - 0.5) * width
    { (IsA, CanopyIvory); Position: {0, 0.9, z}; Box: {length, 0.09, 0.1} }
    { (IsA, CanopyGlow); Position: {0, -0.15, z}; Box: {length, 0.045, 0.035} }
    for i in 0..9 {
      { (IsA, CanopyWood); Position: {(i / 8.0 - 0.5) * length, 0.43, z}; Box: {0.07, 0.9, 0.07} }
    }
  }
  for i in 0..12 {
    { (IsA, CanopyIvory); Position: {(i / 12.0 - 0.46) * length, 0.015, 0}; Box: {0.045, 0.03, width} }
  }
}

include materials
include branch
include leaf
include tree
include fern
include vine
include bridge
include roof
include tower
include rotunda
include cascade
include spire
include pods
include streetlight
include sign
include conservatory
include terrain
include districts
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.controllers

assets {
  @tree ChildOf
  template JungleCity {
    prop columns: i32 = 10
    prop rows: i32 = 9
    prop spacing: f32 = 17
    prop seed: i32 = 17
    prop base_floors: i32 = 2
    prop floor_variation: i32 = 2
    prop center_floors: i32 = 8
    prop trees_per_block: i32 = 7
    const width = columns * spacing + 32
    const depth = rows * spacing + 20
    const extent = math.sqrt(width * width + depth * depth)
    CanopyTerrain(width: width, depth: depth) {}
    CanopyDistricts(rows: rows, columns: columns, spacing: spacing, seed: seed,
      base_floors: base_floors, floor_variation: floor_variation, center_floors: center_floors, trees_per_block: trees_per_block) {}
    civic_island {
      Position: {0, 0.4, depth * 0.34}
      platform : CanopyIvory { Position: {0, 1.8, 0}; Cylinder: {radius: 7, length: 3.6, segments: 48} }
      CanopyConservatory() { Position: {0, 3.6, 0} }
      CanopyBridge(length: spacing + 8, width: 3) { Position: {0, 4.2, 0} }
    }
    camera {
      Position: {-extent * 0.69, extent * 0.59, extent * 0.87}
      Rotation: {-0.55, -0.67, 0}
      Camera: {fov: 43, near_: 0.5, far_: extent * 5}
      CameraController: {speed: 30}
    }
  }
}

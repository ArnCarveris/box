using flecs.script
using box.transform
using box.geometry
using box.material

@tree Parent
template CanopyStreetlight {
  prop intensity: f32 = 5
  foot : CanopyIvory { Position: {0, 0.12, 0}; Cylinder: {radius: 0.24, length: 0.24, segments: 8} }
  mast : CanopyWood { Position: {0, 1.65, 0}; Frustum: {radius_bottom: 0.1, radius_top: 0.05, length: 3.3, segments: 8} }
  arm : CanopyIvory { Position: {0.45, 3.25, 0}; RoundedBox: {1.1, 0.14, 0.35, 0.06} }
  lamp { Position: {0.8, 3.14, 0}; Box: {0.65, 0.12, 0.4}; Rgb: {255, 221, 151}; Emissive: {strength: intensity, color: {255, 209, 129}} }
  cap : CanopySolar { Position: {0.2, 3.4, 0}; Rotation: {0, 0, -0.15}; Box: {0.8, 0.06, 0.7} }
}

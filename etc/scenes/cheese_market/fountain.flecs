include materials
include cheese_wheel
include cheese_wedge
include beam
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.text
using box.particle

assets {
  template MarketFountain {
    base {
      Position: {0, 0.12, 0}
      Cylinder: {radius: 1.85, length: 0.24, segments: 12}
      Rgb: MarketStone
    }

    basin {
      Position: {0, 0.43, 0}
      Tube: {radius: 1.56, thickness: 0.2, length: 0.5, segments: 24}
      Rgb: {209, 193, 161}
    }

    for i in 0..24 {
      {
        Position: {math.sin(i * math.PI / 12) * 1.46, 0.7, math.cos(i * math.PI / 12) * 1.46}
        Rotation: {0, i * math.PI / 12, 0}
        RoundedBox: {0.36, 0.12, 0.29, 0.035}
        Rgb: {220, 204, 174}
      }
    }

    water {
      Position: {0, 0.5, 0}
      Cylinder: {radius: 1.36, length: 0.03, segments: 48}
      Rgb: {150, 218, 208}
      PbrMaterial: {roughness: 0.06}
      Transmission: {
        transmission_factor: 0.75,
        ior: 1.33,
        thickness_factor: 0.25,
        attenuation_distance: 0.5,
        attenuation_color: {70, 170, 160}
      }
    }

    pedestal {
      Position: {0, 1.04, 0}
      Frustum: {radius_bottom: 0.46, radius_top: 0.32, length: 1.3, segments: 8}
      Rgb: MarketStone
    }

    crown {
      Position: {0, 1.74, 0}
      Cylinder: {radius: 0.69, length: 0.15, segments: 16}
      Rgb: {220, 202, 166}
    }

    CheeseWheel(radius: 0.57, height: 0.28) { Position: {0, 1.83, 0} }
    CheeseWedge() { Position: {0, 2.13, 0}; Rotation: {0, -0.35, 0} }

    for i in 0..4 {
      const a = i * math.PI / 2
      {
        Position: {math.sin(a) * 0.42, 1.32, math.cos(a) * 0.42}
        Rotation: {math.PI / 2, a, 0}
        Tube: {radius: 0.06, thickness: 0.02, length: 0.28, segments: 12}
        Rgb: {149, 119, 62}
      }

      {
        Position: {}
        arc {
          Path3D: {
            start: {math.sin(a) * 0.54, 1.32, math.cos(a) * 0.54},
            segments: [{
              kind: CubicBezier,
              end: {math.sin(a) * 1.02, 0.52, math.cos(a) * 1.02},
              control1: {math.sin(a) * 0.7, 1.32, math.cos(a) * 0.7},
              control2: {math.sin(a) * 0.86, 1.0533, math.cos(a) * 0.86}
            }]
          }
        }

        Sweep: {path: arc, profile: MarketRoundProfile, scale: {0.018, 0.018}, rings: 24}
        Rgb: {176, 213, 201}
        PbrMaterial: {roughness: 0.1}
      }

      {
        Position: {math.sin(a) * 1.02, 0.53, math.cos(a) * 1.02}
        Emitter: {
          max: 120, rate: 60, shape: EmitterDisc, radius: 0.04,
          direction: {0, 1, 0}, spread: 35, speed: {0.4, 0.9},
          lifetime: {0.3, 0.6}, size: {0.012, 0.03}, opacity: {0.4, 0.8},
          color: {226, 242, 238}, seed: i + 7
        }
        Forces: {}
        Collision: {height: 0.77, die: true}
        Appearance: {lit: 0.8}
        Curves: {opacity: {keys: [{0, 1}, {0.7, 0.8}, {1, 0}]}}
      }

      for ripple in 0..3 {
        {
          Position: {math.sin(a) * 1.02, 0.523, math.cos(a) * 1.02}
          Torus: {radius: 0.08 + ripple * 0.07, tube: 0.008, segments: 20, rings: 4}
          Rgb: {151, 196, 180}
        }
      }
    }
  }
}

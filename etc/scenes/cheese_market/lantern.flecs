include materials
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.text

assets {
  template MarketLantern {
    cord {
      Position: {0, 0.43, 0}
      Cylinder: {radius: 0.018, length: 0.4, segments: 8}
      Rgb: MarketIron
    }

    glass {
      Position: {0, 0.02, 0}
      Box: {0.23, 0.36, 0.23}
      Rgb: {255, 219, 144}
      Emissive: {strength: 3, color: {255, 191, 95}}
    }

    for x in 0..2 {
      for z in 0..2 {
        {
          Position: {(x - 0.5) * 0.28, 0.02, (z - 0.5) * 0.28}
          Box: {0.035, 0.44, 0.035}
          Rgb: MarketIron
        }
      }
    }

    for side in 0..2 {
      {
        Position: {0, -0.21 + side * 0.46, 0}
        Box: {0.36, 0.06, 0.36}
        Rgb: MarketIron
      }
    }

    cap {
      Position: {0, 0.32, 0}
      Rotation: {0, math.PI / 4, 0}
      Cone: {radius: 0.27, length: 0.17, segments: 4}
      Rgb: MarketIron
    }
  }
}

include materials
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.text

template MarketRoof {
  prop tint: Rgb = {176, 88, 58}

  for side in 0..2 {
    {
      Position: {(side - 0.5) * 2.7, 0.76, 0}
      Rotation: {0, 0, -(side - 0.5) * 0.98}
      Box: {3.12, 0.13, 4.6}
      Rgb: MarketOak
      for row in 0..8 {
        for tile in 0..18 {
          {
            Position: {(row - 3.5) * 0.39, 0.115 + (side - 0.5) * -0.012, (tile - 8.5) * 0.25}
            RoundedBox: {0.41, 0.09, 0.235, 0.04}
            Rgb: {tint.r + (tile + row) % 3 * 7, tint.g + row % 3 * 6, tint.b + tile % 3 * 4}
          }
        }
      }
      for end in 0..2 {
        {
          Position: {0, 0, (end - 0.5) * 4.7}
          Box: {3.2, 0.17, 0.11}
          Rgb: MarketCream
        }
      }
    }
    {
      Position: {(side - 0.5) * 5.55, 0.07, 0}
      Rotation: {math.PI / 2, 0, 0}
      Tube: {radius: 0.09, thickness: 0.025, length: 4.7, segments: 12}
      Rgb: MarketIron
    }
  }
  for i in 0..19 {
    {
      Position: {0, 1.53, (i - 9) * 0.25}
      Rotation: {math.PI / 2, 0, 0}
      Cylinder: {radius: 0.13, length: 0.26, segments: 12}
      Rgb: {204, 118, 75}
    }
  }
  chimney {
    Position: {1.3, 1.49, -0.8}
    Box: {0.58, 1.6, 0.66}
    Rgb: {195, 161, 123}
    for row in 0..7 {
      for brick in 0..2 {
        {
          Position: {(brick - 0.5) * 0.29, (row - 3) * 0.21, 0.34}
          Box: {0.27, 0.185, 0.025}
          Rgb: {172 + row % 3 * 10, 117 + row % 3 * 9, 82}
        }
      }
    }
    {
      Position: {0, 0.83, 0}
      Box: {0.76, 0.17, 0.83}
      Rgb: MarketStone
    }
    for i in 0..2 {
      {
        Position: {(i - 0.5) * 0.34, 1.06, 0}
        Tube: {radius: 0.13, thickness: 0.035, length: 0.35, segments: 12}
        Rgb: {160, 87, 59}
      }
    }
  }
}

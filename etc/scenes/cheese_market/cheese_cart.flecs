include materials
include crate
include cheese_wheel
include milk_can
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.text

assets {
  template CheeseCart {
    for i in 0..7 {
      {
        Position: {(i - 3) * 0.26, 0.78, 0}
        Box: {0.245, 0.14, 2.5}
        Rgb: MarketHoney
      }
    }
    for side in 0..2 {
      for row in 0..3 {
        {
          Position: {(side - 0.5) * 1.85, 0.98 + row * 0.17, 0}
          Box: {0.075, 0.12, 2.55}
          Rgb: MarketHoney
        }
      }
      for end in 0..2 {
        {
          Position: {(side - 0.5) * 1.85, 1.1, (end - 0.5) * 2.4}
          Box: {0.11, 0.83, 0.11}
          Rgb: MarketOak
        }
      }
      "wheel_{side}" {
        Position: {(side - 0.5) * 2.12, 0.6, 0.3}
        Rotation: {0, 0, math.PI / 2}
        Torus: {radius: 0.52, tube: 0.075, segments: 24, rings: 8}
        Rgb: MarketOak
        rim {
          Position: {}
          Torus: {radius: 0.57, tube: 0.027, segments: 24, rings: 6}
          Rgb: MarketIron
        }
        hub {
          Position: {}
          Cylinder: {radius: 0.13, length: 0.25, segments: 12}
          Rgb: MarketIron
        }
        for spoke in 0..10 {
          {
            Rotation: {0, spoke * math.PI / 5, 0}
            Position: {math.sin(spoke * math.PI / 5) * 0.28, 0, math.cos(spoke * math.PI / 5) * 0.28}
            Box: {0.055, 0.065, 0.49}
            Rgb: MarketHoney
          }
        }
      }
      {
        Position: {(side - 0.5) * 1.3, 0.75, 2.05}
        Rotation: {-0.08, 0, 0}
        Box: {0.09, 0.1, 2.1}
        Rgb: MarketOak
      }
    }
    MarketCrate() { Position: {0, 0.86, -0.68} }
    MarketCrate() { Position: {0, 1.44, -0.68}; Rotation: {0, 0.08, 0} }
    CheeseWheel(radius: 0.58, height: 0.32) { Position: {0, 0.86, 0.5} }
    CheeseWheel(radius: 0.49, height: 0.26) { Position: {0.04, 1.19, 0.5} }
    MilkCan() { Position: {-0.51, 0.87, -0.03}; Scale: {0.7, 0.7, 0.7} }
  }
}

include materials
include beam
include flower_pot
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.text

assets {
  template MarketTree {
    prop variant: i32 = 0

    planter {
      Position: {0, 0.25, 0}
      Cylinder: {radius: 1, length: 0.5, segments: 12}
      Rgb: MarketStone
    }
    soil {
      Position: {0, 0.51, 0}
      Cylinder: {radius: 0.86, length: 0.04, segments: 24}
      Rgb: {89, 94, 58}
    }
    trunk {
      Position: {0, 1.78, 0}
      Rotation: {0.04, 0, -0.07}
      Frustum: {radius_bottom: 0.18, radius_top: 0.09, length: 2.6, segments: 10}
      Rgb: MarketOak
    }
    for branch in 0..7 {
      const angle = branch * 2.4 + variant
      const bx = math.cos(angle) * 0.85
      const bz = math.sin(angle) * 0.85
      const by = 2.6 + branch % 3 * 0.35
      MarketBeam(ay: 1.9, bx: bx, by: by, bz: bz, radius: 0.065, tint: MarketOak);
      {
        Position: {bx, by + 0.15, bz}
        Scale: {1.1, 0.78, 1}
        IcoSphere: {radius: 0.49, segments: 2, smooth: true}
        Rgb: {98 + branch % 3 * 9, 131 + branch % 3 * 10, 68 + branch % 3 * 5}
      }
      for leaf in 0..18 {
        const a = leaf * 2.4 + angle
        {
          Position: {bx + math.cos(a) * 0.58, by + 0.17 + math.sin(leaf * 1.7) * 0.39, bz + math.sin(a) * 0.58}
          Rotation: {0.5, a, 0.5}
          Scale: {0.1, 0.027, 0.25}
          Sphere: {radius: 1, segments: 8, smooth: true}
          Rgb: {121 + leaf % 3 * 9, 151 + leaf % 3 * 7, 80 + leaf % 3 * 7}
          DiffuseTransmission: {factor: 0.35, color: {220, 255, 160}, thickness: 0.05}
        }
      }
    }
    for i in 0..5 {
      FlowerPot(size: 0.6) {
        Position: {math.sin(i * 1.257) * 0.7, 0.46, math.cos(i * 1.257) * 0.7}
      }
    }
  }
}

include shipyard/ships
include shipyard/state
include shipyard/liner
include shipyard/ops
include shipyard/slot
include shipyard/cell
include shipyard/stage
include shipyard/logic
include shipyard/camera
include ui/widgets
include shipyard/hud
include shipyard/ops_hud
include shipyard/screen

using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.spatial
using box.texture
using box.transition
using state
using assets

assets {
  yard_stars {
    EnvironmentImage: {path: "etc/scenes/shipyard/assets/space.hdr"}
    Environment: {resolution: 1024}
  }
}

$ {
  box.app.FpsTarget: {60}
  Scene: {environment: true, blend_modes: true, transmission: true, fresnel: true, distortion: true}
  AmbientLight: {sky: {120, 140, 180}, ground: {50, 60, 84}, intensity: 0.4}
}

window { Surface: {width: 1600, height: 1000, vsync: true} }

rig {
  Position: {cam_x, cam_y, cam_z}
  Rotation: {0, cam_yaw, 0}
  arm {
    Rotation: {0 - cam_pitch, 0, 0}
    eye {
      Position: {0, 0, cam_dist}
      Camera: {
        fov: 38,
        near_: liner ? 0.3 * LINER_SCALE : 0.3,
        far_: liner ? 3000 * LINER_SCALE : 3000
      }
    }
  }
}

sun {
  Rotation: {0.7, 0.42, 0}
  DirectionalLight: {intensity: 6}
  Rgb: {255, 244, 226}
}

rim {
  Rotation: {0.35, 3.7, 0}
  DirectionalLight: {intensity: 1.8}
  Rgb: {110, 160, 255}
}

view {
  yard_contact { Gtao: {radius: liner ? 0.9 * LINER_SCALE : 0.9, final_value_power: 2.2} }
  yard_bloom { Bloom: {intensity: 0.2, threshold: 1.1, threshold_softness: 0.45} }
  yard_film { Tonemap: {operator_: TonyMcMapface} }
  yard_edges { Smaa: {} }

  View: {
    camera: rig.arm.eye,
    clear: {enabled: true, color: {3, 5, 10, 255}},
    shadows: {
      enabled: true,
      cascades: 3,
      resolution: 1024,
      max_distance: liner ? 200 * LINER_SCALE : 200,
      filter_size: 2
    },
    lighting: {
      reflections: true,
      baked: false,
      environment: {source: assets.yard_stars, intensity: 0.7, background: true}
    },
    effects: [
      {effect: yard_contact},
      {effect: yard_bloom},
      {effect: yard_film},
      {effect: yard_edges}
    ]
  }
}

yard {
  // The yard of liner mode, authored at 10 m to the unit as the segments of a liner, is scaled
  // by LINER_SCALE to the liner. Its texture frame at the origin maps the drydock as the world
  // did.
  if liner {
    liner_units {
      Position: {0, 0, 0}
      Scale: {LINER_SCALE, LINER_SCALE, LINER_SCALE}
      texture.Frame

      if show_gantry {
        Drydock dock()
      }

      if tool > 0 {
        SpineGuide spine_guide(l: lane)
      }
    }
  } else {
    if show_gantry {
      Slipway slipway()
    }

    BuildFrame frame()

    if tool > 0 {
      DeckGrid deck_grid(level: deck)
    }
  }

  // The backdrop keeps its size to the camera, which frames a liner from 10 times as far.
  const backdrop = liner ? LINER_SCALE : 1
  YardPlanet planet() {
    Position: {-1100 * backdrop, -760 * backdrop, -1500 * backdrop}
    Scale: {backdrop, backdrop, backdrop}
  }
}

if liner {
  YardLiner yard_liner()
} else {
  // The editor draws the modules of the deck it works on itself, so the instance leaves them out.
  const views = rig_views(yard_design, deck)

  Rig rig_ship(design: yard_design, burning: burning, cut: deck, skip: deck, power: rig_power()) {
    for i in 0..CELLS {
      ShipCell "edit_{i}"(idx: i, v: views[i])
    }
  }
}

ShipyardHud hud()

using flecs.script
using flecs.script.math
using box.input

// The constants of the infinite forest and the state its parts share: where the walk starts, the
// streaming radii around the focus (the player, walking or flying), the sizes and heights of
// the terrain features and the snow line of the peaks.
state {
  // The player starts on a trail in a clearing: the one nearest to START_X, START_Z (absolute
  // world meters) within START_SEARCH, sought every START_STEP meters, looking along the trail
  export const START_X: f32 = 0
  export const START_Z: f32 = 0
  export const START_SEARCH: f32 = 180
  export const START_STEP: f32 = 5

  // Eye height above the ground, walking and running speed and the jumps a climb takes
  export const EYE: f32 = 1.7
  export const WALK_SPEED: f32 = 4
  export const RUN_SPEED: f32 = 8
  export const CLIMB: i32 = 6
  export const FLY_SPEED: f32 = 30

  // Streaming radii around the focus, whatever entity it is. The terrain draws its finest tiles
  // of TERRAIN_TILE within TERRAIN_DETAIL and doubles them TERRAIN_LEVELS - 1 times, so its
  // coarsest tiles reach TERRAIN_DETAIL * 2^(TERRAIN_LEVELS - 1); the CPU heights the player
  // walks on are at TERRAIN_QUERY_SPACING within TERRAIN_QUERY_RADIUS, and the heights the
  // cells of the stands and the undergrowth ask for further out stay TERRAIN_QUERY_HOLD frames,
  // so the cells next to them share them. The reflection probe recaptures above the focus
  // every PROBE_FOLLOW meters
  export const TERRAIN_TILE: f32 = 16
  export const TERRAIN_RESOLUTION: i32 = 33
  export const TERRAIN_LEVELS: i32 = 9
  export const TERRAIN_DETAIL: f32 = 80
  export const TERRAIN_BUDGET: i32 = 24
  export const TERRAIN_QUERY_SPACING: f32 = 0.5
  export const TERRAIN_QUERY_RADIUS: f32 = 128
  export const TERRAIN_QUERY_HOLD: i32 = 1200
  export const PROBE_FOLLOW: f32 = 24
  export const VIEW_FAR: f32 = 24000

  // Bounds of the heights of the terrain in meters, for the culling of its tiles
  export const GROUND_MIN: f32 = -20
  export const GROUND_MAX: f32 = 900

  // The brooks (terrain.flecs, brooks.flecs) run along the edges of cells of about BROOK_SIZE
  // meters, their beds BROOK_SINK meters under the ground around them. Their beds step down in
  // terraces of BROOK_STEP meters with the water BROOK_DEPTH
  // over each, so the water of a terrace hides under the bed of the one above it. The heights of
  // the land and the values of the brooks that the cells read come from a second terrain that
  // draws no tiles, BROOK_DATA_DROP meters under the land, whose CPU heights reach
  // BROOK_QUERY_RADIUS around the focus
  export const BROOK_SIZE: f32 = 420
  export const BROOK_STEP: f32 = 0.3
  export const BROOK_DEPTH: f32 = 0.2
  export const BROOK_DATA_DROP: f32 = 1000
  export const BROOK_QUERY_RADIUS: f32 = 96
  export const BROOK_SINK: f32 = 1.8

  // The cliffs of the terrain stand in strata of STRATA_PERIOD meters
  export const STRATA_PERIOD: f32 = 30

  // Peaks above SNOW_LINE carry snow, more of it higher up, filling the band of SNOW_FADE
  // meters above it in winter, and above BARREN_LINE the ground is scree
  export const SNOW_LINE: f32 = 330
  export const SNOW_FADE: f32 = 320
  export const BARREN_LINE: f32 = 400

  // Whether the player flies with the camera controller instead of walking, toggled by F
  export mut flying: bool = false

  // Whether a script moves the player instead of either controller, as the course of the long
  // walk and flight does (course.flecs)
  export mut scripted: bool = false

  actions {
    toggle_fly {
      Action: {description: "Switch between walking and flying"}
      Binding: {key: F}
    }
  }
}

async {
  while true {
    await on.pressed(state.actions.toggle_fly)
    state.flying = !state.flying
  }
}

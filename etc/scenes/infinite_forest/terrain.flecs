using flecs.script
using flecs.script.math
using box.material
using box.texture
using box.terrain
using box.render
using state
using assets

// The ground of the infinite forest: an endless Terrain whose heights and masks are texture graphs over
// the absolute world (DomainWorld), so it never repeats and stays the same across shifts of the
// WorldOrigin.
//
// Heights in meters, from the largest features to the smallest:
// - the regional relief: low frequency noise, the uplands and lowlands kilometers apart
// - mountain ranges: chains along a stretched and warped very low frequency noise, ridged noise
//   with sharpened crests on them and gullies worn down their sides (TexErosion), rising several
//   hundred meters over foothills the chains lift
// - valleys: the brooks run along the edges between the cells of a TexCells of BROOK_SIZE, and
//   the ground rises from every brook to the hills between them, higher where a noise says, so
//   a brook always runs on the floor of its valley and down the regional relief
// - cliffs: the ground before the bumps is cut into strata of STRATA_PERIOD meters, each a
//   bench, a talus and a cliff band over it with a thin ledge above, so cliffs follow the
//   contours of the valley sides as escarpments do. A folding noise tilts the strata and another
//   one wiggles the cliff line, and crags break up their faces. They stand where a noise lets
//   them and the slope beneath is steep enough, and give way on the valley floors and where the
//   trails cross them
// - the forest floor: bumps outside the clearings and the valley floors
// - clearings: the cells of a TexCells nearest their point, for about half of the cells,
//   flattened (no bumps)
// - trails: the edges between the cells of another TexCells (CellsEdge), sunk a little into the
//   ground
// - landmark sites: near the points of a third TexCells, on flat ground, the hollow of a pond or
//   a knoll in a small glade, for the landmarks of landmarks.flecs
// - brooks: a bed sunk BROOK_SINK under the regional relief, leveled across the brook
//   and stepped in terraces of BROOK_STEP along it, with banks that rise to the valley floor.
//   They spring below the uplands and end toward the mountain ranges
// The TexCells of the clearings, the trails and the brooks read warped coordinates, so the
// clearings are not round and the trails and the brooks wind.
//
// Masks, four weights that add up to 1 and paint the TextureBlend of materials.flecs:
// red the forest floor, green the grass of the clearings, the glades and the alpine meadows
// (where later scatter keeps the trees out), blue the dirt of the trails, the scree under the
// cliffs, on the mountain slopes and above BARREN_LINE, the beds of the ponds and the banks of
// the brooks, alpha the bedded rock of the cliffs and the steep slopes and the stones of the
// beds of the brooks.
//
// The brooks of brooks.flecs read infinite_forest.brooks, a second Terrain of the same graph that only
// serves queries and draws no tiles: its height is that of the land BROOK_DATA_DROP meters
// lower, and its masks are the brook values the land has no channel left for: red the meters to
// the middle of the nearest brook, green the height of the bed there.
infinite_forest {
  land {
    coords { nodes.Coords: {} }

    // Regional relief
    base_n { nodes.Noise: {frequency: 0.00045, octaves: 2, seed: 23} }
    base_h { nodes.Multiply: {a: base_n, b_value: {150, 150, 150, 150}} }

    // Mountain ranges: chains of a stretched, warped noise, ridged noise with sharpened crests
    // on them, gullies worn down their sides and foothills under them
    chain_c { nodes.Transform: {angle_value: 35, scale: {1, 0.4, 1}} }
    chain_w { nodes.Noise: {channels: 3, frequency: 0.00035, octaves: 2, seed: 53} }
    chain { nodes.Warp: {coords: chain_c, offset: chain_w, amount_value: 1400} }
    range_n { nodes.Noise: {coords: chain, frequency: 0.00024, octaves: 2, seed: 51} }
    range {
      nodes.Smoothstep: {input: range_n, edge0_value: {0.54, 0, 0, 0}, edge1_value: {0.72, 0, 0, 0}}
    }

    ridge_w { nodes.Noise: {channels: 3, frequency: 0.0016, octaves: 2, seed: 54} }
    ridge_c { nodes.Warp: {coords: coords, offset: ridge_w, amount_value: 260} }
    ridges {
      nodes.Noise: {coords: ridge_c, frequency: 0.0007, octaves: 6, fractal: NoiseRidged, seed: 52}
    }

    ridges_p { nodes.Power: {a: ridges, b_value: {1.5, 1.5, 1.5, 1.5}} }
    peaks_r { nodes.Multiply: {a: ridges_p, b: range} }
    peaks_m { nodes.Multiply: {a: peaks_r, b_value: {640, 640, 640, 640}} }
    flow_n { nodes.Noise: {coords: ridge_c, frequency: 0.0007, octaves: 2, seed: 52} }
    flow_r { nodes.Multiply: {a: flow_n, b: range} }
    flow_m { nodes.Multiply: {a: flow_r, b_value: {1600, 1600, 1600, 1600}} }
    peaks_g { nodes.Gradient: {height: flow_m} }
    gullies {
      nodes.Erosion: {
        slope: peaks_g,
        frequency: 0.004,
        octaves: 3,
        gain: 0.45,
        scale: 1.6,
        branch: 0.6,
        seed: 55
      }
    }

    peaks_gl { nodes.Length: {input: peaks_g} }
    gully_s {
      nodes.Smoothstep: {input: peaks_gl, edge0_value: {0.3, 0, 0, 0}, edge1_value: {0.9, 0, 0, 0}}
    }

    gully_r { nodes.Multiply: {a: peaks_r, b: gully_s} }
    gully_d { nodes.Multiply: {a: gully_r, b_value: {60, 60, 60, 60}} }
    gully_h { nodes.Multiply: {a: gullies, b: gully_d} }
    peaks_h { nodes.Add: {a: peaks_m, b: gully_h} }
    foothills_h { nodes.Multiply: {a: range, b_value: {90, 90, 90, 90}} }

    // The cells of the clearings and the trails are warped by a noise, so the clearings are not
    // round and the trails wind
    meander { nodes.Noise: {channels: 3, frequency: 0.004, octaves: 2, seed: 25} }
    warped { nodes.Warp: {coords: coords, offset: meander, amount_value: 36} }

    // Clearings: near the point of about half of the cells, fading out at their rim
    clear_cells { nodes.Cells: {distance: CellsNearest, size: 300, seed: 31, coords: warped} }
    clear_d { nodes.Split: {input: clear_cells, channel: ChannelR} }
    clear_r { nodes.Split: {input: clear_cells, channel: ChannelB} }
    clear_in {
      nodes.Smoothstep: {input: clear_d, edge0_value: {0.19, 0, 0, 0}, edge1_value: {0.11, 0, 0, 0}}
    }

    clear_kept {
      nodes.Smoothstep: {input: clear_r, edge0_value: {0.5, 0, 0, 0}, edge1_value: {0.46, 0, 0, 0}}
    }

    clearing { nodes.Multiply: {a: clear_in, b: clear_kept} }

    // Brooks along the edges between the cells of a TexCells of BROOK_SIZE meters, warped twice
    // so they bend and meander: brook_x is F2 - F1 in meters, 0 on an edge, and over the length
    // of its gradient it is about the meters to the edge, brook_d0. The blur and the floor of the
    // length keep that from growing where the texels straddle the edge. Toward the mountain
    // ranges and in the uplands brook_d grows, so a brook narrows and ends before them
    brook_bend { nodes.Noise: {channels: 3, frequency: 0.0025, octaves: 2, seed: 81} }
    brook_bent { nodes.Warp: {coords: coords, offset: brook_bend, amount_value: 60} }
    brook_wind { nodes.Noise: {channels: 3, frequency: 0.011, octaves: 2, seed: 82} }
    brook_coords { nodes.Warp: {coords: brook_bent, offset: brook_wind, amount_value: 18} }
    brook_near {
      nodes.Cells: {distance: CellsNearest, size: BROOK_SIZE, seed: 83, coords: brook_coords}
    }

    brook_second {
      nodes.Cells: {distance: CellsSecond, size: BROOK_SIZE, seed: 83, coords: brook_coords}
    }

    brook_f1 { nodes.Split: {input: brook_near, channel: ChannelR} }
    brook_f2 { nodes.Split: {input: brook_second, channel: ChannelR} }
    brook_e { nodes.Subtract: {a: brook_f2, b: brook_f1} }
    brook_x {
      nodes.Multiply: {a: brook_e, b_value: {BROOK_SIZE, BROOK_SIZE, BROOK_SIZE, BROOK_SIZE}}
    }

    brook_g { nodes.Gradient: {height: brook_x} }
    brook_gl { nodes.Length: {input: brook_g} }
    brook_gb { nodes.Blur: {input: brook_gl, radius: 3} }
    brook_gc { nodes.Max: {a: brook_gb, b_value: {0.7, 0.7, 0.7, 0.7}} }
    brook_d0 { nodes.Divide: {a: brook_x, b: brook_gc} }

    // The valleys: the ground rises from every brook to the hills between them, as high as a
    // noise says, wider or narrower along the brook. Away from the brook the length of the
    // gradient jumps where the second nearest cell changes, so the valleys read F2 - F1 itself,
    // vale_x, about the meters to the brook and without jumps
    hill_n { nodes.Noise: {frequency: 0.0011, octaves: 2, seed: 26} }
    hill_amp {
      nodes.Remap: {
        input: hill_n, from_min: 0.25, from_max: 0.75, to_min: 10, to_max: 55, clamp: true
      }
    }

    width_n { nodes.Noise: {frequency: 0.004, octaves: 2, seed: 28} }

    width_k {
      nodes.Remap: {
        input: width_n, from_min: 0.25, from_max: 0.75, to_min: 0.6, to_max: 1.5, clamp: true
      }
    }

    vale_x { nodes.Multiply: {a: brook_x, b_value: {0.55, 0.55, 0.55, 0.55}} }
    vale_d { nodes.Multiply: {a: vale_x, b: width_k} }
    vale {
      nodes.Curve: {input: vale_d, curve: {kind: CurveCatmullRom, keys: [
        {0, 0}, {8, 0.01}, {20, 0.05}, {45, 0.22}, {80, 0.55}, {120, 0.85}, {170, 1}, {400, 1}
      ]}}
    }

    vale_a { nodes.Multiply: {a: vale, b: hill_amp} }
    spur_n { nodes.Noise: {frequency: 0.0045, octaves: 3, seed: 29} }
    spur_c { nodes.Remap: {input: spur_n, from_min: 0.2, from_max: 0.8, to_min: -0.5, to_max: 0.5} }
    spur_a { nodes.Multiply: {a: spur_c, b: hill_amp} }
    spur_h { nodes.Multiply: {a: spur_a, b: vale} }
    vale_h { nodes.Add: {a: vale_a, b: spur_h} }

    brook_ranges {
      nodes.Smoothstep: {input: range_n, edge0_value: {0.53, 0, 0, 0}, edge1_value: {0.58, 0, 0, 0}}
    }

    brook_uplands {
      nodes.Smoothstep: {input: base_n, edge0_value: {0.64, 0, 0, 0}, edge1_value: {0.74, 0, 0, 0}}
    }

    brook_away { nodes.Max: {a: brook_ranges, b: brook_uplands} }
    brook_far { nodes.Multiply: {a: brook_away, b_value: {200, 200, 200, 200}} }
    brook_d { nodes.Add: {a: brook_d0, b: brook_far} }

    // Within about 40 meters of a brook the sites give way
    brook_dv { nodes.Add: {a: vale_x, b: brook_far} }
    brook_v {
      nodes.Smoothstep: {input: brook_dv, edge0_value: {40, 0, 0, 0}, edge1_value: {16, 0, 0, 0}}
    }

    brook_open { nodes.Subtract: {a_value: {1, 1, 1, 1}, b: brook_v} }

    // Trails along the edges of the cells: 1 on the trail, 0 off it, and a wider band along them
    // where the cliffs give way

    trail_cells {
      nodes.Cells: {distance: CellsEdge, size: 190, edge: 0.1, seed: 61, coords: warped}
    }

    trail_e { nodes.Split: {input: trail_cells, channel: ChannelR} }
    track {
      nodes.Remap: {
        input: trail_e, from_min: 0.03, from_max: 0.1, to_min: 1, to_max: 0, clamp: true
      }
    }

    pass_cells {
      nodes.Cells: {distance: CellsEdge, size: 190, edge: 0.5, seed: 61, coords: warped}
    }

    pass_d { nodes.Split: {input: pass_cells, channel: ChannelR} }
    pass_e {
      nodes.Smoothstep: {input: pass_d, edge0_value: {0.05, 0, 0, 0}, edge1_value: {0.7, 0, 0, 0}}
    }

    pre_a { nodes.Add: {a: base_h, b: vale_h} }
    pre { nodes.Add: {a: pre_a, b: foothills_h} }

    // Cliffs: the strata are the ground tilted by a folding noise, its contours wiggled by a
    // noise as far sideways at every slope. strata_t steps each period into a bench, a talus, a
    // cliff band and a thin ledge, and the cliffs move the ground by the difference
    pre_slope { nodes.Slope: {height: pre} }
    fold_n { nodes.Noise: {frequency: 0.0004, octaves: 2, seed: 27} }
    fold_h { nodes.Multiply: {a: fold_n, b_value: {24, 24, 24, 24}} }
    jag_n { nodes.Noise: {frequency: 0.01, octaves: 3, seed: 43} }
    jag_m { nodes.Remap: {input: jag_n, from_min: 0.2, from_max: 0.8, to_min: -16, to_max: 16} }
    jag_h { nodes.Multiply: {a: jag_m, b: pre_slope} }
    strata_a { nodes.Add: {a: pre, b: fold_h} }
    strata_s { nodes.Add: {a: strata_a, b: jag_h} }
    strata_q {
      nodes.Divide: {
        a: strata_s, b_value: {STRATA_PERIOD, STRATA_PERIOD, STRATA_PERIOD, STRATA_PERIOD}
      }
    }

    strata_f { nodes.Fract: {input: strata_q} }

    // Where the cliffs stand: where the noise lets them, the ground beneath is steep enough but
    // not as steep as a mountainside, away from the valley floors and the trails. On steeper
    // ground the strata step more gently (strata_soft), so the faces stay wider than the
    // spacing of the heights of the far tiles
    hard_n { nodes.Noise: {frequency: 0.0009, octaves: 2, seed: 46} }
    hard_r {
      nodes.Smoothstep: {input: hard_n, edge0_value: {0.42, 0, 0, 0}, edge1_value: {0.56, 0, 0, 0}}
    }

    hard_v {
      nodes.Smoothstep: {input: vale_x, edge0_value: {18, 0, 0, 0}, edge1_value: {60, 0, 0, 0}}
    }

    hard_s {
      nodes.Smoothstep: {input: pre_slope, edge0_value: {0.1, 0, 0, 0}, edge1_value: {0.2, 0, 0, 0}}
    }

    hard_t {
      nodes.Smoothstep: {input: pre_slope, edge0_value: {0.8, 0, 0, 0}, edge1_value: {0.5, 0, 0, 0}}
    }

    hard_a { nodes.Multiply: {a: hard_r, b: hard_v} }
    hard_st { nodes.Multiply: {a: hard_s, b: hard_t} }
    hard_b { nodes.Multiply: {a: hard_a, b: hard_st} }
    hard { nodes.Multiply: {a: hard_b, b: pass_e} }

    // The values both the heights and the masks read, packed so a stage of the graph reads
    // them as one input
    cliff_pack { nodes.Combine: {r: strata_f, g: hard, b: track, a: brook_d} }
    strata_fp { nodes.Split: {input: cliff_pack, channel: ChannelR} }
    hard_p { nodes.Split: {input: cliff_pack, channel: ChannelG} }
    track_p { nodes.Split: {input: cliff_pack, channel: ChannelB} }
    brook_dp { nodes.Split: {input: cliff_pack, channel: ChannelA} }

    strata_sharp {
      nodes.Curve: {input: strata_fp, curve: {keys: [
        {0, 0}, {0.2, 0.05}, {0.38, 0.1}, {0.45, 0.15}, {0.5, 0.23}, {0.52, 0.29}, {0.535, 0.42},
        {0.553, 0.6}, {0.57, 0.7}, {0.59, 0.745}, {0.62, 0.765}, {0.8, 0.8}, {0.845, 0.845},
        {0.86, 0.87}, {0.87, 0.92}, {0.882, 0.95}, {0.9, 0.965}, {1, 1}
      ]}}
    }

    strata_soft {
      nodes.Curve: {input: strata_fp, curve: {keys: [
        {0, 0}, {0.2, 0.05}, {0.36, 0.1}, {0.42, 0.15}, {0.47, 0.23}, {0.5, 0.29}, {0.53, 0.42},
        {0.57, 0.6}, {0.61, 0.7}, {0.64, 0.745}, {0.68, 0.765}, {0.8, 0.8}, {0.84, 0.845},
        {0.86, 0.87}, {0.88, 0.92}, {0.9, 0.95}, {0.93, 0.965}, {1, 1}
      ]}}
    }

    soft_k {
      nodes.Smoothstep: {
        input: pre_slope, edge0_value: {0.2, 0, 0, 0}, edge1_value: {0.45, 0, 0, 0}
      }
    }

    strata_t { nodes.Mix: {a: strata_sharp, b: strata_soft, factor: soft_k} }

    strata_dt { nodes.Subtract: {a: strata_t, b: strata_fp} }
    strata_dev {
      nodes.Multiply: {
        a: strata_dt, b_value: {STRATA_PERIOD, STRATA_PERIOD, STRATA_PERIOD, STRATA_PERIOD}
      }
    }

    trail_h { nodes.Multiply: {a: track_p, b_value: {-0.35, -0.35, -0.35, -0.35}} }
    cliffs_h { nodes.Multiply: {a: strata_dev, b: hard_p} }

    face_lo {
      nodes.Smoothstep: {
        input: strata_fp, edge0_value: {0.5, 0, 0, 0}, edge1_value: {0.53, 0, 0, 0}
      }
    }

    face_hi {
      nodes.Smoothstep: {
        input: strata_fp, edge0_value: {0.62, 0, 0, 0}, edge1_value: {0.57, 0, 0, 0}
      }
    }

    face_b { nodes.Multiply: {a: face_lo, b: face_hi} }
    face { nodes.Multiply: {a: face_b, b: hard_p} }
    crags { nodes.Noise: {frequency: 0.06, octaves: 3, seed: 44} }
    crags_c { nodes.Remap: {input: crags, from_min: 0.25, from_max: 0.75, to_min: -2, to_max: 2} }
    crags_h { nodes.Multiply: {a: crags_c, b: face} }
    cliffs_c { nodes.Add: {a: cliffs_h, b: crags_h} }
    h1 { nodes.Add: {a: pre, b: cliffs_c} }
    h5 { nodes.Add: {a: h1, b: peaks_h} }

    // Landmark sites: near the point of some cells of a third TexCells, on gentle ground away
    // from the cliffs, a pond in a hollow or a knoll, each in a small glade. The points keep to
    // the middle of their cells (jitter), so a site never reaches the edge of its cell. The
    // slope is that of the ground before the cliffs and the bumps, which changes little across a
    // site and keeps it whole.
    site_cells { nodes.Cells: {distance: CellsNearest, size: 230, jitter: 0.5, seed: 71} }
    site_d { nodes.Split: {input: site_cells, channel: ChannelR} }
    site_r { nodes.Split: {input: site_cells, channel: ChannelB} }
    site_level {
      nodes.Smoothstep: {
        input: pre_slope, edge0_value: {0.2, 0, 0, 0}, edge1_value: {0.12, 0, 0, 0}
      }
    }

    site_solid { nodes.Subtract: {a_value: {1, 1, 1, 1}, b: hard_p} }
    site_flat { nodes.Multiply: {a: site_level, b: site_solid} }

    pond_r {
      nodes.Smoothstep: {
        input: site_r, edge0_value: {0.145, 0, 0, 0}, edge1_value: {0.135, 0, 0, 0}
      }
    }

    site_r_in {
      nodes.Smoothstep: {
        input: site_r, edge0_value: {0.405, 0, 0, 0}, edge1_value: {0.395, 0, 0, 0}
      }
    }

    site_any { nodes.Multiply: {a: site_r_in, b: site_flat} }
    pond_sel { nodes.Multiply: {a: pond_r, b: site_flat} }
    site_pack { nodes.Combine: {r: clearing, g: site_d, b: site_any, a: pond_sel} }
    clearing_p { nodes.Split: {input: site_pack, channel: ChannelR} }
    site_dp { nodes.Split: {input: site_pack, channel: ChannelG} }
    site_any_p { nodes.Split: {input: site_pack, channel: ChannelB} }
    pond_p { nodes.Split: {input: site_pack, channel: ChannelA} }
    knoll_sel { nodes.Subtract: {a: site_any_p, b: pond_p} }

    // The packed values again for the masks, and the glades
    strata_fm { nodes.Split: {input: cliff_pack, channel: ChannelR} }
    hard_m { nodes.Split: {input: cliff_pack, channel: ChannelG} }
    track_m { nodes.Split: {input: cliff_pack, channel: ChannelB} }
    brook_dm { nodes.Split: {input: cliff_pack, channel: ChannelA} }
    clearing_m { nodes.Split: {input: site_pack, channel: ChannelR} }
    site_dm { nodes.Split: {input: site_pack, channel: ChannelG} }
    site_any_m { nodes.Split: {input: site_pack, channel: ChannelB} }
    pond_m { nodes.Split: {input: site_pack, channel: ChannelA} }
    glade_in_m {
      nodes.Smoothstep: {input: site_dm, edge0_value: {0.16, 0, 0, 0}, edge1_value: {0.09, 0, 0, 0}}
    }

    glade_m { nodes.Multiply: {a: glade_in_m, b: site_any_m} }

    // The hollow of the pond, with a flat bed, and the knoll
    hollow {
      nodes.Smoothstep: {input: site_dp, edge0_value: {0.1, 0, 0, 0}, edge1_value: {0.02, 0, 0, 0}}
    }

    hollow_s { nodes.Multiply: {a: hollow, b: pond_p} }
    hollow_h { nodes.Multiply: {a: hollow_s, b_value: {-2.8, -2.8, -2.8, -2.8}} }
    knoll {
      nodes.Smoothstep: {input: site_dp, edge0_value: {0.17, 0, 0, 0}, edge1_value: {0, 0, 0, 0}}
    }

    knoll_s { nodes.Multiply: {a: knoll, b: knoll_sel} }
    knoll_h { nodes.Multiply: {a: knoll_s, b_value: {4.5, 4.5, 4.5, 4.5}} }
    site_k { nodes.Add: {a: hollow_h, b: knoll_h} }
    site_h { nodes.Multiply: {a: site_k, b: brook_open} }

    // The glade of the site, and the mud of the bed of the pond
    glade_in {
      nodes.Smoothstep: {input: site_dp, edge0_value: {0.16, 0, 0, 0}, edge1_value: {0.09, 0, 0, 0}}
    }

    glade { nodes.Multiply: {a: glade_in, b: site_any_p} }
    bed_in {
      nodes.Smoothstep: {
        input: site_dm, edge0_value: {0.075, 0, 0, 0}, edge1_value: {0.055, 0, 0, 0}
      }
    }

    bed { nodes.Multiply: {a: bed_in, b: pond_m} }
    opening { nodes.Max: {a: clearing_p, b: glade} }
    wooded { nodes.Subtract: {a_value: {1, 1, 1, 1}, b: opening} }

    // Bumps of the forest floor, smoothed out in the clearings, the glades and on the valley
    // floors
    bumps { nodes.Noise: {frequency: 0.018, octaves: 3, seed: 22} }
    bumps_c { nodes.Remap: {input: bumps, from_min: 0, from_max: 1, to_min: -3, to_max: 3} }
    bumps_w { nodes.Multiply: {a: bumps_c, b: wooded} }
    bumps_v {
      nodes.Smoothstep: {input: vale_x, edge0_value: {10, 0, 0, 0}, edge1_value: {45, 0, 0, 0}}
    }

    bumps_h { nodes.Multiply: {a: bumps_w, b: bumps_v} }

    h6 { nodes.Add: {a: h5, b: bumps_h} }
    h7 { nodes.Add: {a: h6, b: site_h} }
    h8 { nodes.Add: {a: h7, b: trail_h} }

    // The bed of a brook: the regional relief sunk BROOK_SINK, leveled across the
    // brook by taking the height at the middle (the height less the distance times its slope
    // away from the middle), so the water stands level from bank to bank. It steps down in
    // terraces of BROOK_STEP, and the banks rise from the bed along brook_rise: the water
    // BROOK_DEPTH over a terrace reaches 1.2 to 1.6 meters to either side of the middle. The
    // brook cuts the ground only where it is lower, so the ground keeps its shape further out
    brook_ground_a { nodes.Add: {a: base_h, b: foothills_h} }
    brook_ground { nodes.Add: {a: brook_ground_a, b: peaks_h} }
    brook_sunk {
      nodes.Subtract: {a: brook_ground, b_value: {BROOK_SINK, BROOK_SINK, BROOK_SINK, BROOK_SINK}}
    }

    brook_sg { nodes.Gradient: {height: brook_ground} }
    brook_n { nodes.Normalize: {input: brook_g} }
    brook_tilt { nodes.Dot: {a: brook_sg, b: brook_n} }
    brook_level { nodes.Min: {a: brook_d0, b_value: {8, 8, 8, 8}} }
    brook_lift { nodes.Multiply: {a: brook_tilt, b: brook_level} }
    brook_bed { nodes.Subtract: {a: brook_sunk, b: brook_lift} }
    brook_q {
      nodes.Divide: {a: brook_bed, b_value: {BROOK_STEP, BROOK_STEP, BROOK_STEP, BROOK_STEP}}
    }

    brook_qf { nodes.Floor: {input: brook_q} }
    brook_steps {
      nodes.Multiply: {a: brook_qf, b_value: {BROOK_STEP, BROOK_STEP, BROOK_STEP, BROOK_STEP}}
    }

    brook_rise {
      nodes.Curve: {input: brook_dp, curve: {kind: CurveCatmullRom, keys: [
        {0, -0.5}, {0.9, -0.42}, {1.5, 0.1}, {2.2, 0.6}, {3, 1}, {4.5, 1.35}, {8, 1.9},
        {14, 3.2}, {22, 5}, {32, 8}, {45, 16}, {60, 40}, {80, 200}, {100, 1000}
      ]}}
    }

    brook_bank { nodes.Add: {a: brook_bed, b: brook_rise} }
    brook_cut { nodes.Max: {a: brook_steps, b: brook_bank} }
    height { nodes.Min: {a: h8, b: brook_cut} }

    // Rock on the cliffs and the steep slopes
    slope { nodes.Slope: {height: height} }
    rock {
      nodes.Smoothstep: {input: slope, edge0_value: {1, 0, 0, 0}, edge1_value: {1.5, 0, 0, 0}}
    }

    open { nodes.Subtract: {a_value: {1, 1, 1, 1}, b: rock} }

    // Scree on the talus under the cliffs, on the mountain slopes and above BARREN_LINE
    foot_lo {
      nodes.Smoothstep: {
        input: strata_fm, edge0_value: {0.36, 0, 0, 0}, edge1_value: {0.44, 0, 0, 0}
      }
    }

    foot_hi {
      nodes.Smoothstep: {
        input: strata_fm, edge0_value: {0.57, 0, 0, 0}, edge1_value: {0.53, 0, 0, 0}
      }
    }

    foot_b { nodes.Multiply: {a: foot_lo, b: foot_hi} }
    foot_s {
      nodes.Smoothstep: {input: slope, edge0_value: {0.2, 0, 0, 0}, edge1_value: {0.45, 0, 0, 0}}
    }

    foot_h { nodes.Multiply: {a: foot_b, b: hard_m} }
    foot { nodes.Multiply: {a: foot_h, b: foot_s} }
    talus_s {
      nodes.Smoothstep: {input: slope, edge0_value: {0.48, 0, 0, 0}, edge1_value: {0.8, 0, 0, 0}}
    }

    talus { nodes.Multiply: {a: talus_s, b: range} }
    alt_n { nodes.Noise: {frequency: 0.006, octaves: 3, seed: 47} }
    alt_d { nodes.Remap: {input: alt_n, from_min: 0, from_max: 1, to_min: -50, to_max: 50} }
    alt { nodes.Add: {a: height, b: alt_d} }
    barren {
      nodes.Smoothstep: {
        input: alt, edge0_value: {BARREN_LINE - 40, 0, 0, 0},
        edge1_value: {BARREN_LINE + 40, 0, 0, 0}
      }
    }

    scree_a { nodes.Max: {a: foot, b: talus} }
    scree { nodes.Max: {a: scree_a, b: barren} }
    scree_w { nodes.Multiply: {a: scree, b: open} }
    rest_a { nodes.Subtract: {a: open, b: scree_w} }

    // Trails, where the ground is not steep
    trail_w { nodes.Multiply: {a: track_m, b: rest_a} }
    rest_b { nodes.Subtract: {a: rest_a, b: trail_w} }

    // Mud on the bed of the ponds
    bed_w { nodes.Multiply: {a: bed, b: rest_b} }
    rest_c { nodes.Subtract: {a: rest_b, b: bed_w} }

    // The wet earth of the banks of the brooks, and the stones of their beds in the middle
    brook_bank_m {
      nodes.Smoothstep: {input: brook_dm, edge0_value: {5.5, 0, 0, 0}, edge1_value: {2.4, 0, 0, 0}}
    }

    brook_core_m {
      nodes.Smoothstep: {input: brook_dm, edge0_value: {2.4, 0, 0, 0}, edge1_value: {1.2, 0, 0, 0}}
    }

    brook_w { nodes.Multiply: {a: brook_bank_m, b: rest_c} }
    rest_d { nodes.Subtract: {a: rest_c, b: brook_w} }
    brook_core_w { nodes.Multiply: {a: brook_w, b: brook_core_m} }
    brook_stone_w { nodes.Multiply: {a: brook_core_w, b_value: {0.55, 0.55, 0.55, 0.55}} }
    brook_mud_w { nodes.Subtract: {a: brook_w, b: brook_stone_w} }

    // Grass in the clearings, the glades and above the tree line
    alpine {
      nodes.Smoothstep: {input: alt, edge0_value: {210, 0, 0, 0}, edge1_value: {300, 0, 0, 0}}
    }

    meadow_a { nodes.Max: {a: clearing_m, b: alpine} }
    meadow { nodes.Max: {a: meadow_a, b: glade_m} }
    grass_w { nodes.Multiply: {a: meadow, b: rest_d} }
    floor_w { nodes.Subtract: {a: rest_d, b: grass_w} }

    scree_dirt { nodes.Multiply: {a: scree_w, b_value: {0.85, 0.85, 0.85, 0.85}} }
    scree_rock { nodes.Multiply: {a: scree_w, b_value: {0.15, 0.15, 0.15, 0.15}} }
    dirt_a { nodes.Add: {a: trail_w, b: scree_dirt} }
    dirt_b { nodes.Add: {a: dirt_a, b: bed_w} }
    dirt_w { nodes.Add: {a: dirt_b, b: brook_mud_w} }
    rock_a { nodes.Add: {a: rock, b: scree_rock} }
    rock_w { nodes.Add: {a: rock_a, b: brook_stone_w} }
    masks { nodes.Combine: {r: floor_w, g: grass_w, b: dirt_w, a: rock_w} }

    Terrain: {
      height: height,
      masks: masks,
      tile_size: TERRAIN_TILE,
      resolution: TERRAIN_RESOLUTION,
      levels: TERRAIN_LEVELS,
      lod_distance: TERRAIN_DETAIL,
      min_height: GROUND_MIN,
      max_height: GROUND_MAX,
      budget: TERRAIN_BUDGET,
      query_spacing: TERRAIN_QUERY_SPACING,
      query_radius: TERRAIN_QUERY_RADIUS,
      query_hold: TERRAIN_QUERY_HOLD
    }

    texture.Blend: {
      layers: [infinite_forest_floor, infinite_forest_grass, infinite_forest_dirt, terrain_cliff],
      heights: [litter_height, infinite_forest_grass_height, path_height, terrain_cliff_height],
      contrast: 6,
      variation: 0.4
    }

    texture.Mapping: {mode: MappingWorld, size: GROUND_MAP_SIZE, blend: 0.15}
    texture.Layers: {layers: [infinite_forest_peak_snow, layer_wet, layer_snow]}
    Rgb: {212, 206, 196}
    PbrMaterial: {roughness: 0.95}

    // What infinite_forest.brooks reads: the land BROOK_DATA_DROP meters lower, the meters to the
    // middle of the nearest brook and the height of its bed
    brook_data_h { nodes.Subtract: {a: height, b_value: {BROOK_DATA_DROP, 0, 0, 0}} }

    brook_data { nodes.Combine: {r: brook_d, g: brook_bed} }
  }

  // The query terrain of the brooks: its CPU heights and masks at the spacing of the land within
  // BROOK_QUERY_RADIUS of the focus, and where the cells of brooks.flecs ask for them
  brooks {
    Terrain: {
      height: infinite_forest.land.brook_data_h,
      masks: infinite_forest.land.brook_data,
      tile_size: 1024,
      resolution: 5,
      levels: 1,
      lod_distance: 3072,
      min_height: GROUND_MIN - BROOK_DATA_DROP,
      max_height: GROUND_MAX - BROOK_DATA_DROP,
      budget: TERRAIN_BUDGET,
      query_spacing: TERRAIN_QUERY_SPACING,
      query_radius: BROOK_QUERY_RADIUS,
      query_only: true,
      query_hold: TERRAIN_QUERY_HOLD
    }
  }
}

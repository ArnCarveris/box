using flecs.script
using flecs.script.math
using box.app
using box.transform
using box.world
using box.terrain
using box.render
using box.texture
using box.layout
using box.text
using box.geometry
using box.material
using state

// The course of the long walk and the long flight (infinite_forest_walk.flecs, infinite_forest_flight.flecs):
// a script moves the player COURSE_LENGTH meters from the start on the trail, in legs that each
// turn from the one before. Walking it keeps to the trails it comes upon, weighing the dirt
// ahead against the heading of its leg, and stays off rock walls; it stands at eye height on the
// terrain at WALK_SPEED. Flying it holds the headings of the legs at COURSE_FLY_SPEED,
// COURSE_FLY_CLEARANCE meters over the highest ground ahead. Every frame moves the player by
// COURSE_FRAME seconds of the world, as a frame at 60 FPS would, however long the frame took:
// the streaming has as much to do per frame as on a real walk, while the frames may run faster
// than real time. The path is kept in absolute meters and written to the player in the frame of
// the WorldOrigin, so the origin shifts as the player goes on.
//
// The course panel (top right, H hides it with the forest panel) shows where the player is and,
// every COURSE_MARK meters, a row of the streaming and the frames since the mark before: origin
// shifts, terrain tiles and their GPU memory, loaded cells of the stands, undergrowth and
// landmarks and the cells loaded per second, instances of the view, texture graphs and their
// pool, the worst frame and the frames over 16.7 and 33.3 ms. Every frame over 16.7 ms is
// counted under what the frame before it did: an origin shift, cells of the grids loaded or
// unloaded, terrain tiles made or dropped, texture graphs made or dropped, or none of those;
// course_hitches lists the worst frame over 33.3 ms of every COURSE_MARK meters with what it did.
state {
  // Length of the course in meters, the distance between two rows of the panel, and the
  // course meters skipped before the run, set by a scene to start further out
  export const COURSE_LENGTH: f32 = 10000
  export const COURSE_KM: f32 = COURSE_LENGTH / 1000
  export const COURSE_MARK: f32 = 500
  export mut course_seek: f32 = 0

  // Whether the course is flown instead of walked, set by infinite_forest_flight.flecs
  export mut course_flight: bool = false

  // World seconds a frame moves the player by
  export const COURSE_FRAME: f32 = 1.0 / 60

  // The walk: the meters ahead whose ground it weighs, the radians between the directions it
  // weighs, the weight of keeping to its leg and the most it turns per meter
  export const COURSE_LOOK: f32 = 12
  export const COURSE_FAN: f32 = 0.12
  export const COURSE_HOLD: f32 = 0.6
  export const COURSE_WALK_CURVE: f32 = 0.05
  export const COURSE_WALK_PITCH: f32 = -0.06

  // The flight: meters per second, meters over the highest ground of the COURSE_FLY_AHEAD meters
  // ahead, the pitch of the view and the most it turns per meter
  export const COURSE_FLY_SPEED: f32 = 40
  export const COURSE_FLY_CLEARANCE: f32 = 70
  export const COURSE_FLY_AHEAD: f32 = 360
  export const COURSE_FLY_PITCH: f32 = -0.16
  export const COURSE_FLY_CURVE: f32 = 0.004

  // The rock mask of the terrain (terrain.flecs) and the steepest ground the walk takes
  export const MASK_ROCK: i32 = 3
  export const COURSE_STEEP: f32 = 0.5

  // Frame intervals in milliseconds over which a frame is slow (a frame of 60 FPS) and a hitch
  // (two)
  export const COURSE_SLOW_MS: f32 = 16.7
  export const COURSE_HITCH_MS: f32 = 33.3

  // The course as it runs, in absolute meters
  export mut course_started: bool = false
  export mut course_done: bool = false
  export mut course_x: f64 = 0
  export mut course_y: f64 = 0
  export mut course_z: f64 = 0
  export mut course_yaw: f64 = 0
  export mut course_leg_yaw: f64 = 0
  export mut course_leg: i32 = 0
  export mut course_leg_end: f64 = 0
  export mut course_distance: f64 = 0
  export mut course_seconds: f64 = 0

  // What the panel shows: the line of the player and a row per mark
  export mut course_now: string = "Waiting for the ground at the start"
  export mut course_log: string = ""
  export mut course_causes: string = ""
  export mut course_hitches: string = ""

  // The legs of the course: the radians each turns from the leg before and its meters, which
  // add up to COURSE_LENGTH
  export const COURSE_LEGS: i32 = 7

  fn course_turn(i: i32) -> f64 {
    match i {
      0: 0
      1: 0.7
      2: -1.1
      3: 0.5
      4: 0.9
      5: -0.6
      _: -0.8
    }
  }

  fn course_leg_length(i: i32) -> f64 {
    match i {
      0: 1400
      1: 1300
      2: 1600
      3: 1200
      4: 1500
      5: 1500
      _: 1500
    }
  }

  // An angle in -PI..PI
  fn course_wrap(a: f64) -> f64 {
    a - 2 * PI * floor((a + PI) / (2 * PI))
  }

  // How good a place is to walk: the dirt of the trails, no rock and no steep ground
  fn course_ground(x: f64, z: f64) -> f64 {
    infinite_forest_mask(x, z, MASK_DIRT) - 1.5 * infinite_forest_mask(x, z, MASK_ROCK) -
      4 * max(0, box.terrain.slope(infinite_forest.land, x, z) - COURSE_STEEP)
  }

  // Cells of the stands, the undergrowth and the landmarks loaded now, or created this frame
  fn course_cells() -> f64 {
    infinite_forest.stands[ChunkGridStatus].cells + infinite_forest.undergrowth[ChunkGridStatus].cells +
      infinite_forest.landmarks[ChunkGridStatus].cells
  }

  fn course_created() -> f64 {
    infinite_forest.stands[ChunkGridStatus].created + infinite_forest.undergrowth[ChunkGridStatus].created +
      infinite_forest.landmarks[ChunkGridStatus].created
  }

  // Cells of the grids that changed level or were deleted this frame, and the milliseconds the
  // grids took
  fn course_changed() -> f64 {
    infinite_forest.stands[ChunkGridStatus].changed + infinite_forest.undergrowth[ChunkGridStatus].changed +
      infinite_forest.landmarks[ChunkGridStatus].changed + infinite_forest.stands[ChunkGridStatus].deleted +
      infinite_forest.undergrowth[ChunkGridStatus].deleted + infinite_forest.landmarks[ChunkGridStatus].deleted
  }

  fn course_grid_ms() -> f64 {
    infinite_forest.stands[ChunkGridStatus].time_ms + infinite_forest.undergrowth[ChunkGridStatus].time_ms +
      infinite_forest.landmarks[ChunkGridStatus].time_ms
  }

  // Texture graphs alive on the backend, 0 before the backend counted them
  fn course_graphs() -> i32 {
    box.texture.graph.Stats.has(box.texture.graph.Stats) ?
      box.texture.graph.Stats[box.texture.graph.Stats].graphs : 0
  }

  fn course_mb(bytes: f64) -> f64 {
    bytes / 1048576
  }
}

// Wait for the player to stand at the start, skip course_seek meters along the legs, then take
// the player off its controllers and move it along the course every frame
async {
  while !state.started {
    await next_frame()
  }

  const o0 = WorldOrigin[WorldOrigin]
  state.course_x = state.start_x + o0.x
  state.course_z = state.start_z + o0.z
  state.course_yaw = state.start_yaw
  state.course_leg_yaw = state.start_yaw
  state.course_leg_end = course_leg_length(0)

  // Skip along the headings of the legs, then wait above the place for the ground
  while state.course_distance + course_leg_length(state.course_leg) <= state.course_seek &&
    state.course_leg < COURSE_LEGS - 1
  {
    const a = state.course_leg_yaw
    const len = course_leg_length(state.course_leg)
    state.course_x = state.course_x - sin(a) * len
    state.course_z = state.course_z - cos(a) * len
    state.course_distance = state.course_distance + len
    state.course_leg = state.course_leg + 1
    state.course_leg_yaw = course_wrap(state.course_leg_yaw + course_turn(state.course_leg))
    state.course_leg_end = state.course_distance + course_leg_length(state.course_leg)
  }

  if state.course_seek > state.course_distance {
    const rest = state.course_seek - state.course_distance
    state.course_x = state.course_x - sin(state.course_leg_yaw) * rest
    state.course_z = state.course_z - cos(state.course_leg_yaw) * rest
    state.course_distance = state.course_seek
  }

  state.course_yaw = state.course_leg_yaw
  state.scripted = true
  if state.course_seek > 0 {
    state.course_now = "Waiting for the ground at {state.course_seek:.0} m"
    while !box.terrain.resident(infinite_forest.land, state.course_x, state.course_z) {
      const o = WorldOrigin[WorldOrigin]
      state.start_x = state.course_x - o.x
      state.start_y = GROUND_MAX - o.y
      state.start_z = state.course_z - o.z
      state.start_yaw = state.course_yaw
      await next_frame()
    }
  }

  const h0 = box.terrain.height(infinite_forest.land, state.course_x, state.course_z)
  state.course_y = h0 + (state.course_flight ? COURSE_FLY_CLEARANCE : EYE)
  state.course_started = true

  mut next_mark: f64 = state.course_distance
  mut next_line: f64 = state.course_distance
  mut mark_seconds: f64 = 0
  mut loads: f64 = 0
  mut worst: f64 = 0
  mut slow: i32 = 0
  mut hitches: i32 = 0
  mut all_worst: f64 = 0
  mut all_worst_km: f64 = 0
  mut all_slow: i32 = 0
  mut all_hitches: i32 = 0
  mut last_y: f64 = state.course_y

  // What the frame before did, and the slow frames counted by it
  mut last_shifts: i32 = WorldOriginStatus[WorldOriginStatus].shifts
  mut last_made: i32 = infinite_forest.land[TerrainStatus].created
  mut last_dropped: i32 = infinite_forest.land[TerrainStatus].dropped
  mut last_graphs: i32 = course_graphs()
  mut slow_shift: i32 = 0
  mut slow_cells: i32 = 0
  mut slow_tiles: i32 = 0
  mut slow_graphs: i32 = 0
  mut slow_none: i32 = 0
  mut hitch_line: string = ""

  while true {
    // Every mark, a row of the streaming and the frames since the mark before
    if state.course_distance >= next_mark {
      const km = next_mark / 1000
      const shifts = WorldOriginStatus[WorldOriginStatus].shifts
      const land = infinite_forest.land[TerrainStatus]
      const tiles_mb = course_mb(land.gpu_bytes)
      const query_mb = course_mb(infinite_forest.land[TerrainQueryStatus].cpu_bytes)
      const cells = course_cells()
      const rate = mark_seconds > 0 ? loads / mark_seconds : 0
      const graphs = course_graphs()
      mut pool_mb: f64 = 0
      if box.texture.graph.Stats.has(box.texture.graph.Stats) {
        pool_mb = course_mb(box.texture.graph.Stats[box.texture.graph.Stats].pool_bytes)
      }

      mut shown: i32 = 0
      if view.has(CullStatus) {
        shown = view[CullStatus].instances
      }

      const tiles = land.count
      state.course_log = state.course_log +
        "{km:.1} km  shifts {shifts}  tiles {tiles} {tiles_mb:.0}+{query_mb:.0} MB  " +
        "cells {cells:.0} {rate:.1}/s  inst {shown}  graphs {graphs} {pool_mb:.0} MB  " +
        "worst {worst:.1} ms  slow {slow}  hitch {hitches}\n"
      state.course_hitches = state.course_hitches + hitch_line
      hitch_line = ""
      next_mark = next_mark + COURSE_MARK
      mark_seconds = 0
      loads = 0
      worst = 0
      slow = 0
      hitches = 0
    }

    if state.course_distance >= COURSE_LENGTH {
      break
    }

    await next_frame()

    // The interval of the frame before and what it did
    const dt = COURSE_FRAME
    const frame_ms = box.app.FrameTiming[box.app.FrameTiming].interval_ms
    const shifts_now = WorldOriginStatus[WorldOriginStatus].shifts
    const land_now = infinite_forest.land[TerrainStatus]
    const graphs_now = course_graphs()
    const made = course_created()
    const changed = course_changed()
    const shifted = shifts_now - last_shifts
    const tiles_made = land_now.created - last_made
    const tiles_dropped = land_now.dropped - last_dropped
    const graphs_delta = graphs_now - last_graphs
    last_shifts = shifts_now
    last_made = land_now.created
    last_dropped = land_now.dropped
    last_graphs = graphs_now

    const section_worst = frame_ms > worst
    worst = max(worst, frame_ms)
    if frame_ms > all_worst {
      all_worst = frame_ms
      all_worst_km = state.course_distance / 1000
    }

    if frame_ms > COURSE_SLOW_MS {
      slow = slow + 1
      all_slow = all_slow + 1
      if shifted > 0 {
        slow_shift = slow_shift + 1
      } else if made + changed > 0 {
        slow_cells = slow_cells + 1
      } else if tiles_made + tiles_dropped > 0 {
        slow_tiles = slow_tiles + 1
      } else if graphs_delta != 0 {
        slow_graphs = slow_graphs + 1
      } else {
        slow_none = slow_none + 1
      }

      state.course_causes = "over 16.7 ms: {all_slow}: origin shift {slow_shift}, " +
        "cells {slow_cells}, terrain tiles {slow_tiles}, texture graphs {slow_graphs}, " +
        "none of those {slow_none}"
    }

    if frame_ms > COURSE_HITCH_MS {
      hitches = hitches + 1
      all_hitches = all_hitches + 1
      if section_worst {
        const km = state.course_distance / 1000
        const grid_ms = course_grid_ms()
        hitch_line = "{km:.3} km {frame_ms:.1} ms: shifts {shifted}, cells +{made:.0} " +
          "~{changed:.0} in {grid_ms:.1} ms, tiles +{tiles_made} -{tiles_dropped}, " +
          "graphs {graphs_delta}\n"
      }
    }

    loads = loads + made
    mark_seconds = mark_seconds + dt
    state.course_seconds = state.course_seconds + dt

    const speed = state.course_flight ? COURSE_FLY_SPEED : WALK_SPEED
    const step = min(speed * dt, COURSE_LENGTH - state.course_distance)
    const x = state.course_x
    const z = state.course_z
    const yaw = state.course_yaw

    // The next leg
    if state.course_distance >= state.course_leg_end && state.course_leg < COURSE_LEGS - 1 {
      state.course_leg = state.course_leg + 1
      state.course_leg_yaw = course_wrap(state.course_leg_yaw + course_turn(state.course_leg))
      state.course_leg_end = state.course_leg_end + course_leg_length(state.course_leg)
    }

    // The heading: walking, the best of a fan of directions; flying, the heading of the leg
    mut goal: f64 = state.course_leg_yaw
    if !state.course_flight {
      mut best: f64 = -1000000
      for k in 0..9 {
        const a = yaw + (k - 4) * COURSE_FAN
        const off = course_wrap(a - state.course_leg_yaw)
        const dx = 0 - sin(a)
        const dz = 0 - cos(a)
        const score = course_ground(x + dx * COURSE_LOOK / 3, z + dz * COURSE_LOOK / 3) +
          course_ground(x + dx * COURSE_LOOK, z + dz * COURSE_LOOK) +
          0.6 * course_ground(x + dx * 2 * COURSE_LOOK, z + dz * 2 * COURSE_LOOK) -
          COURSE_HOLD * off * off - 0.04 * abs(k - 4)
        if score > best {
          best = score
          goal = a
        }
      }
    }

    const curve = state.course_flight ? COURSE_FLY_CURVE : COURSE_WALK_CURVE
    const turn = clamp(course_wrap(goal - yaw), 0 - curve * step, curve * step)
    const new_yaw = course_wrap(yaw + turn)
    const nx = x - sin(new_yaw) * step
    const nz = z - cos(new_yaw) * step
    state.course_x = nx
    state.course_z = nz
    state.course_yaw = new_yaw
    state.course_distance = state.course_distance + step

    // The height: walking, eye height over the ground, eased over a meter or so of the walk;
    // flying, over the highest ground ahead, climbing sooner than it sinks
    const ground = box.terrain.height(infinite_forest.land, nx, nz)
    mut pitch: f64 = COURSE_WALK_PITCH
    if state.course_flight {
      mut top: f64 = ground
      for k in 1..7 {
        const d = k * COURSE_FLY_AHEAD / 6
        top = max(top, box.terrain.height(infinite_forest.land, nx - sin(new_yaw) * d,
          nz - cos(new_yaw) * d))
      }

      const target = top + COURSE_FLY_CLEARANCE
      const ease = target > state.course_y ? 0.8 : 0.2
      state.course_y = state.course_y + (target - state.course_y) * min(1, dt * ease)
      const climb = dt > 0 ? (state.course_y - last_y) / dt : 0
      pitch = COURSE_FLY_PITCH + 0.5 * atan2(climb, COURSE_FLY_SPEED)
    } else {
      const target = ground + EYE
      state.course_y = max(state.course_y + (target - state.course_y) * min(1, step * 0.8),
        ground + 0.6)
    }

    last_y = state.course_y

    // The pose of the player in the frame of the origin
    const o = WorldOrigin[WorldOrigin]
    state.start_x = state.course_x - o.x
    state.start_y = state.course_y - o.y
    state.start_z = state.course_z - o.z
    state.start_yaw = state.course_yaw
    state.start_pitch = pitch

    if state.course_distance >= next_line {
      const km = state.course_distance / 1000
      const t = state.course_seconds
      const shifts = WorldOriginStatus[WorldOriginStatus].shifts
      const mode = state.course_flight ? "Flight" : "Walk"
      const leg = state.course_leg + 1
      const ax = state.course_x
      const ay = state.course_y
      const az = state.course_z
      const ox = o.x
      const oy = o.y
      const oz = o.z
      state.course_now = "{mode} {km:.2} km of {COURSE_KM:.0} in {t:.0} s, leg {leg}, " +
        "origin shifts {shifts}\nat {ax:.0} {ay:.0} {az:.0}, origin {ox:.0} {oy:.0} {oz:.0}\n" +
        "worst frame {all_worst:.1} ms at {all_worst_km:.2} km, over 16.7 ms {all_slow}, " +
        "over 33.3 ms {all_hitches}"
      next_line = next_line + 25
    }
  }

  const t = state.course_seconds
  const shifts = WorldOriginStatus[WorldOriginStatus].shifts
  const mode = state.course_flight ? "Flight" : "Walk"
  state.course_now = "{mode} done: {COURSE_KM:.0} km in {t:.0} s, origin shifts " +
    "{shifts}\nworst frame {all_worst:.1} ms at {all_worst_km:.2} km, over 16.7 ms " +
    "{all_slow}, over 33.3 ms {all_hitches}"
  state.course_done = true
}

// The course panel, top right over the view
hud {
  screen {
    course {
      Layout: {direction: Column, spacing: 8, padding: {12, 14, 12, 14}}
      Item: {h: Right, v: Top, x: state.hud_shown ? -18 : 4000, y: -18}
      Rect: {1, 1}
      Rgb: {24, 30, 25}
      Opacity: {0.88}
      Border: {width: 1, radius: 10, color: {84, 98, 76, 255}}

      title {
        Text: {value: state.course_flight ? "Long flight" : "Long walk", size: 18}
        Rgb: {236, 232, 216}
      }

      now {
        Text: {value: state.course_now, size: 13}
        Rgb: {214, 186, 112}
      }

      marks {
        Text: {value: state.course_log, size: 11}
        Rgb: {196, 200, 184}
      }

      causes {
        Text: {value: state.course_causes, size: 11}
        Rgb: {214, 186, 112}
      }
    }
  }
}

include beam
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.text

template IslandRailing {
  prop width: f32 = 3
  prop tint: Rgb = {27, 86, 171}
  for i in 0..11 {
    {
      Position: {-width / 2 + i * width / 10, 0.46, 0}
      Cylinder: {radius: 0.024, length: 0.9, segments: 8}
      Rgb: tint
    }
  }
  for i in 0..2 {
    IslandBeam(ax: -width / 2 - 0.05, ay: 0.17 + i * 0.75, bx: width / 2 + 0.05, by: 0.17 + i * 0.75, radius: 0.034, tint: tint) {}
  }
}

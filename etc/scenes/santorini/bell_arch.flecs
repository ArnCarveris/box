include materials
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.text

@tree Parent
template BellArch {
  prop width: f32 = 1.1
  prop height: f32 = 1.55
  const radius = width / 2
  for side in 0..2 {
    { Position: {(side - 0.5) * (width + 0.22), (height - radius) / 2, 0}; RoundedBox: {0.23, height - radius, 0.46, 0.05}; Rgb: IslandChalk }
  }
  for i in 0..20 {
    const a = (i + 0.5) * math.PI / 20
    {
      Position: {math.cos(a) * (radius + 0.11), height - radius + math.sin(a) * (radius + 0.11), 0}
      Rotation: {0, 0, a - math.PI / 2}
      RoundedBox: {0.13, 0.24, 0.46, 0.035}
      Rgb: IslandChalk
    }
  }
  axle { Position: {0, height - radius + 0.04, 0}; Box: {width, 0.07, 0.08}; Rgb: IslandWood }
  bell { Position: {0, height - radius - 0.26, 0}; Frustum: {radius_bottom: 0.22, radius_top: 0.1, length: 0.36, segments: 20, smooth: true}; Rgb: {176, 140, 74}; PbrMaterial: {metallic: 0.65, roughness: 0.4} }
  lip { Position: {0, height - radius - 0.44, 0}; Torus: {radius: 0.21, tube: 0.035, segments: 20, rings: 8}; Rgb: {184, 147, 80} }
  clapper { Position: {0, height - radius - 0.5, 0}; Sphere: {radius: 0.055, segments: 10}; Rgb: IslandIron }
  rope { Position: {0.08, 0.45, 0.05}; Cylinder: {radius: 0.012, length: 0.75, segments: 6}; Rgb: IslandWood }
}

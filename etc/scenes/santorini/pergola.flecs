include materials
include bougainvillea
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.text

@tree Parent
template IslandPergola {
  prop width: f32 = 4.3
  prop depth: f32 = 3
  for x in 0..2 {
    for z in 0..2 {
      { Position: {(x - 0.5) * width, 1.5, (z - 0.5) * depth}; Box: {0.14, 3, 0.14}; Rgb: IslandWood }
      { Position: {(x - 0.5) * width, 0.2, (z - 0.5) * depth}; Box: {0.24, 0.4, 0.24}; Rgb: IslandChalk }
    }
    { Position: {(x - 0.5) * width, 3, 0}; Box: {0.17, 0.2, depth + 0.5}; Rgb: IslandWood }
  }
  for i in 0..13 {
    { Position: {-width / 2 - 0.12 + i * (width + 0.24) / 12, 3.14, 0}; Box: {0.075, 0.13, depth + 0.45}; Rgb: {167, 132, 86} }
  }
  for i in 0..22 {
    { Position: {0, 3.23, -depth / 2 + i * depth / 21}; Cylinder: {radius: 0.025, length: width + 0.25, segments: 6}; Rotation: {0, 0, math.PI / 2}; Rgb: {191, 167, 118} }
  }
  Bougainvillea(width: width, height: 3.25) { Position: {0, 0, depth / 2} }
}

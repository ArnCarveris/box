using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.text

@tree Parent
template IslandBeam {
  prop ax: f32 = 0
  prop ay: f32 = 0
  prop az: f32 = 0
  prop bx: f32 = 0
  prop by: f32 = 1
  prop bz: f32 = 0
  prop radius: f32 = 0.025
  prop tint: Rgb = {137, 102, 66}
  const dx = bx - ax
  const dy = by - ay
  const dz = bz - az
  const length = math.sqrt(dx * dx + dy * dy + dz * dz)
  Position: {(ax + bx) / 2, (ay + by) / 2, (az + bz) / 2}
  Rotation: {math.acos(dy / length), math.atan2(dx, dz), 0}
  Cylinder: {radius: radius, length: length, segments: 8, smooth: true}
  Rgb: tint
}

using box.text

assets {
  template FishingBoat {
    prop tint: Rgb = {27, 86, 171}
    hull {
      Position: {0, 0.18, 0}
      Mesh3: {
        vertices: [
          {0, -0.18, 1.9},
          {-0.52, -0.25, 0.55},
          {-0.45, -0.25, -1.3},
          {0.45, -0.25, -1.3},
          {0.52, -0.25, 0.55},
          {0, 0.48, 2.08},
          {-0.77, 0.38, 0.55},
          {-0.65, 0.38, -1.4},
          {0.65, 0.38, -1.4},
          {0.77, 0.38, 0.55}
        ],
        indices: [
          0,
          1,
          6,
          0,
          6,
          5,
          1,
          2,
          7,
          1,
          7,
          6,
          2,
          3,
          8,
          2,
          8,
          7,
          3,
          4,
          9,
          3,
          9,
          8,
          4,
          0,
          5,
          4,
          5,
          9,
          0,
          4,
          1,
          1,
          4,
          3,
          1,
          3,
          2
        ]
      }
      Rgb: tint
      BackFaceMode: {BackFacePlain}
    }

    floor { Position: {0, 0.19, -0.2}; RoundedBox: {1.04, 0.12, 2.55, 0.22}; Rgb: {190, 150, 93} }

    for i in 0..7 {
      { Position: {-0.44 + i * 0.145, 0.257, -0.2}; Box: {0.013, 0.012, 2.26}; Rgb: IslandWood }
    }

    for side in 0..2 {
      const sign = side * 2 - 1
      IslandBeam(
        ax: 0,
        ay: 0.67,
        az: 2.08,
        bx: sign * 0.77,
        by: 0.57,
        bz: 0.55,
        radius: 0.055,
        tint: IslandChalk
      ) {}
      IslandBeam(
        ax: sign * 0.77,
        ay: 0.57,
        az: 0.55,
        bx: sign * 0.65,
        by: 0.57,
        bz: -1.4,
        radius: 0.055,
        tint: IslandChalk
      ) {}

      for i in 0..2 {
        {
          Position: {sign * 0.75, 0.34, -0.65 + i * 1.1}
          Rotation: {math.PI / 2, 0, math.PI / 2}
          Torus: {radius: 0.19, tube: 0.065, segments: 20, rings: 8}
          Rgb: IslandIron
        }
      }
    }

    IslandBeam(
      ax: -0.65,
      ay: 0.57,
      az: -1.4,
      bx: 0.65,
      by: 0.57,
      bz: -1.4,
      radius: 0.055,
      tint: IslandChalk
    ) {}

    for i in 0..3 {
      { Position: {0, 0.47, -0.9 + i * 0.85}; Box: {1.2, 0.08, 0.25}; Rgb: IslandChalk }
    }

    mast {
      Position: {0, 1.58, 0.4}
      Cylinder: {radius: 0.035, length: 2.8, segments: 10}
      Rgb: IslandWood
    }

    IslandBeam(ay: 2.94, az: 0.4, by: 0.62, bz: 1.95, radius: 0.009, tint: IslandPlaster) {}
    IslandBeam(ay: 2.94, az: 0.4, by: 0.62, bz: -1.34, radius: 0.009, tint: IslandPlaster) {}
    flag {
      Position: {0, 2.65, 0.4}

      for i in 0..9 {
        {
          Position: {0.24, 0.23 - i * 0.05, 0}
          Box: {0.48, 0.05, 0.012}
          Rgb: i % 2 == 0 ? IslandCobalt : IslandChalk
        }
      }
    }

    rope_coil {
      Position: {0.3, 0.54, -0.9}
      Torus: {radius: 0.13, tube: 0.035, segments: 20, rings: 6}
      Rgb: {196, 168, 119}
    }

    basket {
      Position: {-0.22, 0.38, -0.25}
      Cylinder: {radius: 0.2, length: 0.25, segments: 16}
      Rgb: IslandWood
    }

    for i in 0..4 {
      {
        Position: {-0.22, 0.28 + i * 0.065, -0.25}
        Torus: {radius: 0.2, tube: 0.016, segments: 16, rings: 6}
        Rgb: {192, 157, 100}
      }
    }
  }

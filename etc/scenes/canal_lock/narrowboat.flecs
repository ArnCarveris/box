include materials
include state
include control
using flecs.script
using box.transform
using box.geometry
using box.material
using box.app
using box.particle
using box.transition

prefab LockHullPlan {
  Path2D: {
    start: {-3, -0.95},
    segments: [
      {kind: Line, end: {1.9, -0.95}},
      {kind: CubicBezier, end: {3.7, 0}, control1: {2.8, -0.95}, control2: {3.5, -0.42}},
      {kind: CubicBezier, end: {1.9, 0.95}, control1: {3.5, 0.42}, control2: {2.8, 0.95}},
      {kind: Line, end: {-3, 0.95}},
      {kind: CubicBezier, end: {-3.6, 0}, control1: {-3.42, 0.95}, control2: {-3.6, 0.5}},
      {kind: CubicBezier, end: {-3, -0.95}, control1: {-3.6, -0.5}, control2: {-3.42, -0.95}}
    ],
    closed: true
  }
}
prefab LockHullProfile { Profile2D: {outer: LockHullPlan} }

prefab LockHullEdge {
  Path3D: {
    start: {-3, 0, -0.95},
    segments: [
      {kind: Line, end: {1.9, 0, -0.95}},
      {kind: CubicBezier, end: {3.7, 0, 0}, control1: {2.8, 0, -0.95}, control2: {3.5, 0, -0.42}},
      {kind: CubicBezier, end: {1.9, 0, 0.95}, control1: {3.5, 0, 0.42}, control2: {2.8, 0, 0.95}},
      {kind: Line, end: {-3, 0, 0.95}},
      {kind: CubicBezier, end: {-3.6, 0, 0}, control1: {-3.42, 0, 0.95}, control2: {-3.6, 0, 0.5}},
      {kind: CubicBezier, end: {-3, 0, -0.95}, control1: {-3.6, 0, -0.5}, control2: {-3.42, 0, -0.95}}
    ],
    closed: true
  }
}
prefab LockStrakeShape { Path2D: {start: {-0.035, -0.03}, segments: [{kind: Line, end: {0.035, -0.03}}, {kind: Line, end: {0.035, 0.03}}, {kind: Line, end: {-0.035, 0.03}}], closed: true} }
prefab LockStrakeProfile { Profile2D: {outer: LockStrakeShape} }

prefab LockTillerPath {
  Path3D: {
    start: {-3.05, 0.62, 0},
    segments: [{kind: CubicBezier, end: {-3.75, 0.98, 0}, control1: {-3.35, 0.62, 0}, control2: {-3.5, 1.0, 0}}]
  }
}
prefab LockRoundShape { Path2D: {start: {0.024, 0}, segments: [{kind: Line, end: {0, 0.024}}, {kind: Line, end: {-0.024, 0}}, {kind: Line, end: {0, -0.024}}], closed: true} }
prefab LockRoundProfile { Profile2D: {outer: LockRoundShape} }

prefab LockCanShape {
  Path2D: {
    start: {0.08, 0},
    segments: [
      {kind: CubicBezier, end: {0.13, 0.22}, control1: {0.14, 0.05}, control2: {0.14, 0.14}},
      {kind: CubicBezier, end: {0.05, 0.36}, control1: {0.12, 0.3}, control2: {0.07, 0.3}},
      {kind: Line, end: {0.05, 0.42}}
    ]
  }
}

template LockFender {
  rope : CanalRope { Position: {0, 0.26, 0}; Cylinder: {radius: 0.012, length: 0.26, segments: 5} }
  body : CanalRope { Position: {}; Capsule: {radius: 0.075, length: 0.2, segments: 10, smooth: true} }
}

template LockNarrowboatBody {
  hull : CanalBitumen {
    Position: {}
    Loft: {
      sections: [
        {profile: LockHullProfile, offset: {0, -0.46, 0}, scale: {0.97, 0.88}},
        {profile: LockHullProfile, offset: {0, -0.1, 0}, scale: {0.99, 0.97}},
        {profile: LockHullProfile, offset: {0, 0.42, 0}, scale: {1, 1}}
      ],
      cap_start: true, cap_end: true, rings: 6
    }
  }
  gunwale : CanalRed { Position: {0, 0.44, 0}; Sweep: {path: LockHullEdge, profile: LockStrakeProfile, scale: {1, 1}, rings: 96} }
  rubbing : CanalYellow { Position: {0, 0.2, 0}; Sweep: {path: LockHullEdge, profile: LockStrakeProfile, scale: {0.7, 0.7}, rings: 96} }
  stem : CanalBrass { Position: {3.68, 0.1, 0}; Box: {0.05, 0.64, 0.05} }

  fore_deck : CanalDeckPlanks { Position: {2.55, 0.45, 0}; Box: {1.1, 0.03, 1.1} }
  cabin : CanalGreen { Position: {-0.55, 0.84, 0}; Box: {4.5, 0.8, 1.56} }
  CanalFace(w: 4.46, h: 0.76, u: 1, v: 1) { (IsA, CanalBoatSide); Position: {-0.55, 0.84, 0.79} }
  CanalFace(w: 4.46, h: 0.76, u: 1, v: 1) { (IsA, CanalBoatSide); Position: {-0.55, 0.84, -0.79}; Rotation: {0, math.PI, 0} }
  roof : CanalRed { Position: {-0.55, 1.28, 0}; RoundedBox: {4.66, 0.09, 1.7, 0.035, segments: 2} }
  roof_crown : CanalRed { Position: {-0.55, 1.33, 0}; RoundedBox: {4.4, 0.06, 1.2, 0.025, segments: 2} }
  fore_door : CanalYellow { Position: {1.71, 0.82, 0}; Box: {0.02, 0.62, 0.62} }
  rear_door : CanalYellow { Position: {-2.81, 0.82, 0}; Box: {0.02, 0.62, 0.62} }
  hatch : CanalGreen { Position: {-2.45, 1.39, 0}; RoundedBox: {0.5, 0.08, 0.66, 0.02, segments: 1} }

  for i in 0..4 {
    const wx = -1.65 + i * 0.73
    for s in 0..2 {
      const sign = s * 2 - 1
      { (IsA, CanalBrass); Position: {wx, 1.08, sign * 0.815}; Rotation: {math.PI / 2, 0, 0}; Tube: {radius: 0.075, length: 0.03, thickness: 0.018, segments: 18} }
      { (IsA, CanalGlass); Position: {wx, 1.08, sign * 0.808}; Rotation: {math.PI / 2, 0, 0}; Cylinder: {radius: 0.06, length: 0.02, segments: 16} }
    }
  }

  chimney : CanalBlack { Position: {0.9, 1.72, 0.3}; Cylinder: {radius: 0.075, length: 0.72, segments: 14, smooth: true} }
  chimney_band_a : CanalBrass { Position: {0.9, 1.92, 0.3}; Cylinder: {radius: 0.085, length: 0.05, segments: 14, smooth: true} }
  chimney_band_b : CanalBrass { Position: {0.9, 1.68, 0.3}; Cylinder: {radius: 0.085, length: 0.04, segments: 14, smooth: true} }
  smoke {
    Position: {0.9, 2.12, 0.3}
    ParticleEmitter: {
      max: 160, rate: 12, shape: EmitterPoint, spread: 12,
      speed: {0.35, 0.6}, lifetime: {2, 3.5}, size: {0.08, 0.3},
      opacity: {0.05, 0.14}, color: {128, 128, 132}, seed: 3
    }
  }

  can : CanalGreen { Position: {0.1, 1.36, -0.32}; Lathe: {profile: LockCanShape, cap_start: true, cap_end: true, segments: 18, rings: 14} }
  can_band : CanalRed { Position: {0.1, 1.55, -0.32}; Cylinder: {radius: 0.135, length: 0.03, segments: 18, smooth: true} }
  can_handle : CanalIron { Position: {0.1, 1.68, -0.32}; Rotation: {math.PI / 2, 0, 0}; Torus: {radius: 0.09, tube: 0.008, segments: 16, rings: 5} }

  rope_coil : CanalRope { Position: {-1.5, 1.4, 0.2}; Torus: {radius: 0.14, tube: 0.035, segments: 18, rings: 8} }
  rope_coil_b : CanalRope { Position: {-1.5, 1.45, 0.2}; Torus: {radius: 0.1, tube: 0.03, segments: 18, rings: 8} }
  plank_rail : CanalWhite { Position: {-0.7, 1.4, -0.48}; RoundedBox: {1.3, 0.05, 0.2, 0.012, segments: 1} }
  planter : CanalYellow { Position: {-1.1, 1.43, -0.05}; RoundedBox: {0.74, 0.14, 0.24, 0.02, segments: 1} }
  for i in 0..6 {
    { Position: {-1.38 + i * 0.11, 1.55, (i % 2 - 0.5) * 0.09}; IcoSphere: {radius: 0.055, segments: 1}; Rgb: {236 - i * 8, 66 + i * 28, 80 + (i % 2) * 110} }
    { (IsA, CanalLeaf); Position: {-1.38 + i * 0.11, 1.5, -(i % 2 - 0.5) * 0.09}; IcoSphere: {radius: 0.05, segments: 1} }
  }

  lamp : CanalBrass { Position: {1.84, 1.2, 0}; Cylinder: {radius: 0.09, length: 0.22, segments: 14, smooth: true} }
  lamp_glass { Position: {1.92, 1.2, 0}; Rotation: {0, 0, math.PI / 2}; Cylinder: {radius: 0.07, length: 0.03, segments: 14}; Rgb: {255, 236, 190}; Emissive: {strength: 1.6, color: {255, 214, 150}} }

  for f in 0..3 {
    const fx = -1.9 + f * 1.7
    LockFender() { Position: {fx, 0.15, 0.99} }
    LockFender() { Position: {fx, 0.15, -0.99} }
  }
  tipcat : CanalRope { Position: {3.75, 0.05, 0}; Scale: {1, 0.9, 1}; Sphere: {radius: 0.14, segments: 12, smooth: true} }

  tiller : CanalBrass { Position: {}; Sweep: {path: LockTillerPath, profile: LockRoundProfile, scale: {1, 1}, rings: 16} }
  tiller_grip : CanalWhite { Position: {-3.75, 0.98, 0}; Rotation: {0, 0, 1.5}; Cylinder: {radius: 0.032, length: 0.2, segments: 10} }
  rudder_post : CanalBitumen { Position: {-3.05, 0.32, 0}; Cylinder: {radius: 0.035, length: 0.62, segments: 10} }
  rudder : CanalRed { Position: {-3.72, -0.12, 0}; Box: {0.52, 0.56, 0.05} }

  steerer {
    Position: {-3.02, 0.44, 0}
    leg_a : CanalCloth { Position: {0, 0.26, 0.09}; Capsule: {radius: 0.055, length: 0.42, segments: 10, smooth: true} }
    leg_b : CanalCloth { Position: {0, 0.26, -0.09}; Capsule: {radius: 0.055, length: 0.42, segments: 10, smooth: true} }
    body : CanalRed { Position: {0, 0.76, 0}; Capsule: {radius: 0.13, length: 0.26, segments: 12, smooth: true} }
    waistcoat : CanalBlack { Position: {0.05, 0.74, 0}; Scale: {0.8, 1, 1.04}; Capsule: {radius: 0.122, length: 0.22, segments: 12, smooth: true} }
    arm_a : CanalRed { Position: {-0.1, 0.72, 0.17}; Rotation: {0, 0, -0.9}; Capsule: {radius: 0.04, length: 0.34, segments: 8, smooth: true} }
    arm_b : CanalRed { Position: {0.02, 0.8, -0.17}; Rotation: {0.2, 0, 0.1}; Capsule: {radius: 0.04, length: 0.3, segments: 8, smooth: true} }
    head : CanalSkin { Position: {0, 1.12, 0}; Sphere: {radius: 0.105, segments: 14, smooth: true} }
    cap : CanalBlack { Position: {0, 1.2, 0}; Cylinder: {radius: 0.115, length: 0.05, segments: 14, smooth: true} }
    peak : CanalBlack { Position: {0.11, 1.18, 0}; Box: {0.14, 0.015, 0.16} }
  }
}

template LockNarrowboat : LockControl {
  const level = match lock_high { true: -0.45; _: -2.25 }
  const x = match lock_boat_at { 0: -16.6; 1: 0.6; _: 14.0 }
  const y = match lock_boat_at { 0: -2.25; 1: level; _: -0.45 }

  Position: {x, y, 0}
  Transition: [
    Position: {duration: 6, timing_function: EaseInOut},
    Tint: {duration: 0.12}
  ]

  LockNarrowboatBody body()

  async {
    while true {
      await on.click(this)
      const now = AppStatus[AppStatus].elapsed
      if now >= lock_busy_until {
        if lock_boat_at == 0 && lock_bridge_up && lock_bottom_gate {
          lock_boat_at = 1
          lock_boat_up = true
          lock_busy_until = now + 6.1
          hover = false
        } else if lock_boat_at == 1 && lock_boat_up && lock_top_gate {
          lock_boat_at = 2
          lock_boat_up = false
          lock_trips = lock_trips + 1
          lock_busy_until = now + 6.1
          hover = false
        } else if lock_boat_at == 2 && lock_top_gate {
          lock_boat_at = 1
          lock_busy_until = now + 6.1
          hover = false
        } else if lock_boat_at == 1 && !lock_boat_up && lock_bridge_up && lock_bottom_gate {
          lock_boat_at = 0
          lock_boat_up = true
          lock_trips = lock_trips + 1
          lock_busy_until = now + 6.1
          hover = false
        }
      }
    }
  }
}

using flecs.script
using box.material
using box.input
using box.picking
using box.transition

template LockControl {
  prop enabled: bool = true

  mut hover = false

  Interactive

  if enabled {
    Cursor: {CursorPointer}
  } else {
    Cursor: {CursorNotAllowed}
  }

  if hover && enabled {
    Tint: {255, 226, 130, 90}
  } else if hover {
    Tint: {190, 50, 40, 90}
  } else {
    Tint: {255, 226, 130, 0}
  }

  async {
    while true {
      await on.enter(this)
      hover = true
    }
  }

  async {
    while true {
      await on.leave(this)
      hover = false
    }
  }
}

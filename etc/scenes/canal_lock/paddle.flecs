include materials
include state
include control
using flecs.script
using box.transform
using box.geometry
using box.material
using box.app
using box.transition

template LockPaddleRack {
  bar : CanalBlack { Position: {0, 0.95, 0}; Box: {0.13, 1.5, 0.13} }
  tip : CanalWhite { Position: {0, 1.72, 0}; Box: {0.15, 0.1, 0.15} }
  for i in 0..9 {
    { (IsA, CanalIron); Position: {0, 0.32 + i * 0.16, 0.075}; Box: {0.1, 0.05, 0.03} }
  }
}

template LockPaddleCrank {
  axle : CanalIron { Rotation: {0, 0, math.PI / 2}; Position: {0.1, 0, 0}; Cylinder: {radius: 0.04, length: 0.3, segments: 10} }
  gear : CanalBrass { Rotation: {0, 0, math.PI / 2}; Cylinder: {radius: 0.17, length: 0.05, segments: 18, smooth: true} }
  arm : CanalWhite { Position: {0.24, 0.2, 0}; Box: {0.05, 0.5, 0.07} }
  handle : CanalBlack { Position: {0.34, 0.43, 0}; Rotation: {0, 0, math.PI / 2}; Cylinder: {radius: 0.045, length: 0.22, segments: 10} }
}

template LockPaddleGear : LockControl {
  prop top: bool = false

  const raised = (top && lock_top_paddle) || (!top && lock_bottom_paddle)
  const lift = match raised { true: 0.85; _: 0 }

  Transition: [Tint: {duration: 0.12}]

  plinth : CanalDarkStone { Position: {0, 0.08, 0}; RoundedBox: {0.86, 0.16, 0.86, 0.03, segments: 1} }
  base : CanalRed { Position: {0, 0.2, 0}; RoundedBox: {0.56, 0.08, 0.46, 0.02, segments: 1} }
  frame_a : CanalRed { Position: {-0.17, 0.82, 0}; Frustum: {radius_bottom: 0.1, radius_top: 0.065, length: 1.2, segments: 8} }
  frame_b : CanalRed { Position: {0.17, 0.82, 0}; Frustum: {radius_bottom: 0.1, radius_top: 0.065, length: 1.2, segments: 8} }
  frame_top : CanalRed { Position: {0, 1.44, 0}; RoundedBox: {0.5, 0.07, 0.2, 0.02, segments: 1} }
  for b in 0..4 {
    { (IsA, CanalBrass); Position: {-0.22 + (b % 2) * 0.44, 0.25, -0.16 + (b / 2) * 0.32}; Sphere: {radius: 0.025, segments: 8} }
  }

  rack {
    Position: {0, lift, 0}
    Transition: [Position: {duration: 1.2, timing_function: EaseInOut}]
    LockPaddleRack body()
  }

  crank {
    Position: {0.26, 0.86, 0}
    Rotation: {lift * 8, 0, 0}
    Transition: [Rotation: {duration: 1.2, timing_function: EaseInOut}]
    LockPaddleCrank body()
  }

  async {
    while true {
      await on.click(this)
      const now = AppStatus[AppStatus].elapsed
      if now >= lock_busy_until {
        if top {
          if lock_top_paddle {
            lock_top_paddle = false
          } else if !lock_bottom_paddle && !lock_bottom_gate {
            lock_top_paddle = true
            if !lock_high {
              lock_high = true
              lock_busy_until = now + 6.1
            }
          }
        } else {
          if lock_bottom_paddle {
            lock_bottom_paddle = false
          } else if !lock_top_paddle && !lock_top_gate {
            lock_bottom_paddle = true
            if lock_high {
              lock_high = false
              lock_busy_until = now + 6.1
            }
          }
        }
      }
    }
  }
}

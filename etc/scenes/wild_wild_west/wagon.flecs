include wheel
include beam
include barrel
include crate
using flecs.script
using box.transform
using box.geometry
using box.material
using box.light
using box.text


template WestWagon {
  chassis : WestRed { Position: {0, 0.93, 0}; Box: {2, 0.2, 3.7} }
  for end in 0..2 {
    { (IsA, WestIron); Position: {0, 0.73, (end - 0.5) * 2.6}; Rotation: {0, 0, math.PI / 2}; Cylinder: {radius: 0.075, length: 2.6, segments: 12} }
    for side in 0..2 {
      WestWheel(radius: 0.72) { Position: {(side - 0.5) * 2.55, 0.75, (end - 0.5) * 2.6}; Rotation: {0, (side - 0.5) * math.PI, 0} }
    }
    for row in 0..3 {
      { Position: {0, 1.14 + row * 0.21, (end - 0.5) * 3.6}; Box: {2.1, 0.19, 0.09}; Rgb: {144 + row * 12, 95 + row * 8, 47} }
    }
  }
  for side in 0..2 {
    for row in 0..3 {
      { Position: {(side - 0.5) * 2.02, 1.14 + row * 0.21, 0}; Box: {0.08, 0.19, 3.6}; Rgb: {144 + row * 12, 95 + row * 8, 47} }
    }
    for strap in 0..4 {
      { (IsA, WestIron); Position: {(side - 0.5) * 2.09, 1.36, -1.5 + strap}; Box: {0.04, 0.7, 0.07} }
    }
    WestBeam(ax: (side - 0.5) * 1.5, ay: 0.85, az: 1.45, bx: (side - 0.5) * 1.15, by: 0.5, bz: 4.5, width: 0.09) {}
  }
  canvas : WestCanvas {
    Position: {0, 1.63, -0.15}
    Rotation: {-math.PI / 2, 0, 0}
    Tube: {radius: 1.06, length: 3.25, thickness: 0.035, arc: math.PI, segments: 32, smooth: true}
  }
  for i in 0..5 {
    {
      Position: {0, 1.63, -1.75 + i * 0.8}
      Rotation: {-math.PI / 2, 0, 0}
      Tube: {radius: 1.08, length: 0.055, thickness: 0.055, arc: math.PI, segments: 32, smooth: true}
      Rgb: {179, 147, 99}
    }
    for side in 0..2 {
      { Position: {(side - 0.5) * 2.08, 1.48, -1.75 + i * 0.8}; Cylinder: {radius: 0.016, length: 0.4, segments: 6}; Rgb: {110, 79, 41} }
    }
  }
  bench : WestTimber { Position: {0, 1.65, 1.65}; Box: {1.8, 0.12, 0.4} }
  WestBarrel() { Position: {-1.3, 1.05, -0.3}; Scale: {0.6, 0.6, 0.6} }
  WestCrate() { Position: {0, 1.05, -1.2}; Scale: {0.7, 0.7, 0.7} }
  rear_step : WestIron { Position: {0, 0.66, -2.12}; Box: {1.1, 0.06, 0.45} }
}

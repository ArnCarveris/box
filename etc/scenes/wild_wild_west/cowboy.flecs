include beam
using flecs.script
using box.transform
using box.geometry
using box.material
using box.light
using box.text


template WestCowboy {
  prop shirt: Rgb = {75, 103, 117}
  for side in 0..2 {
    const x = (side - 0.5) * 0.24
    { (IsA, WestCloth); Position: {x, 0.42, 0}; Capsule: {radius: 0.08, length: 0.55, segments: 10}; Rgb: {56, 66, 65} }
    { Position: {x, 0.1, 0.06}; RoundedBox: {0.18, 0.19, 0.3, 0.04}; Rgb: {66, 44, 28} }
    WestBeam(ax: (side - 0.5) * 0.45, ay: 1.19, az: 0, bx: (side - 0.5) * 0.58, by: 0.87, bz: 0.12, width: 0.12, tint: shirt) { Sheen: {color: {90, 84, 76}, roughness: 0.5} }
    { Position: {(side - 0.5) * 0.59, 0.84, 0.13}; Sphere: {radius: 0.07, segments: 10}; Rgb: {185, 133, 91} }
  }
  torso : WestCloth { Position: {0, 1, 0}; RoundedBox: {0.4, 0.53, 0.25, 0.09}; Rgb: shirt }
  vest : WestCloth { Position: {0, 1.07, 0.13}; Box: {0.3, 0.38, 0.035}; Rgb: {74, 48, 30} }
  shirtfront : WestCloth { Position: {0, 1.1, 0.155}; Box: {0.055, 0.34, 0.02}; Rgb: shirt }
  belt : WestTimber { Position: {0, 0.76, 0}; Box: {0.41, 0.07, 0.27} }
  buckle : WestBrass { Position: {0, 0.76, 0.15}; Box: {0.08, 0.055, 0.025} }
  head { Position: {0, 1.44, 0}; Scale: {0.85, 1, 0.9}; Sphere: {radius: 0.16, segments: 12, smooth: true}; Rgb: {185, 133, 91} }
  bandana : WestRed { Position: {0, 1.3, 0.12}; TrianglePrism: {0.21, 0.15, 0.035}; Rotation: {0, 0, math.PI} }
  hat_brim : WestTimber { Position: {0, 1.57, 0}; Scale: {1.15, 1, 0.9}; Cylinder: {radius: 0.3, length: 0.045, segments: 24} }
  hat_crown : WestPlank { Position: {0, 1.68, 0}; RoundedBox: {0.29, 0.22, 0.3, 0.06} }
  hat_band : WestTimber { Position: {0, 1.6, 0}; RoundedBox: {0.3, 0.055, 0.31, 0.055} }
}

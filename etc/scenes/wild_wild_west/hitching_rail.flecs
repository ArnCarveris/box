include materials
using flecs.script
using box.transform
using box.geometry
using box.material

@tree Parent
template WestHitchingRail {
  for side in 0..2 {
    { Position: {(side - 0.5) * 3, 0.6, 0}; Box: {0.18, 1.2, 0.18}; Rgb: {103, 64, 38} }
  }
  crossbar : WestTimber { Position: {0, 1.12, 0}; Box: {3.5, 0.16, 0.16} }
}

include materials
using flecs.script
using box.transform
using box.geometry
using box.material
using box.light
using box.text


template WestMesa {
  prop height: f32 = 5
  prop width: f32 = 4
  for layer in 0..7 {
    const t = layer / 7.0
    const w = width * (1 - t * 0.45)
    { Position: {math.sin(layer * 3) * 0.1, height * (t + 0.07), 0}; Rotation: {0, 0.15 + layer % 2 * 0.015, 0}; BeveledPrism: {footprint: [{-w * 0.5, -w * 0.36}, {w * 0.45, -w * 0.43}, {w * 0.51, w * 0.32}, {-w * 0.4, w * 0.4}], depth: height / 7 + 0.04, inset: 0.08, offset: {0.05, -0.04}, bevel: 0.11}; Rgb: {159 + layer % 3 * 15, 82 + layer % 3 * 14, 48 + layer % 3 * 10} }
  }
  for i in 0..8 {
    { Position: {math.sin(i * 2.4) * width * 0.45, 0.15, math.cos(i * 2.4) * width * 0.4}; Scale: {1.3, 0.8, 1}; IcoSphere: {radius: 0.3 + i % 3 * 0.17, segments: 0}; Rgb: {177, 108, 65} }
  }
}

include materials
using flecs.script
using box.transform
using box.geometry
using box.material
using box.light
using box.text


assets {
  template WestWheel {
    prop radius: f32 = 0.7
    rim : WestTimber {
      Position: {}
      Rotation: {math.PI / 2, 0, 0}
      Tube: {radius: radius, length: 0.13, thickness: 0.09, segments: 32}
    }

    tire : WestIron {
      Position: {}
      Rotation: {math.PI / 2, 0, 0}
      Tube: {radius: radius + 0.025, length: 0.15, thickness: 0.028, segments: 32}
    }

    hub : WestIron {
      Position: {}
      Rotation: {math.PI / 2, 0, 0}
      Cylinder: {radius: 0.14, length: 0.26, segments: 12}
    }

    cap : WestBrass {
      Position: {0, 0, 0.15}
      Rotation: {math.PI / 2, 0, 0}
      Cylinder: {radius: 0.065, length: 0.03, segments: 12}
    }

    for i in 0..12 {
      const a = i * math.PI / 6
      {
        Position: {math.sin(a) * radius * 0.49, math.cos(a) * radius * 0.49, 0}
        Rotation: {0, 0, -a}
        Box: {0.055, radius * 0.82, 0.07}
        Rgb: {181, 125, 62}
      }
    }
  }
}

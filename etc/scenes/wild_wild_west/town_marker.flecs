include sign
using flecs.script
using box.transform
using box.geometry
using box.material

assets {
  template WestTownMarker {
    for side in 0..2 {
      { Position: {(side - 0.5) * 3.4, 1.15, 0}; Box: {0.15, 2.3, 0.15}; Rgb: {103, 64, 38} }
    }

    WestSign(label: "DRY CREEK", width: 4, height: 0.72, size: 0.42) { Position: {0, 1.96, 0.05} }
    WestSign(label: "POP. 128  -  EST. 1876", width: 3.4, height: 0.4, size: 0.2) {
      Position: {0, 1.36, 0.05}
    }
  }
}

include beam
using flecs.script
using box.transform
using box.geometry
using box.material
using box.light
using box.text


assets {
  template WestHorse {
    prop tint: Rgb = {112, 65, 37}
    prop hair: Rgb = {44, 33, 25}
    barrel { Position: {0, 1.12, -0.05}; Rotation: {math.PI / 2, 0, 0}; Scale: {0.82, 1, 1}; Capsule: {radius: 0.36, length: 0.8, segments: 20, smooth: true}; Rgb: tint }
    chest { Position: {0, 1.14, 0.5}; Scale: {0.8, 1, 0.9}; Sphere: {radius: 0.37, segments: 18, smooth: true}; Rgb: tint }

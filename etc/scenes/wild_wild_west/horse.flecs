    tail { Position: {0, 0.78, -1.17}; Rotation: {0.12, 0, 0}; Scale: {0.75, 1, 1}; Frustum: {radius_bottom: 0.12, radius_top: 0.06, length: 0.72, segments: 12, smooth: true}; Rgb: hair }
    tail_tip { Position: {0, 0.38, -1.22}; Scale: {0.75, 1.3, 1}; Sphere: {radius: 0.12, segments: 12, smooth: true}; Rgb: hair }
    blanket { Position: {0, 1.12, -0.12}; Rotation: {-math.PI / 2, 0, 0}; Scale: {0.87, 1, 1}; Tube: {radius: 0.385, thickness: 0.03, length: 0.72, arc: math.PI, segments: 24, smooth: true}; Rgb: {144, 54, 37}; PbrMaterial: {roughness: 0.95}; Sheen: {color: {150, 96, 84}, roughness: 0.45} }
    girth { Position: {0, 1.12, -0.05}; Rotation: {math.PI / 2, 0, 0}; Scale: {0.83, 1, 1}; Tube: {radius: 0.368, thickness: 0.015, length: 0.09, segments: 24, smooth: true}; Rgb: {41, 39, 31} }
    seat { Position: {0, 1.53, -0.12}; RoundedBox: {0.28, 0.1, 0.56, 0.05}; Rgb: {71, 45, 27} }
    pommel { Position: {0, 1.6, 0.13}; Sphere: {radius: 0.055, segments: 10, smooth: true}; Rgb: {71, 45, 27} }
    cantle { Position: {0, 1.59, -0.36}; RoundedBox: {0.26, 0.12, 0.07, 0.03}; Rgb: {71, 45, 27} }

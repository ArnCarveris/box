      WestBeam(ax: x, ay: 0.58, az: 0.6, bx: x, by: 0.14, bz: 0.6, width: 0.085, tint: tint) {}
      { Position: {x, 0.58, 0.6}; Sphere: {radius: 0.082, segments: 10, smooth: true}; Rgb: tint }
      { Position: {x, 0.07, 0.62}; Frustum: {radius_bottom: 0.085, radius_top: 0.06, length: 0.14, segments: 12}; Rgb: {42, 36, 29} }
      { Position: {x, 1.02, -0.66}; Scale: {0.65, 1, 1}; Sphere: {radius: 0.2, segments: 12, smooth: true}; Rgb: tint }
      WestBeam(ax: x, ay: 1.02, az: -0.66, bx: x, by: 0.6, bz: -0.84, width: 0.15, tint: tint) {}
      WestBeam(ax: x, ay: 0.6, az: -0.84, bx: x, by: 0.14, bz: -0.74, width: 0.085, tint: tint) {}
      { Position: {x, 0.6, -0.84}; Sphere: {radius: 0.082, segments: 10, smooth: true}; Rgb: tint }
      { Position: {x, 0.07, -0.72}; Frustum: {radius_bottom: 0.085, radius_top: 0.06, length: 0.14, segments: 12}; Rgb: {42, 36, 29} }
      { Position: {s * 0.13, 2.11, 1.02}; Rotation: {-0.1, 0, s * -0.3}; Cone: {radius: 0.045, length: 0.17, segments: 8}; Rgb: tint }
      { Position: {s * 0.2, 1.92, 1.2}; Sphere: {radius: 0.032, segments: 10}; Rgb: {16, 17, 15} }
      WestBeam(ax: s * 0.205, ay: 2.03, az: 1.08, bx: s * 0.2, by: 1.7, bz: 1.34, width: 0.022, tint: {41, 39, 31}) {}
      WestBeam(ax: s * 0.2, ay: 1.68, az: 1.38, bx: s * 0.38, by: 1.6, bz: 0.75, width: 0.016, tint: {41, 39, 31}) {}
      WestBeam(ax: s * 0.38, ay: 1.6, az: 0.75, bx: s * 0.24, by: 1.6, bz: 0.14, width: 0.016, tint: {41, 39, 31}) {}
      WestBeam(ax: s * 0.3, ay: 1.52, az: -0.1, bx: s * 0.66, by: 1.3, bz: -0.1, width: 0.025, tint: {41, 39, 31}) {}
      WestBeam(ax: s * 0.66, ay: 1.3, az: -0.1, bx: s * 0.74, by: 0.82, bz: -0.1, width: 0.025, tint: {41, 39, 31}) {}
      { (IsA, WestIron); Position: {s * 0.74, 0.79, -0.1}; RoundedBox: {0.06, 0.05, 0.16, 0.02} }
    }
    noseband { Position: {0, 1.71, 1.34}; Rotation: {0.72, 0, 0}; Scale: {0.8, 1, 1}; Torus: {radius: 0.125, tube: 0.014, segments: 16, rings: 6}; Rgb: {41, 39, 31} }
    for i in 0..8 {

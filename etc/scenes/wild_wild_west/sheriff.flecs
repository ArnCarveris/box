    hat { Position: {-2, 2.03, 2.63}; Box: {0.31, 0.04, 0.025}; Rgb: {83, 63, 43} }
    bench : WestPlank { Position: {1.5, 0.92, 3.3}; Box: {2, 0.12, 0.55} }

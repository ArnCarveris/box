    }

    notice : WestTimber { Position: {-2, 1.92, 2.55}; Box: {0.77, 1.05, 0.06} }
    paper { Position: {-2, 1.92, 2.595}; Box: {0.65, 0.91, 0.02}; Rgb: {229, 204, 151} }
    wanted {

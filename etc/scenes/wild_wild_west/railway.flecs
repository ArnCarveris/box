include materials
using flecs.script
using box.transform
using box.geometry
using box.material
using box.light
using box.text


assets {
  template WestRailway {
    ballast { Position: {0, 0.025, 0}; RoundedBox: {36, 0.13, 2.7, 0.06}; Rgb: {133, 114, 84} }
    for i in 0..46 {
      { Position: {-17.5 + i * 0.78, 0.15, 0}; Rotation: {0, math.sin(i * 7) * 0.025, 0}; Box: {0.26, 0.18, 2.25}; Rgb: {91 + i % 4 * 8, 67 + i % 4 * 6, 43} }
      for side in 0..2 {
        { (IsA, WestIron); Position: {-17.5 + i * 0.78, 0.26, (side - 0.5) * 1.45}; Box: {0.3, 0.035, 0.3} }
        for end in 0..2 {
          { Position: {-17.5 + i * 0.78, 0.29, (side - 0.5) * 1.45 + (end - 0.5) * 0.22}; Box: {0.055, 0.06, 0.055}; Rgb: {67, 63, 53} }
        }
      }
    }
    for side in 0..2 {
      { Position: {0, 0.28, (side - 0.5) * 1.45}; Box: {36, 0.07, 0.2}; Rgb: {98, 74, 55}; PbrMaterial: {metallic: 0.8, roughness: 0.65} }
      { Position: {0, 0.35, (side - 0.5) * 1.45}; Box: {36, 0.12, 0.06}; Rgb: {98, 74, 55}; PbrMaterial: {metallic: 0.8, roughness: 0.65} }
      { Position: {0, 0.43, (side - 0.5) * 1.45}; RoundedBox: {36, 0.07, 0.12, 0.02}; Rgb: {158, 157, 139}; PbrMaterial: {metallic: 0.85, roughness: 0.3} }
    }
    for i in 0..240 {
      { Position: {-17.8 + (i * 73 % 359) * 0.1, 0.115, math.sin(i * 6.73) * 1.24}; Scale: {1.4, 0.5, 1}; IcoSphere: {radius: 0.055 + i % 3 * 0.018, segments: 0}; Rgb: {128 + i % 5 * 9, 114 + i % 5 * 8, 90 + i % 5 * 7} }
    }
  }
}

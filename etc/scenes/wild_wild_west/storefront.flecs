include beam
include window
include lantern
using flecs.script
using box.transform
using box.geometry
using box.material
using box.light
using box.text


@tree Parent
template WestStorefront {
  prop width: f32 = 6
  prop height: f32 = 3.8
  prop tint: Rgb = {151, 102, 64}
  prop trim: Rgb = {232, 207, 155}
  foundation : WestTimber { Position: {0, 0.2, 0}; Box: {width + 0.2, 0.4, 5} }
  walls { Position: {0, height / 2 + 0.4, 0}; Box: {width, height, 4.8}; Rgb: tint }
  for row in 0..24 {
    const y = 0.5 + row * (height - 0.1) / 24
    for side in 0..2 {
      { Position: {0, y, (side - 0.5) * 4.84}; Box: {width, 0.025, 0.03}; Rgb: {98, 67, 43} }
      { Position: {(side - 0.5) * (width + 0.03), y, 0}; Box: {0.035, 0.025, 4.8}; Rgb: {98, 67, 43} }
    }
  }
  for side in 0..2 {
    for end in 0..2 {
      { Position: {(side - 0.5) * (width - 0.1), height / 2 + 0.4, (end - 0.5) * 4.84}; Box: {0.17, height, 0.15}; Rgb: trim }
    }
    WestWindow() { Position: {(side - 0.5) * (width + 0.13), 2.1, -0.6}; Rotation: {0, (side - 0.5) * math.PI, 0} }
    { Position: {(side - 0.5) * (width + 0.22), height + 0.46, 0}; Box: {0.18, 0.2, 5.2}; Rgb: trim }
  }
  roof : WestTimber { Position: {0, height + 0.4, 0}; Box: {width + 0.4, 0.16, 5.15} }
  for row in 0..11 {
    for col in 0..12 {
      { Position: {-width / 2 + (col + 0.5) * width / 12, height + 0.5 + row % 2 * 0.008, -2.35 + row * 0.47}; Box: {width / 12 - 0.025, 0.055, 0.45}; Rgb: {82 + (col * 3 + row * 5) % 4 * 9, 73 + (col + row) % 3 * 7, 57} }
    }
  }
  for plank in 0..32 {
    { Position: {-width / 2 - 0.25 + (plank + 0.5) * (width + 0.5) / 32, 0.39, 3.25}; Box: {(width + 0.5) / 32 - 0.015, 0.17, 2}; Rgb: {151 + plank % 4 * 9, 105 + plank % 4 * 7, 61 + plank % 4 * 4} }
  }
  for step in 0..2 {
    { Position: {0, 0.1 + step * 0.12, 4.7 - step * 0.24}; Box: {2.3, 0.2, 0.5}; Rgb: {157, 111, 64} }
  }
  for i in 0..4 {
    const x = -width / 2 + i * width / 3
    { Position: {x, 1.75, 4.05}; Box: {0.16, 2.7, 0.16}; Rgb: trim }
    { Position: {x, 0.6, 4.05}; Box: {0.24, 0.3, 0.24}; Rgb: {103, 64, 38} }
    WestBeam(ax: x, ay: 2.4, az: 4.05, bx: x + 0.4, by: 2.98, bz: 4.05, width: 0.09, tint: trim) {}
    WestBeam(ax: x, ay: 2.4, az: 4.05, bx: x - 0.4, by: 2.98, bz: 4.05, width: 0.09, tint: trim) {}
  }
  porch_roof : WestTimber { Position: {0, 3.12, 3.2}; Box: {width + 0.65, 0.18, 2.25} }
  fascia { Position: {0, 3.06, 4.33}; Box: {width + 0.65, 0.3, 0.12}; Rgb: trim }
  for i in 0..24 {
    { Position: {-width / 2 + (i + 0.5) * width / 24, 3.23, 3.2}; Box: {width / 24 - 0.016, 0.055, 2.2}; Rgb: {146 + i % 3 * 12, 99 + i % 3 * 9, 54} }
  }
  WestLantern() { Position: {-width / 2 + 0.3, 2.55, 2.8} }
  WestLantern() { Position: {width / 2 - 0.3, 2.55, 2.8} }
}

template WestFreight {
  WestCrate() { Position: {} }
  WestCrate() { Position: {1.05, 0, 0.1}; Rotation: {0, 0.12, 0} }
  WestCrate() { Position: {0.2, 0.84, 0}; Rotation: {0, -0.1, 0} }
  WestBarrel() { Position: {-0.9, 0, 0.2} }
  WestBarrel() { Position: {-0.8, 0, -0.9} }
  WestWheel(radius: 0.6) { Position: {1.7, 0.63, -0.6}; Rotation: {-0.15, -0.3, 0} }
}

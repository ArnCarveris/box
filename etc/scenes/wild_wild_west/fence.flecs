include beam
using flecs.script
using box.transform
using box.geometry
using box.material
using box.light
using box.text


assets {
  template WestFence {
    prop length: f32 = 6
    prop bays: i32 = 3
    for i in 0..bays + 1 {
      { Position: {-length / 2 + i * length / bays, 0.66, 0}; Box: {0.17, 1.32, 0.17}; Rgb: {116, 81, 46} }
      { Position: {-length / 2 + i * length / bays, 1.36, 0}; Cone: {radius: 0.12, length: 0.14, segments: 4}; Rotation: {0, math.PI / 4, 0}; Rgb: {165, 122, 69} }
    }
    for row in 0..3 {
      { Position: {0, 0.3 + row * 0.4, 0.035}; Box: {length + 0.12, 0.12, 0.09}; Rgb: {155, 111, 61} }
    }
    for i in 0..bays {
      WestBeam(ax: -length / 2 + i * length / bays, ay: 0.3, az: 0.07, bx: -length / 2 + (i + 1) * length / bays, by: 1.1, bz: 0.07, width: 0.065) {}
    }
  }
}

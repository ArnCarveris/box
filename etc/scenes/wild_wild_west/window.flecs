include materials
using flecs.script
using box.transform
using box.geometry
using box.material
using box.light
using box.text


assets {
  template WestWindow {
    prop barred: bool = false
    prop width: f32 = 1.1
    prop height: f32 = 1.45
    recess : WestTimber { Position: {}; Box: {width + 0.24, height + 0.24, 0.12} }
    pane : WestGlass { Position: {0, 0, 0.075}; Box: {width, height, 0.035} }
    for side in 0..2 {
      { Position: {(side - 0.5) * (width + 0.1), 0, 0.13}; Box: {0.1, height + 0.23, 0.12}; Rgb: {232, 207, 155} }
      { Position: {0, (side - 0.5) * (height + 0.1), 0.13}; Box: {width + 0.24, 0.1, 0.12}; Rgb: {232, 207, 155} }
    }
    sill : WestCream { Position: {0, -height / 2 - 0.16, 0.17}; Box: {width + 0.38, 0.12, 0.32} }
    if barred {
      for i in 0..5 {
        { (IsA, WestIron); Position: {(i - 2) * width / 5, 0, 0.2}; Cylinder: {radius: 0.025, length: height, segments: 8} }
      }
      crossbar : WestIron { Position: {0, 0, 0.22}; Box: {width, 0.045, 0.05} }
    } else {
      mullion : WestCream { Position: {0, 0, 0.13}; Box: {0.045, height, 0.06} }
      transom : WestCream { Position: {0, 0, 0.13}; Box: {width, 0.055, 0.06} }
      shade { Position: {0, height * 0.35, 0.1}; Box: {width - 0.08, height * 0.23, 0.02}; Rgb: {185, 157, 106} }
    }
  }
}

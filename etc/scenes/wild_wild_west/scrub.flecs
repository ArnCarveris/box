include materials
using flecs.script
using box.transform
using box.geometry
using box.material
using box.light
using box.text


assets {
  template WestScrub {
    for i in 0..11 {
      const a = i * 2.4
      { Position: {math.sin(a) * 0.13, 0.18, math.cos(a) * 0.13}; Rotation: {math.sin(a) * 0.65, a, 0.45}; Cone: {radius: 0.035, length: 0.6 + i % 3 * 0.09, segments: 5}; Rgb: {143 + i % 3 * 15, 131 + i % 3 * 9, 77} }
    }
  }
}

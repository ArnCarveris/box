include beam
include sign
using flecs.script
using box.transform
using box.geometry
using box.material
using box.light
using box.text


@tree Parent
template WestWaterTower {
  for side in 0..2 {
    for end in 0..2 {
      { Position: {(side - 0.5) * 2.3, 2.1, (end - 0.5) * 2.3}; Box: {0.25, 4.2, 0.25}; Rgb: {103, 64, 38} }
    }
    const s = (side - 0.5) * 2.3
    WestBeam(ax: -1.15, ay: 0.4, az: s, bx: 1.15, by: 3.8, bz: s, width: 0.14) {}
    WestBeam(ax: 1.15, ay: 0.4, az: s, bx: -1.15, by: 3.8, bz: s, width: 0.14) {}
    WestBeam(ax: s, ay: 0.4, az: -1.15, bx: s, by: 3.8, bz: 1.15, width: 0.14) {}
    { Position: {0, 4.08, s}; Box: {3.3, 0.2, 0.2}; Rgb: {103, 64, 38} }
  }
  deck : WestPlank { Position: {0, 4.25, 0}; Box: {3.4, 0.2, 3.4} }
  tank : WestTimber { Position: {0, 5.5, 0}; Cylinder: {radius: 1.48, length: 2.35, segments: 40} }
  for i in 0..40 {
    const a = i * math.PI / 20
    { Position: {math.sin(a) * 1.48, 5.5, math.cos(a) * 1.48}; Rotation: {0, a, 0}; Box: {0.215, 2.35, 0.075}; Rgb: {136 + i % 4 * 9, 92 + i % 4 * 7, 48 + i % 4 * 4} }
  }
  for i in 0..4 {
    { Position: {0, 4.48 + i * 0.68, 0}; Tube: {radius: 1.54, thickness: 0.035, length: 0.1, segments: 40}; Rgb: {49, 51, 48}; PbrMaterial: {metallic: 0.7, roughness: 0.7} }
  }
  roof : WestRed { Position: {0, 7.05, 0}; Cone: {radius: 1.75, length: 0.8, segments: 40} }
  roof_cap : WestIron { Position: {0, 7.48, 0}; Sphere: {radius: 0.1, segments: 12} }
  WestSign(label: "DRY CREEK", width: 2.2, height: 0.65, size: 0.3, tint: {110, 63, 35}) { Position: {0, 5.7, 1.54} }
  for side in 0..2 {
    { Position: {1.74, 2.1, (side - 0.5) * 0.55}; Box: {0.055, 4.2, 0.055}; Rgb: {49, 51, 48} }
  }
  for i in 0..13 {
    { Position: {1.74, 0.22 + i * 0.32, 0}; Box: {0.06, 0.045, 0.65}; Rgb: {49, 51, 48} }
  }
  downpipe : WestIron { Position: {-1.65, 2.8, 0}; Cylinder: {radius: 0.1, length: 4.4, segments: 12} }
  spout : WestIron { Position: {-1.65, 0.75, 0.65}; Rotation: {math.PI / 2, 0, 0}; Cylinder: {radius: 0.1, length: 1.3, segments: 12} }
  valve : WestRed { Position: {-1.65, 1.75, 0.16}; Rotation: {math.PI / 2, 0, 0}; Torus: {radius: 0.22, tube: 0.035, segments: 20, rings: 8} }
}

include materials
using flecs.script
using box.transform
using box.geometry
using box.material
using box.light
using box.text


west_barrel_profile {
  Path2D: {start: {0.36, 0}, segments: [{kind: CubicBezier, control1: {0.51, 0.3}, control2: {0.51, 0.7}, end: {0.36, 1}}]}
}

@tree Parent
template WestBarrel {
  body : WestPlank { Position: {}; Lathe: {profile: west_barrel_profile, segments: 24, rings: 12, cap_start: true, cap_end: true} }
  for i in 0..16 {
    const a = i * math.PI / 8
    for j in 0..4 {
      const t = j / 4.0
      const n = (j + 1) / 4.0
      const r1 = 0.364 + 0.45 * t * (1 - t)
      const r2 = 0.364 + 0.45 * n * (1 - n)
      {
        Position: {math.sin(a) * (r1 + r2) / 2, t + 0.125, math.cos(a) * (r1 + r2) / 2}
        Rotation: {math.atan2(r2 - r1, 0.25), a, 0}
        Box: {0.012, 0.255, 0.012}
        Rgb: {99, 65, 37}
      }
    }
  }
  for i in 0..3 {
    { Position: {0, 0.14 + i * 0.36, 0}; Tube: {radius: 0.422 + (1 - math.abs(i - 1)) * 0.055, length: 0.075, thickness: 0.022, segments: 24}; Rgb: {49, 51, 48}; PbrMaterial: {metallic: 0.7, roughness: 0.65} }
  }
  lid : WestPlank { Position: {0, 1.002, 0}; Cylinder: {radius: 0.345, length: 0.03, segments: 24} }
  for i in 0..3 {
    { Position: {(i - 1) * 0.16, 1.02, 0}; Box: {0.012, 0.008, 0.58}; Rgb: {103, 64, 38} }
  }
  bung : WestTimber { Position: {0.13, 1.025, 0.08}; Cylinder: {radius: 0.055, length: 0.025, segments: 12} }
}

include beam
using flecs.script
using box.transform
using box.geometry
using box.material
using box.light
using box.text


@tree Parent
template WestTelegraph {
  pole : WestTimber { Position: {0, 2.9, 0}; Cylinder: {radius: 0.11, length: 5.8, segments: 10} }
  for row in 0..2 {
    { Position: {0, 5 + row * 0.6, 0}; Box: {2.1, 0.13, 0.13}; Rgb: {103, 64, 38} }
    for i in 0..4 {
      { Position: {-0.85 + i * 0.57, 5.14 + row * 0.6, 0}; Cylinder: {radius: 0.07, length: 0.2, segments: 12}; Rgb: {71, 124, 117}; PbrMaterial: {roughness: 0.2} }
      { Position: {-0.85 + i * 0.57, 5.15 + row * 0.6, 0}; Torus: {radius: 0.075, tube: 0.025, segments: 12, rings: 6}; Rgb: {92, 146, 133} }
    }
  }
  WestBeam(ax: -0.8, ay: 5, az: 0, bx: 0, by: 4.4, bz: 0, width: 0.065) {}
  WestBeam(ax: 0.8, ay: 5, az: 0, bx: 0, by: 4.4, bz: 0, width: 0.065) {}
}

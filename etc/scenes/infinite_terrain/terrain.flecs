using flecs.script
using flecs.script.math
using box.material
using box.texture
using box.terrain
using box.render
using state
using assets

infinite_terrain {
  land {
    coords { nodes.Coords: {} }

    base_n { nodes.Noise: {frequency: 0.00045, octaves: 2, seed: 23} }
    base_h { nodes.Multiply: {a: base_n, b_value: {150, 150, 150, 150}} }

    chain_c { nodes.Transform: {angle_value: 35, scale: {1, 0.4, 1}} }
    chain_w { nodes.Noise: {channels: 3, frequency: 0.00035, octaves: 2, seed: 53} }
    chain { nodes.Warp: {coords: chain_c, offset: chain_w, amount_value: 1400} }
    range_n { nodes.Noise: {coords: chain, frequency: 0.00024, octaves: 2, seed: 51} }
    range {
      nodes.Smoothstep: {input: range_n, edge0_value: {0.54, 0, 0, 0}, edge1_value: {0.72, 0, 0, 0}}
    }

    ridge_w { nodes.Noise: {channels: 3, frequency: 0.0016, octaves: 2, seed: 54} }
    ridge_c { nodes.Warp: {coords: coords, offset: ridge_w, amount_value: 260} }
    ridges {
      nodes.Noise: {coords: ridge_c, frequency: 0.0007, octaves: 6, fractal: NoiseRidged, seed: 52}
    }

    ridges_p { nodes.Power: {a: ridges, b_value: {1.5, 1.5, 1.5, 1.5}} }
    peaks_r { nodes.Multiply: {a: ridges_p, b: range} }
    peaks_m { nodes.Multiply: {a: peaks_r, b_value: {640, 640, 640, 640}} }
    flow_n { nodes.Noise: {coords: ridge_c, frequency: 0.0007, octaves: 2, seed: 52} }
    flow_r { nodes.Multiply: {a: flow_n, b: range} }
    flow_m { nodes.Multiply: {a: flow_r, b_value: {1600, 1600, 1600, 1600}} }
    peaks_g { nodes.Gradient: {height: flow_m} }
    gullies {
      nodes.Erosion: {
        slope: peaks_g,
        frequency: 0.004,
        octaves: 3,
        gain: 0.45,
        scale: 1.6,
        branch: 0.6,
        seed: 55
      }
    }

    peaks_gl { nodes.Length: {input: peaks_g} }
    gully_s {
      nodes.Smoothstep: {input: peaks_gl, edge0_value: {0.3, 0, 0, 0}, edge1_value: {0.9, 0, 0, 0}}
    }

    gully_r { nodes.Multiply: {a: peaks_r, b: gully_s} }
    gully_d { nodes.Multiply: {a: gully_r, b_value: {60, 60, 60, 60}} }
    gully_h { nodes.Multiply: {a: gullies, b: gully_d} }
    peaks_h { nodes.Add: {a: peaks_m, b: gully_h} }
    foothills_h { nodes.Multiply: {a: range, b_value: {90, 90, 90, 90}} }

    meander { nodes.Noise: {channels: 3, frequency: 0.004, octaves: 2, seed: 25} }
    warped { nodes.Warp: {coords: coords, offset: meander, amount_value: 36} }

    clear_cells { nodes.Cells: {distance: CellsNearest, size: 300, seed: 31, coords: warped} }
    clear_d { nodes.Split: {input: clear_cells, channel: ChannelR} }
    clear_r { nodes.Split: {input: clear_cells, channel: ChannelB} }
    clear_in {
      nodes.Smoothstep: {input: clear_d, edge0_value: {0.19, 0, 0, 0}, edge1_value: {0.11, 0, 0, 0}}
    }

    clear_kept {
      nodes.Smoothstep: {input: clear_r, edge0_value: {0.5, 0, 0, 0}, edge1_value: {0.46, 0, 0, 0}}
    }

    clearing { nodes.Multiply: {a: clear_in, b: clear_kept} }

    brook_bend { nodes.Noise: {channels: 3, frequency: 0.0025, octaves: 2, seed: 81} }
    brook_bent { nodes.Warp: {coords: coords, offset: brook_bend, amount_value: 60} }
    brook_wind { nodes.Noise: {channels: 3, frequency: 0.011, octaves: 2, seed: 82} }
    brook_coords { nodes.Warp: {coords: brook_bent, offset: brook_wind, amount_value: 18} }
    brook_near {
      nodes.Cells: {distance: CellsNearest, size: BROOK_SIZE, seed: 83, coords: brook_coords}
    }

    brook_second {
      nodes.Cells: {distance: CellsSecond, size: BROOK_SIZE, seed: 83, coords: brook_coords}
    }

    brook_f1 { nodes.Split: {input: brook_near, channel: ChannelR} }
    brook_f2 { nodes.Split: {input: brook_second, channel: ChannelR} }
    brook_e { nodes.Subtract: {a: brook_f2, b: brook_f1} }
    brook_x {
      nodes.Multiply: {a: brook_e, b_value: {BROOK_SIZE, BROOK_SIZE, BROOK_SIZE, BROOK_SIZE}}
    }

    brook_g { nodes.Gradient: {height: brook_x} }
    brook_gl { nodes.Length: {input: brook_g} }
    brook_gb { nodes.Blur: {input: brook_gl, radius: 3} }
    brook_gc { nodes.Max: {a: brook_gb, b_value: {0.7, 0.7, 0.7, 0.7}} }
    brook_d0 { nodes.Divide: {a: brook_x, b: brook_gc} }

    hill_n { nodes.Noise: {frequency: 0.0011, octaves: 2, seed: 26} }
    hill_amp {
      nodes.Remap: {
        input: hill_n, from_min: 0.25, from_max: 0.75, to_min: 10, to_max: 55, clamp: true
      }
    }

    width_n { nodes.Noise: {frequency: 0.004, octaves: 2, seed: 28} }

    width_k {
      nodes.Remap: {
        input: width_n, from_min: 0.25, from_max: 0.75, to_min: 0.6, to_max: 1.5, clamp: true
      }
    }

    vale_x { nodes.Multiply: {a: brook_x, b_value: {0.55, 0.55, 0.55, 0.55}} }
    vale_d { nodes.Multiply: {a: vale_x, b: width_k} }
    vale {
      nodes.Curve: {input: vale_d, curve: {kind: CurveCatmullRom, keys: [
        {0, 0}, {8, 0.01}, {20, 0.05}, {45, 0.22}, {80, 0.55}, {120, 0.85}, {170, 1}, {400, 1}
      ]}}
    }

    vale_a { nodes.Multiply: {a: vale, b: hill_amp} }
    spur_n { nodes.Noise: {frequency: 0.0045, octaves: 3, seed: 29} }
    spur_c { nodes.Remap: {input: spur_n, from_min: 0.2, from_max: 0.8, to_min: -0.5, to_max: 0.5} }
    spur_a { nodes.Multiply: {a: spur_c, b: hill_amp} }
    spur_h { nodes.Multiply: {a: spur_a, b: vale} }
    vale_h { nodes.Add: {a: vale_a, b: spur_h} }

    brook_ranges {
      nodes.Smoothstep: {input: range_n, edge0_value: {0.53, 0, 0, 0}, edge1_value: {0.58, 0, 0, 0}}
    }

    brook_uplands {
      nodes.Smoothstep: {input: base_n, edge0_value: {0.64, 0, 0, 0}, edge1_value: {0.74, 0, 0, 0}}
    }

    brook_away { nodes.Max: {a: brook_ranges, b: brook_uplands} }
    brook_far { nodes.Multiply: {a: brook_away, b_value: {200, 200, 200, 200}} }
    brook_d { nodes.Add: {a: brook_d0, b: brook_far} }

    trail_cells {
      nodes.Cells: {distance: CellsEdge, size: 190, edge: 0.1, seed: 61, coords: warped}
    }

    trail_e { nodes.Split: {input: trail_cells, channel: ChannelR} }
    track_all {
      nodes.Remap: {
        input: trail_e, from_min: 0.03, from_max: 0.1, to_min: 1, to_max: 0, clamp: true
      }
    }

    track {
      nodes.Multiply: {a: track_all, b_value: {
        paths ? 1 : 0, paths ? 1 : 0, paths ? 1 : 0, paths ? 1 : 0
      }}
    }

    trail_h { nodes.Multiply: {a: track, b_value: {-0.35, -0.35, -0.35, -0.35}} }

    pre_a { nodes.Add: {a: base_h, b: vale_h} }
    pre { nodes.Add: {a: pre_a, b: foothills_h} }

    pre_slope { nodes.Slope: {height: pre} }
    fold_n { nodes.Noise: {frequency: 0.0004, octaves: 2, seed: 27} }
    fold_h { nodes.Multiply: {a: fold_n, b_value: {24, 24, 24, 24}} }
    jag_n { nodes.Noise: {frequency: 0.01, octaves: 3, seed: 43} }
    jag_m { nodes.Remap: {input: jag_n, from_min: 0.2, from_max: 0.8, to_min: -16, to_max: 16} }
    jag_h { nodes.Multiply: {a: jag_m, b: pre_slope} }
    strata_a { nodes.Add: {a: pre, b: fold_h} }
    strata_s { nodes.Add: {a: strata_a, b: jag_h} }
    strata_q {
      nodes.Divide: {
        a: strata_s, b_value: {STRATA_PERIOD, STRATA_PERIOD, STRATA_PERIOD, STRATA_PERIOD}
      }
    }

    strata_f { nodes.Fract: {input: strata_q} }
    strata_sharp {
      nodes.Curve: {input: strata_f, curve: {keys: [
        {0, 0}, {0.2, 0.05}, {0.38, 0.1}, {0.45, 0.15}, {0.5, 0.23}, {0.52, 0.29}, {0.535, 0.42},
        {0.553, 0.6}, {0.57, 0.7}, {0.59, 0.745}, {0.62, 0.765}, {0.8, 0.8}, {0.845, 0.845},
        {0.86, 0.87}, {0.87, 0.92}, {0.882, 0.95}, {0.9, 0.965}, {1, 1}
      ]}}
    }

    strata_soft {
      nodes.Curve: {input: strata_f, curve: {keys: [
        {0, 0}, {0.2, 0.05}, {0.36, 0.1}, {0.42, 0.15}, {0.47, 0.23}, {0.5, 0.29}, {0.53, 0.42},
        {0.57, 0.6}, {0.61, 0.7}, {0.64, 0.745}, {0.68, 0.765}, {0.8, 0.8}, {0.84, 0.845},
        {0.86, 0.87}, {0.88, 0.92}, {0.9, 0.95}, {0.93, 0.965}, {1, 1}
      ]}}
    }

    soft_k {
      nodes.Smoothstep: {
        input: pre_slope, edge0_value: {0.2, 0, 0, 0}, edge1_value: {0.45, 0, 0, 0}
      }
    }

    strata_t { nodes.Mix: {a: strata_sharp, b: strata_soft, factor: soft_k} }

    strata_dt { nodes.Subtract: {a: strata_t, b: strata_f} }
    strata_dev {
      nodes.Multiply: {
        a: strata_dt, b_value: {STRATA_PERIOD, STRATA_PERIOD, STRATA_PERIOD, STRATA_PERIOD}
      }
    }

    hard_n { nodes.Noise: {frequency: 0.0009, octaves: 2, seed: 46} }
    hard_r {
      nodes.Smoothstep: {input: hard_n, edge0_value: {0.42, 0, 0, 0}, edge1_value: {0.56, 0, 0, 0}}
    }

    hard_v {
      nodes.Smoothstep: {input: vale_x, edge0_value: {18, 0, 0, 0}, edge1_value: {60, 0, 0, 0}}
    }

    pass_cells {
      nodes.Cells: {distance: CellsEdge, size: 190, edge: 0.5, seed: 61, coords: warped}
    }

    pass_d { nodes.Split: {input: pass_cells, channel: ChannelR} }
    pass_e {
      nodes.Smoothstep: {input: pass_d, edge0_value: {0.05, 0, 0, 0}, edge1_value: {0.7, 0, 0, 0}}
    }

    hard_s {
      nodes.Smoothstep: {input: pre_slope, edge0_value: {0.1, 0, 0, 0}, edge1_value: {0.2, 0, 0, 0}}
    }

    hard_t {
      nodes.Smoothstep: {input: pre_slope, edge0_value: {0.8, 0, 0, 0}, edge1_value: {0.5, 0, 0, 0}}
    }

    hard_a { nodes.Multiply: {a: hard_r, b: hard_v} }
    hard_st { nodes.Multiply: {a: hard_s, b: hard_t} }
    hard_b { nodes.Multiply: {a: hard_a, b: hard_st} }
    hard { nodes.Multiply: {a: hard_b, b: pass_e} }
    cliffs_h { nodes.Multiply: {a: strata_dev, b: hard} }

    face_lo {
      nodes.Smoothstep: {input: strata_f, edge0_value: {0.5, 0, 0, 0}, edge1_value: {0.53, 0, 0, 0}}
    }

    face_hi {
      nodes.Smoothstep: {
        input: strata_f, edge0_value: {0.62, 0, 0, 0}, edge1_value: {0.57, 0, 0, 0}
      }
    }

    face_b { nodes.Multiply: {a: face_lo, b: face_hi} }
    face { nodes.Multiply: {a: face_b, b: hard} }
    crags { nodes.Noise: {frequency: 0.06, octaves: 3, seed: 44} }
    crags_c { nodes.Remap: {input: crags, from_min: 0.25, from_max: 0.75, to_min: -2, to_max: 2} }
    crags_h { nodes.Multiply: {a: crags_c, b: face} }
    cliffs_c { nodes.Add: {a: cliffs_h, b: crags_h} }
    h1 { nodes.Add: {a: pre, b: cliffs_c} }
    h2 { nodes.Add: {a: h1, b: peaks_h} }

    wooded { nodes.Subtract: {a_value: {1, 1, 1, 1}, b: clearing} }
    bumps { nodes.Noise: {frequency: 0.018, octaves: 3, seed: 22} }
    bumps_c { nodes.Remap: {input: bumps, from_min: 0, from_max: 1, to_min: -3, to_max: 3} }
    bumps_w { nodes.Multiply: {a: bumps_c, b: wooded} }
    bumps_v {
      nodes.Smoothstep: {input: vale_x, edge0_value: {10, 0, 0, 0}, edge1_value: {45, 0, 0, 0}}
    }

    bumps_h { nodes.Multiply: {a: bumps_w, b: bumps_v} }

    h3 { nodes.Add: {a: h2, b: bumps_h} }
    h4 { nodes.Add: {a: h3, b: trail_h} }

    brook_ground_a { nodes.Add: {a: base_h, b: foothills_h} }
    brook_ground { nodes.Add: {a: brook_ground_a, b: peaks_h} }
    brook_sunk {
      nodes.Subtract: {a: brook_ground, b_value: {BROOK_SINK, BROOK_SINK, BROOK_SINK, BROOK_SINK}}
    }

    brook_sg { nodes.Gradient: {height: brook_ground} }
    brook_n { nodes.Normalize: {input: brook_g} }
    brook_tilt { nodes.Dot: {a: brook_sg, b: brook_n} }
    brook_level { nodes.Min: {a: brook_d0, b_value: {8, 8, 8, 8}} }
    brook_lift { nodes.Multiply: {a: brook_tilt, b: brook_level} }
    brook_bed { nodes.Subtract: {a: brook_sunk, b: brook_lift} }
    brook_q {
      nodes.Divide: {a: brook_bed, b_value: {BROOK_STEP, BROOK_STEP, BROOK_STEP, BROOK_STEP}}
    }

    brook_qf { nodes.Floor: {input: brook_q} }
    brook_steps {
      nodes.Multiply: {a: brook_qf, b_value: {BROOK_STEP, BROOK_STEP, BROOK_STEP, BROOK_STEP}}
    }

    brook_rise {
      nodes.Curve: {input: brook_d, curve: {kind: CurveCatmullRom, keys: [
        {0, -0.5}, {0.9, -0.42}, {1.5, 0.1}, {2.2, 0.6}, {3, 1}, {4.5, 1.35}, {8, 1.9},
        {14, 3.2}, {22, 5}, {32, 8}, {45, 16}, {60, 40}, {80, 200}, {100, 1000}
      ]}}
    }

    brook_bank { nodes.Add: {a: brook_bed, b: brook_rise} }
    brook_cut_w { nodes.Max: {a: brook_steps, b: brook_bank} }
    brook_cut {
      nodes.Add: {a: brook_cut_w, b_value: {
        water ? 0 : 100000, water ? 0 : 100000, water ? 0 : 100000, water ? 0 : 100000
      }}
    }

    height { nodes.Min: {a: h4, b: brook_cut} }

    slope { nodes.Slope: {height: height} }
    rock {
      nodes.Smoothstep: {input: slope, edge0_value: {1, 0, 0, 0}, edge1_value: {1.5, 0, 0, 0}}
    }

    open { nodes.Subtract: {a_value: {1, 1, 1, 1}, b: rock} }

    foot_lo {
      nodes.Smoothstep: {
        input: strata_f, edge0_value: {0.36, 0, 0, 0}, edge1_value: {0.44, 0, 0, 0}
      }
    }

    foot_hi {
      nodes.Smoothstep: {
        input: strata_f, edge0_value: {0.57, 0, 0, 0}, edge1_value: {0.53, 0, 0, 0}
      }
    }

    foot_b { nodes.Multiply: {a: foot_lo, b: foot_hi} }
    foot_s {
      nodes.Smoothstep: {input: slope, edge0_value: {0.2, 0, 0, 0}, edge1_value: {0.45, 0, 0, 0}}
    }

    foot_h { nodes.Multiply: {a: foot_b, b: hard} }
    foot { nodes.Multiply: {a: foot_h, b: foot_s} }
    talus_s {
      nodes.Smoothstep: {input: slope, edge0_value: {0.48, 0, 0, 0}, edge1_value: {0.8, 0, 0, 0}}
    }

    talus { nodes.Multiply: {a: talus_s, b: range} }
    alt_n { nodes.Noise: {frequency: 0.006, octaves: 3, seed: 47} }
    alt_d { nodes.Remap: {input: alt_n, from_min: 0, from_max: 1, to_min: -50, to_max: 50} }
    alt { nodes.Add: {a: height, b: alt_d} }
    barren {
      nodes.Smoothstep: {
        input: alt, edge0_value: {BARREN_LINE - 40, 0, 0, 0},
        edge1_value: {BARREN_LINE + 40, 0, 0, 0}
      }
    }

    scree_a { nodes.Max: {a: foot, b: talus} }
    scree { nodes.Max: {a: scree_a, b: barren} }
    scree_w { nodes.Multiply: {a: scree, b: open} }
    rest_a { nodes.Subtract: {a: open, b: scree_w} }

    trail_w { nodes.Multiply: {a: track, b: rest_a} }
    rest_c { nodes.Subtract: {a: rest_a, b: trail_w} }

    brook_bank_m0 {
      nodes.Smoothstep: {input: brook_d, edge0_value: {5.5, 0, 0, 0}, edge1_value: {2.4, 0, 0, 0}}
    }

    brook_bank_m {
      nodes.Multiply: {a: brook_bank_m0, b_value: {
        water ? 1 : 0, water ? 1 : 0, water ? 1 : 0, water ? 1 : 0
      }}
    }

    brook_core_m {
      nodes.Smoothstep: {input: brook_d, edge0_value: {2.4, 0, 0, 0}, edge1_value: {1.2, 0, 0, 0}}
    }

    brook_w { nodes.Multiply: {a: brook_bank_m, b: rest_c} }
    rest_d { nodes.Subtract: {a: rest_c, b: brook_w} }
    brook_core_w { nodes.Multiply: {a: brook_w, b: brook_core_m} }
    brook_stone_w { nodes.Multiply: {a: brook_core_w, b_value: {0.55, 0.55, 0.55, 0.55}} }
    brook_mud_w { nodes.Subtract: {a: brook_w, b: brook_stone_w} }

    alpine {
      nodes.Smoothstep: {input: alt, edge0_value: {210, 0, 0, 0}, edge1_value: {300, 0, 0, 0}}
    }

    meadow { nodes.Max: {a: clearing, b: alpine} }
    grass_w { nodes.Multiply: {a: meadow, b: rest_d} }
    rough_w { nodes.Subtract: {a: rest_d, b: grass_w} }

    scree_dirt { nodes.Multiply: {a: scree_w, b_value: {0.85, 0.85, 0.85, 0.85}} }
    scree_rock { nodes.Multiply: {a: scree_w, b_value: {0.15, 0.15, 0.15, 0.15}} }
    dirt_a { nodes.Add: {a: trail_w, b: scree_dirt} }
    dirt_w { nodes.Add: {a: dirt_a, b: brook_mud_w} }
    rock_a { nodes.Add: {a: rock, b: scree_rock} }
    rock_w { nodes.Add: {a: rock_a, b: brook_stone_w} }
    masks { nodes.Combine: {r: rough_w, g: grass_w, b: dirt_w, a: rock_w} }

    Terrain: {
      height: height,
      masks: masks,
      tile_size: tile_size,
      resolution: resolution,
      levels: levels,
      lod_distance: detail,
      min_height: GROUND_MIN,
      max_height: GROUND_MAX,
      budget: budget,
      query_spacing: QUERY_SPACING,
      query_radius: QUERY_RADIUS
    }

    texture.Blend: {
      layers: [terrain_rough, terrain_grass, terrain_dirt, terrain_cliff],
      heights: [
        terrain_rough_height, terrain_grass_height, terrain_dirt_height, terrain_cliff_height
      ],
      contrast: 6
    }

    texture.Mapping: {mode: MappingWorld, size: GROUND_MAP_SIZE, blend: 0.4}
    texture.Layers: {layers: [terrain_peak_snow]}
    Rgb: {212, 206, 196}
    PbrMaterial: {roughness: 0.95}

    brook_data_h { nodes.Subtract: {a: height, b_value: {BROOK_DATA_DROP, 0, 0, 0}} }
    brook_data { nodes.Combine: {r: brook_d, g: brook_bed} }
  }

  brooks {
    Terrain: {
      height: infinite_terrain.land.brook_data_h,
      masks: infinite_terrain.land.brook_data,
      tile_size: 1024,
      resolution: 5,
      levels: 1,
      lod_distance: 3072,
      min_height: GROUND_MIN - BROOK_DATA_DROP,
      max_height: GROUND_MAX - BROOK_DATA_DROP,
      budget: 24,
      query_spacing: QUERY_SPACING,
      query_radius: BROOK_QUERY_RADIUS,
      query_only: true
    }
  }
}

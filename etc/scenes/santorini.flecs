    }
  }
  rope_coil { Position: {0.3, 0.54, -0.9}; Torus: {radius: 0.13, tube: 0.035, segments: 20, rings: 6}; Rgb: {196, 168, 119} }
  basket { Position: {-0.22, 0.38, -0.25}; Cylinder: {radius: 0.2, length: 0.25, segments: 16}; Rgb: wood }
  for i in 0..4 {
    { Position: {-0.22, 0.28 + i * 0.065, -0.25}; Torus: {radius: 0.2, tube: 0.016, segments: 16, rings: 6}; Rgb: {192, 157, 100} }
  }
}

@tree Parent
template IslandPaving {
  prop width: f32 = 5
  prop depth: f32 = 3
  prop columns: i32 = 8
  prop rows: i32 = 5
  slab { Position: {0, -0.07, 0}; RoundedBox: {width, 0.14, depth, 0.06}; Rgb: chalk }
  for row in 0..rows {
    for col in 0..columns {
      const tone = (row * 7 + col * 13) % 5
      {
        Position: {-width / 2 + (col + 0.5) * width / columns, 0.008, -depth / 2 + (row + 0.5) * depth / rows}
        Rotation: {0, math.sin(row * 8 + col * 3) * 0.04, 0}
        RoundedBox: {width / columns - 0.06, 0.045, depth / rows - 0.06, 0.07}
        Rgb: {182 + tone * 8, 179 + tone * 8, 163 + tone * 8}
      }
    }
  }
}


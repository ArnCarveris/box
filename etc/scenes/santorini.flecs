  IslandBeam(ay: 2.94, az: 0.4, by: 0.62, bz: 1.95, radius: 0.009, tint: plaster) {}
  IslandBeam(ay: 2.94, az: 0.4, by: 0.62, bz: -1.34, radius: 0.009, tint: plaster) {}
  flag {

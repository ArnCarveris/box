// Infinite forest: an endless forest to walk through: terrain without end, rolling forest floor in
// hills and valleys, clearings, a network of trails, brooks stepping down the valley floors, bands
// of bedded cliffs with scree at their feet along the valley sides and mountain ranges with snow
// on their peaks in the distance, grown over with
// stands of beech, oak, birch, spruce and fir, young trees and snags, and an undergrowth of grass,
// flowers, ferns, shrubs, logs, stumps, rocks and litter around the player.
// Walk with WASD, F switches to flying and back; the panel of the forest library (H hides it) sets
// the season, the weather, the wind and the time of day.
//
// The forest library (forest/library) brings the state the sliders write, the materials, the
// weather, the sky and the HUD. This scene adds one file per concern in infinite_forest/: its constants
// and the fly toggle, the terrain materials, the terrain, the grass blades of the clearings, the
// player, the tree library, the stands that stream its trees over the terrain, the undergrowth
// that streams the plants of the forest library close around the player, the water, stones and reeds of the brooks, the rare landmarks
// along the way (boulder fields and crags, fallen trunks, signposts, giant trees, ruins, cairns and
// ponds), the motes and pollen in the air, what falls from the trees in the wind, the insects
// around the player and the view.
include ui/widgets
include trees/generator
include forest/library
include forest/fog
include infinite_forest/state
include infinite_forest/materials
include infinite_terrain/cliff
include infinite_forest/terrain
include infinite_forest/grass
include infinite_forest/player
include infinite_forest/trees
include infinite_forest/stands
include infinite_forest/undergrowth
include infinite_forest/brooks
include infinite_forest/landmarks
include infinite_forest/air
include infinite_forest/fall
include infinite_forest/insects
include infinite_forest/view

using box.view

$ {
  box.app.FpsTarget: {60}
  Scene: {
    reflections: true,
    environment: true,
    aerial_perspective: true,
    cookies: true,
    shader_features: {
      Extended: {
        alpha_cutout: true,
        blend_modes: true,
        texture_blend: true,
        water: true,
        texture_layers: true,
        wind: true
      },
      Terrain: {
        texture_blend: true,
        texture_layers: true,
        triplanar: true
      }
    }
  }
}

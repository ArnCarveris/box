using flecs.script
using box.transform
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.controllers
using box.atmosphere

// Above the near quay, looking north-west across the Seine at the far bank, where the Eiffel
// Tower rises above the rooftops.
camera {
  Position: {48, 22, -13}
  Rotation: {-0.06, 0.565, 0}
  Camera: {fov: 60, near_: 0.1, far_: 600}
  CameraController: {speed: 14}
}

paris {
  // Over the far bank, above the rooftops, looking south-west across the Seine and the bridge at
  // the quay facades and the boulevard.
  facades_camera {
    Position: {40, 38, -64}
    Rotation: {-0.42, 2.5, 0}
    Camera: {fov: 45, near_: 0.1, far_: 600}
    CameraController: {speed: 14}
  }

  // On the cross street, looking at the square: the café terrace, the Morris column and the
  // Métro entrance.
  street_camera {
    Position: {3, 1.9, 23}
    Rotation: {-0.04, -2.29, 0}
    Camera: {fov: 60, near_: 0.05, far_: 400}
    CameraController: {speed: 5}
  }

  boulevard_camera {
    Position: {2.6, 1.7, 54}
    Rotation: {0.05, 0.04, 0}
    Camera: {fov: 52, near_: 0.05, far_: 400}
    CameraController: {speed: 5}
  }

  quay_camera {
    Position: {48, -0.5, -24.4}
    Rotation: {0.07, 1.45, 0}
    Camera: {fov: 52, near_: 0.05, far_: 400}
    CameraController: {speed: 5}
  }
}

// The moon comes first so that it, not the set sun, casts the cascaded shadows.
moon {
  DirectionalLight: {intensity: 0.6 * math.PI}
  Rgb: {196, 212, 255}
}

sun {
  DirectionalLight: {intensity: 3 * math.PI}
  Rgb: {255, 240, 224}
}

sky {
  Atmosphere: {
    sun: sun,
    moon: moon,
    units_per_km: 100,
    rayleigh: {scale_height: 8, scattering_scale: 1.2},
    mie: {scale_height: 1.2, anisotropy: 0.8, scattering_scale: 1.4, tint: {255, 220, 190}},
    ozone_scale: 2,
    ground_albedo: {60, 60, 70},
    night_tint: {58, 84, 190},
    night_intensity: 0.05,
    sun_disk_intensity: 4,
    moon_radius: 1.4,
    moon_disk_intensity: 20,
    earthshine: 0.04
  }
  TimeOfDay: {
    hour: 21.4,
    day_of_year: 172,
    latitude: 48.85,
    north: 180,
    moon_offset: 4,
    sun: sun,
    moon: moon
  }
  HeightFog: {density: 0.006, falloff: 0.12, base_height: -3, max_opacity: 0.35, atmosphere: sky}
}

stars {
  Rotation: {0.5, 0.3, 0.9}
  StarField: {count: 9000, brightness: 2.5, size: 1.3}
}

$ {
  AmbientLight: {sky: {60, 74, 110}, ground: {40, 34, 30}, intensity: 0.08}
  ReflectionBake: {resolution: 64, budget_ms: 2, scene_probe: true, scene_probe_height: 3}
  Bake: {
    environment: sky,
    probe_spacing: 4,
    bounds_padding: 0.5,
    bounces: 1,
    capture_size: 32,
    budget_ms: 6
  }
}

view {
  gtao { Gtao: {radius: 0.7, final_value_power: 1.8} }
  bloom { Bloom: {intensity: 0.18, threshold: 1.2, threshold_softness: 0.5} }
  exposure {
    AutoExposure: {
      min_log_luma: -14,
      max_log_luma: 4,
      min_brightness: 0.1,
      max_brightness: 0.26,
      exposure_compensation: -0.6
    }
  }

  tonemap { Tonemap: {auto_exposure: exposure, operator_: TonyMcMapface} }
  smaa { Smaa: {} }

  View: {
    camera: camera,
    clear: {enabled: true, color: {8, 10, 20, 255}},
    lighting: {
      enabled: true,
      baked: true,
      reflections: true,
      atmosphere: true,
      environment: {source: sky, intensity: 1, yaw: 0, background: false}
    },
    shadows: {enabled: true, resolution: 2048, max_distance: 160},
    effects: [
      {enabled: true, effect: gtao},
      {enabled: true, effect: sky},
      {enabled: true, effect: bloom},
      {enabled: true, effect: tonemap},
      {enabled: true, effect: smaa}
    ]
  }
}

include materials
include state
include clock
include raccoon
using flecs.script
using flecs.script.math
using box.transform
using box.camera
using box.controllers
using state
using assets

$ {
  box.particle.Settings: {effect_max: 12, effect_total: 24, effect_overflow: EffectRecycle}
}

paris {
  // The raccoons: one per entry of state.pr_raccoons.
  raccoons {
    for i in 0..PR_RACCOONS {
      ParisRaccoon "raccoon_{i}"(id: i, seed: i * 2.17 + 0.3)
    }
  }

  // Low on the quay promenade under the lamp, beside the bin where raccoon 0 digs at the start,
  // so it shows the masked face and the ringed tail.
  raccoon_camera {
    Position: {-41.07, 0.9, -18.16}
    Rotation: {-0.1, -2.1, 0}
    Camera: {fov: 50, near_: 0.05, far_: 400}
    CameraController: {speed: 3}
  }
}

// The raccoons wander the street graph, dig in bins and hide in one hideout to come out of
// another. Each frame works on a copy of state.pr_raccoons (so other logic, like ParisHunt, can
// change it between frames) and writes it back once.
async {
  const rng: math.Rng = {seed: 4417}
  // Sideways offset from the line between two nodes, to the right of the way a raccoon walks, so
  // that raccoons meeting on a link pass each other.
  const lane: f32 = 0.35

  mut rs: ParisRaccoonState[10] = pr_raccoons

  while true {
    await next_frame()
    const step = dt
    rs = pr_raccoons

    for i in 0..PR_RACCOONS {
      const r = rs[i]
      mut x: f32 = r.x
      mut y: f32 = r.y
      mut z: f32 = r.z
      mut yaw: f32 = r.yaw
      mut node: i32 = r.node
      mut target: i32 = r.target
      mut prev: i32 = r.prev
      mut behaviour: i32 = r.behaviour
      mut goal: i32 = r.goal
      mut timer: f32 = r.timer + step
      mut wait: f32 = r.wait
      mut cooldown: f32 = max(0, r.cooldown - step)
      mut hideout: i32 = r.hideout
      mut gait: f32 = r.gait
      mut speed: f32 = r.speed
      mut rearing: f32 = r.rearing
      mut hidden: f32 = r.hidden

      const trot: f32 = 1.3 + pr_hash(i * 3.1 + 0.7) * 0.4

      // What the behaviour asks for this frame: walk to (gx, gz) at `want` along the segment
      // from (ax, az) to (bx, bz) whose ends have the ground heights ay and by, or stand and turn
      // to `face`; `placed` means the behaviour set x, y and z itself.
      mut gx: f32 = x
      mut gz: f32 = z
      mut want: f32 = 0
      mut ax: f32 = x
      mut ay: f32 = y
      mut az: f32 = z
      mut bx: f32 = x
      mut by: f32 = y
      mut bz: f32 = z
      mut face: f32 = yaw
      mut turn = false
      mut placed = false
      mut rear_to: f32 = 0
      mut choose = false

      if behaviour == PR_RC_WANDER {
        const a = pr_nodes[node]
        const b = pr_nodes[target]
        const ldx = b.x - a.x
        const ldz = b.z - a.z
        const ll = sqrt(ldx * ldx + ldz * ldz)
        ax = a.x
        ay = a.y
        az = a.z
        bx = b.x
        by = b.y
        bz = b.z
        gx = ll > 0.01 ? b.x + ldz / ll * lane : b.x
        gz = ll > 0.01 ? b.z - ldx / ll * lane : b.z
        want = wait
        hidden = 0

        const ex = gx - x
        const ez = gz - z
        if ex * ex + ez * ez < 0.09 {
          // Arrived at the target node: use the hideout here, pause or trot on.
          if target != node {
            prev = node
            node = target
          }

          const h = cooldown <= 0 ? pr_hideout_at(node) : -1
          mut busy = false
          if h >= 0 {
            for j in 0..PR_RACCOONS {
              if j != i && rs[j].hideout == h {
                busy = true
              }
            }
          }

          const roll = rng.f(1)
          const bin = h >= 0 && pr_hideouts[h].kind == PR_HIDE_BIN
          const hide_p: f32 = bin ? 0.7 : 0.5

          if h >= 0 && !busy && bin && roll < 0.45 {
            behaviour = PR_RC_APPROACH
            goal = PR_RC_RUMMAGE
            hideout = h
            timer = 0
          } else if h >= 0 && !busy && roll < hide_p {
            behaviour = PR_RC_APPROACH
            goal = PR_RC_HIDE
            hideout = h
            timer = 0
          } else if roll > 0.85 {
            behaviour = PR_RC_PAUSE
            timer = 0
            wait = 0.8 + rng.f(1.6)
          } else {
            choose = true
          }
        }
      } else if behaviour == PR_RC_PAUSE {
        // Stand up and look around (the head turns with the slow gait).
        rear_to = 0.65
        hidden = 0
        if timer >= wait {
          choose = true
        }
      } else if behaviour == PR_RC_APPROACH {
        const a = pr_nodes[node]
        ax = a.x
        ay = a.y
        az = a.z
        bx = pr_hideout_spot_x(hideout)
        by = pr_hideout_spot_y(hideout)
        bz = pr_hideout_spot_z(hideout)
        gx = bx
        gz = bz
        want = trot * 0.8
        hidden = 0

        const ex = gx - x
        const ez = gz - z
        if ex * ex + ez * ez < 0.0004 {
          x = gx
          z = gz
          behaviour = goal
          timer = 0
          wait = goal == PR_RC_RUMMAGE ? 3 + rng.f(2.5) : 4 + rng.f(6)
        }
      } else if behaviour == PR_RC_RUMMAGE {
        // Rear up against the bin, tip the lid up and dig; scraps hop out now and then.
        const ho = pr_hideouts[hideout]
        face = atan2(ho.x - x, ho.z - z)
        turn = true
        hidden = 0
        rear_to = timer < wait - 0.5 ? 1 : 0
        y = pr_hideout_spot_y(hideout) + 0.2 * rearing
        placed = true

        if timer >= 0.35 && timer - step < 0.35 {
          pr_hideout_lift[hideout] = 0.7
        }

        const n0 = floor((timer - step - 0.9) / 1.1)
        const n1 = floor((timer - 0.9) / 1.1)
        if n1 > n0 && n1 >= 0 && timer < wait - 0.6 {
          if ho.y > 0.05 {
            const b = box.particle.burst_at(ParisRaccoonScraps_1, {ho.x, ho.y + 0.95, ho.z}, 1)
          } else {
            const b = box.particle.burst_at(ParisRaccoonScraps_0, {ho.x, ho.y + 0.95, ho.z}, 1)
          }
        }

        if timer >= wait {
          pr_hideout_lift[hideout] = 0
          hideout = -1
          cooldown = 10 + rng.f(10)
          behaviour = PR_RC_WANDER
          target = node
          timer = 0
          wait = trot
        }
      } else if behaviour == PR_RC_HIDE {
        // Open the cover, peek, slip in, close it behind, wait, then come out of another
        // hideout.
        const ho = pr_hideouts[hideout]
        const sx = pr_hideout_spot_x(hideout)
        const sy = pr_hideout_spot_y(hideout)
        const sz = pr_hideout_spot_z(hideout)
        const iy: f32 = ho.kind == PR_HIDE_BIN ? ho.y + 0.75 : (ho.kind == PR_HIDE_MANHOLE ? ho.y - 0.3 : sy)
        face = atan2(ho.x - sx, ho.z - sz)
        turn = true
        placed = true

        if timer >= 0.02 && timer - step < 0.02 {
          pr_hideout_lift[hideout] = 1
        }

        const k = clamp((timer - 0.45) / 0.7, 0, 1)
        const e = k * k * (3 - 2 * k)
        rear_to = timer < 0.45 ? 0.5 : 0
        x = sx + (ho.x - sx) * e
        y = sy + (iy - sy) * e
        z = sz + (ho.z - sz) * e
        hidden = e

        if timer >= 1.4 && timer - step < 1.4 {
          pr_hideout_lift[hideout] = 0
        }

        if timer >= 1.4 + wait {
          // Another free hideout at another node, starting from a random one.
          const start: i32 = rng.u(PR_HIDEOUTS)
          mut next: i32 = -1
          for c in 0..PR_HIDEOUTS {
            const cand = start + c >= PR_HIDEOUTS ? start + c - PR_HIDEOUTS : start + c
            if next < 0 && cand != hideout && pr_hideouts[cand].node != node {
              mut busy = false
              for j in 0..PR_RACCOONS {
                if j != i && rs[j].hideout == cand {
                  busy = true
                }
              }
              if !busy {
                next = cand
              }
            }
          }

          if next >= 0 {
            const nh = pr_hideouts[next]
            const nsx = pr_hideout_spot_x(next)
            const nsz = pr_hideout_spot_z(next)
            hideout = next
            node = nh.node
            target = node
            prev = node
            behaviour = PR_RC_EMERGE
            timer = 0
            x = nh.x
            z = nh.z
            y = nh.kind == PR_HIDE_BIN ? nh.y + 0.75 : (nh.kind == PR_HIDE_MANHOLE ? nh.y - 0.3 : pr_hideout_spot_y(next))
            yaw = atan2(nsx - nh.x, nsz - nh.z)
            face = yaw
            hidden = 1
          } else {
            timer = 0.4 + wait
          }
        }
      } else if behaviour == PR_RC_EMERGE {
        // The cover opens and the raccoon climbs out to the front of the hideout.
        const ho = pr_hideouts[hideout]
        const sx = pr_hideout_spot_x(hideout)
        const sy = pr_hideout_spot_y(hideout)
        const sz = pr_hideout_spot_z(hideout)
        const iy: f32 = ho.kind == PR_HIDE_BIN ? ho.y + 0.75 : (ho.kind == PR_HIDE_MANHOLE ? ho.y - 0.3 : sy)
        face = atan2(sx - ho.x, sz - ho.z)
        turn = true
        placed = true

        if timer >= 0.02 && timer - step < 0.02 {
          pr_hideout_lift[hideout] = 1
        }

        const k = clamp((timer - 0.35) / 0.65, 0, 1)
        const e = k * k * (3 - 2 * k)
        x = ho.x + (sx - ho.x) * e
        y = iy + (sy - iy) * e
        z = ho.z + (sz - ho.z) * e
        hidden = 1 - e

        if timer >= 1.0 {
          pr_hideout_lift[hideout] = 0
          hideout = -1
          hidden = 0
          cooldown = 12 + rng.f(10)
          behaviour = PR_RC_WANDER
          target = node
          timer = 0
          wait = trot
        }
      }

      // Trot on to a linked node, not back where it came from unless it is a dead end; now and
      // then scamper.
      if choose {
        const deg = pr_degree(node)
        mut k: i32 = rng.u(deg)
        mut next: i32 = pr_neighbor(node, k)
        if next == prev && deg > 1 {
          k = k + 1 + rng.u(deg - 1)
          if k >= deg {
            k = k - deg
          }
          next = pr_neighbor(node, k)
        }
        target = next
        behaviour = PR_RC_WANDER
        timer = 0
        wait = rng.f(1) < 0.12 ? 3.2 : trot
      }

      // Walk toward the goal, slowing down behind other raccoons and while turning.
      mut moved: f32 = 0
      if want > 0 {
        const dx = gx - x
        const dz = gz - z
        const d = sqrt(dx * dx + dz * dz)
        if d > 0.0001 {
          const mx = dx / d
          const mz = dz / d
          mut factor: f32 = 1
          for j in 0..PR_RACCOONS {
            if j != i && rs[j].hidden < 0.5 {
              const ox = rs[j].x - x
              const oz = rs[j].z - z
              const od = sqrt(ox * ox + oz * oz)
              if od < 1.0 && ox * mx + oz * mz > 0.25 * od {
                factor = min(factor, clamp((od - 0.45) / 0.55, 0.15, 1))
              }
            }
          }

          face = atan2(dx, dz)
          turn = true
          const err = atan2(sin(face - yaw), cos(face - yaw))
          const v = want * factor * max(0.25, cos(err))
          const sd = min(v * step, d)
          x += mx * sd
          z += mz * sd
          moved = v
        }
      }

      // Step aside from raccoons that come too close (passing on a link or meeting at a node).
      if !placed {
        mut px: f32 = 0
        mut pz: f32 = 0
        for j in 0..PR_RACCOONS {
          if j != i && rs[j].hidden < 0.5 {
            const ox = x - rs[j].x
            const oz = z - rs[j].z
            const od = sqrt(ox * ox + oz * oz)
            if od < 0.6 {
              // Raccoons on the very same spot part to either side by their index.
              const side: f32 = i < j ? 1 : -1
              px += od > 0.01 ? ox / od * (0.6 - od) : side * 0.3
              pz += od > 0.01 ? oz / od * (0.6 - od) : 0
            }
          }
        }
        x += px * min(1, step * 4)
        z += pz * min(1, step * 4)
      }

      // Follow the ground along the segment being walked.
      if !placed {
        const sdx = bx - ax
        const sdz = bz - az
        const sl = sdx * sdx + sdz * sdz
        const t = sl > 0.0001 ? clamp(((x - ax) * sdx + (z - az) * sdz) / sl, 0, 1) : 1
        const ydes = ay + (by - ay) * t
        y += (ydes - y) * min(1, step * 12)
      }

      // Turn smoothly, faster at speed.
      if turn {
        const err = atan2(sin(face - yaw), cos(face - yaw))
        const rate = (6 + 2 * speed) * step
        yaw = atan2(sin(yaw + clamp(err, 0 - rate, rate)), cos(yaw + clamp(err, 0 - rate, rate)))
      }

      // The pose: speed follows the walk, the gait runs with the speed (and fast while digging,
      // slowly while standing), rearing eases to what the behaviour asks.
      speed += (moved - speed) * min(1, step * 8)
      gait += step * (speed * 8.5 + (behaviour == PR_RC_RUMMAGE ? 11 : 0) + (behaviour == PR_RC_PAUSE ? 1.6 : 0.8))
      if gait > 20 * PI {
        gait -= 20 * PI
      }
      rearing += (rear_to - rearing) * min(1, step * 6)

      rs[i].x = x
      rs[i].y = y
      rs[i].z = z
      rs[i].yaw = yaw
      rs[i].node = node
      rs[i].target = target
      rs[i].prev = prev
      rs[i].behaviour = behaviour
      rs[i].goal = goal
      rs[i].timer = timer
      rs[i].wait = wait
      rs[i].cooldown = cooldown
      rs[i].hideout = hideout
      rs[i].gait = gait
      rs[i].speed = speed
      rs[i].rearing = rearing
      rs[i].hidden = hidden
    }

    pr_raccoons = rs
  }
}

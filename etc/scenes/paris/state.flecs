using flecs.script
using flecs.script.math

state {
  export mut clock: f32 = 0
  export mut dt: f32 = 0.016

  // The street graph the characters walk on. Nodes are points on open pavement (x, z) with the
  // height of the ground there (0.15 on pavements, 0 on roads and the bridge roadway, -2.2 on the
  // lower quays). Every link is a straight walk along open pavement, roads or the bridge.
  struct ParisNode(x: f32, y: f32, z: f32)
  struct ParisLink(a: i32, b: i32)

  export const PR_NODES: i32 = 71
  export const PR_LINKS: i32 = 93
  export const PR_MAX_DEGREE: i32 = 6

  export const pr_nodes: ParisNode[71] = [

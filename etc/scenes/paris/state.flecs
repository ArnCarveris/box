    {-34.6, -2.2, -23.4},
    {-56, -2.2, -25},
    {-36, -2.2, -25},
    {-20, -2.2, -25},
    {-8, -2.2, -25},
    // 64..69 east lower quay: stair top, stair foot, quayside
    {25.2, 0, -23.4},

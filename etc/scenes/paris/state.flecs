  // While true, paris/liberty.flecs gives the standing statues a slow idle look-around (head_turn
  // and torch_sweep). The logic that walks them sets it to false and drives the pose itself.
  export mut pr_statue_idle = true

  // Index of the node nearest to the point x, z.
  fn pr_nearest_node(x: f32, z: f32) -> i32 {
    mut best: i32 = 0
    mut best_d: f32 = 1000000

    for i in 0..PR_NODES {
      const dx = pr_nodes[i].x - x
      const dz = pr_nodes[i].z - z
      const d = dx * dx + dz * dz

      if d < best_d {
        best_d = d
        best = i
      }
    }

    best
  }

  // Number of links at node n.
  fn pr_degree(n: i32) -> i32 {
    mut count: i32 = 0

    for l in 0..PR_LINKS {
      if pr_links[l].a == n || pr_links[l].b == n {
        count += 1
      }
    }

    count
  }

  // Whether node n is a dead end without a hideout, where a fleeing raccoon would be cornered.
  fn pr_dead_end(n: i32) -> bool {
    pr_degree(n) <= 1 && pr_hideout_at(n) < 0
  }

  // The node at the other end of the k-th link of node n (0 <= k < pr_degree(n)), or n.
  fn pr_neighbor(n: i32, k: i32) -> i32 {
    mut seen: i32 = 0
    mut result: i32 = n

    for l in 0..PR_LINKS {
      if pr_links[l].a == n || pr_links[l].b == n {
        if seen == k {
          result = pr_links[l].a == n ? pr_links[l].b : pr_links[l].a
        }

        seen += 1
      }
    }

    result
  }

  // A hash of n in 0..1, for variation that does not depend on the order of evaluation.
  fn pr_hash(n: f32) -> f32 {
    const s = sin(n * 12.9898 + 4.1414) * 43758.5453
    s - floor(s)
  }
}

  // Statistics of the charm acts, to check them in a headless run: winks, poses, kisses (and
  // heart bursts), head tosses and torch waves, torch twirls.
  export mut pr_charm_winks: i32 = 0
  export mut pr_charm_poses: i32 = 0
  export mut pr_charm_kisses: i32 = 0
  export mut pr_charm_greets: i32 = 0
  export mut pr_charm_twirls: i32 = 0

  // The hunt (paris/hunt.flecs): what each statue is doing. The behaviour (PR_ST_*), the time in
  // it and the time of its next step (wait), the node she came from, the raccoon she is after
  // (-1 = none), the node she heads for while chasing or searching, the spot off the street graph
  // she inspects or searches (sx, sy, sz) and the leg of that walk (0 on the graph, 1 out to the
  // spot, 2 there, 3 back to the node), her speed, the time before she may spot a raccoon again,
  // the kind of pause (0 look both ways, 1 sweep the torch low, 2 look into a hideout) or search
  // (0 on the way, 1 at the spot) and whether the raccoon vanished there.
  struct ParisHunter(behaviour: i32, timer: f32, wait: f32, prev: i32, quarry: i32, gnode: i32, sx: f32, sy: f32, sz: f32, leg: i32, speed: f32, cooldown: f32, kind: i32, vanished: bool)

  export const PR_ST_PATROL: i32 = 0 // walk from node to linked node
  export const PR_ST_PAUSE: i32 = 1  // stop to look both ways, sweep the torch or look into a hideout
  export const PR_ST_SPOT: i32 = 2   // point the torch at a raccoon
  export const PR_ST_CHASE: i32 = 3  // walk briskly after it along the street graph
  export const PR_ST_LOST: i32 = 4   // search where it was last seen, then patrol again


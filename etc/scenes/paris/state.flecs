    {7.8, 0.15, 5}, {7.8, 0.15, 20}, {7.8, 0.15, 27}, {7.8, 0.15, 42}, {7.8, 0.15, 58},
    // 38..41 cross street, 42 the square
    {-56, 0, 23.5}, {-21, 0, 23.5}, {21, 0, 23.5}, {56, 0, 23.5}, {15, 0.15, 33},
    // 43..48 bridge pavements (west then east)

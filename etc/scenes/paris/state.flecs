  // Hunt statistics: chases started, chases that ended with the raccoon hidden or escaped, and
  // the smallest distance seen between a statue and a raccoon in the open.
  export mut pr_hunt_chases: i32 = 0
  export mut pr_hunt_hidden: i32 = 0

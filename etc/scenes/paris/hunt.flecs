include materials
include state
include clock
using flecs.script
using flecs.script.math
using box.transform
using box.camera
using box.controllers
using box.light
using box.particle
using box.material
using box.curve
using state
using assets

assets {
  // A shower of sparks from a torch, played with box.particle.burst_at where a raccoon just
  // vanished under a statue's nose.
  prefab ParisTorchSparks {
    sparks {
      Position: {0, 0, 0}
      Emitter: {
        max: 60, rate: 0, shape: EmitterSphere, radius: 0.06, direction: {0, 1, 0}, spread: 75,
        speed: {1.4, 3.0}, lifetime: {0.35, 0.7}, size: {0.02, 0.045},
        color: {255, 200, 110}, seed: 41
      }
      Burst: {count: 45}
      Forces: {gravity: {0, -9.81, 0}, drag: 0.8}
      Appearance: {blend: Additive}
      Curves: {
        color: {keys: [{0, {255, 245, 200}}, {0.4, {255, 160, 50}}, {1, {200, 50, 10}}]}
        opacity: {keys: [{0, 1}, {0.7, 0.9}, {1, 0}]}
      }
    }

    glow {
      Position: {0, 0.1, 0}
      Rgb: {255, 170, 80}
      PointLight: {intensity: PI, range: 4, shadows: false}
      EffectFlash: {intensity: 6 * PI, seconds: 0.35}
    }
  }
}

state {
  // The length of the walk along the street graph from node n to node goal (Bellman-Ford over
  // the links, at most a few dozen passes).
  fn pr_graph_dist(n: i32, goal: i32) -> f32 {
    mut gd: f32[71] = {}
    for k in 0..PR_NODES {
      gd[k] = 100000
    }
    gd[goal] = 0

    mut changed = true
    for pass in 0..PR_NODES {
      if changed {
        changed = false
        for l in 0..PR_LINKS {
          const la = pr_links[l].a
          const lb = pr_links[l].b
          const dx = pr_nodes[la].x - pr_nodes[lb].x
          const dz = pr_nodes[la].z - pr_nodes[lb].z
          const len = sqrt(dx * dx + dz * dz)
          if gd[la] + len < gd[lb] {
            gd[lb] = gd[la] + len
            changed = true
          }
          if gd[lb] + len < gd[la] {
            gd[la] = gd[lb] + len
            changed = true
          }
        }
      }
    }

    gd[n]
  }

  // The node linked to n on the shortest walk to goal, where walking to avoid_a or avoid_b costs
  // a detour (so that statues chasing the same raccoon take different streets).
  fn pr_route(n: i32, goal: i32, avoid_a: i32, avoid_b: i32) -> i32 {
    mut gd: f32[71] = {}
    for k in 0..PR_NODES {
      gd[k] = 100000
    }
    gd[goal] = 0

    mut changed = true
    for pass in 0..PR_NODES {
      if changed {
        changed = false
        for l in 0..PR_LINKS {
          const la = pr_links[l].a
          const lb = pr_links[l].b
          const dx = pr_nodes[la].x - pr_nodes[lb].x
          const dz = pr_nodes[la].z - pr_nodes[lb].z
          const len = sqrt(dx * dx + dz * dz)
          if gd[la] + len < gd[lb] {
            gd[lb] = gd[la] + len
            changed = true
          }
          if gd[lb] + len < gd[la] {
            gd[la] = gd[lb] + len
            changed = true
          }
        }
      }
    }

    mut best: i32 = n
    mut best_c: f32 = 1000000
    for l in 0..PR_LINKS {
      if pr_links[l].a == n || pr_links[l].b == n {
        const m = pr_links[l].a == n ? pr_links[l].b : pr_links[l].a
        const dx = pr_nodes[m].x - pr_nodes[n].x
        const dz = pr_nodes[m].z - pr_nodes[n].z
        const c = sqrt(dx * dx + dz * dz) + gd[m] + (m == avoid_a || m == avoid_b ? 9.0 : 0.0)
        if c < best_c {
          best_c = c
          best = m
        }
      }
    }

    best
  }

  // Whether a link joins nodes a and b.
  fn pr_linked(a: i32, b: i32) -> bool {
    mut found = false
    for l in 0..PR_LINKS {
      if (pr_links[l].a == a && pr_links[l].b == b) || (pr_links[l].a == b && pr_links[l].b == a) {
        found = true
      }
    }

    found
  }

  // Whether raccoon r is out in the open, where a statue can see it.
  fn pr_raccoon_visible(r: ParisRaccoonState) -> bool {
    r.hidden < 0.5 && r.behaviour != PR_RC_HIDE && r.behaviour != PR_RC_EMERGE
  }
}

paris {
  // Above the boulevard by the river, looking down it toward the quay: statues patrol and chase
  // raccoons across the pavements and the road.
  hunt_camera {
    Position: {0, 5.5, 14}
    Rotation: {-0.22, 0, 0}
    Camera: {fov: 60, near_: 0.05, far_: 400}
    CameraController: {speed: 5}
  }
}

// The statues hunt the raccoons. They patrol the street graph at a stately pace (stopping now
// and then to look both ways, sweep the torch low or look into a bin, manhole or drain), spot a
// raccoon in front of them, point the torch at it, chase it briskly along the street graph with
// the torch held forward and search where it vanished or got away. Each frame works on copies of
// state.pr_statues and state.pr_hunters and writes them back once.
async {
  const rng: math.Rng = {seed: 9127}
  // Sideways offset from the line between two nodes, to the right of the way a statue walks.
  const lane: f32 = 0.45
  // A statue sees a raccoon within sight in front of her, keeps keep_statue from the other
  // statues and keep_raccoon from the raccoons, gives up a chase when the raccoon is lose_dist
  // ahead, and at most max_hunters statues hunt at a time (at most 3 after one raccoon).
  const sight: f32 = 12
  const keep_statue: f32 = 1.3
  const keep_raccoon: f32 = 1.9
  const lose_dist: f32 = 22
  const max_hunters: i32 = 8
  // On patrol she often walks on toward a raccoon in the open within prowl.
  const prowl: f32 = 30

  mut ss: ParisStatue[14] = pr_statues
  mut hs: ParisHunter[14] = pr_hunters
  pr_statue_idle = false

  while true {
    await next_frame()
    const step = dt
    ss = pr_statues
    hs = pr_hunters
    const rc = pr_raccoons
    mut closest: f32 = pr_hunt_closest

    // Who is after which raccoon.
    mut after: i32[10] = {}
    mut hunting: i32 = 0
    for k in 0..PR_STATUES {
      if hs[k].behaviour == PR_ST_SPOT || hs[k].behaviour == PR_ST_CHASE {
        if hs[k].quarry >= 0 {
          after[hs[k].quarry] += 1
        }
      }
      if hs[k].behaviour >= PR_ST_SPOT {
        hunting += 1
      }
    }

    for i in 0..PR_STATUES {
      const s = ss[i]
      const h = hs[i]
      mut x: f32 = s.x
      mut y: f32 = s.y
      mut z: f32 = s.z
      mut yaw: f32 = s.yaw
      mut node: i32 = s.node
      mut target: i32 = s.target
      mut walk: f32 = s.walk
      mut stride: f32 = s.stride
      mut raise: f32 = s.torch_raise
      mut sweep: f32 = s.torch_sweep
      mut head: f32 = s.head_turn
      mut lean: f32 = s.lean
      mut behaviour: i32 = h.behaviour
      mut timer: f32 = h.timer + step
      mut wait: f32 = h.wait
      mut prev: i32 = h.prev
      mut quarry: i32 = h.quarry
      mut gnode: i32 = h.gnode
      mut sx: f32 = h.sx
      mut sy: f32 = h.sy
      mut sz: f32 = h.sz
      mut leg: i32 = h.leg
      mut speed: f32 = h.speed
      mut cooldown: f32 = max(0, h.cooldown - step)
      mut kind: i32 = h.kind
      mut vanished: bool = h.vanished

      const pace: f32 = 0.75 + pr_hash(i * 2.3 + 0.4) * 0.15
      const brisk: f32 = 2.2 + pr_hash(i * 4.1 + 1.3) * 0.35

      // The pose the behaviour asks for.
      mut raise_to: f32 = 1
      mut sweep_to: f32 = 0
      mut head_to: f32 = 0
      mut lean_to: f32 = 0

      // What the behaviour asks for this frame: walk to (gx, gz) at `want` along the segment
      // from (ax, az) to (bx, bz) whose ends have the ground heights ay and by, or stand and turn
      // to `face`.
      mut gx: f32 = x
      mut gz: f32 = z
      mut want: f32 = 0
      mut ax: f32 = pr_nodes[node].x
      mut ay: f32 = pr_nodes[node].y
      mut az: f32 = pr_nodes[node].z
      mut bx: f32 = pr_nodes[target].x
      mut by: f32 = pr_nodes[target].y
      mut bz: f32 = pr_nodes[target].z
      mut face: f32 = yaw
      mut turn = false
      mut arrived = false

      if leg != 0 {
        // Off the street graph, on the segment from the node to the spot.
        bx = sx
        by = sy
        bz = sz
      }

      if leg == 1 || leg == 3 {
        // Out from the node to the spot (leg 1) or back (leg 3).
        gx = leg == 1 ? sx : ax
        gz = leg == 1 ? sz : az
        want = behaviour == PR_ST_PATROL || behaviour == PR_ST_PAUSE ? pace : brisk * 0.75
        const ex = gx - x
        const ez = gz - z
        arrived = ex * ex + ez * ez < 0.0025
      } else if leg == 0 {
        // On the link from node to target, in the right lane.
        const ldx = bx - ax
        const ldz = bz - az
        const ll = sqrt(ldx * ldx + ldz * ldz)
        gx = ll > 0.01 ? bx + ldz / ll * lane : bx
        gz = ll > 0.01 ? bz - ldx / ll * lane : bz
        want = behaviour == PR_ST_CHASE ? brisk : (behaviour == PR_ST_LOST ? brisk * 0.75 : pace)
        const ex = gx - x
        const ez = gz - z
        arrived = ex * ex + ez * ez < 0.04
      }

      // Held up close to the goal (by a statue heading for the same node): close enough.
      if !arrived && want > 0 && h.speed < 0.35 * want && timer > 2 && (gx - x) * (gx - x) + (gz - z) * (gz - z) < 1 {
        arrived = true
      }

      if behaviour == PR_ST_PATROL {
        // Torch raised, a slow look around while walking.
        sweep_to = 0.12 * sin(clock * 0.3 + i * 1.9)
        head_to = 0.25 * sin(clock * 0.23 + i * 1.3)

        if leg == 3 && arrived {
          leg = 0
          target = node
        }

        if leg == 0 && arrived {
          // Arrived at the next node (or back on the node after a pause, then walk on).
          const walked = target != node
          if walked {
            prev = node
            node = target
          }

          // At a junction: look into the hideout here, look both ways, sweep the torch into the
          // dark corners or walk on.
          const ho = pr_hideout_at(node)
          const deg = pr_degree(node)
          const roll: f32 = walked ? rng.f(1) : 1.0
          timer = 0

          if ho >= 0 && roll < 0.4 {
            const hp = pr_hideouts[ho]
            const n = pr_nodes[node]
            const dx = hp.x - n.x
            const dz = hp.z - n.z
            const dl = max(sqrt(dx * dx + dz * dz), 0.01)
            const reach = max(0, dl - 1.1)
            behaviour = PR_ST_PAUSE
            kind = 2
            sx = n.x + dx / dl * reach
            sy = n.y + (hp.y - n.y) * reach / dl
            sz = n.z + dz / dl * reach
            leg = reach > 0.1 ? 1 : 2
            wait = 2.5 + rng.f(1.5)
          } else if deg >= 3 && roll < 0.6 {
            behaviour = PR_ST_PAUSE
            kind = 0
            wait = 2.6 + rng.f(1.4)
          } else if roll < 0.72 {
            behaviour = PR_ST_PAUSE
            kind = 1
            wait = 2.5 + rng.f(2)
          } else {
            // Walk on to a linked node, not back where she came from unless it is a dead end:
            // often toward the nearest raccoon in the open within prowl, else at random.
            mut k: i32 = rng.u(deg)
            mut next: i32 = pr_neighbor(node, k)
            if next == prev && deg > 1 {
              k = k + 1 + rng.u(deg - 1)
              if k >= deg {
                k = k - deg
              }
              next = pr_neighbor(node, k)
            }

            mut prey: i32 = -1
            mut prey_d: f32 = prowl
            for j in 0..PR_RACCOONS {
              if pr_raccoon_visible(rc[j]) {
                const d = sqrt((rc[j].x - x) * (rc[j].x - x) + (rc[j].z - z) * (rc[j].z - z))
                if d < prey_d {
                  prey = j
                  prey_d = d
                }
              }
            }
            if prey >= 0 && rng.f(1) < 0.65 {
              mut best_d: f32 = 1000000
              for kk in 0..deg {
                const m = pr_neighbor(node, kk)
                const ox = rc[prey].x - pr_nodes[m].x
                const oz = rc[prey].z - pr_nodes[m].z
                const d = ox * ox + oz * oz
                if (m != prev || deg == 1) && d < best_d {
                  best_d = d
                  next = m
                }
              }
            }
            target = next
          }
        } else if leg == 0 && timer > 45 {
          // Held up for too long (by other statues): turn back.
          const back = node
          node = target
          target = back
          timer = 0
        }
      } else if behaviour == PR_ST_PAUSE {
        if kind == 2 {
          // Walk up to the bin, manhole or drain, bend over it with the torch low, walk back.
          const ho = pr_hideout_at(node)
          if leg == 1 {
            raise_to = 0.6
            if arrived {
              leg = 2
              timer = 0
            }
          } else if leg == 2 {
            want = 0
            raise_to = 0.3
            lean_to = 0.3
            sweep_to = 0.25 * sin(timer * 1.7)
            if ho >= 0 {
              face = atan2(pr_hideouts[ho].x - x, pr_hideouts[ho].z - z)
              turn = true
            }
            if timer >= wait {
              leg = 3
              timer = 0
            }
          } else if leg == 3 {
            if arrived {
              leg = 0
              behaviour = PR_ST_PATROL
              target = node
            }
          }
        } else {
          want = 0
          if kind == 0 {
            // Look both ways.
            const k = timer / wait
            head_to = k < 0.4 ? 0.7 : (k < 0.85 ? 0 - 0.7 : 0)
            sweep_to = head_to * 0.3
          } else {
            // Sweep the torch low into the dark corners.
            raise_to = 0.3
            lean_to = 0.12
            sweep_to = 0.6 * sin(timer * 1.6)
            head_to = sweep_to * 0.6
          }

          if timer >= wait {
            behaviour = PR_ST_PATROL
            target = node
            timer = 0
          }
        }
      } else if behaviour == PR_ST_SPOT {
        // Stop and point the torch at the raccoon, then give chase.
        const q = rc[quarry]
        want = 0
        face = atan2(q.x - x, q.z - z)
        turn = true
        raise_to = 0
        lean_to = 0.06
        const rel = atan2(sin(face - yaw), cos(face - yaw))
        sweep_to = clamp(rel, 0 - 0.6, 0.6)

        const qv = pr_raccoon_visible(q)
        if !qv {
          behaviour = PR_ST_LOST
          kind = 0
          timer = 0
          vanished = true
          sx = q.hideout >= 0 ? pr_hideouts[q.hideout].x : q.x
          sy = q.hideout >= 0 ? pr_hideouts[q.hideout].y : q.y
          sz = q.hideout >= 0 ? pr_hideouts[q.hideout].z : q.z
          gnode = q.hideout >= 0 ? pr_hideouts[q.hideout].node : pr_nearest_node(sx, sz)
          if leg == 1 || leg == 2 {
            leg = 3
          }
        } else if timer >= wait {
          behaviour = PR_ST_CHASE
          timer = 0
          wait = 0
          pr_hunt_chases += 1
          if leg == 1 || leg == 2 {
            leg = 3
          }
        }
      } else if behaviour == PR_ST_CHASE {
        // Walk briskly along the street graph toward the raccoon, the torch held forward and
        // swinging after it.
        const q = rc[quarry]
        const qx = q.x - x
        const qz = q.z - z
        const qd = sqrt(qx * qx + qz * qz)
        raise_to = 0
        lean_to = 0.12
        const rel = atan2(sin(atan2(qx, qz) - yaw), cos(atan2(qx, qz) - yaw))
        sweep_to = clamp(rel, 0 - 0.6, 0.6)
        head_to = clamp(rel, 0 - 0.5, 0.5)

        const qv = pr_raccoon_visible(q)
        if !qv {
          // It vanished: search where it went in.
          behaviour = PR_ST_LOST
          kind = 0
          timer = 0
          vanished = true
          sx = q.hideout >= 0 ? pr_hideouts[q.hideout].x : q.x
          sy = q.hideout >= 0 ? pr_hideouts[q.hideout].y : q.y
          sz = q.hideout >= 0 ? pr_hideouts[q.hideout].z : q.z
          gnode = q.hideout >= 0 ? pr_hideouts[q.hideout].node : pr_nearest_node(sx, sz)
          pr_hunt_hidden += 1
        } else if qd > lose_dist || timer > 30 {
          // It got away: search where it was last seen.
          behaviour = PR_ST_LOST
          kind = 0
          timer = 0
          vanished = false
          sx = q.x
          sy = q.y
          sz = q.z
          gnode = pr_nearest_node(sx, sz)
          pr_hunt_escaped += 1
        } else if leg == 3 {
          if arrived {
            leg = 0
            target = node
            wait = timer
          }
        } else if leg == 0 {
          if arrived && target != node {
            prev = node
            node = target
            target = node
            wait = timer
          }

          if timer >= wait {
            // Head for the node the raccoon runs to, coming at it from a different street than
            // the other statues after it.
            wait = timer + 1.2
            gnode = q.behaviour == PR_RC_FLEE || q.behaviour == PR_RC_WANDER ? q.target : q.node
            mut av_a: i32 = -1
            mut av_b: i32 = -1
            for k in 0..PR_STATUES {
              if k != i && hs[k].quarry == quarry && hs[k].behaviour == PR_ST_CHASE {
                if av_a < 0 {
                  av_a = ss[k].target
                } else {
                  av_b = ss[k].target
                }
              }
            }

            if target == node {
              if node == gnode {
                const other = q.node != node ? q.node : q.target
                target = pr_linked(node, other) ? other : node
              } else {
                target = pr_route(node, gnode, av_a, av_b)
              }
            } else {
              // Turn back when the walk the other way is shorter.
              const fx = pr_nodes[target].x - x
              const fz = pr_nodes[target].z - z
              const bkx = pr_nodes[node].x - x
              const bkz = pr_nodes[node].z - z
              const fwd = sqrt(fx * fx + fz * fz) + pr_graph_dist(target, gnode)
              const back = sqrt(bkx * bkx + bkz * bkz) + pr_graph_dist(node, gnode)
              if back + 1 < fwd {
                const o = node
                node = target
                target = o
              }
            }
          }
        }
      } else if behaviour == PR_ST_LOST {
        // Walk to where the raccoon was last seen, search around with the torch sweeping, then
        // patrol again.
        raise_to = 0.4
        lean_to = 0.1
        sweep_to = 0.7 * sin(timer * 2.2 + i)
        head_to = 0.5 * sin(timer * 1.3 + i * 0.7)

        if kind == 0 {
          if leg == 3 {
            if arrived {
              leg = 0
              target = node
            }
          } else if leg == 0 && (arrived || target == node) {
            if target != node {
              prev = node
              node = target
            }

            if node == gnode {
              // Off the graph to a step short of the spot.
              const n = pr_nodes[node]
              const dx = sx - n.x
              const dz = sz - n.z
              const dl = max(sqrt(dx * dx + dz * dz), 0.01)
              const reach = max(0, dl - 1.0)
              sx = n.x + dx / dl * reach
              sy = n.y + (sy - n.y) * reach / dl
              sz = n.z + dz / dl * reach
              kind = 1
              leg = reach > 0.1 ? 1 : 2
              target = node
              if leg == 2 {
                timer = 0
                wait = 3 + rng.f(2)
              }
            } else {
              target = pr_route(node, gnode, -1, -1)
            }
          }

          if timer > 25 {
            // Too far: give up.
            behaviour = PR_ST_PATROL
            quarry = -1
            cooldown = 4
            if leg == 1 || leg == 2 {
              leg = 3
            }
          }
        } else {
          if leg == 1 && arrived {
            leg = 2
            timer = 0
            wait = 3 + rng.f(2)
          }

          if leg == 2 {
            want = 0
            if timer - step <= 0 && vanished {
              // Sparks fly from the torch where the raccoon just vanished.
              const tlx: f32 = 0 - 0.2
              const tlz: f32 = 0.45
              const wx = x + cos(yaw) * tlx + sin(yaw) * tlz
              const wz = z - sin(yaw) * tlx + cos(yaw) * tlz
              const fx = box.particle.burst_at(ParisTorchSparks, {wx, y + 1.6, wz}, 1)
              vanished = false
            }
            if timer >= wait {
              leg = 3
              timer = 0
            }
          } else if leg == 3 && arrived {
            leg = 0
            behaviour = PR_ST_PATROL
            quarry = -1
            target = node
            timer = 0
            cooldown = 4 + rng.f(4)
          }
        }
      }

      // Spot a raccoon in the open, within sight and in front, that fewer than three statues
      // are after.
      if (behaviour == PR_ST_PATROL || behaviour == PR_ST_PAUSE) && cooldown <= 0 && hunting < max_hunters {
        const look = yaw + head
        mut seen: i32 = -1
        mut seen_d: f32 = sight
        for j in 0..PR_RACCOONS {
          const r = rc[j]
          if pr_raccoon_visible(r) && after[j] < 3 {
            const dx = r.x - x
            const dz = r.z - z
            const d = sqrt(dx * dx + dz * dz)
            const ahead = sin(look) * dx + cos(look) * dz
            if d < seen_d && abs(r.y - y) < 1.5 && ahead > 0.2 * d {
              seen = j
              seen_d = d
            }
          }
        }

        if seen >= 0 {
          behaviour = PR_ST_SPOT
          quarry = seen
          timer = 0
          wait = 0.8 + rng.f(0.5)
          after[seen] += 1
          hunting += 1
          if leg == 1 {
            leg = 2
          }
        }
      }

      // Walk toward the goal, slowing down behind other statues and short of the raccoons.
      mut moved: f32 = 0
      if want > 0 {
        const dx = gx - x
        const dz = gz - z
        const d = sqrt(dx * dx + dz * dz)
        if d > 0.0001 {
          const mx = dx / d
          const mz = dz / d
          mut factor: f32 = 1
          for j in 0..PR_STATUES {
            if j != i {
              const ox = ss[j].x - x
              const oz = ss[j].z - z
              const od = sqrt(ox * ox + oz * oz)
              if od < 2.2 && ox * mx + oz * mz > 0.3 * od {
                factor = min(factor, clamp((od - 0.9) / 1.2, 0, 1))
              }
            }
          }
          for j in 0..PR_RACCOONS {
            if pr_raccoon_visible(rc[j]) {
              const ox = rc[j].x - x
              const oz = rc[j].z - z
              const od = sqrt(ox * ox + oz * oz)
              if od < keep_raccoon + 0.6 && ox * mx + oz * mz > 0.2 * od {
                factor = min(factor, clamp((od - keep_raccoon) / 0.6, 0, 1))
              }
            }
          }

          face = atan2(dx, dz)
          turn = true
          const err = atan2(sin(face - yaw), cos(face - yaw))
          const v = want * factor * max(0.2, cos(err))
          const sd = min(v * step, d)
          x += mx * sd
          z += mz * sd
          moved = sd / max(step, 0.0001)
        }
      }

      // Step aside from statues and raccoons that come too close.
      mut px: f32 = 0
      mut pz: f32 = 0
      for j in 0..PR_STATUES {
        if j != i {
          const ox = x - ss[j].x
          const oz = z - ss[j].z
          const od = sqrt(ox * ox + oz * oz)
          if od < keep_statue {
            const side: f32 = i < j ? 1 : 0 - 1
            px += od > 0.01 ? ox / od * (keep_statue - od) : side * 0.4
            pz += od > 0.01 ? oz / od * (keep_statue - od) : 0
          }
        }
      }
      x += px * min(1, step * 4)
      z += pz * min(1, step * 4)

      // Quickly, from a raccoon that dodges past.
      px = 0
      pz = 0
      for j in 0..PR_RACCOONS {
        if pr_raccoon_visible(rc[j]) {
          const ox = x - rc[j].x
          const oz = z - rc[j].z
          const od = sqrt(ox * ox + oz * oz)
          if od < keep_raccoon && od > 0.01 {
            px += ox / od * (keep_raccoon - od)
            pz += oz / od * (keep_raccoon - od)
          }
        }
      }
      x += px * min(1, step * 10)
      z += pz * min(1, step * 10)

      // Keep to the pavement along the segment: at most a step off its line (half a step off
      // the graph), and follow the ground.
      const sdx = bx - ax
      const sdz = bz - az
      const sl = sdx * sdx + sdz * sdz
      const t = sl > 0.0001 ? clamp(((x - ax) * sdx + (z - az) * sdz) / sl, 0, 1) : 1
      const cx = ax + sdx * t
      const cz = az + sdz * t
      const ox = x - cx
      const oz = z - cz
      const off = sqrt(ox * ox + oz * oz)
      const most: f32 = leg == 0 ? 0.9 : 0.5
      if off > most {
        x = cx + ox / off * most
        z = cz + oz / off * most
      }
      const ydes = ay + (by - ay) * t
      y += (ydes - y) * min(1, step * 10)

      for j in 0..PR_RACCOONS {
        if pr_raccoon_visible(rc[j]) {
          const ox = x - rc[j].x
          const oz = z - rc[j].z
          closest = min(closest, sqrt(ox * ox + oz * oz))
        }
      }

      // Turn smoothly, faster when hurrying.
      if turn {
        const err = atan2(sin(face - yaw), cos(face - yaw))
        const rate = (2.2 + 1.2 * speed) * step
        yaw = atan2(sin(yaw + clamp(err, 0 - rate, rate)), cos(yaw + clamp(err, 0 - rate, rate)))
      }

      // The walk follows the actual speed: each half cycle of the walk the feet (pr_step_len
      // forward and back at full stride, short at low charm and long at high charm) cover
      // 2 * pr_step_len * stride, so they do not slide.
      speed += (moved - speed) * min(1, step * 6)
      stride = clamp(speed / 0.8, 0, 1)
      walk += step * speed * PI / (2 * pr_step_len(s.charm) * max(stride, 0.25))
      if walk > 20 * PI {
        walk -= 20 * PI
      }
      raise += (raise_to - raise) * min(1, step * 3)
      sweep += (sweep_to - sweep) * min(1, step * 4)
      head += (head_to - head) * min(1, step * 4)
      lean += (lean_to - lean) * min(1, step * 3)

      ss[i].x = x
      ss[i].y = y
      ss[i].z = z
      ss[i].yaw = yaw
      ss[i].node = node
      ss[i].target = target
      ss[i].walk = walk
      ss[i].stride = stride
      ss[i].torch_raise = raise
      ss[i].torch_sweep = sweep
      ss[i].head_turn = head
      ss[i].lean = lean

      hs[i].behaviour = behaviour
      hs[i].timer = timer
      hs[i].wait = wait
      hs[i].prev = prev
      hs[i].quarry = quarry
      hs[i].gnode = gnode
      hs[i].sx = sx
      hs[i].sy = sy
      hs[i].sz = sz
      hs[i].leg = leg
      hs[i].speed = speed
      hs[i].cooldown = cooldown
      hs[i].kind = kind
      hs[i].vanished = vanished
    }

    pr_statues = ss
    pr_hunters = hs
    pr_hunt_closest = closest
  }
}

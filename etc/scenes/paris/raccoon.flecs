include materials
include state
include clock
using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.particle
using state
using assets

assets {
  // A few scraps (peel, paper, crusts) that hop out of a bin with a puff of dust, played with
  // box.particle.burst_at at the rim of the bin while a raccoon digs. The scraps land on the
  // ground under the bin: ParisRaccoonScraps_0 for a bin on the road (0), _1 on a pavement (0.15).
  for g in 0..2 {
    prefab "ParisRaccoonScraps_{g}" {
      scraps {
        Position: {0, 0, 0}
        Emitter: {
          max: 16, rate: 0, shape: EmitterSphere, radius: 0.1, direction: {0, 1, 0}, spread: 40,
          speed: {1.4, 2.4}, lifetime: {0.9, 1.3}, size: {0.04, 0.08},
          color: {206, 184, 140}, color_variance: {50, 70, 60}, seed: 31
        }
        Burst: {count: 6}
        Forces: {gravity: {0, -9.81, 0}}
        box.particle.Collision: {height: g * 0.15, bounce: 0.3, friction: 0.6}
        Appearance: {lit: 1}
      }

      dust {
        Position: {0, 0, 0}
        Emitter: {
          max: 24, rate: 0, shape: EmitterSphere, radius: 0.15, direction: {0, 1, 0}, spread: 70,
          speed: {0.25, 0.6}, lifetime: {0.6, 1.0}, size: {0.08, 0.16}, opacity: {0.25, 0.4},
          color: {150, 140, 122}, seed: 32
        }
        Burst: {count: 12}
        Forces: {gravity: {0, 0.2, 0}, drag: 2}
        Appearance: {lit: 1}
        Curves: {
          size: {keys: [{0, 0.6}, {1, 1.4}]}
          opacity: {keys: [{0, 0}, {0.15, 1}, {1, 0}]}
        }
      }
    }
  }

  // A raccoon, about 0.7 units from the rump to the nose (plus the tail), facing +Z with the
  // origin on the ground: a stocky grey body, a pointed pale snout with a black nose, the black
  // eye mask with white brows and cheeks, rounded white-rimmed ears, short dark legs with little
  // hands and a bushy tail with black rings.
  //
  // id >= 0 reads the position and the pose from state.pr_raccoons[id] every frame; id < 0 (a
  // loose raccoon) stands at `at` and keeps the mut variables as they are set.
  //
  // gait is the phase of the legs (radians), speed 0 (idle), about 1.5 (trot) to about 5
  // (sprint), rearing 0..1 stands up on the hind legs, tail_puff 0..1 bristles the tail and
  // flattens the ears, hidden 0..1 shrinks the raccoon away and lowers it into a hideout.
  template ParisRaccoon {
    prop id: i32 = -1
    prop seed: f32 = 0
    prop at: Position = {0, 0, 0}

    mut px: f32 = 0
    mut py: f32 = 0
    mut pz: f32 = 0
    mut yaw: f32 = 0
    mut gait: f32 = 0
    mut speed: f32 = 0
    mut rearing: f32 = 0
    mut tail_puff: f32 = 0
    mut hidden: f32 = 0

    const size = 0.94 + pr_hash(seed + 0.71) * 0.14
    const hid = clamp(hidden, 0, 1)
    const sc = max(0.002, (1 - hid) * size)
    const run = clamp(speed / 1.5, 0, 1)
    const dash = clamp((speed - 1.5) / 3.5, 0, 1)
    const rear = clamp(rearing, 0, 1)
    const puff = clamp(tail_puff, 0, 1)
    const sg = sin(gait)
    const amp = 0.38 * run + 0.5 * dash
    const bob = abs(sg) * (0.02 * run + 0.035 * dash)
    // Digging with the hands while reared up and standing still.
    const dig = rear * (1 - run) * sin(gait) * 0.45
    const wag = sin(gait * 0.5) * (0.25 + 0.35 * run + 0.5 * dash + 0.3 * puff)

    Position: {at.x + px, at.y + py - hid * 0.2, at.z + pz}
    Rotation: {0, yaw, 0}
    Scale: {sc, sc, sc}
    DynamicTransform

    // Hind legs, standing on the ground under the rump; diagonal pairs swing together at a trot.
    for s in 0..2 {
      const sx = s * 2 - 1
      const swing = (s == 0 ? 0 - sg : sg) * amp
      "hind_{s}" {
        Position: {sx * 0.085, 0.2, 0 - 0.13}
        Rotation: {swing - rear * 0.25, 0, 0}
        thigh : ParisRaccoonFur { Position: {0, 0 - 0.03, 0.01}; Scale: {0.75, 1.15, 1.1}; Sphere: {radius: 0.065, segments: 10, smooth: true} }
        leg : ParisRaccoonFurDark { Position: {0, 0 - 0.1, 0}; Capsule: {length: 0.1, radius: 0.028, segments: 8, smooth: true} }
        foot : ParisRaccoonFurDark { Position: {0, 0 - 0.183, 0.02}; Scale: {1, 0.55, 1.5}; Sphere: {radius: 0.032, segments: 8, smooth: true} }
      }
    }

    body {
      Position: {0, bob - 0.03 * dash, 0}

      // Pivots at the rump: rearing tips the front up onto the hind legs, a sprint rocks it.
      torso {
        Position: {0, 0.22, 0 - 0.14}
        Rotation: {0 - rear * 1.05 + sin(gait * 2) * 0.07 * dash, 0, sg * 0.04 * run}

        rump : ParisRaccoonFur { Position: {0, 0.03, 0}; Sphere: {radius: 0.13, segments: 16, smooth: true} }
        chest : ParisRaccoonFur {
          Position: {0, 0.03, 0.13}
          Scale: {0.27, 0.24, 0.4}
          Sphere: {radius: 0.5, segments: 18, smooth: true}
        }

        belly : ParisRaccoonFurPale {
          Position: {0, 0 - 0.03, 0.15}
          Scale: {0.2, 0.14, 0.3}
          Sphere: {radius: 0.5, segments: 14, smooth: true}
          Rgb: {176, 170, 160}
        }

        // Front legs with little hands; they reach forward and paddle when reared up.
        for s in 0..2 {
          const sx = s * 2 - 1
          const swing = (s == 0 ? sg : 0 - sg) * amp
          "front_{s}" {
            Position: {sx * 0.085, 0 - 0.02, 0.27}
            Rotation: {swing + rear * 0.95 + (s == 0 ? dig : 0 - dig), 0, 0}
            shoulder : ParisRaccoonFur { Position: {0, 0 - 0.02, 0}; Scale: {0.75, 1.1, 1}; Sphere: {radius: 0.055, segments: 10, smooth: true} }
            leg : ParisRaccoonFurDark { Position: {0, 0 - 0.1, 0}; Capsule: {length: 0.1, radius: 0.026, segments: 8, smooth: true} }
            hand : ParisRaccoonFurDark { Position: {0, 0 - 0.183, 0.015}; Scale: {1.1, 0.55, 1.3}; Sphere: {radius: 0.03, segments: 8, smooth: true} }
            for f in 0..3 {
              "finger_{f}" : ParisRaccoonFurDark {
                Position: {(f - 1) * 0.017, 0 - 0.19, 0.047}
                Sphere: {radius: 0.011, segments: 6, smooth: true}
              }
            }
          }
        }

        neck : ParisRaccoonFur { Position: {0, 0.08, 0.32}; Sphere: {radius: 0.085, segments: 12, smooth: true} }

        // The head stays about level while the body rears and looks around while it stands.
        head {
          Position: {0, 0.11, 0.4}
          Rotation: {rear * 0.7 + 0.05 * dash, rear * (1 - run) * sin(gait * 0.3) * 0.5, 0}

          skull : ParisRaccoonFur { Scale: {1.15, 0.92, 1}; Sphere: {radius: 0.095, segments: 16, smooth: true} }

          // The pointed snout, pale with a black button nose.
          snout : ParisRaccoonFurPale {
            Position: {0, 0 - 0.035, 0.12}
            Rotation: {PI / 2 + 0.12, 0, 0}
            Scale: {1.1, 1, 0.85}
            Cone: {length: 0.13, radius: 0.048, segments: 12}
          }

          nose : ParisRaccoonNose { Position: {0, 0 - 0.043, 0.183}; Scale: {1.2, 0.85, 1}; Sphere: {radius: 0.018, segments: 8, smooth: true} }

          // The black mask across the eyes and down the bridge of the nose, white brows above and
          // white cheeks below.
          mask_bridge : ParisRaccoonFurBlack {
            Position: {0, 0.01, 0.083}
            Scale: {0.7, 1.2, 0.7}
            Sphere: {radius: 0.028, segments: 8, smooth: true}
          }

          for s in 0..2 {
            const sx = s * 2 - 1

            "mask_{s}" : ParisRaccoonFurBlack {
              Position: {sx * 0.05, 0.005, 0.068}
              Rotation: {0, sx * 0.5, 0 - sx * 0.25}
              Scale: {1.5, 0.75, 0.6}
              Sphere: {radius: 0.04, segments: 10, smooth: true}
            }

            "eye_{s}" : ParisRaccoonEye {
              Position: {sx * 0.045, 0.012, 0.094}
              Sphere: {radius: 0.014, segments: 8, smooth: true}
            }

            "brow_{s}" : ParisRaccoonFurPale {
              Position: {sx * 0.044, 0.046, 0.074}
              Rotation: {0, sx * 0.45, 0 - sx * 0.25}
              Scale: {1.6, 0.45, 0.6}
              Sphere: {radius: 0.035, segments: 8, smooth: true}
            }

            "cheek_{s}" : ParisRaccoonFurPale {
              Position: {sx * 0.065, 0 - 0.032, 0.045}
              Scale: {1, 0.8, 1.1}
              Sphere: {radius: 0.048, segments: 10, smooth: true}
            }

            // Rounded ears with a white rim, flattened back when scared or sprinting.
            "ear_{s}" {
              Position: {sx * 0.068, 0.09, 0 - 0.012}
              Rotation: {0 - 0.6 * puff - 0.4 * dash, 0, 0 - sx * 0.35}
              rim : ParisRaccoonFurPale { Scale: {1, 1, 0.38}; Sphere: {radius: 0.038, segments: 10, smooth: true} }
              inner : ParisRaccoonFurBlack { Position: {0, 0 - 0.004, 0.006}; Scale: {1, 1, 0.3}; Sphere: {radius: 0.029, segments: 8, smooth: true} }
              base : ParisRaccoonFur { Position: {0, 0 - 0.022, 0 - 0.003}; Scale: {1.1, 0.7, 0.6}; Sphere: {radius: 0.032, segments: 8, smooth: true} }
            }
          }
        }
      }

      // The bushy tail with black rings and a black tip, sways with the gait, drops to the ground
      // when reared up, streams out in a sprint and bristles up when scared.
      tail {
        Position: {0, 0.24, 0 - 0.25}
        Rotation: {0.05 - 0.55 * rear + 0.45 * puff + 0.12 * dash, wag * 0.35, 0}
        for k in 0..8 {
          const r = (0.04 + 0.014 * sin(k * PI / 7)) * (1 + 0.45 * puff) * (k == 7 ? 0.8 : 1)
          const tx = wag * k * k * 0.0025
          const tz = 0 - 0.03 - k * 0.048
          if k == 1 || k == 3 || k == 5 || k == 7 {
            "ring_{k}" : ParisRaccoonFurBlack { Position: {tx, 0 - k * 0.004, tz}; Scale: {1, 1, 0.9}; Sphere: {radius: r, segments: 12, smooth: true} }
          } else {
            "ring_{k}" : ParisRaccoonFur { Position: {tx, 0 - k * 0.004, tz}; Scale: {1, 1, 0.9}; Sphere: {radius: r, segments: 12, smooth: true} }
          }
        }
      }
    }

    // Copy the position and the pose of state.pr_raccoons[id] into the mut variables.
    async {
      while true {
        await next_frame()
        if id >= 0 && id < PR_RACCOONS {
          const s = pr_raccoons[id]
          if px != s.x { px = s.x }
          if py != s.y { py = s.y }
          if pz != s.z { pz = s.z }
          if yaw != s.yaw { yaw = s.yaw }
          if gait != s.gait { gait = s.gait }
          if speed != s.speed { speed = s.speed }
          if rearing != s.rearing { rearing = s.rearing }
          if tail_puff != s.tail_puff { tail_puff = s.tail_puff }
          if hidden != s.hidden { hidden = s.hidden }
        }
      }
    }
  }
}

include fable_isle/state
include fable_isle/materials
include fable_isle/terrain
include fable_isle/camera
include fable_isle/stars
include fable_isle/rail
include fable_isle/nature
include fable_isle/skylife
include fable_isle/village
include fable_isle/hud
include fable_isle/audio
include fable_isle/creatures
include fable_isle/whale

using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.atmosphere
using box.texture
using state
using assets

window { Surface: {width: 1600, height: 1000, vsync: true} }

sun {
  DirectionalLight: {intensity: 3 * PI}
  Rgb: {255, 248, 236}
  Cookie: {
    texture: isle_cloud_h,
    size: 460,
    height: 400,
    threshold: 0.42,
    softness: 0.1,
    strength: 0.42,
    velocity: {3 + wind * 12, 1.5 + wind * 5}
  }
}

moon {
  DirectionalLight: {intensity: 0.45 * PI}
  Rgb: {190, 210, 255}
}

sky {
  Atmosphere: {
    sun: sun,
    moon: moon,
    units_per_km: 220,
    sea_level: 0,
    ground_altitude: 3.2,
    rayleigh: {scale_height: 8, scattering_scale: 1.2},
    mie: {scale_height: 1.2, anisotropy: 0.8, scattering_scale: 0.8, tint: {255, 236, 214}},
    ozone_scale: 2,
    ground_albedo: {30, 80, 150},
    night_tint: {64, 88, 190},
    night_intensity: 0.055,
    sun_disk_intensity: 8,
    sun_radius: 1.1,
    moon_radius: 1.6,
    moon_disk_intensity: 24,
    earthshine: 0.05
  }
  TimeOfDay: {
    hour: hour,
    day_of_year: season == SPRING ? 95 : season == SUMMER ? 172 : season == AUTUMN ? 280 : 355,
    latitude: 38,
    north: 205,
    sun: sun,
    moon: moon
  }
}

cloud_sea {
  CloudLayer: {
    texture: isle_cloud_h,
    size: 2600,
    altitude: -170,
    threshold: 0.58,
    softness: 0.05,
    velocity: {4 + wind * 14, 2 + wind * 6}
  }
}

cloud_high {
  CloudLayer: {
    texture: isle_cloud_h,
    size: 9000,
    altitude: 1600,
    threshold: 0.7,
    softness: 0.16,
    density: 0.5,
    offset: {700, 300},
    velocity: {6 + wind * 20, 3}
  }
}

$ {
  box.app.FpsTarget: {60}
  Scene: {reflections: true, punctual_shadows: true, environment: true, aerial_perspective: true,
    blend_modes: true, transmission: true, triplanar: true, clear_coat: true, sheen: true,
    diffuse_transmission: true, texture_scroll: true, water: true, fresnel: true,
    alpha_cutout: true, cookies: true}
}

rig {
  Position: {cam_x, cam_y, cam_z}
  Rotation: {0, cam_yaw, 0}
  arm {
    Rotation: {0 - cam_pitch, 0, 0}
    eye {
      Position: {0 - cam_dist * 0.085, 0, cam_dist}
      Camera: {fov: 34, near_: 0.5, far_: 4000}
    }
  }
}

isle {
  IsleTerrain terrain()
  IsleStars stars()
  IsleRailway railway()
  IsleNature nature()
  IsleSkyLife skylife()
  IsleVillage village()
  IsleWindmill windmill()
  IsleLighthouse lighthouse()
  IsleFarm farm()
  IsleSkyWhale whale()
  IsleAirship airship()
}

view {
  isle_contact { Gtao: {radius: 0.8, final_value_power: 2} }
  isle_bloom { Bloom: {intensity: 0.16, threshold: 1.2, threshold_softness: 0.5} }
  isle_exposure {
    AutoExposure: {
      min_log_luma: -11,
      min_brightness: 0.16,
      max_brightness: 0.4,
      exposure_compensation: -1.5 + 2 * daylight,
      max_exposure: 5
    }
  }

  isle_film { Tonemap: {auto_exposure: isle_exposure, operator_: TonyMcMapface} }
  isle_grade { ColorGrading: {contrast: 1.03, saturation: 1.05} }
  isle_edges { Smaa: {} }

  View: {
    camera: cam_pick == CAM_TRAIN ?
      isle.lookup("railway").lookup("pivot").lookup("loco").lookup("cam") :
      cam_pick == CAM_BALLOON ?
      isle.lookup("skylife").lookup("balloon_0").lookup("rig").lookup("cam") : rig.arm.eye,
    clear: {enabled: true, color: {10, 12, 20, 255}},
    lighting: {
      enabled: true,
      reflections: true,
      atmosphere: true,
      environment: {source: sky, intensity: 1, background: false}
    },
    shadows: {enabled: true, resolution: 4096, max_distance: 220},
    effects: [
      {effect: isle_contact},
      {effect: sky},
      {effect: isle_bloom},
      {effect: isle_film},
      {effect: isle_grade},
      {effect: isle_edges}
    ]
  }
}

IsleHud hud()

async {
  while true {
    await next_frame()
    const status = sky[TimeOfDayStatus]
    const dark = status.sun_altitude < -2

    if dark != night {
      night = dark
    }

    const level = round(clamp((status.sun_altitude + 8) / 8, 0, 1) * 40) / 40

    if level != daylight {
      daylight = level
    }
  }
}

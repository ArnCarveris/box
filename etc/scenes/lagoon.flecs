include lagoon/state
include lagoon/materials
include lagoon/world
include lagoon/wake
include lagoon/canoe
include lagoon/scenery
include lagoon/riverbed
include lagoon/play
include lagoon/hazards
include lagoon/life
include lagoon/hud

using flecs.script
using flecs.script.math
using box.app
using box.view
using box.surface
using state

$ {
  box.app.FpsTarget: {60}
  Scene: {environment: true, aerial_perspective: true, planar_reflections: true,
    shader_features: {Extended: {blend_modes: true, sheen: true, diffuse_transmission: true,
    texture_scroll: true, water: true}}}
}

window { Surface: {width: 1280, height: 800, vsync: true} }

include materials
include shrub
using flecs.script
using box.transform
using box.geometry
using box.material
using box.texture

assets {
  korean_ground {
    tone { Gen: {width: 256, seed: 5, layers: [{kind: GenNoise, frequency: 16, octaves: 3}]} }
    patches_height { Gen: {width: 256, seed: 9, layers: [{kind: GenNoise, frequency: 4, octaves: 2}, {kind: GenNoise, frequency: 8, octaves: 2, amount: 0.35, seed: 3}]} }
    patches { Gen: {source: patches_height, output: GenAlbedo, colors: [{0, {255, 0, 0}}, {0.48, {255, 0, 0}}, {0.6, {0, 255, 0}}, {1, {0, 255, 0}}]} }
    dirt_a_tex { Gen: {source: tone, output: GenAlbedo, colors: [{0, {160, 143, 106}}, {1, {174, 157, 117}}]} }
    dirt_b_tex { Gen: {source: tone, output: GenAlbedo, colors: [{0, {154, 139, 103}}, {1, {170, 155, 116}}]} }
    yard_a_tex { Gen: {source: tone, output: GenAlbedo, colors: [{0, {181, 167, 133}}, {1, {192, 178, 143}}]} }
    yard_b_tex { Gen: {source: tone, output: GenAlbedo, colors: [{0, {176, 162, 128}}, {1, {190, 176, 141}}]} }
    grass_a_tex { Gen: {source: tone, output: GenAlbedo, colors: [{0, {100, 120, 70}}, {1, {116, 136, 82}}]} }
    grass_b_tex { Gen: {source: tone, output: GenAlbedo, colors: [{0, {86, 114, 60}}, {1, {122, 146, 80}}]} }
    dirt_a { PbrTextures: {albedo: korean_ground.dirt_a_tex}; TextureTransform: {4, 4, 0, 0} }
    dirt_b { PbrTextures: {albedo: korean_ground.dirt_b_tex}; TextureTransform: {4, 4, 0, 0} }
    yard_a { PbrTextures: {albedo: korean_ground.yard_a_tex}; TextureTransform: {4, 4, 0, 0} }
    yard_b { PbrTextures: {albedo: korean_ground.yard_b_tex}; TextureTransform: {4, 4, 0, 0} }
    grass_a { PbrTextures: {albedo: korean_ground.grass_a_tex}; TextureTransform: {4, 4, 0, 0} }
    grass_b { PbrTextures: {albedo: korean_ground.grass_b_tex}; TextureTransform: {4, 4, 0, 0} }
  }

  template KoreanLandscape {
    { Position: {0, -0.6, 0}; RoundedBox: {32, 1.15, 28, 0.45}; Rgb: {94, 105, 94}; PbrMaterial: {roughness: 1} }
    { Position: {0, -0.035, 0}; RoundedBox: {31.8, 0.18, 27.8, 0.42}; Rgb: {255, 255, 255}; PbrMaterial: {roughness: 1}; TextureBlend: {mask: korean_ground.patches, layers: [korean_ground.dirt_a, korean_ground.dirt_b]}; TextureMapping: {mode: MappingWorld, size: 8} }
    { Position: {0, 0.065, -0.2}; RoundedBox: {11.6, 0.12, 14, 0.16}; Rgb: {255, 255, 255}; PbrMaterial: {roughness: 1}; TextureBlend: {mask: korean_ground.patches, layers: [korean_ground.yard_a, korean_ground.yard_b]}; TextureMapping: {mode: MappingWorld, size: 5} }
    for i in 0..360 {
      const x = (i * 97 % 310) * 0.1 - 15.5
      const z = (i * 59 % 270) * 0.1 - 13.5
      { Position: {x, 0.07, z}; Scale: {1.3, 0.5, 1}; IcoSphere: {radius: 0.022 + i % 4 * 0.012, segments: 0}; Rgb: {134 + i % 3 * 18, 124 + i % 3 * 16, 100 + i % 3 * 14}; PbrMaterial: {roughness: 1} }
    }
    for i in 0..240 {
      const x = (i * 83 % 110) * 0.1 - 5.5
      const z = (i * 47 % 134) * 0.1 - 6.9
      { Position: {x, 0.132, z}; Scale: {1.3, 0.5, 1}; IcoSphere: {radius: 0.02 + i % 4 * 0.012, segments: 0}; Rgb: {150 + i % 3 * 18, 142 + i % 3 * 16, 116 + i % 3 * 14}; PbrMaterial: {roughness: 1} }
    }
    for row in 0..17 {
      for col in 0..4 {
        const tone = (row * 5 + col * 3) % 4
        { Position: {(col - 1.5) * 0.64 + (row % 2) * 0.03, 0.15, -4.8 + row * 0.94}; RoundedBox: {0.6, 0.12, 0.89, 0.035}; Rgb: {142 + tone * 9, 146 + tone * 8, 134 + tone * 8}; PbrMaterial: {roughness: 0.95} }
      }
    }
    for row in 0..15 {
      for side in 0..2 {
        { Position: {(side - 0.5) * 2.76, 0.135, -4.8 + row * 1.1}; RoundedBox: {0.16, 0.08, 1.06, 0.02}; Rgb: {118, 118, 106} }
      }
    }
    for side in 0..2 {
      { Position: {(side - 0.5) * 26, 0.07, -1}; RoundedBox: {4.5, 0.12, 23, 0.7}; Rgb: {255, 255, 255}; PbrMaterial: {roughness: 1}; TextureBlend: {mask: korean_ground.patches, layers: [korean_ground.grass_a, korean_ground.grass_b]}; TextureMapping: {mode: MappingWorld, size: 6} }
      for i in 0..23 {
        { Position: {(side - 0.5) * 25 + math.sin(i * 2.4) * 0.8, 0.18, -11.5 + i}; Scale: {0.5 + i % 3 * 0.13, 0.25, 0.4}; IcoSphere: {radius: 1, segments: 1}; Rgb: {132 + i % 3 * 9, 140 + i % 3 * 8, 120 + i % 3 * 7} }
      }
      for i in 0..120 {
        const x = (side - 0.5) * 26 + (i * 41 % 42) * 0.1 - 2.1
        const z = -12.2 + (i * 61 % 225) * 0.1
        for blade in 0..3 {
          { Position: {x + blade * 0.05, 0.22, z + (blade - 1) * 0.03}; Rotation: {0.18 * (blade - 1), i * 0.7, (blade - 1) * 0.28}; Cone: {radius: 0.035, length: 0.26 + i % 3 * 0.06, segments: 4}; Rgb: {92 + i % 3 * 13, 128 + blade * 9, 66} }
        }
      }
    }
    for side in 0..2 {
      for i in 0..13 {
        { Position: {(side - 0.5) * 14, 0.12, -5 + i * 0.9}; Rotation: {0, i * 0.31, 0}; Cylinder: {radius: 0.39, length: 0.14, segments: 7}; Rgb: {168, 170, 153} }
      }
    }
    { Position: {0, 0.056, 12.45}; Box: {30.6, 0.004, 1.36}; Rgb: {84, 96, 82}; PbrMaterial: {roughness: 1} }
    { (IsA, KoreanWater); Position: {0, 0.08, 12.45}; Box: {30.6, 0.05, 1.36} }
    for side in 0..2 {
      const z = 12.45 + (side - 0.5) * 1.5
      for i in 0..58 {
        const tone = (i * 7 + side) % 4
        { Position: {-15.15 + i * 0.53 + side * 0.2, 0.13, z + math.sin(i * 1.9) * 0.05}; Rotation: {0, i * 1.3, 0}; Scale: {1.25, 0.5, 0.8}; IcoSphere: {radius: 0.17 + i % 4 * 0.05, segments: 1}; Rgb: {118 + tone * 11, 120 + tone * 10, 110 + tone * 9}; PbrMaterial: {roughness: 1} }
      }
    }
    for i in 0..12 {
      const x = -14 + (i * 67 % 280) * 0.1
      if x * x > 3 {
        { KoreanRock: {size: 0.34 + i % 3 * 0.1}; Position: {x, 0.07, 12.25 + (i % 3) * 0.2}; Rotation: {0, i * 1.1, 0} }
      }
    }
    for slab in 0..3 {
      { (IsA, KoreanStone); Position: {(slab - 1) * 0.92, 0.26, 12.45}; RoundedBox: {0.88, 0.16, 2.5, 0.03} }
      { Position: {(slab - 1) * 0.92, 0.343, 12.45}; Box: {0.8, 0.008, 2.42}; Rgb: {166 - slab * 12, 167 - slab * 12, 152 - slab * 11}; PbrMaterial: {roughness: 1} }
    }
    for side in 0..2 {
      const x = (side - 0.5) * 2.86
      { (IsA, KoreanStone); Position: {x, 0.17, 12.45}; Box: {0.3, 0.26, 1.8} }
      for end in 0..2 {
        const z = 12.45 + (end - 0.5) * 2.2
        { (IsA, KoreanStone); Position: {x, 0.5, z}; Box: {0.2, 0.5, 0.2} }
        { (IsA, KoreanStone); Position: {x, 0.8, z}; Sphere: {radius: 0.12, segments: 10} }
      }
      { (IsA, KoreanStone); Position: {x, 0.6, 12.45}; Box: {0.1, 0.09, 2.1} }
    }
  }
}

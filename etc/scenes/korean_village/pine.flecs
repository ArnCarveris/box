include beam
using flecs.script
using box.transform
using box.geometry
using box.material

@tree Parent
template KoreanPine {
  prop variant: f32 = 0
  for seg in 0..14 {
    const t = seg / 14.0
    const n = (seg + 1) / 14.0
    KoreanBeam(ax: math.sin(t * 3) * 0.7, ay: t * 4.9, az: 0.1 * t, bx: math.sin(n * 3) * 0.7, by: n * 4.9, bz: 0.1 * n, radius: 0.23 - t * 0.14, tint: {112, 76, 52}) {}
  }
  for plate in 0..54 {
    const t = plate / 54.0
    const a = plate * 2.4
    const r = 0.21 - t * 0.14
    { (IsA, KoreanBark); Position: {math.sin(t * 3) * 0.7 + math.sin(a) * r, t * 4.9, 0.1 * t + math.cos(a) * r}; Rotation: {0, a, 0}; Scale: {1, 1.6, 0.34}; IcoSphere: {radius: 0.075 - t * 0.04, segments: 0}; Rgb: {66 + plate % 4 * 14, 46 + plate % 4 * 9, 34 + plate % 4 * 6} }
  }
  for branch in 0..8 {
    const a = branch * 2.4 + variant
    const y = 2.6 + branch * 0.3
    const spread = 1.85 - branch * 0.12
    const x = math.sin(a) * spread + 0.3
    const z = math.cos(a) * spread
    KoreanBeam(ax: 0.5, ay: y - 0.35, az: 0, bx: x, by: y + 0.2, bz: z, radius: 0.07, tint: {103, 69, 43}) {}
    for clump in 0..4 {
      const cx = x + math.sin(clump * 2.4 + branch) * 0.55
      const cy = y + 0.25 + math.sin(clump * 1.8) * 0.13
      const cz = z + math.cos(clump * 2.4 + branch) * 0.48
      { Position: {cx, cy - 0.06, cz}; Scale: {1.1, 0.32, 0.9}; IcoSphere: {radius: 0.7, segments: 1}; Rgb: {38, 74, 50} }
      for tuft in 0..12 {
        const ta = tuft * 2.4 + clump
        const tr = 0.08 + tuft * 0.062
        const tone = (tuft + clump * 2 + branch) % 3
        { Position: {cx + math.sin(ta) * tr * 1.12, cy + 0.1 - tr * 0.18, cz + math.cos(ta) * tr * 0.92}; Rotation: {ta * 0.3, ta, 0}; Scale: {1, 0.56, 1}; IcoSphere: {radius: 0.3 - tuft * 0.009, segments: 1}; Rgb: {48 + tone * 10, 90 + tone * 11, 56 + tone * 6} }
      }
    }
  }
  for root in 0..7 {
    const a = root * 0.898 + variant
    KoreanBeam(ax: 0, ay: 0.2, az: 0, bx: math.sin(a) * 0.75, by: 0.03, bz: math.cos(a) * 0.75, radius: 0.075, tint: {94, 64, 44}) {}
  }
}

include roof
include bracket
include door
using flecs.script
using box.transform
using box.geometry
using box.material

@tree Parent
template KoreanHall {
  { (IsA, KoreanStone); Position: {0, 0.25, 0}; RoundedBox: {8.1, 0.5, 5.7, 0.09} }
  { (IsA, KoreanStone); Position: {0, 0.56, 0}; Box: {8.35, 0.14, 5.9} }
  for course in 0..2 {
    for block in 0..16 {
      { Position: {-3.8 + block * 0.5 + course * 0.08, 0.14 + course * 0.23, 2.86}; Box: {0.012, 0.21, 0.012}; Rgb: {101, 108, 102} }
    }
  }
  for step in 0..3 {
    { Position: {0, 0.1 + step * 0.17, 3.5 - step * 0.28}; Box: {2.7, 0.2, 0.65}; Rgb: {175, 176, 161} }
  }
  { (IsA, KoreanPlaster); Position: {0, 1.8, -0.25}; Box: {6.7, 2.4, 3.65} }
  for bay in 0..4 {
    for side in 0..2 {
      const x = (bay - 1.5) * 2.15
      const z = (side - 0.5) * 4.5
      { (IsA, KoreanStone); Position: {x, 0.76, z}; Cylinder: {radius: 0.29, length: 0.28, segments: 12} }
      { (IsA, KoreanRed); Position: {x, 1.97, z}; Cylinder: {radius: 0.16, length: 2.3, segments: 16, smooth: true} }
      { (IsA, KoreanMint); Position: {x, 3.02, z}; Box: {0.42, 0.14, 0.42} }
      { KoreanBracket: {}; Position: {x, 3.23, z} }
    }
  }
  for side in 0..2 {
    const z = (side - 0.5) * 4.5
    { (IsA, KoreanGreen); Position: {0, 3.2, z}; Box: {7.4, 0.4, 0.23} }
    for stripe in 0..2 {
      { (IsA, KoreanMint); Position: {0, 3.2 + (stripe - 0.5) * 0.3, z}; Box: {7.45, 0.035, 0.26} }
    }
    for flower in 0..13 {
      { KoreanLotus: {}; Position: {(flower - 6) * 0.55, 3.2, z + (side * 2 - 1) * 0.14}; Rotation: {0, (1 - side) * math.PI, 0}; Scale: {0.78, 0.78, 0.78} }
    }
    for rafter in 0..29 {
      { Position: {(rafter - 14) * 0.26, 3.63, z}; Cylinder: {radius: 0.065, length: 1.05, segments: 8}; Rotation: {math.PI / 2 + (side - 0.5) * -0.35, 0, 0}; Rgb: {125, 170, 120} }
    }
  }
  for bay in 0..3 {
    { KoreanDoor: {}; Position: {(bay - 1) * 2.15, 1.8, 1.61} }
    { (IsA, KoreanRed); Position: {(bay - 1) * 2.15, 2.8, 1.65}; Box: {2, 0.18, 0.18} }
  }
  for side in 0..2 {
    const sign = side * 2 - 1
    {
      Position: {sign * 3.38, 0, -0.25}
      Rotation: {0, sign * math.PI / 2, 0}
      for panel in 0..2 {
        { KoreanDoor: {}; Position: {(panel - 0.5) * 1.7, 1.8, 0.03}; Scale: {0.9, 1, 1} }
      }
      { (IsA, KoreanRed); Position: {0, 1.85, 0.09}; Box: {0.15, 2.4, 0.2} }
      { (IsA, KoreanGreen); Position: {0, 3.2, 0.09}; Box: {4.6, 0.4, 0.25} }
      for stripe in 0..2 {
        { (IsA, KoreanMint); Position: {0, 3.2 + (stripe - 0.5) * 0.3, 0.23}; Box: {4.6, 0.03, 0.03} }
      }
      for flower in 0..9 {
        { KoreanLotus: {}; Position: {(flower - 4) * 0.5, 3.2, 0.24}; Scale: {0.8, 0.8, 0.8} }
      }
      for bracket in 0..3 {
        { KoreanBracket: {}; Position: {(bracket - 1) * 1.7, 3.24, 0} }
      }
    }
  }
  for plank in 0..26 {
    { (IsA, KoreanTimber); Position: {(plank - 12.5) * 0.28, 0.67, 2.12}; Box: {0.265, 0.075, 1.35} }
  }
  { KoreanRoof: {}; Position: {0, 3.72, 0} }
}

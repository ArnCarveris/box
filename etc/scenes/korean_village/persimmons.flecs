include materials
using flecs.script
using box.transform
using box.geometry
using box.material

assets {
  template KoreanPersimmons {
    for strand in 0..5 {
      const x = (strand - 2) * 0.15
      const length = 0.62 + strand % 2 * 0.14
      {
        (IsA, KoreanStraw)
        Position: {x, -length / 2, 0}
        Cylinder: {radius: 0.006, length: length, segments: 5}
      }

      for fruit in 0..6 {
        const y = -0.07 - fruit * 0.1

        if y > -length {
          {
            Position: {x, y, 0}
            Scale: {1, 0.82, 1}
            Sphere: {radius: 0.05, segments: 8}
            Rgb: {214 - (strand + fruit) % 3 * 14, 96 + (strand + fruit) % 3 * 10, 30}
            PbrMaterial: {roughness: 0.55}
          }
        }
      }
    }

    { (IsA, KoreanTimber); Position: {0, 0, 0}; Box: {0.86, 0.035, 0.035} }
  }
}

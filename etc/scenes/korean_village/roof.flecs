assets {
  prefab KoreanEaveLong {
    Path3D: {
      start: {-4.2, 0.33, 0},
      segments: [
        {kind: CatmullRom, end: {-4.074, 0.2759, 0}},
        {kind: CatmullRom, end: {-3.906, 0.2199, 0}},
        {kind: CatmullRom, end: {-3.696, 0.1699, 0}},
        {kind: CatmullRom, end: {-3.36, 0.1219, 0}},
        {kind: CatmullRom, end: {-2.856, 0.09143, 0}},
        {kind: CatmullRom, end: {-2.1, 0.08098, 0}},
        {kind: CatmullRom, end: {-1.05, 0.08, 0}},
        {kind: CatmullRom, end: {0, 0.08, 0}},
        {kind: CatmullRom, end: {1.05, 0.08, 0}},
        {kind: CatmullRom, end: {2.1, 0.08098, 0}},
        {kind: CatmullRom, end: {2.856, 0.09143, 0}},
        {kind: CatmullRom, end: {3.36, 0.1219, 0}},
        {kind: CatmullRom, end: {3.696, 0.1699, 0}},
        {kind: CatmullRom, end: {3.906, 0.2199, 0}},
        {kind: CatmullRom, end: {4.074, 0.2759, 0}},
        {kind: CatmullRom, end: {4.2, 0.33, 0}}
      ]
    }
  }

  prefab KoreanEaveShort {
    Path3D: {
      start: {0, 0.33, -2.9},
      segments: [
        {kind: CatmullRom, end: {0, 0.2759, -2.813}},
        {kind: CatmullRom, end: {0, 0.2199, -2.697}},
        {kind: CatmullRom, end: {0, 0.1699, -2.552}},
        {kind: CatmullRom, end: {0, 0.1219, -2.32}},
        {kind: CatmullRom, end: {0, 0.09143, -1.972}},
        {kind: CatmullRom, end: {0, 0.08098, -1.45}},
        {kind: CatmullRom, end: {0, 0.08, -0.725}},
        {kind: CatmullRom, end: {0, 0.08, 0}},
        {kind: CatmullRom, end: {0, 0.08, 0.725}},
        {kind: CatmullRom, end: {0, 0.08098, 1.45}},
        {kind: CatmullRom, end: {0, 0.09143, 1.972}},
        {kind: CatmullRom, end: {0, 0.1219, 2.32}},
        {kind: CatmullRom, end: {0, 0.1699, 2.552}},
        {kind: CatmullRom, end: {0, 0.2199, 2.697}},
        {kind: CatmullRom, end: {0, 0.2759, 2.813}},
        {kind: CatmullRom, end: {0, 0.33, 2.9}}
      ]
    }
  }

  const KOREAN_ROWS_LONG: entity[] = [
    KoreanRowL0_0, KoreanRowL0_1, KoreanRowL0_2, KoreanRowL0_3, KoreanRowL0_4, KoreanRowL0_5,
    KoreanRowL0_6, KoreanRowL0_7, KoreanRowL0_8, KoreanRowL0_9, KoreanRowL0_10, KoreanRowL0_11,
    KoreanRowL0_12, KoreanRowL0_13, KoreanRowL0_14, KoreanRowL0_15, KoreanRowL0_16, KoreanRowL0_17,
    KoreanRowL0_18, KoreanRowL0_19, KoreanRowL0_20, KoreanRowL0_21, KoreanRowL0_22, KoreanRowL0_23,
    KoreanRowL0_24, KoreanRowL0_25, KoreanRowL0_26, KoreanRowL0_27, KoreanRowL0_28, KoreanRowL0_29,
    KoreanRowL0_30, KoreanRowL1_0, KoreanRowL1_1, KoreanRowL1_2, KoreanRowL1_3, KoreanRowL1_4,
    KoreanRowL1_5, KoreanRowL1_6, KoreanRowL1_7, KoreanRowL1_8, KoreanRowL1_9, KoreanRowL1_10,
    KoreanRowL1_11, KoreanRowL1_12, KoreanRowL1_13, KoreanRowL1_14, KoreanRowL1_15, KoreanRowL1_16,
    KoreanRowL1_17, KoreanRowL1_18, KoreanRowL1_19, KoreanRowL1_20, KoreanRowL1_21, KoreanRowL1_22,
    KoreanRowL1_23, KoreanRowL1_24, KoreanRowL1_25, KoreanRowL1_26, KoreanRowL1_27, KoreanRowL1_28,
    KoreanRowL1_29, KoreanRowL1_30
  ]
  const KOREAN_ROWS_SHORT: entity[] = [
    KoreanRowS0_0, KoreanRowS0_1, KoreanRowS0_2, KoreanRowS0_3, KoreanRowS0_4, KoreanRowS0_5,
    KoreanRowS0_6, KoreanRowS0_7, KoreanRowS0_8, KoreanRowS0_9, KoreanRowS0_10, KoreanRowS0_11,
    KoreanRowS0_12, KoreanRowS0_13, KoreanRowS0_14, KoreanRowS0_15, KoreanRowS0_16, KoreanRowS0_17,
    KoreanRowS0_18, KoreanRowS1_0, KoreanRowS1_1, KoreanRowS1_2, KoreanRowS1_3, KoreanRowS1_4,
    KoreanRowS1_5, KoreanRowS1_6, KoreanRowS1_7, KoreanRowS1_8, KoreanRowS1_9, KoreanRowS1_10,
    KoreanRowS1_11, KoreanRowS1_12, KoreanRowS1_13, KoreanRowS1_14, KoreanRowS1_15, KoreanRowS1_16,
    KoreanRowS1_17, KoreanRowS1_18
  ]
  const KOREAN_RIDGES: entity[] = [KoreanRidge0_0, KoreanRidge0_1, KoreanRidge1_0, KoreanRidge1_1]

  template KoreanRoofRidge {
    {
      (IsA, KoreanTileEdge)
      Position: {0, 1.72, 0}
      Rotation: {0, 0, math.PI / 2}
      Cylinder: {radius: 0.14, length: 5.5, segments: 16}
    }

    { (IsA, KoreanPaper); Position: {0, 1.61, 0}; Box: {5.5, 0.16, 0.22} }

    for layer in 0..3 {
      {
        Position: {0, 1.53 + layer * 0.03, 0}
        Box: {5.42, 0.022, 0.42 - layer * 0.07}
        Rgb: {62 + layer * 12, 72 + layer * 12, 78 + layer * 12}
      }
    }

    for cap in 0..28 {
      {
        (IsA, KoreanTile)
        Position: {(cap - 13.5) * 0.196, 1.72, 0}
        Rotation: {0, 0, math.PI / 2}
        Cylinder: {radius: 0.15, length: 0.022, segments: 16}
      }
    }

    for end in 0..2 {
      const sign = end * 2 - 1

      for piece in 0..5 {
        const rise = piece / 4.0
        {
          Position: {sign * (2.68 + rise * rise * 0.16), 1.74 + rise * 0.46, 0}
          Rotation: {0, 0, -sign * (0.1 + rise * 0.55)}
          RoundedBox: {0.26 - rise * 0.1, 0.16, 0.3 - rise * 0.12, 0.035}
          Rgb: {96 + piece * 5, 108 + piece * 5, 110 + piece * 5}
        }
      }
    }
  }

  template KoreanRoof : KoreanRoofRidge {
    prop ornate: bool = false
    prop rafter: Rgb = {88, 56, 38}
    prop rafter_end: Rgb = {176, 150, 104}
    { (IsA, KoreanRoofSurface); Position: {} }

    for side in 0..2 {
      const sign = side * 2 - 1

      for tile in 0..31 {
        const u = (tile - 15) / 15.0
        const u2 = u * u
        const corner = 0.25 * u2 * u2 * u2 * u2
        const wear = (tile * 7 + side) % 5
        {
          Position: {0, 0, 0}
          Sweep: {
            path: KOREAN_ROWS_LONG[side * 31 + tile],
            profile: KoreanTileProfile,
            scale: {0.046, 0.046},
            rings: 16
          }
          Rgb: {78 + wear * 6, 94 + wear * 6, 102 + wear * 5}
          PbrMaterial: {roughness: 0.7}
        }

        {
          (IsA, KoreanTileEdge)
          Position: {u * 4.2, 0.175 + corner, sign * 2.92}
          Rotation: {math.PI / 2, 0, 0}
          Cylinder: {radius: 0.075, length: 0.07, segments: 12}
        }

        {
          (IsA, KoreanPaper)
          Position: {u * 4.2, 0.175 + corner, sign * 2.965}
          Rotation: {math.PI / 2, 0, 0}
          Torus: {radius: 0.035, tube: 0.009, segments: 10, rings: 4}
        }
      }

      for tile in 0..19 {
        const u = (tile - 9) / 9.0
        const u2 = u * u
        const wear = (tile * 7 + side) % 5
        {
          Position: {0, 0, 0}
          Sweep: {
            path: KOREAN_ROWS_SHORT[side * 19 + tile],
            profile: KoreanTileProfile,
            scale: {0.046, 0.046},
            rings: 16
          }
          Rgb: {78 + wear * 6, 94 + wear * 6, 102 + wear * 5}
          PbrMaterial: {roughness: 0.7}
        }
      }

      {
        Position: {0, 0, sign * 2.9}
        Sweep: {path: KoreanEaveLong, profile: KoreanTileProfile, scale: {0.09, 0.09}, rings: 48}
        Rgb: {196, 192, 164}
        PbrMaterial: {roughness: 0.7}
      }

      {
        Position: {sign * 4.2, 0, 0}
        Sweep: {path: KoreanEaveShort, profile: KoreanTileProfile, scale: {0.09, 0.09}, rings: 32}
        Rgb: {196, 192, 164}
        PbrMaterial: {roughness: 0.7}
      }

      for beam in 0..23 {
        const u = (beam - 11) / 11.6
        const u2 = u * u
        const corner = 0.25 * u2 * u2 * u2 * u2
        const ay = 0.01 + corner * 0.37
        const by = 0.03 + corner
        KoreanBeam(
          ax: u * (2.65 + 1.55 * 0.78),
          ay: ay,
          az: sign * 2.9 * 0.78,
          bx: u * 4.14,
          by: by,
          bz: sign * 2.84,
          radius: 0.052,
          tint: rafter
        ) {}
        {
          Position: {u * 4.14, by, sign * 2.84}
          Sphere: {radius: 0.058, segments: 8}
          Rgb: rafter_end
          PbrMaterial: {roughness: 0.8}
        }
      }

      for beam in 0..15 {
        const u = (beam - 7) / 7.6
        const u2 = u * u
        const corner = 0.25 * u2 * u2 * u2 * u2
        const ay = 0.01 + corner * 0.37
        const by = 0.03 + corner
        KoreanBeam(
          ax: sign * (2.65 + 1.55 * 0.78),
          ay: ay,
          az: u * 2.9 * 0.78,
          bx: sign * 4.14,
          by: by,
          bz: u * 2.84,
          radius: 0.052,
          tint: rafter
        ) {}
        {
          Position: {sign * 4.14, by, u * 2.84}
          Sphere: {radius: 0.058, segments: 8}
          Rgb: rafter_end
          PbrMaterial: {roughness: 0.8}
        }
      }

      for end in 0..2 {
        const across = end * 2 - 1
        {
          Position: {0, 0, 0}
          Sweep: {
            path: KOREAN_RIDGES[side * 2 + end],
            profile: KoreanTileProfile,
            scale: {0.095, 0.095},
            rings: 20
          }
          Rgb: {133, 144, 143}
          PbrMaterial: {roughness: 0.7}
        }

        {
          Position: {sign * 4.2, 0.46, across * 2.9}
          Sphere: {radius: 0.1, segments: 12, smooth: true}
          Rgb: {133, 144, 143}
          PbrMaterial: {roughness: 0.8}
        }

        if ornate {
          for figure in 0..4 {
            const t = 0.56 + figure * 0.09
            const y = 1.65 * (1 - t) * (1 - t) + 0.14 * t * t * t * t * t * t +
              0.25 * t * t * t * t + 0.11
            {
              Position: {sign * (2.65 + 1.55 * t), y + 0.09, across * 2.9 * t}
              {
                Position: {0, 0.02, 0}
                Cone: {radius: 0.05, length: 0.1, segments: 8}
                Rgb: {96, 108, 110}
              }

              { Position: {0, 0.09, 0}; Sphere: {radius: 0.032, segments: 8}; Rgb: {96, 108, 110} }
            }
          }

          {
            Position: {sign * 4.14, 0.12, across * 2.84}
            {
              (IsA, KoreanIron)
              Position: {0, -0.08, 0}
              Cylinder: {radius: 0.006, length: 0.16, segments: 6}
            }

            {
              (IsA, KoreanBronze)
              Position: {0, -0.2, 0}
              Frustum: {radius_bottom: 0.06, radius_top: 0.03, length: 0.1, segments: 12}
            }

            {
              (IsA, KoreanBronze)
              Position: {0, -0.31, 0}
              Scale: {1, 0.45, 0.2}
              Sphere: {radius: 0.05, segments: 8}
            }
          }
        }
      }
    }
  }
}

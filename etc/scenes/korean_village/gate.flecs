include roof
include bracket
using flecs.script
using box.transform
using box.geometry
using box.material

@tree Parent
template KoreanGate {
  for side in 0..2 {
    const x = (side - 0.5) * 3.7
    { (IsA, KoreanStone); Position: {x, 0.17, 0}; Cylinder: {radius: 0.32, length: 0.34, segments: 12} }
    { (IsA, KoreanRed); Position: {x, 1.55, 0}; Cylinder: {radius: 0.2, length: 2.8, segments: 16} }
    { KoreanBracket: {}; Position: {x, 2.98, 0} }
    {
      Position: {x, 0, 0}
      Rotation: {0, (side * 2 - 1) * -0.75, 0}
      { (IsA, KoreanRed); Position: {(1 - side * 2) * 0.65, 1.25, 0}; Box: {1.3, 2.2, 0.1} }
      for row in 0..4 {
        for stud in 0..4 {
          { Position: {(1 - side * 2) * (0.18 + stud * 0.29), 0.45 + row * 0.53, 0.07}; Sphere: {radius: 0.035, segments: 8}; Rgb: {59, 58, 47} }
        }
      }
      { Position: {(1 - side * 2) * 1.08, 1.2, 0.1}; Rotation: {math.PI / 2, 0, 0}; Torus: {radius: 0.09, tube: 0.018, segments: 16, rings: 6}; Rgb: {58, 57, 46} }
    }
  }
  { (IsA, KoreanGreen); Position: {0, 2.92, 0}; Box: {4.35, 0.38, 0.32} }
  for i in 0..9 {
    { KoreanLotus: {}; Position: {(i - 4) * 0.45, 2.92, 0.18}; Scale: {0.8, 0.8, 0.8} }
  }
  { KoreanRoof: {}; Position: {0, 3.4, 0}; Scale: {0.65, 0.64, 0.52} }
  { (IsA, KoreanStone); Position: {0, 0.08, 0}; Box: {4.4, 0.16, 1} }
}

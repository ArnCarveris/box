include materials
using flecs.script
using box.transform
using box.geometry
using box.material

@tree Parent
template KoreanWell {
  { (IsA, KoreanStone); Position: {0, 0.12, 0}; Cylinder: {radius: 1.05, length: 0.24, segments: 8} }
  { (IsA, KoreanStone); Position: {0, 0.6, 0}; Tube: {radius: 0.8, thickness: 0.22, length: 0.85, segments: 8} }
  { (IsA, KoreanStone); Position: {0, 1.05, 0}; Tube: {radius: 0.88, thickness: 0.3, length: 0.15, segments: 8} }
  { Position: {0, 0.48, 0}; Cylinder: {radius: 0.57, length: 0.03, segments: 24}; Rgb: {38, 80, 79}; PbrMaterial: {roughness: 0.08, metallic: 0.15} }
  for side in 0..2 {
    { (IsA, KoreanTimber); Position: {(side - 0.5) * 2.1, 1.3, 0}; Box: {0.13, 2.6, 0.13} }
  }
  { (IsA, KoreanTimber); Position: {0, 2.55, 0}; Box: {2.4, 0.14, 0.15} }
  { (IsA, KoreanTimber); Position: {0, 2.4, 0}; Rotation: {math.PI / 2, 0, 0}; Torus: {radius: 0.16, tube: 0.04, segments: 16, rings: 8} }
  { Position: {0.12, 1.8, 0}; Cylinder: {radius: 0.018, length: 1.2, segments: 8}; Rgb: {183, 160, 112} }
  { (IsA, KoreanTimber); Position: {0.12, 1.08, 0}; Tube: {radius: 0.2, thickness: 0.035, length: 0.3, segments: 12} }
}

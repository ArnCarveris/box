include materials
using flecs.script
using box.transform
using box.geometry
using box.material
using box.light

assets {
  template KoreanLantern {
    { (IsA, KoreanStone); Position: {0, 0.1, 0}; RoundedBox: {0.7, 0.2, 0.7, 0.04} }
    {
      (IsA, KoreanStone)
      Position: {0, 0.24, 0}
      Frustum: {radius_bottom: 0.3, radius_top: 0.2, length: 0.09, segments: 8}
    }

    {
      (IsA, KoreanStone)
      Position: {0, 0.65, 0}
      Cylinder: {radius: 0.14, length: 0.8, segments: 8}
    }

    for ring in 0..2 {
      {
        (IsA, KoreanStone)
        Position: {0, 0.52 + ring * 0.26, 0}
        Torus: {radius: 0.14, tube: 0.022, segments: 12, rings: 5}
      }
    }

    { (IsA, KoreanStone); Position: {0, 1.08, 0}; Box: {0.62, 0.12, 0.62} }

    for petal in 0..8 {
      const a = petal * math.PI / 4
      {
        (IsA, KoreanStone)
        Position: {math.sin(a) * 0.25, 1.01, math.cos(a) * 0.25}
        Rotation: {0, a, 0}
        Scale: {0.85, 0.5, 0.35}
        Sphere: {radius: 0.11, segments: 8}
      }
    }

    {
      Position: {0, 1.32, 0}
      Box: {0.32, 0.4, 0.32}
      Rgb: {243, 199, 121}
      Emissive: {strength: 1.3, color: {255, 172, 76}}
    }

    for x in 0..2 {
      for z in 0..2 {
        {
          Position: {(x - 0.5) * 0.43, 1.33, (z - 0.5) * 0.43}
          Box: {0.12, 0.43, 0.12}
          Rgb: {158, 161, 149}
        }
      }
    }

    {
      (IsA, KoreanStone)
      Position: {0, 1.61, 0}
      Rotation: {0, math.PI / 4, 0}
      Frustum: {radius_bottom: 0.56, radius_top: 0.21, length: 0.22, segments: 4}
    }

    for corner in 0..4 {
      const a = corner * math.PI / 2 + math.PI / 4
      {
        (IsA, KoreanStone)
        Position: {math.sin(a) * 0.53, 1.54, math.cos(a) * 0.53}
        Sphere: {radius: 0.045, segments: 8}
      }
    }

    {
      (IsA, KoreanStone)
      Position: {0, 1.76, 0}
      Cylinder: {radius: 0.1, length: 0.08, segments: 8}
    }

    {
      (IsA, KoreanStone)
      Position: {0, 1.86, 0}
      Sphere: {radius: 0.12, segments: 16, smooth: true}
    }

    { (IsA, KoreanStone); Position: {0, 1.99, 0}; Cone: {radius: 0.06, length: 0.12, segments: 8} }
    {
      Position: {0, 1.32, 0.26}
      PointLight: {intensity: 1.6, range: 5, shadows: true, shadow_resolution: 512}
      Rgb: {255, 170, 90}
    }

    {
      Position: {0, 1.32, -0.26}
      PointLight: {intensity: 0.8, range: 3.5, shadows: true, shadow_resolution: 256}
      Rgb: {255, 170, 90}
    }
  }
}

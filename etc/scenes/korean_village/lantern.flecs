include materials
using flecs.script
using box.transform
using box.geometry
using box.material

using box.light
@tree Parent
template KoreanLantern {
  { (IsA, KoreanStone); Position: {0, 0.1, 0}; RoundedBox: {0.7, 0.2, 0.7, 0.04} }
  { (IsA, KoreanStone); Position: {0, 0.55, 0}; Cylinder: {radius: 0.14, length: 0.8, segments: 8} }
  { (IsA, KoreanStone); Position: {0, 0.98, 0}; Box: {0.62, 0.12, 0.62} }
  { Position: {0, 1.22, 0}; Box: {0.32, 0.4, 0.32}; Rgb: {243, 199, 121}; Emissive: {strength: 1.3, color: {255, 185, 88}} }
  for x in 0..2 {
    for z in 0..2 {
      { Position: {(x - 0.5) * 0.43, 1.23, (z - 0.5) * 0.43}; Box: {0.12, 0.43, 0.12}; Rgb: {158, 161, 149} }
    }
  }
  { (IsA, KoreanStone); Position: {0, 1.51, 0}; Rotation: {0, math.PI / 4, 0}; Frustum: {radius_bottom: 0.56, radius_top: 0.21, length: 0.22, segments: 4} }
  { (IsA, KoreanStone); Position: {0, 1.72, 0}; Sphere: {radius: 0.12, segments: 12} }
}

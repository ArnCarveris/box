include korean_village/hall
include korean_village/house
include korean_village/gate
include korean_village/wall
include korean_village/onggi
include korean_village/pine
include korean_village/lantern
include korean_village/bench
include korean_village/well
include korean_village/landscape
include korean_village/shrub
include korean_village/bamboo
include korean_village/pagoda
include korean_village/jangseung
include korean_village/firewood
include ui/widgets
include cfg/hud
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.atmosphere
using box.widgets

window { Surface: {width: 1600, height: 1100, vsync: true} }
korean_contact { Gtao: {radius: 0.6, final_value_power: 1.7} }
korean_bloom { Bloom: {intensity: 0.1, threshold: 1.6} }
korean_exposure { AutoExposure: {min_log_luma: -10.8, exposure_compensation: 0.35, max_exposure: 20} }
korean_film { Tonemap: {auto_exposure: korean_exposure} }
korean_edges { Smaa: {} }

async {
  hud_hour = 15
  hud_day_of_year = 265
  hud_latitude = 36
  hud_north = 200
  hud_fog = 0.003
}

korean_village {
  Scene: {}
  ReflectionBake: {resolution: 64, budget_ms: 2, scene_probe: true, scene_probe_height: 2}
  camera {
    Position: {-31, 26, 37}
    Rotation: {-0.55, -0.697, 0}
    Camera: {fov: 40, near_: 0.1, far_: 200}
    CameraController: {speed: 10}
  }
  detail_camera {
    Position: {-7, 6.8, 3.5}
    Rotation: {-0.24, -0.55, 0}
    Camera: {fov: 48, near_: 0.1, far_: 200}
    CameraController: {speed: 5}
  }
  courtyard_camera {
    Position: {-0.9, 1.7, 8.2}
    Rotation: {-0.02, 0.02, 0}
    Camera: {fov: 58, near_: 0.1, far_: 200}
    CameraController: {speed: 4}
  }
  sun {
    DirectionalLight: {intensity: 2.8 * math.PI}
    Rgb: {255, 255, 255}
  }
  sky {
    Atmosphere: {
      sun: sun,
      units_per_km: 100,
      rayleigh: {scale_height: 8, scattering_scale: 2.5},
      mie: {scale_height: 1.4, anisotropy: 0.76, scattering_scale: 3, tint: {255, 222, 184}},
      ozone_scale: 3,
      ground_albedo: {118, 128, 104},
      sun_disk_intensity: 10,
      sun_radius: 0.75
    }
    TimeOfDay: {
      hour: hud.screen.options.body.hour[Slider.mut].current,
      day_of_year: hud.screen.options.body.day_of_year[Slider.mut].current,
      latitude: hud.screen.options.body.latitude[Slider.mut].current,
      north: hud.screen.options.body.north[Slider.mut].current,
      sun: sun
    }
    HeightFog: {
      density: hud.screen.options.body.fog[Slider.mut].current,
      falloff: 0.12,
      base_height: 0,
      max_opacity: 0.3,
      atmosphere: sky
    }
  }
  LightBake: {environment: sky, probe_spacing: 2.5, bounds_padding: 0.5, bounces: 1, capture_size: 32, budget_ms: 6}
  landscape { KoreanLandscape: {}; Position: {} }
  hall { KoreanHall: {}; Position: {0, 0.12, -7.6}; Scale: {1.12, 1.12, 1.12} }
  west_house { KoreanHouse: {}; Position: {-9.3, 0.12, -5.8}; Rotation: {0, math.PI / 2, 0} }
  west_workshop { KoreanHouse: {harvest: true}; Position: {-9.3, 0.12, 2.2}; Rotation: {0, math.PI / 2, 0} }
  east_house { KoreanHouse: {harvest: true}; Position: {9.3, 0.12, -5.8}; Rotation: {0, -math.PI / 2, 0} }
  east_kitchen { KoreanHouse: {}; Position: {9.3, 0.12, 2.2}; Rotation: {0, -math.PI / 2, 0} }
  gate { KoreanGate: {}; Position: {0, 0.12, 10.4} }
  for side in 0..2 {
    const sign = side * 2 - 1
    { KoreanWall: {length: 12.4, tiles: 58, stones: 26}; Position: {sign * 8.55, 0.12, 10.4} }
    for i in 0..4 {
      { KoreanWall: {length: 5.5, tiles: 26, stones: 12}; Position: {sign * 14.75, 0.12, -9.4 + i * 5.6}; Rotation: {0, math.PI / 2, 0} }
    }
    { KoreanLantern: {}; Position: {sign * 2.7, 0.13, 8.6} }
    { KoreanLantern: {}; Position: {sign * 2.85, 0.13, -3.4} }
    for i in 0..2 {
      { KoreanPine: {variant: side + i * 2}; Position: {sign * 12.75, 0.13, -10 + i * 15.6}; Scale: {0.92, 0.92, 0.92} }
    }
    { KoreanFirewood: {}; Position: {sign * 9.4, 0.13, -1.8}; Rotation: {0, math.PI / 2, 0} }
    { KoreanJangseung: {hat: {44 + side * 36, 44 + side * 8, 42 + side * 18}}; Position: {sign * 2.45, 0.07, 11.1}; Rotation: {0, -sign * 0.2, 0} }
    { KoreanShrub: {}; Position: {sign * 12.9, 0.13, -3.2}; Scale: {1.25, 1.25, 1.25} }
    { KoreanShrub: {bloom: {232, 142, 172}}; Position: {sign * 12.1, 0.13, 1.2} }
    { KoreanShrub: {bloom: {236, 212, 224}}; Position: {sign * 13.3, 0.13, 8.4}; Scale: {1.1, 1.1, 1.1} }
    { KoreanShrub: {}; Position: {sign * 5.7, 0.13, 9.6} }
    { KoreanRock: {size: 1.3}; Position: {sign * 13.5, 0.13, -0.8}; Rotation: {0, sign * 0.8, 0} }
    { KoreanRock: {size: 0.9}; Position: {sign * 12, 0.13, 8.9}; Rotation: {0, side * 2.4, 0} }
  }
  for i in 0..5 {
    { KoreanWall: {length: 5.8, tiles: 28, stones: 13}; Position: {(i - 2) * 5.9, 0.12, -12.3} }
  }
  for i in 0..46 {
    const x = -15.2 + i * 0.67 + math.sin(i * 2.3) * 0.2
    { KoreanBamboo: {height: 5.6 + (i * 5 % 7) * 0.42, tone: i % 3}; Position: {x, 0.06, -13.2 + math.sin(i * 1.7) * 0.25}; Rotation: {math.sin(i * 0.9) * 0.04, i * 1.1, math.sin(i * 1.3) * 0.05} }
  }
  courtyard_pine { KoreanPine: {variant: 1.2}; Position: {-4.3, 0.13, 3.9}; Scale: {0.85, 0.85, 0.85} }
  pagoda { KoreanPagoda: {}; Position: {4.3, 0.13, -0.6} }
  well { KoreanWell: {}; Position: {4.2, 0.13, 4.8} }
  jar_terrace : KoreanStone { Position: {8.7, 0.2, 7.6}; RoundedBox: {4, 0.25, 2.5, 0.12} }
  for side in 0..2 {
    for i in 0..9 {
      { Position: {6.84 + i * 0.465, 0.18, 7.6 + (side - 0.5) * 2.54}; RoundedBox: {0.44, 0.28, 0.08, 0.03}; Rgb: {128 + (i * 5 + side) % 4 * 10, 130 + (i * 5 + side) % 4 * 9, 118 + (i * 5 + side) % 4 * 9} }
    }
  }
  for row in 0..2 {
    for i in 0..4 {
      { KoreanOnggi: {size: 0.72 + (i + row) % 3 * 0.15}; Position: {7.3 + i * 0.94, 0.33, 7.1 + row * 1.03} }
    }
  }
  for i in 0..3 {
    { KoreanOnggi: {size: 0.65 + i * 0.12}; Position: {-6.8, 0.13, -9.6 + i * 0.88} }
  }
  bench { KoreanBench: {}; Position: {-4.2, 0.13, 5.6} }
  bamboo_mist {
    Position: {0, 1.4, -13.1}
    FogVolume: {
      extent: {15.6, 1.4, 1.3},
      density: 0.22,
      color: {232, 238, 236},
      edge_fade: 1.1,
      asymmetry: 0.45,
      noise_strength: 0.75,
      noise_scale: 3,
      wind: {0.25, 0.02, 0},
      steps: 8
    }
  }
  for i in 0..7 {
    { Position: {-4.3 + math.sin(i * 0.9) * 1.1, 0.22, 3.9 + math.cos(i * 0.9) * 0.85}; Scale: {0.35, 0.2, 0.3}; IcoSphere: {radius: 1, segments: 1}; Rgb: {136, 144, 125} }
  }
}

main_view {
  View: {
    camera: korean_village.camera,
    clear: {enabled: true, color: {174, 193, 194, 255}},
    lighting: {
      enabled: true,
      baked: hud.screen.options.body.baked[Checkbox.mut].current,
      reflections: true,
      atmosphere: true,
      environment: {source: korean_village.sky, intensity: 1.15, yaw: 0, background: false}
    },
    shadows: {enabled: hud.screen.options.body.shadows[Checkbox.mut].current, resolution: 2048, max_distance: 110},
    effects: [
      {enabled: hud.screen.options.body.gtao[Checkbox.mut].current, effect: korean_contact},
      {enabled: true, effect: korean_village.sky},
      {enabled: true, effect: korean_bloom},
      {enabled: true, effect: korean_film},
      {enabled: true, effect: korean_edges}
    ]
  }
}

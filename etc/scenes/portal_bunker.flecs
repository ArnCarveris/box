// Portal bunker compound, ported from the WebGPU Entities scenario of the same name: the bunker,
// its rooms and their walls, floors, roofs and frames (shell), the brick shed, the quay and the docked
// freighter's props, and the lights, with the rooms,
// openings and occluders as VisArea, VisPortal and VisOccluder components (see
// include/box/portal.h) and the doors as PortalDoor templates (portal/door.flecs). Walk with
// WASD (Shift runs, Space jumps, W/S climb ladders, you swim in the sea, F flies); the doors open
// for the camera, and what is behind closed or unseen portals is not drawn. The access control
// screen on the control room console (portal_bunker/screens) locks and unlocks the doors: aim
// the cursor at it within 3 m and click.
include ui/widgets
include portal/door
include portal/power
include portal/screen
include portal/doors_screen
include portal/facility_screen
include portal/power_screen
include portal/generator_screen
include portal/ship_chart
include portal/ship_feed
include portal/harbour_screen
include portal/engine_screen
include portal/navigation_screen
include portal/helm_screen
include portal/cctv_screen
include portal_bunker/textures
include portal_bunker/materials
include portal_bunker/models
include portal_bunker/rooms
include portal_bunker/shell
include portal_bunker/props
include portal_bunker/power
include portal_bunker/lights
include portal_bunker/island
include portal_bunker/ship
include portal_bunker/screens

using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.atmosphere
using box.texture

$ {
  box.app.FpsTarget: {60}
  Scene: {blend_modes: true, fresnel: true, water: true, texture_scroll: true, environment: true,
    aerial_perspective: true, reflections: true}
}

window {
  Surface: {width: 1600, height: 900, vsync: true}
}

// The original's walker: a 0.3 m body with 0.55 m steps that climbs ladders and swims
camera {
  Position: {0, 1.7, -16}
  Rotation: {-0.0349, 3.1416, 0}
  Camera: {fov: 70}
  FirstPersonController: {
    speed: 4.2, run: 7.5, eye: 1.65, radius: 0.3, step: 0.55, jump: 5.2, gravity: 18,
    climb: 2.4, swim_speed: 0.45, swim_jump: 3.5, swim_depth: 1.3, fly_speed: 5, boost: 2.8,
    turn_speed: 1.8, sensitivity: 0.0022, ground: -12
  }
  box.portal.PortalActor
}

// Ladders climb; the terrain and the hull collide by their triangles, not their bounds (the bulwark's
// bounds would be a slab over the whole ship)
BunkerModel_ladder { Climbable }

island {
  terrain_grass { TriangleCollider }
  terrain_sand { TriangleCollider }
}

// The route of the freighter seen from above (x, z; the height is not used) and the outline of
// its hull at the deck in its local frame (x, z), which the seabed and the quay must stay clear of
freighter_voyage {
  route {
    Path3D: {
      start: {55, 0, 29},
      segments: [
        {kind: CatmullRom, end: {55, 0, 75}},
        {kind: CatmullRom, end: {55, 0, 125}},
        {kind: CatmullRom, end: {55, 0, 160}},
        {kind: CatmullRom, end: {20, 0, 190}},
        {kind: CatmullRom, end: {-60, 0, 188}},
        {kind: CatmullRom, end: {-130, 0, 150}},
        {kind: CatmullRom, end: {-158, 0, 60}},
        {kind: CatmullRom, end: {-155, 0, -40}},
        {kind: CatmullRom, end: {-125, 0, -110}},
        {kind: CatmullRom, end: {-50, 0, -140}},
        {kind: CatmullRom, end: {20, 0, -140}},
        {kind: CatmullRom, end: {55, 0, -110}},
        {kind: CatmullRom, end: {55, 0, -70}},
        {kind: CatmullRom, end: {55, 0, -40}}
      ],
      closed: true
    }
  }

  outline {
    Path2D: {
      start: {49, -6},
      segments: [
        {kind: Line, end: {50, -8}},
        {kind: Line, end: {60, -8}},
        {kind: Line, end: {61, -6}},
        {kind: Line, end: {61, 52}},
        {kind: Line, end: {58.5, 60}},
        {kind: Line, end: {55, 66}},
        {kind: Line, end: {51.5, 60}},
        {kind: Line, end: {49, 52}}
      ],
      closed: true
    }
  }
}

// The freighter is the mover of the whole ship: the docked pose is its local frame (the identity), and
// moving or turning it carries the ship's rooms, portals, doors, lights, screens and props, which are
// its children (portal_bunker/rooms, shell, props, lights, screens).
freighter {
  Position: {0, 0, 0}
  Rotation: {0, 0, 0}
  DynamicTransform
  texture.Frame
  hull { TriangleCollider }
  antifouling { TriangleCollider }
  deck { TriangleCollider }
  bulwark { TriangleCollider }

  // The helm on the bridge: the wheel turns with the rudder about the fore-and-aft axis, the lever
  // tilts with the throttle; a click on the wheel within reach takes the helm like F at the stand
  helm_wheel {
    Position: {55, 9.2, 1.82}
    Rotation: {0, 0, 0}
    DynamicTransform
    texture.Frame
    box.picking.PickRange: {distance: 2.5}
    box.picking.ActionTrigger: {action: box.controllers.helm.Use}
    rim : BunkerMat_metal { Rotation: {1.5708, 0, 0}; Torus: {radius: 0.34, tube: 0.025} }
    spoke_across : BunkerMat_metal { Box: {0.66, 0.03, 0.03} }
    spoke_along : BunkerMat_metal { Box: {0.03, 0.66, 0.03} }
    hub : BunkerMat_steel { Position: {0, 0, -0.03}; Box: {0.08, 0.08, 0.08} }
  }

  helm_lever {
    Position: {55.55, 9.1, 2.05}
    Rotation: {0, 0, 0}
    DynamicTransform
    texture.Frame
    stick : BunkerMat_steel { Position: {0, 0.2, 0}; Box: {0.04, 0.4, 0.04} }
    knob : BunkerMat_metal { Position: {0, 0.42, 0}; Box: {0.08, 0.08, 0.08} }
  }

  // The voyage of the original (scenario vehicles.freighter): round the island on the route of
  // freighter_voyage.route, docking at its first waypoint, the quay
  Vessel: {
    route: freighter_voyage.route, pivot: {55, -1.2, 29}, dock: 0, speed: 7, accel: 0.35,
    wait: 30, max_speed: 9, max_yaw_rate: 0.12, yaw_response: 2.5, steer_heel: 0.6,
    max_heel: 0.1047, waves: {0.0192, 0.0314, 0.25}, outline: freighter_voyage.outline,
    keel: -5, deck: 5, inset: 1.2, water: -1.2, stand: {55, 8, 0.65}, reach: 1.6,
    wheel: helm_wheel, lever: helm_lever
  }
}

// The sky: the sun and the moon are top of atmosphere values, the engine turns them over the day
// (TimeOfDay on sky; its hour, time_scale and pause are set with the time command). The sun comes
// first so the portals take it as the light that shines through apertures
sun {
  DirectionalLight: {intensity: 3 * PI}
  Rgb: {255, 248, 236}
}

moon {
  DirectionalLight: {intensity: 0.45 * PI}
  Rgb: {190, 210, 255}
}

sky {
  Atmosphere: {
    sun: sun,
    moon: moon,
    units_per_km: 220,
    sea_level: 0,
    ground_altitude: 3.2,
    mie: {scale_height: 1.2, anisotropy: 0.8, scattering_scale: 0.8, tint: {255, 236, 214}},
    ozone_scale: 2,
    night_tint: {64, 88, 190},
    night_intensity: 0.055,
    sun_disk_intensity: 8,
    sun_radius: 1.1,
    moon_radius: 1.6,
    moon_disk_intensity: 24,
    earthshine: 0.05
  }
  TimeOfDay: {
    hour: 9.5,
    day_of_year: 172,
    latitude: 21.4,
    north: 30,
    time_scale: 0.1,
    sun: sun,
    moon: moon
  }
}

sky_cloud_h {
  Gen: {width: 512, height: 512, seed: 23, layers: [{kind: GenNoise, frequency: 7, octaves: 5, gain: 0.5}]}
}

// Three layers drifting with the wind: low scattered clouds, a broken middle deck and thin high ones
cloud_low { CloudLayer: {texture: sky_cloud_h, size: 3000, altitude: 900, threshold: 0.6, softness: 0.08, density: 0.9, velocity: {6, 3}} }
cloud_mid { CloudLayer: {texture: sky_cloud_h, size: 6500, altitude: 1500, threshold: 0.66, softness: 0.12, density: 0.7, offset: {900, 400}, velocity: {9, 4}} }
cloud_high { CloudLayer: {texture: sky_cloud_h, size: 11000, altitude: 2400, threshold: 0.72, softness: 0.16, density: 0.4, offset: {300, 1700}, velocity: {14, 6}} }


// Portal bunker compound, ported from the WebGPU Entities scenario of the same name: the bunker,
// its rooms and their walls, floors, roofs and frames (shell), the brick shed, the quay and the docked
// freighter's props, and the lights, with the rooms,
// openings, occluders and doors as VisArea, VisPortal, VisOccluder and PortalDoor components
// (see include/box/portal.h). Fly with WASD (QE for down/up, Shift to go faster).
include portal_bunker/textures
include portal_bunker/materials
include portal_bunker/models
include portal_bunker/rooms
include portal_bunker/shell
include portal_bunker/props
include portal_bunker/lights

using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers

$ {
  box.app.FpsTarget: {60}
  Scene: {blend_modes: true, fresnel: true}
}

window {
  Surface: {width: 1600, height: 900, vsync: true}
}

camera {
  Position: {0, 1.7, -16}
  Rotation: {-0.0349, 3.1416, 0}
  Camera: {fov: 70}
  CameraController: {speed: 6}
}

sun {
  Rotation: {0.9209, -0.9098, 0}
  DirectionalLight: {intensity: 5}
  Rgb: {255, 228, 194}
}

$ {
  AmbientLight: {sky: {55, 100, 237}, ground: {40, 36, 30}, intensity: 0.5}
}

ground_0 : BunkerMat_grass {
  Position: {30, -0.05, -38}
  Box: {220, 0.1, 64}
}

ground_1 : BunkerMat_grass {
  Position: {-15, -0.05, -2.5}
  Box: {130, 0.1, 7}
}

ground_2 : BunkerMat_grass {
  Position: {100, -0.05, -2.5}
  Box: {80, 0.1, 7}
}

ground_3 : BunkerMat_grass {
  Position: {30, -0.05, 80}
  Box: {220, 0.1, 60}
}

ground_4 : BunkerMat_grass {
  Position: {-15, -0.05, 28.5}
  Box: {130, 0.1, 43}
}

ground_5 : BunkerMat_grass {
  Position: {100, -0.05, 28.5}
  Box: {80, 0.1, 43}
}

ground_6 : BunkerMat_grass {
  Position: {-15, -0.05, 6}
  Box: {130, 0.1, 2}
}

ground_7 : BunkerMat_grass {
  Position: {100, -0.05, 6}
  Box: {80, 0.1, 2}
}

ground_8 : BunkerMat_grass {
  Position: {-47, -0.05, 3}
  Box: {66, 0.1, 4}
}

ground_9 : BunkerMat_grass {
  Position: {22, -0.05, 3}
  Box: {56, 0.1, 4}
}

ground_10 : BunkerMat_grass {
  Position: {100, -0.05, 3}
  Box: {80, 0.1, 4}
}


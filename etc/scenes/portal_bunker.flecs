view {
  exposure { AutoExposure: {} }
  tonemap { Tonemap: {auto_exposure: exposure} }
  smaa { Smaa: {} }
  View: {
    camera: camera,
    clear: {enabled: true, color: {10, 12, 20, 255}},
    lighting: {enabled: true, reflections: true, atmosphere: true,
      environment: {source: sky, intensity: 1, background: false}},
    shadows: {enabled: true},
    effects: [{effect: tonemap}, {effect: smaa}]
  }
}

view {
  exposure { AutoExposure: {} }
  tonemap { Tonemap: {auto_exposure: exposure} }
  smaa { Smaa: {} }
  View: {
    camera: camera,
    clear: {enabled: true, color: {191, 219, 255, 255}},
    shadows: {enabled: true},
    effects: [{effect: tonemap}, {effect: smaa}]
  }
}

      target: aw_music_lp,
      component: box.audio.Filter,
      member: "cutoff",
      length: 384,
      curve: {
        keys: [
          {0, 1700}, {24, 2400}, {32, 3500}, {60, 2300}, {63.8, 900}, {64, 14000}, {120, 11000},
          {127.8, 1300}, {128, 15000}, {158, 7000}, {160, 1000}, {176, 1400}, {208, 1000},
          {224, 1800}, {240, 5500}, {255.8, 700}, {256, 16000}, {310, 14200}, {319.8, 1100},
          {320, 15800}, {352, 5200}, {383, 650}, {384, 550}
        ]
      }
    }
  }


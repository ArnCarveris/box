include aetherwake/clips
using box.audio
using box.audio.synth
using box.material
using assets
// AETHERWAKE: original instrumental, 154 BPM, B minor, 96 bars.
// Intro 0-8 | Groove 8-16 | Drop I 16-32 | Trance 32-40 | Breakdown 40-56 | Build 56-64
// Drop II 64-80 | Trance lift 80-88 | Outro 88-96
box { audio { Song { Rgb: {95, 138, 196} } } }
assets {
  aw_master_eq {
    Equalizer: {
      bands: [
        {kind: EqLowCut, frequency: 27},
        {kind: EqPeak, frequency: 280, gain: -1.6, q: 1.1},
        {kind: EqHighShelf, frequency: 9000, gain: 1.0, q: 0.8}
      ]
    }
  }

  aw_master_glue {
    Compressor: {
      threshold: -16,
      ratio: 2.1,
      attack: 0.020,
      release: 0.2,
      knee: 4,
      makeup: 0.0,
      mix: 0.65
    }
  }

  aw_mix {
    Bus: {output: master, volume: 0.88, kind: ChannelGroup, effects: [aw_master_eq, aw_master_glue]}
    Meter: {}
  }

  aw_reverb_hp { box.audio.Filter: {kind: HighPass, cutoff: 240} }
  aw_echo_hp { box.audio.Filter: {kind: HighPass, cutoff: 315} }
  aw_hall {
    Bus: {output: aw_mix, volume: 0.37, kind: ChannelReturn, effects: [aw_hall, aw_reverb_hp]}
    Reverb: {decay: 3.3, damping: 0.55, predelay: 0.035, size: 0.86, mix: 1}
  }

  aw_delay {
    Bus: {output: aw_mix, volume: 0.34, kind: ChannelReturn, effects: [aw_delay, aw_echo_hp]}
    Delay: {sync: 0.75, feedback: 0.34, mix: 1, ping_pong: true, damping: 4800}
  }

  aw_drums { Bus: {output: aw_mix, volume: 0.80, kind: ChannelGroup}; Meter: {} }
  aw_music_lp { box.audio.Filter: {kind: LowPass, cutoff: 14000, resonance: 0.09} }
  aw_music {
    Bus: {output: aw_mix, volume: 0.78, kind: ChannelGroup, effects: [aw_music_lp]}
    Meter: {}
  }

  aw_kick_eq {
    Equalizer: {
      bands: [
        {kind: EqLowCut, frequency: 26},
        {kind: EqPeak, frequency: 61, gain: 1.2, q: 1.1},
        {kind: EqPeak, frequency: 260, gain: -2, q: 0.85}
      ]
    }
  }

  aw_sub_hp { box.audio.Filter: {kind: HighPass, cutoff: 28} }
  aw_mid_hp { box.audio.Filter: {kind: HighPass, cutoff: 113} }
  aw_mid_lp { box.audio.Filter: {kind: LowPass, cutoff: 2600} }
  aw_stab_hp { box.audio.Filter: {kind: HighPass, cutoff: 190} }
  aw_offbeat_hp { box.audio.Filter: {kind: HighPass, cutoff: 190} }
  aw_saw_hp { box.audio.Filter: {kind: HighPass, cutoff: 190} }
  aw_saw_lp { box.audio.Filter: {kind: LowPass, cutoff: 8000} }
  aw_choir_hp { box.audio.Filter: {kind: HighPass, cutoff: 290} }
  aw_pad_hp { box.audio.Filter: {kind: HighPass, cutoff: 210} }
  aw_chord_chorus {
    Chorus: {voices: 3, rate: 0.18, depth: 3.9, delay: 15, mix: 0.31, spread: 0.86}
  }

  aw_poly_chorus { Chorus: {voices: 3, rate: 0.18, depth: 3.9, delay: 15, mix: 0.31, spread: 0.86} }

  prefab aw_kick_s {
    Sound: {seed: 501}
    aw_low {
      Oscillator: {wave: Sine, frequency: 60, level: 0.8}
      Envelope: {attack: 0.001, decay: 0.30, curve: 5}
      PitchEnvelope: {amount: 43, decay: 0.057, curve: 5}
    }

    aw_click { Oscillator: {wave: Noise, level: 0.16}; Envelope: {attack: 0.001, decay: 0.017} }
  }

  prefab aw_snare_s {
    Sound: {seed: 502}
    Filter: {kind: HighPass, cutoff: 590}
    aw_noise {
      Oscillator: {wave: Noise, color: NoisePink, level: 0.50}
      Envelope: {attack: 0.002, decay: 0.16, curve: 4}
    }

    aw_body {
      Oscillator: {wave: Triangle, frequency: 190, level: 0.18}
      Envelope: {attack: 0.001, decay: 0.11}
    }
  }

  prefab aw_hat_s {
    Sound: {seed: 503}
    Oscillator: {wave: Noise, level: 0.28}
    Envelope: {attack: 0.001, decay: 0.07}
    Filter: {kind: HighPass, cutoff: 6900}
  }

  prefab aw_open_s {
    Sound: {seed: 504}
    Oscillator: {wave: Noise, level: 0.22}
    Envelope: {attack: 0.001, decay: 0.27}
    Filter: {kind: HighPass, cutoff: 6800}
  }

  prefab aw_perc_s {
    Sound: {seed: 505}
    Oscillator: {wave: Noise, level: 0.24}
    Envelope: {attack: 0.001, decay: 0.06}
    Filter: {kind: BandPass, cutoff: 1700, resonance: 0.19}
  }

  prefab aw_sub_s {
    Sound: {seed: 506}
    Oscillator: {wave: Sine, frequency: 440, level: 0.79, sub: 0.2}
    Envelope: {attack: 0.005, decay: 0.16, sustain: 0.76, release: 0.07}
  }

  prefab aw_growl_s {
    Sound: {seed: 507, drift: 2}
    Envelope: {attack: 0.009, decay: 0.28, sustain: 0.45, release: 0.09}
    Drive: {drive: 0.30}
    Filter: {kind: Formant, vowel: 2.2, resonance: 0.37}
    FilterEnvelope: {attack: 0.01, decay: 0.28, sustain: 0.23, vowel: -1.1}
    aw_mid_saw {
      Oscillator: {wave: Saw, frequency: 440, level: 0.38}
      Unison: {voices: 2, detune: 5.0, width: 0.45}
    }
  }

  prefab aw_pad_s {
    Sound: {seed: 508, drift: 4, free_phase: true}
    Envelope: {attack: 0.31, decay: 0.5, sustain: 0.72, release: 1.2}
    Filter: {kind: LowPass, cutoff: 2600}
    aw_pad_wave {
      Oscillator: {wave: Saw, frequency: 440, level: 0.20}
      Unison: {voices: 3, detune: 7, width: 0.86}
    }

    aw_pad_sine { Oscillator: {wave: Sine, frequency: 440, level: 0.17} }
  }

  prefab aw_choir_s {
    Sound: {seed: 509, free_phase: true}
    Envelope: {attack: 0.48, decay: 0.5, sustain: 0.70, release: 1.2}
    Filter: {kind: LowPass, cutoff: 3600}
    aw_choir_wave {
      Oscillator: {wave: Triangle, frequency: 440, level: 0.25}
      Unison: {voices: 3, detune: 5.5, width: 0.9}
    }
  }

  prefab aw_poly_s {
    Sound: {seed: 510, drift: 2}
    Envelope: {attack: 0.008, decay: 0.16, sustain: 0.44, release: 0.20}
    Filter: {kind: LowPass, cutoff: 6500, resonance: 0.12}
    aw_poly_wave {
      Oscillator: {wave: Saw, frequency: 440, level: 0.28}
      Unison: {voices: 5, detune: 9, width: 0.91}
    }

    aw_poly_sine { Oscillator: {wave: Sine, frequency: 440, level: 0.09} }
  }

  prefab aw_saw_s {
    Sound: {seed: 511, drift: 4}
    Envelope: {attack: 0.015, decay: 0.2, sustain: 0.6, release: 0.22}
    Drive: {drive: 0.18}
    aw_saw_wave {
      Oscillator: {wave: Saw, frequency: 440, level: 0.32}
      Unison: {voices: 6, detune: 12.5, width: 0.93}
    }
  }

  prefab aw_offbeat_s {
    Sound: {seed: 512, drift: 2}
    Envelope: {attack: 0.008, decay: 0.19, sustain: 0.14, release: 0.1}
    Filter: {kind: LowPass, cutoff: 3900}
    aw_stab_osc {
      Oscillator: {wave: Saw, frequency: 440, level: 0.29}
      Unison: {voices: 3, detune: 6.0, width: 0.65}
    }
  }

  prefab aw_glass_s {
    Sound: {seed: 513}
    Envelope: {attack: 0.002, decay: 1.8, sustain: 0.0, release: 0.32}
    aw_glass_sin { Oscillator: {wave: Sine, frequency: 440, level: 0.44} }
    aw_glass_tri { Oscillator: {wave: Triangle, frequency: 440, level: 0.16} }
  }

  prefab aw_impact_s {
    Sound: {seed: 514}
    aw_boom {
      Oscillator: {wave: Sine, frequency: 68, level: 0.50}
      Envelope: {attack: 0.001, decay: 1.1}
      PitchEnvelope: {amount: 21, decay: 0.12}
    }

    aw_air {
      Oscillator: {wave: Noise, level: 0.22}
      Envelope: {attack: 0.002, decay: 1.1}
      Filter: {kind: HighPass, cutoff: 1900}
    }
  }

  prefab aw_rise_s {
    Sound: {seed: 515}
    Oscillator: {wave: Noise, color: NoisePink, level: 0.26}
    Envelope: {attack: 1.35, decay: 0.2, sustain: 0, release: 0.15, attack_curve: -1}
    Filter: {kind: HighPass, cutoff: 430}
  }

  aw_kick_inst { Instrument: {sound: aw_kick_s, root: 36, gate: false } }
  aw_snare_inst { Instrument: {sound: aw_snare_s, root: 36, gate: false } }
  aw_hats_inst { Instrument: {sound: aw_hat_s, root: 36, gate: false } }
  aw_open_hat_inst { Instrument: {sound: aw_open_s, root: 36, gate: false } }
  aw_perc_inst { Instrument: {sound: aw_perc_s, root: 36, gate: false } }
  aw_sub_bass_inst { Instrument: {sound: aw_sub_s, root: 69, gate: true } }
  aw_growl_bass_inst { Instrument: {sound: aw_growl_s, root: 69, gate: true } }
  aw_warm_pad_inst { Instrument: {sound: aw_pad_s, root: 69, gate: true } }
  aw_air_choir_inst { Instrument: {sound: aw_choir_s, root: 69, gate: true } }

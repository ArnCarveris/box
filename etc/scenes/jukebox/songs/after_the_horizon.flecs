// AFTER THE HORIZON: arrangement remix, 122 BPM, F# minor, 112 bars, no lead instrument.
// Bars 0-16 intro | 16-32 groove | 32-48 hook | 48-64 breakdown | 64-72 build | 72-84 drop A
// 84-88 break | 88-96 drop B | 96-104 halftime response | 104-112 outro
using box.audio
using box.audio.synth
using box.material
const hzn_tempo = 122
const hzn_bar = 4
box { audio { Song { Rgb: {82, 161, 191} } } }
assets {

  hzn_glue {
    Compressor: {
      threshold: -15.5,
      ratio: 2.0,
      attack: 0.025,
      release: 0.22,
      knee: 5,
      makeup: 0.5,
      mix: 0.76
    }
  }

  hzn_master_shelf {
    Equalizer: {
      bands: [
        {kind: EqLowCut, frequency: 26},
        {kind: EqPeak, frequency: 285, gain: -2.0, q: 1.1},
        {kind: EqHighShelf, frequency: 8200, gain: 1.3, q: 0.707},
        {kind: EqOff, frequency: 16000}
      ]
    }
  }

  hzn_mix {
    Bus: {output: master, volume: 0.84, kind: ChannelGroup, effects: [hzn_master_shelf, hzn_glue]}
    Meter: {}
  }

  hzn_hall_hp { box.audio.Filter: {kind: HighPass, cutoff: 240, resonance: 0.08, slope: Slope24} }
  hzn_echo_hp { box.audio.Filter: {kind: HighPass, cutoff: 275, resonance: 0.06, slope: Slope12} }
  hzn_hall {
    Bus: {output: hzn_mix, volume: 0.66, kind: ChannelReturn, effects: [hzn_hall, hzn_hall_hp]}
    Reverb: {
      decay: 4.1,
      damping: 0.51,
      predelay: 0.045,
      size: 0.91,
      mix: 1,
      shimmer: 0.08,
      shimmer_pitch: 12
    }
  }

  hzn_echo {
    Bus: {output: hzn_mix, volume: 0.52, kind: ChannelReturn, effects: [hzn_echo, hzn_echo_hp]}
    Delay: {sync: 0.75, feedback: 0.43, mix: 1, ping_pong: true, damping: 4900}
  }

  hzn_drum_sculpt { TransientShaper: {attack: 0.24, sustain: -0.12} }
  hzn_drum_sat {
    Saturator: {drive: 0.13, mode: SaturatorTanh, mix: 0.7, low_cut: 35, high_cut: 14500}
  }

  hzn_drum_bus {
    Bus: {
      output: hzn_mix,
      volume: 0.76,
      kind: ChannelGroup,
      effects: [hzn_drum_sculpt, hzn_drum_sat]
    }
    Meter: {}
  }

  hzn_bass_hp { box.audio.Filter: {kind: HighPass, cutoff: 28, resonance: 0.06, slope: Slope24} }
  hzn_bass_eq {
    Equalizer: {
      bands: [
        {kind: EqLowCut, frequency: 27},
        {kind: EqPeak, frequency: 245, gain: -3.3, q: 1.1},
        {kind: EqHighCut, frequency: 900},
        {kind: EqOff, frequency: 16000}
      ]
    }
  }

  hzn_bass_lp { box.audio.Filter: {kind: LowPass, cutoff: 640, resonance: 0.10, slope: Slope24} }
  // Growl occupies the mid-bass above the sub rather than muddying the kick fundamental.
  hzn_growl_hp { box.audio.Filter: {kind: HighPass, cutoff: 118, resonance: 0.10, slope: Slope24} }
  hzn_growl_lp { box.audio.Filter: {kind: LowPass, cutoff: 1900, resonance: 0.29, slope: Slope24} }
  hzn_growl_eq {
    Equalizer: {
      bands: [
        {kind: EqLowCut, frequency: 112},
        {kind: EqPeak, frequency: 280, gain: -2.7, q: 1.15},
        {kind: EqPeak, frequency: 950, gain: 2.0, q: 0.85},
        {kind: EqHighCut, frequency: 6200}
      ]
    }
  }

  hzn_growl_sat {
    Saturator: {
      drive: 0.37,
      asymmetry: 0.13,
      mode: SaturatorTube,
      mix: 0.83,
      low_cut: 110,
      high_cut: 6000
    }
  }

  hzn_growl_gate {
    PatternGate: {
      steps: [0.4, 1, 0.7, 0.95, 0.45, 1, 0.75, 0.35, 0.45, 1, 0.8, 0.95, 0.4, 1, 0.75, 0.55],
      length: 16,
      rate: 0.25,
      swing: 0.04,
      attack: 0.004,
      release: 0.065,
      gate: 0.84,
      floor: -13,
      mix: 0.5
    }
  }

  hzn_pad_hp { box.audio.Filter: {kind: HighPass, cutoff: 175, resonance: 0.07, slope: Slope24} }
  hzn_pad_gate {
    PatternGate: {
      steps: [1, 0.22, 0.7, 0.25, 0.9, 0.28, 0.78, 0.25, 1, 0.22, 0.67, 0.3, 0.9, 0.28, 0.72, 0.4],
      length: 16,
      rate: 0.25,
      attack: 0.009,
      release: 0.105,
      gate: 0.77,
      floor: -17,
      mix: 0
    }
  }

  hzn_kick_eq {
    Equalizer: {
      bands: [
        {kind: EqLowCut, frequency: 27},
        {kind: EqPeak, frequency: 57, gain: 1.4, q: 1.2},
        {kind: EqPeak, frequency: 270, gain: -1.6, q: 1.1},
        {kind: EqHighShelf, frequency: 5500, gain: 0.8, q: 0.707}
      ]
    }
  }

  hzn_pad_lp { box.audio.Filter: {kind: LowPass, cutoff: 2800, resonance: 0.14} }
  hzn_pad_chorus { Chorus: {voices: 3, rate: 0.23, depth: 5, delay: 17, mix: 0.48, spread: 0.85} }
  hzn_arp_filter { box.audio.Filter: {kind: LowPass, cutoff: 4300, resonance: 0.36} }
  hzn_arp_phaser {
    Phaser: {
      stages: 6,
      rate: 0.12,
      depth: 0.6,
      center: 1100,
      feedback: 0.15,
      mix: 0.37,
      stereo: 0.65
    }
  }

  hzn_haze_filter { box.audio.Filter: {kind: HighPass, cutoff: 310, resonance: 0.06} }
  hzn_riser_filter { box.audio.Filter: {kind: HighPass, cutoff: 180, resonance: 0.32} }
  hzn_riser_wobble {
    Modulator: {target: hzn_riser_filter, component: box.audio.Filter, member: "cutoff",
      wave: ModTriangle, scale: ModOctaves, depth: 1, sync: 0.25} }

  // Air-pad tone stays in the upper-midrange, away from kick and bass fundamentals.
  hzn_air_hp { box.audio.Filter: {kind: HighPass, cutoff: 290, resonance: 0.06, slope: Slope12} }
  hzn_air_lp { box.audio.Filter: {kind: LowPass, cutoff: 3850, resonance: 0.08, slope: Slope12} }
  hzn_air_chorus { Chorus: {voices: 2, rate: 0.19, depth: 3.5, delay: 16, mix: 0.35, spread: 0.7} }


  // Collective musical bus filter: DJ-style sweeps apply to chords, pads, and motifs
  // while the kick and sub remain dry, so the drops regain real full-band punch.
  hzn_music_lp { box.audio.Filter: {kind: LowPass, cutoff: 15500, resonance: 0.16, slope: Slope24} }
  hzn_music_bus {
    Bus: {output: hzn_mix, volume: 0.95, kind: ChannelGroup, effects: [hzn_music_lp]}
    Meter: {}
  }

  // An additional filter is automated separately on the new harmonic stabs.
  hzn_stab_hp { box.audio.Filter: {kind: HighPass, cutoff: 250, resonance: 0.08, slope: Slope24} }
  hzn_stab_lp { box.audio.Filter: {kind: LowPass, cutoff: 3400, resonance: 0.28, slope: Slope24} }
  hzn_stab_chorus { Chorus: {voices: 2, rate: 0.17, depth: 2.2, delay: 12, mix: 0.26, spread: 0.6} }
  hzn_choir_hp { box.audio.Filter: {kind: HighPass, cutoff: 280, resonance: 0.05, slope: Slope12} }
  hzn_choir_lp { box.audio.Filter: {kind: LowPass, cutoff: 4500, resonance: 0.14, slope: Slope12} }
  hzn_choir_chorus { Chorus: {voices: 3, rate: 0.14, depth: 5, delay: 23, mix: 0.50, spread: 0.95} }
  hzn_rim_hp { box.audio.Filter: {kind: HighPass, cutoff: 800, resonance: 0.06} }
  hzn_tom_lp { box.audio.Filter: {kind: LowPass, cutoff: 3900, resonance: 0.14} }
  hzn_crash_hp { box.audio.Filter: {kind: HighPass, cutoff: 2200, resonance: 0.06} }

  prefab hzn_kick_sound {
    Sound: {seed: 101}
    hzn_kick_body {
      Oscillator: {wave: Sine, frequency: 56, level: 0.82}
      Envelope: {attack: 0.001, decay: 0.39, curve: 5}
      PitchEnvelope: {amount: 33, decay: 0.055, curve: 5}
    }

    hzn_kick_click {
      Oscillator: {wave: Noise, color: NoiseWhite, level: 0.16}
      Envelope: {attack: 0.0004, decay: 0.009, curve: 4}
    }
  }

  prefab hzn_clap_sound {
    Sound: {seed: 102, level_variance: 0.04}
    Filter: {kind: HighPass, cutoff: 760, slope: Slope12}
    hzn_clap_noise {
      Oscillator: {wave: Noise, color: NoisePink, level: 0.57}
      Envelope: {attack: 0.001, decay: 0.18, curve: 3}
    }

    hzn_clap_body {
      Oscillator: {wave: Triangle, frequency: 185, level: 0.11}

      model: FilterLadder
    }
    FilterEnvelope: {attack: 0.005, decay: 0.24, sustain: 0.08, release: 0.09, amount: 2.3}
  }

  // Formant growl: stereo mid-bass, with shifting vowel and filter articulation.
  prefab hzn_growl_sound {
    Sound: {seed: 112, drift: 3, free_phase: true}
    Envelope: {attack: 0.007, decay: 0.23, sustain: 0.62, release: 0.10, curve: 3}
    Drive: {drive: 0.31, asymmetry: 0.11}
    Filter: {kind: Formant, vowel: 2.6, resonance: 0.40, drive: 0.16}
    FilterEnvelope: {attack: 0.012, decay: 0.27, sustain: 0.27, release: 0.13, vowel: -1.35}
    Lfo: {wave: LfoTriangle, sync: 2, vowel: 1.15, random_phase: false}
    hzn_growl_saw {
      Oscillator: {wave: Saw, frequency: 440, level: 0.38}
      Unison: {voices: 2, detune: 5.5, width: 0.18}
    }

    hzn_growl_square { Oscillator: {wave: Square, frequency: 440, pulse_width: 0.36, level: 0.19} }
  }

  prefab hzn_pad_sound {
    Sound: {seed: 120, drift: 5, free_phase: true}
    Envelope: {attack: 0.45, decay: 0.6, sustain: 0.82, release: 1.35, attack_curve: 0.3}
    Filter: {kind: LowPass, cutoff: 2300, resonance: 0.12, keytrack: 0.18}
    Lfo: {wave: LfoTriangle, sync: 8, cutoff: 0.22, random_phase: true}
    hzn_pad_saw {
      Oscillator: {wave: Saw, frequency: 440, level: 0.155}
      Unison: {voices: 3, detune: 10, width: 0.92}
    }

    hzn_pad_tri { Oscillator: {wave: Triangle, frequency: 220, level: 0.22} }
  }

  // Soft, non-lead chord-bed: slow attack, smooth triangle/sine voices, long release.
  prefab hzn_air_pad_sound {
    Sound: {seed: 122, drift: 3, free_phase: true}

  }

  prefab hzn_bass_sound {
    Sound: {seed: 111, drift: 1}
    Oscillator: {wave: Saw, frequency: 440, level: 0.38, sub: 0.78, sub_octave: 1}
    Envelope: {attack: 0.006, decay: 0.20, sustain: 0.54, release: 0.075, curve: 4}
    Drive: {drive: 0.16, asymmetry: 0.04}
    Filter: {
      kind: LowPass,
      cutoff: 275,
      resonance: 0.15,
      slope: Slope24,
      velocity: 0.5,

using box.audio
using box.audio.synth
using box.material

box { audio { Song { Rgb: {196, 92, 112} } } }
assets {

  og_church {
    Bus: {
      output: master,
      kind: ChannelReturn,
      volume: 0.85 * state.reverb_level / 100,
      effects: [og_church]
    }
    Reverb: {decay: 5.5, damping: 0.55, predelay: 0.05, size: 1}
  }

  og_club {
    Bus: {
      output: master,
      kind: ChannelReturn,
      volume: 0.7 * state.reverb_level / 100,
      effects: [og_club]
    }
    Reverb: {decay: 1.3, damping: 0.6, predelay: 0.015, size: 0.45}
  }

  og_tone {
    Equalizer: {bands: [
      {kind: EqLowCut, frequency: 24},
      {kind: EqPeak, frequency: 250, gain: -1.5, q: 0.8}
    ]}
  }

  og_glue { Compressor: {threshold: -14, ratio: 2, attack: 0.03, release: 0.3, knee: 8} }
  og_organs {
    Bus: {output: master, volume: 0.75, effects: [og_tone, og_glue]}
    Meter: {}
  }

  prefab og_tonewheel_sound {
    Sound: {seed: 201, free_phase: true}
    Envelope: {attack: 0.004, decay: 0.1, sustain: 1, release: 0.04}
    Filter: {kind: LowPass, cutoff: 7000}
    sub { Oscillator: {wave: Sine, frequency: 220, level: 0.13} }
    fifth { Oscillator: {wave: Sine, frequency: 660, level: 0.13} }
    unison { Oscillator: {wave: Sine, frequency: 440, level: 0.13} }
    octave { Oscillator: {wave: Sine, frequency: 880, level: 0.13} }
    bright { Oscillator: {wave: Sine, frequency: 1760, level: 0.03} }
    click {
      Oscillator: {wave: Noise, level: 0.05}
      Envelope: {attack: 0.001, decay: 0.012, sustain: 0, release: 0.01, curve: 3}
    }
  }

  prefab og_jazz_sound {
    Sound: {seed: 202, free_phase: true}
    Envelope: {attack: 0.003, decay: 0.1, sustain: 1, release: 0.03}
    Filter: {kind: LowPass, cutoff: 8000}
    sub { Oscillator: {wave: Sine, frequency: 220, level: 0.14} }
    fifth { Oscillator: {wave: Sine, frequency: 660, level: 0.14} }
    unison { Oscillator: {wave: Sine, frequency: 440, level: 0.14} }
    percussion {
      Oscillator: {wave: Sine, frequency: 1320, level: 0.16}
      Envelope: {attack: 0.001, decay: 0.45, sustain: 0, release: 0.05, curve: 3}
    }

    click {
      Oscillator: {wave: Noise, level: 0.07}
      Envelope: {attack: 0.001, decay: 0.01, sustain: 0, release: 0.01, curve: 3}
    }
  }

  prefab og_combo_sound {
    Sound: {seed: 203}
    Envelope: {attack: 0.003, decay: 0.1, sustain: 1, release: 0.03}
    Filter: {kind: LowPass, cutoff: 4200, resonance: 0.1, keytrack: 0.4}
    Lfo: {wave: LfoTriangle, rate: 6.4, pitch: 16}
    reed { Oscillator: {wave: Square, frequency: 440, level: 0.16, pulse_width: 0.32} }
    flute { Oscillator: {wave: Triangle, frequency: 880, level: 0.08} }
    buzz { Oscillator: {wave: Saw, frequency: 1760, level: 0.025} }
  }

  prefab og_flute_sound {
    Sound: {seed: 204, drift: 1.5, free_phase: true}

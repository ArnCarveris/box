    Filter: {kind: LowPass, cutoff: 2600, keytrack: 0.7}
    Lfo: {rate: 5.6, amplitude: 0.12, pitch: 4}
    stopped { Oscillator: {wave: Sine, frequency: 440, level: 0.3} }
    twelfth { Oscillator: {wave: Sine, frequency: 1320, level: 0.025} }
    open { Oscillator: {wave: Sine, frequency: 880, level: 0.1} }
    breath { Oscillator: {wave: Noise, color: NoisePink, level: 0.012} }
    chiff {
      Oscillator: {wave: Noise, level: 0.08}

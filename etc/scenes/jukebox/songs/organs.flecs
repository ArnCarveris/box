  og_tonewheel { Instrument: {sound: og_tonewheel_sound, velocity_curve: 1} }
  og_jazz { Instrument: {sound: og_jazz_sound, velocity_curve: 1.5} }
  og_combo { Instrument: {sound: og_combo_sound, velocity_curve: 1} }
  og_flute { Instrument: {sound: og_flute_sound, velocity_curve: 1} }

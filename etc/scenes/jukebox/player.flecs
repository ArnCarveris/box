using flecs.script
using flecs.script.math
using box.audio
using box.input
using box.material

jukebox_actions {
  previous { Action: {description: "Play the previous song"}; Binding: {key: Left} }
  next { Action: {description: "Play the next song"}; Binding: {key: Right} }
  play { Action: {description: "Play or pause"}; Binding: {key: Space} }
  crash { Action: {description: "Crash on the next bar"}; Binding: {key: C} }
  pick_1 { Action: {description: "Play song 1"}; Binding: {key: Num1} }
  pick_2 { Action: {description: "Play song 2"}; Binding: {key: Num2} }
  pick_3 { Action: {description: "Play song 3"}; Binding: {key: Num3} }
  pick_4 { Action: {description: "Play song 4"}; Binding: {key: Num4} }
  pick_5 { Action: {description: "Play song 5"}; Binding: {key: Num5} }
  pick_6 { Action: {description: "Play song 6"}; Binding: {key: Num6} }
  pick_7 { Action: {description: "Play song 7"}; Binding: {key: Num7} }
  pick_8 { Action: {description: "Play song 8"}; Binding: {key: Num8} }
  pick_9 { Action: {description: "Play song 9"}; Binding: {key: Num9} }
}

const PICKS = [
  jukebox_actions.pick_1, jukebox_actions.pick_2, jukebox_actions.pick_3,
  jukebox_actions.pick_4, jukebox_actions.pick_5, jukebox_actions.pick_6,
  jukebox_actions.pick_7, jukebox_actions.pick_8, jukebox_actions.pick_9
]

prefab jb_crash {
  AudioOutput: {bus: sfx}
  SynthSound: {seed: 43, level_variance: 0.05}
  SynthEnvelope: {attack: 0.001, decay: 2.2, curve: 5}
  SynthFilter: {kind: SynthHighPass, cutoff: 2600, resonance: 0.1}
  wash { SynthOscillator: {wave: SynthNoise, level: 0.45} }
  bell {
    SynthOscillator: {frequency: 3170, level: 0.08, feedback: 0.9}
    SynthEnvelope: {attack: 0.001, decay: 1.2, curve: 5}
    shimmer { SynthOscillator: {frequency: 4470, modulation: SynthRing, index: 1} }
  }
}

low_pass_filter {
  AudioFilter: {kind: SynthLowPass, cutoff: low_pass_cutoff, slope: SynthSlope24}
}

high_pass_filter {
  AudioFilter: {kind: SynthHighPass, cutoff: high_pass_cutoff, slope: SynthSlope24}
}

box {
  audio {
    master {
      AudioBus: {effects: [high_pass_filter, low_pass_filter]}
      AudioMeter: {}
    }
  }
}

$ {
  AudioSong: {file: "etc/scenes/jukebox/songs/{SONGS[song]}.flecs"}
  Transport = {playing: playing}
}

// Play song n, or pause it when it is the one that plays
proc pick(n: i32) {
  if n >= 0 && n < SONGS.count() {
    if playing && song == n {
      playing = false
    } else {
      song = n
      playing = true
    }
  }
}

// Play the song that is by songs away from the current one, wrapping around the list
proc skip(by: i32) {
  const count = SONGS.count()
  song = (song + by + count) % count
  playing = true
}

template SongPicker {
  prop index: i32 = 0
  prop action: entity = 0

  async {
    while true {
      await on.pressed(action)
      pick(index)
    }
  }
}

jukebox_pickers {
  for i in 0..9 {
    "pick_{i}" { SongPicker: {index: i, action: PICKS[i]} }
  }
}

async {
  while true {
    await on.pressed(jukebox_actions.play)
    playing = !playing
  }
}

async {
  while true {
    await on.pressed(jukebox_actions.previous)
    skip(-1)
  }
}

async {
  while true {
    await on.pressed(jukebox_actions.next)
    skip(1)
  }
}

async {
  while true {
    await on.pressed(jukebox_actions.crash)
    const c = box.audio.play_quantized(jb_crash, 0.7, Bar)
  }
}

// Follow the song that plays: its position, length, colour and the levels of its lanes
async {
  while true {
    const t = Transport[Transport]
    const s = Song[Song]
    const se: entity = Song
    const status = AudioSongStatus[AudioSongStatus]
    const b = t.position
    beat = b
    song_beats = max(s.beats, 1)

    const ready = status.state == SongReady
    if loaded != ready {
      loaded = ready
    }

    const shows = playing && ready && se.has(Rgb)
    if lit != shows {
      lit = shows
    }

    if shows {
      const c = se[Rgb]
      if song_r != c.r || song_g != c.g || song_b != c.b {
        song_r = c.r
        song_g = c.g
        song_b = c.b
      }
    } else if song_r != 150 || song_g != 155 || song_b != 175 {
      song_r = 150
      song_g = 155
      song_b = 175
    }

    const lanes = s.lanes.count()
    for i in 0..LANE_MAX {
      if i < lanes {
        const e = s.lanes[i].bus
        if e.has(AudioMeter) {
          const m = e[AudioMeter]
          const rms = max(max(m.rms_left, m.rms_right), 0.00001)
          levels[i] = clamp((20 * log10(rms) + 48) / 48, 0, 1)
        } else {
          levels[i] = 0
        }
      } else {
        levels[i] = 0
      }
    }

    const mm = box.audio.master[AudioMeter]
    master_level[0] = clamp((20 * log10(max(mm.rms_left, 0.00001)) + 48) / 48, 0, 1)
    master_level[1] = clamp((20 * log10(max(mm.rms_right, 0.00001)) + 48) / 48, 0, 1)
    glow = clamp((20 * log10(max(max(mm.peak_left, mm.peak_right), 0.00001)) + 30) / 30, 0, 1)

    const open = 300 * pow(2, 5 * clamp(b / 16, 0, 1))
    if abs(open - sweep) > sweep * 0.01 {
      sweep = open
    }

    await next_frame()
  }
}

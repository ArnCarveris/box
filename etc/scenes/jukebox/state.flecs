// The songs of the jukebox, each a file songs/{name}.flecs that sets Song and its Rgb. Adding a
// song is adding its file and its name here.
export const SONGS: string[] = ["distant_orbit", "neon_run", "harbor_lights", "lantern_waltz", "trade_lane_dawn"]

// Lanes the HUD meters at most
export const LANE_MAX: i32 = 8

export mut song: i32 = 0
export mut playing = false
export mut low_pass_cutoff: f32 = 20000
export mut high_pass_cutoff: f32 = 20
export mut reverb_level: f32 = 100
export mut sweep: f32 = 300
export mut beat: f32 = 0
export mut song_beats: f32 = 1
export mut loaded = false
export mut lit = false
export mut song_r: f32 = 150
export mut song_g: f32 = 155
export mut song_b: f32 = 175
export mut levels: f32[8] = {}
export mut master_level: f32[2] = {}
export mut glow: f32 = 0

using flecs.script
using flecs.script.math
using box.view
using box.effects
using box.light
using box.world
using state

fn grass_daylight(hour: f64) -> f64 {
  const d = 23.44 * sin((DAY_OF_YEAR - 80) * 2 * PI / 365) * PI / 180
  const l = LATITUDE * PI / 180
  const h = (hour - 12) * PI / 12
  const e = asin(sin(l) * sin(d) + cos(l) * cos(d) * cos(h)) * 180 / PI
  const t = clamp((e + 6) / 9, 0, 1)
  t * t * (3 - 2 * t)
}

view {
  occlusion { Gtao: {radius: 0.7, final_value_power: 1.8, quality: GtaoHigh} }
  bloom { Bloom: {intensity: 0.12, threshold: 1.2, threshold_softness: 0.5} }
  exposure {
    AutoExposure: {
      min_log_luma: -10.8,
      low_percentile: 0.1,
      high_percentile: 0.65,
      exposure_compensation: 0.2 - 2.5 * (1 - grass_daylight(hour)),
      min_exposure: 1.5 * (1 - grass_daylight(hour)),
      max_exposure: 20
    }
  }

  film { Tonemap: {auto_exposure: exposure, operator_: TonyMcMapface} }
  grade {
    ColorGrading: {temperature: 0.04, tint: 0, contrast: 1.06, saturation: 1.08, vibrance: 0.14}
  }

  vignette { Vignette: {intensity: 0.2, radius: 0.8, smoothness: 0.5} }
  edges { Smaa: {} }

  View: {
    camera: player,
    clear: {enabled: true, color: {120, 140, 160, 255}},
    lighting: {
      enabled: true,
      baked: false,
      atmosphere: true,
      environment: {source: sky, intensity: 1, background: false}
    },
    shadows: {
      enabled: true,
      cascades: 2,
      resolution: 1536,
      interval: [1, 2],
      max_distance: 120,
      split_lambda: 0.85,
      filter_size: 5,
      fade: 0.2,
      blend: 0.15,
      min_caster_texels: 12
    },
    effects: [
      {effect: occlusion},
      {effect: sky},
      {effect: bloom},
      {effect: film},
      {effect: grade},
      {effect: vignette},
      {effect: edges}
    ]
  }
}

$ {
  WorldOrigin: {enabled: true}
}

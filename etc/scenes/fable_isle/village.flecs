  template IsleVillager {
    prop look: i32 = 0
    const cloth = match look % 4 {
      0: IsleClothRed
      1: IsleClothBlue
      2: IsleClothYellow
      _: IsleClothWhite
    }
    body {
      (IsA, $cloth)
      Position: {0, 0.31, 0}
      Frustum: {radius_bottom: 0.2, radius_top: 0.11, length: 0.62, segments: 14, smooth: true}
    }

    arm_l {
      (IsA, $cloth)
      Position: {-0.17, 0.42, 0}
      Rotation: {0, 0, -0.3}
      Capsule: {radius: 0.045, length: 0.2, segments: 8, smooth: true}
      Ignore
    }

    arm_r {
      (IsA, $cloth)
      Position: {0.17, 0.42, 0}
      Rotation: {0, 0, 0.3}
      Capsule: {radius: 0.045, length: 0.2, segments: 8, smooth: true}
      Ignore
    }

    head : IsleVillageSkin {
      Position: {0, 0.75, 0}
      Sphere: {radius: 0.15, segments: 14, smooth: true}
    }

    if look % 3 == 0 {
      brim : IsleRoofThatch {
        Position: {0, 0.84, 0}
        Cylinder: {radius: 0.26, length: 0.03, segments: 14}
        Ignore
      }

      crown : IsleRoofThatch {
        Position: {0, 0.9, 0}
        Cylinder: {radius: 0.13, length: 0.12, segments: 12}
        Ignore
      }
    } else if look % 3 == 1 {
      hat : IslePaintGreen {
        Position: {0, 0.96, 0}
        Cone: {radius: 0.17, length: 0.3, segments: 12, smooth: true}
        Ignore
      }
    } else {
      cap : IsleVillageTimber {
        Position: {0, 0.8, -0.02}
        HemiSphere: {radius: 0.16, segments: 12, smooth: true}
        Ignore
      }
    }
  }


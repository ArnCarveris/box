  template IsleMarketStall {
    prop look: i32 = 0
    const cloth = match look { 0: IsleClothRed; 1: IsleClothBlue; _: IsleClothYellow }
    table : IsleWood { Position: {0, 0.6, 0}; Box: {1.9, 0.08, 0.85} }
    skirt { (IsA, $cloth); Position: {0, 0.36, 0.41}; Box: {1.86, 0.44, 0.03} }

    for i in 0..4 {
      const sx = i % 2 == 0 ? -1 : 1
      const sz = i < 2 ? -1 : 1
      {
        (IsA, IsleWoodDark)
        Position: {sx * 0.9, sz < 0 ? 0.95 : 0.8, sz * 0.38}
        Box: {0.08, sz < 0 ? 1.9 : 1.6, 0.08}
      }
    }

    canopy {
      Position: {0, 1.78, 0.02}
      Rotation: {0.33, 0, 0}
      sheet : IsleClothWhite { Position: {0, 0, 0}; Box: {2.2, 0.04, 1.3} }

      for i in 0..4 {
        { (IsA, $cloth); Position: {-0.825 + i * 0.55, 0.006, 0}; Box: {0.275, 0.04, 1.31}; Ignore }
      }
    }

    crate : IsleWoodDark { Position: {-0.55, 0.72, 0}; Box: {0.6, 0.16, 0.5} }

    for i in 0..6 {
      {
        (IsA, IslePaintRed)

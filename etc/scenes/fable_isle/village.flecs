using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.light
using box.particle
using box.picking
using box.input
using box.spatial
using box.transition
using box.movement
using state

assets {
  prefab IsleVillageSkin { Rgb: {240, 202, 168}; PbrMaterial: {roughness: 0.8} }
  prefab IsleVillageTimber { Rgb: {92, 64, 46}; PbrMaterial: {roughness: 0.85} }
  prefab IsleVillageBarn { Rgb: {164, 58, 46}; PbrMaterial: {roughness: 0.9} }
  prefab IsleVillageWool {
    Rgb: {248, 244, 234}
    PbrMaterial: {roughness: 1}
    Sheen: {color: {255, 255, 255}, roughness: 0.5}
  }

  prefab IsleVillageWater {
    Rgb: {92, 170, 214}
    PbrMaterial: {metallic: 0.2, roughness: 0.08}
    ClearCoat: {strength: 1, roughness: 0.05}
  }

  prefab IsleVillageSail { Rgb: {242, 234, 216}; PbrMaterial: {roughness: 0.95} }
  prefab IsleVillagePumpkin { Rgb: {234, 126, 38}; PbrMaterial: {roughness: 0.6} }
  prefab IsleVillageFur { Rgb: {226, 138, 60}; PbrMaterial: {roughness: 0.9} }
  prefab IsleVillageTerracotta { Rgb: {196, 110, 76}; PbrMaterial: {roughness: 0.8} }

  template IsleGableRoof {
    prop span: f32 = 3
    prop rise: f32 = 1.5
    prop len: f32 = 3
    prop ri: i32 = 1
    prop wi: i32 = 0
    prop ov: f32 = 0.3
    prop timber = false
    prop attic = false

    const roof = match ri { 0: IsleRoofThatch; 1: IsleRoofRed; 2: IsleRoofBlue; _: IsleRoofSlate }
    const wall = match wi {
      0: IslePlaster
      1: IslePlasterWarm
      2: IsleStone
      3: IsleVillageBarn
      _: IsleWood
    }
    const ang: f32 = atan2(rise, span / 2)
    const sl: f32 = sqrt(span * span / 4 + rise * rise) + ov
    const th: f32 = ri == 0 ? 0.26 : 0.13
    const cx: f32 = sl / 2 * cos(ang) + th / 2 * sin(ang)
    const cy: f32 = rise - sl / 2 * sin(ang) + th / 2 * cos(ang)
    const sn: f32 = th / 2 + 0.03

    gable { (IsA, $wall); Position: {0, rise / 2, 0}; TrianglePrism: {span, rise, len} }
    slab_l { (IsA, $roof); Position: {-cx, cy, 0}; Rotation: {0, 0, ang}; Box: {sl, th, len + 0.5} }
    slab_r { (IsA, $roof); Position: {cx, cy, 0}; Rotation: {0, 0, -ang}; Box: {sl, th, len + 0.5} }
    ridge {
      (IsA, $roof)
      Position: {0, rise + th / cos(ang) - 0.07, 0}
      Rotation: {0, 0, 0.7854}
      Box: {0.2, 0.2, len + 0.56}
    }

    if timber {
      king_a : IsleWoodDark {
        Position: {0, rise * 0.45, len / 2 + 0.01}
        Box: {0.1, rise * 0.9, 0.05}
      }

      king_b : IsleWoodDark {
        Position: {0, rise * 0.45, -len / 2 - 0.01}
        Box: {0.1, rise * 0.9, 0.05}
      }

      tie_a : IsleWoodDark { Position: {0, 0.05, len / 2 + 0.01}; Box: {span, 0.12, 0.06} }
      tie_b : IsleWoodDark { Position: {0, 0.05, -len / 2 - 0.01}; Box: {span, 0.12, 0.06} }
    }

    if attic {
      attic_frame : IsleWhite {
        Position: {0, rise * 0.4, len / 2 + 0.02}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: 0.27, length: 0.06, segments: 16}
      }

      attic_pane : IsleWindow {
        Position: {0, rise * 0.4, len / 2 + 0.035}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: 0.2, length: 0.06, segments: 16}
      }
    }

    if season == WINTER {
      snow_l : IsleSnow {
        Position: {
          -cx - sn * sin(ang) + sl * 0.06 * cos(ang),
          cy + sn * cos(ang) + sl * 0.06 * sin(ang),
          0
        }
        Rotation: {0, 0, ang}
        Box: {sl * 0.86, 0.1, len + 0.4}
      }

      snow_r : IsleSnow {
        Position: {
          cx + sn * sin(ang) - sl * 0.06 * cos(ang),
          cy + sn * cos(ang) + sl * 0.06 * sin(ang),
          0
        }
        Rotation: {0, 0, -ang}
        Box: {sl * 0.86, 0.1, len + 0.4}
      }
    }
  }

  template IsleHouseWindow {
    prop w: f32 = 0.5
    prop h: f32 = 0.6
    prop fancy = false
    prop tint: i32 = 0

    frame : IsleWhite { Position: {0, 0, 0.02}; Box: {w + 0.14, h + 0.14, 0.07} }
    pane : IsleWindow { Position: {0, 0, 0.045}; Box: {w, h, 0.04} }
    bar_v : IsleWhite { Position: {0, 0, 0.065}; Box: {0.04, h, 0.02}; Ignore }
    bar_h : IsleWhite { Position: {0, h * 0.12, 0.065}; Box: {w, 0.04, 0.02}; Ignore }

    if fancy {
      const paint = match tint {
        0: IslePaintGreen
        1: IslePaintBlue
        2: IslePaintRed
        _: IslePaintTeal
      }
      shut_l { (IsA, $paint); Position: {-w * 0.5 - 0.2, 0, 0.03}; Box: {0.24, h + 0.12, 0.05} }
      shut_r { (IsA, $paint); Position: {w * 0.5 + 0.2, 0, 0.03}; Box: {0.24, h + 0.12, 0.05} }
      planter : IsleVillageTerracotta {
        Position: {0, -h / 2 - 0.17, 0.13}
        Box: {w + 0.24, 0.15, 0.2}
      }

      greens : IsleLeafDark {
        Position: {0, -h / 2 - 0.07, 0.13}
        Box: {w + 0.18, 0.09, 0.16}
        Ignore
      }

      for i in 0..4 {
        const fx = -w / 2 + (i + 0.5) * w / 4

        if i % 2 == 0 {
          {
            (IsA, IsleClothRed)
            Position: {fx, -h / 2 + 0.01, 0.15}
            IcoSphere: {radius: 0.06, segments: 1}
            Ignore
            NoShadow
          }
        } else {
          {
            (IsA, IsleClothYellow)
            Position: {fx, -h / 2 - 0.01, 0.19}
            IcoSphere: {radius: 0.055, segments: 1}
            Ignore
            NoShadow
          }
        }
      }
    }
  }

  template IsleChimneySmoke {
    prop seed: i32 = 0
    const cold = season == WINTER
    Ignore
    Emitter: {
      max: 160, rate: cold ? 16 : 7, shape: EmitterDisc, radius: 0.07, spread: 10,
      speed: {0.35, 0.7}, lifetime: {3, 5}, size: {0.16, 0.5},
      opacity: {0.06, cold ? 0.24 : 0.14}, color: {168, 168, 174}, seed: seed
    }
    Curves: {
      size: {kind: CurveCatmullRom, keys: [{0, 0.5}, {1, 2.6}]},
      opacity: {keys: [{0, 0}, {0.15, 1}, {0.6, 0.7}, {1, 0}]}
    }
    Forces: {
      gravity: {0, 0.15, 0},
      wind: {wind * 1.6, 0, wind * 0.6},
      drag: 0.4,
      turbulence: 0.25,
      turbulence_scale: 1.5
    }
  }

  template IsleBarrel {
    body : IsleWood {
      Position: {0, 0.3, 0}
      Cylinder: {radius: 0.23, length: 0.6, segments: 14, smooth: true}
    }

    hoop_a : IsleIron {
      Position: {0, 0.14, 0}
      Cylinder: {radius: 0.24, length: 0.05, segments: 14, smooth: true}
      Ignore
    }

    hoop_b : IsleIron {
      Position: {0, 0.46, 0}
      Cylinder: {radius: 0.24, length: 0.05, segments: 14, smooth: true}
      Ignore
    }

    lid : IsleWoodDark {
      Position: {0, 0.6, 0}
      Cylinder: {radius: 0.2, length: 0.02, segments: 14}
      Ignore
    }
  }

  template IsleFence {
    prop n: i32 = 3
    prop span: f32 = 0.9
    const posts = n + 1
    const len: f32 = n * span

    for i in 0..posts {
      { (IsA, IsleWood); Position: {-len / 2 + i * span, 0.33, 0}; Box: {0.09, 0.66, 0.09}; Ignore }
    }

    rail_a : IsleWood { Position: {0, 0.5, 0}; Box: {len, 0.07, 0.04}; Ignore }
    rail_b : IsleWood { Position: {0, 0.26, 0}; Box: {len, 0.07, 0.04}; Ignore }
  }

  template IsleHouseShell {
    prop seed: f32 = 0
    prop style: i32 = 0
    prop look: i32 = 0
    prop smoke = false

    const w: f32 = match style { 0: 3.4; 1: 2.7; 2: 3.6; _: 3.8 }
    const d: f32 = match style { 0: 2.7; 1: 2.7; 2: 2.8; _: 3.2 }
    const wh: f32 = match style { 0: 1.8; 1: 3.4; 2: 2.1; _: 2.2 }
    const rise: f32 = match style { 0: 1.7; 1: 1.8; 2: 1.4; _: 1.8 }
    const fh: f32 = 0.22
    const top: f32 = fh + wh
    const wi = style == 3 ? 2 : look % 3
    const ri = match style * 2 + (look % 2) { 0: 0; 1: 1; 2: 2; 3: 3; 4: 1; 5: 2; _: 3 }
    const wall = match wi { 0: IslePlaster; 1: IslePlasterWarm; _: IsleStone }
    const trim = match look {
      0: IslePaintGreen
      1: IslePaintBlue
      2: IslePaintRed
      _: IslePaintTeal
    }
    const timber = wi != 2
    const jet: f32 = style == 1 ? 0.26 : 0
    const front = style == 1 || style == 3
    const span: f32 = front ? w + jet : d
    const len: f32 = front ? d + jet : w
    const door_x: f32 = match style { 0: 0; 1: -0.62; 2: -1.15; _: 0 }
    const side: f32 = rnd(seed, 3) > 0.5 ? 1 : -1
    const chx: f32 = front ? side * span * 0.24 : side * w * 0.3
    const chz: f32 = front ? -d * 0.2 : -d * 0.16
    const wy: f32 = fh + wh * 0.56
    const fz: f32 = d / 2
    const uz: f32 = (d + jet) / 2
    const ux: f32 = (w + jet) / 2

    base : IsleStone { Position: {0, fh / 2, 0}; Box: {w + 0.16, fh, d + 0.16} }
    walls { (IsA, $wall); Position: {0, fh + wh / 2, 0}; Box: {w, wh, d} }

    if style == 1 {
      upper { (IsA, $wall); Position: {0, fh + wh * 0.76, 0}; Box: {w + jet, wh * 0.48, d + jet} }
      band : IsleWoodDark {
        Position: {0, fh + wh * 0.5, 0}
        Box: {w + jet + 0.08, 0.16, d + jet + 0.08}
      }
    }

    if timber {
      for i in 0..4 {
        const sx = i % 2 == 0 ? -1 : 1
        const sz = i < 2 ? -1 : 1
        { (IsA, IsleWoodDark); Position: {sx * ux, fh + wh / 2, sz * uz}; Box: {0.16, wh, 0.16} }
      }

      plate : IsleWoodDark {
        Position: {0, top - 0.07, 0}
        Box: {w + jet + 0.08, 0.14, d + jet + 0.08}
      }

      if style != 1 {
        rail : IsleWoodDark { Position: {0, fh + wh * 0.3, 0}; Box: {w + 0.06, 0.1, d + 0.06} }
      }
    }

    IsleGableRoof roof(
      span: span,
      rise: rise,
      len: len,
      ri: ri,
      wi: wi,
      timber: timber,
      attic: front
    ) {
      Position: {0, top, 0}
      Rotation: {0, front ? 0 : HALF_PI, 0}
    }

    if style != 3 {
      chimney : IsleStone {
        Position: {chx, top + (rise + 0.4) / 2, chz}
        Box: {0.44, rise + 0.4, 0.44}
      }

      chimney_cap : IsleStone { Position: {chx, top + rise + 0.44, chz}; Box: {0.56, 0.1, 0.56} }
      chimney_pot : IsleVillageTerracotta {
        Position: {chx, top + rise + 0.62, chz}
        Frustum: {radius_bottom: 0.13, radius_top: 0.09, length: 0.28, segments: 10, smooth: true}
      }

      if smoke {
        IsleChimneySmoke puff(seed: seed) { Position: {chx, top + rise + 0.8, chz} }
      }

      door_frame : IsleWoodDark { Position: {door_x, fh + 0.7, fz + 0.02}; Box: {0.88, 1.44, 0.08} }
      door { (IsA, $trim); Position: {door_x, fh + 0.66, fz + 0.05}; Box: {0.7, 1.32, 0.06} }
      door_knob : IsleBrass {
        Position: {door_x + 0.24, fh + 0.66, fz + 0.09}
        Sphere: {radius: 0.045, segments: 10, smooth: true}
        Ignore
      }

      door_lamp : IsleLampGlow {
        Position: {door_x, fh + 1.54, fz + 0.1}
        Box: {0.14, 0.16, 0.12}
        Ignore
      }

      step : IsleStone { Position: {door_x, 0.07, fz + 0.34}; Box: {1.1, 0.14, 0.52} }
    }
  }

  template IsleHouse : IsleHouseShell {
    const w: f32 = match style { 0: 3.4; 1: 2.7; 2: 3.6; _: 3.8 }
    const d: f32 = match style { 0: 2.7; 1: 2.7; 2: 2.8; _: 3.2 }
    const wh: f32 = match style { 0: 1.8; 1: 3.4; 2: 2.1; _: 2.2 }
    const rise: f32 = match style { 0: 1.7; 1: 1.8; 2: 1.4; _: 1.8 }
    const fh: f32 = 0.22
    const top: f32 = fh + wh
    const trim = match look {
      0: IslePaintGreen
      1: IslePaintBlue
      2: IslePaintRed
      _: IslePaintTeal
    }
    const jet: f32 = style == 1 ? 0.26 : 0
    const door_x: f32 = match style { 0: 0; 1: -0.62; 2: -1.15; _: 0 }
    const wy: f32 = fh + wh * 0.56
    const fz: f32 = d / 2
    const uz: f32 = (d + jet) / 2
    const ux: f32 = (w + jet) / 2

    if style == 0 {
      IsleHouseWindow win_a(fancy: true, tint: look) { Position: {-1.04, wy, fz} }
      IsleHouseWindow win_b(fancy: true, tint: look) { Position: {1.04, wy, fz} }
      IsleHouseWindow win_c() { Position: {-0.9, wy, -fz}; Rotation: {0, PI, 0} }
      IsleHouseWindow win_d() { Position: {0.9, wy, -fz}; Rotation: {0, PI, 0} }
      IsleHouseWindow win_e() { Position: {w / 2, wy, 0}; Rotation: {0, HALF_PI, 0} }
      IsleHouseWindow win_f() { Position: {-w / 2, wy, 0}; Rotation: {0, -HALF_PI, 0} }
      bench : IsleWood { Position: {-1.04, 0.3, fz + 0.3}; Box: {0.9, 0.07, 0.3} }
      bench_leg_a : IsleWoodDark { Position: {-1.4, 0.14, fz + 0.3}; Box: {0.07, 0.28, 0.26} }
      bench_leg_b : IsleWoodDark { Position: {-0.68, 0.14, fz + 0.3}; Box: {0.07, 0.28, 0.26} }
    } else if style == 1 {
      IsleHouseWindow win_g(w: 0.6, h: 0.7) { Position: {0.62, fh + 0.95, fz} }
      IsleHouseWindow win_a(fancy: true, tint: look) { Position: {-0.7, fh + wh * 0.76, uz} }
      IsleHouseWindow win_b(fancy: true, tint: look) { Position: {0.7, fh + wh * 0.76, uz} }
      IsleHouseWindow win_c() { Position: {-0.6, fh + wh * 0.76, -uz}; Rotation: {0, PI, 0} }
      IsleHouseWindow win_d() { Position: {0.6, fh + wh * 0.3, -fz}; Rotation: {0, PI, 0} }
      IsleHouseWindow win_e() { Position: {ux, fh + wh * 0.76, 0}; Rotation: {0, HALF_PI, 0} }
      IsleHouseWindow win_f() { Position: {-ux, fh + wh * 0.76, 0}; Rotation: {0, -HALF_PI, 0} }
      IsleBarrel barrel() { Position: {1.2, 0, fz + 0.4} }
    } else if style == 2 {
      IsleHouseWindow win_a(w: 1.5, h: 0.85) { Position: {0.62, fh + 1.0, fz} }
      IsleHouseWindow win_c() { Position: {-0.9, wy, -fz}; Rotation: {0, PI, 0} }
      IsleHouseWindow win_d() { Position: {0.9, wy, -fz}; Rotation: {0, PI, 0} }
      IsleHouseWindow win_e() { Position: {w / 2, wy, 0}; Rotation: {0, HALF_PI, 0} }
      IsleHouseWindow win_f() { Position: {-w / 2, wy, 0}; Rotation: {0, -HALF_PI, 0} }
      awning {
        Position: {0.62, fh + 1.72, fz + 0.46}
        Rotation: {0.42, 0, 0}
        base : IsleClothWhite { Position: {0, 0, 0}; Box: {1.96, 0.04, 1.0} }

        for i in 0..4 {
          {
            (IsA, $trim)
            Position: {-0.735 + i * 0.49, 0.006, 0}
            Box: {0.245, 0.04, 1.01}
            Ignore
          }
        }
      }

      sign_arm : IsleIron {
        Position: {door_x, fh + 1.88, fz + 0.32}
        Box: {0.04, 0.04, 0.64}
        Ignore
      }

      sign { (IsA, $trim); Position: {door_x, fh + 1.66, fz + 0.42}; Box: {0.06, 0.34, 0.46} }
      sign_dot_a : IsleBrass {
        Position: {door_x + 0.035, fh + 1.66, fz + 0.42}
        Sphere: {radius: 0.09, segments: 10, smooth: true}
        Ignore
      }

      sign_dot_b : IsleBrass {
        Position: {door_x - 0.035, fh + 1.66, fz + 0.42}
        Sphere: {radius: 0.09, segments: 10, smooth: true}
        Ignore
      }

      crate_a : IsleWood {
        Position: {0.3, 0.2, fz + 0.36}
        Rotation: {0, 0.2, 0}
        Box: {0.5, 0.4, 0.4}
      }

      crate_b : IsleWoodDark {
        Position: {0.95, 0.16, fz + 0.4}
        Rotation: {0, -0.25, 0}
        Box: {0.42, 0.32, 0.38}
      }

      for i in 0..3 {
        {
          (IsA, IslePaintRed)
          Position: {0.18 + i * 0.13, 0.44, fz + 0.36}
          IcoSphere: {radius: 0.07, segments: 1}
          Ignore
          NoShadow
        }

        {
          (IsA, IslePaintYellow)
          Position: {0.84 + i * 0.12, 0.36, fz + 0.4}
          IcoSphere: {radius: 0.06, segments: 1}
          Ignore
          NoShadow
        }
      }
    } else {
      gate_frame : IsleWoodDark { Position: {0, fh + 0.86, fz + 0.02}; Box: {1.96, 1.76, 0.08} }
      door_l : IsleWood { Position: {-0.45, fh + 0.82, fz + 0.05}; Box: {0.86, 1.62, 0.06} }
      door_r : IsleWood { Position: {0.45, fh + 0.82, fz + 0.05}; Box: {0.86, 1.62, 0.06} }

      for i in 0..4 {
        const sx = i % 2 == 0 ? -1 : 1
        const sy = i < 2 ? 0.36 : 1.3
        {
          (IsA, IsleIron)
          Position: {sx * 0.45, fh + sy, fz + 0.085}
          Box: {0.78, 0.07, 0.02}
          Ignore
        }
      }

      gate_step : IsleStone { Position: {0, 0.05, fz + 0.36}; Box: {2.2, 0.1, 0.56} }
      IsleHouseWindow win_c() { Position: {-0.9, wy, -fz}; Rotation: {0, PI, 0} }
      IsleHouseWindow win_d() { Position: {0.9, wy, -fz}; Rotation: {0, PI, 0} }
      IsleHouseWindow win_f() { Position: {-w / 2, wy, 0}; Rotation: {0, -HALF_PI, 0} }
      IsleHouseWindow win_h(w: 0.4, h: 0.5) { Position: {-1.42, wy, fz} }
      hearth : IsleStone { Position: {w / 2 + 0.42, 0.6, 0.3}; Box: {0.9, 1.2, 1.1} }
      hearth_mouth : IsleBlack { Position: {w / 2 + 0.42, 0.62, 0.86}; Box: {0.6, 0.5, 0.02} }
      fire : IsleFire { Position: {w / 2 + 0.42, 0.5, 0.87}; Box: {0.46, 0.22, 0.03}; NoShadow }
      stack : IsleStone {
        Position: {w / 2 + 0.42, (top + rise + 0.5) / 2, 0.05}
        Box: {0.6, top + rise + 0.5, 0.6}
      }

      stack_cap : IsleStone {
        Position: {w / 2 + 0.42, top + rise + 0.54, 0.05}
        Box: {0.74, 0.1, 0.74}
      }

      stump : IsleBark {
        Position: {w / 2 + 0.3, 0.2, 1.5}
        Cylinder: {radius: 0.2, length: 0.4, segments: 10}
      }

      anvil : IsleIron { Position: {w / 2 + 0.3, 0.5, 1.5}; Box: {0.5, 0.14, 0.2} }
      anvil_foot : IsleIron { Position: {w / 2 + 0.3, 0.42, 1.5}; Box: {0.22, 0.1, 0.16} }
      anvil_horn : IsleIron {
        Position: {w / 2 + 0.62, 0.5, 1.5}
        Rotation: {0, 0, -HALF_PI}
        Cone: {radius: 0.07, length: 0.2, segments: 8}
      }

      IsleBarrel barrel() { Position: {-1.5, 0, fz + 0.36} }
      wheel : IsleWoodDark {
        Position: {1.42, 0.45, fz + 0.1}
        Rotation: {HALF_PI - 0.2, 0, 0}
        Torus: {radius: 0.36, tube: 0.045, segments: 18, rings: 6}
      }

      if smoke {
        IsleChimneySmoke forge_puff(seed: seed) { Position: {w / 2 + 0.42, top + rise + 0.7, 0.05} }
      }
    }
  }

  template IsleHouseSlot {
    prop idx: i32 = 0
    mut shown = false

    const a: f32 = match idx {
      0: 1.8
      1: 2.64
      2: 2.62
      3: 1.72
      4: 3.0
      5: 2.92
      6: 1.42
      7: 1.46
      8: 3.2
      9: 3.38
      10: 1.2
      11: 3.48
      12: 3.76
      _: 3.76
    }
    const inner = match idx { 0, 2, 4, 6, 9, 12: true; _: false }
    const style = match idx {
      0: 2
      1: 1
      2: 0
      3: 0
      4: 1
      5: 3
      6: 0
      7: 1
      8: 0
      9: 2
      10: 0
      11: 1
      12: 0
      _: 3
    }
    const look = match idx {
      0: 0
      1: 0
      2: 1
      3: 0
      4: 1
      5: 2
      6: 2
      7: 3
      8: 3
      9: 1
      10: 1
      11: 2
      12: 0
      _: 3
    }
    const r: f32 = (inner ? 12.0 : 17.8) + (rnd(idx, 1) - 0.5) * 0.4
    const yaw: f32 = (inner ? HALF_PI : -HALF_PI) - a + (rnd(idx, 2) - 0.5) * 0.2
    const s: f32 = shown ? 1 : 0.05

    Position: {px(r, a), 0, pz(r, a)}
    Rotation: {0, yaw, 0}
    Scale: {s, s, s}
    Transition: [
      Scale: {duration: 0.55, timing_function: CubicBezier, bezier: {0.34, 1.56, 0.64, 1}}
    ]

    IsleHouse body(seed: idx, style: style, look: look, smoke: idx % 3 == 0 || style == 3)

    async {
      await delay(0.05)
      shown = true
    }
  }

  template IsleStreetLamp {
    prop lit = false
    foot : IsleStone {
      Position: {0, 0.08, 0}

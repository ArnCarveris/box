  template IsleBellTower {
    mut swing: i32 = 0

    Interactive
    Cursor: {CursorPointer}

    plinth : IsleStone { Position: {0, 0.15, 0}; Box: {2.1, 0.3, 2.1} }
    lower : IsleStone { Position: {0, 1.3, 0}; Box: {1.75, 2.0, 1.75} }
    course : IsleWoodDark { Position: {0, 2.35, 0}; Box: {1.85, 0.12, 1.85} }
    shaft : IslePlaster { Position: {0, 3.55, 0}; Box: {1.55, 2.3, 1.55} }
    cornice : IsleWoodDark { Position: {0, 4.76, 0}; Box: {1.85, 0.14, 1.85} }

    for i in 0..4 {
      const sx = i % 2 == 0 ? -1 : 1
      const sz = i < 2 ? -1 : 1
      { (IsA, IsleWoodDark); Position: {sx * 0.68, 5.38, sz * 0.68}; Box: {0.16, 1.1, 0.16} }
      { (IsA, IsleWoodDark); Position: {sx * 0.775, 3.55, sz * 0.775}; Box: {0.12, 2.3, 0.12} }
    }

    belfry_rail : IsleWoodDark { Position: {0, 5.0, 0}; Box: {1.5, 0.34, 1.5} }
    belfry_top : IsleWoodDark { Position: {0, 5.98, 0}; Box: {1.7, 0.12, 1.7} }
    spire : IsleRoofBlue {
      Position: {0, 6.94, 0}
      Rotation: {0, 0.7854, 0}
      Cone: {radius: 1.4, length: 1.8, segments: 4}
    }

    if season == WINTER {
      spire_snow : IsleSnow {
        Position: {0, 7.2, 0}
        Rotation: {0, 0.7854, 0}
        Cone: {radius: 1.04, length: 1.34, segments: 4}
      }
    }

    finial : IsleBrass { Position: {0, 7.9, 0}; Sphere: {radius: 0.1, segments: 10, smooth: true} }
    vane_rod : IsleIron {
      Position: {0, 8.15, 0}
      Cylinder: {radius: 0.015, length: 0.5, segments: 6}
    }

    vane : IsleBrass { Position: {0.1, 8.3, 0}; Box: {0.4, 0.12, 0.015} }

    yoke {
      Position: {0, 5.82, 0}
      Rotation: {0, 0, swing * 0.55}
      Transition: [Rotation: {duration: 0.38, timing_function: EaseInOut}]
      beam : IsleVillageTimber { Position: {0, 0, 0}; Box: {1.3, 0.1, 0.1} }
      bell : IsleBrass {
        Position: {0, -0.33, 0}
        Frustum: {radius_bottom: 0.36, radius_top: 0.17, length: 0.46, segments: 18, smooth: true}
      }

      crown : IsleBrass {
        Position: {0, -0.1, 0}
        Sphere: {radius: 0.17, segments: 12, smooth: true}
      }

      lip : IsleBrass {
        Position: {0, -0.55, 0}
        Torus: {radius: 0.36, tube: 0.03, segments: 18, rings: 6}
      }

      clapper : IsleIron {
        Position: {0, -0.62, 0}
        Sphere: {radius: 0.07, segments: 8, smooth: true}
      }
    }

    door_arch : IsleStone { Position: {0, 1.05, 0.9}; Box: {1.0, 1.6, 0.1} }
    door : IsleWoodDark { Position: {0, 0.98, 0.93}; Box: {0.74, 1.36, 0.08} }
    door_ring : IsleBrass {
      Position: {0.2, 1.0, 0.98}
      Torus: {radius: 0.06, tube: 0.014, segments: 10, rings: 5}
      Rotation: {HALF_PI, 0, 0}
      Ignore
    }

    step : IsleStone { Position: {0, 0.07, 1.25}; Box: {1.2, 0.14, 0.5} }
    clock_rim : IsleBrass {
      Position: {0, 3.75, 0.78}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: 0.52, length: 0.06, segments: 24}
    }

    clock : IsleWhite {
      Position: {0, 3.75, 0.8}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: 0.45, length: 0.06, segments: 24}
    }

    hand_h : IsleBlack {
      Position: {0.08, 3.84, 0.84}
      Rotation: {0, 0, -0.7}
      Box: {0.04, 0.26, 0.01}
      Ignore
    }

    hand_m : IsleBlack {
      Position: {-0.12, 3.86, 0.84}
      Rotation: {0, 0, 0.85}
      Box: {0.03, 0.36, 0.01}
      Ignore
    }

    slit_l : IsleWindow { Position: {-0.79, 3.4, 0}; Box: {0.04, 0.7, 0.3} }
    slit_r : IsleWindow { Position: {0.79, 3.4, 0}; Box: {0.04, 0.7, 0.3} }
    slit_b : IsleWindow { Position: {0, 3.4, -0.79}; Box: {0.3, 0.7, 0.04} }

    async {
      while true {
        await on.click(this)
        emit Bell()
      }
    }

    async {
      while true {
        await Bell

        for k in 0..4 {
          swing = 1
          await delay(0.4)
          swing = -1
          await delay(0.4)
        }

        swing = 0
      }
    }
  }

  template IsleVillage {
    const sq_r: f32 = 14.0
    const sq_a: f32 = 2.2

    for i in 0..village {
      IsleHouseSlot "house_{i}"(idx: i)
    }

    for i in 0..30 {
      const a = 1.12 + i * 0.094
      {
        (IsA, IsleCobble)
        Position: {px(14.9, a), 0.03, pz(14.9, a)}
        Rotation: {0, -a, 0}
        Box: {1.3, 0.06, 1.5}
        NoShadow
        Ignore
      }
    }

    station_path : IsleCobble {
      Position: {px(18.3, 2.0), 0.03, pz(18.3, 2.0)}
      Rotation: {0, -2.0, 0}
      Box: {5.0, 0.06, 1.2}
      NoShadow
      Ignore
    }

    lake_path : IsleCobble {
      Position: {px(10.6, 2.2), 0.03, pz(10.6, 2.2)}
      Rotation: {0, -2.2, 0}
      Box: {2.6, 0.06, 1.1}
      NoShadow
      Ignore
    }

    for i in 0..8 {
      const a = 1.25 + i * 0.34 + (i > 2 ? 0.2 : 0)
      IsleStreetLamp "lamp_{i}"(lit: i == 1 || i == 2 || i == 3 || i == 5 || i == 7) {
        Position: {px(14.0, a), 0, pz(14.0, a)}
      }
    }

    for i in 0..11 {
      const a = 1.16 + i * 0.26 + (i > 2 ? 0.2 : 0)

      if i != 3 && i != 7 {
        IsleFence "fence_{i}"(n: 4) {
          Position: {px(19.75, a), 0, pz(19.75, a)}
          Rotation: {0, HALF_PI - a, 0}
        }
      }
    }

    square {
      Position: {px(sq_r, sq_a), 0, pz(sq_r, sq_a)}
      Rotation: {0, -sq_a - HALF_PI, 0}

      plaza : IsleCobble {
        Position: {0, 0.04, 0}
        Cylinder: {radius: 2.9, length: 0.08, segments: 40}
        NoShadow
      }

      kerb : IsleStone {
        Position: {0, 0.05, 0}
        Tube: {radius: 3.05, thickness: 0.18, length: 0.12, segments: 40}
      }

      IsleFountain fountain() { Position: {0, 0.06, 0} }
      IsleMarketStall stall_a(look: 0) { Position: {-1.9, 0.08, 0.5}; Rotation: {0, 1.2, 0} }
      IsleMarketStall stall_b(look: 1) { Position: {1.9, 0.08, 0.5}; Rotation: {0, -1.2, 0} }
      IsleNoticeBoard board() { Position: {1.6, 0.08, -2.0}; Rotation: {0, -0.5, 0} }
      IsleBarrel barrel_a() { Position: {-1.5, 0.08, -2.0} }
      IsleBarrel barrel_b() { Position: {-2.0, 0.08, -1.7} }
      crate_a : IsleWood {
        Position: {-1.0, 0.3, -2.3}
        Rotation: {0, 0.3, 0}
        Box: {0.5, 0.44, 0.5}
      }

      crate_b : IsleWoodDark {
        Position: {-1.05, 0.68, -2.28}
        Rotation: {0, -0.2, 0}
        Box: {0.36, 0.32, 0.36}
      }

      IsleBellTower tower() { Position: {0, 0, -3.9} }

      IsleVillager folk_a(look: 0) { Position: {-1.2, 0.08, 1.3}; Rotation: {0, -1.9, 0} }
      IsleVillager folk_b(look: 1) { Position: {1.25, 0.08, 1.2}; Rotation: {0, 1.9, 0} }
      IsleVillager folk_c(look: 2) { Position: {0.5, 0.08, 1.9}; Rotation: {0, 2.8, 0} }
      IsleVillager folk_d(look: 3) { Position: {-0.2, 0.08, 2.1}; Rotation: {0, -2.6, 0} }
      IsleVillager folk_e(look: 4) { Position: {1.3, 0.08, -1.3}; Rotation: {0, 2.4, 0} }
      IsleVillager folk_f(look: 5) { Position: {-0.4, 0.08, -2.2}; Rotation: {0, 3.1, 0} }
      IsleVillager folk_g(look: 6) {
        Position: {-2.4, 0.08, 1.3}
        Rotation: {0, 1.2, 0}
        Scale: {0.7, 0.7, 0.7}
      }

      IsleVillageCat cat(look: 0) { Position: {0.9, 0.54, -0.6}; Rotation: {0, 2.0, 0} }
      IsleVillageCat dog(look: 2) {
        Position: {-0.9, 0.08, 2.2}
        Rotation: {0, 0.6, 0}
        Scale: {1.5, 1.5, 1.5}
      }
    }
  }


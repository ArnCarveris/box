  template IsleField {
    prop wid: f32 = 4
    prop len: f32 = 6
    prop rows: i32 = 7
    prop tall: f32 = 0.4
    const pitch: f32 = wid / rows
    soil : IsleDirt { Position: {0, 0.03, 0}; Box: {wid, 0.08, len}; NoShadow }

    for i in 0..rows {
      {
        (IsA, IsleCrop)
        Position: {-wid / 2 + (i + 0.5) * pitch, 0.07 + tall * 0.4, 0}
        Rotation: {HALF_PI, 0, 0}
        Scale: {1, 1, tall / (pitch * 0.3)}
        Capsule: {radius: pitch * 0.3, length: len - 0.5 - pitch * 0.6, segments: 8, smooth: true}
      }
    }
  }


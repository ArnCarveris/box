using flecs.script
using flecs.script.math
using box.audio
using state

isle_audio {
  hall {
    Bus: {output: master, kind: ChannelReturn, effects: [hall]}
    Reverb: {decay: 2.8, damping: 0.45, predelay: 0.025, size: 0.65}
  }
  music {
    Bus: {output: master, volume: 0.5, sends: [{bus: hall, level: night ? 0.55 : 0.3}]}
  }
  sfx {
    Bus: {output: master, kind: ChannelSfx, volume: 0.65, sends: [{bus: hall, level: 0.3}]}
  }
  air {
    Bus: {output: master, kind: ChannelSfx, volume: 1}
  }

  prefab box_tone {
    SynthSound: {seed: 11, level_variance: 0.06}
    SynthEnvelope: {attack: 0.001, decay: 1.7, curve: 5, key_scale: 0.35}
    body {
      SynthOscillator: {frequency: 440, level: 0.4}
      tine {
        SynthOscillator: {frequency: 1760, modulation: SynthPhase, index: 1.3, velocity: 0.5}
        SynthEnvelope: {attack: 0.001, decay: 0.22, curve: 4}
      }
    }
    ring {
      SynthOscillator: {frequency: 880, level: 0.09}
      SynthEnvelope: {attack: 0.001, decay: 0.8, curve: 5}
    }
    pin {
      SynthOscillator: {wave: SynthNoise, level: 0.025}
      SynthEnvelope: {attack: 0.0005, decay: 0.012}
    }
  }

  prefab low_tone {
    SynthSound: {seed: 12}
    SynthEnvelope: {attack: 0.004, decay: 1.5, curve: 3}
    SynthFilter: {kind: SynthLowPass, cutoff: 1100}
    round { SynthOscillator: {frequency: 440, level: 0.42} }
    wood { SynthOscillator: {wave: SynthTriangle, frequency: 880, level: 0.1} }
  }

  prefab pad_tone {
    SynthSound: {seed: 13, drift: 6}
    SynthEnvelope: {attack: 0.9, decay: 0.6, sustain: 0.8, release: 1.5}
    SynthFilter: {kind: SynthLowPass, cutoff: 1300}
    warm {
      SynthOscillator: {wave: SynthTriangle, frequency: 440, level: 0.16}
      SynthUnison: {voices: 3, detune: 14, width: 0.8}
    }
    glow { SynthOscillator: {frequency: 880, level: 0.03} }
  }

  music_box { Instrument: {sound: box_tone, gate: false, spread: 0.35} }
  low_box { Instrument: {sound: low_tone, gate: false} }
  pad_voice { Instrument: {sound: pad_tone} }

  prefab tune_a {
    NoteClip: {length: 32, notes: [
      {start: 0, duration: 1, pitch: 88, velocity: 0.9}, {start: 1, duration: 0.5, pitch: 91, velocity: 0.72}, {start: 1.5, duration: 0.5, pitch: 88, velocity: 0.58},
      {start: 2, duration: 1, pitch: 84, velocity: 0.72}, {start: 3, duration: 1, pitch: 79, velocity: 0.72}, {start: 4, duration: 1, pitch: 81, velocity: 0.9},
      {start: 5, duration: 0.5, pitch: 84, velocity: 0.72}, {start: 5.5, duration: 0.5, pitch: 88, velocity: 0.58}, {start: 6, duration: 1.5, pitch: 86, velocity: 0.72},
      {start: 7.5, duration: 0.5, pitch: 84, velocity: 0.58}, {start: 8, duration: 1, pitch: 81, velocity: 0.9}, {start: 9, duration: 0.5, pitch: 84, velocity: 0.72},
      {start: 9.5, duration: 0.5, pitch: 89, velocity: 0.58}, {start: 10, duration: 1, pitch: 88, velocity: 0.72}, {start: 11, duration: 1, pitch: 84, velocity: 0.72},
      {start: 12, duration: 2, pitch: 86, velocity: 0.9}, {start: 14, duration: 0.5, pitch: 83, velocity: 0.72}, {start: 14.5, duration: 0.5, pitch: 86, velocity: 0.58},
      {start: 15, duration: 1, pitch: 91, velocity: 0.72}, {start: 16, duration: 1, pitch: 88, velocity: 0.9}, {start: 17, duration: 0.5, pitch: 91, velocity: 0.72},
      {start: 17.5, duration: 0.5, pitch: 88, velocity: 0.58}, {start: 18, duration: 1, pitch: 84, velocity: 0.72}, {start: 19, duration: 1, pitch: 79, velocity: 0.72},
      {start: 20, duration: 1, pitch: 81, velocity: 0.9}, {start: 21, duration: 0.5, pitch: 84, velocity: 0.72}, {start: 21.5, duration: 0.5, pitch: 88, velocity: 0.58},
      {start: 22, duration: 1, pitch: 93, velocity: 0.72}, {start: 23, duration: 1, pitch: 91, velocity: 0.72}, {start: 24, duration: 0.5, pitch: 89, velocity: 0.9},
      {start: 24.5, duration: 0.5, pitch: 88, velocity: 0.58}, {start: 25, duration: 1, pitch: 86, velocity: 0.72}, {start: 26, duration: 0.5, pitch: 86, velocity: 0.72},
      {start: 26.5, duration: 0.5, pitch: 84, velocity: 0.58}, {start: 27, duration: 1, pitch: 83, velocity: 0.72}, {start: 28, duration: 1, pitch: 84, velocity: 0.9},
      {start: 29, duration: 1, pitch: 79, velocity: 0.72}, {start: 30, duration: 1, pitch: 76, velocity: 0.72}, {start: 31, duration: 1, pitch: 79, velocity: 0.72}
    ]}
  }

  prefab tune_b {
    NoteClip: {length: 32, notes: [
      {start: 0, duration: 1, pitch: 84, velocity: 0.9}, {start: 1, duration: 0.5, pitch: 81, velocity: 0.72}, {start: 1.5, duration: 0.5, pitch: 84, velocity: 0.58},
      {start: 2, duration: 2, pitch: 89, velocity: 0.72}, {start: 4, duration: 1, pitch: 86, velocity: 0.9}, {start: 5, duration: 0.5, pitch: 83, velocity: 0.72},
      {start: 5.5, duration: 0.5, pitch: 86, velocity: 0.58}, {start: 6, duration: 2, pitch: 91, velocity: 0.72}, {start: 8, duration: 1, pitch: 91, velocity: 0.9},
      {start: 9, duration: 0.5, pitch: 88, velocity: 0.72}, {start: 9.5, duration: 0.5, pitch: 83, velocity: 0.58}, {start: 10, duration: 2, pitch: 88, velocity: 0.72},
      {start: 12, duration: 1, pitch: 88, velocity: 0.9}, {start: 13, duration: 0.5, pitch: 84, velocity: 0.72}, {start: 13.5, duration: 0.5, pitch: 81, velocity: 0.58},
      {start: 14, duration: 2, pitch: 84, velocity: 0.72}, {start: 16, duration: 0.5, pitch: 81, velocity: 0.9}, {start: 16.5, duration: 0.5, pitch: 84, velocity: 0.58},
      {start: 17, duration: 1, pitch: 89, velocity: 0.72}, {start: 18, duration: 0.5, pitch: 88, velocity: 0.72}, {start: 18.5, duration: 0.5, pitch: 89, velocity: 0.58},
      {start: 19, duration: 1, pitch: 93, velocity: 0.72}, {start: 20, duration: 1.5, pitch: 91, velocity: 0.9}, {start: 21.5, duration: 0.5, pitch: 89, velocity: 0.58},
      {start: 22, duration: 1, pitch: 86, velocity: 0.72}, {start: 23, duration: 1, pitch: 83, velocity: 0.72}, {start: 24, duration: 1, pitch: 84, velocity: 0.9},
      {start: 25, duration: 0.5, pitch: 88, velocity: 0.72}, {start: 25.5, duration: 0.5, pitch: 91, velocity: 0.58}, {start: 26, duration: 2, pitch: 96, velocity: 0.72},
      {start: 28, duration: 0.5, pitch: 91, velocity: 0.9}, {start: 28.5, duration: 0.5, pitch: 88, velocity: 0.58}, {start: 29, duration: 1, pitch: 84, velocity: 0.72},
      {start: 30, duration: 1, pitch: 79, velocity: 0.72}, {start: 31, duration: 1, pitch: 76, velocity: 0.72}
    ]}
  }

  prefab hush_a {
    NoteClip: {length: 32, notes: [
      {start: 0, duration: 2, pitch: 88, velocity: 0.8}, {start: 2, duration: 2, pitch: 84, velocity: 0.6}, {start: 4, duration: 2, pitch: 81, velocity: 0.8},
      {start: 6, duration: 2, pitch: 86, velocity: 0.6}, {start: 8, duration: 2, pitch: 81, velocity: 0.8}, {start: 10, duration: 2, pitch: 88, velocity: 0.6},
      {start: 12, duration: 2, pitch: 86, velocity: 0.8}, {start: 14, duration: 2, pitch: 83, velocity: 0.6}, {start: 16, duration: 2, pitch: 88, velocity: 0.8},
      {start: 18, duration: 2, pitch: 84, velocity: 0.6}, {start: 20, duration: 2, pitch: 81, velocity: 0.8}, {start: 22, duration: 2, pitch: 93, velocity: 0.6},
      {start: 24, duration: 2, pitch: 89, velocity: 0.8}, {start: 26, duration: 2, pitch: 86, velocity: 0.6}, {start: 28, duration: 2, pitch: 84, velocity: 0.8},
      {start: 30, duration: 2, pitch: 76, velocity: 0.6}
    ]}
  }

  prefab hush_b {
    NoteClip: {length: 32, notes: [
      {start: 0, duration: 2, pitch: 84, velocity: 0.8}, {start: 2, duration: 2, pitch: 89, velocity: 0.6}, {start: 4, duration: 2, pitch: 86, velocity: 0.8},
      {start: 6, duration: 2, pitch: 91, velocity: 0.6}, {start: 8, duration: 2, pitch: 91, velocity: 0.8}, {start: 10, duration: 2, pitch: 88, velocity: 0.6},
      {start: 12, duration: 2, pitch: 88, velocity: 0.8}, {start: 14, duration: 2, pitch: 84, velocity: 0.6}, {start: 16, duration: 2, pitch: 81, velocity: 0.8},
      {start: 18, duration: 2, pitch: 88, velocity: 0.6}, {start: 20, duration: 2, pitch: 91, velocity: 0.8}, {start: 22, duration: 2, pitch: 86, velocity: 0.6},
      {start: 24, duration: 2, pitch: 84, velocity: 0.8}, {start: 26, duration: 2, pitch: 96, velocity: 0.6}, {start: 28, duration: 2, pitch: 91, velocity: 0.8},
      {start: 30, duration: 2, pitch: 79, velocity: 0.6}
    ]}
  }

  prefab low_a {
    NoteClip: {length: 32, notes: [
      {start: 0, duration: 2, pitch: 48, velocity: 0.8}, {start: 2, duration: 1, pitch: 55, velocity: 0.55}, {start: 3, duration: 1, pitch: 60, velocity: 0.5},
      {start: 4, duration: 2, pitch: 45, velocity: 0.8}, {start: 6, duration: 1, pitch: 52, velocity: 0.55}, {start: 7, duration: 1, pitch: 57, velocity: 0.5},
      {start: 8, duration: 2, pitch: 41, velocity: 0.8}, {start: 10, duration: 1, pitch: 48, velocity: 0.55}, {start: 11, duration: 1, pitch: 53, velocity: 0.5},
      {start: 12, duration: 2, pitch: 43, velocity: 0.8}, {start: 14, duration: 1, pitch: 50, velocity: 0.55}, {start: 15, duration: 1, pitch: 55, velocity: 0.5},
      {start: 16, duration: 2, pitch: 48, velocity: 0.8}, {start: 18, duration: 1, pitch: 55, velocity: 0.55}, {start: 19, duration: 1, pitch: 60, velocity: 0.5},
      {start: 20, duration: 2, pitch: 45, velocity: 0.8}, {start: 22, duration: 1, pitch: 52, velocity: 0.55}, {start: 23, duration: 1, pitch: 57, velocity: 0.5},
      {start: 24, duration: 2, pitch: 41, velocity: 0.8}, {start: 26, duration: 2, pitch: 43, velocity: 0.75}, {start: 28, duration: 2, pitch: 48, velocity: 0.8},
      {start: 30, duration: 1, pitch: 55, velocity: 0.55}, {start: 31, duration: 1, pitch: 60, velocity: 0.5}
    ]}
  }

  prefab low_b {
    NoteClip: {length: 32, notes: [
      {start: 0, duration: 2, pitch: 41, velocity: 0.8}, {start: 2, duration: 1, pitch: 48, velocity: 0.55}, {start: 3, duration: 1, pitch: 53, velocity: 0.5},
      {start: 4, duration: 2, pitch: 43, velocity: 0.8}, {start: 6, duration: 1, pitch: 50, velocity: 0.55}, {start: 7, duration: 1, pitch: 55, velocity: 0.5},
      {start: 8, duration: 2, pitch: 40, velocity: 0.8}, {start: 10, duration: 1, pitch: 47, velocity: 0.55}, {start: 11, duration: 1, pitch: 52, velocity: 0.5},
      {start: 12, duration: 2, pitch: 45, velocity: 0.8}, {start: 14, duration: 1, pitch: 52, velocity: 0.55}, {start: 15, duration: 1, pitch: 57, velocity: 0.5},
      {start: 16, duration: 2, pitch: 41, velocity: 0.8}, {start: 18, duration: 1, pitch: 48, velocity: 0.55}, {start: 19, duration: 1, pitch: 53, velocity: 0.5},
      {start: 20, duration: 2, pitch: 43, velocity: 0.8}, {start: 22, duration: 1, pitch: 50, velocity: 0.55}, {start: 23, duration: 1, pitch: 55, velocity: 0.5},
      {start: 24, duration: 2, pitch: 48, velocity: 0.8}, {start: 26, duration: 1, pitch: 55, velocity: 0.55}, {start: 27, duration: 1, pitch: 60, velocity: 0.5},
      {start: 28, duration: 2, pitch: 48, velocity: 0.8}, {start: 30, duration: 1, pitch: 55, velocity: 0.55}, {start: 31, duration: 1, pitch: 60, velocity: 0.5}
    ]}
  }

  prefab pad_a {
    NoteClip: {length: 32, notes: [
      {start: 0, duration: 4, pitch: 60, velocity: 0.7}, {start: 0, duration: 4, pitch: 64, velocity: 0.7}, {start: 0, duration: 4, pitch: 67, velocity: 0.7},
      {start: 4, duration: 4, pitch: 57, velocity: 0.7}, {start: 4, duration: 4, pitch: 60, velocity: 0.7}, {start: 4, duration: 4, pitch: 64, velocity: 0.7},
      {start: 8, duration: 4, pitch: 57, velocity: 0.7}, {start: 8, duration: 4, pitch: 60, velocity: 0.7}, {start: 8, duration: 4, pitch: 65, velocity: 0.7},
      {start: 12, duration: 4, pitch: 59, velocity: 0.7}, {start: 12, duration: 4, pitch: 62, velocity: 0.7}, {start: 12, duration: 4, pitch: 67, velocity: 0.7},
      {start: 16, duration: 4, pitch: 60, velocity: 0.7}, {start: 16, duration: 4, pitch: 64, velocity: 0.7}, {start: 16, duration: 4, pitch: 67, velocity: 0.7},
      {start: 20, duration: 4, pitch: 57, velocity: 0.7}, {start: 20, duration: 4, pitch: 60, velocity: 0.7}, {start: 20, duration: 4, pitch: 64, velocity: 0.7},
      {start: 24, duration: 2, pitch: 57, velocity: 0.7}, {start: 24, duration: 2, pitch: 60, velocity: 0.7}, {start: 24, duration: 2, pitch: 65, velocity: 0.7},
      {start: 26, duration: 2, pitch: 59, velocity: 0.7}, {start: 26, duration: 2, pitch: 62, velocity: 0.7}, {start: 26, duration: 2, pitch: 67, velocity: 0.7},
      {start: 28, duration: 4, pitch: 60, velocity: 0.7}, {start: 28, duration: 4, pitch: 64, velocity: 0.7}, {start: 28, duration: 4, pitch: 67, velocity: 0.7}
    ]}
  }

  prefab pad_b {
    NoteClip: {length: 32, notes: [
      {start: 0, duration: 4, pitch: 57, velocity: 0.7}, {start: 0, duration: 4, pitch: 60, velocity: 0.7}, {start: 0, duration: 4, pitch: 65, velocity: 0.7},
      {start: 4, duration: 4, pitch: 59, velocity: 0.7}, {start: 4, duration: 4, pitch: 62, velocity: 0.7}, {start: 4, duration: 4, pitch: 67, velocity: 0.7},
      {start: 8, duration: 4, pitch: 59, velocity: 0.7}, {start: 8, duration: 4, pitch: 64, velocity: 0.7}, {start: 8, duration: 4, pitch: 67, velocity: 0.7},
      {start: 12, duration: 4, pitch: 57, velocity: 0.7}, {start: 12, duration: 4, pitch: 60, velocity: 0.7}, {start: 12, duration: 4, pitch: 64, velocity: 0.7},
      {start: 16, duration: 4, pitch: 57, velocity: 0.7}, {start: 16, duration: 4, pitch: 60, velocity: 0.7}, {start: 16, duration: 4, pitch: 65, velocity: 0.7},
      {start: 20, duration: 4, pitch: 59, velocity: 0.7}, {start: 20, duration: 4, pitch: 62, velocity: 0.7}, {start: 20, duration: 4, pitch: 67, velocity: 0.7},
      {start: 24, duration: 4, pitch: 60, velocity: 0.7}, {start: 24, duration: 4, pitch: 64, velocity: 0.7}, {start: 24, duration: 4, pitch: 67, velocity: 0.7},
      {start: 28, duration: 4, pitch: 60, velocity: 0.7}, {start: 28, duration: 4, pitch: 64, velocity: 0.7}, {start: 28, duration: 4, pitch: 67, velocity: 0.7}
    ]}
  }

  lead {
    Track: {instrument: music_box, humanize: {timing: 5, velocity: 0.1}}
    Bus: {output: music, volume: night ? 0 : 1}
    a { ClipPlacement: {clip: tune_a, start: 0} }
    b { ClipPlacement: {clip: tune_b, start: 32} }
  }
  hush {
    Track: {instrument: music_box, humanize: {timing: 8, velocity: 0.1}}
    Bus: {output: music, volume: night ? 0.9 : 0}
    a { ClipPlacement: {clip: hush_a, start: 0, transpose: -12} }
    b { ClipPlacement: {clip: hush_b, start: 32, transpose: -12} }
  }
  low {
    Track: {instrument: low_box}
    Bus: {output: music, volume: night ? 0.55 : 0.85}
    a { ClipPlacement: {clip: low_a, start: 0} }
    b { ClipPlacement: {clip: low_b, start: 32} }
  }
  pad {
    Track: {instrument: pad_voice}
    Bus: {output: music, volume: night ? 1 : 0.8}
    a { ClipPlacement: {clip: pad_a, start: 0} }
    b { ClipPlacement: {clip: pad_b, start: 32} }
  }

  prefab whistle_tone {
    Output: {bus: sfx}
    SynthSound: {seed: 61, drift: 5}
    SynthEnvelope: {attack: 0.05, decay: 0.12, sustain: 0.85, release: 0.24, curve: 2}
    SynthFilter: {kind: SynthLowPass, cutoff: 2600, resonance: 0.1}
    SynthPitchEnvelope: {amount: -1.4, decay: 0.12, release_amount: -2.5}
    low {
      SynthOscillator: {wave: SynthTriangle, frequency: 554, level: 0.3}
      SynthUnison: {voices: 2, detune: 16}
    }
    high { SynthOscillator: {wave: SynthTriangle, frequency: 667, level: 0.26} }
    reed { SynthOscillator: {wave: SynthSquare, frequency: 835, level: 0.045} }
    breath {
      SynthOscillator: {wave: SynthNoise, color: SynthNoisePink, level: 0.2}
      SynthEnvelope: {attack: 0.02, decay: 0.25, sustain: 0.45, release: 0.3}
    }
  }
  whistle { Instrument: {sound: whistle_tone, velocity_curve: 1} }

  prefab bell_strike {
    Output: {bus: sfx}
    SynthSound: {seed: 71, pitch_variance: 0.004}
    SynthEnvelope: {attack: 0.002, decay: 4.5, curve: 4}
    hum {
      SynthOscillator: {frequency: 196, level: 0.2}
      SynthEnvelope: {attack: 0.01, decay: 6, curve: 3}
    }
    prime { SynthOscillator: {frequency: 392, level: 0.28} }
    tierce {
      SynthOscillator: {frequency: 466.6, level: 0.15}
      SynthEnvelope: {attack: 0.002, decay: 3.2, curve: 4}
    }
    quint {
      SynthOscillator: {frequency: 588.5, level: 0.09}
      SynthEnvelope: {attack: 0.002, decay: 2.3, curve: 4}
    }
    nominal {
      SynthOscillator: {frequency: 785, level: 0.2}
      SynthEnvelope: {attack: 0.001, decay: 2.6, curve: 4}
      clang {
        SynthOscillator: {frequency: 2747, modulation: SynthPhase, index: 2.2}
        SynthEnvelope: {attack: 0.001, decay: 0.2, curve: 4}
      }
    }
    upper {
      SynthOscillator: {frequency: 1181, level: 0.07}
      SynthEnvelope: {attack: 0.001, decay: 1.3, curve: 4}
    }
    clap {
      SynthOscillator: {wave: SynthNoise, level: 0.1}
      SynthEnvelope: {attack: 0.0005, decay: 0.03}
    }
  }

  prefab rocket_rise {
    Output: {bus: sfx}
    SynthSound: {seed: 81, pitch_variance: 0.1}
    SynthEnvelope: {attack: 0.5, decay: 0.3, curve: 2}
    SynthFilter: {kind: SynthBandPass, cutoff: 700, resonance: 0.35}
    SynthFilterEnvelope: {attack: 0.8, decay: 0.1, amount: 2.6}
    hiss { SynthOscillator: {wave: SynthNoise, level: 0.3} }
    squeal { SynthOscillator: {frequency: 900, frequency_end: 2600, sweep: 0.8, level: 0.03} }
  }

  prefab rocket_boom {
    Output: {bus: sfx}
    SynthSound: {seed: 82, pitch_variance: 0.18, level_variance: 0.2}
    SynthEnvelope: {attack: 0.001, decay: 0.7, curve: 5}
    SynthFilter: {kind: SynthLowPass, cutoff: 1100}
    thump { SynthOscillator: {frequency: 120, frequency_end: 46, sweep: 0.22, level: 0.4} }
    blast {
      SynthOscillator: {wave: SynthNoise, color: SynthNoiseBrown, level: 0.38}
      SynthEnvelope: {attack: 0.001, decay: 0.4, curve: 4}
    }
  }

  prefab rocket_crackle {
    Output: {bus: sfx}
    SynthSound: {seed: 83, pitch_variance: 0.2, level_variance: 0.25}
    SynthEnvelope: {attack: 0.02, decay: 1.1, curve: 2}
    SynthFilter: {kind: SynthHighPass, cutoff: 3000}
    SynthLfo: {wave: SynthLfoRandom, rate: 38, amplitude: 1, random_phase: true}
    fizz { SynthOscillator: {wave: SynthNoise, level: 0.3} }
  }

  prefab wind_bed {
    SynthSound: {seed: 5}
    SynthEnvelope: {attack: 1.2, sustain: 1, hold: 57.6, release: 1.2}
    SynthFilter: {kind: SynthBandPass, cutoff: 430, resonance: 0.22}
    SynthLfo: {wave: SynthLfoSine, rate: 0.11, cutoff: 0.9, amplitude: 0.35}
    gust { SynthOscillator: {wave: SynthNoise, color: SynthNoisePink, level: 0.5} }
  }

  wind_bed_source {
    Source: {sound: wind_bed, loop: true, volume: 0.03 + 0.3 * wind * wind}
    Output: {bus: air}
  }
}

$ {
  Transport: {tempo: 96, loop: true, loop_start: 0, loop_end: 64, playing: true}
}

async {
  while true {
    await Whistle
    box.audio.play_note(isle_audio.whistle, 69, 0.8, 0.45)
    await delay(0.42)
    box.audio.play_note(isle_audio.whistle, 69, 0.95, 2.1)
  }
}

async {
  while true {
    await Bell
    box.audio.play(isle_audio.bell_strike, 0.9)
  }
}

async {
  while true {
    await Fireworks
    box.audio.play(isle_audio.rocket_rise, 0.7)
    await delay(0.85)
    for i in 0..5 {
      box.audio.play(isle_audio.rocket_boom, 0.9 - i * 0.07)
      await delay(0.09)
      box.audio.play(isle_audio.rocket_crackle, 0.7)
      await delay(0.24 + rnd(i, 7) * 0.3)
    }
  }
}

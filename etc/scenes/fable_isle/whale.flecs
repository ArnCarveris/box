  prefab IsleAirshipNosePath {
    Path2D: {
      start: {0.02, -4.66},
      segments: [{kind: CatmullRom, end: {0.4, -4.56}}, {kind: CatmullRom, end: {0.8, -4.3}}]
    }
  }

  isle_airship_bob {
    box.animation.Clip: {duration: 9}
    y {
      box.animation.Track: {
        component: Position,
        member: "y",
        curve: {kind: CurveCatmullRom, keys: [{0, 0}, {2.25, 0.5}, {4.5, 0}, {6.75, -0.5}, {9, 0}]}
      }
    }

    roll {
      box.animation.Track: {
        component: Rotation,
        member: "z",
        curve: {
          kind: CurveCatmullRom,
          keys: [{0, 0.03}, {2.25, 0}, {4.5, -0.03}, {6.75, 0}, {9, 0.03}]
        }
      }
    }
  }


    }

    stern : IsleCreatureTeak {
      Position: {0, -2.78, 1.0}
      Cylinder: {radius: 0.55, length: 0.8, segments: 16, smooth: true}
    }

    rail_top : IsleBrass { Position: {0, -2.36, -0.3}; Box: {1.18, 0.06, 2.66} }
    rail_bow : IsleBrass {
      Position: {0, -2.36, -1.6}

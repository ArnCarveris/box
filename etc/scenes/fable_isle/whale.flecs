    }

    if night {
      glow {
        Position: {0, -3.9, -1.5}
        PointLight: {intensity: 14, range: 10}
        Rgb: {255, 180, 100}
      }
    }

    pole : IsleBrass {
      NoShadow
      Position: {0, 2.5, 3.9}
      Cylinder: {radius: 0.025, length: 1.0, segments: 5}
    }

    pennant : IsleCreatureCanvasRed {
      NoShadow
      Ignore
      Position: {0, 2.85, 4.3}
      Box: {0.02, 0.26, 0.8}
    }
  }

  template IsleAirship {
    prop radius: f32 = 48
    prop height: f32 = 20
    prop start: f32 = 2.6
    Position: {0, 0, 0}
    Rotation: {0, start, 0}
    pivot {
      Position: {0, height, 0}
      AngularVelocity: {0, -0.04 - wind * 0.03, 0}
      IsleAirshipModel ship() {
        Position: {radius, 0, 0}
        Rotation: {0, 3.14159, 0}
        Animator: {clip: isle_airship_bob}
      }
    }
  }
}

isle_creature_audio {
  deep {
    Bus: {
      output: master,
      kind: ChannelSfx,
      volume: 0.8,
      sends: [{bus: isle_audio.hall, level: 0.9}]
    }
  }

  prefab whale_call {
    Output: {bus: deep}
    Sound: {seed: 91, drift: 9}
    Envelope: {attack: 0.55, decay: 0.5, sustain: 0.8, release: 1.6, curve: 2}
    Filter: {kind: LowPass, cutoff: 1500, resonance: 0.25}
    PitchEnvelope: {amount: -7, decay: 1.3, curve: -2, release_amount: -5}
    Lfo: {wave: LfoSine, rate: 4.2, cutoff: 0.25, amplitude: 0.12}
    moan {
      Oscillator: {frequency: 440, level: 0.34}
      Unison: {voices: 2, detune: 9, width: 0.6}
    }

    throat { Oscillator: {wave: Triangle, frequency: 880, level: 0.1} }
    cry {
      Oscillator: {frequency: 1320, level: 0.035}
      Envelope: {attack: 0.9, decay: 0.8, sustain: 0.5, release: 1.2}
    }

    breath {
      Oscillator: {wave: Noise, color: NoisePink, level: 0.03}
      Envelope: {attack: 0.3, decay: 0.6, sustain: 0.3, release: 0.8}
    }
  }

  whale_voice { Instrument: {sound: whale_call, velocity_curve: 1} }
}

async {
  while true {
    await WhaleSong
    box.audio.play_note(isle_creature_audio.whale_voice, 50, 0.8, 1.9)
    await delay(1.7)
    box.audio.play_note(isle_creature_audio.whale_voice, 57, 0.9, 2.3)
    await delay(2.3)
    box.audio.play_note(isle_creature_audio.whale_voice, 53, 0.7, 3.0)
    await delay(3.2)
  }
}

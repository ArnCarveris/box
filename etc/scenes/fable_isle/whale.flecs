    }

    rail_stern : IsleBrass {
      Position: {0, -2.36, 1.0}
      Cylinder: {radius: 0.59, length: 0.06, segments: 16, smooth: true}
    }

    keel : IsleBrass { Position: {0, -3.2, -0.3}; Box: {0.9, 0.06, 3.4} }

    for i in 0..3 {
      {
        (IsA, IsleWindow)
        NoShadow
        Position: {0.56, -2.68, -1.2 + i * 0.9}
        Box: {0.04, 0.36, 0.5}
      }

      {
        (IsA, IsleWindow)
        NoShadow
        Position: {-0.56, -2.68, -1.2 + i * 0.9}
        Box: {0.04, 0.36, 0.5}
      }
    }

    win_bow : IsleWindow { NoShadow; Position: {0, -2.68, -2.14}; Box: {0.5, 0.32, 0.04} }

    for i in 0..4 {
      const sx = i % 2 == 0 ? 0.42 : -0.42
      const sz = i < 2 ? -1.5 : 0.9
      {
        (IsA, IsleRope)
        NoShadow
        Ignore
        Position: {sx * 1.4, -2.1, sz}
        Rotation: {0, 0, sx * 0.9}
        Cylinder: {radius: 0.035, length: 0.7, segments: 5}
      }
    }

    outrigger : IsleBrass { Position: {0, -2.75, 0.75}; Box: {3.3, 0.07, 0.12} }

    for i in 0..2 {
      const sx = i == 0 ? 1.7 : -1.7
      {
        (IsA, IsleBrass)
        Position: {sx, -2.75, 0.8}
        Rotation: {1.5708, 0, 0}
        Cylinder: {radius: 0.2, length: 0.7, segments: 12, smooth: true}
      }

      "prop_{i}" {
        Position: {sx, -2.75, 1.22}
        AngularVelocity: {0, 0, i == 0 ? 21 : -21}
        hub : IsleBrass { Position: {0, 0, 0}; Sphere: {radius: 0.1, segments: 8, smooth: true} }
        blade_a : IsleCreatureWood {
          NoShadow
          Position: {0, 0, 0}
          Rotation: {0, 0.3, 0}
          Box: {1.5, 0.16, 0.03}
        }

        blade_b : IsleCreatureWood {
          NoShadow
          Position: {0, 0, 0}
          Rotation: {0.3, 0, 0}
          Box: {0.16, 1.5, 0.03}
        }
      }
    }

    chain : IsleRope {
      NoShadow
      Ignore
      Position: {0, -3.42, -1.5}
      Cylinder: {radius: 0.02, length: 0.4, segments: 5}
    }

    lamp_cap : IsleBrass {

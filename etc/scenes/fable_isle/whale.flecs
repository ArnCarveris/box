        Scale: {1, 0.7, 1.1}
        IcoSphere: {radius: 0.3, segments: 1}
      }

      {
        (IsA, IsleCreatureBarnacle)
        Ignore
        Position: {-1.093, 2.408, 2.6}
        Rotation: {12.6, -11.2, 0}
        Scale: {1, 0.7, 1.1}
        IcoSphere: {radius: 0.24, segments: 1}
      }

      {
        (IsA, IsleCreatureBarnacle)
        Ignore
        Position: {3.426, 0.568, -1}
        Rotation: {9, -0.8, 0}
        Scale: {1, 0.7, 1.1}
        IcoSphere: {radius: 0.26, segments: 1}
      }

      {
        (IsA, IsleCreatureBarnacle)
        Ignore
        Position: {-3.31, 0.567, -0.4}
        Rotation: {9.6, -17.2, 0}
        Scale: {1, 0.7, 1.1}
        IcoSphere: {radius: 0.26, segments: 1}
      }

      {
        (IsA, IsleCreatureBarnacle)
        Ignore
        Position: {-2.885, 1.472, -7}
        Rotation: {3, -15, 0}
        Scale: {1, 0.7, 1.1}
        IcoSphere: {radius: 0.2, segments: 1}
      }
    }

    async {
      while true {
        await delay(7 + rnd(seed, 3) * 9)
        spouting = true
        await delay(1.5)
        spouting = false
        await delay(6 + rnd(seed, 5) * 5)
      }
    }

    async {
      while true {
        await on.click(this)
        emit WhaleSong()
      }
    }

    async {
      while true {
        await WhaleSong
        await delay(seed * 0.5)
        spouting = true
        await delay(1.6)
        spouting = false
      }
    }
  }

  template IsleSkyWhale {
    prop radius: f32 = 66
    prop height: f32 = 5
    prop start: f32 = 1.25
    prop calves: i32 = 2
    Position: {0, 0, 0}
    Rotation: {0, start, 0}
    pivot {
      Position: {0, height, 0}
      AngularVelocity: {0, 0.02 + wind * 0.016, 0}
      mother {
        Position: {radius, 0, 0}
        IsleWhale whale() { Position: {0, 0, 0}; Animator: {clip: isle_whale_swim} }
      }

      for i in 0..calves {
        "calf_{i}" {
          Position: {0, 0, 0}
          Rotation: {0, -0.2 - i * 0.14, 0}
          arm {
            Position: {radius + (i == 0 ? -7.5 : 7.0), -4.5 - i * 2.5, 0}
            IsleWhale whale(size: 0.36 - i * 0.07, garden: false, seed: i + 1) {
              Position: {0, 0, 0}
              Animator: {clip: isle_whale_swim, time: 3 + i * 4, speed: 1.4}
            }
          }
        }
      }
    }
  }

  prefab IsleCreatureCanvas {
    Rgb: {240, 226, 194}
    PbrMaterial: {roughness: 0.85}
    Sheen: {color: {255, 240, 210}, roughness: 0.5}
  }

  prefab IsleCreatureTeak {
    Rgb: {176, 122, 70}
    PbrMaterial: {roughness: 0.7}
    ClearCoat: {strength: 0.3, roughness: 0.3}
  }

  prefab IsleCreatureCanvasRed {
    Rgb: {198, 64, 54}
    PbrMaterial: {roughness: 0.85}
    Sheen: {color: {255, 200, 180}, roughness: 0.5}
  }

  prefab IsleAirshipHullPath {
    Path2D: {
      start: {0.02, -4.6},
      segments: [
        {kind: CatmullRom, end: {0.75, -4.3}},
        {kind: CatmullRom, end: {1.5, -3.3}},
        {kind: CatmullRom, end: {1.95, -1.6}},
        {kind: CatmullRom, end: {2.05, 0}},
        {kind: CatmullRom, end: {1.9, 1.6}},
        {kind: CatmullRom, end: {1.45, 3.1}},
        {kind: CatmullRom, end: {0.75, 4.3}},

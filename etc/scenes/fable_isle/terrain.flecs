using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.texture
using box.particle
using box.curve
using box.light
using box.spatial
using state
using assets

assets {
  prefab IsleLakeWater {
    Rgb: {255, 255, 255}
    PbrMaterial: {roughness: 0.05}
    Water: {
      shallow_color: {74, 188, 184},
      deep_color: {22, 74, 112},
      depth: 2.2,
      visibility: 2.6,
      refraction: 0.015,
      foam_width: 0.22,
      ripple_scale: 2.3,
      ripple_velocity: {0.02, 0.013}
    }
    PbrTextures: {normal: isle_wave_n}
    texture.Mapping: {mode: MappingWorld, size: 5}
    texture.Scroll: {velocity: {0.012, 0.02}}
  }

  prefab IsleBrookWater {
    Rgb: {255, 255, 255}
    PbrMaterial: {roughness: 0.05}
    Water: {
      shallow_color: {96, 200, 196},
      deep_color: {40, 120, 150},
      depth: 0.5,
      visibility: 0.5,
      refraction: 0.01,
      foam_width: 0
    }
    PbrTextures: {normal: isle_wave_n}
    texture.Scroll: {velocity: {0.9, 0}}
    texture.Transform: {scale_x: 6, scale_y: 0.6}
  }

  prefab IsleIce {
    Rgb: {206, 232, 246}
    PbrMaterial: {metallic: 0.1, roughness: 0.14}
    ClearCoat: {strength: 0.8, roughness: 0.08}
    PbrTextures: {normal: isle_rock_n}
    texture.Mapping: {mode: MappingWorld, size: 7}
    Sheen: {color: {230, 244, 255}, roughness: 0.3}
  }

  prefab IsleEarth {
    Rgb: {104, 76, 54}
    PbrMaterial: {roughness: 1}
    PbrTextures: {normal: isle_rock_n}
    texture.Mapping: {mode: MappingWorld, size: 5, blend: 0.3}
  }

  prefab IsleFallWater {
    Rgb: {214, 238, 250}
    PbrMaterial: {roughness: 0.2}
    Emissive: {strength: 0.18, color: {200, 230, 255}}
    PbrTextures: {normal: isle_wave_n}
    texture.Transform: {scale_x: 2, scale_y: 5}
    texture.Scroll: {velocity: {0, -1.6}}
  }

  isle_fall_shape { Path2D: {start: {-0.75, 0}, segments: [
    {kind: CubicBezier, end: {0.75, 0}, control1: {-0.75, 0.22}, control2: {0.75, 0.22}}
    {kind: CubicBezier, end: {-0.75, 0}, control1: {0.75, -0.22}, control2: {-0.75, -0.22}}
  ], closed: true} }
  isle_fall_section { Profile2D: {outer: isle_fall_shape} }
  isle_fall_path { Path3D: {start: {-0.6, 0.06, 0}, segments: [
    {kind: CubicBezier, end: {3.4, -27, 0}, control1: {1.8, 0.3, 0}, control2: {2.9, -9, 0}}
  ]} }

  isle_bed_profile { Path2D: {start: {8.8, 0.02}, segments: [
    {kind: CubicBezier, end: {0, -2.6}, control1: {7.2, -0.5}, control2: {4.6, -2.6}}
  ]} }
  isle_top_profile { Path2D: {start: {29.9, -1.3}, segments: [
    {kind: Line, end: {30, -0.7}}
    {kind: CubicBezier, end: {29.3, 0}, control1: {30, -0.25}, control2: {29.8, 0}}
    {kind: Line, end: {8.9, 0}}
    {kind: Line, end: {8.2, -0.1}}
  ]} }
  isle_earth_profile { Path2D: {start: {28.2, -3.6}, segments: [
    {kind: Line, end: {29.5, -2.4}}
    {kind: Line, end: {30.05, -1.1}}
  ]} }
  isle_rock_profile { Path2D: {start: {0, -35}, segments: [
    {kind: Line, end: {4.2, -30.4}}
    {kind: Line, end: {8.6, -27.2}}
    {kind: Line, end: {10.2, -23.4}}
    {kind: Line, end: {15.2, -20.2}}
    {kind: Line, end: {16.2, -16.8}}
    {kind: Line, end: {21.6, -13.6}}
    {kind: Line, end: {22.4, -11.2}}
    {kind: Line, end: {27.2, -8.4}}
    {kind: Line, end: {26.8, -6.6}}
    {kind: Line, end: {29.8, -4.2}}
    {kind: Line, end: {29.2, -2.9}}
  ]} }
  isle_hill_top_profile { Path2D: {start: {6.8, 4.4}, segments: [
    {kind: CatmullRom, end: {6.3, 5.35}}
    {kind: CatmullRom, end: {5.4, 6.4}}
    {kind: CatmullRom, end: {4.2, 6.85}}
    {kind: CatmullRom, end: {2.4, 6.98}}
    {kind: CatmullRom, end: {0, 7.02}}
  ]} }
  isle_hill_cliff_profile { Path2D: {start: {8.4, -0.2}, segments: [
    {kind: Line, end: {7.85, 0.6}}
    {kind: Line, end: {7.7, 1.7}}
    {kind: Line, end: {7.2, 2.9}}
    {kind: Line, end: {7.05, 4.1}}
    {kind: Line, end: {6.15, 5.0}}
  ]} }

  template IsleBoulder {
    prop s: f32 = 1
    prop seed: f32 = 0
    (IsA, IsleRock)
    Rotation: {rnd(seed, 1) * 3, rnd(seed, 2) * 6, rnd(seed, 3) * 3}
    Scale: {
      s * (0.8 + rnd(seed, 4) * 0.5),
      s * (0.55 + rnd(seed, 5) * 0.4),
      s * (0.8 + rnd(seed, 6) * 0.5)
    }
    IcoSphere: {radius: 1, segments: 1}
  }

  template IsleTerrainGround {
    lake_bed : IsleSand {
      Position: {0, 0, 0}
      Lathe: {profile: isle_bed_profile, segments: 64, rings: 12}
    }

    top : IsleGrass {
      Position: {0, 0, 0}
      Lathe: {profile: isle_top_profile, segments: 96, rings: 4}
    }

    earth : IsleEarth {
      Position: {0, 0, 0}
      Lathe: {profile: isle_earth_profile, segments: 48, rings: 3}
    }

    rock : IsleRockDark {
      Position: {0, 0, 0}
      Lathe: {profile: isle_rock_profile, segments: 18, rings: 3}
    }

    if season == WINTER {
      ice : IsleIce { Position: {0, -0.22, 0}; Cylinder: {radius: 8.5, length: 0.06, segments: 64} }

      for i in 0..7 {
        const a = i * GOLDEN + 0.7
        const r = 1.5 + rnd(i, 51) * 5.2
        "drift_{i}" : IsleSnow {
          Position: {r * cos(a), -0.2, r * sin(a)}
          Rotation: {0, rnd(i, 53) * 6, 0}
          Scale: {1.4 + rnd(i, 55) * 1.6, 0.07, 0.8 + rnd(i, 57) * 0.9}
          IcoSphere: {radius: 1, segments: 2, smooth: true}
          Ignore
        }
      }
    } else {
      lake : IsleLakeWater {
        Position: {0, -0.25, 0}
        Cylinder: {radius: 8.45, length: 0.02, segments: 64}
        NoShadow
      }
    }

    hill {
      Position: {px(RAIL_R, HILL_A), 0, pz(RAIL_R, HILL_A)}
      dome : IsleGrass {
        Position: {0, 0, 0}
        Lathe: {profile: isle_hill_top_profile, segments: 48, rings: 8}
      }

      cliff : IsleRock {
        Position: {0, 0, 0}
        Lathe: {profile: isle_hill_cliff_profile, segments: 48, rings: 3}
      }

      for i in 0..14 {
        const a = i * GOLDEN + 0.4
        const r = 7.9 + rnd(i, 3) * 0.9
        const clear = abs(sin(a)) > 0.45 && !(sin(a) > 0.9)

        if clear {
          IsleBoulder "scree_{i}"(s: 0.5 + rnd(i, 9) * 0.7, seed: i + 40) {
            Position: {r * cos(a), 0.2, r * sin(a)}
          }
        }
      }

      stairs {
        Position: {0, 0, 0}

        for s in 0..2 {
          const sx = s == 0 ? -0.7 : 0.7
          "stringer_{s}" : IsleWoodDark {
            Position: {sx, 3.22, 8.75}
            Rotation: {0.876, 0, 0}
            Box: {0.1, 0.26, 8.7}
          }

          "rail_{s}" : IsleWood {
            Position: {sx, 4.2, 8.75}
            Rotation: {0.876, 0, 0}
            Box: {0.07, 0.07, 8.7}
          }

          for k in 0..6 {
            const t = k / 5.0
            "post_{s}_{k}" : IsleWood {
              Position: {sx, 6.6 * t + 0.5, 11.5 - 5.5 * t}
              Box: {0.08, 1.0, 0.08}
            }
          }

          "leg_a_{s}" : IsleWoodDark { Position: {sx, 1.2, 9.6}; Box: {0.14, 2.4, 0.14} }
          "leg_b_{s}" : IsleWoodDark { Position: {sx, 2.3, 8.2}; Box: {0.14, 4.6, 0.14} }
        }

        for i in 0..17 {
          const t = (i + 0.5) / 17
          "step_{i}" : IsleWood {
            Position: {0, 6.6 * t + 0.1, 11.5 - 5.5 * t}
            Box: {1.36, 0.07, 0.4}
            Ignore
          }
        }

        landing : IsleWood { Position: {0, 6.68, 5.5}; Box: {1.7, 0.1, 1.5} }
        foot : IsleCobble { Position: {0, 0.03, 12.4}; Box: {1.8, 0.06, 1.8} }
      }
    }
  }

  template IsleTerrain : IsleTerrainGround {
    brook {
      Position: {px(19.4, BROOK_A), 0, pz(19.4, BROOK_A)}
      Rotation: {0, 0 - BROOK_A, 0}
      bed : IsleCobble { Position: {0, 0.005, 0}; Box: {22, 0.03, 2.1} }
      water : IsleBrookWater {
        Position: {0, 0.045, 0}
        Rotation: {0 - HALF_PI, 0, 0}
        Quad: {22, 1.6}
        NoShadow
      }

      for i in 0..40 {
        const side = i % 2 == 0 ? -1 : 1
        const along = (floor(i / 2) + rnd(i, 7) * 0.8) * 1.1 - 10.8
        const sz = 0.16 + rnd(i, 2) * 0.2
        const on_rail = abs(along + 19.4 - RAIL_R) < 1.9

        if !on_rail {
          IsleBoulder "bank_{i}"(s: sz, seed: i) {
            Position: {along, sz * 0.3, side * (0.95 + rnd(i, 5) * 0.25)}
            Ignore
          }
        }
      }

      mouth_a : IsleRock {
        Position: {-11.2, 0.05, -1.3}
        Scale: {0.9, 0.45, 0.7}
        IcoSphere: {radius: 1, segments: 1}
      }

      mouth_b : IsleRock {
        Position: {-11.3, 0.05, 1.35}
        Scale: {0.7, 0.5, 0.9}
        IcoSphere: {radius: 1, segments: 1}
      }

      lip_a : IsleRock {
        Position: {10.7, -0.1, -1.5}
        Scale: {1.1, 0.7, 0.9}
        IcoSphere: {radius: 1, segments: 1}
      }

      lip_b : IsleRock {
        Position: {10.6, -0.1, 1.5}
        Scale: {1.0, 0.8, 1.0}
        IcoSphere: {radius: 1, segments: 1}
      }
    }

    falls {
      Position: {px(30.25, BROOK_A), 0, pz(30.25, BROOK_A)}
      Rotation: {0, 0 - BROOK_A, 0}
      Ignore
      ribbon : IsleFallWater {
        Position: {0, 0, 0}
        Sweep: {
          path: isle_fall_path,
          profile: isle_fall_section,
          taper: 1.9,
          segments: 6,
          rings: 28
        }
        Opacity: {0.6}
        NoShadow
      }

      sheet {
        Position: {0.1, 0.06, 0}
        Emitter: {
          max: 3000, rate: 700, shape: EmitterBox, extents: {0.05, 0.02, 0.72},
          direction: {1, 0.15, 0}, spread: 5, speed: {1.6, 2.4},
          lifetime: {2.3, 2.9}, size: {0.14, 0.34}, opacity: {0.35, 0.8},
          acceleration: {0, -7.5, 0}, color: {214, 240, 250}, seed: 4
        }
        Appearance: {stretch: 0.06, softness: 0.3, lit: 1}
        Curves: {
          opacity: {keys: [{0, 0}, {0.04, 1}, {0.55, 0.8}, {1, 0}]}
          size: {keys: [{0, 0.8}, {0.5, 1.2}, {1, 4}]}
        }
      }

      mist {
        Position: {2.4, -14, 0}
        Emitter: {
          max: 400, rate: 40, shape: EmitterBox, extents: {1.2, 4, 1.4},
          direction: {0.4, -1, 0}, spread: 40, speed: {0.4, 1.2},
          lifetime: {3, 5}, size: {1.4, 3.2}, opacity: {0.05, 0.14},
          color: {232, 244, 252}, seed: 9
        }
        Appearance: {softness: 1.5, lit: 1}
        Curves: {opacity: {keys: [{0, 0}, {0.3, 1}, {1, 0}]}, size: {keys: [{0, 0.6}, {1, 1.8}]}}
      }
    }

    under {
      for i in 0..34 {
        const a = i * GOLDEN
        const s = 2.4 + rnd(i, 17) * 3.4
        const y = -2.2 - s * 1.9 - rnd(i, 11) * 19
        const r = 30 * (1 - (0 - y - 1) / 34) * (0.78 + rnd(i, 13) * 0.16)
        "chunk_{i}" : IsleRockDark {
          Position: {r * cos(a), y, r * sin(a)}
          Rotation: {rnd(i, 1) * 3, rnd(i, 2) * 6, rnd(i, 3) * 3}
          Scale: {s, s * (1.1 + rnd(i, 19) * 0.8), s}
          IcoSphere: {radius: 1, segments: 1}
        }
      }

      for i in 0..9 {
        const a = i * 0.698 + 0.2
        const r = 27.5 + rnd(i, 23) * 2
        const s = 0.9 + rnd(i, 29) * 1.2
        "tooth_{i}" : IsleRockDark {
          Position: {r * cos(a), -4.5 - rnd(i, 31) * 1.5, r * sin(a)}
          Rotation: {PI, rnd(i, 2) * 6, 0}
          Cone: {radius: s, length: 3 + rnd(i, 37) * 4, segments: 6}
        }
      }

      for i in 0..7 {
        const a = i * 0.9 + 0.5
        const r = 38 + rnd(i, 41) * 9
        const y = -9 - rnd(i, 43) * 16
        const s = 0.6 + rnd(i, 47) * 1.1
        "drift_{i}" : IsleRockDark {
          Position: {r * cos(a), y, r * sin(a)}
          Rotation: {rnd(i, 1) * 3, rnd(i, 2) * 6, rnd(i, 3) * 3}
          Scale: {s, s * 1.4, s}
          IcoSphere: {radius: 1, segments: 1}
        }
      }
    }
  }
}

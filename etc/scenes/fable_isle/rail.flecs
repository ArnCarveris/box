  template IsleRailSignal {
    prop semaphore: bool = false
    const go = train_speed > 0.01

    base : IsleIron { Position: {0, 0.15, 0}; Cylinder: {radius: 0.14, length: 0.3, segments: 10} }
    if semaphore {
      post : IsleWhite { Position: {0, 1.7, 0}; Cylinder: {radius: 0.06, length: 3.2, segments: 8} }
      finial : IslePaintRed { Position: {0, 3.38, 0}; Cone: {radius: 0.09, length: 0.22, segments: 8} }
      arm {
        Position: {0, 3.0, -0.08}
        Rotation: {0, 0, go ? 0.75 : 0}
        blade : IslePaintRed { Position: {0.5, 0, 0}; Box: {1.0, 0.2, 0.04} }
        band : IsleWhite { Position: {0.78, 0, 0}; Box: {0.12, 0.205, 0.05} }
        lens : IsleRailLens { Position: {-0.14, 0, 0}; Box: {0.24, 0.24, 0.05} }
      }
      if go {
        lamp_go : IsleSignalGreen { Position: {-0.16, 2.74, -0.1}; Sphere: {radius: 0.08, segments: 10}; NoShadow }
      } else {
        lamp_stop : IsleSignalRed { Position: {-0.16, 2.74, -0.1}; Sphere: {radius: 0.08, segments: 10}; NoShadow }
      }
    } else {
      post : IsleIron { Position: {0, 1.3, 0}; Cylinder: {radius: 0.05, length: 2.4, segments: 8} }
      head : IsleBlack { Position: {0, 2.7, 0}; Box: {0.34, 0.8, 0.2} }
      hood : IsleBlack { Position: {0, 3.12, 0}; Box: {0.42, 0.05, 0.42} }
      if go {
        lamp_red : IsleRailLens { Position: {0, 2.9, 0}; Sphere: {radius: 0.12, segments: 10}; NoShadow }
        lamp_green : IsleSignalGreen { Position: {0, 2.52, 0}; Sphere: {radius: 0.12, segments: 10}; NoShadow }
      } else {
        lamp_red : IsleSignalRed { Position: {0, 2.9, 0}; Sphere: {radius: 0.12, segments: 10}; NoShadow }
        lamp_green : IsleRailLens { Position: {0, 2.52, 0}; Sphere: {radius: 0.12, segments: 10}; NoShadow }
      }
    }
  }


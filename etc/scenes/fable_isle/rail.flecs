using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.camera
using box.light
using box.movement
using box.particle
using box.picking
using box.input
using box.text
using box.spatial
using state
using assets

assets {
  const RAIL_V: f32 = 8.8
  const RAIL_W: f32 = 0.4
  const RAIL_PI: f32 = 3.14159265

  prefab IsleRailBallast { Rgb: {146, 136, 124}; PbrMaterial: {roughness: 1} }
  prefab IsleRailBallastLow { Rgb: {122, 112, 100}; PbrMaterial: {roughness: 1} }
  prefab IsleRailSleeper { Rgb: {84, 60, 44}; PbrMaterial: {roughness: 0.9} }
  prefab IsleRailCoal { Rgb: {16, 16, 19}; PbrMaterial: {roughness: 0.3} }
  prefab IsleRailDark { Rgb: {3, 3, 5}; PbrMaterial: {roughness: 1} }
  prefab IsleRailRoof { Rgb: {74, 78, 88}; PbrMaterial: {roughness: 0.55} }
  prefab IsleRailGirder { Rgb: {150, 56, 42}; PbrMaterial: {metallic: 0.3, roughness: 0.5} }
  prefab IsleRailPlank { Rgb: {150, 108, 70}; PbrMaterial: {roughness: 0.85} }
  prefab IsleRailLens { Rgb: {30, 30, 34}; PbrMaterial: {roughness: 0.2} }
  prefab IsleRailBright { Rgb: {206, 210, 218}; PbrMaterial: {metallic: 0.45, roughness: 0.32} }
  prefab IsleRailFire { Rgb: {255, 150, 60}; Emissive: {strength: night ? 9 : 2.5, color: {255, 120, 40}} }

  template IsleRailWheel {
    prop r: f32 = 0.26
    prop n: i32 = 2
    prop side: f32 = 1

    AngularVelocity: {train_speed * RAIL_V / r, 0, 0}
    tyre : IsleSteel { Rotation: {0, 0, HALF_PI}; Tube: {radius: r, thickness: r * 0.2, length: 0.12, segments: 24, smooth: true} }
    flange : IsleSteel { Position: {-side * 0.07, 0, 0}; Rotation: {0, 0, HALF_PI}; Tube: {radius: r + 0.04, thickness: r * 0.2, length: 0.03, segments: 24, smooth: true} }
    hub : IslePaintRed { Position: {side * 0.01, 0, 0}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: r * 0.3, length: 0.14, segments: 12, smooth: true} }
    for i in 0..n {
      "spoke_{i}" : IslePaintRed { Rotation: {i * RAIL_PI / n, 0, 0}; Box: {0.07, r * 1.75, r * 0.2}; SpatialIgnore }
    }
  }

  template IsleRailAxle {
    prop r: f32 = 0.26
    prop n: i32 = 2

    IsleRailWheel left(r: r, n: n, side: 1) { Position: {0.6, 0, 0} }
    IsleRailWheel right(r: r, n: n, side: -1) { Position: {-0.6, 0, 0} }
    axle : IsleIron { Rotation: {0, 0, HALF_PI}; Cylinder: {radius: 0.05, length: 1.2, segments: 8}; SpatialIgnore; NoShadow }
  }

  template IsleRailRod {
    prop r: f32 = 0.44
    prop len: f32 = 1

    AngularVelocity: {train_speed * RAIL_V / r, 0, 0}
    arm {
      Position: {0, r * 0.45, 0}
      AngularVelocity: {-train_speed * RAIL_V / r, 0, 0}
      rod : IsleRailBright { Box: {0.05, 0.1, len + 0.24} }
      pin_a : IsleBrass { Position: {0, 0, len / 2}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: 0.06, length: 0.09, segments: 10} }
      pin_b : IsleBrass { Position: {0, 0, -len / 2}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: 0.06, length: 0.09, segments: 10} }
    }
  }

  template IsleRailLoco {
    mut blowing = false

    Interactive
    Cursor: {CursorPointer}

    frame : IsleIron { Position: {0, 0.86, 0.1}; Box: {1.0, 0.24, 3.7} }
    board : IsleIron { Position: {0, 1.0, 0.1}; Box: {1.6, 0.07, 3.75} }
    valance_l : IslePaintRed { Position: {0.8, 0.94, 0.1}; Box: {0.04, 0.16, 3.75} }
    valance_r : IslePaintRed { Position: {-0.8, 0.94, 0.1}; Box: {0.04, 0.16, 3.75} }
    beam : IslePaintRed { Position: {0, 0.86, 1.99}; Box: {1.64, 0.34, 0.1} }
    catcher : IslePaintRed { Position: {0, 0.6, 2.27}; Rotation: {0, -HALF_PI, 0}; RightTrianglePrism: {0.5, 0.5, 1.5} }
    for i in 0..5 {
      "slat_{i}" : IsleIron { Position: {-0.56 + i * 0.28, 0.61, 2.285}; Rotation: {-0.785, 0, 0}; Box: {0.06, 0.66, 0.03}; SpatialIgnore; NoShadow }
    }
    coupler : IsleIron { Position: {0, 0.8, -1.9}; Box: {0.12, 0.1, 0.4} }

    boiler : IslePaintGreen { Position: {0, 1.6, 0.45}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.5, length: 2.0, segments: 32, smooth: true} }
    saddle : IsleIron { Position: {0, 1.2, 1.72}; Box: {0.74, 0.5, 0.5} }
    smokebox : IsleIron { Position: {0, 1.6, 1.72}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.53, length: 0.56, segments: 32, smooth: true} }
    door : IsleIron { Position: {0, 1.6, 2.0}; Scale: {1, 1, 0.3}; Sphere: {radius: 0.44, segments: 24, smooth: true} }
    door_ring : IsleBrass { Position: {0, 1.6, 2.01}; Rotation: {HALF_PI, 0, 0}; Torus: {radius: 0.46, tube: 0.025, segments: 32, rings: 6, smooth: true} }
    door_wheel : IsleBrass { Position: {0, 1.6, 2.15}; Rotation: {HALF_PI, 0, 0}; Torus: {radius: 0.1, tube: 0.02, segments: 16, rings: 6, smooth: true} }
    door_hub : IsleBrass { Position: {0, 1.6, 2.13}; Sphere: {radius: 0.04, segments: 10, smooth: true} }
    for i in 0..3 {
      "band_{i}" : IsleBrass { Position: {0, 1.6, -0.3 + i * 0.75}; Rotation: {HALF_PI, 0, 0}; Torus: {radius: 0.503, tube: 0.022, segments: 32, rings: 6, smooth: true}; SpatialIgnore }
    }
    rail_l : IsleBrass { Position: {0.53, 1.78, 0.5}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.018, length: 2.0, segments: 6}; SpatialIgnore }
    rail_r : IsleBrass { Position: {-0.53, 1.78, 0.5}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.018, length: 2.0, segments: 6}; SpatialIgnore }

    funnel_base : IsleIron { Position: {0, 2.14, 1.72}; Cylinder: {radius: 0.22, length: 0.1, segments: 20, smooth: true} }
    funnel : IsleIron { Position: {0, 2.45, 1.72}; Frustum: {radius_bottom: 0.13, radius_top: 0.2, length: 0.62, segments: 20, smooth: true} }
    funnel_cap : IsleBrass { Position: {0, 2.76, 1.72}; Torus: {radius: 0.2, tube: 0.035, segments: 20, rings: 8, smooth: true} }
    dome_base : IsleBrass { Position: {0, 2.12, 0.8}; Cylinder: {radius: 0.24, length: 0.3, segments: 20, smooth: true} }
    dome : IsleBrass { Position: {0, 2.27, 0.8}; Sphere: {radius: 0.24, segments: 20, smooth: true} }
    sand_base : IslePaintGreen { Position: {0, 2.1, 0.1}; Cylinder: {radius: 0.18, length: 0.24, segments: 16, smooth: true} }
    sand : IslePaintGreen { Position: {0, 2.22, 0.1}; Sphere: {radius: 0.18, segments: 16, smooth: true} }
    sand_ring : IsleBrass { Position: {0, 2.22, 0.1}; Torus: {radius: 0.18, tube: 0.018, segments: 16, rings: 6, smooth: true} }
    whistle : IsleBrass { Position: {0.2, 2.2, -0.3}; Cylinder: {radius: 0.035, length: 0.36, segments: 8, smooth: true} }
    whistle_top : IsleBrass { Position: {0.2, 2.4, -0.3}; Sphere: {radius: 0.05, segments: 8, smooth: true} }
    valve : IsleBrass { Position: {-0.2, 2.16, -0.3}; Cylinder: {radius: 0.05, length: 0.26, segments: 8, smooth: true} }

    cab : IslePaintGreen { Position: {0, 1.7, -1.15}; Box: {1.5, 1.34, 1.2} }
    cab_roof : IsleIron { Position: {0, 2.36, -1.15}; Rotation: {HALF_PI, 0, 0}; Scale: {1, 1, 0.24}; Cylinder: {radius: 0.9, length: 1.56, segments: 28, smooth: true} }
    cab_line_l : IslePaintYellow { Position: {0.752, 1.24, -1.15}; Box: {0.012, 0.05, 1.2} }
    cab_line_r : IslePaintYellow { Position: {-0.752, 1.24, -1.15}; Box: {0.012, 0.05, 1.2} }
    win_frame : IsleBrass { Position: {0, 1.98, -1.15}; Box: {1.52, 0.6, 0.66} }
    win : IsleWindow { Position: {0, 1.98, -1.15}; Box: {1.54, 0.5, 0.56} }
    plate : IsleBrass { Position: {0, 1.46, -1.15}; Box: {1.52, 0.18, 0.44} }
    spec_l : IsleWindow { Position: {0.5, 2.08, -0.545}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.15, length: 0.04, segments: 16} }
    spec_r : IsleWindow { Position: {-0.5, 2.08, -0.545}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.15, length: 0.04, segments: 16} }
    spec_ring_l : IsleBrass { Position: {0.5, 2.08, -0.54}; Rotation: {HALF_PI, 0, 0}; Torus: {radius: 0.15, tube: 0.02, segments: 16, rings: 6} }
    spec_ring_r : IsleBrass { Position: {-0.5, 2.08, -0.54}; Rotation: {HALF_PI, 0, 0}; Torus: {radius: 0.15, tube: 0.02, segments: 16, rings: 6} }
    cab_back : IsleRailDark { Position: {0, 1.78, -1.752}; Box: {1.1, 0.95, 0.02} }
    firebox : IsleRailFire { Position: {0, 1.5, -1.76}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.2, length: 0.03, segments: 16} }
    firebox_ring : IsleBrass { Position: {0, 1.5, -1.765}; Rotation: {HALF_PI, 0, 0}; Torus: {radius: 0.2, tube: 0.025, segments: 16, rings: 6} }

    splash_fl : IslePaintGreen { Position: {0.6, 1.12, 0.5}; Box: {0.2, 0.2, 0.74} }
    splash_fr : IslePaintGreen { Position: {-0.6, 1.12, 0.5}; Box: {0.2, 0.2, 0.74} }
    splash_bl : IslePaintGreen { Position: {0.6, 1.12, -0.5}; Box: {0.2, 0.2, 0.74} }
    splash_br : IslePaintGreen { Position: {-0.6, 1.12, -0.5}; Box: {0.2, 0.2, 0.74} }
    cyl_l : IslePaintGreen { Position: {0.8, 0.74, 1.25}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.17, length: 0.6, segments: 16, smooth: true} }
    cyl_r : IslePaintGreen { Position: {-0.8, 0.74, 1.25}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.17, length: 0.6, segments: 16, smooth: true} }
    cyl_cap_l : IsleBrass { Position: {0.8, 0.74, 1.56}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.13, length: 0.04, segments: 16} }
    cyl_cap_r : IsleBrass { Position: {-0.8, 0.74, 1.56}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.13, length: 0.04, segments: 16} }
    piston_l : IsleRailBright { Position: {0.8, 0.74, 0.7}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.03, length: 0.6, segments: 6} }
    piston_r : IsleRailBright { Position: {-0.8, 0.74, 0.7}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.03, length: 0.6, segments: 6} }

    IsleRailAxle drive_a(r: 0.44, n: 3) { Position: {0, 0.76, 0.5} }
    IsleRailAxle drive_b(r: 0.44, n: 3) { Position: {0, 0.76, -0.5} }
    IsleRailAxle lead(r: 0.25) { Position: {0, 0.57, 1.5} }
    IsleRailAxle trail(r: 0.25) { Position: {0, 0.57, -1.4} }
    IsleRailRod rod_l(r: 0.44, len: 1) { Position: {0.7, 0.76, 0} }
    IsleRailRod rod_r(r: 0.44, len: 1) { Position: {-0.7, 0.76, 0} }

    lamp : IsleBrass { Position: {0, 2.28, 2.04}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.14, length: 0.22, segments: 16, smooth: true} }
    lamp_lens : IsleLampGlow { Position: {0, 2.28, 2.155}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.11, length: 0.02, segments: 16} }

    if night {
      headlight { Position: {0, 2.28, 2.2}; Rotation: {0.14, 0, 0}; SpotLight: {intensity: 260, range: 30, inner_angle: 14, outer_angle: 30}; Rgb: {255, 226, 170} }
      fireglow { Position: {0, 1.5, -2.0}; PointLight: {intensity: 4, range: 3.5}; Rgb: {255, 130, 50} }
    }

    smoke {
      Position: {0, 2.8, 1.72}
      ParticleEmitter: {
        max: 400, rate: train_speed > 0.01 ? 10 + 34 * train_speed : 3, shape: EmitterDisc, radius: 0.12, spread: 12,
        speed: {3.2, 4.2}, lifetime: {2.2, 3.6}, size: {0.4, 0.65}, rotation: {0, 360},
        opacity: {0.4, 0.7}, acceleration: {0, 0.6, 0}, inherit_velocity: 0.4, color: {244, 244, 240}, seed: 7
      }
      ParticleForces: {gravity: {0, 0, 0}, drag: 0.5, turbulence: 0.7}
      ParticleCurves: {
        size: {keys: [{0, 0.4}, {0.3, 1.2}, {1, 3.4}]},
        opacity: {keys: [{0, 0}, {0.08, 1}, {0.5, 0.55}, {1, 0}]},
        color: {keys: [{0, {255, 255, 255}}, {0.4, {236, 236, 236}}, {1, {200, 204, 212}}]}
      }
      ParticleAppearance: {softness: 0.5, lit: 0.6}
    }

    whistle_jet {
      Position: {0.2, 2.46, -0.3}
      ParticleEmitter: {
        max: 500, rate: blowing ? 260 : 0, spread: 9,
        speed: {4.5, 7}, lifetime: {0.5, 1.1}, size: {0.14, 0.26}, rotation: {0, 360},
        opacity: {0.6, 0.95}, color: {255, 255, 255}, seed: 11
      }
      ParticleForces: {gravity: {0, 0, 0}, drag: 2.2, turbulence: 1.2}
      ParticleCurves: {
        size: {keys: [{0, 0.6}, {0.4, 2.2}, {1, 4}]},
        opacity: {keys: [{0, 1}, {0.5, 0.6}, {1, 0}]}
      }
      ParticleAppearance: {softness: 0.3, lit: 0.4}
    }

    cock_l {
      Position: {0.98, 0.6, 1.5}
      ParticleEmitter: {
        max: 300, rate: blowing ? 120 : 0, direction: {1, 0.15, 0.4}, spread: 16,
        speed: {2, 4}, lifetime: {0.5, 1.0}, size: {0.16, 0.3}, rotation: {0, 360},
        opacity: {0.5, 0.85}, color: {255, 255, 255}, seed: 13
      }
      ParticleForces: {gravity: {0, 0, 0}, drag: 2.5, turbulence: 1}
      ParticleCurves: {size: {keys: [{0, 0.6}, {1, 3.6}]}, opacity: {keys: [{0, 1}, {0.5, 0.5}, {1, 0}]}}
      ParticleAppearance: {softness: 0.3, lit: 0.4}
    }

    cock_r {
      Position: {-0.98, 0.6, 1.5}
      ParticleEmitter: {
        max: 300, rate: blowing ? 120 : 0, direction: {-1, 0.15, 0.4}, spread: 16,
        speed: {2, 4}, lifetime: {0.5, 1.0}, size: {0.16, 0.3}, rotation: {0, 360},
        opacity: {0.5, 0.85}, color: {255, 255, 255}, seed: 14
      }
      ParticleForces: {gravity: {0, 0, 0}, drag: 2.5, turbulence: 1}
      ParticleCurves: {size: {keys: [{0, 0.6}, {1, 3.6}]}, opacity: {keys: [{0, 1}, {0.5, 0.5}, {1, 0}]}}
      ParticleAppearance: {softness: 0.3, lit: 0.4}
    }

    cam { Position: {0, 3.7, -1.7}; Rotation: {-0.2, RAIL_PI - 0.14, 0}; Camera: {fov: 60, near_: 0.1, far_: 800} }

    async {
      while true {
        await on.click(this)
        emit Whistle()
      }
    }

    async {
      while true {
        await Whistle
        blowing = true
        await delay(1.1)
        blowing = false
      }
    }
  }

  template IsleRailTender {
    frame : IsleIron { Position: {0, 0.82, 0}; Box: {1.1, 0.2, 2.2} }
    body : IslePaintGreen { Position: {0, 1.34, 0}; Box: {1.46, 0.84, 2.1} }
    rim : IslePaintGreen { Position: {0, 1.79, 0}; Box: {1.54, 0.07, 2.18} }
    line_a : IslePaintYellow { Position: {0, 1.14, 0}; Box: {1.475, 0.04, 2.115} }
    line_b : IslePaintYellow { Position: {0, 1.62, 0}; Box: {1.475, 0.04, 2.115} }
    coal : IsleRailCoal { Position: {0, 1.76, 0.1}; Scale: {0.62, 0.3, 0.86}; Sphere: {radius: 1, segments: 16, smooth: true} }
    for i in 0..9 {
      "lump_{i}" : IsleRailCoal {
        Position: {-0.4 + rnd(i, 1) * 0.8, 1.86 + rnd(i, 2) * 0.16, -0.5 + rnd(i, 3) * 1.2}
        Rotation: {rnd(i, 4) * 3, rnd(i, 5) * 3, 0}
        IcoSphere: {radius: 0.12 + rnd(i, 6) * 0.08, segments: 0}
        SpatialIgnore
      }
    }
    hatch : IsleBrass { Position: {0, 1.84, -0.82}; Cylinder: {radius: 0.16, length: 0.06, segments: 14, smooth: true} }
    coupler_f : IsleIron { Position: {0, 0.8, 1.2}; Box: {0.12, 0.1, 0.3} }
    coupler_b : IsleIron { Position: {0, 0.8, -1.2}; Box: {0.12, 0.1, 0.3} }
    IsleRailAxle axle_a(r: 0.3) { Position: {0, 0.62, 0.7} }
    IsleRailAxle axle_b(r: 0.3) { Position: {0, 0.62, 0} }
    IsleRailAxle axle_c(r: 0.3) { Position: {0, 0.62, -0.7} }
  }

  template IsleRailCoach {
    prop paint: entity = 0
    prop trim: entity = 0

    frame : IsleIron { Position: {0, 0.8, 0}; Box: {1.2, 0.16, 3.6} }
    deck : IsleIron { Position: {0, 0.9, 0}; Box: {1.46, 0.06, 3.8} }
    lower { (IsA, paint); Position: {0, 1.23, 0}; Box: {1.5, 0.6, 3.3} }
    band { (IsA, trim); Position: {0, 1.84, 0}; Box: {1.46, 0.64, 3.26} }
    cornice { (IsA, paint); Position: {0, 2.2, 0}; Box: {1.5, 0.1, 3.3} }
    stripe : IslePaintYellow { Position: {0, 1.53, 0}; Box: {1.515, 0.04, 3.31} }
    roof : IsleRailRoof { Position: {0, 2.23, 0}; Rotation: {HALF_PI, 0, 0}; Scale: {1, 1, 0.26}; Cylinder: {radius: 0.88, length: 3.6, segments: 28, smooth: true} }
    lantern : IsleRailRoof { Position: {0, 2.47, 0}; Box: {0.5, 0.12, 2.6} }
    for i in 0..5 {
      "win_{i}" : IsleWindow { Position: {0, 1.86, -1.2 + i * 0.6}; Box: {1.48, 0.46, 0.42} }
    }
    for i in 0..3 {
      "vent_{i}" : IsleBrass { Position: {0, 2.56, -0.9 + i * 0.9}; Cylinder: {radius: 0.07, length: 0.1, segments: 8}; SpatialIgnore }
    }
    doors : IsleWoodDark { Position: {0, 1.55, 0}; Box: {0.52, 1.16, 3.32}; TextureMapping: {mode: MappingObject, size: 1.6} }
    door_win : IsleWindow { Position: {0, 1.86, 0}; Box: {0.3, 0.4, 3.34} }
    for s in 0..2 {
      const z = s * 3.72 - 1.86
      "rail_{s}" : IsleBrass { Position: {0, 1.5, z}; Box: {1.3, 0.03, 0.03}; SpatialIgnore }
      "post_l_{s}" : IsleBrass { Position: {0.63, 1.2, z}; Box: {0.03, 0.6, 0.03}; SpatialIgnore }
      "post_r_{s}" : IsleBrass { Position: {-0.63, 1.2, z}; Box: {0.03, 0.6, 0.03}; SpatialIgnore }
      "coupler_{s}" : IsleIron { Position: {0, 0.8, s * 4.0 - 2.0}; Box: {0.12, 0.1, 0.3} }
      "bogie_{s}" : IsleIron { Position: {0, 0.62, s * 2.3 - 1.15}; Box: {1.34, 0.14, 1.0} }
      IsleRailAxle "axle_a_{s}"(r: 0.26) { Position: {0, 0.58, s * 2.3 - 1.15 + 0.32} }
      IsleRailAxle "axle_b_{s}"(r: 0.26) { Position: {0, 0.58, s * 2.3 - 1.15 - 0.32} }
    }
  }

  template IsleRailCaboose {
    frame : IsleIron { Position: {0, 0.8, 0}; Box: {1.2, 0.16, 2.6} }
    deck : IsleIron { Position: {0, 0.9, 0}; Box: {1.46, 0.06, 2.7} }
    body : IslePaintTeal { Position: {0, 1.55, 0.2}; Box: {1.5, 1.24, 2.0} }
    stripe : IslePaintCream { Position: {0, 1.4, 0.2}; Box: {1.515, 0.08, 2.01} }
    roof : IsleRailRoof { Position: {0, 2.15, 0.1}; Rotation: {HALF_PI, 0, 0}; Scale: {1, 1, 0.24}; Cylinder: {radius: 0.88, length: 2.6, segments: 28, smooth: true} }
    cupola : IslePaintTeal { Position: {0, 2.5, 0.3}; Box: {0.9, 0.42, 0.8} }
    cupola_win : IsleWindow { Position: {0, 2.52, 0.3}; Box: {0.92, 0.24, 0.6} }
    cupola_win_b : IsleWindow { Position: {0, 2.52, 0.3}; Box: {0.6, 0.24, 0.82} }
    cupola_roof : IsleRailRoof { Position: {0, 2.74, 0.3}; Box: {1.04, 0.07, 0.94} }
    win_a : IsleWindow { Position: {0, 1.8, 0.7}; Box: {1.52, 0.42, 0.42} }
    win_b : IsleWindow { Position: {0, 1.8, -0.3}; Box: {1.52, 0.42, 0.42} }
    door : IsleWoodDark { Position: {0, 1.5, 0.2}; Box: {0.52, 1.1, 2.02}; TextureMapping: {mode: MappingObject, size: 1.6} }
    chimney : IsleIron { Position: {0.45, 2.5, -0.5}; Cylinder: {radius: 0.06, length: 0.5, segments: 8} }
    rail : IsleBrass { Position: {0, 1.5, -1.3}; Box: {1.3, 0.03, 0.03}; SpatialIgnore }
    post_l : IsleBrass { Position: {0.63, 1.2, -1.3}; Box: {0.03, 0.6, 0.03}; SpatialIgnore }
    post_r : IsleBrass { Position: {-0.63, 1.2, -1.3}; Box: {0.03, 0.6, 0.03}; SpatialIgnore }
    tail : IsleSignalRed { Position: {0, 1.3, -1.36}; Sphere: {radius: 0.07, segments: 10}; NoShadow }
    coupler : IsleIron { Position: {0, 0.8, 1.4}; Box: {0.12, 0.1, 0.3} }

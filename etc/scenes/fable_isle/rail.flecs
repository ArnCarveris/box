  template IsleRailway {
    prop start: f32 = 1.25

    const R = RAIL_R
    const n = 104

    track {
      bed : IsleRailBallastLow { Position: {0, 0.05, 0}; Tube: {radius: R + 1.25, thickness: 2.5, length: 0.1, segments: 128} }
      ballast : IsleRailBallast { Position: {0, 0.13, 0}; Tube: {radius: R + 1.02, thickness: 2.04, length: 0.1, segments: 128} }
      rail_out : IsleRailBright { Position: {0, 0.275, 0}; Tube: {radius: R + 0.635, thickness: 0.07, length: 0.09, segments: 160, smooth: true} }
      rail_in : IsleRailBright { Position: {0, 0.275, 0}; Tube: {radius: R - 0.565, thickness: 0.07, length: 0.09, segments: 160, smooth: true} }
      for i in 0..n {
        const a = i * TAU / n
        if abs(a - 4.712389) > 0.37 {
          "sleeper_{i}" : IsleRailSleeper { Position: {px(R, a), 0.2, pz(R, a)}; Rotation: {0, -a, 0}; Box: {1.9, 0.08, 0.3}; SpatialIgnore; NoShadow }
        }
      }
    }

    pivot {
      AngularVelocity: {0, -RAIL_W * train_speed, 0}
      IsleRailLoco loco() { Position: {px(R, start), 0, pz(R, start)}; Rotation: {0, -start, 0} }
      IsleRailTender tender() { Position: {px(R, start - 3.15 / R), 0, pz(R, start - 3.15 / R)}; Rotation: {0, -(start - 3.15 / R), 0} }
      IsleRailCoach coach_a(paint: IslePaintRed, trim: IslePaintCream) { Position: {px(R, start - 6.45 / R), 0, pz(R, start - 6.45 / R)}; Rotation: {0, -(start - 6.45 / R), 0} }
      IsleRailCoach coach_b(paint: IslePaintBlue, trim: IslePaintCream) { Position: {px(R, start - 10.55 / R), 0, pz(R, start - 10.55 / R)}; Rotation: {0, -(start - 10.55 / R), 0} }
      IsleRailCoach coach_c(paint: IslePaintYellow, trim: IslePaintCream) { Position: {px(R, start - 14.65 / R), 0, pz(R, start - 14.65 / R)}; Rotation: {0, -(start - 14.65 / R), 0} }
      IsleRailCaboose caboose() { Position: {px(R, start - 18.25 / R), 0, pz(R, start - 18.25 / R)}; Rotation: {0, -(start - 18.25 / R), 0} }
    }

    IsleRailPortal portal_a() { Position: {px(R, HILL_A + 0.32), 0, pz(R, HILL_A + 0.32)}; Rotation: {0, -(HILL_A + 0.32), 0} }
    IsleRailPortal portal_b() { Position: {px(R, HILL_A - 0.32), 0, pz(R, HILL_A - 0.32)}; Rotation: {0, RAIL_PI - (HILL_A - 0.32), 0} }
    IsleRailBridge bridge() { Position: {px(R, BROOK_A), 0, pz(R, BROOK_A)}; Rotation: {0, -BROOK_A, 0} }
    IsleRailStation station() { Rotation: {0, -STATION_A, 0} }
    IsleRailCrossing crossing() { Position: {px(R, STATION_A + 0.3), 0, pz(R, STATION_A + 0.3)}; Rotation: {0, -(STATION_A + 0.3), 0} }

    IsleRailSignal signal_station(semaphore: true) { Position: {px(R + 1.3, STATION_A - 0.3), 0, pz(R + 1.3, STATION_A - 0.3)}; Rotation: {0, -(STATION_A - 0.3), 0} }
    IsleRailSignal signal_hill_a() { Position: {px(R - 1.35, HILL_A - 0.52), 0, pz(R - 1.35, HILL_A - 0.52)}; Rotation: {0, -(HILL_A - 0.52), 0} }
    IsleRailSignal signal_hill_b() { Position: {px(R - 1.35, HILL_A + 0.52), 0, pz(R - 1.35, HILL_A + 0.52)}; Rotation: {0, -(HILL_A + 0.52), 0} }
    IsleRailSignal signal_brook(semaphore: true) { Position: {px(R + 1.3, BROOK_A - 0.22), 0, pz(R + 1.3, BROOK_A - 0.22)}; Rotation: {0, -(BROOK_A - 0.22), 0} }
  }
}

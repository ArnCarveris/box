      { (IsA, IsleCreatureFlowerA); NoShadow; SpatialIgnore; Position: {0.2, 3.463, -4.1}; IcoSphere: {radius: 0.11, segments: 1, smooth: true} }
      { (IsA, IsleCreatureFlowerB); NoShadow; SpatialIgnore; Position: {1.9, 3.154, -3.1}; IcoSphere: {radius: 0.11, segments: 1, smooth: true} }
      { (IsA, IsleCreatureEye); NoShadow; SpatialIgnore; Position: {0.4, 3.367, -1.6}; IcoSphere: {radius: 0.11, segments: 1, smooth: true} }
      { (IsA, IsleCreatureFlowerA); NoShadow; SpatialIgnore; Position: {-1.9, 2.775, -0.1}; IcoSphere: {radius: 0.11, segments: 1, smooth: true} }
      { (IsA, IsleCreatureFlowerB); NoShadow; SpatialIgnore; Position: {1.8, 2.729, 0.4}; IcoSphere: {radius: 0.11, segments: 1, smooth: true} }
      { (IsA, IsleCreatureEye); NoShadow; SpatialIgnore; Position: {-2.3, 2.933, -4}; IcoSphere: {radius: 0.11, segments: 1, smooth: true} }
      { (IsA, IsleCreatureFlowerA); NoShadow; SpatialIgnore; Position: {1.3, 3.154, -1}; IcoSphere: {radius: 0.11, segments: 1, smooth: true} }
      { (IsA, IsleCreatureFlowerB); NoShadow; SpatialIgnore; Position: {-0.9, 3.428, -3}; IcoSphere: {radius: 0.11, segments: 1, smooth: true} }
      { (IsA, IsleCreatureBarnacle); SpatialIgnore; Position: {1.449, 1.887, -8.4}; Rotation: {1.6, -6, 0}; Scale: {1, 0.7, 1.1}; IcoSphere: {radius: 0.3, segments: 1} }
      { (IsA, IsleCreatureBarnacle); SpatialIgnore; Position: {0.759, 2.488, -7.7}; Rotation: {2.3, -7.8, 0}; Scale: {1, 0.7, 1.1}; IcoSphere: {radius: 0.42, segments: 1} }
      { (IsA, IsleCreatureBarnacle); SpatialIgnore; Position: {-1.027, 2.285, -8}; Rotation: {2, -10.8, 0}; Scale: {1, 0.7, 1.1}; IcoSphere: {radius: 0.34, segments: 1} }
      { (IsA, IsleCreatureBarnacle); SpatialIgnore; Position: {-1.667, 2.473, -7.1}; Rotation: {2.9, -11.8, 0}; Scale: {1, 0.7, 1.1}; IcoSphere: {radius: 0.25, segments: 1} }
      { (IsA, IsleCreatureBarnacle); SpatialIgnore; Position: {-0.27, 1.804, -8.9}; Rotation: {1.1, -9.5, 0}; Scale: {1, 0.7, 1.1}; IcoSphere: {radius: 0.22, segments: 1} }
      { (IsA, IsleCreatureBarnacle); SpatialIgnore; Position: {2.237, 2.397, -6.4}; Rotation: {3.6, -5.2, 0}; Scale: {1, 0.7, 1.1}; IcoSphere: {radius: 0.22, segments: 1} }
      { (IsA, IsleCreatureBarnacle); SpatialIgnore; Position: {0.964, 2.371, 3}; Rotation: {13, -7, 0}; Scale: {1, 0.7, 1.1}; IcoSphere: {radius: 0.3, segments: 1} }
      { (IsA, IsleCreatureBarnacle); SpatialIgnore; Position: {-1.093, 2.408, 2.6}; Rotation: {12.6, -11.2, 0}; Scale: {1, 0.7, 1.1}; IcoSphere: {radius: 0.24, segments: 1} }
      { (IsA, IsleCreatureBarnacle); SpatialIgnore; Position: {3.426, 0.568, -1}; Rotation: {9, -0.8, 0}; Scale: {1, 0.7, 1.1}; IcoSphere: {radius: 0.26, segments: 1} }
      { (IsA, IsleCreatureBarnacle); SpatialIgnore; Position: {-3.31, 0.567, -0.4}; Rotation: {9.6, -17.2, 0}; Scale: {1, 0.7, 1.1}; IcoSphere: {radius: 0.26, segments: 1} }
      { (IsA, IsleCreatureBarnacle); SpatialIgnore; Position: {-2.885, 1.472, -7}; Rotation: {3, -15, 0}; Scale: {1, 0.7, 1.1}; IcoSphere: {radius: 0.2, segments: 1} }
    }

    async {
      while true {
        await delay(7 + rnd(seed, 3) * 9)
        spouting = true
        await delay(1.5)
        spouting = false
        await delay(6 + rnd(seed, 5) * 5)
      }
    }

    async {
      while true {
        await on.click(this)
        emit WhaleSong()
      }
    }

    async {
      while true {
        await WhaleSong
        await delay(seed * 0.5)
        spouting = true
        await delay(1.6)
        spouting = false
      }
    }
  }

  template IsleSkyWhale {
    prop radius: f32 = 66
    prop height: f32 = 5
    prop start: f32 = 1.25
    prop calves: i32 = 2
    Position: {0, 0, 0}
    Rotation: {0, start, 0}
    pivot {
      Position: {0, height, 0}
      AngularVelocity: {0, 0.02 + wind * 0.016, 0}
      mother {
        Position: {radius, 0, 0}
        IsleWhale whale() { Position: {0, 0, 0}; Animator: {clip: isle_whale_swim} }
      }
      for i in 0..calves {
        "calf_{i}" {
          Position: {0, 0, 0}
          Rotation: {0, -0.2 - i * 0.14, 0}
          arm {
            Position: {radius + (i == 0 ? -7.5 : 7.0), -4.5 - i * 2.5, 0}
            IsleWhale whale(size: 0.36 - i * 0.07, garden: false, seed: i + 1) { Position: {0, 0, 0}; Animator: {clip: isle_whale_swim, time: 3 + i * 4, speed: 1.4} }
          }
        }
      }
    }
  }
  prefab IsleCreatureCanvas { Rgb: {240, 226, 194}; PbrMaterial: {roughness: 0.85}; Sheen: {color: {255, 240, 210}, roughness: 0.5} }
  prefab IsleCreatureTeak { Rgb: {176, 122, 70}; PbrMaterial: {roughness: 0.7}; ClearCoat: {strength: 0.3, roughness: 0.3} }
  prefab IsleCreatureCanvasRed { Rgb: {198, 64, 54}; PbrMaterial: {roughness: 0.85}; Sheen: {color: {255, 200, 180}, roughness: 0.5} }
  prefab IsleAirshipHullPath { Path2D: {start: {0.02, -4.6}, segments: [{kind: CatmullRom, end: {0.75, -4.3}}, {kind: CatmullRom, end: {1.5, -3.3}}, {kind: CatmullRom, end: {1.95, -1.6}}, {kind: CatmullRom, end: {2.05, 0}}, {kind: CatmullRom, end: {1.9, 1.6}}, {kind: CatmullRom, end: {1.45, 3.1}}, {kind: CatmullRom, end: {0.75, 4.3}}, {kind: CatmullRom, end: {0.02, 4.9}}]} }
  prefab IsleAirshipBandPath { Path2D: {start: {2.0, -1.1}, segments: [{kind: CatmullRom, end: {2.075, -0.5}}, {kind: CatmullRom, end: {2.09, 0}}, {kind: CatmullRom, end: {2.065, 0.5}}, {kind: CatmullRom, end: {1.99, 1.1}}]} }
  prefab IsleAirshipNosePath { Path2D: {start: {0.02, -4.66}, segments: [{kind: CatmullRom, end: {0.4, -4.56}}, {kind: CatmullRom, end: {0.8, -4.3}}]} }

  isle_airship_bob {
    AnimationClip: {duration: 9}
    y { AnimationTrack: {component: Position, member: "y", curve: {kind: CurveCatmullRom, keys: [{0, 0}, {2.25, 0.5}, {4.5, 0}, {6.75, -0.5}, {9, 0}]}} }
    roll { AnimationTrack: {component: Rotation, member: "z", curve: {kind: CurveCatmullRom, keys: [{0, 0.03}, {2.25, 0}, {4.5, -0.03}, {6.75, 0}, {9, 0.03}]}} }
  }

  template IsleAirshipModel {
    envelope : IsleCreatureCanvas { Position: {0, 0, 0}; Rotation: {1.5708, 0, 0}; Lathe: {profile: IsleAirshipHullPath, segments: 28, rings: 32} }
    band : IsleCreatureCanvasRed { NoShadow; Position: {0, 0, 0}; Rotation: {1.5708, 0, 0}; Lathe: {profile: IsleAirshipBandPath, segments: 28, rings: 6} }
    nose : IsleBrass { NoShadow; Position: {0, 0, 0}; Rotation: {1.5708, 0, 0}; Lathe: {profile: IsleAirshipNosePath, segments: 28, rings: 6} }
    rib_0 : IsleBrass { NoShadow; Position: {0, 0, -3.3}; Rotation: {1.5708, 0, 0}; Torus: {radius: 1.5, tube: 0.05, segments: 28, rings: 6, smooth: true} }
    rib_1 : IsleBrass { NoShadow; Position: {0, 0, -1.6}; Rotation: {1.5708, 0, 0}; Torus: {radius: 1.95, tube: 0.05, segments: 28, rings: 6, smooth: true} }
    rib_2 : IsleBrass { NoShadow; Position: {0, 0, 1.6}; Rotation: {1.5708, 0, 0}; Torus: {radius: 1.9, tube: 0.05, segments: 28, rings: 6, smooth: true} }
    rib_3 : IsleBrass { NoShadow; Position: {0, 0, 3.1}; Rotation: {1.5708, 0, 0}; Torus: {radius: 1.45, tube: 0.05, segments: 28, rings: 6, smooth: true} }
    fin_t : IsleCreatureCanvasRed { Position: {0, 1.3, 3.75}; Rotation: {0.4, 0, 0}; Box: {0.08, 1.6, 1.4} }
    fin_b : IsleCreatureCanvasRed { Position: {0, -1.3, 3.75}; Rotation: {-0.4, 0, 0}; Box: {0.08, 1.6, 1.4} }
    fin_r : IsleCreatureCanvasRed { Position: {1.3, 0, 3.75}; Rotation: {0, -0.4, 0}; Box: {1.6, 0.08, 1.4} }
    fin_l : IsleCreatureCanvasRed { Position: {-1.3, 0, 3.75}; Rotation: {0, 0.4, 0}; Box: {1.6, 0.08, 1.4} }
    cabin : IsleCreatureTeak { Position: {0, -2.78, -0.3}; Box: {1.1, 0.8, 2.6} }
    bow : IsleCreatureTeak { Position: {0, -2.78, -1.6}; Cylinder: {radius: 0.55, length: 0.8, segments: 16, smooth: true} }
    stern : IsleCreatureTeak { Position: {0, -2.78, 1.0}; Cylinder: {radius: 0.55, length: 0.8, segments: 16, smooth: true} }
    rail_top : IsleBrass { Position: {0, -2.36, -0.3}; Box: {1.18, 0.06, 2.66} }
    rail_bow : IsleBrass { Position: {0, -2.36, -1.6}; Cylinder: {radius: 0.59, length: 0.06, segments: 16, smooth: true} }
    rail_stern : IsleBrass { Position: {0, -2.36, 1.0}; Cylinder: {radius: 0.59, length: 0.06, segments: 16, smooth: true} }
    keel : IsleBrass { Position: {0, -3.2, -0.3}; Box: {0.9, 0.06, 3.4} }
    for i in 0..3 {
      { (IsA, IsleWindow); NoShadow; Position: {0.56, -2.68, -1.2 + i * 0.9}; Box: {0.04, 0.36, 0.5} }
      { (IsA, IsleWindow); NoShadow; Position: {-0.56, -2.68, -1.2 + i * 0.9}; Box: {0.04, 0.36, 0.5} }
    }
    win_bow : IsleWindow { NoShadow; Position: {0, -2.68, -2.14}; Box: {0.5, 0.32, 0.04} }
    for i in 0..4 {
      const sx = i % 2 == 0 ? 0.42 : -0.42
      const sz = i < 2 ? -1.5 : 0.9
      { (IsA, IsleRope); NoShadow; SpatialIgnore; Position: {sx * 1.4, -2.1, sz}; Rotation: {0, 0, sx * 0.9}; Cylinder: {radius: 0.035, length: 0.7, segments: 5} }
    }
    outrigger : IsleBrass { Position: {0, -2.75, 0.75}; Box: {3.3, 0.07, 0.12} }
    for i in 0..2 {
      const sx = i == 0 ? 1.7 : -1.7
      { (IsA, IsleBrass); Position: {sx, -2.75, 0.8}; Rotation: {1.5708, 0, 0}; Cylinder: {radius: 0.2, length: 0.7, segments: 12, smooth: true} }
      "prop_{i}" {
        Position: {sx, -2.75, 1.22}
        AngularVelocity: {0, 0, i == 0 ? 21 : -21}
        hub : IsleBrass { Position: {0, 0, 0}; Sphere: {radius: 0.1, segments: 8, smooth: true} }
        blade_a : IsleCreatureWood { NoShadow; Position: {0, 0, 0}; Rotation: {0, 0.3, 0}; Box: {1.5, 0.16, 0.03} }
        blade_b : IsleCreatureWood { NoShadow; Position: {0, 0, 0}; Rotation: {0.3, 0, 0}; Box: {0.16, 1.5, 0.03} }
      }
    }
    chain : IsleRope { NoShadow; SpatialIgnore; Position: {0, -3.42, -1.5}; Cylinder: {radius: 0.02, length: 0.4, segments: 5} }
    lamp_cap : IsleBrass { NoShadow; Position: {0, -3.6, -1.5}; Cone: {radius: 0.2, length: 0.16, segments: 8} }
    lamp : IsleLampGlow { NoShadow; Position: {0, -3.78, -1.5}; Sphere: {radius: 0.17, segments: 10, smooth: true} }
    if night {
      glow { Position: {0, -3.9, -1.5}; PointLight: {intensity: 14, range: 10}; Rgb: {255, 180, 100} }
    }
    pole : IsleBrass { NoShadow; Position: {0, 2.5, 3.9}; Cylinder: {radius: 0.025, length: 1.0, segments: 5} }
    pennant : IsleCreatureCanvasRed { NoShadow; SpatialIgnore; Position: {0, 2.85, 4.3}; Box: {0.02, 0.26, 0.8} }
  }

  template IsleAirship {
    prop radius: f32 = 48
    prop height: f32 = 20
    prop start: f32 = 2.6
    Position: {0, 0, 0}
    Rotation: {0, start, 0}
    pivot {
      Position: {0, height, 0}
      AngularVelocity: {0, -0.04 - wind * 0.03, 0}
      IsleAirshipModel ship() { Position: {radius, 0, 0}; Rotation: {0, 3.14159, 0}; Animator: {clip: isle_airship_bob} }
    }
  }
}

isle_creature_audio {
  deep {
    Bus: {output: master, kind: ChannelSfx, volume: 0.8, sends: [{bus: isle_audio.hall, level: 0.9}]}
  }
  prefab whale_call {
    Output: {bus: deep}
    Sound: {seed: 91, drift: 9}
    Envelope: {attack: 0.55, decay: 0.5, sustain: 0.8, release: 1.6, curve: 2}
    Filter: {kind: LowPass, cutoff: 1500, resonance: 0.25}
    PitchEnvelope: {amount: -7, decay: 1.3, curve: -2, release_amount: -5}
    Lfo: {wave: LfoSine, rate: 4.2, cutoff: 0.25, amplitude: 0.12}
    moan {
      Oscillator: {frequency: 440, level: 0.34}
      Unison: {voices: 2, detune: 9, width: 0.6}
    }
    throat { Oscillator: {wave: Triangle, frequency: 880, level: 0.1} }
    cry {
      Oscillator: {frequency: 1320, level: 0.035}
      Envelope: {attack: 0.9, decay: 0.8, sustain: 0.5, release: 1.2}
    }
    breath {
      Oscillator: {wave: Noise, color: NoisePink, level: 0.03}
      Envelope: {attack: 0.3, decay: 0.6, sustain: 0.3, release: 0.8}
    }
  }
  whale_voice { Instrument: {sound: whale_call, velocity_curve: 1} }
}

async {
  while true {
    await WhaleSong
    box.audio.play_note(isle_creature_audio.whale_voice, 50, 0.8, 1.9)
    await delay(1.7)
    box.audio.play_note(isle_creature_audio.whale_voice, 57, 0.9, 2.3)
    await delay(2.3)
    box.audio.play_note(isle_creature_audio.whale_voice, 53, 0.7, 3.0)
    await delay(3.2)
  }
}

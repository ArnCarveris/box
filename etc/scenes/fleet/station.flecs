using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.movement
using box.text
using state

// The station, in meters with the top of its outer deck at y = 0: a domed hub, an inner and a
// middle ring, cargo yards between them, and an outer deck with the hangar wall of the rig bays.
assets {
  template HarborStation {
    HarborHub hub
    HarborYards yards
    HarborRings rings
    HarborGateArms arms
    HarborOuter outer
  }
}

using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.movement
using box.text
using state

// The station, in meters with the top of its outer deck at y = 0: a domed hub crowned with
// spires, an inner and a middle ring joined to it by corridors, cargo yards on the decks
// between them, and an outer deck with the hangar wall of the rig bays. The liner gates and the
// rig bays are drawn by the LinerGate and RigBay templates.
assets {
  harbor_arm_shape { Path2D: {start: {-40, 25}, segments: [
    {kind: Line, end: {40, 25}}, {kind: Line, end: {40, -10}}, {kind: Line, end: {25, -25}},
    {kind: Line, end: {-25, -25}}, {kind: Line, end: {-40, -10}}
  ], closed: true} }
  harbor_arm { Profile2D: {outer: harbor_arm_shape} }

  // A mast with a blinking red beacon on top.
  template HarborMast {
    prop h: f32 = 20
    pole : HarborSteel { Position: {0, h / 2, 0}; Cylinder: {radius: 0.8, length: h, segments: 8} }
    lamp : HarborBeaconRed { Position: {0, h + 1.5, 0}; Sphere: {radius: 2, segments: 10} }
  }

  // A ring of n window strips on a cylinder of radius r at height y, each w wide and h high.
  // Every skip-th strip is left dark.
  template HarborWindows {
    prop r: f32 = 50
    prop y: f32 = 0
    prop n: i32 = 32
    prop w: f32 = 6
    prop h: f32 = 3
    prop skip: i32 = 100000
    for c in 0..n {
      const a = (c + 0.5) * 2 * PI / n
      if (c + 1) % skip != 0 {
        "w_{c}" : HarborWindow {
          Position: {cos(a) * r, y, sin(a) * r}
          Rotation: {0, 0 - a, 0}
          Box: {1, h, w}
        }
      }
    }
  }

  template HarborGlazing {
    prop r: f32 = 50
    prop y: f32 = 0
    prop h: f32 = 13
    prop seg: i32 = 128
    band : HarborWindowBand {
      Position: {0, y, 0}
      Tube: {radius: r + 0.3, thickness: 0.6, length: h, segments: seg}
      texture.Transform: {scale_x: floor(2 * PI * r / 8), scale_y: h / 8}
    }
  }

  // A stack of shipping containers, l long.
  template HarborCrates {
    prop l: f32 = 20
    prop seed: i32 = 0
    for i in 0..3 {
      for j in 0..2 {
        const k = (seed + i + j * 2) % 3
        "c_{i}_{j}" {
          if k == 0 {
            (IsA, HarborCrateRed)
          } else if k == 1 {
            (IsA, HarborCrateBlue)
          } else {
            (IsA, HarborCrateGrey)
          }
          Position: {(i - 1) * 6.5, 3 + j * 6, 0}
          Box: {6, 5.75, l}
        }
      }
    }
  }

  // A yellow portal crane straddling a cargo yard, s wide.
  template HarborCrane {
    prop s: f32 = 30
    leg_a : HarborYellow { Position: {0 - s / 2, 17.5, 0}; Box: {3, 35, 3} }
    leg_b : HarborYellow { Position: {s / 2, 17.5, 0}; Box: {3, 35, 3} }
    beam : HarborYellow { Position: {0, 36, 0}; Box: {s + 5, 4, 5} }
    cab : HarborPanel { Position: {s / 4, 32, 0}; Box: {6, 4, 6} }
    cab_light : HarborAmber { Position: {s / 4, 32, 3.05}; Box: {4, 1.5, 0.1} }
    lamp : HarborBeaconAmber { Position: {0, 38.5, 0}; Sphere: {radius: 1.5, segments: 8} }
  }

  template HarborRadiators {
    prop n: i32 = 5
    prop l: f32 = 30
    prop h: f32 = 13
    const w = n * 4.5 + 3
    base : HarborPanel { Position: {0, 1.5, 0}; Box: {w, 3, l + 3} }
    header : HarborYellow { Position: {0, 4.5, l / 2 + 0.5}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: 1, length: w - 2, segments: 8} }
    for f in 0..n {
      "fin_{f}" : HarborRadiator { Position: {(f - (n - 1) * 0.5) * 4.5, 3 + h / 2, 0}; Box: {0.8, h, l} }
    }
  }

  template HarborTanks {
    prop n: i32 = 3
    prop r: f32 = 4.5
    prop l: f32 = 20
    const w = n * (r * 2 + 1.5)
    saddle_a : HarborPanel { Position: {0, 1.5, l * 0.35}; Box: {w, 3, 2} }
    saddle_b : HarborPanel { Position: {0, 1.5, 0 - l * 0.35}; Box: {w, 3, 2} }
    for t in 0..n {
      "tank_{t}" {
        Position: {(t - (n - 1) * 0.5) * (r * 2 + 1.5), r + 2, 0}
        body : HarborWhite { Rotation: {HALF_PI, 0, 0}; Capsule: {radius: r, length: l, segments: 16, smooth: true} }
        band : HarborRed { Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: r + 0.2, length: 1.5, segments: 16} }
      }
    }
  }

  template HarborDish {
    prop r: f32 = 10
    prop tilt: f32 = 0.6
    prop spin: f32 = 0
    pedestal : HarborPanel { Position: {0, r * 0.4, 0}; Cylinder: {radius: r * 0.18, length: r * 0.8, segments: 10} }
    head {
      Position: {0, r * 0.85, 0}
      AngularVelocity: {0, spin, 0}
      yoke : HarborHullDark { Box: {r * 0.5, r * 0.2, r * 0.3} }
      bowl {
        Rotation: {tilt, 0, 0}
        dish : HarborWhite { Position: {0, r * 0.15, 0}; Frustum: {radius_bottom: r * 0.25, radius_top: r, length: r * 0.3, segments: 24} }
        feed : HarborSteel { Position: {0, r * 0.6, 0}; Cylinder: {radius: r * 0.04, length: r * 0.7, segments: 6} }
        horn : HarborAmber { Position: {0, r * 0.95, 0}; Sphere: {radius: r * 0.08, segments: 8} }
      }
    }
  }

  template HarborPad {
    prop r: f32 = 15
    plate : HarborPanel { Position: {0, 0.25, 0}; Cylinder: {radius: r, length: 0.5, segments: 32} }
    ring : HarborHazard { Position: {0, 0.55, 0}; Tube: {radius: r - 0.75, thickness: 1.5, length: 0.2, segments: 32} }
    bar_a : HarborWhite { Position: {r * 0.25, 0.55, 0}; Box: {r * 0.1, 0.2, r * 0.8} }
    bar_b : HarborWhite { Position: {0 - r * 0.25, 0.55, 0}; Box: {r * 0.1, 0.2, r * 0.8} }
    bar_c : HarborWhite { Position: {0, 0.55, 0}; Box: {r * 0.5, 0.2, r * 0.1} }
    for l in 0..8 {
      const a = l * PI / 4
      "light_{l}" : HarborCyan { Position: {cos(a) * (r + 1), 0.5, sin(a) * (r + 1)}; Sphere: {radius: 0.7, segments: 8} }
    }
  }

  template HarborSpheres {
    prop r: f32 = 6
    pump : HarborPanel { Position: {0, 3, 0}; Box: {7, 6, 7} }
    for s in 0..4 {
      const a = s * HALF_PI + PI / 4
      "sphere_{s}" {
        Position: {cos(a) * r * 1.7, 0, sin(a) * r * 1.7}
        legs : HarborSteel { Position: {0, r * 0.4, 0}; Cylinder: {radius: r * 0.5, length: r * 0.8, segments: 8} }
        tank : HarborWhite { Position: {0, r * 1.5, 0}; Sphere: {radius: r, segments: 16, smooth: true} }
        belt : HarborRed { Position: {0, r * 1.5, 0}; Cylinder: {radius: r + 0.15, length: r * 0.15, segments: 16} }
        pipe : HarborYellow { Position: {0 - cos(a) * r * 0.85, 2, 0 - sin(a) * r * 0.85}; Rotation: {0, 0 - a, HALF_PI}; Cylinder: {radius: 0.6, length: r * 1.7, segments: 6} }
      }
    }
  }

  template HarborRoofModule {
    prop kind: i32 = 0
    prop mast: f32 = 20
    if kind == 0 {
      HarborRadiators fins(n: 5, l: 28, h: 12)
    } else if kind == 1 {
      HarborTanks tanks(n: 3, r: 4.5, l: 22)
    } else if kind == 2 {
      pad : HarborPanel { Position: {0, 1, 0}; Box: {20, 2, 20} }
      HarborDish dish(r: 10, tilt: 0.75, spin: 0.08) { Position: {0, 2, 0} }
    } else if kind == 3 {
      block : HarborHullDark { Position: {0, 7, 0}; Box: {27, 14, 39} }
      vent : HarborPanel { Position: {0, 15, -7}; Box: {19, 2, 15} }
      grill : HarborSteel { Position: {0, 15, 11}; Cylinder: {radius: 4.5, length: 3, segments: 12} }
      HarborMast mast_(h: mast) { Position: {9, 14, 15} }
    } else {
      hab : HarborHull { Position: {0, 6.5, 0}; RoundedBox: {22, 13, 35, 4.5, segments: 2} }
      glass : HarborWindow { Position: {11.3, 7.5, 0}; Box: {0.5, 2.5, 26} }
      glass_b : HarborWindow { Position: {-11.3, 7.5, 0}; Box: {0.5, 2.5, 26} }
      hatch : HarborYellow { Position: {0, 13.5, 9}; Cylinder: {radius: 3, length: 1, segments: 12} }
      HarborMast mast_(h: mast * 0.6) { Position: {0, 13, -12} }
    }
  }

  // A corridor from radius r0 to r1 along +z, w wide and h high, at height y.
  template HarborCorridor {
    prop r0: f32 = 0
    prop r1: f32 = 50
    prop w: f32 = 30
    prop h: f32 = 25
    prop y: f32 = 0
    const l = r1 - r0
    const z = (r0 + r1) / 2
    body : HarborHullDark { Position: {0, y, z}; Box: {w, h, l} }
    roof : HarborPanel { Position: {0, y + h / 2 + 1.5, z}; Box: {w * 0.7, 3, l} }
    win_a : HarborWindow { Position: {w / 2 + 0.3, y + 2, z}; Box: {0.5, h * 0.3, l * 0.92} }
    win_b : HarborWindow { Position: {0 - w / 2 - 0.3, y + 2, z}; Box: {0.5, h * 0.3, l * 0.92} }
    for r in 0..3 {
      "rib_{r}" : HarborPanel { Position: {0, y, r0 + l * (r + 1) / 4}; Box: {w + 3, h + 3, 3} }
    }
  }

  template HarborStation {
    // The hub: a drum with window bands, a dome, a crown of spires and a spike underneath.
    hub {
      base : HarborHull { Position: {0, 15, 0}; Cylinder: {radius: 190, length: 110, segments: 96, smooth: true} }
      HarborGlazing win_a(r: 190.25, y: -20, h: 13, seg: 96)
      HarborGlazing win_b(r: 190.25, y: 10, h: 13, seg: 96)
      HarborGlazing win_c(r: 190.25, y: 40, h: 13, seg: 96)
      for b in 0..12 {
        const a = b * PI / 6
        "buttress_{b}" {
          Rotation: {0, a, 0}
          block : HarborHullDark { Position: {0, 5, 197.5}; RoundedBox: {45, 100, 30, 4, segments: 2} }
          strip : HarborWindow { Position: {0, 20, 212.8}; Box: {30, 5, 0.5} }
          door : HarborPanel { Position: {0, -20, 212.8}; Box: {20, 25, 0.5} }
          HarborMast mast(h: 15) { Position: {0, 55, 197.5} }
        }
      }
      mid : HarborHullDark { Position: {0, 95, 0}; Cylinder: {radius: 160, length: 50, segments: 96, smooth: true} }
      mid_lip : HarborPanel { Position: {0, 70.5, 0}; Cylinder: {radius: 195, length: 3, segments: 96, smooth: true} }
      HarborGlazing win_mid(r: 160.25, y: 97.5, h: 19.5, seg: 96)
      for p in 0..4 {
        const a = p * HALF_PI
        HarborPad "pad_{p}"(r: 13) { Position: {cos(a) * 176, 72, sin(a) * 176} }
        HarborDish "dish_{p}"(r: 11, tilt: 0.8, spin: 0.05 + p * 0.02) { Position: {cos(a + PI / 4) * 176, 72, sin(a + PI / 4) * 176}; Rotation: {0, 0 - a, 0} }
      }
      dome : HarborHull { Position: {0, 120, 0}; HemiSphere: {radius: 150, segments: 64, smooth: true} }
      for r in 0..16 {
        const a = r * PI / 8 + PI / 48
        "dome_rib_{r}" : HarborPanel {
          Position: {0, 120, 0}
          EllipsoidShell: {radius: {151.5, 151.5, 151.5}, longitude_start: a, longitude_end: a + 0.03, latitude_start: 0, latitude_end: 1.2, thickness: 2.5, rims: true, segments: 3, rings: 24}
        }
      }
      dome_rim : HarborPanel { Position: {0, 121, 0}; Torus: {radius: 151, tube: 4, segments: 96, rings: 8} }
      band_a : HarborPanel { Position: {0, 160, 0}; Torus: {radius: 144.5, tube: 3, segments: 96, rings: 8} }
      band_b : HarborPanel { Position: {0, 200, 0}; Torus: {radius: 127, tube: 3, segments: 96, rings: 8} }
      band_c : HarborPanel { Position: {0, 235, 0}; Torus: {radius: 96.5, tube: 3, segments: 64, rings: 8} }
      for c in 0..48 {
        const a = c * PI / 24
        "dome_window_{c}" : HarborWindowCool {
          Position: {cos(a) * 140, 172.5, sin(a) * 140}
          Rotation: {0, 0 - a, 0.3}
          Box: {1, 11, 9}
        }
      }
      crown : HarborHullDark { Position: {0, 280, 0}; Cylinder: {radius: 55, length: 40, segments: 48, smooth: true} }
      crown_lip : HarborPanel { Position: {0, 301, 0}; Cylinder: {radius: 60, length: 3, segments: 48, smooth: true} }
      HarborGlazing win_crown(r: 55.25, y: 280, h: 13, seg: 48)
      spire : HarborSteel { Position: {0, 432.5, 0}; Cone: {radius: 21, length: 260, segments: 24} }
      spire_tip : HarborBeaconRed { Position: {0, 565, 0}; Sphere: {radius: 4, segments: 10} }

      halo {
        Position: {0, 490, 0}
        AngularVelocity: {0, 0.12, 0}
        ring : HarborWhite { Torus: {radius: 55, tube: 2, segments: 64, rings: 8} }
        collar : HarborPanel { Cylinder: {radius: 8, length: 5, segments: 16} }
        for s in 0..6 {
          const a = s * PI / 3
          "spoke_{s}" : HarborSteel { Position: {cos(a) * 31, 0, sin(a) * 31}; Rotation: {0, 0 - a, 0}; Box: {48, 1.5, 1.5} }
          "pod_{s}" : HarborPanel { Position: {cos(a) * 55, 0, sin(a) * 55}; Rotation: {0, 0 - a, 0}; Box: {6, 4.5, 8} }
        }
        for l in 0..12 {
          const a = l * PI / 6 + PI / 12
          "light_{l}" : HarborCyan { Position: {cos(a) * 55, 0, sin(a) * 55}; Sphere: {radius: 1.5, segments: 8} }
        }
      }
      for s in 0..6 {
        const a = s * PI / 3
        const tall = s == 0 || s == 2 || s == 4
        "spire_{s}" {
          Position: {cos(a) * 36, 0, sin(a) * 36}
          body : HarborHullDark { Position: {0, tall ? 380 : 360, 0}; Cone: {radius: 10, length: tall ? 160 : 120, segments: 16} }
          lamp : HarborBeaconRed { Position: {0, tall ? 462.5 : 422.5, 0}; Sphere: {radius: 2.5, segments: 8} }
        }
      }
      under : HarborHullDark { Position: {0, -115, 0}; Frustum: {radius_bottom: 60, radius_top: 190, length: 150, segments: 64, smooth: true} }
      spike : HarborSteel { Position: {0, -290, 0}; Rotation: {PI, 0, 0}; Cone: {radius: 30, length: 200, segments: 24} }
      spike_tip : HarborBeaconRed { Position: {0, -391, 0}; Sphere: {radius: 4, segments: 10} }
      for p in 0..8 {
        const a = p * PI / 4 + PI / 8
        "pod_{p}" : HarborPanel { Position: {cos(a) * 100, -150, sin(a) * 100}; Rotation: {0, 0 - a, 0}; Box: {25, 45, 20} }
      }
    }

    // The decks between the hub and the rings, with cargo yards and cranes.
    deck_inner : HarborDeck { Position: {0, -27.5, 0}; Tube: {radius: 350, thickness: 165, length: 15, segments: 96} }
    deck_mid : HarborDeck { Position: {0, -22.5, 0}; Tube: {radius: 625, thickness: 180, length: 15, segments: 128} }
    for y in 0..16 {
      const a = y * PI / 8 + PI / 16
      "yard_{y}" {
        Rotation: {0, a, 0}
        HarborCrates crates_a(l: 25, seed: y) { Position: {0, -15, 505} }
        HarborCrates crates_b(l: 15, seed: y + 1) { Position: {0, -15, 545} }
        HarborCrane crane(s: 35) { Position: {0, -15, 525}; Rotation: {0, HALF_PI, 0} }
        HarborCrates crates_c(l: 20, seed: y + 2) { Position: {0, -20, 280} }
        HarborCrates crates_d(l: 17, seed: y + 3) { Position: {0, -15, 590}; Rotation: {0, HALF_PI, 0} }
        if y % 2 == 0 {
          HarborSpheres tanks(r: 6) { Position: {0, -20, 236} }
          HarborTanks tanks_b(n: 4, r: 4, l: 25) { Position: {0, -15, 470}; Rotation: {0, HALF_PI, 0} }
        } else {
          HarborPad pad(r: 19) { Position: {0, -20, 236} }
          HarborRadiators fins(n: 4, l: 25, h: 11) { Position: {0, -15, 470}; Rotation: {0, HALF_PI, 0} }
        }
        for l in 0..2 {
          "lamp_{l}" {
            Position: {l == 0 ? -30 : 30, -15, 525}
            pole : HarborSteel { Position: {0, 6, 0}; Cylinder: {radius: 0.6, length: 12, segments: 6} }
            head : HarborWindow { Position: {0, 12.5, 0}; Box: {3, 1, 1.5} }
          }
        }
      }
    }
    rail_a : HarborSteel { Position: {0, -14.5, 0}; Tube: {radius: 508.5, thickness: 1.5, length: 1, segments: 160} }
    rail_b : HarborSteel { Position: {0, -14.5, 0}; Tube: {radius: 543, thickness: 1.5, length: 1, segments: 160} }

    // The inner ring and the corridors that join it to the hub.
    ring_inner {
      body : HarborHull { Position: {0, 10, 0}; Tube: {radius: 450, thickness: 100, length: 80, segments: 128} }
      lip : HarborPanel { Position: {0, 51.5, 0}; Tube: {radius: 453, thickness: 15, length: 4, segments: 128} }
      HarborGlazing out_a(r: 450.25, y: -2.5, h: 13, seg: 128)
      HarborGlazing out_b(r: 450.25, y: 27.5, h: 13, seg: 128)
      HarborGlazing in_a(r: 349.75, y: 15, h: 19.5, seg: 128)
      ledge : HarborPanel { Position: {0, 12.5, 0}; Tube: {radius: 452, thickness: 2.5, length: 2, segments: 128} }
      pipe_a : HarborYellow { Position: {0, 52, 0}; Torus: {radius: 367.5, tube: 1.5, segments: 128, rings: 6} }
      pipe_b : HarborSteel { Position: {0, 52, 0}; Torus: {radius: 372.5, tube: 1.5, segments: 128, rings: 6} }
      pipe_c : HarborSteel { Position: {0, 52, 0}; Torus: {radius: 431, tube: 1.5, segments: 128, rings: 6} }
      for m in 0..32 {
        const a = m * PI / 16
        if m % 8 != 0 {
          "roof_{m}" {
            Rotation: {0, a, 0}
            HarborRoofModule unit(kind: (m * 3) % 5, mast: 25) { Position: {0, 50, 400} }
          }
        }
      }
      for p in 0..48 {
        const a = (p + 0.5) * PI / 24
        "pilaster_{p}" : HarborHullDark { Position: {cos(a) * 451.5, 10, sin(a) * 451.5}; Rotation: {0, 0 - a, 0}; Box: {4, 79, 6} }
      }
    }
    for c in 0..8 {
      "spoke_inner_{c}" {
        Rotation: {0, c * PI / 4, 0}
        HarborCorridor body(r0: 185, r1: 355, w: 35, h: 30, y: 10)
      }
    }

    for g in 0..4 {
      "gate_arm_{g}" {
        Rotation: {0, g * HALF_PI, 0}
        body : HarborHull { Position: {0, 120, 511}; Rotation: {HALF_PI, 0, 0}; ProfileExtrusion: {profile: harbor_arm, depth: 722, cap_start: true, cap_end: true} }
        for s in 0..2 {
          "glazing_{s}" : HarborWindowGrid { Position: {s == 0 ? -40.3 : 40.3, 120, 511}; Box: {0.5, 11, 700} }
        }
        pylon_inner : HarborHullDark { Position: {0, 76, 400}; Box: {55, 48, 35} }
        pylon_middle : HarborHullDark { Position: {0, 68.5, 667.5}; Box: {55, 63, 35} }
        pylon_outer : HarborHullDark { Position: {0, 94.5, 820}; Box: {60, 12, 40} }
      }
    }

    // The middle ring and its corridors to the inner ring and the hangar wall.
    ring_middle {
      body : HarborHull { Position: {0, 5, 0}; Tube: {radius: 700, thickness: 75, length: 60, segments: 160} }
      lip : HarborPanel { Position: {0, 36.5, 0}; Tube: {radius: 702.5, thickness: 12, length: 3, segments: 160} }
      HarborGlazing out_a(r: 700.25, y: -7, h: 13, seg: 160)
      HarborGlazing out_b(r: 700.25, y: 18, h: 13, seg: 160)
      HarborGlazing in_a(r: 624.75, y: 10, h: 13, seg: 160)
      ledge : HarborPanel { Position: {0, 5, 0}; Tube: {radius: 702, thickness: 2.5, length: 2, segments: 160} }
      pipe_a : HarborYellow { Position: {0, 36.5, 0}; Torus: {radius: 635, tube: 1.5, segments: 160, rings: 6} }
      pipe_b : HarborSteel { Position: {0, 36.5, 0}; Torus: {radius: 640, tube: 1.5, segments: 160, rings: 6} }
      for m in 0..48 {
        const a = m * PI / 24 + PI / 48
        "roof_{m}" {
          Rotation: {0, a, 0}
          HarborRoofModule unit(kind: (m * 2 + 1) % 5, mast: 20) { Position: {0, 35, 667.5} }
        }
      }
      for p in 0..64 {
        const a = (p + 0.5) * PI / 32
        "pilaster_{p}" : HarborHullDark { Position: {cos(a) * 701.5, 5, sin(a) * 701.5}; Rotation: {0, 0 - a, 0}; Box: {4, 59, 6} }
      }
    }
    for c in 0..8 {
      "spoke_middle_{c}" {
        Rotation: {0, PI / 8 + c * PI / 4, 0}
        HarborCorridor body(r0: 445, r1: 630, w: 30, h: 25, y: 5)
      }
      "spoke_outer_{c}" {
        Rotation: {0, c * PI / 4, 0}
        HarborCorridor body(r0: 695, r1: 780, w: 40, h: 30, y: 10)
      }
    }

    // The outer deck: the hangar wall of the rig bays, the deck in front of it and the rim.
    outer {
      deck : HarborDeck { Position: {0, -15, 0}; Tube: {radius: 1020, thickness: 245, length: 30, segments: 192} }
      skirt : HarborHullDark { Position: {0, -60, 0}; Frustum: {radius_bottom: 820, radius_top: 1020, length: 60, segments: 192, smooth: true} }
      HarborWindows edge(r: 1020.25, y: -15, n: 240, w: 13, h: 6)
      HarborWindows skirt_win(r: 925, y: -75, n: 180, w: 10, h: 4, skip: 4)
      parapet : HarborPanel { Position: {0, 4, 0}; Tube: {radius: 1020, thickness: 5, length: 8, segments: 192} }
      for l in 0..144 {
        const a = (l + 0.5) * PI / 72
        "rim_light_{l}" : HarborAmber { Position: {cos(a) * 1017.5, 8.5, sin(a) * 1017.5}; Rotation: {0, 0 - a, 0}; Box: {1.5, 1, 5} }
      }
      wall : HarborHull { Position: {0, 42.5, 0}; Tube: {radius: 860, thickness: 85, length: 85, segments: 192} }
      wall_lip : HarborPanel { Position: {0, 86.5, 0}; Tube: {radius: 863, thickness: 95, length: 4, segments: 192} }
      HarborGlazing wall_win(r: 860.25, y: 70, h: 13, seg: 192)
      HarborGlazing wall_in(r: 774.75, y: 45, h: 19.5, seg: 192)
      pipe_a : HarborYellow { Position: {0, 90, 0}; Torus: {radius: 782.5, tube: 1.75, segments: 192, rings: 6} }
      pipe_b : HarborSteel { Position: {0, 90, 0}; Torus: {radius: 788.5, tube: 1.75, segments: 192, rings: 6} }
      for m in 0..48 {
        const a = m * PI / 24 + PI / 48
        "roof_{m}" {
          Rotation: {0, a, 0}
          HarborRoofModule unit(kind: m % 5, mast: 22) { Position: {0, 88.5, 825} }
        }
      }

      for q in 0..4 {
        for b in 0..6 {
          const a = q * HALF_PI + (20 + b * 10) * PI / 180
          "buttress_{q}_{b}" {
            Rotation: {0, a, 0}
            block : HarborHullDark { Position: {0, 45, 866}; Box: {11, 90, 13} }
            cap : HarborPanel { Position: {0, 91.5, 868}; Box: {14, 4, 18} }
            strip : HarborAmber { Position: {0, 50, 872.8}; Box: {1.5, 60, 0.5} }
            foot : HarborHazard { Position: {0, 2, 875}; Box: {11, 4, 5} }
          }
        }
      }
    }

    keel {
      ring : HarborHullDark { Position: {0, -131, 0}; Tube: {radius: 660, thickness: 20, length: 15, segments: 160} }
      HarborWindows lights(r: 660.25, y: -131, n: 120, w: 9, h: 3)
      for s in 0..16 {
        const a = s * PI / 8
        "strut_{s}" : HarborPanel { Position: {cos(a) * 650, -106.5, sin(a) * 650}; Rotation: {0, 0 - a, 0}; Box: {12, 35, 10} }
      }
      for v in 0..32 {
        const a = (v + 0.5) * PI / 16
        "vane_{v}" {
          Rotation: {0, a, 0}
          panel : HarborRadiator { Position: {0, -114, 540}; Box: {1.5, 45, 100} }
          spar : HarborPanel { Position: {0, -91.5, 540}; Box: {4, 3, 100} }
        }
      }
    }
  }
}

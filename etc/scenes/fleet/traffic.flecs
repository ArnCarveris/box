using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.animation
using box.curve
using box.light
using box.movement
using box.transition
using box.text
using state

// The traffic of the station. Every ship flies one looping clip that never restarts, and the
// gates and bays read the clock of their own Animator to clamp, refuel and light up in step
// with it, so ships move without jumps and keep their distance.
//
// A gate holds three liners that take turns of 90 s. The liner of a turn sits in the berth:
// the clamp booms swing out to its flank (0-4 s), their pads press onto the hull (4-8), it
// refuels (8-38), the pads release (38-42) and the booms fold back (42-46). It then
// flies out bow first along the axis of the berth and dives away, while the next liner comes
// down from where it holds above the approach and backs into the berth (62-90). The third
// liner jumps in 11 km out above the approach (60), turns around and holds. In the frame of a
// gate +z points away from the station along the berth and y up, so liners never cross the
// rig bays between the gates.
state {
  fn harbor_mod3(v: i32) -> i32 { v >= 6 ? v - 6 : v >= 3 ? v - 3 : v }

  // The step of the turn of a gate at t (0 to 90 s).
  fn harbor_gate_step(t: f32) -> i32 {
    t < 4 ? 0 : t < 8 ? 1 : t < 38 ? 2 : t < 42 ? 3 : t < 46 ? 4 : t < 48 ? 5 : t < 75 ? 6 : 7
  }

  // The step of a rig bay at t (0 to 150 s): arrive, descend, settle, boom in, refuel, boom
  // out, wait, lift, turn and depart.
  fn harbor_bay_step(t: f32) -> i32 {
    t < 40 ? 0 : t < 56 ? 1 : t < 58 ? 2 : t < 61 ? 3 : t < 88 ? 4 : t < 91 ? 5 : t < 94 ? 6 : t < 110 ? 7 : t < 116 ? 8 : 9
  }

  // Whether a liner of a role (0 docked, 1 leaving and arriving, 2 holding) fires its drives in
  // a step of its gate.
  fn harbor_liner_burn(role: i32, step: i32) -> bool {
    (role == 0 && step >= 5) || role == 1 || (role == 2 && step <= 1)
  }

  // The number of whole units in x, at most n.
  fn harbor_ticks(x: f32, n: i32) -> i32 {
    mut c: i32 = 0
    for i in 0..n {
      if x >= i + 1 {
        c += 1
      }
    }
    c
  }

  fn harbor_liner_design(kind: i32) -> LinerDesign {
    match kind {
      0: passenger_design
      1: freighter_design
      _: tender_design
    }
  }

  fn harbor_rem3(v: i32) -> i32 {
    mut r: i32 = v
    for i in 0..12 {
      if r >= 3 {
        r -= 3
      }
    }
    r
  }

  fn harbor_rig_design(idx: i32) -> RigDesign {
    match harbor_rem3(idx) {
      0: frigate_design
      1: scout_design
      _: miner_design
    }
  }
}

assets {
  harbor_dock_upper_shape { Path2D: {start: {-50, -105}, segments: [
    {kind: Line, end: {95, -105}}, {kind: Line, end: {95, -150}}, {kind: Line, end: {-30, -150}},
    {kind: Line, end: {-50, -130}}
  ], closed: true} }
  harbor_dock_upper { Profile2D: {outer: harbor_dock_upper_shape} }
  harbor_dock_lower_shape { Path2D: {start: {-50, -105}, segments: [
    {kind: Line, end: {-50, 40}}, {kind: Line, end: {-30, 60}}, {kind: Line, end: {15, 60}},
    {kind: Line, end: {30, 45}}, {kind: Line, end: {30, -105}}
  ], closed: true} }
  harbor_dock_lower { Profile2D: {outer: harbor_dock_lower_shape} }

  prefab harbor_gate_clock { Clip: {duration: 270} }
  prefab harbor_bay_clock { Clip: {duration: 150} }

  // The 270 s of a liner, for its center in the frame of its gate: docked with its bow out
  // (0-46), out of the berth and down away from the station (46-132), gone (132-150), in from
  // the jump point above the approach (150-200), turned around (200-222), holding above the
  // approach (222-242) and down and back into the berth stern first (242-270).
  prefab harbor_liner_cycle {
    Clip: {duration: 270}
    y { Track: {component: box.transform.Position, member: "y", curve: {kind: CurveBezier, keys: [
      {time: 0, value: 0, out: 0}, {time: 52, value: 0, in: 0, out: 0}, {time: 80, value: -700, in: -30, out: -30},
      {time: 132, value: -1600, in: -10, out: 0}, {time: 149.9, value: -1600, in: 0, out: 0},
      {time: 150, value: 1500, in: 0, out: -51}, {time: 200, value: 650, in: 0, out: 0},
      {time: 242, value: 650, in: 0, out: 0}, {time: 266, value: 0, in: 0, out: 0}, {time: 270, value: 0, in: 0}
    ]}} }
    z { Track: {component: box.transform.Position, member: "z", curve: {kind: CurveBezier, keys: [
      {time: 0, value: 420, out: 0}, {time: 46, value: 420, in: 0, out: 0}, {time: 80, value: 2620, in: 110, out: 110},
      {time: 132, value: 11420, in: 200, out: 0}, {time: 149.9, value: 11420, in: 0, out: 0},
      {time: 150, value: 11620, in: 0, out: -594}, {time: 200, value: 1720, in: 0, out: 0},
      {time: 242, value: 1720, in: 0, out: 0}, {time: 270, value: 420, in: 0}
    ]}} }
    yaw { Track: {component: box.transform.Rotation, member: "y", curve: {kind: CurveBezier, keys: [
      {time: 0, value: 0, out: 0}, {time: 149.9, value: 0, in: 0, out: 0}, {time: 150, value: 3.1415927, in: 0, out: 0},
      {time: 200, value: 3.1415927, in: 0, out: 0}, {time: 222, value: 6.2831853, in: 0, out: 0},
      {time: 270, value: 6.2831853, in: 0}
    ]}} }
    fade { Track: {component: Opacity, member: "value", curve: {keys: [
      {0, 1}, {130, 1}, {132, 0}, {150, 0}, {151.5, 1}, {270, 1}
    ]}} }
  }

  // The flashes of the jump points of a gate, every turn: a liner arrives at 60 s and one
  // leaves at 42 s.
  prefab harbor_flash_in {
    Clip: {duration: 90}
    x { Track: {component: box.transform.Scale, member: "x", curve: {keys: [{0, 0.01}, {60, 0.01}, {60.25, 480}, {61.8, 0.01}, {90, 0.01}]}} }
    y { Track: {component: box.transform.Scale, member: "y", curve: {keys: [{0, 0.01}, {60, 0.01}, {60.25, 480}, {61.8, 0.01}, {90, 0.01}]}} }
    z { Track: {component: box.transform.Scale, member: "z", curve: {keys: [{0, 0.01}, {60, 0.01}, {60.25, 480}, {61.8, 0.01}, {90, 0.01}]}} }
  }
  prefab harbor_flash_in_light {
    Clip: {duration: 90}
    i { Track: {component: PointLight, member: "intensity", curve: {keys: [{0, 0}, {60, 0}, {60.2, 60000000}, {62, 0}, {90, 0}]}} }
  }
  prefab harbor_flash_out {
    Clip: {duration: 90}
    x { Track: {component: box.transform.Scale, member: "x", curve: {keys: [{0, 0.01}, {41.8, 0.01}, {42.05, 480}, {43.6, 0.01}, {90, 0.01}]}} }
    y { Track: {component: box.transform.Scale, member: "y", curve: {keys: [{0, 0.01}, {41.8, 0.01}, {42.05, 480}, {43.6, 0.01}, {90, 0.01}]}} }
    z { Track: {component: box.transform.Scale, member: "z", curve: {keys: [{0, 0.01}, {41.8, 0.01}, {42.05, 480}, {43.6, 0.01}, {90, 0.01}]}} }
  }
  prefab harbor_flash_out_light {
    Clip: {duration: 90}
    i { Track: {component: PointLight, member: "intensity", curve: {keys: [{0, 0}, {41.8, 0}, {42, 60000000}, {43.8, 0}, {90, 0}]}} }
  }

  // The 150 s of a rig, in the frame of its bay (+z away from the station, deck at y = 0): in
  // from its jump point (0-40), over the rim and down onto the deck nose first (40-56), parked
  // (56-94), up and back out over the rim (94-110), turned around (110-116) and away (116-146).
  prefab harbor_rig_cycle {
    Clip: {duration: 150}
    y { Track: {component: box.transform.Position, member: "y", curve: {kind: CurveBezier, keys: [
      {time: 0, value: 1300, out: -87.75}, {time: 40, value: 130, in: 0, out: 0}, {time: 50, value: 30, in: 0, out: 0},
      {time: 56, value: 1, in: 0, out: 0}, {time: 94, value: 1, in: 0, out: 0}, {time: 100, value: 30, in: 0, out: 0},
      {time: 110, value: 130, in: 0, out: 0}, {time: 116, value: 130, in: 0, out: 0}, {time: 146, value: 1300, in: 117, out: 0},
      {time: 150, value: 1300, in: 0}
    ]}} }
    z { Track: {component: box.transform.Position, member: "z", curve: {kind: CurveBezier, keys: [
      {time: 0, value: 2100, out: -145.125}, {time: 40, value: 165, in: 0, out: 0}, {time: 50, value: 0, in: 0, out: 0},
      {time: 100, value: 0, in: 0, out: 0}, {time: 110, value: 165, in: 0, out: 0}, {time: 116, value: 165, in: 0, out: 0},
      {time: 146, value: 2100, in: 193.5, out: 0}, {time: 150, value: 2100, in: 0}
    ]}} }
    yaw { Track: {component: box.transform.Rotation, member: "y", curve: {kind: CurveBezier, keys: [
      {time: 0, value: 3.1415927, out: 0}, {time: 110, value: 3.1415927, in: 0, out: 0},
      {time: 116, value: 6.2831853, in: 0, out: 0}, {time: 150, value: 6.2831853, in: 0}
    ]}} }
    fade { Track: {component: Opacity, member: "value", curve: {keys: [{0, 0}, {1.5, 1}, {144.5, 1}, {146, 0}, {150, 0}]}} }
  }
  prefab harbor_rig_flash {
    Clip: {duration: 150}
    x { Track: {component: box.transform.Scale, member: "x", curve: {keys: [{0, 40}, {1.2, 0.01}, {145.9, 0.01}, {146.1, 40}, {147.4, 0.01}, {149.8, 0.01}, {150, 40}]}} }
    y { Track: {component: box.transform.Scale, member: "y", curve: {keys: [{0, 40}, {1.2, 0.01}, {145.9, 0.01}, {146.1, 40}, {147.4, 0.01}, {149.8, 0.01}, {150, 40}]}} }
    z { Track: {component: box.transform.Scale, member: "z", curve: {keys: [{0, 40}, {1.2, 0.01}, {145.9, 0.01}, {146.1, 40}, {147.4, 0.01}, {149.8, 0.01}, {150, 40}]}} }
  }

  prefab harbor_fuel_flow {
    Clip: {duration: 3}
    z { Track: {component: box.transform.Position, member: "z", curve: {keys: [{0, -150}, {3, 160}]}} }
  }
  prefab harbor_boom_flow {
    Clip: {duration: 1.5}
    x { Track: {component: box.transform.Position, member: "x", curve: {keys: [{0, -1}, {1.5, -15}]}} }
  }
  prefab HarborPulse { Rgb: {120, 240, 255}; Emissive: {strength: 14, color: {90, 220, 255}}; NoShadow }

  // A clamp boom on the wall of a dock, hinged at the origin on a vertical axis. It lies folded
  // along the wall (-z, or +z when fold is -1) when not down and swings out (+x) to the near flank
  // of a liner when down, and set pushes its pad onto the hull, reach out from the hinge. fueling
  // lights the fuel line along its top.
  template HarborClamp {
    prop down: bool = false
    prop set: bool = false
    prop fueling: bool = false
    prop fold: f32 = 1
    prop reach: f32 = 29
    mount : HarborHullDark { Position: {3.5, 0, 0}; Box: {7, 30, 22} }
    hinge : HarborSteel { Position: {9, 0, 0}; Cylinder: {radius: 4, length: 26, segments: 12} }
    arm {
      Position: {9, 0, 0}
      Rotation: {0, down ? 0 : fold * HALF_PI, 0}
      Transition: [Rotation: {duration: 4, timing_function: EaseInOut}]
      beam : HarborYellow { Position: {(reach - 10) / 2, 0, 0}; Box: {reach - 10, 9, 9} }
      head : HarborYellow { Position: {reach - 7, 0, 0}; Box: {6, 20, 14} }
      for f in 0..2 {
        const fz = f == 0 ? 0 - 4.6 : 4.6
        "glow_{f}" : HarborAmber { Position: {(reach - 10) / 2, 0, fz}; Box: {reach - 14, 2, 0.4} }
      }
      line {
        Position: {(reach - 10) / 2, 4.7, 0}
        Box: {reach - 14, 0.4, 2.5}
        Rgb: {120, 240, 255}
        Emissive: {strength: fueling ? 12 : 0.5, color: {90, 220, 255}}
        Transition: [Emissive: {duration: 0.8, timing_function: EaseInOut}]
      }
      pad {
        Position: {set ? reach - 3.2 : reach - 6, 0, 0}
        Transition: [Position: {duration: 4, timing_function: EaseInOut}]
        ram : HarborSteel { Position: {-3, 0, 0}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: 2.5, length: 6, segments: 10} }
        shoe : HarborPanel { Box: {4, 18, 12} }
        rubber : HarborRubber { Position: {2.6, 0, 0}; Box: {1.2, 16, 10} }
      }
      lamp {
        Position: {reach - 7, 11, 0}
        Sphere: {radius: 1.5, segments: 8}
        if set {
          Rgb: {110, 240, 130}
          Emissive: {strength: 8, color: {90, 255, 110}}
        } else {
          Rgb: {255, 80, 60}
          Emissive: {strength: 8, color: {255, 60, 40}}
        }
      }
    }
  }

  // A liner gate on the rim of the station, in its own frame: the rim at z = 0, +z away from the
  // station and the deck at y = 0. The dock is a hall that continues the arm of the station out
  // past the rim. The liner berths alongside it (+x) with its bow out, its near pods in the cutout
  // under the overhang with the label, where two clamp booms on the wall swing out to them.
  template LinerGate {
    prop idx: i32 = 0
    prop label: string = "NORTH GATE"
    mut turn: i32 = 0
    mut step: i32 = 0
    mut fuel: i32 = 0

    const offset = idx * 22.5
    Animator: {clip: harbor_gate_clock, time: offset, speed: 1, mode: Loop}

    const down = step <= 3
    const set = step == 1 || step == 2
    const fueling = step == 2

    dock {
      upper : HarborHull { Position: {0, 0, 55}; Rotation: {HALF_PI, 0, 0}; ProfileExtrusion: {profile: harbor_dock_upper, depth: 410, cap_start: true, cap_end: true} }
      lower : HarborHull { Position: {0, 0, 30}; Rotation: {HALF_PI, 0, 0}; ProfileExtrusion: {profile: harbor_dock_lower, depth: 360, cap_start: true, cap_end: true} }
      wall_glazing : HarborWindowGrid { Position: {30.6, 50, 30}; Box: {1, 16, 340} }
      ceiling_light : HarborAmber { Position: {62.5, 104.7, 55}; Box: {65, 0.6, 400} }
      beam : HarborYellow { Position: {91, 101, 55}; Box: {8, 8, 410} }
      beam_light : HarborAmber { Position: {95.3, 101, 55}; Box: {0.6, 2, 400} }

      for s in 0..2 {
        const sx = s == 0 ? 0 - 1 : 1
        const fx = s == 0 ? -50.6 : 95.6
        const sy = s == 0 ? 100 : 127.5
        "side_{s}" {
          sign : HarborSign { Position: {fx, sy, 55}; Box: {1, 40, 380} }
          title {
            Position: {fx + sx * 0.8, sy + 6, 55}
            Rotation: {0, sx * HALF_PI, 0}
            Text: {value: label, size: 26, align: Center}
            Rgb: {235, 238, 245}
            Emissive: {strength: 1.5, color: {235, 238, 245}}
          }
          subtitle {
            Position: {fx + sx * 0.8, sy - 11, 55}
            Rotation: {0, sx * HALF_PI, 0}
            Text: {value: "LINER DOCK {idx}", size: 11, align: Center}
            Rgb: {255, 190, 90}
            Emissive: {strength: 2, color: {255, 170, 60}}
          }
          trim : HarborAmber { Position: {fx + sx * 0.6, sy - 18, 55}; Box: {0.6, 1.5, 380} }
        }
      }
      for g in 0..12 {
        "gauge_{g}" {
          Position: {30.6, 18 + g * 5, 190}
          Box: {1, 3.5, 10}
          if g < fuel {
            Rgb: {110, 240, 130}
            Emissive: {strength: 8, color: {90, 255, 110}}
          } else {
            Rgb: {40, 44, 52}
            Emissive: {strength: 0.5, color: {255, 60, 40}}
          }
        }
      }
      glazing_a : HarborWindowGrid { Position: {-50.6, 40, 55}; Box: {1, 15, 380} }
      glazing_b : HarborWindowGrid { Position: {-50.6, -20, 30}; Box: {1, 15, 300} }
      end_glazing_a : HarborWindowGrid { Position: {22.5, 127, 260.6}; Box: {120, 14, 1} }
      end_glazing_b : HarborWindowGrid { Position: {-10, 40, 210.6}; Box: {70, 14, 1} }

      for m in 0..3 {
        HarborMast "mast_{m}"(h: m == 1 ? 30 : 20) { Position: {20, 150, -100 + m * 150} }
      }
      for v in 0..4 {
        "vent_{v}" : HarborPanel { Position: {v % 2 == 0 ? -15 : 55, 152.5, v < 2 ? -40 : 140}; Box: {15, 5, 25} }
      }

      fuel_line : HarborYellow { Position: {33, -24, 5}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 2, length: 310, segments: 10} }
      fuel_drop : HarborYellow { Position: {33, -19.5, 160}; Cylinder: {radius: 2, length: 9, segments: 8} }
      if fueling {
        for p in 0..8 {
          "pulse_{p}" : HarborPulse {
            Position: {33, -24, -150}
            Sphere: {radius: 3, segments: 10}
            Animator: {clip: harbor_fuel_flow, time: p * 0.375, speed: 1, mode: Loop}
          }
        }
      }

      for f in 0..2 {
        "flood_{f}" {
          Position: {55, 103, f == 0 ? 120 : 160}
          Rotation: {0, 0 - HALF_PI, 0}
          lamp {
            Rotation: {-1.35, 0, 0}
            housing : HarborPanel { Position: {0, 0, 2}; Box: {8, 5, 4} }
            lens : HarborWindowCool { Position: {0, 0, -0.1}; Box: {7, 4, 0.2} }
            Rgb: {255, 240, 220}
            SpotLight: {intensity: 300000, range: 400, inner_angle: 30, outer_angle: 46, shadows: true, shadow_resolution: 1024}
          }
        }
      }
    }

    HarborClamp clamp_aft(down: down, set: set, reach: 25) { Position: {30, 0, 120} }
    HarborClamp clamp_fore(down: down, set: set, fueling: fueling, fold: -1, reach: 29) { Position: {30, 0, 160} }

    // The berth of the liners alongside the dock, with the jump points where a liner arrives and
    // where one leaves.
    berth {
      Position: {170, 0, 0}
      flash_in : HarborFlash {
        Position: {0, 1500, 11620}
        Scale: {0.01, 0.01, 0.01}
        Sphere: {radius: 1, segments: 32, smooth: true}
        Animator: {clip: harbor_flash_in, time: offset, speed: 1, mode: Loop}
      }
      flash_in_light {
        Position: {0, 1500, 11620}
        Rgb: {170, 215, 255}
        PointLight: {intensity: 0, range: 9000}
        Animator: {clip: harbor_flash_in_light, time: offset, speed: 1, mode: Loop}
      }
      flash_out : HarborFlash {
        Position: {0, -1600, 11420}
        Scale: {0.01, 0.01, 0.01}
        Sphere: {radius: 1, segments: 32, smooth: true}
        Animator: {clip: harbor_flash_out, time: offset, speed: 1, mode: Loop}
      }
      flash_out_light {
        Position: {0, -1600, 11420}
        Rgb: {170, 215, 255}
        PointLight: {intensity: 0, range: 9000}
        Animator: {clip: harbor_flash_out_light, time: offset, speed: 1, mode: Loop}
      }

      // The three liners. Liner k is 90 s ahead of liner k - 1 in the cycle, the one docked in
      // turn n is the one with (n + k) % 3 == 0.
      for k in 0..3 {
        "liner_{k}" {
          Animator: {clip: harbor_liner_cycle, time: k * 90 + offset, speed: 1, mode: Loop}
        }
      }
      for k in 0..3 {
        "liner_{k}" {
          Liner hull(design: harbor_liner_design(harbor_mod3(idx + k)), burning: harbor_liner_burn(harbor_mod3(turn + k), step)) {
            Position: {0, 0, 0}
          }
        }
      }
    }

    async {
      while true {
        await next_frame()
        const c = this[Animator].time
        const n = c < 90 ? 0 : c < 180 ? 1 : 2
        const t = c - n * 90
        const s = harbor_gate_step(t)
        const f = s < 2 ? 0 : s > 2 ? 12 : harbor_ticks((t - 8) / 2.5, 12)
        if n != turn {
          turn = n
        }
        if s != step {
          step = s
        }
        if f != fuel {
          fuel = f
        }
      }
    }
  }

  // A rig bay on the outer deck, in its own frame: the deck at y = 0, +z away from the station
  // and the hangar door of the bay in the wall at z = -55.
  template RigBay {
    prop idx: i32 = 0
    mut step: i32 = 0
    mut fuel: i32 = 0

    const offset = idx * 7.5
    Animator: {clip: harbor_bay_clock, time: offset, speed: 1, mode: Loop}

    const busy = step >= 1 && step <= 8
    const hazard = step == 1 || step == 7
    const boom_in = step == 3 || step == 4
    const fueling = step == 4
    const burn = step <= 1 || step >= 7

    edge_a : HarborHazard { Position: {0, 0.15, 34}; Box: {38.5, 0.3, 2.5} }
    edge_b : HarborHazard { Position: {0, 0.15, -34}; Box: {38.5, 0.3, 2.5} }
    edge_c : HarborHazard { Position: {18, 0.15, 0}; Box: {2.5, 0.3, 68} }
    edge_d : HarborHazard { Position: {-18, 0.15, 0}; Box: {2.5, 0.3, 68} }
    for l in 0..7 {
      "guide_{l}" {
        Position: {0, 0.25, -30 + l * 10}
        Box: {1.5, 0.5, 4}
        if busy {
          Rgb: {255, 180, 70}
          Emissive: {strength: 6, color: {255, 160, 50}}
        } else {
          Rgb: {96, 220, 240}
          Emissive: {strength: 5, color: {80, 214, 255}}
        }
      }
    }
    for c in 0..4 {
      "corner_{c}" {
        Position: {c < 2 ? -18 : 18, 1, c % 2 == 0 ? -34 : 34}
        dome : HarborAmber { Position: {0, 0, 0}; Sphere: {radius: 1, segments: 10} }
        if hazard {
          glow : HarborBeaconAmber { Position: {0, 0, 0}; Sphere: {radius: 1.3, segments: 10} }
          Rgb: {255, 160, 60}
          PointLight: {intensity: 1500, range: 60}
        }
      }
    }

    door {
      Position: {0, 0, -54.5}
      panel : HarborPanel { Position: {0, 11, 0}; Box: {36, 22, 1} }
      seam : HarborHullDark { Position: {0, 11, 0.6}; Box: {0.8, 21.5, 0.3} }
      top : HarborYellow { Position: {0, 23, 0.5}; Box: {40, 3, 2} }
      side_a : HarborYellow { Position: {19.5, 11, 0.5}; Box: {3, 22, 2} }
      side_b : HarborYellow { Position: {-19.5, 11, 0.5}; Box: {3, 22, 2} }
      bar : HarborAmber { Position: {0, 26, 0.5}; Box: {32, 1.5, 0.5} }
      sign : HarborSign { Position: {0, 34, 0.25}; Box: {20, 11, 1} }
      number {
        Position: {0, 34, 0.9}
        Text: {value: idx < 9 ? "0{idx + 1}" : "{idx + 1}", size: 9, align: Center}
        Rgb: {240, 240, 245}
        Emissive: {strength: 1.5, color: {240, 240, 245}}
      }
      if busy {
        light {
          Position: {0, 28, 15}
          Rgb: {255, 190, 120}
          PointLight: {intensity: 12000, range: 130}
        }
      }
    }

    tower : HarborHullDark { Position: {23, 10, 0}; Box: {4, 20, 4} }
    for g in 0..8 {
      "gauge_{g}" {
        Position: {20.9, 2 + g * 2, 0}
        Box: {0.2, 1.4, 2.5}
        if g < fuel {
          Rgb: {110, 240, 130}
          Emissive: {strength: 6, color: {90, 255, 110}}
        } else {
          Rgb: {40, 44, 52}
          Emissive: {strength: 0.4, color: {255, 60, 40}}
        }
      }
    }
    boom {
      Position: {23, 21, 0}
      Rotation: {0, boom_in ? 0 : 0 - HALF_PI, 0}
      Transition: [Rotation: {duration: 3, timing_function: EaseInOut}]
      hub : HarborPanel { Position: {0, 0, 0}; Cylinder: {radius: 1.5, length: 2, segments: 12} }
      arm : HarborYellow { Position: {-8, 0, 0}; Box: {16, 1.5, 1.5} }
      hose : HarborRubber { Position: {-15.5, -3.5, 0}; Cylinder: {radius: 0.5, length: 7, segments: 8} }
      nozzle {
        Position: {-15.5, -7.5, 0}
        Cylinder: {radius: 0.8, length: 1, segments: 10}
        Rgb: {120, 240, 255}
        Emissive: {strength: fueling ? 10 : 0.5, color: {90, 220, 255}}
        Transition: [Emissive: {duration: 0.6, timing_function: EaseInOut}]
      }
      if fueling {
        for p in 0..3 {
          "pulse_{p}" : HarborPulse {
            Position: {-1, 1, 0}
            Sphere: {radius: 0.6, segments: 8}
            Animator: {clip: harbor_boom_flow, time: p * 0.5, speed: 1, mode: Loop}
          }
        }
      }
    }

    ship {
      Animator: {clip: harbor_rig_cycle, time: offset, speed: 1, mode: Loop}
      Rig hull(design: harbor_rig_design(idx), burning: burn) {
        Position: {0, 0, 0}
      }
    }
    flash : HarborFlash {
      Position: {0, 1300, 2100}
      Scale: {0.01, 0.01, 0.01}
      Sphere: {radius: 1, segments: 24, smooth: true}
      Animator: {clip: harbor_rig_flash, time: offset, speed: 1, mode: Loop}
    }

    async {
      while true {
        await next_frame()
        const t = this[Animator].time
        const s = harbor_bay_step(t)
        const f = s < 4 ? 0 : s > 4 ? 8 : harbor_ticks((t - 61) / 3.375, 8)
        if s != step {
          step = s
        }
        if f != fuel {
          fuel = f
        }
      }
    }
  }
}

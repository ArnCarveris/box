    cradle_tip : HarborYellow { Position: {186, -190, 0}; Rotation: {0, 0, PI / 4}; Box: {40, 40, 30} }
    cradle_stripe : HarborHazard { Position: {186, -190, 15.2}; Rotation: {0, 0, PI / 4}; Box: {30, 30, 0.6} }
    for s in 0..6 {
      "cradle_rib_{s}" : HarborHullDark { Position: {-130 + s * 56, -190, 0}; Box: {6, 21, 29} }
    }
    tip_lamp : HarborBeaconAmber { Position: {186, -213, 0}; Sphere: {radius: 3, segments: 8} }

    HarborRam ram_ul(set: set, reach: reach) { Rotation: {0, 0, PI / 4} }
    HarborRam ram_ll(set: set, reach: reach) { Rotation: {0, 0, 3 * PI / 4} }
    HarborRam ram_lr(set: set, reach: reach) { Rotation: {0, 0, 0 - 3 * PI / 4} }

    arm {
      Position: {-190, 190, 0}
      Rotation: {0, 0, down ? 0 : 1.7}
      Transition: [Rotation: {duration: 4, timing_function: EaseInOut}]
      riser : HarborYellow { Position: {35, 30, 0}; Rotation: {0, 0, 0.7086}; Box: {92, 34, 30} }
      riser_web : HarborHullDark { Position: {35, 30, 0}; Rotation: {0, 0, 0.7086}; Box: {80, 22, 31} }
      joint_a : HarborYellow { Position: {72, 60, 0}; Box: {40, 40, 34} }
      chord_top : HarborYellow { Position: {190, 74, 0}; Box: {240, 8, 28} }
      chord_bottom : HarborYellow { Position: {190, 46, 0}; Box: {240, 8, 28} }

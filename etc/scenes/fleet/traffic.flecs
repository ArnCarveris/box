using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.animation
using box.curve
using box.light
using box.movement
using box.transition
using box.text
using state

// The traffic of the station. Every ship flies one looping clip that never restarts, and the
// gates and bays read the clock of their own Animator to clamp, refuel and light up in step
// with it, so ships move without jumps and keep their distance.
//
// A gate holds three liners that take turns of 90 s: one berths and refuels, one holds above
// the approach and one leaves and jumps back in.
state {
  fn harbor_mod3(v: i32) -> i32 { v >= 6 ? v - 6 : v >= 3 ? v - 3 : v }

  // The step of the turn of a gate at t (0 to 90 s).
  fn harbor_gate_step(t: f32) -> i32 {
    t < 4 ? 0 : t < 8 ? 1 : t < 38 ? 2 : t < 42 ? 3 : t < 46 ? 4 : t < 48 ? 5 : t < 75 ? 6 : 7
  }

  // The step of the turn of a rig bay at t (0 to 150 s): arrive, descend, settle, boom in,
  // refuel, boom out, wait, lift, turn and depart.
  fn harbor_bay_step(t: f32) -> i32 {
    t < 40 ? 0 : t < 56 ? 1 : t < 58 ? 2 : t < 61 ? 3 : t < 88 ? 4 : t < 91 ? 5 :
      t < 94 ? 6 : t < 110 ? 7 : t < 116 ? 8 : 9
  }

  // Whether a liner of a role (0 docked, 1 leaving and arriving, 2 holding) fires its drives in
  // a step of its gate.
  fn harbor_liner_burn(role: i32, step: i32) -> bool {
    (role == 0 && step >= 5) || role == 1 || (role == 2 && step <= 1)
  }

  fn harbor_ticks(x: f32, n: i32) -> i32 {
    mut c: i32 = 0

    for i in 0..n {
      if x >= i + 1 {
        c += 1
      }
    }

    c
  }

  // Whether a rig fires its drives in a step of its bay, as the rig in the bay or as the one
  // that waits its turn.
  fn harbor_rig_burn(docked: bool, step: i32) -> bool {
    docked ? step <= 1 || step >= 7 : step <= 4
  }

  fn harbor_liner_design(kind: i32) -> LinerDesign {
    match kind {
      0: passenger_design
      1: freighter_design
      _: tender_design
    }
  }

  fn harbor_rem3(v: i32) -> i32 {
    mut r: i32 = v

    for i in 0..12 {
      if r >= 3 {
        r -= 3
      }
    }

    r
  }

  fn harbor_rig_design(idx: i32) -> RigDesign {
    match harbor_rem3(idx) {
      0: frigate_design
      1: scout_design
      _: miner_design
    }
  }
}

assets {
  prefab harbor_gate_clock { Clip: {duration: 270} }
  prefab harbor_bay_clock { Clip: {duration: 300} }

  // The 270 s of a liner, for its center in the frame of its gate: docked (0-46), leaving

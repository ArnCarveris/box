  template HarborDockClamp {
    prop down: bool = false
    prop set: bool = false
    prop reach: f32 = 30

    top_car : HarborPanel { Position: {-190, 170, 0}; Box: {50, 24, 64} }
    bottom_car : HarborPanel { Position: {-190, -190, 0}; Box: {50, 20, 64} }
    for w in 0..4 {
      "wheel_top_{w}" : HarborSteel { Position: {w < 2 ? -208 : -172, 158, w % 2 == 0 ? -22 : 22}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: 5, length: 10, segments: 10} }
      "wheel_bottom_{w}" : HarborSteel { Position: {w < 2 ? -208 : -172, -200, w % 2 == 0 ? -22 : 22}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: 5, length: 10, segments: 10} }
    }
    column : HarborYellow { Position: {-190, -11, 0}; Box: {24, 338, 32} }
    column_web : HarborHullDark { Position: {-177.7, 10, 0}; Box: {0.6, 240, 14} }
    column_foot : HarborHazard { Position: {-177.7, -155, 0}; Box: {0.6, 36, 32} }
    for l in 0..3 {
      "column_lamp_{l}" : HarborAmber { Position: {-177.4, -100 + l * 90, 0}; Box: {0.4, 4, 8} }
    }
    drum : HarborSteel { Position: {-190, 190, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 15, length: 46, segments: 16} }
    for g in 0..2 {
      "gear_{g}" : HarborPanel { Position: {-190, 190, g == 0 ? -26 : 26}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 22, length: 6, segments: 16} }

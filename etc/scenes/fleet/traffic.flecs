  // A rotating amber beacon that spins and lights up while on.
  template HarborHazardLight {
    prop on: bool = false
    base : HarborPanel { Position: {0, 4, 0}; Cylinder: {radius: 7, length: 8, segments: 12} }
    dome : HarborAmber { Position: {0, 12, 0}; Sphere: {radius: 6, segments: 12} }
    head {
      Position: {0, 12, 0}
      if on {
        AngularVelocity: {0, 4, 0}
        glow : HarborBeaconAmber { Position: {0, 0, 0}; Sphere: {radius: 7, segments: 12} }
        beam {
          Rotation: {0.35, 0, 0}
          Rgb: {255, 160, 60}
          SpotLight: {intensity: 400000, range: 1400, inner_angle: 8, outer_angle: 14}
        }
      }
    }
  }

  // A liner gate on the rim of the station, in its own frame: the gate house on the station side
  // (-x) with the liner berthed alongside it, open above, below and on the outer side, and two
  // clamp portals that ride rails along the berth face and lower their arms over the liner.
  template LinerGate {
    prop idx: i32 = 0
    prop label: string = "NORTH GATE"
    mut turn: i32 = 0
    mut step: i32 = 0
    mut fuel: i32 = 0

    const offset = idx * 22.5
    Animator: {clip: harbor_gate_clock, time: offset, speed: 1, mode: Loop}

    const down = step <= 3
    const set = step == 1 || step == 2
    const fueling = step == 2
    const hazard = step == 0 || step >= 4
    const front_k = step >= 5 ? harbor_mod3(2 - turn + 3) : harbor_mod3(3 - turn)
    const front_z = harbor_mod3(idx + front_k) == 2 ? 220 : 300

    house {
      core : HarborHull { Position: {-370, -30, -12.5}; Box: {300, 400, 525}; Bevel: {top_left: 30, bottom_left: 30, front_right: 20, back_right: 20, front_left: 20, back_left: 20, segments: 2} }
      for b in 0..4 {
        "glazing_{b}" : HarborWindowGrid { Position: {-219.5, 92 - b * 62, -12.5}; Box: {1, 36, 470} }
      }
      for l in 0..5 {
        "ledge_{l}" : HarborHullDark { Position: {-218, 123 - l * 62, -12.5}; Box: {5, 5, 485} }
      }
      for p in 0..9 {
        "pilaster_{p}" : HarborHullDark { Position: {-217.5, -30, -240 + p * 57}; Box: {6, 320, 9} }
      }
      for j in 0..3 {
        "jetway_{j}" {
          Position: {-210, -6, -150 + j * 150}
          tube : HarborPanel { Box: {20, 14, 18} }
          door : HarborWindow { Position: {10.2, 0, 0}; Box: {0.4, 8, 10} }
          lamp : HarborAmber { Position: {0, 8, 0}; Box: {6, 1.2, 6} }
        }
      }
      for h in 0..2 {
        "service_bay_{h}" {
          Position: {-219, -110, h == 0 ? -95 : 95}
          recess : HarborHullDark { Position: {0.6, 0, 0}; Box: {1, 64, 90} }
          inner : HarborWindowCool { Position: {0.8, -6, 0}; Box: {0.4, 44, 76} }
          shutter : HarborPanel { Position: {1.2, 14, 0}; Box: {0.6, 22, 80} }
          frame_top : HarborYellow { Position: {2, 33, 0}; Box: {4, 4, 96} }
          frame_a : HarborYellow { Position: {2, 0, 46}; Box: {4, 66, 4} }
          frame_b : HarborYellow { Position: {2, 0, -46}; Box: {4, 66, 4} }
          sill : HarborHazard { Position: {2, -32, 0}; Box: {4, 3, 96} }
          lamp_a : HarborBeaconAmber { Position: {4, 37, 40}; Sphere: {radius: 2.5, segments: 8} }
          lamp_b : HarborBeaconAmber { Position: {4, 37, -40}; Sphere: {radius: 2.5, segments: 8} }
        }
      }
      catwalk : HarborPanel { Position: {-214, -170, -12.5}; Box: {12, 2, 500} }
      catwalk_lights : HarborAmber { Position: {-208.4, -169, -12.5}; Box: {0.6, 0.8, 490} }
      for e in 0..2 {
        const ez = e == 0 ? -275.6 : 250.6
        const ef = e == 0 ? 0 - 1 : 1
        "end_{e}" {
          for b in 0..3 {
            "glazing_{b}" : HarborWindowGrid { Position: {-380, 120 - b * 70, ez}; Box: {230, 30, 1} }
          }
          ledge : HarborHullDark { Position: {-380, 153, ez + ef * 1.5}; Box: {240, 4, 3} }
          if e == 0 {
            mark {
              Position: {-370, -150, ez - 1.2}
              Rotation: {0, PI, 0}
              Text: {value: "DOCK {idx}", size: 40, align: Center}
              Rgb: {235, 238, 245}
              Emissive: {strength: 1.5, color: {235, 238, 245}}
            }
            mark_plate : HarborSign { Position: {-370, -150, ez - 0.4}; Box: {160, 56, 1} }
          }
        }
      }
      for b in 0..2 {
        "back_glazing_{b}" : HarborWindowGrid { Position: {-520.5, 60 - b * 90, -12.5}; Box: {1, 30, 420} }
      }

      for w in 0..2 {
        const wz = w == 0 ? -355 : 330
        const wf = w == 0 ? 0 - 1 : 1
        "shoulder_{w}" {
          block : HarborHull { Position: {-400, 40, wz}; Box: {280, 150, 160}; Bevel: {top_right: 30, top_left: 20, front_right: 14, back_right: 14, segments: 2} }
          glazing : HarborWindowGrid { Position: {-259.5, 50, wz}; Box: {1, 40, 130} }
          glazing_end : HarborWindowGrid { Position: {-410, 50, wz + wf * 80.5}; Box: {200, 40, 1} }
          band : HarborHazard { Position: {-400, 112, wz + wf * 80.5}; Box: {220, 2, 0.6} }
          HarborRadiators fins(n: 8, l: 60, h: 20) { Position: {-420, 115, wz + wf * 10}; Rotation: {0, HALF_PI, 0} }
          HarborMast mast(h: 60) { Position: {-510, 115, wz + wf * 55} }
          for k in 0..3 {
            "buttress_{k}" : HarborHullDark { Position: {-300 - k * 80, -60, wz + wf * 77}; Box: {24, 140, 14} }
          }
        }
      }

      pier : HarborHullDark { Position: {-370, -290, -10}; Box: {260, 120, 400}; Bevel: {bottom_left: 30, bottom_right: 40, segments: 2} }
      pier_glazing : HarborWindowGrid { Position: {-239.5, -262, -10}; Box: {1, 22, 320} }
      for f in 0..3 {
        "fin_{f}" : HarborHull { Position: {-370, -380, -130 + f * 120}; Box: {200, 60, 18}; Bevel: {bottom_left: 25, bottom_right: 25, segments: 2} }
        HarborMast "antenna_{f}"(h: 40 + f * 15) { Position: {-430 + f * 60, -350, f == 1 ? -170 : 150}; Rotation: {PI, 0, 0} }
      }
      for q in 0..4 {
        "thruster_{q}" {
          Position: {q < 2 ? -495 : -250, -320, q % 2 == 0 ? -205 : 185}
          block : HarborPanel { Box: {20, 20, 20} }
          for n in 0..2 {
            "nozzle_{n}" : HarborSteel { Position: {0, -14, n == 0 ? -5 : 5}; Rotation: {PI, 0, 0}; Cone: {radius: 4, length: 8, segments: 10} }
          }
        }
      }

      upper : HarborHullDark { Position: {-375, 255, -10}; Box: {250, 170, 400}; Bevel: {top_right: 30, top_left: 16, front_right: 16, back_right: 16, segments: 2} }
      for e in 0..2 {
        "upper_glazing_{e}" : HarborWindowGrid { Position: {-385, 250, e == 0 ? -210.6 : 190.6}; Box: {200, 104, 1} }
      }
      upper_back : HarborWindowGrid { Position: {-500.5, 250, -10}; Box: {1, 104, 350} }

      crown : HarborHullDark { Position: {-410, 375, -60}; Box: {130, 70, 190}; Bevel: {top_right: 16, segments: 2} }
      crown_glazing : HarborWindowGrid { Position: {-410, 376, -60}; Box: {131, 26, 191} }
      crown_cap : HarborPanel { Position: {-410, 412, -60}; Box: {132, 4, 192} }
      radar {
        Position: {-410, 414, -60}
        pedestal : HarborSteel { Position: {0, 8, 0}; Cylinder: {radius: 5, length: 16, segments: 10} }
        head {
          Position: {0, 18, 0}
          AngularVelocity: {0, 0.9, 0}
          hub : HarborPanel { Box: {12, 6, 12} }
          arm : HarborWhite { Position: {0, 6, 0}; Rotation: {0, 0, 0.25}; Box: {80, 12, 3} }
          tip : HarborBeaconRed { Position: {40, 16, 0}; Sphere: {radius: 2.5, segments: 8} }
        }
      }
      for m in 0..4 {
        HarborMast "mast_{m}"(h: 60 + m * 25) { Position: {m < 2 ? -465 : -355, 414, m % 2 == 0 ? -145 : 25} }
      }
      HarborRadiators radiators(n: 5, l: 60, h: 22) { Position: {-440, 340, 120} }
      HarborDish dish(r: 22, tilt: 0.7, spin: 0.15) { Position: {-330, 340, 125} }
      for v in 0..3 {
        "vent_{v}" : HarborSteel { Position: {-470 + v * 30, 352, -180}; Cylinder: {radius: 7, length: 24, segments: 12} }
      }

      facade {
        Position: {-232, 262, -10}
        Rotation: {0, 0, 0.45}
        panel : HarborHull { Box: {12, 110, 380} }
        sign : HarborSign { Position: {6.6, 4, -8}; Box: {1, 84, 340} }
        title {
          Position: {7.4, 19, -8}
          Rotation: {0, HALF_PI, 0}
          Text: {value: label, size: 54, align: Center}
          Rgb: {235, 238, 245}
          Emissive: {strength: 1.5, color: {235, 238, 245}}
        }
        subtitle {
          Position: {7.4, -20, -8}
          Rotation: {0, HALF_PI, 0}
          Text: {value: "LINER DOCK {idx}", size: 24, align: Center}
          Rgb: {255, 190, 90}
          Emissive: {strength: 2, color: {255, 170, 60}}
        }
        trim : HarborAmber { Position: {6.6, -42, -8}; Box: {1, 2.5, 340} }
        for g in 0..12 {
          "gauge_{g}" {
            Position: {6.6, -40 + g * 7, 176}
            Box: {1, 5, 12}
            if g < fuel {
              Rgb: {110, 240, 130}
              Emissive: {strength: 8, color: {90, 255, 110}}
            } else {
              Rgb: {40, 44, 52}
              Emissive: {strength: 0.5, color: {255, 60, 40}}
            }
          }
        }
      }

      for r in 0..2 {
        const ry = r == 0 ? 145 : -213
        "rail_deck_{r}" {
          deck : HarborPanel { Position: {-192.5, ry, 0}; Box: {55, 10, 690} }
          edge : HarborHazard { Position: {-165, ry, 0}; Box: {0.6, 10, 690} }
          rail_a : HarborSteel { Position: {-208, ry + 9, 0}; Box: {6, 8, 690} }
          rail_b : HarborSteel { Position: {-172, ry + 9, 0}; Box: {6, 8, 690} }
        }
      }
      strut_0 : HarborHullDark { Position: {-192, 90, -307.5}; Rotation: {-0.576, 0, 0}; Box: {14, 119, 14} }
      strut_1 : HarborHullDark { Position: {-192, 90, 295}; Rotation: {0.733, 0, 0}; Box: {14, 134.5, 14} }
      strut_2 : HarborHullDark { Position: {-192, -164, -307.5}; Rotation: {0.636, 0, 0}; Box: {14, 109, 14} }
      strut_3 : HarborHullDark { Position: {-192, -164, 295}; Rotation: {-0.797, 0, 0}; Box: {14, 126, 14} }

      for e in 0..2 {
        const ez = e == 0 ? -345 : 345
        "rail_end_{e}" {
          Position: {-192, 150, ez}
          HarborHazardLight beacon(on: hazard)
          signal {
            Position: {0, -5, e == 0 ? -7 : 7}
            Sphere: {radius: 8, segments: 14}
            const go = e == 0 ? step == 6 : step >= 5
            if go {
              Rgb: {110, 240, 130}
              Emissive: {strength: 10, color: {90, 255, 110}}
            } else {
              Rgb: {255, 80, 60}
              Emissive: {strength: 10, color: {255, 60, 40}}
            }
          }
        }
      }

      HarborTanks tanks(n: 3, r: 9, l: 160) { Position: {-380, 170, 223}; Rotation: {0, HALF_PI, 0} }
      fuel_feed : HarborYellow { Position: {-245, 176, 243}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: 4, length: 50, segments: 8} }
      fuel_riser : HarborYellow { Position: {-218, 148, 243}; Cylinder: {radius: 4, length: 56, segments: 8} }
      fuel_line : HarborYellow { Position: {-218, 120, -12}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 5, length: 500, segments: 12} }
      fuel_drop : HarborYellow { Position: {-216, 60, -262}; Cylinder: {radius: 4, length: 120, segments: 8} }
      if fueling {
        for p in 0..8 {
          "pulse_{p}" : HarborPulse {
            Position: {-218, 120, 230}
            Sphere: {radius: 7, segments: 10}
            Animator: {clip: harbor_fuel_flow, time: p * 0.375, speed: 1, mode: Loop}
          }
        }
      }

      probe {
        Position: {0, 0, -260}
        housing : HarborHullDark { Position: {-212, 0, 0}; Box: {20, 50, 40} }
        hatch : HarborHazard { Position: {-201.6, 0, 0}; Box: {0.8, 40, 34} }
        ram {
          Position: {set ? -125 : -190, 0, 0}
          Transition: [Position: {duration: 4, timing_function: EaseInOut}]
          rod : HarborSteel { Position: {-60, 0, 0}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: 5, length: 110, segments: 10} }
          head : HarborYellow { Position: {-6, 0, 0}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: 10, length: 14, segments: 12} }
          nozzle {
            Position: {2, 0, 0}
            Rotation: {0, 0, HALF_PI}
            Cylinder: {radius: 6, length: 4, segments: 12}
            Rgb: {120, 240, 255}
            Emissive: {strength: fueling ? 12 : 0.5, color: {90, 220, 255}}
            Transition: [Emissive: {duration: 0.8, timing_function: EaseInOut}]
          }
        }
      }

      for f in 0..2 {
        "flood_{f}" {
          Position: {-215, 136, f == 0 ? -130 : 130}
          Rotation: {0, 0 - HALF_PI, 0}
          lamp {
            Rotation: {-0.55, 0, 0}
            housing : HarborPanel { Position: {0, 0, 4}; Box: {24, 14, 8} }
            lens : HarborWindowCool { Position: {0, 0, -0.2}; Box: {20, 10, 0.4} }
            Rgb: {255, 240, 220}
            SpotLight: {intensity: 600000, range: 900, inner_angle: 26, outer_angle: 40, shadows: true, shadow_resolution: 1024}
          }
        }
      }
    }

    HarborDockClamp clamp_aft(down: down, set: set, reach: 40) { Position: {0, 0, -300} }
    clamp_fore {
      Position: {0, 0, front_z}
      Transition: [Position: {duration: 8, timing_function: EaseInOut}]
      HarborDockClamp clamp(down: down, set: set, reach: 30)
    }

    for m in 0..2 {
      const sz = m == 0 ? 0 - 1 : 1
      for i in 0..5 {
        for k in 0..4 {
          const f = k * HALF_PI + PI / 4
          "buoy_{m}_{i}_{k}" {
            Position: {cos(f) * 300, sin(f) * 300, sz * (470 + i * 130)}
            body : HarborPanel { Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 4, length: 18, segments: 8} }
            fin : HarborHullDark { Rotation: {0, 0, f}; Box: {14, 1.5, 12} }
            lamp : HarborBuoyLamp {
              Position: {0, 0, sz * 10}
              Sphere: {radius: 5, segments: 10}
              Animator: {clip: harbor_chase, time: (m == 0 ? i : 4 - i) * 0.12, speed: 1, mode: Loop}
            }
          }
        }
      }
    }

    // The jump points of the line: a flash where a liner arrives and where one leaves.
    flash_in : HarborFlash {
      Position: {0, 0, -11000}
      Scale: {0.01, 0.01, 0.01}
      Sphere: {radius: 1, segments: 32, smooth: true}
      Animator: {clip: harbor_flash_in, time: offset, speed: 1, mode: Loop}
    }
    flash_in_light {
      Position: {0, 0, -11000}
      Rgb: {170, 215, 255}
      PointLight: {intensity: 0, range: 9000}
      Animator: {clip: harbor_flash_in_light, time: offset, speed: 1, mode: Loop}
    }
    flash_out : HarborFlash {
      Position: {0, -1600, 11094}
      Scale: {0.01, 0.01, 0.01}
      Sphere: {radius: 1, segments: 32, smooth: true}
      Animator: {clip: harbor_flash_out, time: offset, speed: 1, mode: Loop}
    }
    flash_out_light {
      Position: {0, -1600, 11094}
      Rgb: {170, 215, 255}
      PointLight: {intensity: 0, range: 9000}
      Animator: {clip: harbor_flash_out_light, time: offset, speed: 1, mode: Loop}
    }

    // The three liners. Liner k is 90 s ahead of liner k - 1 in the cycle, the one docked in
    // turn n is the one with (n + k) % 3 == 0.
    for k in 0..3 {
      const role = harbor_mod3(turn + k)
      const burn = (role == 0 && step >= 5) || (role == 1 && step <= 3) || (role == 2 && step == 6)
      "liner_{k}" {
        Animator: {clip: harbor_liner_cycle, time: k * 90 + offset, speed: 1, mode: Loop}
        Liner hull(design: harbor_liner_design(harbor_mod3(idx + k)), burning: burn) {
          Position: {0, 0, 0}
        }
      }
    }

    async {
      while true {
        await next_frame()
        const c = this[Animator].time
        const n = c < 90 ? 0 : c < 180 ? 1 : 2
        const t = c - n * 90
        const s = harbor_gate_step(t)
        const f = s < 2 ? 0 : s > 2 ? 12 : harbor_ticks((t - 8) / 2.5, 12)
        if n != turn {
          turn = n
        }
        if s != step {
          step = s
        }
        if f != fuel {
          fuel = f
        }
      }
    }
  }

  // A rig bay on the outer deck, in its own frame: the deck at y = 0, +z away from the station
  // and the hangar door of the bay in the wall at z = -110.
  template RigBay {
    prop idx: i32 = 0
    mut step: i32 = 0
    mut fuel: i32 = 0

    const offset = idx * 7.5
    Animator: {clip: harbor_bay_clock, time: offset, speed: 1, mode: Loop}

    const busy = step >= 1 && step <= 8
    const hazard = step == 1 || step == 7
    const boom_in = step == 3 || step == 4
    const fueling = step == 4
    const burn = step <= 1 || step >= 7

    edge_a : HarborHazard { Position: {0, 0.3, 100}; Box: {84, 0.6, 5} }
    edge_b : HarborHazard { Position: {0, 0.3, -100}; Box: {84, 0.6, 5} }
    edge_c : HarborHazard { Position: {40, 0.3, 0}; Box: {5, 0.6, 200} }
    edge_d : HarborHazard { Position: {-40, 0.3, 0}; Box: {5, 0.6, 200} }
    for l in 0..10 {
      "guide_{l}" {
        Position: {0, 0.5, -90 + l * 30}
        Box: {3, 1, 8}
        if busy {
          Rgb: {255, 180, 70}
          Emissive: {strength: 6, color: {255, 160, 50}}
        } else {
          Rgb: {96, 220, 240}
          Emissive: {strength: 5, color: {80, 214, 255}}
        }
      }
    }
    for c in 0..4 {
      "corner_{c}" {
        Position: {c < 2 ? -40 : 40, 2, c % 2 == 0 ? -100 : 100}
        dome : HarborAmber { Position: {0, 0, 0}; Sphere: {radius: 2, segments: 10} }
        if hazard {
          glow : HarborBeaconAmber { Position: {0, 0, 0}; Sphere: {radius: 2.6, segments: 10} }
          Rgb: {255, 160, 60}
          PointLight: {intensity: 6000, range: 120}
        }
      }
    }

    door {
      Position: {0, 0, -109}
      panel : HarborPanel { Position: {0, 45, 0}; Box: {100, 90, 2} }
      seam : HarborHullDark { Position: {0, 45, 1.2}; Box: {1.5, 88, 0.5} }
      top : HarborYellow { Position: {0, 93, 1}; Box: {110, 6, 4} }
      side_a : HarborYellow { Position: {53, 45, 1}; Box: {6, 90, 4} }
      side_b : HarborYellow { Position: {-53, 45, 1}; Box: {6, 90, 4} }
      bar : HarborAmber { Position: {0, 99, 1}; Box: {90, 3, 1} }
      sign : HarborSign { Position: {0, 124, 0.5}; Box: {50, 28, 2} }
      number {
        Position: {0, 124, 1.8}
        Text: {value: idx < 9 ? "0{idx + 1}" : "{idx + 1}", size: 22, align: Center}
        Rgb: {240, 240, 245}
        Emissive: {strength: 1.5, color: {240, 240, 245}}
      }
      if busy {
        light {
          Position: {0, 110, 30}
          Rgb: {255, 190, 120}
          PointLight: {intensity: 40000, range: 260}
        }
      }
    }

    tower : HarborHullDark { Position: {46, 20, 0}; Box: {8, 40, 8} }
    for g in 0..8 {
      "gauge_{g}" {
        Position: {41.9, 4 + g * 3.5, 0}
        Box: {0.2, 2.4, 5}
        if g < fuel {
          Rgb: {110, 240, 130}
          Emissive: {strength: 6, color: {90, 255, 110}}
        } else {
          Rgb: {40, 44, 52}
          Emissive: {strength: 0.4, color: {255, 60, 40}}
        }
      }
    }
    boom {
      Position: {46, 42, 0}
      Rotation: {0, boom_in ? 0 : 0 - HALF_PI, 0}
      Transition: [Rotation: {duration: 3, timing_function: EaseInOut}]
      hub : HarborPanel { Position: {0, 0, 0}; Cylinder: {radius: 3, length: 4, segments: 12} }
      arm : HarborYellow { Position: {-18, 0, 0}; Box: {36, 3, 3} }
      hose : HarborRubber { Position: {-35, -8, 0}; Cylinder: {radius: 1, length: 16, segments: 8} }
      nozzle {
        Position: {-35, -16.5, 0}
        Cylinder: {radius: 1.6, length: 2, segments: 10}
        Rgb: {120, 240, 255}
        Emissive: {strength: fueling ? 10 : 0.5, color: {90, 220, 255}}
        Transition: [Emissive: {duration: 0.6, timing_function: EaseInOut}]
      }
      if fueling {
        for p in 0..3 {
          "pulse_{p}" : HarborPulse {
            Position: {-2, 2, 0}
            Sphere: {radius: 1.1, segments: 8}
            Animator: {clip: harbor_boom_flow, time: p * 0.5, speed: 1, mode: Loop}
          }
        }
      }
    }

    ship {
      Animator: {clip: harbor_rig_cycle, time: offset, speed: 1, mode: Loop}
      Rig hull(design: harbor_rig_design(idx), burning: burn) {
        Position: {0, 0, 0}
      }
    }
    flash : HarborFlash {
      Position: {0, 2600, 4200}
      Scale: {0.01, 0.01, 0.01}
      Sphere: {radius: 1, segments: 24, smooth: true}
      Animator: {clip: harbor_rig_flash, time: offset, speed: 1, mode: Loop}
    }

    async {
      while true {
        await next_frame()
        const t = this[Animator].time
        const s = harbor_bay_step(t)
        const f = s < 4 ? 0 : s > 4 ? 8 : harbor_ticks((t - 61) / 3.375, 8)
        if s != step {
          step = s
        }
        if f != fuel {
          fuel = f
        }
      }
    }
  }
}

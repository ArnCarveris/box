    }

    skirt_seam_b : HarborPanel {
      Position: {0, -66, 0}
      Torus: {radius: 164, tube: 1.2, segments: 96, rings: 6}
    }

    skirt_glow : HarborCyan {
      Position: {0, -74, 0}
      Torus: {radius: 156.2, tube: 0.6, segments: 96, rings: 6}
    }

    gallery : HarborPanel {
      Position: {0, -82, 0}
      Tube: {radius: 156, thickness: 8, length: 4, segments: 96, smooth: true}
    }

    gallery_lights : HarborHubRunLights {
      Position: {0, -82, 0}
      Tube: {radius: 156.15, thickness: 0.3, length: 1.6, segments: 96, smooth: true}
      texture.Transform: {scale_x: 306, scale_y: 0.5}
    }

    heat_cone : HarborHull {
      Position: {0, -107, 0}
      Frustum: {radius_bottom: 110, radius_top: 150, length: 54, segments: 96, smooth: true}
    }

    for f in 0..24 {
      const a = (2 * f + 1) * PI / 24
      "radiator_{f}" {
        Rotation: {0, a, 0}
        panel : HarborHubRadiator { Position: {0, -109, 144}; Box: {1.2, 46, 72} }
        spar : HarborPanel { Position: {0, -85.5, 144}; Box: {2.6, 2.6, 72} }
      }
    }

    for g in 0..4 {
      const a = PI / 4 + g * HALF_PI
      "thruster_{g}" {
        Rotation: {0, a, 0}
        block : HarborHull { Position: {0, -62, 168}; Box: {16, 14, 24} }
        block_lights : HarborHubRunLightsCyan {
          Position: {0, -67, 180.2}
          Box: {14, 1.6, 0.3}
          texture.Transform: {scale_x: 3.5, scale_y: 0.5}
        }

        cowl : HarborPanel { Position: {0, -54.5, 169}; Box: {17, 1.5, 25} }
        stripe : HarborHazard { Position: {0, -58, 180.2}; Box: {12, 2, 0.3} }
        out_l : ShipNozzle {
          Position: {-4.5, -63, 183}
          Rotation: {0 - HALF_PI, 0, 0}
          Frustum: {radius_bottom: 3.6, radius_top: 1.6, length: 6, segments: 16, smooth: true}
        }

        out_r : ShipNozzle {
          Position: {4.5, -63, 183}
          Rotation: {0 - HALF_PI, 0, 0}
          Frustum: {radius_bottom: 3.6, radius_top: 1.6, length: 6, segments: 16, smooth: true}
        }

        down : ShipNozzle {
          Position: {0, -72, 170}
          Frustum: {radius_bottom: 4.2, radius_top: 2, length: 6, segments: 16, smooth: true}
        }

        lamp : HarborBeaconRed { Position: {0, -53, 178}; Sphere: {radius: 1, segments: 8} }
      }
    }

    lower_cone : HarborHullDark {
      Position: {0, -162, 0}
      Frustum: {radius_bottom: 62, radius_top: 110, length: 56, segments: 96, smooth: true}
    }

    lower_seam : HarborPanel {
      Position: {0, -134.5, 0}
      Torus: {radius: 110, tube: 1.6, segments: 96, rings: 6}
    }

    for k in 0..8 {
      const a = PI / 8 + k * PI / 4
      "stringer_{k}" : HarborPanel {
        Position: {sin(a) * 86.76, -161.35, cos(a) * 86.76}
        Rotation: {-0.7086, a, 0}
        Box: {3, 73.8, 2}
      }
    }
  }

  template HarborHubReactor {
    for g in 0..4 {
      const a = g * HALF_PI
      "tanks_{g}" {
        Rotation: {0, a, 0}
        bracket_a : HarborPanel { Position: {0, -150, 92}; Box: {24, 3, 16} }
        bracket_b : HarborPanel { Position: {0, -168, 86}; Box: {24, 3, 22} }

        for t in 0..2 {
          const x = t == 0 ? -8.5 : 8.5
          "tank_{t}" : HarborWhite {
            Position: {x, -160, 100}
            Capsule: {radius: 6.5, length: 20, segments: 16, smooth: true}
          }

          "band_{t}" : HarborRed {
            Position: {x, -160, 100}
            Cylinder: {radius: 6.75, length: 2, segments: 16}
          }
        }

        feed : HarborYellow {
          Position: {0, -139, 100}
          Rotation: {0, 0, HALF_PI}
          Cylinder: {radius: 0.9, length: 17, segments: 8}
        }
      }
    }

    reactor_collar : HarborPanel {
      Position: {0, -190, 0}
      Tube: {radius: 66, thickness: 8, length: 3, segments: 64, smooth: true}
    }

    reactor : HarborHullDark {
      Position: {0, -203, 0}
      Cylinder: {radius: 62, length: 26, segments: 64, smooth: true}
    }

    for k in 0..3 {
      "reactor_coil_{k}" : ShipCopper {
        Position: {0, -194 - k * 9, 0}
        Torus: {radius: 63, tube: 2, segments: 64, rings: 8}
      }
    }

    for k in 0..2 {
      "reactor_glow_{k}" : HarborHubPlasma {
        Position: {0, -198.5 - k * 9, 0}
        Tube: {radius: 62.4, thickness: 0.8, length: 2.5, segments: 64, smooth: true}
      }
    }

    reactor_cap : HarborHull {
      Position: {0, -216, 0}
      Rotation: {PI, 0, 0}
      HemiSphere: {radius: 58, segments: 48, smooth: true}
    }

    for k in 0..8 {
      "reactor_rib_{k}" : HarborPanel {
        Position: {0, -216, 0}
        Rotation: {0, k * PI / 4, 0}
        EllipsoidShell: {
          radius: {60, 60, 60},
          longitude_start: 0,
          longitude_end: 0.07,
          latitude_start: -1.25,
          latitude_end: 0,
          thickness: 3,
          rims: true,
          segments: 3,
          rings: 16
        }
      }

      "reactor_vent_{k}" : HarborHubRadiator {
        Position: {0, -216, 0}
        Rotation: {0, k * PI / 4, 0}
        EllipsoidShell: {
          radius: {58.4, 58.4, 58.4},
          longitude_start: 0.2,
          longitude_end: 0.58,
          latitude_start: -0.5,
          latitude_end: -0.12,
          thickness: 0.6,
          rims: true,
          segments: 6,
          rings: 4
        }
      }
    }

    boom : HarborHull {
      Position: {0, -290, 0}
      Cylinder: {radius: 12, length: 44, segments: 24, smooth: true}
    }

    boom_collar : HarborPanel {
      Position: {0, -282, 0}
      Torus: {radius: 12.5, tube: 1.2, segments: 24, rings: 6}
    }

    for d in 0..3 {
      const a = d * 2 * PI / 3
      "boom_dish_{d}" {
        Rotation: {0, a, 0}
        arm : HarborPanel { Position: {0, -296, 19}; Box: {2, 2, 16} }
        HarborDish dish(r: 7, tilt: 0.6, spin: 0) { Position: {0, -296, 28}; Rotation: {PI, 0, 0} }
      }
    }

    sensor_ring : HarborPanel {
      Position: {0, -316, 0}
      Cylinder: {radius: 18, length: 8, segments: 24}
    }

    sensor_lights : HarborHubRunLightsCyan {
      Position: {0, -316, 0}
      Tube: {radius: 18.1, thickness: 0.3, length: 1.6, segments: 24}
      texture.Transform: {scale_x: 28, scale_y: 0.5}
    }

    for e in 0..6 {
      const a = e * PI / 3 + PI / 6
      "sensor_{e}" : ShipVisor {
        Position: {sin(a) * 18, -316, cos(a) * 18}
        Sphere: {radius: 3.2, segments: 12, smooth: true}
      }
    }

    probe : HarborSteel {
      Position: {0, -348, 0}
      Frustum: {radius_bottom: 3, radius_top: 9, length: 56, segments: 16, smooth: true}
    }

    probe_yard_a : HarborSteel { Position: {0, -352, 0}; Box: {40, 1, 1} }
    probe_yard_b : HarborSteel { Position: {0, -352, 0}; Box: {1, 1, 40} }

    for l in 0..4 {
      "probe_lamp_{l}" : HarborBeaconRed {
        Position: {l == 0 ? -20 : l == 1 ? 20 : 0, -352, l == 2 ? -20 : l == 3 ? 20 : 0}
        Sphere: {radius: 1, segments: 8}
      }
    }

    probe_whip : HarborSteel {
      Position: {0, -383, 0}
      Cylinder: {radius: 0.7, length: 14, segments: 6}
    }

    probe_tip : HarborBeaconRed { Position: {0, -391, 0}; Sphere: {radius: 3.5, segments: 10} }
  }

  template HarborHub {
    HarborHubDrum() {}
    HarborHubBays() {}
    HarborHubOps() {}
    HarborHubDome() {}
    HarborHubCrown() {}
    HarborHubHalo() {}

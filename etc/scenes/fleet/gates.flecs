  template HarborGateTower {
    stem : HarborHullDark { Position: {0, 5, 0}; Box: {12, 10, 12} }
    cab : HarborPanel { Position: {0, 13.5, 0}; Box: {24, 7, 18} }
    glass : HarborWindowCool { Position: {0, 14, 0}; Box: {24.4, 3.2, 18.4} }
    cap : HarborHullDark { Position: {0, 17.5, 0}; Box: {26, 1, 20} }
    HarborMast mast(h: 10) { Position: {8, 18, 5} }
  }

  template HarborGateFlood {
    lamp {
      Rotation: {-1.35, 0, 0}
      housing : HarborPanel { Position: {0, 0, 2}; Box: {8, 5, 4} }
      lens : HarborWindowCool { Position: {0, 0, -0.1}; Box: {7, 4, 0.2} }
      Rgb: {255, 240, 220}
      SpotLight: {
        intensity: 300000,
        range: 400,
        inner_angle: 30,
        outer_angle: 46,
        shadows: true,
        shadow_resolution: 1024
      }
    }
  }

  template HarborGateGauge {
    prop lit: bool = false
    Box: {1, 3.5, 10}

    if lit {
      Rgb: {110, 240, 130}
      Emissive: {strength: 8, color: {90, 255, 110}}
    } else {
      Rgb: {40, 44, 52}
      Emissive: {strength: 0.5, color: {255, 60, 40}}
    }
  }

  template HarborGateDock {
    prop idx: i32 = 0
    prop label: string = "NORTH GATE"
    prop set: bool = false
    prop fueling: bool = false
    prop fuel: i32 = 0
    upper : HarborHull {
      Position: {0, 0, 55}
      Rotation: {HALF_PI, 0, 0}
      ProfileExtrusion: {profile: harbor_dock_upper, depth: 410, cap_start: true, cap_end: true}
    }

    lower : HarborHull {
      Position: {0, 0, 30}
      Rotation: {HALF_PI, 0, 0}
      ProfileExtrusion: {profile: harbor_dock_lower, depth: 360, cap_start: true, cap_end: true}
    }

    throat : HarborHullDark { Position: {36, 99, -144}; Box: {12, 12, 12} }

    for f in 0..5 {
      const zf = f == 0 ? -147 : f == 1 ? -75 : f == 2 ? 0 : f == 3 ? 75 : 207
      "frame_{f}" : HarborGateFrame {
        Position: {0, 0, zf}
        Rotation: {HALF_PI, 0, 0}
        ProfileExtrusion: {profile: harbor_gate_frame, depth: 4, cap_start: true, cap_end: true}
      }
    }

    frame_end : HarborGateFrame {
      Position: {0, 0, 257}
      Rotation: {HALF_PI, 0, 0}
      ProfileExtrusion: {profile: harbor_gate_frame_end, depth: 4, cap_start: true, cap_end: true}
    }

    for b in 0..5 {
      const z0 = b == 0 ? -145 : b == 1 ? -73 : b == 2 ? 2 : b == 3 ? 77 : 209
      const z1 = b == 0 ? -77 : b == 1 ? -2 : b == 2 ? 73 : b == 3 ? 205 : 255
      const bz = (z0 + z1) / 2
      const bl = z1 - z0
      "ceiling_light_{b}" : HarborAmber { Position: {62, 104.7, bz}; Box: {50, 0.6, bl - 8} }
      "skylight_{b}" : HarborWindowGrid { Position: {35, 150.25, bz}; Box: {12, 0.5, bl - 12} }
      "roof_plate_{b}" : HarborGateSkin { Position: {75, 150.2, bz}; Box: {24, 0.4, bl - 14} }

      if b < 4 {
        "concourse_{b}" : HarborWindowGrid { Position: {-50.5, 40, bz}; Box: {1, 15, bl - 10} }
        "spandrel_{b}" : HarborGateRecess { Position: {-50.3, 60, bz}; Box: {0.6, 5, bl - 6} }
      }

      if b == 2 || b == 3 {
        "lower_deck_{b}" : HarborWindowGrid { Position: {-50.5, -20, bz}; Box: {1, 15, bl - 10} }
      }
    }

    gallery_aft : HarborWindowGrid { Position: {-50.5, 113, -111}; Box: {1, 10, 58} }
    gallery_fore : HarborWindowGrid { Position: {-50.5, 113, 232}; Box: {1, 10, 40} }

    for d in 0..2 {
      const dz = d == 0 ? -120 : -40
      "door_{d}" : HarborPanel { Position: {-50.3, 7.5, dz}; Box: {0.6, 15, 22} }
      "lintel_{d}" : HarborHazard { Position: {-50.5, 16.5, dz}; Box: {1, 2.4, 25} }
    }

    wall_aft : HarborWindowGrid { Position: {30.5, 50, -110}; Box: {1, 16, 64} }
    wall_mid : HarborWindowGrid { Position: {30.5, 50, -37.5}; Box: {1, 16, 65} }
    wall_rim : HarborWindowGrid { Position: {30.5, 50, 17}; Box: {1, 16, 28} }
    wall_fore : HarborWindowGrid { Position: {30.5, 50, 105}; Box: {1, 16, 50} }
    wall_end : HarborWindowGrid { Position: {30.5, 50, 165}; Box: {1, 16, 32} }

    for w in 0..2 {
      HarborGateGangway "gangway_{w}"(set: set) { Position: {30, 50, w == 0 ? 40 : 140} }
    }

    beam : HarborYellow { Position: {91, 101, 55}; Box: {8, 8, 410} }
    beam_light : HarborAmber { Position: {95.3, 101, 55}; Box: {0.6, 2, 400} }
    catwalk : HarborGateFrame { Position: {32.5, 27, 17.5}; Box: {5, 1.2, 325} }
    catwalk_rail : HarborSteel { Position: {34.7, 30, 17.5}; Box: {0.4, 0.4, 325} }
    catwalk_light : HarborAmber { Position: {35.05, 27, 17.5}; Box: {0.2, 0.5, 321} }
    conduit_a : HarborSteel {
      Position: {31.6, -36, 30}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: 1.4, length: 350, segments: 8}
    }

    conduit_b : HarborGateFrame { Position: {31.2, -40, 30}; Box: {2.4, 2.4, 350} }

    for b in 0..4 {
      const pz = b == 0 ? -111 : b == 1 ? -37.5 : b == 2 ? 37.5 : 92
      "wall_panel_{b}" : HarborGateSkin {
        Position: {30.2, 5, pz}
        Box: {0.6, 30, b == 3 ? 20 : 56}
      }

      "wall_lamp_{b}" : HarborAmber {
        Position: {30.4, 21.5, pz}
        Box: {0.4, 0.8, b == 3 ? 16 : 52}
      }
    }

    HarborGateSide0 side_0(idx: idx, label: label)

    HarborGateSide1 side_1(idx: idx, label: label)

    gauge_housing : HarborPanel { Position: {30.2, 45.5, 190}; Box: {0.4, 64, 14} }

    for r in 0..2 {
      "gauge_rail_{r}" : HarborYellow {
        Position: {30.8, 45.5, r == 0 ? 183.5 : 196.5}
        Box: {1.6, 64, 1}
      }
    }

    for g in 0..12 {
      HarborGateGauge "gauge_{g}"(lit: g < fuel) { Position: {30.6, 18 + g * 5, 190} }
    }

    end_glazing_a : HarborWindowGrid { Position: {22.5, 127, 260.6}; Box: {120, 14, 1} }
    end_glazing_b : HarborWindowGrid { Position: {-10, 40, 210.6}; Box: {70, 14, 1} }
    end_light_port : HarborBeaconRed { Position: {-48, 147, 261}; Sphere: {radius: 2, segments: 8} }
    end_light_berth {
      Position: {93, 147, 261}
      Sphere: {radius: 2, segments: 8}
      Rgb: {80, 255, 110}
      Emissive: {strength: 1, color: {60, 255, 90}}
      Animator: {clip: harbor_blink}
    }

    for m in 0..3 {
      HarborMast "mast_{m}"(h: m == 1 ? 30 : 20) { Position: {20, 150, -100 + m * 150} }
    }

    for v in 0..4 {
      HarborGateHvac "hvac_{v}" { Position: {v % 2 == 0 ? -12 : 52, 150, v < 2 ? -40 : 140} }
    }

    HarborRadiators roof_fins(n: 4, l: 40, h: 10) { Position: {-5, 150, 100} }
    HarborDish roof_dish(r: 9, tilt: 0.7, spin: 0.04) { Position: {-12, 150, -112} }
    HarborGateTower tower { Position: {68, 150, 228} }

    fuel_line : HarborYellow {
      Position: {33, -24, 5}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: 2, length: 310, segments: 10}
    }

    fuel_drop : HarborYellow {
      Position: {33, -19.5, 160}
      Cylinder: {radius: 2, length: 9, segments: 8}
    }

    for b in 0..5 {
      "fuel_bracket_{b}" : HarborGateFrame { Position: {32, -24, 10 + b * 35}; Box: {4, 5.5, 1.5} }
    }

    fuel_riser : HarborYellow {
      Position: {33, -45.5, 138}
      Cylinder: {radius: 1.5, length: 43, segments: 8}
    }

    fuel_header : HarborYellow {
      Position: {7.5, -67, 138}
      Rotation: {0, 0, HALF_PI}
      Cylinder: {radius: 1.5, length: 51, segments: 8}
    }

    for t in 0..2 {
      "tank_{t}" : HarborWhite {
        Position: {t == 0 ? -18 : 2, -67, 100}
        Rotation: {HALF_PI, 0, 0}
        Capsule: {radius: 6, length: 60, segments: 16, smooth: true}
      }

      "tank_band_{t}" : HarborRed {
        Position: {t == 0 ? -18 : 2, -67, 100}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: 6.2, length: 2, segments: 16}
      }

      "saddle_{t}" : HarborGateFrame { Position: {-8, -61, t == 0 ? 80 : 120}; Box: {34, 2, 3} }
    }

    if fueling {
      for p in 0..8 {
        "pulse_{p}" : HarborPulse {
          Position: {33, -24, -150}
          Sphere: {radius: 3, segments: 10}
          Animator: {clip: harbor_fuel_flow, time: p * 0.375, speed: 1, mode: Loop}
        }
      }
    }

    for f in 0..2 {
      HarborGateFlood "flood_{f}" {
        Position: {55, 103, f == 0 ? 120 : 160}
        Rotation: {0, 0 - HALF_PI, 0}
      }
    }
  }

  // A liner gate on the rim of the station, in its own frame: the rim at z = 0, +z away from the
  // station and the deck at y = 0. The liner berths alongside the dock (+x) with its bow out.
  template LinerGate {
    prop idx: i32 = 0
    prop label: string = "NORTH GATE"
    mut turn: i32 = 0
    mut step: i32 = 0
    mut fuel: i32 = 0

    const offset = idx * 22.5
    Animator: {clip: harbor_gate_clock, time: offset, speed: 1, mode: Loop}

    const down = step <= 3
    const set = step == 1 || step == 2
    const fueling = step == 2

    HarborGateDock dock(idx: idx, label: label, set: set, fueling: fueling, fuel: fuel)

    HarborClamp clamp_aft(down: down, set: set, reach: 25) { Position: {30, 0, 120} }
    HarborClamp clamp_fore(down: down, set: set, fueling: fueling, fold: -1, reach: 29) {
      Position: {30, 0, 160}
    }

    berth {
      Position: {170, 0, 0}
      flash_in : HarborFlash {
        Position: {0, 1500, 11620}
        Scale: {0.01, 0.01, 0.01}
        Sphere: {radius: 1, segments: 32, smooth: true}
        Animator: {clip: harbor_flash_in, time: offset, speed: 1, mode: Loop}
      }

      flash_in_light {
        Position: {0, 1500, 11620}
        Rgb: {170, 215, 255}
        PointLight: {intensity: 0, range: 9000}
        Animator: {clip: harbor_flash_in_light, time: offset, speed: 1, mode: Loop}
      }

      flash_out : HarborFlash {
        Position: {0, -1600, 11420}
        Scale: {0.01, 0.01, 0.01}
        Sphere: {radius: 1, segments: 32, smooth: true}
        Animator: {clip: harbor_flash_out, time: offset, speed: 1, mode: Loop}
      }

      flash_out_light {
        Position: {0, -1600, 11420}
        Rgb: {170, 215, 255}
        PointLight: {intensity: 0, range: 9000}
        Animator: {clip: harbor_flash_out_light, time: offset, speed: 1, mode: Loop}
      }

      // Liner k is 90 s ahead of liner k - 1 in the cycle, the one docked in turn n is the one with
      // (n + k) % 3 == 0.
      for k in 0..3 {
        "liner_{k}" {
          Animator: {clip: harbor_liner_cycle, time: k * 90 + offset, speed: 1, mode: Loop}
        }
      }

      for k in 0..3 {
        "liner_{k}" {
          Liner hull(
            design: harbor_liner_design(harbor_mod3(idx + k)),
            burning: harbor_liner_burn(harbor_mod3(turn + k), step)
          ) {
            Position: {0, 0, 0}
          }
        }
      }
    }

    async {
      while true {
        await next_frame()
        const c = this[Animator].time
        const n = c < 90 ? 0 : c < 180 ? 1 : 2
        const t = c - n * 90
        const s = harbor_gate_step(t)
        const f = s < 2 ? 0 : s > 2 ? 12 : harbor_ticks((t - 8) / 2.5, 12)

        if n != turn {
          turn = n
        }

        if s != step {
          step = s
        }

        if f != fuel {
          fuel = f
        }
      }
    }
  }
}

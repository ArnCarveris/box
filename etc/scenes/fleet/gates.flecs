using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.texture
using box.animation
using box.curve
using box.light
using box.movement
using box.transition
using box.text
using state

assets {
  harbor_arm_shape { Path2D: {start: {-40, 25}, segments: [
    {kind: Line, end: {40, 25}}, {kind: Line, end: {40, -10}}, {kind: Line, end: {25, -25}},
    {kind: Line, end: {-25, -25}}, {kind: Line, end: {-40, -10}}
  ], closed: true} }
  harbor_arm { Profile2D: {outer: harbor_arm_shape} }
  harbor_gate_arm_core_shape { Path2D: {start: {-38.8, 23.8}, segments: [
    {kind: Line, end: {38.8, 23.8}},
    {kind: Line, end: {38.8, -9.5}},
    {kind: Line, end: {24.5, -23.8}},
    {kind: Line, end: {-24.5, -23.8}}, {kind: Line, end: {-38.8, -9.5}}
  ], closed: true} }
  harbor_gate_arm_core { Profile2D: {outer: harbor_gate_arm_core_shape} }
  harbor_gate_arm_rib_shape { Path2D: {start: {-42, 27}, segments: [
    {kind: Line, end: {42, 27}}, {kind: Line, end: {42, -10.8}}, {kind: Line, end: {25.8, -27}},
    {kind: Line, end: {-25.8, -27}}, {kind: Line, end: {-42, -10.8}}
  ], closed: true} }
  harbor_gate_arm_rib { Profile2D: {outer: harbor_gate_arm_rib_shape} }
  harbor_gate_collar_shape { Path2D: {start: {-47, 32}, segments: [
    {kind: Line, end: {47, 32}}, {kind: Line, end: {47, -12.9}}, {kind: Line, end: {27.9, -32}},
    {kind: Line, end: {-27.9, -32}}, {kind: Line, end: {-47, -12.9}}
  ], closed: true} }
  harbor_gate_collar { Profile2D: {outer: harbor_gate_collar_shape} }
  harbor_gate_flange_shape { Path2D: {start: {-49.5, 34.5}, segments: [
    {kind: Line, end: {49.5, 34.5}},
    {kind: Line, end: {49.5, -14.2}},
    {kind: Line, end: {29.2, -34.5}},
    {kind: Line, end: {-29.2, -34.5}}, {kind: Line, end: {-49.5, -14.2}}
  ], closed: true} }
  harbor_gate_flange { Profile2D: {outer: harbor_gate_flange_shape} }
  harbor_dock_upper_shape { Path2D: {start: {-50, -105}, segments: [
    {kind: Line, end: {95, -105}}, {kind: Line, end: {95, -150}}, {kind: Line, end: {-30, -150}},
    {kind: Line, end: {-50, -130}}
  ], closed: true} }
  harbor_dock_upper { Profile2D: {outer: harbor_dock_upper_shape} }
  harbor_dock_lower_shape { Path2D: {start: {-50, -105}, segments: [
    {kind: Line, end: {-50, 40}}, {kind: Line, end: {-30, 60}}, {kind: Line, end: {15, 60}},
    {kind: Line, end: {30, 45}}, {kind: Line, end: {30, -105}}
  ], closed: true} }
  harbor_dock_lower { Profile2D: {outer: harbor_dock_lower_shape} }
  harbor_gate_frame_shape { Path2D: {start: {-52, 41}, segments: [
    {kind: Line, end: {-31, 62}}, {kind: Line, end: {16, 62}}, {kind: Line, end: {32, 46}},
    {kind: Line, end: {32, -103}}, {kind: Line, end: {94.5, -103}}, {kind: Line, end: {94.5, -152}},
    {kind: Line, end: {-31, -152}}, {kind: Line, end: {-52, -131}}
  ], closed: true} }
  harbor_gate_frame { Profile2D: {outer: harbor_gate_frame_shape} }
  harbor_gate_frame_end_shape { Path2D: {start: {-52, -103}, segments: [
    {kind: Line, end: {94.5, -103}},
    {kind: Line, end: {94.5, -152}},
    {kind: Line, end: {-31, -152}},
    {kind: Line, end: {-52, -131}}
  ], closed: true} }
  harbor_gate_frame_end { Profile2D: {outer: harbor_gate_frame_end_shape} }

  prefab HarborGateSkin {
    Rgb: {120, 124, 134}
    PbrMaterial: {metallic: 0.5, roughness: 0.5}
    PbrTextures: {
      albedo: assets.harbor_tex_hull,
      normal: assets.harbor_tex_hull_normal,
      orm: assets.harbor_tex_hull_orm
    }
    texture.Mapping: {MappingWorld, size: 9, blend: 0.3}
    ClearCoat: {strength: 0.2, roughness: 0.3}
  }

  prefab HarborGateFrame {
    Rgb: {60, 64, 74}
    PbrMaterial: {metallic: 0.7, roughness: 0.45}
    PbrTextures: {
      albedo: assets.harbor_tex_hull,
      normal: assets.harbor_tex_hull_normal,
      orm: assets.harbor_tex_hull_orm
    }
    texture.Mapping: {MappingWorld, size: 5, blend: 0.3}
  }

  prefab HarborGateRecess { Rgb: {18, 20, 26}; PbrMaterial: {metallic: 0.5, roughness: 0.8} }

  prefab harbor_gate_tram {
    Clip: {duration: 160}
    z {
      Track: {
        component: box.transform.Position,
        member: "z",
        curve: {keys: [{0, 200}, {20, 200}, {80, 840}, {100, 840}, {160, 200}]}
      }
    }
  }

  template HarborGatePylon {
    prop h: f32 = 45
    prop w: f32 = 40
    prop d: f32 = 26
    const lh = h - 6
    const ly = 3 + lh / 2

    for s in 0..2 {
      const sx = s == 0 ? 0 - 1 : 1
      "sill_{s}" : HarborPanel { Position: {sx * w / 2, 1.5, 0}; Box: {8, 3, d + 8} }
      "toe_{s}" : HarborHazard { Position: {sx * w / 2, 3.2, 0}; Box: {8.2, 0.4, d + 8.2} }

      for t in 0..2 {
        const sz = t == 0 ? 0 - 1 : 1
        "leg_{s}_{t}" : HarborHullDark { Position: {sx * w / 2, ly, sz * d / 2}; Box: {4, lh, 4} }
      }

      "brace_x_{s}_a" : HarborSteel {
        Position: {sx * w / 2, ly, 0}
        Rotation: {atan2(lh, d), 0, 0}
        Box: {1.4, 1.4, sqrt(lh * lh + d * d)}
      }

      "brace_x_{s}_b" : HarborSteel {
        Position: {sx * w / 2, ly, 0}
        Rotation: {0 - atan2(lh, d), 0, 0}
        Box: {1.4, 1.4, sqrt(lh * lh + d * d)}
      }

      "brace_z_{s}_a" : HarborSteel {
        Position: {0, ly, sx * d / 2}
        Rotation: {0, 0, atan2(lh, w)}
        Box: {sqrt(lh * lh + w * w), 1.4, 1.4}
      }

      "brace_z_{s}_b" : HarborSteel {
        Position: {0, ly, sx * d / 2}
        Rotation: {0, 0, 0 - atan2(lh, w)}
        Box: {sqrt(lh * lh + w * w), 1.4, 1.4}
      }

      "tie_{s}" : HarborHullDark { Position: {0, ly, sx * d / 2}; Box: {w, 2.5, 2.5} }
      "light_{s}" : HarborAmber { Position: {sx * (w / 2 + 4.15), h - 3, 0}; Box: {0.3, 1.2, d} }
    }

    shaft : HarborHull { Position: {0, h / 2, 0}; Cylinder: {radius: 5.5, length: h, segments: 16} }
    shaft_glass : HarborWindowCool { Position: {0, h / 2, 0}; Box: {11.3, h - 14, 2.4} }
    head : HarborHullDark { Position: {0, h - 3, 0}; Box: {w + 8, 6, d + 6} }
  }

  template HarborGateArms {
    const p = 722 / 12

    for g in 0..4 {
      "gate_arm_{g}" {
        Rotation: {0, g * HALF_PI, 0}
        core : HarborGateRecess {
          Position: {0, 120, 511}
          Rotation: {HALF_PI, 0, 0}
          ProfileExtrusion: {
            profile: harbor_gate_arm_core,
            depth: 722,
            cap_start: true,
            cap_end: true
          }
        }

        collar : HarborHullDark {
          Position: {0, 120, 156}
          Rotation: {HALF_PI, 0, 0}
          ProfileExtrusion: {profile: harbor_gate_collar, depth: 32, cap_start: true, cap_end: true}
        }

        flange : HarborGateFrame {
          Position: {0, 120, 171}
          Rotation: {HALF_PI, 0, 0}
          ProfileExtrusion: {profile: harbor_gate_flange, depth: 3, cap_start: true, cap_end: true}
        }

        for m in 0..12 {
          const zc = 150 + (m + 0.5) * p
          const kind = m % 4 == 0 ? 2 : m % 2 == 1 ? 0 : 1
          "skin_{m}" {
            if kind == 0 {
              (IsA, HarborHull)
            } else if kind == 1 {
              (IsA, HarborGateSkin)
            } else {
              (IsA, HarborHullDark)
            }

            Position: {0, 120, zc}
            Rotation: {HALF_PI, 0, 0}
            ProfileExtrusion: {profile: harbor_arm, depth: p - 4, cap_start: true, cap_end: true}
          }

          "rib_{m}" : HarborGateFrame {
            Position: {0, 120, m == 11 ? 870.5 : zc + p / 2}
            Rotation: {HALF_PI, 0, 0}
            ProfileExtrusion: {
              profile: harbor_gate_arm_rib,
              depth: 3,
              cap_start: true,
              cap_end: true
            }
          }

          for s in 0..2 {
            const sx = s == 0 ? 0 - 1 : 1
            "plate_{m}_{s}" : HarborGateFrame {
              Position: {sx * 16, 145.2, zc + sx * 7}
              Box: {12, 0.4, p * 0.45}
            }

            if kind == 0 {
              "win_a_{m}_{s}" : HarborWindowGrid {
                Position: {sx * 40.25, 106, zc}
                Box: {0.5, 6, p - 14}
              }

              "win_b_{m}_{s}" : HarborWindowGrid {
                Position: {sx * 40.25, 118, zc}
                Box: {0.5, 6, p - 14}
              }
            } else if kind == 1 {
              "win_a_{m}_{s}" : HarborWindowGrid {
                Position: {sx * 40.25, 113, zc - 6}
                Box: {0.5, 12, p - 26}
              }

              "louver_{m}_{s}" : HarborPanel {
                Position: {sx * 40.3, 113, zc + p / 2 - 11}
                Box: {0.6, 12, 8}
              }
            } else {
              for v in 0..3 {
                "louver_{m}_{s}_{v}" : HarborPanel {
                  Position: {sx * 40.3, 112, zc - 16 + v * 13}
                  Box: {0.6, 12, 10}
                }
              }

              "hatch_{m}_{s}" : HarborYellow {
                Position: {sx * 40.3, 106, zc + 21}
                Box: {0.6, 14, 7}
              }

              "lamp_{m}_{s}" : HarborAmber { Position: {sx * 40.3, 125, zc}; Box: {0.4, 1, p - 12} }
            }
          }

          if kind == 2 {
            HarborMast "mast_{m}"(h: 14) { Position: {19, 145, zc + 12} }
            "vent_{m}" : HarborPanel { Position: {0 - 17, 146.25, zc}; Box: {8, 2.5, 14} }
            "grill_{m}" : HarborSteel {
              Position: {0 - 17, 147.7, zc}
              Cylinder: {radius: 3, length: 0.6, segments: 12}
            }
          }
        }

        for s in 0..2 {
          const sx = s == 0 ? 0 - 1 : 1
          "pipe_a_{s}" : HarborYellow {
            Position: {sx * 37.8, 136.8, 511}
            Rotation: {HALF_PI, 0, 0}
            Cylinder: {radius: 1.3, length: 712, segments: 10}
          }

          "pipe_b_{s}" : HarborSteel {
            Position: {sx * 32.6, 141.6, 511}
            Rotation: {HALF_PI, 0, 0}
            Cylinder: {radius: 1, length: 712, segments: 8}
          }

          "rail_{s}" : HarborSteel { Position: {sx * 5, 148, 511}; Box: {1.2, 1, 718} }
          "collar_light_{s}" : HarborAmber { Position: {sx * 47.2, 112, 156}; Box: {0.4, 1.5, 26} }
          "bearing_{s}" : HarborHullDark { Position: {sx * 18, 91.75, 820}; Box: {14, 6.5, 30} }
          "bearing_pad_{s}" : HarborHazard {
            Position: {sx * 18, 89.1, 820}
            Box: {14.4, 1.2, 30.4}
          }
        }

        conduit : HarborPanel { Position: {0, 93.7, 511}; Box: {16, 2.4, 718} }
        plinth : HarborPanel { Position: {0, 146.25, 511}; Box: {14, 2.5, 718} }
        saddle : HarborPanel { Position: {0, 94, 820}; Box: {50, 2, 34} }

        tram {
          Position: {0, 148.5, 200}
          Animator: {clip: harbor_gate_tram, time: g * 37, speed: 1, mode: Loop}
          bogie : HarborPanel { Position: {0, 1.2, 0}; Box: {12, 2.4, 16} }
          cab : HarborYellow { Position: {0, 5.4, 0}; Box: {10, 6, 13} }
          glass : HarborWindowCool { Position: {0, 6.2, 0}; Box: {10.3, 2, 9} }
          lamp : HarborBeaconAmber { Position: {0, 9.2, 0}; Sphere: {radius: 1, segments: 8} }
        }

        HarborGatePylon pylon_inner(h: 45, w: 40, d: 26) { Position: {0, 50, 400} }
        HarborGatePylon pylon_middle(h: 60, w: 40, d: 26) { Position: {0, 35, 667.5} }
      }
    }
  }

  // A clamp boom on the wall of a dock, hinged at the origin on a vertical axis. It lies folded
  // along the wall (-z, or +z when fold is -1) and swings out (+x) to a liner when down.
  template HarborClamp {
    prop down: bool = false
    prop set: bool = false
    prop fueling: bool = false
    prop fold: f32 = 1
    prop reach: f32 = 29
    const l = reach - 10
    base : HarborGateFrame { Position: {1.5, 0, 0}; Box: {3, 38, 28} }
    mount : HarborHullDark { Position: {4.5, 0, 0}; Box: {5, 30, 20} }

    for k in 0..2 {
      const ky = k == 0 ? 0 - 1 : 1
      "knuckle_{k}" : HarborSteel { Position: {8, ky * 14.5, 0}; Box: {10, 3, 12} }
      "pin_{k}" : HarborYellow {
        Position: {9, ky * 16.8, 0}
        Cylinder: {radius: 2.4, length: 1.6, segments: 10}
      }

      "bolt_{k}" : HarborHazard { Position: {3.4, ky * 17.5, 0}; Box: {0.4, 2.5, 26} }
    }

    hinge : HarborSteel { Position: {9, 0, 0}; Cylinder: {radius: 4, length: 26, segments: 12} }
    arm {
      Position: {9, 0, 0}
      Rotation: {0, down ? 0 : fold * HALF_PI, 0}
      Transition: [Rotation: {duration: 4, timing_function: EaseInOut}]
      root : HarborPanel { Position: {4, 0, 0}; Box: {7, 12, 11} }
      web : HarborPanel { Position: {l / 2, 0, 0}; Box: {l, 6, 7} }
      chord_top : HarborYellow { Position: {l / 2, 3.75, 0}; Box: {l, 1.5, 9} }
      chord_bottom : HarborYellow { Position: {l / 2, 0 - 3.75, 0}; Box: {l, 1.5, 9} }

      for s in 0..3 {
        "stiffener_{s}" : HarborYellow { Position: {l * (s + 1) / 4, 0, 0}; Box: {1.2, 6, 8.6} }
      }

      for f in 0..2 {
        const fz = f == 0 ? 0 - 3.65 : 3.65
        "glow_{f}" : HarborAmber { Position: {l / 2, 0, fz}; Box: {reach - 14, 1.2, 0.3} }
        "rod_{f}" : HarborSteel {
          Position: {l / 2 + 2, 5.2, f == 0 ? 0 - 3 : 3}
          Rotation: {0, 0, HALF_PI}
          Cylinder: {radius: 0.6, length: l - 2, segments: 6}
        }
      }

      line {
        Position: {(reach - 10) / 2, 4.7, 0}
        Box: {reach - 14, 0.4, 2.5}
        Rgb: {120, 240, 255}
        Emissive: {strength: fueling ? 12 : 0.5, color: {90, 220, 255}}
        Transition: [Emissive: {duration: 0.8, timing_function: EaseInOut}]
      }

      head : HarborYellow { Position: {reach - 7, 0, 0}; Box: {6, 20, 14} }

      for c in 0..2 {
        "cheek_{c}" : HarborPanel {
          Position: {reach - 7.5, 0, c == 0 ? 0 - 7.3 : 7.3}
          Box: {5, 16, 0.6}
        }
      }

      stripe : HarborHazard { Position: {reach - 7, 10.2, 0}; Box: {6.2, 0.4, 14.2} }
      pad {
        Position: {set ? reach - 3.2 : reach - 6, 0, 0}
        Transition: [Position: {duration: 4, timing_function: EaseInOut}]
        ram : HarborSteel {
          Position: {-3, 0, 0}
          Rotation: {0, 0, HALF_PI}
          Cylinder: {radius: 2.5, length: 6, segments: 10}
        }

        for r in 0..2 {
          "guide_{r}" : HarborSteel {
            Position: {-3, r == 0 ? 0 - 6 : 6, 0}
            Rotation: {0, 0, HALF_PI}
            Cylinder: {radius: 0.8, length: 6, segments: 6}
          }
        }

        shoe : HarborPanel { Box: {4, 18, 12} }
        rubber : HarborRubber { Position: {2.6, 0, 0}; Box: {1.2, 16, 10} }
      }

      lamp {
        Position: {reach - 7, 11, 0}
        Sphere: {radius: 1.5, segments: 8}

        if set {
          Rgb: {110, 240, 130}
          Emissive: {strength: 8, color: {90, 255, 110}}
        } else {
          Rgb: {255, 80, 60}
          Emissive: {strength: 8, color: {255, 60, 40}}
        }
      }
    }
  }

  template HarborGateGangway {
    prop set: bool = false
    collar : HarborHullDark { Position: {2, 0, 0}; Box: {4, 17, 17} }
    tube : HarborWhite {
      Position: {9, 0, 0}
      Rotation: {0, 0, HALF_PI}
      Cylinder: {radius: 5, length: 14, segments: 16}
    }

    band_a : HarborPanel {
      Position: {6, 0, 0}
      Rotation: {0, 0, HALF_PI}
      Cylinder: {radius: 5.5, length: 1, segments: 16}
    }

    band_b : HarborPanel {
      Position: {13, 0, 0}
      Rotation: {0, 0, HALF_PI}
      Cylinder: {radius: 5.5, length: 1, segments: 16}
    }

    windows : HarborWindow { Position: {9.5, 0.5, 0}; Box: {7, 1.2, 10.1} }
    strut : HarborSteel {
      Position: {5, -9.5, 0}
      Rotation: {0, 0, 0.73}
      Box: {13.4, 1.5, 1.5}
    }

    tele {
      Position: {set ? 20 : 14, 0, 0}
      Transition: [Position: {duration: 4, timing_function: EaseInOut}]
      tube : HarborWhite {
        Rotation: {0, 0, HALF_PI}
        Cylinder: {radius: 4.4, length: 12, segments: 16}
      }

      stripe : HarborHazard {
        Position: {3.5, 0, 0}
        Rotation: {0, 0, HALF_PI}
        Cylinder: {radius: 4.5, length: 1.5, segments: 16}
      }

      rim : HarborYellow {
        Position: {6, 0, 0}
        Rotation: {0, 0, HALF_PI}
        Cylinder: {radius: 6, length: 2, segments: 16}
      }

      seal : HarborRubber {
        Position: {7.5, 0, 0}
        Rotation: {0, 0, HALF_PI}
        Cylinder: {radius: 5.4, length: 1, segments: 16}
      }

      lamp {
        Position: {6, 7, 0}
        Sphere: {radius: 1, segments: 8}

        if set {
          Rgb: {110, 240, 130}
          Emissive: {strength: 8, color: {90, 255, 110}}
        } else {
          Rgb: {255, 176, 60}
          Emissive: {strength: 6, color: {255, 150, 40}}
        }
      }
    }
  }

  template HarborGateSide0 {
    prop idx: i32 = 0
    prop label: string = "NORTH GATE"
    sign : HarborSign { Position: {-53, 100, 55}; Box: {1, 40, 240} }
    rail_top : HarborGateFrame { Position: {-53.7, 121.2, 55}; Box: {2.4, 2.4, 244.8} }
    rail_bottom : HarborGateFrame { Position: {-53.7, 78.8, 55}; Box: {2.4, 2.4, 244.8} }
    cap_aft : HarborGateFrame { Position: {-53.7, 100, -66.2}; Box: {2.4, 44.8, 2.4} }
    cap_fore : HarborGateFrame { Position: {-53.7, 100, 176.2}; Box: {2.4, 44.8, 2.4} }
    title {
      Position: {-53.8, 106, 55}
      Rotation: {0, 0 - HALF_PI, 0}
      Text: {value: label, size: 26, align: Center}
      Rgb: {235, 238, 245}
      Emissive: {strength: 1.5, color: {235, 238, 245}}
    }

    subtitle {
      Position: {-53.8, 89, 55}
      Rotation: {0, 0 - HALF_PI, 0}
      Text: {value: "LINER DOCK {idx}", size: 11, align: Center}
      Rgb: {255, 190, 90}
      Emissive: {strength: 2, color: {255, 170, 60}}
    }

    trim : HarborAmber { Position: {-53.6, 82, 55}; Box: {0.6, 1.5, 236} }
  }


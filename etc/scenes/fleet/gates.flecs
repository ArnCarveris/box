  template HarborGateHvac {
    base : HarborPanel { Position: {0, 2.5, 0}; Box: {16, 5, 26} }

    for f in 0..2 {
      "fan_{f}" : HarborSteel {
        Position: {0, 5.4, f == 0 ? -6 : 6}
        Cylinder: {radius: 5, length: 1.2, segments: 16}
      }

      "grill_{f}" : HarborRubber {
        Position: {0, 5.6, f == 0 ? -6 : 6}

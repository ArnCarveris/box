  // A fern: seven fronds from its origin on the ground, one unit long (the shorter ones less),
  // rising and arching out and down toward their tips, their faces up. Backs are reversed copies
  prefab ForestFernMesh {
    Mesh3: {
      vertices: [
        {0.304, 0, 0.065}, {-0.311, 0, -0.006}, {0.29, 0.214, 0.194}, {-0.326, 0.214, 0.123},
        {0.272, 0.413, 0.344}, {-0.344, 0.413, 0.273}, {0.249, 0.556, 0.548}, {-0.367, 0.556, 0.476},
        {0.22, 0.58, 0.795}, {-0.396, 0.58, 0.724}, {0.304, 0, 0.065}, {-0.311, 0, -0.006},
        {0.29, 0.214, 0.194}, {-0.326, 0.214, 0.123}, {0.272, 0.413, 0.344}, {-0.344, 0.413, 0.273},
        {0.249, 0.556, 0.548}, {-0.367, 0.556, 0.476}, {0.22, 0.58, 0.795}, {-0.396, 0.58, 0.724},
        {0.195, 0, -0.18}, {-0.15, 0, 0.219}, {0.304, 0.156, -0.085}, {-0.041, 0.156, 0.313},
        {0.425, 0.296, 0.019}, {0.08, 0.296, 0.418}, {0.573, 0.381, 0.147}, {0.228, 0.381, 0.545},

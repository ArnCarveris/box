using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.texture
using state
using assets

// The undergrowth of the forest floor between the trees and the brook: alpha cut grass clumps
// and sedge, ferns, wildflowers, reeds at the brook, shrubs, moss cushions, mushrooms, fallen
// logs, stumps, rocks, twigs and leaf litter. Each kind is scattered on a seeded, jittered grid
// of its own and kept by the light of its spot (forest_light): grass and flowers in the sun of
// the clearing and along the brook, ferns, moss, litter and mushrooms in the shade. Nothing grows
// on the path, in the brook bed or under the landmarks, and the plants thin out toward the
// backdrop.
//
// The materials of every kind are on shared prefabs (Rgb, textures, cutoff), and every instance
// carries a ForestPlant with its kind and a seeded value, so the season task recolors a kind
// through its prefab and thins it by the seed. The grass, flower and reed clumps have their origin
// on the ground at the foot of the clump, so the wind bends them by height.
state {
  // An undergrowth instance: its kind (PLANT_*) and its seeded value, 0..1, by which the season
  // task can thin a kind (hiding the instances below a threshold)
  struct ForestPlant(kind: i32, seed: f32)

  export const PLANT_GRASS: i32 = 0
  export const PLANT_SEDGE: i32 = 1
  export const PLANT_FERN: i32 = 2
  export const PLANT_FLOWER: i32 = 3
  export const PLANT_REED: i32 = 4
  export const PLANT_SHRUB: i32 = 5
  export const PLANT_MOSS: i32 = 6
  export const PLANT_MUSHROOM: i32 = 7
  export const PLANT_LITTER: i32 = 8
  export const PLANT_LOG: i32 = 9
  export const PLANT_STUMP: i32 = 10
  export const PLANT_ROCK: i32 = 11
  export const PLANT_TWIG: i32 = 12

  // The undergrowth is dense within UNDER_FULL of the origin and thins out to UNDER_EDGE
  export const UNDER_FULL: f32 = 28
  export const UNDER_EDGE: f32 = 50

  // The scatter grids: cell sizes, and cells across the 2 * UNDER_EDGE square around the origin.
  // The cells of the grass, flowers, ferns and litter hold four spots each, jittered in their
  // quarters, which share the light and density of the cell
  export const GRASS_CELL: f32 = 1.2
  export const GRASS_GRID: i32 = 84
  export const FERN_CELL: f32 = 3.4
  export const FERN_GRID: i32 = 30
  export const FLOWER_CELL: f32 = 2.5
  export const FLOWER_GRID: i32 = 40
  export const LITTER_CELL: f32 = 2.2
  export const LITTER_GRID: i32 = 46
  export const SMALL_CELL: f32 = 2.5
  export const SMALL_GRID: i32 = 40

  // Logs, stumps and shrubs: at most one in each FEATURE_CELL, near the middle of it
  export const FEATURE_CELL: f32 = 6
  export const FEATURE_GRID: i32 = 16
  export const FEATURE_NONE: i32 = 0
  export const FEATURE_LOG: i32 = 1
  export const FEATURE_STUMP: i32 = 2
  export const FEATURE_SHRUB: i32 = 3

  // Reeds stand on the banks of the brook from REED_D0 to REED_D1 off its centerline, above the
  // water line, every REED_STEP meters along it on either side
  export const REED_D0: f32 = 1.45
  export const REED_D1: f32 = 2.3
  export const REED_STEP: f32 = 0.3
  export const REED_COUNT: i32 = 300

  // Light on the floor at (x, z), 0..1: full in the clearing, fading over the first meters of the
  // forest, the gap of the canopy over the brook, and sunny patches in the forest
  fn forest_light(x: f64, z: f64) -> f64 {
    const open = forest_smooth(7, -1, forest_clearing_distance(x, z))
    const brook = forest_smooth(7, 3, forest_brook_distance(x, z)) * 0.65
    const fleck = forest_smooth(0.55, 0.9, forest_hash2(floor(x / 5), floor(z / 5), 41)) * 0.5
    clamp(max(max(open, brook), fleck), 0, 1)
  }

  // Share of the undergrowth kept at (x, z): all of it within UNDER_FULL, none past UNDER_EDGE
  fn forest_under_density(x: f64, z: f64) -> f64 {
    const r = max(abs(x), abs(z)) * 0.6 + sqrt(x * x + z * z) * 0.4
    forest_smooth(UNDER_EDGE, UNDER_FULL, r)
  }

  // Within r of the spot of the mature tree or the young tree of grid cell (gx, gz)
  fn forest_tree_cell_near(gx: f64, gz: f64, x: f64, z: f64, r: f64) -> bool {
    const i = gx * TREE_GRID + gz
    const mx = (gx + 0.15 + 0.7 * forest_hash(i, 101)) * TREE_CELL - BACKDROP_START
    const mz = (gz + 0.15 + 0.7 * forest_hash(i, 102)) * TREE_CELL - BACKDROP_START
    const yx = (gx + 0.5 + 0.8 * (forest_hash(i, 121) - 0.5)) * YOUNG_CELL - BACKDROP_START
    const yz = (gz + 0.5 + 0.8 * (forest_hash(i, 122) - 0.5)) * YOUNG_CELL - BACKDROP_START
    forest_near(x, z, mx, mz, r) || forest_near(x, z, yx, yz, r * 0.7)
  }

  // Within r of a tree of stands.flecs (or of a gap where one was left out): the trees of the
  // four grid cells around (x, z)
  fn forest_trees_near(x: f64, z: f64, r: f64) -> bool {
    const gx = floor((x + BACKDROP_START) / TREE_CELL - 0.5)
    const gz = floor((z + BACKDROP_START) / TREE_CELL - 0.5)
    forest_tree_cell_near(gx, gz, x, z, r) ? true : (forest_tree_cell_near(gx + 1, gz, x, z, r) ? true : (
      forest_tree_cell_near(gx, gz + 1, x, z, r) ? true : forest_tree_cell_near(gx + 1, gz + 1, x, z, r)))
  }

  // A plant of radius r at (x, z) stays off the path, out of the brook bed and clear of the
  // landmarks
  fn forest_floor_free(x: f64, z: f64, r: f64) -> bool {
    forest_free(x, z, r) ? !forest_landmark_near(x, z, r) : false
  }

  // The feature of grid cell (gx, gz): its spot, its kind and its yaw; a log lies along its yaw
  // from its spot (local +Z turned by the yaw), forest_log_len long
  fn forest_feature_i(gx: f64, gz: f64) -> f64 {
    gx * FEATURE_GRID + gz
  }

  fn forest_feature_x(gx: f64, gz: f64) -> f64 {
    (gx + 0.3 + 0.4 * forest_hash(forest_feature_i(gx, gz), 401)) * FEATURE_CELL - FEATURE_GRID * FEATURE_CELL / 2
  }

  fn forest_feature_z(gx: f64, gz: f64) -> f64 {
    (gz + 0.3 + 0.4 * forest_hash(forest_feature_i(gx, gz), 402)) * FEATURE_CELL - FEATURE_GRID * FEATURE_CELL / 2
  }

  fn forest_feature_yaw(gx: f64, gz: f64) -> f64 {
    forest_hash(forest_feature_i(gx, gz), 404) * 6.2832
  }

  fn forest_log_len(gx: f64, gz: f64) -> f64 {
    3 + 1.6 * forest_hash(forest_feature_i(gx, gz), 405)
  }

  fn forest_log_radius(gx: f64, gz: f64) -> f64 {
    0.18 + 0.14 * forest_hash(forest_feature_i(gx, gz), 406)
  }

  fn forest_stump_radius(gx: f64, gz: f64) -> f64 {
    0.25 + 0.2 * forest_hash(forest_feature_i(gx, gz), 406)
  }

  // Logs lie in the forest and the edge of the clearing, stumps in the forest; the cell's spot
  // decides, its own seeded value picks. FEATURE_NONE leaves the cell to a shrub or nothing
  fn forest_feature_solid_at(x: f64, z: f64, h: f64) -> i32 {
    const edge = forest_clearing_distance(x, z)
    const inside = forest_under_density(x, z) > 0.2 && forest_zone(x, z) != ZONE_BACKDROP
    !inside ? FEATURE_NONE : (h < 0.14 && edge > -5 ? FEATURE_LOG : (h < 0.26 && edge > 1 ? FEATURE_STUMP : FEATURE_NONE))
  }

  fn forest_feature_solid(gx: f64, gz: f64) -> i32 {
    const h = forest_hash(forest_feature_i(gx, gz), 403)
    h >= 0.26 ? FEATURE_NONE : forest_feature_solid_at(forest_feature_x(gx, gz), forest_feature_z(gx, gz), h)
  }

  // The feature of a cell: its log or stump, else a shrub, mostly in the shade
  fn forest_feature_kind(gx: f64, gz: f64) -> i32 {
    const x = forest_feature_x(gx, gz)
    const z = forest_feature_z(gx, gz)
    const h = forest_hash(forest_feature_i(gx, gz), 403)
    const solid = forest_feature_solid(gx, gz)
    const shrub = h < 0.26 + 0.4 * (1 - 0.6 * forest_light(x, z)) && forest_clearing_distance(x, z) > -1.5
    solid != FEATURE_NONE ? solid : (forest_under_density(x, z) > 0.2 && shrub ? FEATURE_SHRUB : FEATURE_NONE)
  }

  // Distance from (x, z) to the axis of the log of cell (gx, gz)
  fn forest_log_distance(gx: f64, gz: f64, x: f64, z: f64) -> f64 {
    const yaw = forest_feature_yaw(gx, gz)
    const dx = sin(yaw)
    const dz = cos(yaw)
    const ax = forest_feature_x(gx, gz)
    const az = forest_feature_z(gx, gz)
    const t = clamp((x - ax) * dx + (z - az) * dz, 0, forest_log_len(gx, gz))
    const px = ax + dx * t
    const pz = az + dz * t
    sqrt((x - px) * (x - px) + (z - pz) * (z - pz))
  }

  // Within pad of the log or the stump of cell (gx, gz)
  fn forest_feature_cell_near(gx: f64, gz: f64, x: f64, z: f64, pad: f64) -> bool {
    const k = forest_feature_solid(gx, gz)
    k == FEATURE_LOG ? forest_log_distance(gx, gz, x, z) < forest_log_radius(gx, gz) + pad : (
      k == FEATURE_STUMP ? forest_near(x, z, forest_feature_x(gx, gz), forest_feature_z(gx, gz), forest_stump_radius(gx, gz) * 1.5 + pad) : false)
  }

  // Within pad of a log or a stump: the features of the four grid cells around (x, z), as far
  // as a log reaches
  fn forest_feature_near(x: f64, z: f64, pad: f64) -> bool {
    const gx = floor((x + FEATURE_GRID * FEATURE_CELL / 2) / FEATURE_CELL - 0.5)
    const gz = floor((z + FEATURE_GRID * FEATURE_CELL / 2) / FEATURE_CELL - 0.5)
    forest_feature_cell_near(gx, gz, x, z, pad) ? true : (forest_feature_cell_near(gx + 1, gz, x, z, pad) ? true : (
      forest_feature_cell_near(gx, gz + 1, x, z, pad) ? true : forest_feature_cell_near(gx + 1, gz + 1, x, z, pad)))
  }

  // The kind of a small thing by its seeded value h and the light of its spot: moss and
  // mushrooms in the shade, else rocks and twigs, or nothing (-1)
  fn forest_small_kind(h: f64, light: f64) -> i32 {
    const shade = 1 - light
    h < 0.32 * shade ? PLANT_MOSS : (
      h < 0.52 * shade ? PLANT_MUSHROOM : (
      h < 0.62 ? PLANT_ROCK : (h < 0.85 ? PLANT_TWIG : 0 - 1)))
  }

  // A blade i of a tuft: its foot near the middle of the bottom edge, its angle within spread
  // degrees of upright, its length from len_min up
  fn forest_tuft_x(i: f64, seed: f64) -> f64 {
    0.5 + (forest_hash(i, seed) - 0.5) * 0.2
  }

  fn forest_tuft_angle(i: f64, seed: f64, spread: f64) -> f64 {
    (forest_hash(i + 30, seed) * 2 - 1) * spread
  }

  fn forest_tuft_len(i: f64, seed: f64, len_min: f64) -> f64 {
    len_min + (0.96 - len_min) * forest_hash(i + 50, seed)
  }

  // Leaf i of a patch of litter, anywhere in the map
  fn forest_litter_x(i: f64, seed: f64) -> f64 {
    0.18 + 0.64 * forest_hash(i + 20, seed)
  }

  fn forest_litter_y(i: f64, seed: f64) -> f64 {
    0.18 + 0.64 * forest_hash(i + 40, seed)
  }
}

assets {
  // A blade of grass from the middle of the bottom edge to the top, width to either side of its
  // midrib and tapering over its upper part to a point, the tone lighter toward its tip
  template ForestGrassBladeMap {
    prop width: f32 = 0.022

    uv { nodes.Coords: {} }
    u { nodes.Split: {input: uv, channel: ChannelR} }
    v { nodes.Split: {input: uv, channel: ChannelG} }
    off { nodes.Subtract: {a: u, b_value: {0.5, 0, 0, 0}} }
    side { nodes.Abs: {input: off} }
    along { nodes.Subtract: {a_value: {0.995, 0, 0, 0}, b: v} }
    taper { nodes.Smoothstep: {input: along, edge0_value: {0.99, 0, 0, 0}, edge1_value: {0.3, 0, 0, 0}} }
    half { nodes.Multiply: {a: taper, b_value: {width, 0, 0, 0}} }
    inside { nodes.Subtract: {a: half, b: side} }
    blade { nodes.Smoothstep: {input: inside, edge0_value: {0, 0, 0, 0}, edge1_value: {0.004, 0, 0, 0}} }
    foot { nodes.Smoothstep: {input: along, edge0_value: {0, 0, 0, 0}, edge1_value: {0.01, 0, 0, 0}} }
    cover { nodes.Multiply: {a: blade, b: foot} }
    rib { nodes.Smoothstep: {input: side, edge0_value: {0.004, 0, 0, 0}, edge1_value: {0.0015, 0, 0, 0}} }
    vein { nodes.Multiply: {a: rib, b: cover} }
    shade { nodes.Remap: {input: along, from_min: 0, from_max: 1, to_min: 0.4, to_max: 1, clamp: true} }
    tone { nodes.Multiply: {a: shade, b: cover} }
    dome { nodes.Smoothstep: {input: inside, edge0_value: {0, 0, 0, 0}, edge1_value: {width * 0.6, 0, 0, 0}} }
    dome_h { nodes.Multiply: {a: dome, b_value: {0.25, 0, 0, 0}} }
    height { nodes.Add: {a: dome_h, b_value: {0.42, 0, 0, 0}} }
    data { nodes.Combine: {r: cover, g: vein, b: tone, a: height} }
    ForestFrame framed(input: data)
    Graph: {output: framed, width: SPRAY_RES, format: GraphLinear}
  }

  // A tuft: 11 blades of tex from near the middle of the bottom edge, fanned within spread
  // degrees of upright, from len_min to nearly the height of the map, each with a seeded tone.
  // A stage of a graph reads at most 12 nodes, so a denser tuft stamps 11 more over this one
  // with ForestTuftMoreMap
  template ForestTuftMap {
    prop tex: entity = 0
    prop seed: f32 = 1
    prop spread: f32 = 25
    prop len_min: f32 = 0.5
    prop tone_min: f32 = 0.5

    ForestStamp b0(tex: tex, x: forest_tuft_x(0, seed), y: 0.995, angle: forest_tuft_angle(0, seed, spread), len: forest_tuft_len(0, seed, len_min), tone: forest_pinnate_tone(0, seed, tone_min))
    ForestStamp b1(prev: b0, tex: tex, x: forest_tuft_x(1, seed), y: 0.995, angle: forest_tuft_angle(1, seed, spread), len: forest_tuft_len(1, seed, len_min), tone: forest_pinnate_tone(1, seed, tone_min))
    ForestStamp b2(prev: b1, tex: tex, x: forest_tuft_x(2, seed), y: 0.995, angle: forest_tuft_angle(2, seed, spread), len: forest_tuft_len(2, seed, len_min), tone: forest_pinnate_tone(2, seed, tone_min))
    ForestStamp b3(prev: b2, tex: tex, x: forest_tuft_x(3, seed), y: 0.995, angle: forest_tuft_angle(3, seed, spread), len: forest_tuft_len(3, seed, len_min), tone: forest_pinnate_tone(3, seed, tone_min))
    ForestStamp b4(prev: b3, tex: tex, x: forest_tuft_x(4, seed), y: 0.995, angle: forest_tuft_angle(4, seed, spread), len: forest_tuft_len(4, seed, len_min), tone: forest_pinnate_tone(4, seed, tone_min))
    ForestStamp b5(prev: b4, tex: tex, x: forest_tuft_x(5, seed), y: 0.995, angle: forest_tuft_angle(5, seed, spread), len: forest_tuft_len(5, seed, len_min), tone: forest_pinnate_tone(5, seed, tone_min))
    ForestStamp b6(prev: b5, tex: tex, x: forest_tuft_x(6, seed), y: 0.995, angle: forest_tuft_angle(6, seed, spread), len: forest_tuft_len(6, seed, len_min), tone: forest_pinnate_tone(6, seed, tone_min))
    ForestStamp b7(prev: b6, tex: tex, x: forest_tuft_x(7, seed), y: 0.995, angle: forest_tuft_angle(7, seed, spread), len: forest_tuft_len(7, seed, len_min), tone: forest_pinnate_tone(7, seed, tone_min))
    ForestStamp b8(prev: b7, tex: tex, x: forest_tuft_x(8, seed), y: 0.995, angle: forest_tuft_angle(8, seed, spread), len: forest_tuft_len(8, seed, len_min), tone: forest_pinnate_tone(8, seed, tone_min))
    ForestStamp b9(prev: b8, tex: tex, x: forest_tuft_x(9, seed), y: 0.995, angle: forest_tuft_angle(9, seed, spread), len: forest_tuft_len(9, seed, len_min), tone: forest_pinnate_tone(9, seed, tone_min))
    ForestStamp b10(prev: b9, tex: tex, x: forest_tuft_x(10, seed), y: 0.995, angle: forest_tuft_angle(10, seed, spread), len: forest_tuft_len(10, seed, len_min), tone: forest_pinnate_tone(10, seed, tone_min))
    Graph: {output: b10, width: LEAF_RES, format: GraphLinear}
  }

  // 11 more blades of tex over the tuft base_tex, as ForestTuftMap
  template ForestTuftMoreMap {
    prop base_tex: entity = 0
    prop tex: entity = 0
    prop seed: f32 = 1
    prop spread: f32 = 25
    prop len_min: f32 = 0.5
    prop tone_min: f32 = 0.5

    base { nodes.Image: {texture: base_tex, linear: true} }
    ForestStamp b0(prev: base, tex: tex, x: forest_tuft_x(0, seed + 13), y: 0.995, angle: forest_tuft_angle(0, seed + 13, spread), len: forest_tuft_len(0, seed + 13, len_min), tone: forest_pinnate_tone(0, seed + 13, tone_min))
    ForestStamp b1(prev: b0, tex: tex, x: forest_tuft_x(1, seed + 13), y: 0.995, angle: forest_tuft_angle(1, seed + 13, spread), len: forest_tuft_len(1, seed + 13, len_min), tone: forest_pinnate_tone(1, seed + 13, tone_min))
    ForestStamp b2(prev: b1, tex: tex, x: forest_tuft_x(2, seed + 13), y: 0.995, angle: forest_tuft_angle(2, seed + 13, spread), len: forest_tuft_len(2, seed + 13, len_min), tone: forest_pinnate_tone(2, seed + 13, tone_min))
    ForestStamp b3(prev: b2, tex: tex, x: forest_tuft_x(3, seed + 13), y: 0.995, angle: forest_tuft_angle(3, seed + 13, spread), len: forest_tuft_len(3, seed + 13, len_min), tone: forest_pinnate_tone(3, seed + 13, tone_min))
    ForestStamp b4(prev: b3, tex: tex, x: forest_tuft_x(4, seed + 13), y: 0.995, angle: forest_tuft_angle(4, seed + 13, spread), len: forest_tuft_len(4, seed + 13, len_min), tone: forest_pinnate_tone(4, seed + 13, tone_min))
    ForestStamp b5(prev: b4, tex: tex, x: forest_tuft_x(5, seed + 13), y: 0.995, angle: forest_tuft_angle(5, seed + 13, spread), len: forest_tuft_len(5, seed + 13, len_min), tone: forest_pinnate_tone(5, seed + 13, tone_min))
    ForestStamp b6(prev: b5, tex: tex, x: forest_tuft_x(6, seed + 13), y: 0.995, angle: forest_tuft_angle(6, seed + 13, spread), len: forest_tuft_len(6, seed + 13, len_min), tone: forest_pinnate_tone(6, seed + 13, tone_min))
    ForestStamp b7(prev: b6, tex: tex, x: forest_tuft_x(7, seed + 13), y: 0.995, angle: forest_tuft_angle(7, seed + 13, spread), len: forest_tuft_len(7, seed + 13, len_min), tone: forest_pinnate_tone(7, seed + 13, tone_min))
    ForestStamp b8(prev: b7, tex: tex, x: forest_tuft_x(8, seed + 13), y: 0.995, angle: forest_tuft_angle(8, seed + 13, spread), len: forest_tuft_len(8, seed + 13, len_min), tone: forest_pinnate_tone(8, seed + 13, tone_min))
    ForestStamp b9(prev: b8, tex: tex, x: forest_tuft_x(9, seed + 13), y: 0.995, angle: forest_tuft_angle(9, seed + 13, spread), len: forest_tuft_len(9, seed + 13, len_min), tone: forest_pinnate_tone(9, seed + 13, tone_min))
    ForestStamp b10(prev: b9, tex: tex, x: forest_tuft_x(10, seed + 13), y: 0.995, angle: forest_tuft_angle(10, seed + 13, spread), len: forest_tuft_len(10, seed + 13, len_min), tone: forest_pinnate_tone(10, seed + 13, tone_min))
    Graph: {output: b10, width: LEAF_RES, format: GraphLinear}
  }

  // A flower on its stalk, or a reed head: a stalk from the middle of the bottom edge up to a
  // head head_w by head_h to either side of its middle head_y below the top, with an eye of eye
  // of its size. The head is marked in green, 1 on the petals and 0.5 on the eye, the stalk has
  // the tone
  template ForestStalkMap {
    prop head_w: f32 = 0.1
    prop head_h: f32 = 0.07
    prop head_y: f32 = 0.16
    prop eye: f32 = 0.4
    prop stalk: f32 = 0.012

    uv { nodes.Coords: {} }
    u { nodes.Split: {input: uv, channel: ChannelR} }
    v { nodes.Split: {input: uv, channel: ChannelG} }
    off { nodes.Subtract: {a: u, b_value: {0.5, 0, 0, 0}} }
    side { nodes.Abs: {input: off} }
    hx { nodes.Multiply: {a: off, b_value: {1 / head_w, 0, 0, 0}} }
    hy_off { nodes.Subtract: {a: v, b_value: {head_y, 0, 0, 0}} }
    hy { nodes.Multiply: {a: hy_off, b_value: {1 / head_h, 0, 0, 0}} }
    hx2 { nodes.Multiply: {a: hx, b: hx} }
    hy2 { nodes.Multiply: {a: hy, b: hy} }
    r2 { nodes.Add: {a: hx2, b: hy2} }
    head { nodes.Smoothstep: {input: r2, edge0_value: {1, 0, 0, 0}, edge1_value: {0.8, 0, 0, 0}} }
    eye_m { nodes.Smoothstep: {input: r2, edge0_value: {eye * eye, 0, 0, 0}, edge1_value: {eye * eye * 0.6, 0, 0, 0}} }
    stalk_w { nodes.Smoothstep: {input: side, edge0_value: {stalk, 0, 0, 0}, edge1_value: {stalk * 0.4, 0, 0, 0}} }
    below { nodes.Step: {input: v, edge_value: {head_y, 0, 0, 0}} }
    above_foot { nodes.Step: {input_value: {0.993, 0, 0, 0}, edge: v} }
    stalk_span { nodes.Multiply: {a: below, b: above_foot} }
    stalk_m { nodes.Multiply: {a: stalk_w, b: stalk_span} }
    cover { nodes.Max: {a: head, b: stalk_m} }
    eye_half { nodes.Multiply: {a: eye_m, b_value: {0.5, 0, 0, 0}} }
    petal { nodes.Subtract: {a: head, b: eye_half} }
    bare { nodes.Subtract: {a_value: {1, 0, 0, 0}, b: head} }
    stalk_t { nodes.Multiply: {a: stalk_m, b: bare} }
    tone { nodes.Multiply: {a: stalk_t, b_value: {0.6, 0, 0, 0}} }
    dome { nodes.Smoothstep: {input: r2, edge0_value: {1, 0, 0, 0}, edge1_value: {0.2, 0, 0, 0}} }
    dome_h { nodes.Multiply: {a: dome, b_value: {0.2, 0, 0, 0}} }
    height { nodes.Add: {a: dome_h, b_value: {0.42, 0, 0, 0}} }
    data { nodes.Combine: {r: cover, g: petal, b: tone, a: height} }
    ForestFrame framed(input: data)
    Graph: {output: framed, width: SPRAY_RES, format: GraphLinear}
  }

  // A tuft with flowers: 7 stalks of tex over the tuft base, fanned within spread degrees
  template ForestBloomMap {
    prop base_tex: entity = 0
    prop tex: entity = 0
    prop seed: f32 = 1
    prop spread: f32 = 18
    prop len_min: f32 = 0.6

    base { nodes.Image: {texture: base_tex, linear: true} }
    ForestStamp f0(prev: base, tex: tex, x: forest_tuft_x(0, seed + 7), y: 0.995, angle: forest_tuft_angle(0, seed + 7, spread), len: forest_tuft_len(0, seed + 7, len_min), tone: 1)
    ForestStamp f1(prev: f0, tex: tex, x: forest_tuft_x(1, seed + 7), y: 0.995, angle: forest_tuft_angle(1, seed + 7, spread), len: forest_tuft_len(1, seed + 7, len_min), tone: 1)
    ForestStamp f2(prev: f1, tex: tex, x: forest_tuft_x(2, seed + 7), y: 0.995, angle: forest_tuft_angle(2, seed + 7, spread), len: forest_tuft_len(2, seed + 7, len_min), tone: 1)
    ForestStamp f3(prev: f2, tex: tex, x: forest_tuft_x(3, seed + 7), y: 0.995, angle: forest_tuft_angle(3, seed + 7, spread), len: forest_tuft_len(3, seed + 7, len_min), tone: 1)
    ForestStamp f4(prev: f3, tex: tex, x: forest_tuft_x(4, seed + 7), y: 0.995, angle: forest_tuft_angle(4, seed + 7, spread), len: forest_tuft_len(4, seed + 7, len_min), tone: 1)
    ForestStamp f5(prev: f4, tex: tex, x: forest_tuft_x(5, seed + 7), y: 0.995, angle: forest_tuft_angle(5, seed + 7, spread), len: forest_tuft_len(5, seed + 7, len_min), tone: 1)
    ForestStamp f6(prev: f5, tex: tex, x: forest_tuft_x(6, seed + 7), y: 0.995, angle: forest_tuft_angle(6, seed + 7, spread), len: forest_tuft_len(6, seed + 7, len_min), tone: 1)
    Graph: {output: f6, width: LEAF_RES, format: GraphLinear}
  }

  // The albedo of a tuft with flowers: greens by the tone, the petals (pr, pg, pb) and the eye
  // (er, eg, eb), darker toward the foot, the coverage as alpha
  template ForestBloomAlbedo {
    prop data: entity = 0
    prop pr: f32 = 1
    prop pg: f32 = 1
    prop pb: f32 = 1
    prop er: f32 = 1
    prop eg: f32 = 0.8
    prop eb: f32 = 0.2

    img { nodes.Image: {texture: data, linear: true} }
    cover { nodes.Split: {input: img, channel: ChannelR} }
    petal { nodes.Split: {input: img, channel: ChannelG} }
    tone { nodes.Split: {input: img, channel: ChannelB} }
    uv { nodes.Coords: {} }
    v { nodes.Split: {input: uv, channel: ChannelG} }
    inner { nodes.Remap: {input: v, from_min: 0.3, from_max: 1, to_min: 1, to_max: 0.55, clamp: true} }
    leaf {
      nodes.Ramp: {
        input: tone,
        keys: [{0, {52, 74, 30}}, {0.3, {66, 96, 36}}, {0.6, {94, 126, 46}}, {1, {128, 152, 60}}]
      }
    }

    leaf_s { nodes.Multiply: {a: leaf, b: inner} }
    is_eye { nodes.Smoothstep: {input: petal, edge0_value: {0.3, 0, 0, 0}, edge1_value: {0.45, 0, 0, 0}} }
    is_petal { nodes.Smoothstep: {input: petal, edge0_value: {0.7, 0, 0, 0}, edge1_value: {0.85, 0, 0, 0}} }
    eyed { nodes.Mix: {a: leaf_s, b_value: {er, eg, eb, 1}, factor: is_eye} }
    petaled { nodes.Mix: {a: eyed, b_value: {pr, pg, pb, 1}, factor: is_petal} }
    r { nodes.Split: {input: petaled, channel: ChannelR} }
    g { nodes.Split: {input: petaled, channel: ChannelG} }
    b { nodes.Split: {input: petaled, channel: ChannelB} }
    color { nodes.Combine: {r: r, g: g, b: b, a: cover} }
    Graph: {output: color, width: LEAF_RES}
  }

  // A patch of leaf litter: 11 fallen leaves of tex_a and tex_b strewn over the map, turned any
  // way, each with a seeded tone. ForestLitterMoreMap strews 11 more over it
  template ForestLitterPatchMap {
    prop tex_a: entity = 0
    prop tex_b: entity = 0
    prop seed: f32 = 1

    ForestStamp l0(tex: tex_a, x: forest_litter_x(0, seed), y: forest_litter_y(0, seed), angle: forest_hash(0 + 60, seed) * 360, len: 0.15 + 0.08 * forest_hash(0 + 80, seed), tone: forest_hash(0 + 100, seed))
    ForestStamp l1(prev: l0, tex: tex_a, x: forest_litter_x(1, seed), y: forest_litter_y(1, seed), angle: forest_hash(1 + 60, seed) * 360, len: 0.15 + 0.08 * forest_hash(1 + 80, seed), tone: forest_hash(1 + 100, seed))
    ForestStamp l2(prev: l1, tex: tex_b, x: forest_litter_x(2, seed), y: forest_litter_y(2, seed), angle: forest_hash(2 + 60, seed) * 360, len: 0.15 + 0.08 * forest_hash(2 + 80, seed), tone: forest_hash(2 + 100, seed))
    ForestStamp l3(prev: l2, tex: tex_a, x: forest_litter_x(3, seed), y: forest_litter_y(3, seed), angle: forest_hash(3 + 60, seed) * 360, len: 0.15 + 0.08 * forest_hash(3 + 80, seed), tone: forest_hash(3 + 100, seed))
    ForestStamp l4(prev: l3, tex: tex_a, x: forest_litter_x(4, seed), y: forest_litter_y(4, seed), angle: forest_hash(4 + 60, seed) * 360, len: 0.15 + 0.08 * forest_hash(4 + 80, seed), tone: forest_hash(4 + 100, seed))
    ForestStamp l5(prev: l4, tex: tex_b, x: forest_litter_x(5, seed), y: forest_litter_y(5, seed), angle: forest_hash(5 + 60, seed) * 360, len: 0.15 + 0.08 * forest_hash(5 + 80, seed), tone: forest_hash(5 + 100, seed))
    ForestStamp l6(prev: l5, tex: tex_a, x: forest_litter_x(6, seed), y: forest_litter_y(6, seed), angle: forest_hash(6 + 60, seed) * 360, len: 0.15 + 0.08 * forest_hash(6 + 80, seed), tone: forest_hash(6 + 100, seed))
    ForestStamp l7(prev: l6, tex: tex_a, x: forest_litter_x(7, seed), y: forest_litter_y(7, seed), angle: forest_hash(7 + 60, seed) * 360, len: 0.15 + 0.08 * forest_hash(7 + 80, seed), tone: forest_hash(7 + 100, seed))
    ForestStamp l8(prev: l7, tex: tex_b, x: forest_litter_x(8, seed), y: forest_litter_y(8, seed), angle: forest_hash(8 + 60, seed) * 360, len: 0.15 + 0.08 * forest_hash(8 + 80, seed), tone: forest_hash(8 + 100, seed))
    ForestStamp l9(prev: l8, tex: tex_a, x: forest_litter_x(9, seed), y: forest_litter_y(9, seed), angle: forest_hash(9 + 60, seed) * 360, len: 0.15 + 0.08 * forest_hash(9 + 80, seed), tone: forest_hash(9 + 100, seed))
    ForestStamp l10(prev: l9, tex: tex_a, x: forest_litter_x(10, seed), y: forest_litter_y(10, seed), angle: forest_hash(10 + 60, seed) * 360, len: 0.15 + 0.08 * forest_hash(10 + 80, seed), tone: forest_hash(10 + 100, seed))
    ForestFrame framed(input: l10)
    Graph: {output: framed, width: LEAF_RES, format: GraphLinear}
  }

  template ForestLitterMoreMap {
    prop base_tex: entity = 0
    prop tex_a: entity = 0
    prop tex_b: entity = 0
    prop seed: f32 = 1

    base { nodes.Image: {texture: base_tex, linear: true} }
    ForestStamp l0(prev: base, tex: tex_a, x: forest_litter_x(0, seed + 13), y: forest_litter_y(0, seed + 13), angle: forest_hash(0 + 60, seed + 13) * 360, len: 0.15 + 0.08 * forest_hash(0 + 80, seed + 13), tone: forest_hash(0 + 100, seed + 13))
    ForestStamp l1(prev: l0, tex: tex_a, x: forest_litter_x(1, seed + 13), y: forest_litter_y(1, seed + 13), angle: forest_hash(1 + 60, seed + 13) * 360, len: 0.15 + 0.08 * forest_hash(1 + 80, seed + 13), tone: forest_hash(1 + 100, seed + 13))
    ForestStamp l2(prev: l1, tex: tex_b, x: forest_litter_x(2, seed + 13), y: forest_litter_y(2, seed + 13), angle: forest_hash(2 + 60, seed + 13) * 360, len: 0.15 + 0.08 * forest_hash(2 + 80, seed + 13), tone: forest_hash(2 + 100, seed + 13))
    ForestStamp l3(prev: l2, tex: tex_a, x: forest_litter_x(3, seed + 13), y: forest_litter_y(3, seed + 13), angle: forest_hash(3 + 60, seed + 13) * 360, len: 0.15 + 0.08 * forest_hash(3 + 80, seed + 13), tone: forest_hash(3 + 100, seed + 13))
    ForestStamp l4(prev: l3, tex: tex_a, x: forest_litter_x(4, seed + 13), y: forest_litter_y(4, seed + 13), angle: forest_hash(4 + 60, seed + 13) * 360, len: 0.15 + 0.08 * forest_hash(4 + 80, seed + 13), tone: forest_hash(4 + 100, seed + 13))
    ForestStamp l5(prev: l4, tex: tex_b, x: forest_litter_x(5, seed + 13), y: forest_litter_y(5, seed + 13), angle: forest_hash(5 + 60, seed + 13) * 360, len: 0.15 + 0.08 * forest_hash(5 + 80, seed + 13), tone: forest_hash(5 + 100, seed + 13))
    ForestStamp l6(prev: l5, tex: tex_a, x: forest_litter_x(6, seed + 13), y: forest_litter_y(6, seed + 13), angle: forest_hash(6 + 60, seed + 13) * 360, len: 0.15 + 0.08 * forest_hash(6 + 80, seed + 13), tone: forest_hash(6 + 100, seed + 13))
    ForestStamp l7(prev: l6, tex: tex_a, x: forest_litter_x(7, seed + 13), y: forest_litter_y(7, seed + 13), angle: forest_hash(7 + 60, seed + 13) * 360, len: 0.15 + 0.08 * forest_hash(7 + 80, seed + 13), tone: forest_hash(7 + 100, seed + 13))
    ForestStamp l8(prev: l7, tex: tex_b, x: forest_litter_x(8, seed + 13), y: forest_litter_y(8, seed + 13), angle: forest_hash(8 + 60, seed + 13) * 360, len: 0.15 + 0.08 * forest_hash(8 + 80, seed + 13), tone: forest_hash(8 + 100, seed + 13))
    ForestStamp l9(prev: l8, tex: tex_a, x: forest_litter_x(9, seed + 13), y: forest_litter_y(9, seed + 13), angle: forest_hash(9 + 60, seed + 13) * 360, len: 0.15 + 0.08 * forest_hash(9 + 80, seed + 13), tone: forest_hash(9 + 100, seed + 13))
    ForestStamp l10(prev: l9, tex: tex_a, x: forest_litter_x(10, seed + 13), y: forest_litter_y(10, seed + 13), angle: forest_hash(10 + 60, seed + 13) * 360, len: 0.15 + 0.08 * forest_hash(10 + 80, seed + 13), tone: forest_hash(10 + 100, seed + 13))
    ForestFrame framed(input: l10)
    Graph: {output: framed, width: LEAF_RES, format: GraphLinear}
  }

  // The albedo of the litter: browns from dark and old to fresh and orange by the tone, darker
  // veins, the coverage as alpha
  template ForestLitterAlbedo {
    prop data: entity = 0

    img { nodes.Image: {texture: data, linear: true} }
    cover { nodes.Split: {input: img, channel: ChannelR} }
    vein { nodes.Split: {input: img, channel: ChannelG} }
    tone { nodes.Split: {input: img, channel: ChannelB} }
    shade {
      nodes.Ramp: {
        input: tone,
        keys: [
          {0, {50, 36, 24}}, {0.25, {76, 52, 30}}, {0.5, {104, 72, 38}}, {0.75, {132, 92, 48}},
          {0.9, {150, 110, 58}}, {1, {128, 104, 64}}
        ]
      }
    }

    veined { nodes.Mix: {a: shade, b_value: {0.3, 0.21, 0.13, 1}, factor: vein} }
    r { nodes.Split: {input: veined, channel: ChannelR} }
    g { nodes.Split: {input: veined, channel: ChannelG} }
    b { nodes.Split: {input: veined, channel: ChannelB} }
    color { nodes.Combine: {r: r, g: g, b: b, a: cover} }
    Graph: {output: color, width: LEAF_RES}
  }

  // Grass: a short lush tuft in the sun, and the longer, looser sedge of the shade
  ForestGrassBladeMap grass_blade(width: 0.024)
  ForestTuftMap grass_half(tex: grass_blade, seed: 31, spread: 26, len_min: 0.45, tone_min: 0.45)
  ForestTuftMoreMap grass_data(base_tex: grass_half, tex: grass_blade, seed: 31, spread: 26, len_min: 0.45, tone_min: 0.45)
  ForestTuftMap sedge_half(tex: grass_blade, seed: 32, spread: 38, len_min: 0.6, tone_min: 0.35)
  ForestTuftMoreMap sedge_data(base_tex: sedge_half, tex: grass_blade, seed: 32, spread: 38, len_min: 0.6, tone_min: 0.35)
  ForestLeafAlbedo grass_albedo(data: grass_data)
  ForestLeafNormal grass_normal(data: grass_data)
  ForestLeafAlbedo sedge_albedo(data: sedge_data)
  ForestLeafNormal sedge_normal(data: sedge_data)

  // Wildflowers: a low tuft with seven flowers on stalks over it, in yellow (buttercups), white
  // (wood anemones and daisies) and violet (campanula)
  ForestTuftMap bloom_tuft(tex: grass_blade, seed: 33, spread: 34, len_min: 0.3, tone_min: 0.4)
  ForestStalkMap bloom_stalk(head_w: 0.085, head_h: 0.06, head_y: 0.12, eye: 0.42)
  ForestBloomMap bloom_data(base_tex: bloom_tuft, tex: bloom_stalk, seed: 34, spread: 22, len_min: 0.55)
  ForestBloomAlbedo bloom_yellow_albedo(data: bloom_data, pr: 0.98, pg: 0.82, pb: 0.12, er: 0.85, eg: 0.6, eb: 0.1)
  ForestBloomAlbedo bloom_white_albedo(data: bloom_data, pr: 0.97, pg: 0.96, pb: 0.92, er: 0.95, eg: 0.78, eb: 0.15)
  ForestBloomAlbedo bloom_violet_albedo(data: bloom_data, pr: 0.55, pg: 0.4, pb: 0.9, er: 0.4, eg: 0.3, eb: 0.75)
  ForestLeafNormal bloom_normal(data: bloom_data)

  // Reeds: tall, narrow, nearly upright leaves and a few brown cattail heads
  ForestGrassBladeMap reed_blade(width: 0.02)
  ForestTuftMap reed_tuft(tex: reed_blade, seed: 35, spread: 20, len_min: 0.6, tone_min: 0.45)
  ForestStalkMap reed_stalk(head_w: 0.024, head_h: 0.075, head_y: 0.14, eye: 0.01, stalk: 0.009)
  ForestBloomMap reed_data(base_tex: reed_tuft, tex: reed_stalk, seed: 36, spread: 10, len_min: 0.75)
  ForestBloomAlbedo reed_albedo(data: reed_data, pr: 0.24, pg: 0.15, pb: 0.08, er: 0.24, eg: 0.15, eb: 0.08)
  ForestLeafNormal reed_normal(data: reed_data)

  // Fern: a frond of pinnae, each a row of small toothed pinnules
  ForestBladeMap fern_pinnule(width: 0.42, shape: 0.75, teeth: 0.1, tooth_count: 5, veins: 4, stem: 0.02)
  ForestPinnateMap fern_pinna(tex: fern_pinnule, stem_tex: forest_stem, seed: 37, start: 0.03, end: 0.9, spread: 68, spread_tip: 48, len: 0.34, len_tip: 0.2, tone_min: 0.55, res: SPRAY_RES)
  ForestPinnateMap fern_data(tex: fern_pinna, stem_tex: forest_stem, seed: 38, start: 0.06, end: 0.86, spread: 72, spread_tip: 56, len: 0.6, len_tip: 0.3, tone_min: 0.65, res: LEAF_RES)
  ForestLeafAlbedo fern_albedo(data: fern_data)
  ForestLeafNormal fern_normal(data: fern_data)

  // Leaf litter of beech and oak leaves
  ForestLitterPatchMap litter_patch_half(tex_a: leaf_beech_blade, tex_b: leaf_oak_blade, seed: 39)
  ForestLitterMoreMap litter_patch_data(base_tex: litter_patch_half, tex_a: leaf_beech_blade, tex_b: leaf_oak_blade, seed: 39)
  ForestLitterAlbedo litter_patch_albedo(data: litter_patch_data)
  ForestLeafNormal litter_patch_normal(data: litter_patch_data)

  // Spots of the fly agaric: white flecks on red
  forest_agaric_albedo {
    spots_c { nodes.Cells: {distance: CellsNearest, count: 40, seed: 301} }
    spots_d { nodes.Split: {input: spots_c, channel: ChannelR} }
    spots { nodes.Smoothstep: {input: spots_d, edge0_value: {0.2, 0, 0, 0}, edge1_value: {0.14, 0, 0, 0}} }
    color { nodes.Mix: {a_value: {0.72, 0.08, 0.04, 1}, b_value: {0.95, 0.93, 0.86, 1}, factor: spots} }
    Graph: {output: color, width: 256}
  }


  // The plants. The season recolors and thins a kind through its prefab, the sedge inherits the
  // grass: fresh in spring, deep in summer, straw, rust and brown in autumn and winter. Like the
  // leaves (leaves.flecs) they are NoBake, so a season change doesn't touch every instance
  prefab ForestGrass : ForestClumpMesh {
    Rgb: {forest_seasonal(season, 118, 104, 150, 156), forest_seasonal(season, 158, 134, 138, 146), forest_seasonal(season, 58, 54, 70, 118)}
    PbrMaterial: {roughness: 0.8}
    WindSway: {bend: SWAY_GRASS_BEND, height: SWAY_GRASS_HEIGHT, base: 0, flutter: 0.03, flutter_frequency: 4, flutter_reach: 0.25}
    AlphaCutoff: {forest_seasonal(season, LEAF_FULL, LEAF_FULL, 0.5, 0.8)}
    DiffuseTransmission: {factor: 0.6, color: {forest_leaf_glow_r(season), forest_leaf_glow_g(season), forest_leaf_glow_b(season)}}
    PbrTextures: {albedo: grass_albedo, normal: grass_normal}
    NoShadow
    NoBake
  }

  prefab ForestSedge : ForestGrass {
    PbrTextures: {albedo: sedge_albedo, normal: sedge_normal}
    NoBake
  }


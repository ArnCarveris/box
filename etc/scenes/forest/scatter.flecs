using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.light
using box.texture
using state
using assets

// The placement of the undergrowth of undergrowth.flecs on the forest floor between the trees
// and the brook: grass clumps and sedge, ferns, wildflowers, reeds at the brook, shrubs, moss
// cushions, mushrooms, fallen logs, stumps, rocks, twigs and leaf litter. Each kind is scattered
// on a seeded, jittered grid of its own and kept by the light of its spot (forest_light): grass
// and flowers in the sun of the clearing and along the brook, ferns, moss, litter and mushrooms
// in the shade. Nothing grows on the path, in the brook bed or under the landmarks, and the
// plants thin out toward the backdrop.
state {
  // The undergrowth is dense within UNDER_FULL of the origin and thins out to UNDER_EDGE
  export const UNDER_FULL: f32 = 28
  export const UNDER_EDGE: f32 = 50

  // The scatter grids: cell sizes, and cells across the 2 * UNDER_EDGE square around the origin.
  // The cells of the grass, flowers, ferns and litter hold four spots each, jittered in their
  // quarters, which share the light and density of the cell
  export const GRASS_CELL: f32 = 1.2
  export const GRASS_GRID: i32 = 84
  export const FERN_CELL: f32 = 3.4
  export const FERN_GRID: i32 = 30
  export const FLOWER_CELL: f32 = 2.5
  export const FLOWER_GRID: i32 = 40
  export const LITTER_CELL: f32 = 2.2
  export const LITTER_GRID: i32 = 46
  export const SMALL_CELL: f32 = 2.5
  export const SMALL_GRID: i32 = 40

  // Logs, stumps and shrubs: at most one in each FEATURE_CELL, near the middle of it
  export const FEATURE_CELL: f32 = 6
  export const FEATURE_GRID: i32 = 16
  export const FEATURE_NONE: i32 = 0
  export const FEATURE_LOG: i32 = 1
  export const FEATURE_STUMP: i32 = 2
  export const FEATURE_SHRUB: i32 = 3

  // Reeds stand on the banks of the brook from REED_D0 to REED_D1 off its centerline, above the
  // water line, every REED_STEP meters along it on either side
  export const REED_D0: f32 = 1.45
  export const REED_D1: f32 = 2.3
  export const REED_STEP: f32 = 0.3
  export const REED_COUNT: i32 = 300

  // Light on the floor at (x, z), 0..1: full in the clearing, fading over the first meters of the
  // forest, the gap of the canopy over the brook, and sunny patches in the forest
  fn forest_light(x: f64, z: f64) -> f64 {
    const open = forest_smooth(7, -1, forest_clearing_distance(x, z))
    const brook = forest_smooth(7, 3, forest_brook_distance(x, z)) * 0.65
    const fleck = forest_smooth(0.55, 0.9, forest_hash2(floor(x / 5), floor(z / 5), 41)) * 0.5
    clamp(max(max(open, brook), fleck), 0, 1)
  }

  // Share of the undergrowth kept at (x, z): all of it within UNDER_FULL, none past UNDER_EDGE
  fn forest_under_density(x: f64, z: f64) -> f64 {
    const r = max(abs(x), abs(z)) * 0.6 + sqrt(x * x + z * z) * 0.4
    forest_smooth(UNDER_EDGE, UNDER_FULL, r)
  }

  // Within r of the spot of the mature tree or the young tree of grid cell (gx, gz)
  fn forest_tree_cell_near(gx: f64, gz: f64, x: f64, z: f64, r: f64) -> bool {
    const i = gx * TREE_GRID + gz
    const mx = (gx + 0.15 + 0.7 * forest_hash(i, 101)) * TREE_CELL - BACKDROP_START
    const mz = (gz + 0.15 + 0.7 * forest_hash(i, 102)) * TREE_CELL - BACKDROP_START
    const yx = (gx + 0.5 + 0.8 * (forest_hash(i, 121) - 0.5)) * YOUNG_CELL - BACKDROP_START
    const yz = (gz + 0.5 + 0.8 * (forest_hash(i, 122) - 0.5)) * YOUNG_CELL - BACKDROP_START
    forest_near(x, z, mx, mz, r) || forest_near(x, z, yx, yz, r * 0.7)
  }

  // Within r of a tree of stands.flecs (or of a gap where one was left out): the trees of the
  // four grid cells around (x, z)
  fn forest_trees_near(x: f64, z: f64, r: f64) -> bool {
    const gx = floor((x + BACKDROP_START) / TREE_CELL - 0.5)
    const gz = floor((z + BACKDROP_START) / TREE_CELL - 0.5)
    forest_tree_cell_near(gx, gz, x, z, r) ? true : (forest_tree_cell_near(gx + 1, gz, x, z, r) ? true : (
      forest_tree_cell_near(gx, gz + 1, x, z, r) ? true : forest_tree_cell_near(gx + 1, gz + 1, x, z, r)))
  }

  // A plant of radius r at (x, z) stays off the path, out of the brook bed and clear of the
  // landmarks
  fn forest_floor_free(x: f64, z: f64, r: f64) -> bool {
    forest_free(x, z, r) ? !forest_landmark_near(x, z, r) : false
  }

  // The feature of grid cell (gx, gz): its spot, its kind and its yaw; a log lies along its yaw
  // from its spot (local +Z turned by the yaw), forest_log_len long
  fn forest_feature_i(gx: f64, gz: f64) -> f64 {
    gx * FEATURE_GRID + gz
  }

  fn forest_feature_x(gx: f64, gz: f64) -> f64 {
    (gx + 0.3 + 0.4 * forest_hash(forest_feature_i(gx, gz), 401)) * FEATURE_CELL - FEATURE_GRID * FEATURE_CELL / 2
  }

  fn forest_feature_z(gx: f64, gz: f64) -> f64 {
    (gz + 0.3 + 0.4 * forest_hash(forest_feature_i(gx, gz), 402)) * FEATURE_CELL - FEATURE_GRID * FEATURE_CELL / 2
  }

  fn forest_feature_yaw(gx: f64, gz: f64) -> f64 {
    forest_hash(forest_feature_i(gx, gz), 404) * 6.2832
  }

  fn forest_log_len(gx: f64, gz: f64) -> f64 {
    3 + 1.6 * forest_hash(forest_feature_i(gx, gz), 405)
  }

  fn forest_log_radius(gx: f64, gz: f64) -> f64 {
    0.18 + 0.14 * forest_hash(forest_feature_i(gx, gz), 406)
  }

  fn forest_stump_radius(gx: f64, gz: f64) -> f64 {
    0.25 + 0.2 * forest_hash(forest_feature_i(gx, gz), 406)
  }

  // Logs lie in the forest and the edge of the clearing, stumps in the forest; the cell's spot
  // decides, its own seeded value picks. FEATURE_NONE leaves the cell to a shrub or nothing
  fn forest_feature_solid_at(x: f64, z: f64, h: f64) -> i32 {
    const edge = forest_clearing_distance(x, z)
    const inside = forest_under_density(x, z) > 0.2 && forest_zone(x, z) != ZONE_BACKDROP
    !inside ? FEATURE_NONE : (h < 0.14 && edge > -5 ? FEATURE_LOG : (h < 0.26 && edge > 1 ? FEATURE_STUMP : FEATURE_NONE))
  }

  fn forest_feature_solid(gx: f64, gz: f64) -> i32 {
    const h = forest_hash(forest_feature_i(gx, gz), 403)
    h >= 0.26 ? FEATURE_NONE : forest_feature_solid_at(forest_feature_x(gx, gz), forest_feature_z(gx, gz), h)
  }

  // The feature of a cell: its log or stump, else a shrub, mostly in the shade
  fn forest_feature_kind(gx: f64, gz: f64) -> i32 {
    const x = forest_feature_x(gx, gz)
    const z = forest_feature_z(gx, gz)
    const h = forest_hash(forest_feature_i(gx, gz), 403)
    const solid = forest_feature_solid(gx, gz)
    const shrub = h < 0.26 + 0.4 * (1 - 0.6 * forest_light(x, z)) && forest_clearing_distance(x, z) > -1.5
    solid != FEATURE_NONE ? solid : (forest_under_density(x, z) > 0.2 && shrub ? FEATURE_SHRUB : FEATURE_NONE)
  }

  // Distance from (x, z) to the axis of the log of cell (gx, gz)
  fn forest_log_distance(gx: f64, gz: f64, x: f64, z: f64) -> f64 {
    const yaw = forest_feature_yaw(gx, gz)
    const dx = sin(yaw)
    const dz = cos(yaw)
    const ax = forest_feature_x(gx, gz)
    const az = forest_feature_z(gx, gz)
    const t = clamp((x - ax) * dx + (z - az) * dz, 0, forest_log_len(gx, gz))
    const px = ax + dx * t
    const pz = az + dz * t
    sqrt((x - px) * (x - px) + (z - pz) * (z - pz))
  }

  // Within pad of the log or the stump of cell (gx, gz)
  fn forest_feature_cell_near(gx: f64, gz: f64, x: f64, z: f64, pad: f64) -> bool {
    const k = forest_feature_solid(gx, gz)
    k == FEATURE_LOG ? forest_log_distance(gx, gz, x, z) < forest_log_radius(gx, gz) + pad : (
      k == FEATURE_STUMP ? forest_near(x, z, forest_feature_x(gx, gz), forest_feature_z(gx, gz), forest_stump_radius(gx, gz) * 1.5 + pad) : false)
  }

  // Within pad of a log or a stump: the features of the four grid cells around (x, z), as far
  // as a log reaches
  fn forest_feature_near(x: f64, z: f64, pad: f64) -> bool {
    const gx = floor((x + FEATURE_GRID * FEATURE_CELL / 2) / FEATURE_CELL - 0.5)
    const gz = floor((z + FEATURE_GRID * FEATURE_CELL / 2) / FEATURE_CELL - 0.5)
    forest_feature_cell_near(gx, gz, x, z, pad) ? true : (forest_feature_cell_near(gx + 1, gz, x, z, pad) ? true : (
      forest_feature_cell_near(gx, gz + 1, x, z, pad) ? true : forest_feature_cell_near(gx + 1, gz + 1, x, z, pad)))
  }

  // The kind of a small thing by its seeded value h and the light of its spot: moss and
  // mushrooms in the shade, else rocks and twigs, or nothing (-1)
  fn forest_small_kind(h: f64, light: f64) -> i32 {
    const shade = 1 - light
    h < 0.32 * shade ? PLANT_MOSS : (
      h < 0.52 * shade ? PLANT_MUSHROOM : (
      h < 0.62 ? PLANT_ROCK : (h < 0.85 ? PLANT_TWIG : 0 - 1)))
  }
}

forest {
  // Nothing picks, collides with or queries the undergrowth, so it stays out of the spatial
  // index
  undergrowth {
    box.spatial.Ignore

    // Logs, stumps and shrubs, at most one in each FEATURE_CELL. A log lies along its yaw from
    // the spot, clear of the trees, the path and the brook bed along all of its length
    for gx in 0..FEATURE_GRID {
      for gz in 0..FEATURE_GRID {
        const i = forest_feature_i(gx, gz)
        const k: i32 = forest_feature_kind(gx, gz)
        const x = forest_feature_x(gx, gz)
        const z = forest_feature_z(gx, gz)
        const yaw = forest_feature_yaw(gx, gz)
        const seed = forest_hash(i, 407)

        if k == FEATURE_LOG {
          const len = forest_log_len(gx, gz)
          const lr = forest_log_radius(gx, gz)
          const mx = x + sin(yaw) * len / 2
          const mz = z + cos(yaw) * len / 2
          const ex = x + sin(yaw) * len
          const ez = z + cos(yaw) * len
          const free = forest_floor_free(x, z, lr + 0.3) && forest_floor_free(mx, mz, lr + 0.3) && forest_floor_free(ex, ez, lr + 0.3) &&
            forest_floor_free((x + mx) / 2, (z + mz) / 2, lr + 0.3) && forest_floor_free((mx + ex) / 2, (mz + ez) / 2, lr + 0.3)
          const clear = !forest_trees_near(x, z, lr + 0.9) && !forest_trees_near(mx, mz, lr + 0.9) && !forest_trees_near(ex, ez, lr + 0.9)
          if free && clear {
            const sp: i32 = forest_hash(i, 408) < 0.5 ? SPECIES_SNAG : (forest_hash(i, 409) < 0.5 ? SPECIES_BEECH : SPECIES_OAK)
            ForestLog "log_{i}"(seed: seed, length: len, radius: lr, species: sp) {
              Position: {x, 0, z}
              Rotation: {0, yaw, 0}
            }
          }
        } else if k == FEATURE_STUMP {
          const sr = forest_stump_radius(gx, gz)
          if forest_floor_free(x, z, sr + 0.3) && !forest_trees_near(x, z, sr + 0.9) {
            const sp: i32 = forest_hash(i, 408) < 0.4 ? SPECIES_OAK : (forest_hash(i, 409) < 0.5 ? SPECIES_BEECH : SPECIES_SPRUCE)
            ForestStump "stump_{i}"(seed: seed, radius: sr, height: 0.3 + 0.5 * forest_hash(i, 410), species: sp) {
              Position: {x, 0, z}
              Rotation: {0, yaw, 0}
            }
          }
        } else if k == FEATURE_SHRUB {
          const size = 1.1 + 0.9 * forest_hash(i, 411)
          if forest_floor_free(x, z, size * 0.5) && !forest_trees_near(x, z, size * 0.5 + 0.4) {
            ForestShrub "shrub_{i}"(seed: seed, size: size, elder: forest_hash(i, 412) < 0.4) {
              Position: {x, 0, z}
              Rotation: {0, yaw, 0}
            }
          }
        }
      }
    }

    // Grass: dense in the sun, sparser sedge in the shade
    for gx in 0..GRASS_GRID {
      for gz in 0..GRASS_GRID {
        const i = gx * GRASS_GRID + gz
        const dens = forest_under_density((gx + 0.5) * GRASS_CELL - UNDER_EDGE, (gz + 0.5) * GRASS_CELL - UNDER_EDGE)
        if dens > 0 {
          const light = forest_light((gx + 0.5) * GRASS_CELL - UNDER_EDGE, (gz + 0.5) * GRASS_CELL - UNDER_EDGE)
          const keep = dens * (0.12 + 0.88 * light)
          for k in 0..4 {
            const j = i * 4 + k
            const x = (gx + 0.5 * (k % 2) + 0.05 + 0.4 * forest_hash(j, 301)) * GRASS_CELL - UNDER_EDGE
            const z = (gz + 0.5 * floor(k / 2) + 0.05 + 0.4 * forest_hash(j, 302)) * GRASS_CELL - UNDER_EDGE
            if forest_hash(j, 303) < keep {
              if forest_floor_free(x, z, 0.2) {
                if !forest_feature_near(x, z, 0.25) {
                  const s = 0.6 + 0.5 * forest_hash(j, 304)
                  const h = 0.26 + 0.3 * forest_hash(j, 305)
                  const yaw = forest_hash(j, 306) * 6.2832
                  const seed = forest_hash(j, 307)
                  if light > 0.5 || forest_hash(j, 308) < light {
                    "grass_{j}" : ForestGrass {
                      Position: {x, 0, z}
                      Rotation: {0, yaw, 0}
                      Scale: {s, h, s}
                      ForestPlant: {kind: PLANT_GRASS, seed: seed}
                    }
                  } else {
                    "sedge_{j}" : ForestSedge {
                      Position: {x, 0, z}
                      Rotation: {0, yaw, 0}
                      Scale: {s * 1.2, h * 1.1, s * 1.2}
                      ForestPlant: {kind: PLANT_SEDGE, seed: seed}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }

    // Wildflowers in the sun, each color in patches of its own
    for gx in 0..FLOWER_GRID {
      for gz in 0..FLOWER_GRID {
        const i = gx * FLOWER_GRID + gz
        const dens = forest_under_density((gx + 0.5) * FLOWER_CELL - UNDER_EDGE, (gz + 0.5) * FLOWER_CELL - UNDER_EDGE)
        if dens > 0 {
          const light = forest_light((gx + 0.5) * FLOWER_CELL - UNDER_EDGE, (gz + 0.5) * FLOWER_CELL - UNDER_EDGE)
          const keep = dens * light * light * 0.8
          for k in 0..4 {
            const j = i * 4 + k
            const x = (gx + 0.5 * (k % 2) + 0.05 + 0.4 * forest_hash(j, 311)) * FLOWER_CELL - UNDER_EDGE
            const z = (gz + 0.5 * floor(k / 2) + 0.05 + 0.4 * forest_hash(j, 312)) * FLOWER_CELL - UNDER_EDGE
            if forest_hash(j, 313) < keep {
              if forest_floor_free(x, z, 0.15) {
                if !forest_feature_near(x, z, 0.2) {
                  const s = 0.32 + 0.22 * forest_hash(j, 314)
                  const yaw = forest_hash(j, 316) * 6.2832
                  const seed = forest_hash(j, 317)
                  const patch = forest_hash2(floor(x / 4), floor(z / 4), 51)
                  if patch < 0.45 {
                    "flower_{j}" : ForestFlower {
                      Position: {x, 0, z}
                      Rotation: {0, yaw, 0}
                      Scale: {s, s * 1.1, s}
                      ForestPlant: {kind: PLANT_FLOWER, seed: seed}
                    }
                  } else if patch < 0.8 {
                    "flower_{j}" : ForestFlowerWhite {
                      Position: {x, 0, z}
                      Rotation: {0, yaw, 0}
                      Scale: {s, s, s}
                      ForestPlant: {kind: PLANT_FLOWER, seed: seed}
                    }
                  } else {
                    "flower_{j}" : ForestFlowerViolet {
                      Position: {x, 0, z}
                      Rotation: {0, yaw, 0}
                      Scale: {s, s * 1.3, s}
                      ForestPlant: {kind: PLANT_FLOWER, seed: seed}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }

    // Ferns in the shade, a few at the edge of the sun
    for gx in 0..FERN_GRID {
      for gz in 0..FERN_GRID {
        const i = gx * FERN_GRID + gz
        const dens = forest_under_density((gx + 0.5) * FERN_CELL - UNDER_EDGE, (gz + 0.5) * FERN_CELL - UNDER_EDGE)
        if dens > 0 {
          const light = forest_light((gx + 0.5) * FERN_CELL - UNDER_EDGE, (gz + 0.5) * FERN_CELL - UNDER_EDGE)
          const keep = dens * (0.06 + 0.84 * (1 - light))
          for k in 0..4 {
            const j = i * 4 + k
            const x = (gx + 0.5 * (k % 2) + 0.05 + 0.4 * forest_hash(j, 321)) * FERN_CELL - UNDER_EDGE
            const z = (gz + 0.5 * floor(k / 2) + 0.05 + 0.4 * forest_hash(j, 322)) * FERN_CELL - UNDER_EDGE
            if forest_hash(j, 323) < keep {
              if forest_floor_free(x, z, 0.4) {
                if !forest_feature_near(x, z, 0.4) {
                  if !forest_trees_near(x, z, 0.5) {
                    const s = 0.55 + 0.55 * forest_hash(j, 324) * (1.2 - light)
                    "fern_{j}" : ForestFern {
                      Position: {x, 0, z}
                      Rotation: {0, forest_hash(j, 326) * 6.2832, 0}
                      Scale: {s, s * (0.8 + 0.3 * forest_hash(j, 325)), s}
                      ForestPlant: {kind: PLANT_FERN, seed: forest_hash(j, 327)}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }

    // Leaf litter, thicker in the shade. The patches lie a few mm apart in height so they never
    // fight where they overlap
    for gx in 0..LITTER_GRID {
      for gz in 0..LITTER_GRID {
        const i = gx * LITTER_GRID + gz
        const dens = forest_under_density((gx + 0.5) * LITTER_CELL - UNDER_EDGE, (gz + 0.5) * LITTER_CELL - UNDER_EDGE)
        if dens > 0 {
          const light = forest_light((gx + 0.5) * LITTER_CELL - UNDER_EDGE, (gz + 0.5) * LITTER_CELL - UNDER_EDGE)
          const keep = dens * (0.03 + 0.7 * (1 - light) * (1 - light))
          for k in 0..4 {
            const j = i * 4 + k
            const x = (gx + 0.5 * (k % 2) + 0.05 + 0.4 * forest_hash(j, 331)) * LITTER_CELL - UNDER_EDGE
            const z = (gz + 0.5 * floor(k / 2) + 0.05 + 0.4 * forest_hash(j, 332)) * LITTER_CELL - UNDER_EDGE
            if forest_hash(j, 333) < keep {
              if forest_floor_free(x, z, 0.4) {
                if !forest_feature_near(x, z, 0.4) {
                  const s = 0.7 + 0.5 * forest_hash(j, 334)
                  "litter_{j}" : ForestLitter {
                    Position: {x, 0.006 + (j % 5) * 0.003, z}
                    Rotation: {0, forest_hash(j, 336) * 6.2832, 0}
                    Scale: {s, 1, s}
                    ForestPlant: {kind: PLANT_LITTER, seed: forest_hash(j, 337)}
                  }
                }
              }
            }
          }
        }
      }
    }

    // Small things on a coarser grid: moss cushions and mushrooms in the shade, rocks, twigs
    for gx in 0..SMALL_GRID {
      for gz in 0..SMALL_GRID {
        const i = gx * SMALL_GRID + gz
        const x = (gx + 0.1 + 0.8 * forest_hash(i, 341)) * SMALL_CELL - UNDER_EDGE
        const z = (gz + 0.1 + 0.8 * forest_hash(i, 342)) * SMALL_CELL - UNDER_EDGE
        const dens = forest_under_density(x, z)
        const kind: i32 = forest_small_kind(forest_hash(i, 343), forest_light(x, z))
        const ok = forest_hash(i, 344) < dens && forest_floor_free(x, z, 0.6) && !forest_feature_near(x, z, 0.5)

        if ok && kind == PLANT_MOSS {
          const ms = 0.3 + 0.45 * forest_hash(i, 345)
          "moss_{i}" : ForestMoss {
            Position: {x, 0 - ms * 0.12, z}
            Rotation: {0, forest_hash(i, 346) * 6.28, 0}
            Scale: {ms, ms * 0.42, ms * (0.6 + 0.4 * forest_hash(i, 347))}
            ForestPlant: {kind: PLANT_MOSS, seed: forest_hash(i, 348)}
          }
        } else if ok && kind == PLANT_MUSHROOM {
          const agaric = forest_hash(i, 349) < 0.3
          const n: i32 = 2 + floor(forest_hash(i, 350) * 4)
          "mushrooms_{i}" {
            Position: {x, 0, z}
            ForestPlant: {kind: PLANT_MUSHROOM, seed: forest_hash(i, 351)}
            for j in 0..n {
              const a = j * 2.4 + forest_hash(i, 352) * 6.28
              const d = 0.06 + 0.16 * forest_hash(j, i + 0.5)
              ForestMushroom "m{j}"(size: (agaric ? 0.12 : 0.07) * (0.6 + 0.8 * forest_hash(j + 9, i + 0.5)), agaric: agaric, tilt: (forest_hash(j + 4, i + 0.5) - 0.5) * 0.4) {
                Position: {sin(a) * d, 0, cos(a) * d}
                Rotation: {0, a, 0}
              }
            }
          }
        } else if ok && kind == PLANT_ROCK {
          const rs = 0.18 + 0.4 * forest_hash(i, 353) * forest_hash(i, 354)
          "rock_{i}" : ForestRock {
            Position: {x, rs * 0.2, z}
            Rotation: {(forest_hash(i, 355) - 0.5) * 0.4, forest_hash(i, 356) * 6.28, 0}
            Scale: {rs * (1 + 0.4 * forest_hash(i, 357)), rs * (0.6 + 0.25 * forest_hash(i, 358)), rs}
            ForestPlant: {kind: PLANT_ROCK, seed: forest_hash(i, 359)}
          }

          if forest_hash(i, 360) < 0.5 {
            const ca = forest_hash(i, 361) * 6.28
            "rock_b{i}" : ForestRock {
              Position: {x + sin(ca) * rs * 1.4, rs * 0.04, z + cos(ca) * rs * 1.4}
              Rotation: {0, ca, 0.2}
              Scale: {rs * 0.45, rs * 0.25, rs * 0.38}
              ForestPlant: {kind: PLANT_ROCK, seed: forest_hash(i, 362)}
            }
          }
        } else if ok && kind == PLANT_TWIG {
          ForestFallenTwig "twig_{i}"(seed: forest_hash(i, 363), length: 0.4 + 0.9 * forest_hash(i, 364)) {
            Position: {x, 0, z}
            Rotation: {0, forest_hash(i, 365) * 6.28, 0}
          }
        }
      }
    }

    // Plants on the mounds of the floor, which the plants of the grids sink into: on the surface
    // of each mound, ferns, sedge and moss in the shade, grass in the sun
    for m in 0..MOUND_COUNT {
      const mx = forest_mound_x(m)
      const mz = forest_mound_z(m)
      if forest_mound_placed(m) && forest_under_density(mx, mz) > 0 {
        const light = forest_light(mx, mz)
        const rx = forest_mound_rx(m)
        const rz = forest_mound_rz(m)
        const ry = forest_mound_ry(m)
        const yaw = forest_mound_yaw(m)
        for k in 0..8 {
          const j = m * 8 + k
          const f = 0.8 * sqrt(forest_hash(j, 381))
          const a = forest_hash(j, 382) * 6.2832
          const u = f * rx * cos(a)
          const v = f * rz * sin(a)
          const x = mx + u * cos(yaw) + v * sin(yaw)
          const z = mz - u * sin(yaw) + v * cos(yaw)
          const y = ry * (sqrt(1 - f * f) - 0.55) - 0.03
          const h = forest_hash(j, 384)
          const seed = forest_hash(j, 385)
          if forest_hash(j, 383) < forest_under_density(x, z) {
            if !forest_feature_near(x, z, 0.4) {
              if !forest_trees_near(x, z, 0.5) {
                if light > 0.5 {
                  const s = 0.6 + 0.5 * forest_hash(j, 386)
                  "mound_grass_{j}" : ForestGrass {
                    Position: {x, y, z}
                    Rotation: {0, a, 0}
                    Scale: {s, 0.26 + 0.3 * forest_hash(j, 387), s}
                    ForestPlant: {kind: PLANT_GRASS, seed: seed}
                  }
                } else if h < 0.5 {
                  const s = 0.6 + 0.5 * forest_hash(j, 386)
                  "mound_fern_{j}" : ForestFern {
                    Position: {x, y, z}
                    Rotation: {0, a, 0}
                    Scale: {s, s * (0.8 + 0.3 * forest_hash(j, 387)), s}
                    ForestPlant: {kind: PLANT_FERN, seed: seed}
                  }
                } else if h < 0.8 {
                  const s = 0.7 + 0.5 * forest_hash(j, 386)
                  "mound_sedge_{j}" : ForestSedge {
                    Position: {x, y, z}
                    Rotation: {0, a, 0}
                    Scale: {s, 0.3 + 0.3 * forest_hash(j, 387), s}
                    ForestPlant: {kind: PLANT_SEDGE, seed: seed}
                  }
                } else {
                  const ms = 0.35 + 0.4 * forest_hash(j, 386)
                  "mound_moss_{j}" : ForestMoss {
                    Position: {x, y - ms * 0.1, z}
                    Rotation: {0, a, 0}
                    Scale: {ms, ms * 0.4, ms * 0.8}
                    ForestPlant: {kind: PLANT_MOSS, seed: seed}
                  }
                }
              }
            }
          }
        }
      }
    }

    // Reeds on the banks of the brook, above the water line, clear of the footbridge and the
    // ledge of the cascade, standing in the slope of the bank
    for i in 0..REED_COUNT {
      const t = (i - REED_COUNT / 2) * REED_STEP + (forest_hash(i, 371) - 0.5) * REED_STEP
      const side = forest_hash(i, 372) < 0.5 ? 1 : -1
      const d = REED_D0 + (REED_D1 - REED_D0) * forest_hash(i, 373)
      const x = forest_brook_off_x(t, side * d)
      const z = forest_brook_off_z(t, side * d)
      const clear = abs(t - CROSSING_X) > BRIDGE_HALF_WIDTH + 1.6 && abs(t - CASCADE_X) > 1 && forest_path_distance(x, z) > PATH_HALF_WIDTH + 0.6
      const keep = forest_hash(i, 374) < 0.75 * forest_under_density(x, z)
      if clear && keep && !forest_landmark_near(x, z, 0.2) {
        const s = 0.35 + 0.3 * forest_hash(i, 375)
        "reed_{i}" : ForestReed {
          Position: {x, forest_brook_bed_y_at(t, d) - 0.03, z}
          Rotation: {0, forest_hash(i, 376) * 6.2832, 0}
          Scale: {s, 0.7 + 0.7 * forest_hash(i, 377), s}
          ForestPlant: {kind: PLANT_REED, seed: forest_hash(i, 378)}
        }
      }
    }
  }
}

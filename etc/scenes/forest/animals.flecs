      forest_rot_y(forest_stub_x(5, 7.5, 1, 0.85), forest_stub_top(5, 7.5, 1, 0.85), forest_stub_z(5, 7.5, 1, 0.85), SNAG_A_TILT, SNAG_A_YAW),
      SNAG_A_Z + forest_rot_z(forest_stub_x(5, 7.5, 1, 0.85), forest_stub_top(5, 7.5, 1, 0.85), forest_stub_z(5, 7.5, 1, 0.85), SNAG_A_TILT, SNAG_A_YAW),
      1
    },
    {
      SNAG_B_X + forest_rot_x(forest_stub_x(9, 2.6, 0, 0.6), forest_stub_top(9, 2.6, 0, 0.6), forest_stub_z(9, 2.6, 0, 0.6), 0, SNAG_B_YAW),
      forest_rot_y(forest_stub_x(9, 2.6, 0, 0.6), forest_stub_top(9, 2.6, 0, 0.6), forest_stub_z(9, 2.6, 0, 0.6), 0, SNAG_B_YAW),
      SNAG_B_Z + forest_rot_z(forest_stub_x(9, 2.6, 0, 0.6), forest_stub_top(9, 2.6, 0, 0.6), forest_stub_z(9, 2.6, 0, 0.6), 0, SNAG_B_YAW),

      forest_rot_y(forest_stub_x(5, 7.5, 1, 0.5), forest_stub_top(5, 7.5, 1, 0.5), forest_stub_z(5, 7.5, 1, 0.5), SNAG_A_TILT, SNAG_A_YAW),
      SNAG_A_Z + forest_rot_z(forest_stub_x(5, 7.5, 1, 0.5), forest_stub_top(5, 7.5, 1, 0.5), forest_stub_z(5, 7.5, 1, 0.5), SNAG_A_TILT, SNAG_A_YAW),
      2
    },
    {
      SNAG_A_X + forest_rot_x(forest_stub_x(5, 7.5, 2, 0.5), forest_stub_top(5, 7.5, 2, 0.5), forest_stub_z(5, 7.5, 2, 0.5), SNAG_A_TILT, SNAG_A_YAW),
      forest_rot_y(forest_stub_x(5, 7.5, 2, 0.5), forest_stub_top(5, 7.5, 2, 0.5), forest_stub_z(5, 7.5, 2, 0.5), SNAG_A_TILT, SNAG_A_YAW),
      SNAG_A_Z + forest_rot_z(forest_stub_x(5, 7.5, 2, 0.5), forest_stub_top(5, 7.5, 2, 0.5), forest_stub_z(5, 7.5, 2, 0.5), SNAG_A_TILT, SNAG_A_YAW),

using flecs.script
using flecs.script.math
using box.app
using box.transform
using box.geometry
using box.material
using box.animation
using box.camera
using box.controllers
using state
using assets

// The animals of the forest, each by its season and time of day (the sliders of state.flecs):
// songbirds that flit between the dead branches of the snags, the rails of the footbridge and the
// ground, buzzards and crows over the canopy (fewer in winter, none at night), a tawny owl at
// night, a red squirrel that forages on the floor and runs up the trunks of the snags, a roe deer
// that grazes on the far bank of the brook at dawn and dusk and leaves in strong wind or heavy
// rain, and brown trout that hold in the current of the pool and the calm reach.
//
// The animals that move about are template instances whose async block steers them with a
// seeded Rng and the fixed delta time of the app, so a capture with --delta-time is the same every
// run. They plan where to go with the layout functions of layout.flecs, stands.flecs and
// scatter.flecs: away from the trees, the landmarks, the logs, stumps and rocks and the mounds,
// out of the brook bed (the trout out of the stones of the bed), and the perches and trunks they
// use are found with the same functions that grow the snags (trees.flecs) and the footbridge
// (brook.flecs). The birds over the canopy fly on Animators, so no script runs for them.
state {
  // Seeds of the animals
  export const SEED_SONGBIRD: i32 = 7101
  export const SEED_OWL: i32 = 7211
  export const SEED_SQUIRREL: i32 = 7307
  export const SEED_DEER: i32 = 7401
  export const SEED_TROUT: i32 = 7503

  // Songbirds about in the day, fewer in winter; none in the dark. The owl comes out once
  // daylight drops below OWL_DARK
  export const SONGBIRDS_MAX: i32 = 5
  export const BIRD_DAY: f32 = 0.35
  export const OWL_DARK: f32 = 0.2

  // Kinds of the perching birds
  export const BIRD_ROBIN: i32 = 0
  export const BIRD_CHAFFINCH: i32 = 1
  export const BIRD_TIT: i32 = 2
  export const BIRD_OWL: i32 = 3

  // Kinds of the birds over the canopy
  export const SOARER_BUZZARD: i32 = 0
  export const SOARER_CROW: i32 = 1

  // The roe deer grazes from DEER_DAWN_BEFORE hours before sunrise to DEER_DAWN_AFTER after it,
  // and from DEER_DUSK_BEFORE before sunset to DEER_DUSK_AFTER after it. It leaves when the
  // wind blows harder than DEER_WIND m/s or more rain than DEER_RAIN falls
  // (forest_rainfall, 0..1)
  export const DEER_DAWN_BEFORE: f32 = 1
  export const DEER_DAWN_AFTER: f32 = 2.5
  export const DEER_DUSK_BEFORE: f32 = 3
  export const DEER_DUSK_AFTER: f32 = 1.5
  export const DEER_WIND: f32 = 11
  export const DEER_RAIN: f32 = 0.55

  // Where the deer grazes: on the far (south) bank of the brook, at the edge of the clearing,
  // within DEER_GRAZE_R of the spot; it comes and goes along a lane through the forest from the
  // spot DEER_LANE meters long, clear of the trees
  export const DEER_GRAZE_X: f32 = -5
  export const DEER_GRAZE_Z: f32 = -14.2
  export const DEER_GRAZE_R: f32 = 2.6
  export const DEER_LANE: f32 = 22

  // The trout: TROUT_COUNT fish, in the pool above the cascade and the calm reach below it
  export const TROUT_COUNT: i32 = 4

  // Behaviours of the deer
  export const DEER_AWAY: i32 = 0
  export const DEER_ENTER: i32 = 1
  export const DEER_GRAZE: i32 = 2
  export const DEER_ALERT: i32 = 3
  export const DEER_LEAVE: i32 = 4

  // The pose of an animal that its template draws, written once a frame by its async block: its
  // position and yaw (turning local +Z toward world +X), pitch and roll, and the joints of the
  // kind: a gait phase, a speed, the wings open and their beat, the head turned and bowed, the
  // tail, a crouch (sitting up for the squirrel)
  struct ForestAnimalPose(
    x: f32,
    y: f32,
    z: f32,
    yaw: f32,
    pitch: f32,
    roll: f32,
    gait: f32,
    speed: f32,
    open: f32,
    beat: f32,
    head: f32,
    bow: f32,
    tail: f32,
    crouch: f32,
    ear: f32
  )

  // A perch of the birds: where the feet go, and the biggest bird it holds (1 songbirds, 2 also
  // the owl)
  struct ForestPerch(x: f32, y: f32, z: f32, size: f32)

  // The two landmark snags of stands.flecs, as ForestSnag grows them (trees.flecs)
  export const SNAG_A_SEED: i32 = 5
  export const SNAG_A_HEIGHT: f32 = 7.5
  export const SNAG_A_TILT: f32 = 0.03
  export const SNAG_A_YAW: f32 = 0.8
  export const SNAG_B_SEED: i32 = 9
  export const SNAG_B_HEIGHT: f32 = 2.6
  export const SNAG_B_YAW: f32 = 2.2

  // Radius of the trunk of a snag at its foot, and the scale of its trunk path across
  fn forest_snag_r0(seed: f64) -> f64 {
    0.26 + 0.18 * forest_hash(1, seed)
  }

  fn forest_snag_kr(seed: f64) -> f64 {
    forest_snag_r0(seed) / TRUNK_RADIUS
  }

  // The trunk of a snag of a height at height y over its foot, in its own space: the offset of
  // its axis across X and Z and its radius (the trunk tapers to 0.75 at the top)
  fn forest_snag_f(height: f64, y: f64) -> f64 {
    (y + TRUNK_SINK) / (height + TRUNK_SINK)
  }

  fn forest_snag_axis_x(seed: f64, height: f64, y: f64) -> f64 {
    forest_trunk_x(seed - 4 * floor(seed / 4), forest_snag_f(height, y)) * forest_snag_kr(seed)
  }

  fn forest_snag_axis_z(seed: f64, height: f64, y: f64) -> f64 {
    forest_trunk_z(seed - 4 * floor(seed / 4), forest_snag_f(height, y)) * forest_snag_kr(seed)
  }

  fn forest_snag_radius(seed: f64, height: f64, y: f64) -> f64 {
    forest_snag_r0(seed) * (1 - 0.25 * forest_snag_f(height, y))
  }

  // Stub j of a snag (trees.flecs): its height on the trunk, scale, pitch and yaw, and the point
  // q along it on the top of the wood, in the space of the snag
  fn forest_stub_y(height: f64, j: f64) -> f64 {
    height * (0.35 + 0.18 * j)
  }

  fn forest_stub_s(seed: f64, j: f64) -> f64 {
    (0.8 + 1.4 * forest_hash(j + 40, seed)) / LIMB_LEN
  }

  fn forest_stub_p(seed: f64, j: f64) -> f64 {
    1 + 0.5 * forest_hash(j + 41, seed)
  }

  fn forest_stub_w(seed: f64, j: f64) -> f64 {
    j * 2.3 + seed
  }

  // Radius of the wood of stub j at q along it
  fn forest_stub_r(seed: f64, j: f64, q: f64) -> f64 {
    const s = forest_stub_s(seed, j)
    const lv = forest_girth_level(forest_snag_r0(seed) * 0.3 / s)
    forest_girth(lv) * s * (1 - (1 - LIMB_TAPER) * q)
  }

  fn forest_stub_x(seed: f64, height: f64, j: f64, q: f64) -> f64 {
    const y = forest_stub_y(height, j)
    forest_snag_axis_x(seed, height, y) +
      forest_limb_at_x(LIMB_STRAIGHT, q, forest_stub_p(seed, j), forest_stub_w(seed, j), forest_stub_s(seed, j))
  }

  fn forest_stub_top(seed: f64, height: f64, j: f64, q: f64) -> f64 {
    const y = forest_stub_y(height, j)
    const p = forest_stub_p(seed, j)
    y + forest_limb_at_y(LIMB_STRAIGHT, q, p, forest_stub_w(seed, j), forest_stub_s(seed, j)) +
      forest_stub_r(seed, j, q) / max(sin(p), 0.5)
  }

  fn forest_stub_z(seed: f64, height: f64, j: f64, q: f64) -> f64 {
    const y = forest_stub_y(height, j)
    forest_snag_axis_z(seed, height, y) +
      forest_limb_at_z(LIMB_STRAIGHT, q, forest_stub_p(seed, j), forest_stub_w(seed, j), forest_stub_s(seed, j))
  }

  // The top of the fallen top of a snag at q along it, in the space of the snag (trees.flecs)
  fn forest_log_top_x(seed: f64, q: f64) -> f64 {
    const v = seed - 4 * floor(seed / 4)
    const lr = forest_snag_r0(seed) * 0.8
    forest_trunk_x(v + 1 - 4 * floor((v + 1) / 4), q) * lr / TRUNK_RADIUS
  }

  fn forest_log_top_y(seed: f64, q: f64) -> f64 {
    const v = seed - 4 * floor(seed / 4)
    const lr = forest_snag_r0(seed) * 0.8
    lr * 0.85 - forest_trunk_z(v + 1 - 4 * floor((v + 1) / 4), q) * lr / TRUNK_RADIUS +
      lr * (1 - 0.25 * q)
  }

  fn forest_log_top_z(seed: f64, q: f64) -> f64 {
    forest_snag_r0(seed) + 0.5 + q * (4 + 4 * forest_hash(60, seed))
  }

  // Yaw of the footbridge (brook.flecs), and a point on it in its space (local +Z along the path)
  export const BRIDGE_YAW: f32 = atan2(forest_path_slope(CROSSING_Z), 1)
  export const RAIL_TOP: f32 = 1.055

  fn forest_bridge_x(lx: f64, lz: f64) -> f64 {
    CROSSING_X + lx * cos(BRIDGE_YAW) + lz * sin(BRIDGE_YAW)
  }

  fn forest_bridge_z(lx: f64, lz: f64) -> f64 {
    CROSSING_Z + lz * cos(BRIDGE_YAW) - lx * sin(BRIDGE_YAW)
  }

  // Perches: the dead stubs of the two snags, the fallen top of the broken one and the handrails
  // of the footbridge, where the feet of a bird rest
  export const FOREST_PERCHES: ForestPerch[] = [
    {
      SNAG_A_X + forest_rot_x(forest_stub_x(5, 7.5, 0, 0.55), forest_stub_top(5, 7.5, 0, 0.55), forest_stub_z(5, 7.5, 0, 0.55), SNAG_A_TILT, SNAG_A_YAW),
      forest_rot_y(forest_stub_x(5, 7.5, 0, 0.55), forest_stub_top(5, 7.5, 0, 0.55), forest_stub_z(5, 7.5, 0, 0.55), SNAG_A_TILT, SNAG_A_YAW),
      SNAG_A_Z + forest_rot_z(forest_stub_x(5, 7.5, 0, 0.55), forest_stub_top(5, 7.5, 0, 0.55), forest_stub_z(5, 7.5, 0, 0.55), SNAG_A_TILT, SNAG_A_YAW),
      2

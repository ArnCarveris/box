    Clip: {duration: 4}
    x { Track: {component: Position, member: "x", curve: {kind: CurveCatmullRom, keys: [
      {0, 0}, {1.5, 0.14}, {3, -0.1}, {4, 0}
    ]}} }
    y { Track: {component: Position, member: "y", curve: {kind: CurveCatmullRom, keys: [
      {0, 0}, {1, 0.28}, {2, -0.04}, {3, 0.34}, {4, 0}
    ]}} }
  }

  // The flight of an insect around four stops, a clip for an Animator on the insect: it rests
  // or hovers at stop k (xk, yk, zk) for hold to hold + hold_var seconds, turns toward the next
  // one over turn seconds as it takes off, and flies to it in fly to fly + fly_var seconds,
  // weaving up to wander meters to the side and rising rise meters over the higher stop, from
  // stop 3 back to stop 0. Its keys rest with a zero slope, so it settles on a stop and sits
  // still. With flap a track sets the speed of the Animator of its child flap: slow while it
  // rests, full in flight (the flap of ForestButterfly model)
  template ForestFlight {
    prop x0: f32 = 0
    prop y0: f32 = 0
    prop z0: f32 = 0
    prop x1: f32 = 0
    prop y1: f32 = 0
    prop z1: f32 = 0
    prop x2: f32 = 0
    prop y2: f32 = 0
    prop z2: f32 = 0
    prop x3: f32 = 0
    prop y3: f32 = 0
    prop z3: f32 = 0
    prop seed: f32 = 0
    prop hold: f32 = 2
    prop hold_var: f32 = 2
    prop fly: f32 = 2
    prop fly_var: f32 = 1
    prop rise: f32 = 0.5
    prop wander: f32 = 0.3
    prop turn: f32 = 0.3
    prop flap: bool = false

    // Take off (t) and landing (l) times
    const t0 = hold + hold_var * forest_hash(seed, 1)
    const l1 = t0 + fly + fly_var * forest_hash(seed, 5)
    const t1 = l1 + hold + hold_var * forest_hash(seed, 2)
    const l2 = t1 + fly + fly_var * forest_hash(seed, 6)
    const t2 = l2 + hold + hold_var * forest_hash(seed, 3)
    const l3 = t2 + fly + fly_var * forest_hash(seed, 7)
    const t3 = l3 + hold + hold_var * forest_hash(seed, 4)
    const end = t3 + fly + fly_var * forest_hash(seed, 8)

    // The legs: their run, their sideways weave, their speed and the height of their arc
    const dx0 = x1 - x0
    const dz0 = z1 - z0
    const dx1 = x2 - x1
    const dz1 = z2 - z1
    const dx2 = x3 - x2
    const dz2 = z3 - z2
    const dx3 = x0 - x3
    const dz3 = z0 - z3
    const w0 = wander * (forest_hash(seed, 11) * 2 - 1) / max(sqrt(dx0 * dx0 + dz0 * dz0), 0.2)
    const w1 = wander * (forest_hash(seed, 12) * 2 - 1) / max(sqrt(dx1 * dx1 + dz1 * dz1), 0.2)
    const w2 = wander * (forest_hash(seed, 13) * 2 - 1) / max(sqrt(dx2 * dx2 + dz2 * dz2), 0.2)
    const w3 = wander * (forest_hash(seed, 14) * 2 - 1) / max(sqrt(dx3 * dx3 + dz3 * dz3), 0.2)
    const f0 = l1 - t0
    const f1 = l2 - t1
    const f2 = l3 - t2
    const f3 = end - t3
    const a0 = max(y0, y1) + rise * (0.7 + 0.6 * forest_hash(seed, 15))
    const a1 = max(y1, y2) + rise * (0.7 + 0.6 * forest_hash(seed, 16))
    const a2 = max(y2, y3) + rise * (0.7 + 0.6 * forest_hash(seed, 17))
    const a3 = max(y3, y0) + rise * (0.7 + 0.6 * forest_hash(seed, 18))

    // Headings of the legs, each within half a turn of the one before, so it turns the short
    // way; it starts on stop 0 facing as it came in from stop 3
    const h3 = forest_heading(dx3, dz3)
    const h0 = h3 + forest_wrap_angle(forest_heading(dx0, dz0) - h3)
    const h1 = h0 + forest_wrap_angle(forest_heading(dx1, dz1) - h0)
    const h2 = h1 + forest_wrap_angle(forest_heading(dx2, dz2) - h1)
    const h4 = h2 + forest_wrap_angle(forest_heading(dx3, dz3) - h2)

    Clip: {duration: end}

    x { Track: {component: Position, member: "x", curve: {kind: CurveBezier, keys: [
      {0, x0, 0, 0}, {t0, x0, 0, 0},
      {t0 + f0 * 0.25, x0 + dx0 * 0.25 - dz0 * w0, dx0 / f0, dx0 / f0},
      {t0 + f0 * 0.5, x0 + dx0 * 0.5 + dz0 * w0 * 0.6, dx0 / f0, dx0 / f0},
      {t0 + f0 * 0.75, x0 + dx0 * 0.75 - dz0 * w0 * 0.8, dx0 / f0, dx0 / f0},
      {l1, x1, 0, 0}, {t1, x1, 0, 0},
      {t1 + f1 * 0.25, x1 + dx1 * 0.25 - dz1 * w1, dx1 / f1, dx1 / f1},
      {t1 + f1 * 0.5, x1 + dx1 * 0.5 + dz1 * w1 * 0.6, dx1 / f1, dx1 / f1},
      {t1 + f1 * 0.75, x1 + dx1 * 0.75 - dz1 * w1 * 0.8, dx1 / f1, dx1 / f1},
      {l2, x2, 0, 0}, {t2, x2, 0, 0},
      {t2 + f2 * 0.25, x2 + dx2 * 0.25 - dz2 * w2, dx2 / f2, dx2 / f2},
      {t2 + f2 * 0.5, x2 + dx2 * 0.5 + dz2 * w2 * 0.6, dx2 / f2, dx2 / f2},
      {t2 + f2 * 0.75, x2 + dx2 * 0.75 - dz2 * w2 * 0.8, dx2 / f2, dx2 / f2},
      {l3, x3, 0, 0}, {t3, x3, 0, 0},
      {t3 + f3 * 0.25, x3 + dx3 * 0.25 - dz3 * w3, dx3 / f3, dx3 / f3},
      {t3 + f3 * 0.5, x3 + dx3 * 0.5 + dz3 * w3 * 0.6, dx3 / f3, dx3 / f3},
      {t3 + f3 * 0.75, x3 + dx3 * 0.75 - dz3 * w3 * 0.8, dx3 / f3, dx3 / f3},
      {end, x0, 0, 0}
    ]}} }

    z { Track: {component: Position, member: "z", curve: {kind: CurveBezier, keys: [
      {0, z0, 0, 0}, {t0, z0, 0, 0},
      {t0 + f0 * 0.25, z0 + dz0 * 0.25 + dx0 * w0, dz0 / f0, dz0 / f0},
      {t0 + f0 * 0.5, z0 + dz0 * 0.5 - dx0 * w0 * 0.6, dz0 / f0, dz0 / f0},
      {t0 + f0 * 0.75, z0 + dz0 * 0.75 + dx0 * w0 * 0.8, dz0 / f0, dz0 / f0},
      {l1, z1, 0, 0}, {t1, z1, 0, 0},
      {t1 + f1 * 0.25, z1 + dz1 * 0.25 + dx1 * w1, dz1 / f1, dz1 / f1},
      {t1 + f1 * 0.5, z1 + dz1 * 0.5 - dx1 * w1 * 0.6, dz1 / f1, dz1 / f1},
      {t1 + f1 * 0.75, z1 + dz1 * 0.75 + dx1 * w1 * 0.8, dz1 / f1, dz1 / f1},
      {l2, z2, 0, 0}, {t2, z2, 0, 0},
      {t2 + f2 * 0.25, z2 + dz2 * 0.25 + dx2 * w2, dz2 / f2, dz2 / f2},
      {t2 + f2 * 0.5, z2 + dz2 * 0.5 - dx2 * w2 * 0.6, dz2 / f2, dz2 / f2},
      {t2 + f2 * 0.75, z2 + dz2 * 0.75 + dx2 * w2 * 0.8, dz2 / f2, dz2 / f2},
      {l3, z3, 0, 0}, {t3, z3, 0, 0},
      {t3 + f3 * 0.25, z3 + dz3 * 0.25 + dx3 * w3, dz3 / f3, dz3 / f3},
      {t3 + f3 * 0.5, z3 + dz3 * 0.5 - dx3 * w3 * 0.6, dz3 / f3, dz3 / f3},
      {t3 + f3 * 0.75, z3 + dz3 * 0.75 + dx3 * w3 * 0.8, dz3 / f3, dz3 / f3},
      {end, z0, 0, 0}
    ]}} }

    // Up and down over the arc of a leg, settling onto the next stop
    y { Track: {component: Position, member: "y", curve: {kind: CurveBezier, keys: [
      {0, y0, 0, 0}, {t0, y0, 0, 0},
      {t0 + f0 * 0.25, a0, 0, 0}, {t0 + f0 * 0.5, a0 - rise * 0.35, 0, 0}, {t0 + f0 * 0.75, a0, 0, 0},
      {l1, y1, 0, 0}, {t1, y1, 0, 0},
      {t1 + f1 * 0.25, a1, 0, 0}, {t1 + f1 * 0.5, a1 - rise * 0.35, 0, 0}, {t1 + f1 * 0.75, a1, 0, 0},
      {l2, y2, 0, 0}, {t2, y2, 0, 0},
      {t2 + f2 * 0.25, a2, 0, 0}, {t2 + f2 * 0.5, a2 - rise * 0.35, 0, 0}, {t2 + f2 * 0.75, a2, 0, 0},
      {l3, y3, 0, 0}, {t3, y3, 0, 0},
      {t3 + f3 * 0.25, a3, 0, 0}, {t3 + f3 * 0.5, a3 - rise * 0.35, 0, 0}, {t3 + f3 * 0.75, a3, 0, 0},
      {end, y0, 0, 0}
    ]}} }

    yaw { Track: {component: Rotation, member: "y", curve: {kind: CurveBezier, keys: [
      {0, h3, 0, 0}, {t0, h3, 0, 0}, {t0 + turn, h0, 0, 0},
      {t1, h0, 0, 0}, {t1 + turn, h1, 0, 0},
      {t2, h1, 0, 0}, {t2 + turn, h2, 0, 0},
      {t3, h2, 0, 0}, {t3 + turn, h4, 0, 0},
      {end, h4, 0, 0}
    ]}} }

    if flap {
      beat { Track: {component: Animator, member: "speed", target: "model.flap", curve: {keys: [
        {0, FLAP_REST}, {t0, FLAP_REST}, {t0 + 0.15, 1}, {l1 - 0.2, 1},
        {l1, FLAP_REST}, {t1, FLAP_REST}, {t1 + 0.15, 1}, {l2 - 0.2, 1},
        {l2, FLAP_REST}, {t2, FLAP_REST}, {t2 + 0.15, 1}, {l3 - 0.2, 1},
        {l3, FLAP_REST}, {t3, FLAP_REST}, {t3 + 0.15, 1}, {end - 0.2, 1},
        {end, FLAP_REST}
      ]}} }
    }
  }

  // A butterfly about 6 cm across facing -Z, in the colors of a kind: 0 brimstone, 1 cabbage
  // white, 2 peacock, 3 small tortoiseshell, 4 common blue
  template ForestButterfly {
    prop kind: i32 = 0
    prop phase: f32 = 0

    const r = kind == 0 ? 238 : (kind == 1 ? 246 : (kind == 2 ? 178 : (kind == 3 ? 228 : 122)))
    const g = kind == 0 ? 224 : (kind == 1 ? 244 : (kind == 2 ? 54 : (kind == 3 ? 116 : 152)))
    const b = kind == 0 ? 96 : (kind == 1 ? 234 : (kind == 2 ? 36 : (kind == 3 ? 40 : 238)))

    body : ForestInsectDark {
      Position: {0, 0, 0.004}
      Scale: {0.0022, 0.0022, 0.0105}
      Sphere: {radius: 1, segments: 6}
    }

    head : ForestInsectDark {
      Position: {0, 0.0004, -0.0078}
      Sphere: {radius: 0.002, segments: 6}
    }

    flap {
      Animator: {clip: forest_butterfly_flap, time: phase * FLAP_TIME, speed: 1}

      wing_r : ForestButterflyWingR {
        Position: {0.0012, 0.001, -0.001}
        Rotation: {0, 0, 0}
        Scale: {0.03, 0.03, 0.03}
        Rgb: {r, g, b}
      }

      wing_l : ForestButterflyWingL {
        Position: {-0.0012, 0.001, -0.001}
        Rotation: {0, 0, 0}
        Scale: {0.03, 0.03, 0.03}
        Rgb: {r, g, b}
      }
    }
  }

  // A honey bee, 1.3 cm long, facing -Z, hovering with buzzing wings
  template ForestBee {
    prop phase: f32 = 0

    hover {
      Animator: {clip: forest_hover_wobble, time: phase * 1.3, speed: 1}

      thorax : ForestInsectDark {
        Position: {0, 0, -0.001}
        Sphere: {radius: 0.0032, segments: 6}
      }

      head : ForestInsectDark {
        Position: {0, -0.0005, -0.0052}
        Sphere: {radius: 0.0022, segments: 6}
      }

      abdomen : ForestBeeAmber {
        Position: {0, -0.0006, 0.0052}
        Rotation: {0.2, 0, 0}
        Scale: {0.0038, 0.0036, 0.0058}
        Sphere: {radius: 1, segments: 10, smooth: true}
      }

      buzz {
        Position: {0, 0.003, -0.0015}
        Animator: {clip: forest_bee_buzz, time: phase * BUZZ_TIME, speed: 1}
        wing_r : ForestClearWingR { Rotation: {0, 0, 0}; Scale: {0.0085, 0.0085, 0.0085} }
        wing_l : ForestClearWingL { Rotation: {0, 0, 0}; Scale: {0.0085, 0.0085, 0.0085} }
      }
    }
  }

  // A dragonfly 9 cm long facing -Z: a large head of eyes, the thorax with the four wings and
  // the long abdomen, 0 blue, 1 green, 2 red
  template ForestDragonfly {
    prop kind: i32 = 0
    prop phase: f32 = 0

    hover {
      Scale: {1.25, 1.25, 1.25}
      Animator: {clip: forest_hover_wobble, time: phase * 1.3, speed: 0.7}

      head : ForestDragonEye {
        Position: {0, 0, -0.0105}
        Scale: {0.0052, 0.0042, 0.0042}
        Sphere: {radius: 1, segments: 8}
      }

      if kind == 0 {
        thorax : ForestDragonGreen { Scale: {0.0042, 0.0046, 0.0072}; Sphere: {radius: 1, segments: 6} }
        abdomen : ForestDragonBlue {
          Position: {0, -0.0008, 0.032}
          Scale: {0.0022, 0.0022, 0.026}
          Sphere: {radius: 1, segments: 6}
        }
      } else if kind == 1 {
        thorax : ForestDragonGreen { Scale: {0.0042, 0.0046, 0.0072}; Sphere: {radius: 1, segments: 6} }
        abdomen : ForestDragonGreen {
          Position: {0, -0.0008, 0.032}
          Scale: {0.0022, 0.0022, 0.026}
          Sphere: {radius: 1, segments: 6}
        }
      } else {
        thorax : ForestDragonRed { Scale: {0.0042, 0.0046, 0.0072}; Sphere: {radius: 1, segments: 6} }
        abdomen : ForestDragonRed {
          Position: {0, -0.0008, 0.03}
          Scale: {0.002, 0.002, 0.024}
          Sphere: {radius: 1, segments: 6}
        }
      }

      flutter {
        Position: {0, 0.0035, 0}
        Animator: {clip: forest_dragon_flutter, time: phase * FLUTTER_TIME, speed: 1}
        fore_r : ForestClearWingR { Position: {0, 0, -0.003}; Rotation: {0, 0, 0}; Scale: {0.044, 0.044, 0.044} }
        fore_l : ForestClearWingL { Position: {0, 0, -0.003}; Rotation: {0, 0, 0}; Scale: {0.044, 0.044, 0.044} }
        hind_r : ForestClearWingR { Position: {0, 0, 0.004}; Rotation: {0, 0, 0}; Scale: {0.041, 0.05, 0.05} }
        hind_l : ForestClearWingL { Position: {0, 0, 0.004}; Rotation: {0, 0, 0}; Scale: {0.041, 0.05, 0.05} }
      }
    }
  }
}

// The counts follow the sliders
async {
  while true {
    await next_frame()
    const s = state.season
    const h = state.hour
    const t = state.temperature
    const p = state.precipitation
    const w = state.wind
    const nb: i32 = round(state.BUTTERFLY_MAX * state.forest_butterfly_activity(s, h, t, p, w))
    const ne: i32 = round(state.BEE_MAX * state.forest_bee_activity(s, h, t, p, w))
    const nd: i32 = round(state.DRAGONFLY_MAX * state.forest_dragonfly_activity(s, h, t, p, w))
    const fa = state.forest_firefly_activity(s, h, t, p, w)
    const nf: i32 = round(state.FIREFLY_LIGHT_MAX * fa)
    const fg: f32 = floor(fa * 20 + 0.5) / 20
    const ng: i32 = round(state.GNAT_SWARM_MAX * state.forest_gnat_activity(s, h, t, p, w))

    if nb != state.butterfly_count {
      state.butterfly_count = nb
    }

    if ne != state.bee_count {
      state.bee_count = ne
    }

    if nd != state.dragonfly_count {
      state.dragonfly_count = nd
    }

    if nf != state.firefly_lights {
      state.firefly_lights = nf
    }

    if fg != state.firefly_glow {
      state.firefly_glow = fg
    }

    if ng != state.gnat_swarms {
      state.gnat_swarms = ng
    }
  }
}

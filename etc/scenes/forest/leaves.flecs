  // The leaves of each species. The season recolors and thins a species through the Rgb,
  // AlphaCutoff and DiffuseTransmission of its prefabs; the B prefabs lag behind a little. The
  // prefabs the season changes are NoBake: the reflection probes would otherwise look up every
  // card that inherits a changed material, every frame the slider moves
  prefab ForestLeafBeech : ForestCardTripleMesh {
    Rgb: {forest_leaf_r(0, season), forest_leaf_g(0, season), forest_leaf_b(0, season)}
    PbrMaterial: {roughness: 0.75}
    WindSway: {bend: SWAY_BROADLEAF_BEND, height: SWAY_BROADLEAF_HEIGHT, base: 0, flutter: SWAY_LEAF_FLUTTER, flutter_frequency: SWAY_LEAF_FREQUENCY, flutter_reach: SWAY_LEAF_REACH}
    AlphaCutoff: {forest_leaf_cutoff(0, season)}
    DiffuseTransmission: {factor: 0.65, color: {forest_leaf_glow_r(season), forest_leaf_glow_g(season), forest_leaf_glow_b(season)}}
    PbrTextures: {albedo: leaf_beech_albedo, normal: leaf_beech_normal}
    texture.Layers: {layers: [layer_wet_foliage, layer_snow_foliage]}
    NoBake
  }

  prefab ForestLeafBeechB : ForestLeafBeech {
    Rgb: {forest_leaf_r(0, season - LEAF_LAG), forest_leaf_g(0, season - LEAF_LAG), forest_leaf_b(0, season - LEAF_LAG)}
    AlphaCutoff: {forest_leaf_cutoff(0, season - LEAF_LAG)}
    PbrTextures: {albedo: leaf_beech_b_albedo, normal: leaf_beech_b_normal}
    NoBake
  }

  prefab ForestLeafOak : ForestCardTripleMesh {
    Rgb: {forest_leaf_r(1, season), forest_leaf_g(1, season), forest_leaf_b(1, season)}
    PbrMaterial: {roughness: 0.8}
    WindSway: {bend: SWAY_BROADLEAF_BEND, height: SWAY_BROADLEAF_HEIGHT, base: 0, flutter: SWAY_LEAF_FLUTTER, flutter_frequency: SWAY_LEAF_FREQUENCY, flutter_reach: SWAY_LEAF_REACH}
    AlphaCutoff: {forest_leaf_cutoff(1, season)}
    DiffuseTransmission: {factor: 0.5, color: {forest_leaf_glow_r(season), forest_leaf_glow_g(season), forest_leaf_glow_b(season)}}
    PbrTextures: {albedo: leaf_oak_albedo, normal: leaf_oak_normal}
    texture.Layers: {layers: [layer_wet_foliage, layer_snow_foliage]}
    NoBake
  }

  prefab ForestLeafOakB : ForestLeafOak {
    Rgb: {forest_leaf_r(1, season - LEAF_LAG), forest_leaf_g(1, season - LEAF_LAG), forest_leaf_b(1, season - LEAF_LAG)}
    AlphaCutoff: {forest_leaf_cutoff(1, season - LEAF_LAG)}
    PbrTextures: {albedo: leaf_oak_b_albedo, normal: leaf_oak_b_normal}
    NoBake
  }

  prefab ForestLeafBirch : ForestCardTripleMesh {
    Rgb: {forest_leaf_r(2, season), forest_leaf_g(2, season), forest_leaf_b(2, season)}
    PbrMaterial: {roughness: 0.72}
    WindSway: {bend: SWAY_BIRCH_BEND, height: SWAY_BIRCH_HEIGHT, base: 0, flutter: SWAY_LEAF_FLUTTER, flutter_frequency: SWAY_LEAF_FREQUENCY, flutter_reach: SWAY_LEAF_REACH}
    AlphaCutoff: {forest_leaf_cutoff(2, season)}
    DiffuseTransmission: {factor: 0.7, color: {forest_leaf_glow_r(season), forest_leaf_glow_g(season), forest_leaf_glow_b(season)}}
    PbrTextures: {albedo: leaf_birch_albedo, normal: leaf_birch_normal}
    texture.Layers: {layers: [layer_wet_foliage, layer_snow_foliage]}
    NoBake
  }

  prefab ForestLeafBirchB : ForestLeafBirch {
    Rgb: {forest_leaf_r(2, season - LEAF_LAG), forest_leaf_g(2, season - LEAF_LAG), forest_leaf_b(2, season - LEAF_LAG)}
    AlphaCutoff: {forest_leaf_cutoff(2, season - LEAF_LAG)}
    PbrTextures: {albedo: leaf_birch_b_albedo, normal: leaf_birch_b_normal}
    NoBake
  }

  // The needles stay green all year
  prefab ForestNeedleSpruce : ForestFrondPairMesh {
    Rgb: {52, 86, 50}
    PbrMaterial: {roughness: 0.85}
    WindSway: {bend: SWAY_CONIFER_BEND, height: SWAY_CONIFER_HEIGHT, base: 0, flutter: SWAY_NEEDLE_FLUTTER, flutter_frequency: SWAY_NEEDLE_FREQUENCY, flutter_reach: SWAY_NEEDLE_REACH}
    AlphaCutoff: {0.4}
    DiffuseTransmission: {factor: 0.15, color: {150, 200, 120}}
    PbrTextures: {albedo: leaf_spruce_albedo, normal: leaf_spruce_normal}
    texture.Layers: {layers: [layer_wet_foliage, layer_snow_foliage]}
  }

  prefab ForestNeedleFir : ForestFrondPairMesh {
    Rgb: {44, 80, 54}
    PbrMaterial: {roughness: 0.85}
    WindSway: {bend: SWAY_CONIFER_BEND, height: SWAY_CONIFER_HEIGHT, base: 0, flutter: SWAY_NEEDLE_FLUTTER, flutter_frequency: SWAY_NEEDLE_FREQUENCY, flutter_reach: SWAY_NEEDLE_REACH}
    AlphaCutoff: {0.4}
    DiffuseTransmission: {factor: 0.12, color: {150, 200, 120}}
    PbrTextures: {albedo: leaf_fir_albedo, normal: leaf_fir_normal}
    texture.Layers: {layers: [layer_wet_foliage, layer_snow_foliage]}
  }
}

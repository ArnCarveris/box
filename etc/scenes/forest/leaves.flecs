using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.light
using box.texture
using state
using assets
using trees

// The leaves of the forest trees and shrubs. The card textures are those of the tree library
// (trees/cards): data per level, an albedo that is a light, nearly neutral detail with the
// coverage as alpha, and the normals. The color comes from the Rgb of the leaf prefab, so the
// season recolors every leaf of a species by changing its prefab (the B prefabs a little
// later), and thins a crown card by card by the VertexReveal of its prefab, which hides the
// cards whose seed (TREE_CHANNEL_SEED) is below its threshold.
state {
  // The leaf colors of the broadleaf species (0, OAK, BIRCH) by channel: fresh lime
  // in spring, deep green in summer, copper beech, russet oak and golden birch in autumn
  fn forest_leaf_r(species: f64, season: f64) -> f64 {
    species < 0.5 ? forest_foliage(season, 138, 86, 190, 120) : (
      species < 1.5 ? forest_foliage(season, 124, 66, 160, 112) : forest_foliage(season, 150, 104, 222, 156))
  }

  fn forest_leaf_g(species: f64, season: f64) -> f64 {
    species < 0.5 ? forest_foliage(season, 180, 126, 94, 74) : (
      species < 1.5 ? forest_foliage(season, 164, 102, 106, 80) : forest_foliage(season, 188, 144, 176, 122))
  }

  fn forest_leaf_b(species: f64, season: f64) -> f64 {
    species < 0.5 ? forest_foliage(season, 58, 44, 26, 38) : (
      species < 1.5 ? forest_foliage(season, 52, 36, 34, 42) : forest_foliage(season, 66, 50, 40, 58))
  }

  // The share of the cards of a crown of a species the season hides: a few while the leaves come
  // out in spring, none in summer, more in autumn (the birch first, the oak holds on longest),
  // all in winter
  fn forest_leaf_thin(species: f64, season: f64) -> f64 {
    species < 0.5 ? forest_seasonal(season, 0.12, 0, 0.2, LEAF_BARE) : (
      species < 1.5 ? forest_seasonal(season, 0.16, 0, 0.14, LEAF_BARE) : forest_seasonal(season, 0.1, 0, 0.28, LEAF_BARE))
  }

  // The AlphaCutoff of the leaves of a species, which thins the cards that are left leaf by
  // leaf: small leaves while they come out in spring, full in summer, dropping in autumn
  fn forest_leaf_cutoff(species: f64, season: f64) -> f64 {
    species < 0.5 ? forest_seasonal(season, 0.6, LEAF_FULL, 0.78, LEAF_KEEP_MIN) : (
      species < 1.5 ? forest_seasonal(season, 0.7, LEAF_FULL, 0.7, LEAF_KEEP_MIN) : forest_seasonal(season, 0.55, LEAF_FULL, 0.82, LEAF_KEEP_MIN))
  }

  // The B clusters of a crown turn and drop a little later than the others, so an autumn crown
  // is mottled
  export const LEAF_LAG: f32 = 0.18

  // The light through the leaves: green, golden in autumn
  fn forest_leaf_glow_r(season: f64) -> f64 {
    forest_seasonal(season, 226, 210, 255, 210)
  }

  fn forest_leaf_glow_g(season: f64) -> f64 {
    forest_seasonal(season, 255, 255, 196, 200)
  }

  fn forest_leaf_glow_b(season: f64) -> f64 {
    forest_seasonal(season, 150, 140, 110, 180)
  }

}

assets {

using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.light
using box.particle
using box.animation
using state
using assets

// The insects that bring the forest to life: fireflies blinking over the grass on summer
// evenings, a few of them real lights, butterflies that fly from flower to flower and settle on
// them, bees that hover at the flowers, dragonflies that hover and dart over the brook, and
// swarms of gnats dancing in the sunbeams. Each kind follows the season, the hour, the
// temperature, the wind and the rain (forest_*_activity): none in winter, in the cold or in
// heavy rain, and fewer the harder the wind blows.
//
// The async block at the end turns the activities into counts; the loops below create and
// delete the insects as the counts change, and Animators fly them, so the script does not run
// again every frame. The butterflies and the bees visit the wildflowers of scatter.flecs:
// forest_flower_* mirror where it places them.
state {
  // The most insects of each kind, at their most active
  export const BUTTERFLY_MAX: i32 = 16
  export const BEE_MAX: i32 = 20
  export const DRAGONFLY_MAX: i32 = 6
  export const FIREFLY_LIGHT_MAX: i32 = 8
  export const GNAT_SWARM_MAX: i32 = 6

  // Particles a second of the fireflies over the grass, at their most active
  export const FIREFLY_RATE: f32 = 60

  // The butterflies and the bees visit the flowers of the flower cells from (VISIT_GX, VISIT_GZ)
  // on, VISIT_W by VISIT_H cells: the sunny middle of the clearing in front of the start view
  export const VISIT_GX: i32 = 20
  export const VISIT_GZ: i32 = 19
  export const VISIT_W: i32 = 4
  export const VISIT_H: i32 = 3

  // The dragonflies patrol DRAGON_REACH meters of the brook each, the reaches DRAGON_GAP apart
  export const DRAGON_REACH: f32 = 6
  export const DRAGON_GAP: f32 = 4.5

  // X of hover spot k of dragonfly d on its reach of the brook: the even ones upstream of the
  // bridge, the odd ones downstream, so none flies through it
  fn forest_dragon_x(d: f64, k: f64) -> f64 {
    const n = floor(d / 2)
    const u = DRAGON_REACH * forest_hash(d, 610 + k)
    d - 2 * n < 0.5 ? CROSSING_X - BRIDGE_HALF_WIDTH - 1.2 - n * DRAGON_GAP - u :
      CROSSING_X + BRIDGE_HALF_WIDTH + 1.2 + n * DRAGON_GAP + u
  }

  // Speed of the flap Animator of a butterfly sitting on a flower: its wings open and close
  // slowly
  export const FLAP_REST: f32 = 0.1

  // The flower spots of scatter.flecs: spot j is spot j % 4 of flower cell floor(j / 4), and
  // cell i is (floor(i / FLOWER_GRID), i % FLOWER_GRID)
  fn forest_flower_cell_x(gx: f64) -> f64 {
    (gx + 0.5) * FLOWER_CELL - UNDER_EDGE
  }

  fn forest_flower_spot_x(j: f64) -> f64 {
    const i = floor(j / 4)
    const k = j - i * 4
    const gx = floor(i / FLOWER_GRID)
    (gx + 0.5 * (k - 2 * floor(k / 2)) + 0.05 + 0.4 * forest_hash(j, 311)) * FLOWER_CELL - UNDER_EDGE
  }

  fn forest_flower_spot_z(j: f64) -> f64 {
    const i = floor(j / 4)
    const k = j - i * 4
    const gz = i - floor(i / FLOWER_GRID) * FLOWER_GRID
    (gz + 0.5 * floor(k / 2) + 0.05 + 0.4 * forest_hash(j, 312)) * FLOWER_CELL - UNDER_EDGE
  }

  // A flower grows at spot j, as scatter.flecs decides
  fn forest_flower_placed(j: f64) -> bool {
    const i = floor(j / 4)
    const gx = floor(i / FLOWER_GRID)
    const cx = forest_flower_cell_x(gx)
    const cz = forest_flower_cell_x(i - gx * FLOWER_GRID)
    const dens = forest_under_density(cx, cz)
    const light = forest_light(cx, cz)
    const x = forest_flower_spot_x(j)
    const z = forest_flower_spot_z(j)
    dens <= 0 ? false : (forest_hash(j, 313) >= dens * light * light * 0.8 ? false : (
      forest_floor_free(x, z, 0.15) ? !forest_feature_near(x, z, 0.2) : false))
  }

  // Height of the flower heads of the flower at spot j: its scale by its kind, the heads
  // stand at about 0.72 of the clump
  fn forest_flower_top(j: f64) -> f64 {
    const s = 0.32 + 0.22 * forest_hash(j, 314)
    const patch = forest_hash2(floor(forest_flower_spot_x(j) / 4), floor(forest_flower_spot_z(j) / 4), 51)
    0.72 * (patch < 0.45 ? s * 1.1 : (patch < 0.8 ? s : s * 1.3))
  }

  // A flower of cell (gx, gz): the first one that grows from spot start on, -1 for none
  fn forest_flower_pick(gx: f64, gz: f64, start: f64) -> f64 {
    const i = (gx * FLOWER_GRID + gz) * 4
    const a = i + start - 4 * floor(start / 4)
    const b = i + (start + 1) - 4 * floor((start + 1) / 4)
    const c = i + (start + 2) - 4 * floor((start + 2) / 4)
    const d = i + (start + 3) - 4 * floor((start + 3) / 4)
    forest_flower_placed(a) ? a : (forest_flower_placed(b) ? b : (
      forest_flower_placed(c) ? c : (forest_flower_placed(d) ? d : 0 - 1)))
  }

  // Where an insect visits the flower of cell (gx, gz): the heads of the flower, or the grass
  // in the middle of the cell when no flower grows in it
  fn forest_visit_x(gx: f64, gz: f64, start: f64) -> f64 {
    const j = forest_flower_pick(gx, gz, start)
    j < 0 ? forest_flower_cell_x(gx) : forest_flower_spot_x(j)
  }

  fn forest_visit_z(gx: f64, gz: f64, start: f64) -> f64 {
    const j = forest_flower_pick(gx, gz, start)
    j < 0 ? forest_flower_cell_x(gz) : forest_flower_spot_z(j)
  }

  fn forest_visit_y(gx: f64, gz: f64, start: f64) -> f64 {
    const j = forest_flower_pick(gx, gz, start)
    j < 0 ? 0.3 : forest_flower_top(j)
  }

  // An angle moved by whole turns to within half a turn of 0
  fn forest_wrap_angle(a: f64) -> f64 {
    a - 2 * PI * round(a / (2 * PI))
  }

  // Yaw that faces local -Z along (dx, dz)
  fn forest_heading(dx: f64, dz: f64) -> f64 {
    atan2(0 - dx, 0 - dz)
  }

  // How the weather lets the insects fly, 0..1: warm enough, out of the rain and the wind. cold
  // and warm are the temperatures in °C between which they take wing, rain the precipitation
  // that grounds them all, gust the wind in m/s
  fn forest_insect_weather(t: f64, p: f64, w: f64, cold: f64, warm: f64, rain: f64, gust: f64) -> f64 {
    forest_smooth(cold, warm, t) * (1 - forest_smooth(rain * 0.15, rain, p)) *
      (1 - forest_smooth(gust * 0.4, gust, w))
  }

  // The insects of a kind on the wing, 0..1, at a season, hour, temperature, precipitation and
  // wind. Fireflies glow from sunset into the night of summer, in the warmth and still air
  fn forest_firefly_activity(season: f64, hour: f64, t: f64, p: f64, w: f64) -> f64 {
    const dusk = forest_smooth(forest_sunset(season) - 0.8, forest_sunset(season) + 0.6, hour)
    forest_seasonal(season, 0.12, 1, 0.08, 0) * dusk * forest_insect_weather(t, p, w, 11, 16, 0.25, 8)
  }

  // Butterflies in the sun of spring and summer, warm and calm days
  fn forest_butterfly_activity(season: f64, hour: f64, t: f64, p: f64, w: f64) -> f64 {
    const sun = forest_smooth(6, 22, forest_sun_elevation(season, hour))
    forest_seasonal(season, 0.85, 1, 0.3, 0) * sun * forest_insect_weather(t, p, w, 7, 13, 0.18, 12)
  }

  // Bees from the first warm days of spring to autumn, from the morning to the evening
  fn forest_bee_activity(season: f64, hour: f64, t: f64, p: f64, w: f64) -> f64 {
    const sun = forest_smooth(3, 16, forest_sun_elevation(season, hour))
    forest_seasonal(season, 1, 1, 0.35, 0) * sun * forest_insect_weather(t, p, w, 6, 11, 0.3, 13)
  }

  // Dragonflies over the brook in the warm days of summer
  fn forest_dragonfly_activity(season: f64, hour: f64, t: f64, p: f64, w: f64) -> f64 {
    const sun = forest_smooth(8, 24, forest_sun_elevation(season, hour))
    forest_seasonal(season, 0.1, 1, 0.4, 0) * sun * forest_insect_weather(t, p, w, 13, 18, 0.25, 12)
  }

  // Gnats dance in the beams of the low sun (forest_beam) of the mornings and evenings from
  // spring to autumn, in still air
  fn forest_gnat_activity(season: f64, hour: f64, t: f64, p: f64, w: f64) -> f64 {
    forest_seasonal(season, 0.7, 1, 0.75, 0) * forest_smooth(0.15, 0.6, forest_beam(season, hour)) *
      forest_insect_weather(t, p, w, 5, 10, 0.25, 7)
  }

  // The counts the activities give, kept up to date by the async block at the end; the glow of
  // the fireflies over the grass in steps of a twentieth
  export mut butterfly_count: i32 = 0
  export mut bee_count: i32 = 0
  export mut dragonfly_count: i32 = 0
  export mut firefly_lights: i32 = 0
  export mut gnat_swarms: i32 = 0
  export mut firefly_glow: f32 = 0
}

assets {

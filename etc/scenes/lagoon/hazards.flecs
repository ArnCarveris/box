using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.particle
using state
using assets

state {
  // How far below the water an item at world z sits while it rises in, age seconds after it
  // spawned: it rises over RISE units after SPAWN_AHEAD, or over RISE_TIME seconds when that is
  // slower, so items seeded closer at the start of a run rise in instead of popping up
  fn lg_sink(wz: f64, age: f64) -> f64 {
    -1.6 * (1 - min(clamp((wz + SPAWN_AHEAD) / RISE, 0, 1), clamp(age / RISE_TIME, 0, 1)))
  }

  // Whether a circle of radius r at x, wz (world z) touches the hull or the outrigger float
  fn lg_touches(x: f64, wz: f64, r: f64) -> bool {
    (abs(x - canoe_x) < HULL_HALF_W + r && abs(wz - CANOE_Z) < HULL_HALF_L + r) ||
      (abs(x - canoe_x - FLOAT_X) < FLOAT_HALF_W + r && abs(wz - CANOE_Z - 0.1) < FLOAT_HALF_L + r)
  }

  // The yaw of a log at time t: it turns LOG_TURN radians a second, one way or the other by kind
  fn lg_log_yaw(spin: f64, kind: i32, t: f64) -> f64 {
    spin + t * (kind == 0 ? LOG_TURN : 0 - LOG_TURN)
  }

  // Whether a log at x, wz (world z) with the given yaw and size touches the canoe: its capsule
  // as LOG_SAMPLES circles of LOG_R along the axis, which turns local +X to (cos, -sin) in X, Z
  fn lg_touches_log(x: f64, wz: f64, yaw: f64, size: f64) -> bool {
    mut hit: bool = false

    for k in 0..LOG_SAMPLES {
      const t = LOG_HALF * size * (2.0 * k / (LOG_SAMPLES - 1) - 1)

      if lg_touches(x + t * cos(yaw), wz - t * sin(yaw), LOG_R) {
        hit = true
      }
    }

    hit
  }

  // The reach of a hazard from its middle across the river, whatever its yaw
  fn lg_rock_r(size: f64) -> f64 {
    ROCK_R * size
  }

  fn lg_log_r(size: f64) -> f64 {
    LOG_HALF * size + LOG_R
  }

  // Whether a circle of radius r at x, z (scrolled world) stays clear of every live hazard
  fn lg_clear(x: f64, z: f64, r: f64) -> bool {
    mut ok: bool = true

    for j in 0..rocks.count() {
      const d = sqr(x - rocks[j].x) + sqr(z - rocks[j].z)

      if rocks[j].live && d < sqr(lg_rock_r(rocks[j].size) + r) {
        ok = false
      }
    }

    for j in 0..logs.count() {
      const d = sqr(x - logs[j].x) + sqr(z - logs[j].z)

      if logs[j].live && d < sqr(lg_log_r(logs[j].size) + r) {
        ok = false
      }
    }

    ok
  }

  // The first free slot of a pool, -1 when it is full
  fn lg_free_rock() -> i32 {
    mut s: i32 = -1

    for j in 0..rocks.count() {
      if s < 0 && !rocks[j].live {
        s = j
      }
    }

    s
  }

  fn lg_free_log() -> i32 {
    mut s: i32 = -1

    for j in 0..logs.count() {
      if s < 0 && !logs[j].live {
        s = j
      }
    }

    s
  }

  // Adds lo..hi across the river to what the row being placed blocks
  fn lg_wall_add(lo: f64, hi: f64) {
    if walls < WALL_MAX {
      wall_lo[walls] = lo
      wall_hi[walls] = hi
      walls += 1
    }
  }

  // Whether lo..hi across the river slips past everything the row being placed blocks
  fn lg_wall_open(lo: f64, hi: f64) -> bool {
    mut open: bool = true

    for j in 0..walls {
      if lo < wall_hi[j] && hi > wall_lo[j] {
        open = false
      }
    }

    open
  }

  fn lg_free_nut() -> i32 {
    mut s: i32 = -1

    for j in 0..nuts.count() {
      if s < 0 && !nuts[j].live {
        s = j
      }
    }

    s
  }
}

$ {
  box.particle.Settings: {effect_max: 16, effect_total: 48, effect_overflow: EffectRecycle}
}

assets {
  // A jagged coral head breaking the surface, ringed by foam
  template LgReefRock {
    prop size: f32 = 1
    prop seed: f32 = 0

    base : LgCoral {
      Position: {0, 0.1 * size, 0}
      Rotation: {0.3, seed, 0.2}
      Scale: {1.1 * size, 0.7 * size, 0.95 * size}
      IcoSphere: {radius: 1, segments: 1}
    }

    for k in 0..5 {
      const a = seed + k * 1.2566 + 0.4 * sin(seed * 3 + k)
      const h = (0.7 + 0.5 * hash(seed + k)) * size
      "spike_{k}" : LgCoral {
        Position: {0.5 * size * cos(a), 0.45 * size + h * 0.5, 0.5 * size * sin(a)}
        Rotation: {0.45 * sin(a), a, 0.45 * cos(a)}
        Cone: {length: h * 1.6, radius: 0.24 * size, segments: 4}
      }
    }

    foam : LgFoam {
      Position: {0, 0.03, 0}
      Scale: {1, 0.35, 1}
      Torus: {radius: 1.12 * size, tube: 0.16, segments: 20, rings: 6}
    }
  }

  // A bleached log lying along X with a snapped branch, half under water
  template LgDriftLog {
    prop size: f32 = 1
    prop seed: f32 = 0

    trunk : LgDriftwood {
      Rotation: {seed, 0, HALF_PI}
      Capsule: {length: 1.5 * size, radius: 0.27, segments: 10, smooth: true}
    }

    end_l : LgDriftwoodEnd {
      Position: {-0.75 * size - 0.2, 0, 0}
      Rotation: {0, 0, HALF_PI}
      Cylinder: {length: 0.04, radius: 0.2, segments: 10}
    }

    end_r : LgDriftwoodEnd {
      Position: {0.75 * size + 0.2, 0, 0}
      Rotation: {0, 0, HALF_PI}
      Cylinder: {length: 0.04, radius: 0.2, segments: 10}
    }

    branch : LgDriftwood {
      Position: {0.2 * size, 0.24, -0.1}
      Rotation: {-0.5, 0.4, -0.7}
      Cylinder: {length: 0.6, radius: 0.07, segments: 6}
    }

    stub : LgDriftwood {
      Position: {-0.45 * size, 0.18, 0.12}
      Rotation: {0.6, 0, 0.3}
      Cylinder: {length: 0.3, radius: 0.06, segments: 6}
    }
  }

  // A floating coconut, its pointed end forward
  template LgFloatCoconut {
    prop seed: f32 = 0

    husk : LgCoconutHusk {
      Scale: {1, 0.9, 1.12}
      Sphere: {radius: 0.32, segments: 14, smooth: true}
    }

    tip : LgCoconutHusk {
      Position: {0, 0, -0.34}
      Rotation: {-HALF_PI, 0, 0}
      Cone: {length: 0.12, radius: 0.12, segments: 8}
    }

    stem : LgCoconutGreen {
      Position: {0, 0.27, 0.06}
      Cylinder: {length: 0.08, radius: 0.06, segments: 6}
    }
  }

  // Spray and a puff of mist where the hull hits a rock or a log
  prefab LgSplash {
    drops {
      Position: {0, 0, 0}
      box.particle.Emitter: {
        max: 90, rate: 0, shape: EmitterSphere, radius: 0.4,
        direction: {0, 1, 0}, spread: 50, speed: {3, 6.5},
        lifetime: {0.5, 1.0}, size: {0.1, 0.22}, opacity: {0.7, 1},
        color: {214, 244, 240}, color_variance: {20, 10, 10}, seed: 21
      }
      Burst: {count: 70}
      Forces: {gravity: {0, -14, 0}}
    }

    mist {
      Position: {0, 0, 0}
      box.particle.Emitter: {
        max: 20,
        rate: 0,
        shape: EmitterSphere,
        radius: 0.7,
        direction: {0, 1, 0},
        spread: 80,
        speed: {0.5, 1.3},
        lifetime: {0.8, 1.4},
        size: {0.7, 1.2},
        opacity: {0.3, 0.5},
        color: {236, 250, 248},
        seed: 22
      }
      Burst: {count: 14}
      Curves: {size: {keys: [{0, 0.6}, {1, 1.8}]}, opacity: {keys: [{0, 1}, {1, 0}]}}
    }
  }

  // Golden sparkles where a coconut is picked up
  prefab LgSparkle {
    sparks {
      Position: {0, 0, 0}
      box.particle.Emitter: {
        max: 50, rate: 0, shape: EmitterSphere, radius: 0.25,
        direction: {0, 1, 0}, spread: 70, speed: {1.5, 3.5},
        lifetime: {0.4, 0.8}, size: {0.06, 0.14}, opacity: {1, 1},
        color: {255, 220, 110}, color_variance: {0, 30, 40}, seed: 23
      }
      Appearance: {blend: Additive, stretch: 0.03}
      Burst: {count: 36}
      Forces: {gravity: {0, -3, 0}, drag: 1.5}
    }

    flash {
      Position: {0, 0, 0}
      box.particle.Emitter: {
        max: 4,
        rate: 0,
        shape: EmitterPoint,
        direction: {0, 0, 0},
        speed: {0, 0},
        lifetime: {0.25, 0.25},
        size: {1.4, 1.4},
        opacity: {0.8, 0.8},
        color: {255, 230, 140},
        seed: 24
      }
      Appearance: {blend: Additive}
      Burst: {count: 1}
      Curves: {size: {keys: [{0, 0.5}, {1, 1.4}]}, opacity: {keys: [{0, 1}, {1, 0}]}}
    }
  }
}

// One entity per pool slot. The slot places itself from the item and distance; its model only
// exists while the item is live.
hazards {
  for i in 0..rocks.count() {
    "rock_{i}" {
      Position: {
        rocks[i].x,
        lg_sink(rocks[i].z + distance, clock - rocks[i].born),
        rocks[i].z + distance
      }

      if rocks[i].live {
        LgReefRock model(size: rocks[i].size, seed: rocks[i].spin)
      }
    }
  }

  for i in 0..logs.count() {
    "log_{i}" {
      Position: {
        logs[i].x,
        lg_sink(logs[i].z + distance, clock - logs[i].born) +
          0.04 * sin(clock * 1.6 + logs[i].spin),
        logs[i].z + distance
      }

      if logs[i].live {
        // The foam turns with the log, the way its capsule collides
        turn {
          Rotation: {0, lg_log_yaw(logs[i].spin, logs[i].kind, clock), 0}

          roll {
            Rotation: {0, 0, 0.05 * sin(clock * 1.3 + logs[i].spin)}
            LgDriftLog model(size: logs[i].size, seed: logs[i].spin)
          }

          foam : LgFoam {
            Position: {0, 0.02, 0}
            Scale: {LOG_HALF * logs[i].size + 0.3, 0.35, 0.45}
            Torus: {radius: 1, tube: 0.14, segments: 20, rings: 4}
          }
        }
      }
    }
  }

  for i in 0..nuts.count() {
    "nut_{i}" {
      Position: {
        nuts[i].x,
        lg_sink(nuts[i].z + distance, clock - nuts[i].born) + 0.1 +
          0.07 * sin(clock * 2.2 + nuts[i].spin),
        nuts[i].z + distance
      }

      if nuts[i].live {
        spin {
          Rotation: {0.25 * sin(clock * 1.7 + nuts[i].spin), nuts[i].spin + clock * 1.8, 0}
          LgFloatCoconut model(seed: nuts[i].spin)
        }

        foam : LgFoam {
          Position: {0, -0.1, 0}
          Scale: {1, 0.3, 1}
          Torus: {radius: 0.38, tube: 0.05, segments: 16, rings: 4}
        }
      }
    }
  }
}

async {
  const rng: flecs.script.math.Rng = {seed: SEED_HAZARDS}

  while true {
    await next_frame()

    if game_state == GS_PLAYING {
      // Rows: every row is a wall of hazards with one door for the canoe footprint, in reach of the
      // door before (or of the canoe at the start of a run).
      //
      // Whether the door makes the player steer, how far and which way sets how hard the row is.
      // Rows seeded closer at the start rise in by time (lg_sink).
      while distance >= next_row {
        const zs = 0 - (next_row + SPAWN_AHEAD)
        const gw = FOOT_W + lg_knob(GAP_MARGIN_EASY, GAP_MARGIN_HARD)
        const gh = (gw - FOOT_W) / 2

        // The door before, or the footprint of the canoe as a door that the hull leaves now, so
        // that the first row is entered after FIRST_HAZARD_TIME
        mut px: f64 = canoe_x + FOOT_CX
        mut pw: f64 = FOOT_W
        mut pz: f64 = HULL_HALF_L + HAZ_R_MAX + HAZ_Z_JITTER - distance

        if rows > 0 {
          const pr = (rows - 1) % CORRIDORS
          px = corridors[pr].gx
          pw = corridors[pr].gw
          pz = corridors[pr].z
        }

        const ph = (pw - FOOT_W) / 2

        // The speed the canoe may have by then (every live coconut and this row's line picked
        // up) sets the time to steer, and that how far the footprint can move from anywhere in
        // the door before: the middle of this door can be up to dmax from the one before
        const vb = lg_speed_bound(NUTS_PER_LINE)
        const dmax = max(0, lg_shift_max(pz - zs, vb) + gh - ph)
        const lo = 0 - WATER_HALF + GAP_SHORE + gw / 2
        const hi = WATER_HALF - GAP_SHORE - gw / 2
        mut gx: f64 = clamp(px, lo, hi)

        if rng.f(1) < lg_knob(MOVE_CHANCE_EASY, MOVE_CHANCE_HARD) {
          // A move: a canoe in the middle of the door before steers at least MOVE_MIN, along the
          // last move or back, but away from a shore without room for it
          const dmin = min(dmax, gh + MOVE_MIN)
          const d = dmin + rng.f(1) * (dmax - dmin) * lg_knob(MOVE_SIZE_EASY, MOVE_SIZE_HARD)
          mut md: f64 = last_move

          if md == 0 {
            md = rng.f(1) < 0.5 ? 1.0 : -1.0
          } else if rng.f(1) < lg_knob(REVERSE_EASY, REVERSE_HARD) {
            md = 0 - md
          }

          const room = md > 0 ? hi - px : px - lo

          if room < dmin {
            md = 0 - md
          }

          gx = clamp(px + md * d, lo, hi)
          last_move = md
        } else {
          gx = clamp(px + (rng.f(2) - 1) * min(dmax, gh * 0.5), lo, hi)
        }

        corridors[rows % CORRIDORS].z = zs
        corridors[rows % CORRIDORS].gx = gx
        corridors[rows % CORRIDORS].gw = gw

        // Hazards from one waterline to the other in the walk direction dir, x along the walk.
        // A hazard whose reach would overlap the door moves past it instead, close to it.
        walls = 0
        const dir = rng.f(1) < 0.5 ? 1.0 : -1.0
        const blo = dir > 0 ? gx - gw / 2 : 0 - gx - gw / 2
        const bhi = blo + gw
        const log_chance = lg_knob(LOG_CHANCE_EASY, LOG_CHANCE_HARD)
        mut cx: f64 = 0 - WATER_HALF + HAZ_SHORE
        mut placed: i32 = 0
        mut placed_logs: i32 = 0
        mut past_door: bool = false

        while placed < HAZARDS_PER_ROW {
          const rs = lg_free_rock()
          const ls = lg_free_log()
          const want_log = rng.f(1) < log_chance
          const is_log = ls >= 0 && placed_logs < LOGS_PER_ROW && (want_log || rs < 0)

          // Place fewer hazards rather than skip one for a full pool
          if !is_log && rs < 0 {
            break
          }

          const seed = rng.f(100)
          const size = is_log ? LOG_SIZE_MIN + rng.f(LOG_SIZE_VAR) :
            ROCK_SIZE_MIN + rng.f(ROCK_SIZE_VAR)
          const r = is_log ? lg_log_r(size) : lg_rock_r(size)
          const gap = past_door ? rng.f(HAZ_GAP_DOOR) :
            HAZ_GAP_MIN + rng.f(HAZ_GAP_MAX - HAZ_GAP_MIN)
          const x = cx + gap + r

          if x - r < bhi && x + r > blo {
            cx = bhi
            past_door = true
            continue
          }

          if x + r > WATER_HALF - HAZ_SHORE {
            break
          }

          past_door = false
          const wx = dir * x
          const z = zs + (rng.f(2) - 1) * HAZ_Z_JITTER

          if is_log {
            logs[ls].x = wx
            logs[ls].z = z
            logs[ls].size = size
            logs[ls].spin = seed
            logs[ls].kind = seed > 50 ? 1 : 0
            logs[ls].hit = false
            logs[ls].born = clock
            logs[ls].live = true
            placed_logs += 1
            lg_wall_add(wx - LOG_R, wx + LOG_R)
          } else {
            rocks[rs].x = wx
            rocks[rs].z = z
            rocks[rs].size = size
            rocks[rs].spin = seed
            rocks[rs].kind = 0
            rocks[rs].hit = false
            rocks[rs].born = clock
            rocks[rs].live = true
            lg_wall_add(wx - r, wx + r)
          }

          placed += 1
          cx = x + r
        }

        // Scan the canoe across the river: where both the hull and the float slip through outside
        // the door, a small rock closes the gap, beside the door on the side the canoe sticks out
        // of it, so the door stays clear.
        //
        // Canoe positions in_lo..in_hi hold the footprint in the door, with half a step to spare.
        // The scan narrows the hull and the float by half a step, so a way through narrower than a
        // step is found too.
        const in_lo = gx - gh - FOOT_CX - SCAN_STEP / 2
        const in_hi = gx + gh - FOOT_CX + SCAN_STEP / 2
        const pr = lg_rock_r(ROCK_SIZE_MIN)
        const hw = HULL_HALF_W - SCAN_STEP / 2
        const fw = FLOAT_HALF_W - SCAN_STEP / 2
        mut sx: f64 = CANOE_MIN_X

        while sx <= CANOE_MAX_X {
          if (sx < in_lo || sx > in_hi) && walls < WALL_MAX &&
            lg_wall_open(sx - hw, sx + hw) &&
            lg_wall_open(sx + FLOAT_X - fw, sx + FLOAT_X + fw) {
            const rs = lg_free_rock()

            if rs < 0 {
              break
            }

            const wx = sx > in_hi ? max(sx, gx + gw / 2 + pr) : min(sx + FLOAT_X, gx - gw / 2 - pr)
            rocks[rs].x = wx
            rocks[rs].z = zs + (rng.f(2) - 1) * HAZ_Z_JITTER
            rocks[rs].size = ROCK_SIZE_MIN
            rocks[rs].spin = rng.f(100)
            rocks[rs].kind = 0
            rocks[rs].hit = false
            rocks[rs].born = clock
            rocks[rs].live = true
            lg_wall_add(wx - pr, wx + pr)
          }

          sx += SCAN_STEP
        }

        // A coconut line in front of the row along the hull's way: from the side of the corridor
        // before nearest to this one, into this corridor. A risky line bulges out, but every nut
        // keeps this corridor in reach from the time it passes the canoe.
        if rng.f(1) < NUT_LINE_CHANCE {
          const hx = gx - FOOT_CX + (rng.f(2) - 1) * gh
          const x0 = clamp(hx, px - ph - FOOT_CX, px + ph - FOOT_CX)
          mut bulge: f64 = 0

          if rng.f(1) < lg_knob(NUT_RISK_EASY, NUT_RISK_HARD) {
            bulge = (rng.f(2) - 1) * NUT_RISK_BULGE
          }

          for c in 0..NUTS_PER_LINE {
            const t = c * 1.0 / (NUTS_PER_LINE - 1)
            const dz = NUT_LEAD + (NUTS_PER_LINE - 1 - c) * NUT_SPACING
            const room = REACH_SHARE *
              lg_reach((dz - (HULL_HALF_L + HAZ_R_MAX + HAZ_Z_JITTER)) / vb - REACT_TIME)
            const ease = t * t * (3 - 2 * t)
            const x = clamp(
              clamp(x0 + (hx - x0) * ease + bulge * sin(t * PI),
                gx - gh - FOOT_CX - room, gx + gh - FOOT_CX + room),
              CANOE_MIN_X, CANOE_MAX_X)
            const z = zs + dz
            const s = lg_free_nut()

            if s >= 0 && lg_clear(x, z, NUT_R) {
              nuts[s].x = x
              nuts[s].z = z
              nuts[s].size = 1
              nuts[s].spin = rng.f(100)
              nuts[s].kind = 0
              nuts[s].hit = false
              nuts[s].born = clock
              nuts[s].live = true
            }
          }
        }

        rows += 1
        next_row += speed * lg_knob(ROW_TIME_EASY, ROW_TIME_HARD)
      }

      if invulnerable > 0 {
        invulnerable = max(0, invulnerable - dt)
      }

      for i in 0..rocks.count() {
        if rocks[i].live {
          const wz = rocks[i].z + distance

          if wz > DESPAWN_Z {
            rocks[i].live = false
          } else if game_state == GS_PLAYING && invulnerable <= 0 &&
            lg_touches(rocks[i].x, wz, lg_rock_r(rocks[i].size)) {
            rocks[i].hit = true
            rocks[i].live = false
            lives -= 1
            invulnerable = INVULNERABLE_TIME
            const b = box.particle.burst_at(assets.LgSplash, {rocks[i].x, 0.3, wz}, 1)

            if lives <= 0 {
              game_state = GS_OVER
            }
          }
        }
      }

      for i in 0..logs.count() {
        if logs[i].live {
          const wz = logs[i].z + distance

          if wz > DESPAWN_Z {
            logs[i].live = false
          } else if game_state == GS_PLAYING && invulnerable <= 0 &&
            lg_touches_log(logs[i].x, wz, lg_log_yaw(logs[i].spin, logs[i].kind, clock),
            logs[i].size) {
            logs[i].hit = true
            logs[i].live = false
            lives -= 1
            invulnerable = INVULNERABLE_TIME
            const b = box.particle.burst_at(assets.LgSplash, {logs[i].x, 0.3, wz}, 1)

            if lives <= 0 {
              game_state = GS_OVER
            }
          }
        }
      }

      for i in 0..nuts.count() {
        if nuts[i].live {
          const wz = nuts[i].z + distance

          if wz > DESPAWN_Z {
            nuts[i].live = false
          } else if game_state == GS_PLAYING && lg_touches(nuts[i].x, wz, NUT_R) {
            nuts[i].hit = true
            nuts[i].live = false
            coconuts += 1
            const b = box.particle.burst_at(assets.LgSparkle, {nuts[i].x, 0.5, wz}, 1)
          }
        }
      }

      if game_state == GS_OVER {
        invulnerable = 0
        const b = box.particle.burst_at(assets.LgSplash, {canoe_x, 0.4, CANOE_Z}, 2.6)
        const c = box.particle.burst_at(assets.LgSplash, {canoe_x + FLOAT_X, 0.3, CANOE_Z + 1}, 1.6)
      }
    }
  }
}

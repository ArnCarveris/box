using flecs.script
using flecs.script.math
using box.app
using box.transform
using box.input
using box.material
using box.particle
using state

state {
  // Lean per unit of sideways speed, and how fast the hull rolls toward it
  export const LEAN_PER_VX: f32 = 0.028
  export const LEAN_RATE: f32 = 8
  // Seconds the canoe takes to roll over once the game is over
  export const CAPSIZE_TIME: f32 = 0.8
  // The canoe touches a beach within SHORE_TOUCH of its stop and leaves it SHORE_LEAVE away
  export const SHORE_TOUCH: f32 = 0.06
  export const SHORE_LEAVE: f32 = 0.5
  // Mapping size of the water texture (texture.Mapping of LgWater)
  export const WATER_MAP: f32 = 7

  // The speed the water flows at (0 once the world stops), the render time the scroll runs on
  // and the offset that keeps the waves in place when the flow changes
  export mut water_flow: f32 = START_SPEED
  export mut water_t: f64 = 0
  export mut water_shift: f64 = 0

  lg_actions {
    SteerLeft {
      Action: {description: "Steer left"}
      Binding: {key: A}
      alt { Binding: {key: Left} }
    }

    SteerRight {
      Action: {description: "Steer right"}
      Binding: {key: D}
      alt { Binding: {key: Right} }
    }

    Restart { Action: {description: "Paddle again"}; Binding: {key: R} }
  }

  // Wraps an offset to 0..2, the period of a mirrored texture
  fn wrap2(v: f64) -> f64 {
    v - 2 * floor(v / 2)
  }
}

assets {
  // Wet sand thrown up where the hull or the float runs onto a beach
  prefab LgShoreSplash {
    sand {
      Position: {0, 0, 0}
      box.particle.Emitter: {
        max: 30, rate: 0, shape: EmitterSphere, radius: 0.25,
        direction: {0, 1, 0}, spread: 45, speed: {2, 3.6},
        lifetime: {0.4, 0.8}, size: {0.08, 0.16}, opacity: {0.8, 1},
        color: {214, 190, 140}, color_variance: {16, 14, 10}, seed: 31
      }
      Burst: {count: 22}
      Forces: {gravity: {0, -12, 0}}
    }

    ripple {
      Position: {0, 0, 0}
      box.particle.Emitter: {
        max: 8, rate: 0, shape: EmitterSphere, radius: 0.3,
        direction: {0, 1, 0}, spread: 80, speed: {0.2, 0.5},
        lifetime: {0.6, 1.0}, size: {0.4, 0.7}, opacity: {0.25, 0.4},
        color: {226, 214, 180}, seed: 32
      }
      Burst: {count: 6}
      Curves: {size: {keys: [{0, 0.6}, {1, 1.6}]}, opacity: {keys: [{0, 1}, {1, 0}]}}
    }
  }
}

// U of the world mapping runs along +Z, so a velocity of -flow / size moves the waves toward the
// camera at flow units a second. water_shift cancels the jump a change of the flow causes.
lagoon {
  water {
    texture.Scroll: {velocity: {0 - water_flow / WATER_MAP, 0.03}}
    texture.Transform: {scale_x: 1, scale_y: 1, offset_x: water_shift, offset_y: 0}
    // The WaterWaves travel in the frame of the water, which flows toward the camera (+Z) with
    // the banks and the riverbed
    WaterFlow: {velocity: {0, water_flow}}
  }
}

async {
  mut last: f64 = box.app.Status[box.app.Status].elapsed
  // The beach the canoe touches, 1 right, -1 left, 0 none
  mut on_shore: i32 = 0

  while true {
    await next_frame()
    const now = box.app.Status[box.app.Status].elapsed
    const fixed = App[App].delta_time
    const d = fixed > 0 ? fixed : clamp(now - last, 0.001, 0.1)
    last = now
    dt = d
    clock += d
    // The world time the renderer scrolls the water on
    water_t += box.app.Status[box.app.Status].delta_time

    if game_state == GS_PLAYING {
      const steer = bool_f(state.lg_actions.SteerRight[ActionState].down) -
        bool_f(state.lg_actions.SteerLeft[ActionState].down)
      const rate = steer != 0 ? STEER_ACCEL : STEER_DAMP
      mut vx: f32 = canoe_vx + (steer * STEER_SPEED - canoe_vx) * min(1, d * rate)

      if abs(vx) < 0.001 && steer == 0 {
        vx = 0
      }

      // Toward a beach the sideways speed eases to 0 over SHORE_EASE, so the hull (right) or the
      // float (left) runs up to the waterline and stops there
      if vx > 0 {
        vx = min(vx, STEER_SPEED * max(0, CANOE_MAX_X - canoe_x) / SHORE_EASE)
      }

      if vx < 0 {
        vx = max(vx, 0 - STEER_SPEED * max(0, canoe_x - CANOE_MIN_X) / SHORE_EASE)
      }

      const x = clamp(canoe_x + vx * d, CANOE_MIN_X, CANOE_MAX_X)

      // A puff of sand where the canoe touches a beach, once until it paddles off again
      mut shore: i32 = 0

      if x >= CANOE_MAX_X - SHORE_TOUCH {
        shore = 1
      }

      if x <= CANOE_MIN_X + SHORE_TOUCH {
        shore = -1
      }

      if shore != 0 && shore != on_shore {
        mut sx: f32 = x + HULL_HALF_W
        mut sz: f32 = CANOE_Z - 1.5

        if shore < 0 {
          sx = x + FLOAT_X - FLOAT_HALF_W
          sz = CANOE_Z + 0.6
        }

        const b = box.particle.burst_at(assets.LgShoreSplash, {sx, 0.08, sz}, 1)
        on_shore = shore
      }

      if x < CANOE_MAX_X - SHORE_LEAVE && x > CANOE_MIN_X + SHORE_LEAVE {
        on_shore = 0
      }

      if vx != canoe_vx {
        canoe_vx = vx
      }

      if x != canoe_x {
        canoe_x = x
      }

      const want = 0 - canoe_vx * LEAN_PER_VX

      if abs(want - lean) > 0.0001 {
        lean += (want - lean) * min(1, d * LEAN_RATE)
      }

      // The difficulty only rises; its pace step sets the speed, which eases toward it
      const diff = max(difficulty, lg_diff_at(coconuts, distance))

      if diff != difficulty {
        difficulty = diff
      }

      const p = lg_pace_at(difficulty)

      if p != pace {
        pace = p
      }

      const want_speed = lg_pace_speed(pace)

      if abs(want_speed - speed) > 0.001 {
        speed += (want_speed - speed) * min(1, d * SPEED_EASE)
      } else if speed != want_speed {
        speed = want_speed
      }

      paddle_phase += d * (2.2 + speed * 0.08)
      distance += speed * d
    } else if game_state == GS_OVER {
      if canoe_vx != 0 {
        canoe_vx = 0
      }

      if capsize < 1 {
        capsize = min(1, capsize + d / CAPSIZE_TIME)
      }
    }

    const flow = game_state == GS_PLAYING ? speed : 0

    if flow != water_flow {
      water_shift = wrap2(water_shift + (flow - water_flow) / WATER_MAP * water_t)
      water_flow = flow
    }

    // The canoe and the flotsam bob on the swell as it passes at the speed of the water
    swell_phase += d * SWELL_K * (SWELL_SPEED - water_flow)
    swell_phase -= 2 * PI * floor(swell_phase / (2 * PI))
  }
}

async {
  while true {
    await on.pressed(state.lg_actions.Restart)

    if game_state == GS_OVER {
      reset()
    }
  }
}

using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.layout
using box.text
using box.transition
using box.app
using state
using assets

window {}

state {
  // Seconds of a run the steering hint stays up, and how long the coconut count pops
  export const HINT_TIME: f32 = 6
  export const POP_TIME: f32 = 0.18
  export const LOST_ALPHA: f32 = 0.22

  // Written by the HUD loop only when they change, so the HUD does not rebuild every frame
  export mut hud_hint: bool = true
  export mut hud_pop: bool = false
  // True from the frame after the game is over, so the capsized panel is created clear and fades in
  export mut hud_panel: bool = false
}

assets {
  export const C_HUD_BG: Rgb = {24, 66, 74}
  export const C_HUD_TEXT: Rgb = {255, 246, 226}
  export const C_HUD_SHADE: Rgb = {40, 18, 16}

  // Text over a dark copy of itself, readable over bright water and sky
  template LgShadowText {
    prop text: string = ""
    prop size: f32 = 24
    prop color: Rgb = C_HUD_TEXT
    prop depth: f32 = 2
    Text: {value: text, size: size}
    Rgb: C_HUD_SHADE
    face {
      Position: {0 - depth * 0.5, depth, 0.02}
      Text: {value: text, size: size}
      Rgb: color
    }
  }

  // A coconut seen from its end: brown husk, a lighter patch, three eyes and a leaf
  template LgNutIcon {
    prop size: f32 = 40
    Item: {width: {mode: Fixed, value: size}, height: {mode: Fixed, value: size}}
    Circle: {size * 0.5}
    Rgb: {110, 68, 36}
    Border: {width: 2, color: {54, 30, 14, 255}}
    patch { Position: {size * 0.1, size * 0.1, 0.05}; Circle: {size * 0.3}; Rgb: {146, 96, 54} }
    eye_0 {
      Position: {0 - size * 0.12, 0 - size * 0.02, 0.1}
      Circle: {size * 0.075}
      Rgb: {44, 24, 10}
    }

    eye_1 {
      Position: {size * 0.12, 0 - size * 0.02, 0.1}
      Circle: {size * 0.075}
      Rgb: {44, 24, 10}
    }

    eye_2 { Position: {0, 0 - size * 0.2, 0.1}; Circle: {size * 0.075}; Rgb: {44, 24, 10} }
    shine {
      Position: {0 - size * 0.2, size * 0.22, 0.12}
      Circle: {size * 0.07}
      Rgb: {255, 240, 214}
      Opacity: {0.6}
    }

    leaf {
      Position: {size * 0.26, size * 0.44, 0.15}
      Rotation: {0, 0, 0.6}
      Rect: {size * 0.38, size * 0.14}
      Border: {width: 1.2, radius: size * 0.07, color: {36, 90, 34, 255}}
      Rgb: {96, 178, 72}
    }
  }

  // A hibiscus flower for hull life idx: five petals around a golden heart, faded once lost.
  // It reads lives itself, so it follows the state (a prop is set only once).
  template LgLifeIcon {
    prop size: f32 = 40
    prop idx: i32 = 0
    Item: {width: {mode: Fixed, value: size}, height: {mode: Fixed, value: size}}
    Transition: [Opacity: {duration: 0.4, timing_function: EaseOut}]
    Opacity: {idx < lives ? 1 : LOST_ALPHA}

    for k in 0..5 {
      const a = HALF_PI + k * 1.2566
      "petal_{k}" {
        Position: {size * 0.24 * cos(a), size * 0.24 * sin(a), 0.02}
        Circle: {size * 0.24}
        Rgb: {234, 62, 92}
        Border: {width: 1.4, color: {150, 24, 54, 255}}
      }
    }

    heart { Position: {0, 0, 0.1}; Circle: {size * 0.13}; Rgb: {255, 206, 84} }
    stamen { Position: {size * 0.06, size * 0.07, 0.15}; Circle: {size * 0.05}; Rgb: {200, 30, 40} }
  }

  // A rounded badge in the corners of the screen
  template LgBadge {
    Layout: {direction: Row, spacing: 10, v: Middle, padding: {8, 8, 12, 18}}
    Rect: {1, 1}
    Rgb: C_HUD_BG
    Border: {width: 2.5, radius: 24, color: {255, 210, 136, 255}}
    BoxShadow: {offset_y: -4, blur: 14, color: {0, 0, 0, 120}}
  }
}

lg_hud {
  Scene: {blend_modes: true}

  camera {
    Position: {0, 0, 100}
    Camera: {ortho: true, ortho_scale: 1}
  }

  screen {
    Fill: {surface: window}
    Layout: {}

    LgBadge nuts() {
      Item: {h: Left, v: Top, x: 20, y: -20}
      LgNutIcon icon(size: 40)
      count {
        Text: {value: "{coconuts}", size: 34}
        Rgb: hud_pop ? {255, 212, 84} : C_HUD_TEXT
        Scale: {hud_pop ? 1.3 : 1, hud_pop ? 1.3 : 1, 1}
        Transition: [
          Rgb: {duration: 0.12, timing_function: EaseOut},
          Scale: {duration: 0.12, timing_function: EaseOut}
        ]
      }
    }

    LgBadge lives() {
      Item: {h: Right, v: Top, x: -20, y: -20}

      for i in 0..MAX_LIVES {
        "life_{i}" {
          LgLifeIcon: {size: 40, idx: i}
        }
      }
    }

    hint {
      Item: {h: Center, v: Bottom, y: 24}
      Layout: {direction: Row, padding: {8, 8, 18, 18}}
      Rect: {1, 1}
      Rgb: C_HUD_BG
      Border: {width: 2, radius: 18, color: {255, 210, 136, 255}}
      Transition: [Opacity: {duration: 0.8, timing_function: EaseOut}]
      Opacity: {hud_hint ? 1 : 0}
      LgShadowText label(text: "A / D to steer - grab the coconuts, dodge the reef!", size: 22)
    }

    // The game over panel, above the canoe. It is created clear and fades in once hud_panel is
    // set: a transition with on_add does not animate an entity that is created with the value.
    if game_state == GS_OVER {
      capsized {
        Item: {h: Center, v: Middle, y: 70, width: {mode: Fixed, value: 640}}
        Layout: {direction: Column, h: Center, spacing: 14, padding: {16, 26, 16, 16}}
        Rect: {1, 1}
        Rgb: {212, 84, 66}
        Border: {width: 4, radius: 26, color: {255, 204, 112, 255}}
        BoxShadow: {offset_y: -8, blur: 32, spread: 2, color: {48, 10, 24, 180}}
        Transition: [Opacity: {duration: 0.6, timing_function: EaseOut}]
        Opacity: {hud_panel ? 1 : 0}

        band {
          Item: {width: {mode: Grow}}
          Layout: {direction: Row, h: Center, padding: {12, 10, 0, 0}}
          Rect: {1, 1}
          Rgb: {248, 150, 66}
          Border: {width: 0, radius: 18}
          LgShadowText title(text: "CAPSIZED!", size: 68, color: {255, 244, 196}, depth: 4)
        }

        waves {
          Layout: {direction: Row, spacing: 8}

          for k in 0..11 {
            "wave_{k}" {
              Item: {width: {mode: Fixed, value: 12}, height: {mode: Fixed, value: 12}}
              Circle: {6}
              Rgb: k % 2 == 0 ? {74, 196, 196} : {255, 214, 120}
            }
          }
        }

        result {
          Layout: {direction: Row, spacing: 12, v: Middle}
          LgNutIcon icon(size: 34)

          if coconuts == 1 {
            LgShadowText label(text: "1 coconut gathered", size: 30)
          } else {
            LgShadowText label(text: "{coconuts} coconuts gathered", size: 30)
          }
        }

        LgShadowText prompt(text: "Press R to paddle again", size: 24, color: {255, 222, 150})
      }
    }
  }

  view {
    View: {camera: lg_hud.camera, order: 1, lighting: {enabled: false}, culling: {enabled: false}}
  }
}

async {
  mut last_nuts: i32 = coconuts
  mut pop_t: f32 = 0
  mut was_over: bool = false

  while true {
    await next_frame()
    const show = game_state == GS_PLAYING && clock < HINT_TIME

    if show != hud_hint {
      hud_hint = show
    }

    const over = game_state == GS_OVER
    const panel = over && was_over

    if panel != hud_panel {
      hud_panel = panel
    }

    was_over = over

    if coconuts > last_nuts {
      pop_t = POP_TIME

      if !hud_pop {
        hud_pop = true
      }
    }

    last_nuts = coconuts

    if pop_t > 0 {
      pop_t -= dt

      if pop_t <= 0 && hud_pop {
        hud_pop = false
      }
    }
  }
}

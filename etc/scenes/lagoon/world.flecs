using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.atmosphere
using state
using assets

$ {
  AmbientLight: {sky: {170, 170, 200}, ground: {150, 120, 80}, intensity: 0.35}
}

// Toward the sun: low ahead and to the right of the canoe, a warm late afternoon
const sunX: f32 = 0.5
const sunY: f32 = 0.27
const sunZ: f32 = -1.0

sun {
  Rotation: {asin(sunY / sqrt(sunX * sunX + sunY * sunY + sunZ * sunZ)), atan2(0 - sunX, 0 - sunZ), 0}
  DirectionalLight: {intensity: 2.4}
  Rgb: {255, 230, 200}
  Atmosphere: {
    sun: sun,
    mie: {scale_height: 1.2, anisotropy: 0.8, scattering_scale: 1.0, tint: {255, 236, 214}},
    ground_albedo: {80, 150, 160},
    sun_disk_intensity: 8,
    sun_radius: 0.8
  }
}

// Chase camera: behind and above the canoe, its X follows the canoe by CAM_FOLLOW
camera {
  Position: {canoe_x * CAM_FOLLOW, CAM_HEIGHT, CANOE_Z + CAM_BACK}
  Rotation: {0 - atan2(CAM_HEIGHT - 0.6, CAM_BACK + CAM_LOOK_AHEAD), 0, 0}
  Camera: {fov: CAM_FOV, near_: 0.3, far_: 2500}
}

exposure {
  AutoExposure: {min_log_luma: -16, low_percentile: 0, min_brightness: 0.05, max_brightness: 0.5}
}

fog {
  HeightFog: {density: 0.0012, falloff: 0.025, base_height: 0, max_opacity: 0.4, atmosphere: sun}
}

gtao {
  Gtao: {radius: 0.5, final_value_power: 2}
}

bloom {
  Bloom: {intensity: 0.14, threshold: 1.1, threshold_softness: 0.5}
}

tonemap {
  Tonemap: {auto_exposure: exposure, operator_: TonyMcMapface}
}

main_view {
  View: {
    camera: camera,
    clear: {enabled: true, color: {236, 196, 160, 255}},
    lighting: {enabled: true, reflections: true, atmosphere: true,
      environment: {source: sun, intensity: 0.8, yaw: 0, background: false}},
    shadows: {enabled: true, cascades: 2, resolution: 2048, max_distance: 60},
    culling: {enabled: true, min_dimension_px: 2},
    effects: [{effect: fog}, {effect: gtao}, {effect: sun}, {effect: bloom}, {effect: tonemap}]
  }
}

lagoon {
  // The water and the sand floor under it, wide and long enough to reach the horizon haze
  water : LgWater { Position: {0, 0, -800}; Box: {1600, 0.02, 2400}; NoShadow }
  floor : LgSandWet { Position: {0, -1.8, -800}; Box: {1600, 0.2, 2400}; NoShadow }

  // A distant volcano island up the lagoon, softened by the haze
  volcano {
    Position: {-110, 0, -1250}
    shore : LgSandDry { Position: {0, 0.6, 0}; Scale: {1, 0.06, 0.7}; Sphere: {radius: 260, segments: 32, smooth: true}; NoShadow }
    skirt : LgVolcanoGreen { Position: {0, 34, 0}; Frustum: {length: 70, radius_bottom: 230, radius_top: 120, segments: 32, smooth: true}; NoShadow }
    cone : LgVolcano { Position: {0, 120, 0}; Frustum: {length: 104, radius_bottom: 122, radius_top: 34, segments: 32, smooth: true}; NoShadow }
    crater : LgVolcano { Position: {0, 171, 0}; Frustum: {length: 4, radius_bottom: 34, radius_top: 28, segments: 24}; Rgb: {72, 64, 66}; NoShadow }
    smoke {
      for i in 0..4 {
        "puff_{i}" { Position: {i * 9, 186 + i * 16, i * 3}; Sphere: {radius: 18 + i * 6, segments: 12, smooth: true}; Rgb: {214, 200, 196}; PbrMaterial: {roughness: 1}; Opacity: {0.35 - i * 0.06}; BlendMode: AlphaBlend; NoShadow }
      }
    }
  }
  islet {
    Position: {260, 0, -900}
    hill : LgVolcanoGreen { Position: {0, 0, 0}; Scale: {1, 0.35, 0.8}; Sphere: {radius: 90, segments: 24, smooth: true}; NoShadow }
  }
}

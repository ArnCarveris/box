using flecs.script
using flecs.script.math

state {
  export const HALF_PI: f32 = 1.5707963

  // The channel the canoe paddles in, X in -CHANNEL_HALF..CHANNEL_HALF
  export const CHANNEL_HALF: f32 = 6
  export const CANOE_Z: f32 = 0
  export const CANOE_HALF_WIDTH: f32 = 0.9

  // Chase camera: behind (+Z) and above the canoe, looking up the lagoon (-Z)
  export const CAM_BACK: f32 = 12
  export const CAM_HEIGHT: f32 = 5
  export const CAM_LOOK_AHEAD: f32 = 11
  export const CAM_FOLLOW: f32 = 0.6
  export const CAM_FOV: f32 = 55

  export const START_SPEED: f32 = 9
  export const SPEED_STEP: f32 = 1.5
  export const MAX_SPEED: f32 = 26
  export const COCONUTS_PER_STEP: i32 = 5
  export const MAX_LIVES: i32 = 3
  export const INVULNERABLE_TIME: f32 = 1.6
  export const SEED: i32 = 4242

  export const ROCKS: i32 = 12
  export const LOGS: i32 = 6
  export const COCONUTS: i32 = 16

  export const GS_PLAYING: i32 = 1
  export const GS_OVER: i32 = 2

  // An item of a pool: live items sit at x, z (z in the scrolled world), kind and spin pick
  // their look, hit marks an item that was already struck or collected
  struct LgItem(x: f32, z: f32, size: f32, spin: f32, kind: i32, live: bool, hit: bool)

  fn fract(v: f64) -> f64 {
    v - floor(v)
  }

  fn hash(i: f64) -> f64 {
    fract(sin(i * 12.9898 + 4.1414) * 43758.5453)
  }

  fn bool_f(b: bool) -> f32 {
    b ? 1 : 0
  }

  export mut game_state: i32 = GS_PLAYING
  export mut clock: f64 = 0
  export mut dt: f32 = 0.016
  export mut distance: f64 = 0
  export mut speed: f32 = START_SPEED
  export mut canoe_x: f32 = 0
  export mut canoe_vx: f32 = 0
  export mut lean: f32 = 0
  export mut paddle_phase: f32 = 0
  export mut lives: i32 = MAX_LIVES
  export mut coconuts: i32 = 0
  export mut invulnerable: f32 = 0
  export mut capsize: f32 = 0

  export mut rocks: LgItem[12] = {}
  export mut logs: LgItem[6] = {}
  export mut nuts: LgItem[16] = {}

  // Puts every variable back to its start value
  fn reset() {
    game_state = GS_PLAYING
    clock = 0
    distance = 0
    speed = START_SPEED
    canoe_x = 0
    canoe_vx = 0
    lean = 0
    paddle_phase = 0
    lives = MAX_LIVES
    coconuts = 0
    invulnerable = 0
    capsize = 0
    for i in 0..ROCKS {
      rocks[i].live = false
      rocks[i].hit = false
    }
    for i in 0..LOGS {
      logs[i].live = false
      logs[i].hit = false
    }
    for i in 0..COCONUTS {
      nuts[i].live = false
      nuts[i].hit = false
    }
  }
}

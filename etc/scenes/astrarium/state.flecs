  fn band_stars(band: i32) -> i32 {
    mut n: i32 = 0

    for (i, s) in atlas_stars {
      if s.band == band {
        n += 1
      }
    }

    n
  }

  fn band_awake(band: i32) -> i32 {
    mut n: i32 = 0

    for (i, s) in atlas_stars {
      if s.awake && s.band == band {
        n += 1
      }
    }

    n
  }

  fn stat_awake(stat: i32) -> i32 {
    mut n: i32 = 0

    for (i, s) in atlas_stars {
      if s.awake && s.stat == stat {
        n += s.amount
      }
    }

    n
  }

  export mut atlas_awake: bool[] = atlas_stars.map((s) -> { s.awake })

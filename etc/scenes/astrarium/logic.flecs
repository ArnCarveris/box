using flecs.script
using flecs.script.math
using box.app
using box.surface

async {
  while true {
    if window.has(SurfaceStatus) {
      const s = window[SurfaceStatus]
      if s.point_width > 0 && s.point_height > 0 {
        if s.point_width != screen_w || s.point_height != screen_h {
          screen_w = s.point_width
          screen_h = s.point_height
        }
      }
    }
    await next_frame()
  }
}

async {
  await delay(0.6)
  title_go = true
}

async {
  while true {
    await delay(0.25)
    hero_mp = min(hero_mp_max, hero_mp + (2.6 + stat_aether * 0.05) * 0.25)
    hero_hp = aegis_on ? min(hero_hp_max, hero_hp + 1.6) : max(hero_hp_max * 0.22, hero_hp - 0.22)
    check_afford()
  }
}

async {
  while true {
    const e = await BannerShown
    await delay(e.until - AppStatus[AppStatus].elapsed)
    if e.serial == banner_serial {
      banner_on = false
    }
  }
}

async {
  while true {
    const e = await AegisRaised
    await delay(e.until - AppStatus[AppStatus].elapsed)
    if e.serial == aegis_serial {
      aegis_on = false
    }
  }
}

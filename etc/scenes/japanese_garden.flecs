using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers

const cedar: Rgb = {109, 65, 53}
const vermilion: Rgb = {191, 62, 48}
const slate: Rgb = {65, 83, 101}
const stone: Rgb = {176, 183, 172}
const moss: Rgb = {99, 139, 104}
const paper: Rgb = {255, 225, 169}
const blossom: Rgb = {247, 181, 204}

@tree Parent
template GardenRock {
  prop size: f32 = 1

  body {
    Position: {0, size * 0.24, 0}
    Rotation: {0.12, 0.4, 0.18}
    Scale: {1.2, 0.65, 0.85}
    IcoSphere: {radius: size * 0.6, segments: 1}
    Rgb: stone
    PbrMaterial: {roughness: 0.95}
  }
  moss_cap {
    Position: {-size * 0.08, size * 0.48, 0}
    Scale: {1, 0.24, 0.7}
    Sphere: {radius: size * 0.42, segments: 12, smooth: true}
    Rgb: moss
  }
}

@tree Parent
template StoneLantern {
  {
    Position: {0, 0.12, 0}
    RoundedBox: {0.8, 0.24, 0.8, 0.08}
    Rgb: stone
  }
  stem {
    Position: {0, 0.51, 0}
    Frustum: {radius_bottom: 0.22, radius_top: 0.16, length: 0.58, segments: 8}
    Rgb: stone
  }
  sill {
    Position: {0, 0.83, 0}
    Box: {0.67, 0.14, 0.67}
    Rgb: stone
  }
  glow {
    Position: {0, 1.12, 0}
    Box: {0.41, 0.46, 0.41}
    Rgb: paper
    Emissive: {strength: 9, color: {255, 192, 103}}
  }
  for x in 0..2 {
    for z in 0..2 {
      {
        Position: {(x - 0.5) * 0.51, 1.12, (z - 0.5) * 0.51}
        Box: {0.09, 0.53, 0.09}
        Rgb: stone
      }
    }
  }
  roof {
    Position: {0, 1.49, 0}
    Rotation: {0, math.PI / 4, 0}
    Frustum: {radius_bottom: 0.69, radius_top: 0.22, length: 0.3, segments: 4}
    Rgb: slate
  }
  finial {
    Position: {0, 1.74, 0}
    Sphere: {radius: 0.13, segments: 12, smooth: true}
    Rgb: stone
  }
}

@tree Parent
template PaperLantern {
  prop tint: Rgb = {255, 197, 133}

  cord {
    Position: {0, 0.43, 0}
    Cylinder: {radius: 0.015, length: 0.4, segments: 6}
    Rgb: cedar
  }
  shade {
    Scale: {1, 1.18, 1}
    Sphere: {radius: 0.29, segments: 16, smooth: true}
    Rgb: tint
    Emissive: {strength: 7, color: tint}
  }
  for i in 0..5 {
    {
      Position: {0, (i - 2) * 0.115, 0}
      Torus: {radius: 0.29 * math.sqrt(1 - (i - 2) * (i - 2) * 0.11), tube: 0.012, segments: 16, rings: 4}
      Rgb: {161, 96, 64}
    }
  }
  for i in 0..2 {
    {
      Position: {0, (i - 0.5) * 0.65, 0}
      Cylinder: {radius: 0.105, length: 0.055, segments: 12}
      Rgb: cedar
    }
  }
}

@tree Parent
template TreeLimb {
  prop ax: f32 = 0
  prop ay: f32 = 0
  prop az: f32 = 0
  prop bx: f32 = 0
  prop by: f32 = 1
  prop bz: f32 = 0
  prop base: f32 = 0.1
  prop tip: f32 = 0.05
  prop tint: Rgb = {119, 85, 74}
  prop markings: bool = false

  const dx = bx - ax
  const dy = by - ay
  const dz = bz - az
  const length = math.sqrt(dx * dx + dy * dy + dz * dz)

  Position: {(ax + bx) / 2, (ay + by) / 2, (az + bz) / 2}
  Rotation: {math.acos(dy / length), math.atan2(dx, dz), 0}
  Frustum: {radius_bottom: base, radius_top: tip, length: length, segments: 10, smooth: true}
  Rgb: tint
  PbrMaterial: {roughness: 0.95}

  if markings {
    for i in 0..8 {
      const t = 0.12 + i * 0.105
      const radius = base + (tip - base) * t
      const angle = i * 2.4
      {
        Position: {math.sin(angle) * radius, (t - 0.5) * length, math.cos(angle) * radius}
        Rotation: {0, angle, 0.06 * math.sin(i)}
        Box: {radius * 0.75, 0.012, 0.008}
        Rgb: {151, 112, 95}
      }
    }
  }
}


template CoveredWalk {
  prop bays: i32 = 4
  prop bay_length: f32 = 2.27

  for bay in 0..bays {
    {
      Position: {0, 0, bay * bay_length}
      for i in 0..10 {
        {
          Position: {0, 0.26, (i - 4.5) * bay_length / 10}
          Box: {2.05, 0.12, bay_length / 10 - 0.015}
          Rgb: {155, 107, 77}
        }
      }
      for side in 0..2 {
        {
          Position: {(side - 0.5) * 1.82, 1.4, -bay_length / 2}
          Box: {0.13, 2.8, 0.13}
          Rgb: vermilion
        }
        {
          Position: {(side - 0.5) * 1.82, 0.65, 0}
          Box: {0.08, 0.09, bay_length}
          Rgb: vermilion
        }
        for slat in 0..6 {
          {
            Position: {(side - 0.5) * 1.82, 0.47, (slat - 2.5) * bay_length / 6}
            Box: {0.055, 0.35, 0.055}
            Rgb: cedar
          }
        }
        {
          Position: {(side - 0.5) * 1.15, 2.85, 0}
          Rotation: {0, 0, (side - 0.5) * -0.6}
          Box: {1.4, 0.12, bay_length - 0.015}
          Rgb: slate
        }
      }
      crossbeam {
        Position: {0, 2.65, -bay_length / 2}
        Box: {2.3, 0.15, 0.15}
        Rgb: cedar
      }
      PaperLantern() { Position: {0, 2.12, 0} }
    }
  }
  for side in 0..2 {
    {
      Position: {(side - 0.5) * 1.82, 1.4, bays * bay_length - bay_length / 2}
      Box: {0.13, 2.8, 0.13}
      Rgb: vermilion
    }
  }
}


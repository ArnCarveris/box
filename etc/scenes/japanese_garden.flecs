@tree Parent
template BlossomSpray {
  prop phase: f32 = 0
  prop blush: i32 = 0

  for i in 0..16 {
    const angle = i * 2.4 + phase
    const reach = 0.07 + i * 0.025
    const size = 1.5 + i % 3 * 0.18
    SakuraFlower(tint: {242 + i % 3 * 6, 171 + i % 3 * 18 + blush, 197 + i % 3 * 13 + blush}) {
      Position: {math.cos(angle) * reach, 0.08 + math.sin(i * 1.7 + phase) * 0.14, math.sin(angle) * reach}
      Rotation: {0.5 + 0.55 * math.sin(angle * 1.3), angle, 0.5 * math.cos(i * 2.3)}
      Scale: {size, size, size}
    }
  }
  for i in 0..3 {
    const angle = phase + i * 2.1
    GardenLeaf(tint: {113 + i * 10, 142 + i * 7, 100 + i * 5}) {
      Position: {math.cos(angle) * 0.19, 0.04, math.sin(angle) * 0.19}
      Rotation: {0.3, math.PI / 2 - angle, -0.2}
      Scale: {0.8, 1, 0.85}
    }
  }
}

@tree Parent
template CherryTree {
  prop variant: i32 = 0

  const phase = variant * 0.43
  const reach = 1 + math.sin(variant * 1.7) * 0.08

  for i in 0..6 {
    const angle = i * 1.047 + phase
    TreeLimb(ax: math.cos(angle) * 0.1, ay: 0.18, az: math.sin(angle) * 0.1,
      bx: math.cos(angle) * 0.47, by: 0.025, bz: math.sin(angle) * 0.47,
      base: 0.1, tip: 0.018)
  }
  TreeLimb trunk_base(ax: 0, ay: 0.04, az: 0, bx: -0.12, by: 0.72, bz: 0.04,
    base: 0.235, tip: 0.17, markings: true)
  TreeLimb trunk_bend(ax: -0.12, ay: 0.69, az: 0.04, bx: 0.05, by: 1.35, bz: 0.09,
    base: 0.175, tip: 0.125, markings: true)
  TreeLimb trunk_fork(ax: 0.05, ay: 1.32, az: 0.09, bx: 0.13, by: 1.98, bz: -0.03,
    base: 0.13, tip: 0.085, markings: true)
  TreeLimb leader(ax: 0.13, ay: 1.94, az: -0.03, bx: 0, by: 2.65, bz: 0.1,
    base: 0.09, tip: 0.025)

  for i in 0..6 {
    const angle = i * 2.4 + phase
    const shoulder_x = 0.08 + math.cos(angle) * 0.62
    const shoulder_y = 1.93 + math.sin(i * 1.7 + phase) * 0.18 + i * 0.055
    const shoulder_z = math.sin(angle) * 0.62
    const elbow_x = 0.08 + math.cos(angle + 0.12) * 1.12 * reach
    const elbow_y = 2.45 + math.sin(i * 1.7 + phase) * 0.22 + i * 0.055
    const elbow_z = math.sin(angle + 0.12) * 1.05 * reach
    TreeLimb(ax: 0.1, ay: 1.5 + i * 0.085, az: 0.03,
      bx: shoulder_x, by: shoulder_y, bz: shoulder_z, base: 0.095, tip: 0.063, markings: true)
    TreeLimb(ax: shoulder_x, ay: shoulder_y, az: shoulder_z,
      bx: elbow_x, by: elbow_y, bz: elbow_z, base: 0.066, tip: 0.038)
    for j in 0..3 {
      const twig_angle = angle + (j - 1) * 0.5
      const tip_x = elbow_x + math.cos(twig_angle) * (0.36 + j * 0.08)
      const tip_y = elbow_y + 0.27 + math.sin(j * 2.2 + i) * 0.15
      const tip_z = elbow_z + math.sin(twig_angle) * (0.36 + j * 0.08)
      TreeLimb(ax: elbow_x, ay: elbow_y, az: elbow_z,
        bx: tip_x, by: tip_y, bz: tip_z, base: 0.036 - j * 0.005, tip: 0.009)
      BlossomSpray(phase: angle + j * 1.7, blush: variant % 3 * 5) {
        Position: {tip_x, tip_y, tip_z}
        Rotation: {0.1 * math.sin(i + j), twig_angle, 0.08 * math.cos(i)}
        Scale: {0.9 + j * 0.06, 1, 0.9 + j * 0.06}
      }
    }
    TreeLimb(ax: 0, ay: 2.58, az: 0.1,
      bx: math.cos(angle) * 0.46, by: 2.76 + i % 3 * 0.2, bz: math.sin(angle) * 0.46,
      base: 0.026, tip: 0.006)
    BlossomSpray(phase: angle, blush: variant % 3 * 5) {
      Position: {math.cos(angle) * 0.46, 2.76 + i % 3 * 0.2, math.sin(angle) * 0.46}
      Scale: {0.85, 0.85, 0.85}
    }
  }

  for i in 0..32 {
    const angle = i * 2.4 + phase
    {
      Position: {math.cos(angle) * (0.25 + i * 0.042), 0.018, math.sin(angle) * (0.25 + i * 0.042)}
      Rotation: {0, angle, 0}
      Scale: {1, 0.16, 0.65}
      Sphere: {radius: 0.045, segments: 6, smooth: true}
      Rgb: {250, 199 + i % 3 * 8, 213 + i % 3 * 6}
    }
  }
}

@tree Parent
template Bamboo {
  prop height: f32 = 2.6
  prop phase: f32 = 0

  for i in 0..7 {
    const t0 = i / 7.0
    const t1 = (i + 1) / 7.0
    const seam = t1 - 0.1 / height
    const collar = t1 - 0.075 / height
    const rim = t1 - 0.02 / height
    TreeLimb(ax: t0 * t0 * 0.16, ay: height * t0, az: 0,
      bx: seam * seam * 0.16, by: height * seam, bz: 0,
      base: 0.082 - t0 * 0.032, tip: 0.082 - seam * 0.032,
      tint: {111 + i % 2 * 22, 159 + i % 2 * 15, 78 + i % 2 * 13})
    TreeLimb(ax: seam * seam * 0.16, ay: height * seam, az: 0,
      bx: collar * collar * 0.16, by: height * collar, bz: 0,
      base: 0.082 - seam * 0.032, tip: 0.082 - collar * 0.032,
      tint: {58, 93, 51})
    TreeLimb(ax: collar * collar * 0.16, ay: height * collar, az: 0,
      bx: rim * rim * 0.16, by: height * rim, bz: 0,
      base: 0.097 - collar * 0.032, tip: 0.097 - rim * 0.032,
      tint: {199, 211, 144})
    TreeLimb(ax: rim * rim * 0.16, ay: height * rim, az: 0,
      bx: t1 * t1 * 0.16, by: height * t1, bz: 0,
      base: 0.097 - rim * 0.032, tip: 0.082 - t1 * 0.032,
      tint: {174, 190, 119})
  }
  for i in 0..4 {
    const t = (i + 3) / 7.0
    const angle = i * 2.4 + phase
    const x = t * t * 0.16
    const y = height * t
    TreeLimb(ax: x, ay: y, az: 0,
      bx: x + math.cos(angle) * 0.48, by: y + 0.18, bz: math.sin(angle) * 0.48,
      base: 0.017, tip: 0.004, tint: {127, 155, 93})
    for j in 0..4 {
      const along = 0.13 + j * 0.1
      GardenLeaf(tint: {95 + j % 3 * 12, 139 + j % 3 * 10, 92 + j % 2 * 14}) {
        Position: {x + math.cos(angle) * along, y + along * 0.375, math.sin(angle) * along}
        Rotation: {0.25 + j * 0.12, math.PI / 2 - angle + (j % 2 - 0.5) * 1.35, 0}
        Scale: {0.65, 1, 1.3 + j % 2 * 0.3}
      }
    }
  }
  TreeLimb(ax: 0.16, ay: height, az: 0, bx: 0.2, by: height + 0.18, bz: 0.03,
    base: 0.05, tip: 0.006, tint: {126, 159, 103})
  for i in 0..2 {
    GardenLeaf(tint: {137, 168, 110}) {
      Position: {0.18, height + 0.09, 0.015}
      Rotation: {-0.65, phase + i * 2.6, 0}
      Scale: {0.5, 1, 0.95}
    }
  }
}


  const wall: Rgb = walls[variant]
  const roof_color: Rgb = roofs[variant]
  const accent: Rgb = accents[variant]
  const timber: Rgb = timbers[variant]
  const panel_width = 0.8 + variant % 2 * 0.35
  const panes = 3 + variant % 3
  foundation {
    Position: {0, 0.17, 0}
    RoundedBox: {4.6, 0.34, 3.3, 0.09}

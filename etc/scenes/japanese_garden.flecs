  const accents4: Rgb = {137, 116, 153}
  const accents5: Rgb = {173, 126, 89}
  const accents6: Rgb = {165, 129, 99}
  const accents7: Rgb = {124, 151, 117}
  const accents = [accents0, accents1, accents2, accents3, accents4, accents5, accents6, accents7]
  const timbers0: Rgb = {109, 65, 53}

          Position: {-2.6 + i * 0.225, 2.72, 0.1 + (side - 0.5) * 4.4}
          Rotation: {math.PI / 2, 0, 0}
          Cylinder: {radius: 0.055, length: 0.2, segments: 6}
          Rgb: {85, 105, 122}
        }
      }
    }
    for side in 0..2 {
      for row in 0..5 {
        const t = (row + 0.2) / 5.0
        const rx = 2.696 - t * 2.077
        const rz = 2.157 - t * 1.662
        {
          Position: {0, 2.65 + t * 0.95, 0.1 + (side - 0.5) * 2 * rz}
          Rotation: {(side - 0.5) * 1.038, 0, 0}
          Box: {rx * 2, 0.05, 0.1}
          Rgb: {69, 87, 106}
        }
        {
          Position: {(side - 0.5) * 2 * rx, 2.65 + t * 0.95, 0.1}
          Rotation: {0, 0, -(side - 0.5) * 0.858}
          Box: {0.1, 0.05, rz * 2}
          Rgb: {69, 87, 106}
        }
      }
      for rib in 0..17 {
        const u = (rib - 8) / 8.0
        const t = math.min(1, (2.696 - math.abs(u * 2.65)) / 2.077)
        TreeLimb(ax: u * 2.65, ay: 2.69, az: 0.1 + (side - 0.5) * 4.31,
          bx: u * 2.65, by: 2.69 + t * 0.9, bz: 0.1 + (side - 0.5) * 2 * (2.157 - t * 1.662),
          base: 0.035, tip: 0.028, tint: {85, 105, 122})
      }
      for rib in 0..11 {
        const u = (rib - 5) / 5.0
        const t = math.min(1, (2.157 - math.abs(u * 2.1)) / 1.662)
        TreeLimb(ax: (side - 0.5) * 5.39, ay: 2.69, az: 0.1 + u * 2.1,
          bx: (side - 0.5) * 2 * (2.696 - t * 2.077), by: 2.69 + t * 0.9, bz: 0.1 + u * 2.1,
          base: 0.035, tip: 0.028, tint: {85, 105, 122})
      }
    }
    for x in 0..2 {
      for z in 0..2 {
        TreeLimb(ax: (x - 0.5) * 5.39, ay: 2.73, az: 0.1 + (z - 0.5) * 4.31,
          bx: (x - 0.5) * 1.24, by: 3.62, bz: 0.1 + (z - 0.5) * 0.99,
          base: 0.075, tip: 0.06, tint: {99, 119, 131})

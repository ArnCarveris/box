include japanese_garden/materials
include japanese_garden/paths
include japanese_garden/covered_walk
include japanese_garden/tea_house
include japanese_garden/stone_lantern
include japanese_garden/bed
include japanese_garden/water_basin
include japanese_garden/bench
include japanese_garden/stone_pagoda
include japanese_garden/flower_bush
include japanese_garden/rock
include japanese_garden/cherry_tree
include japanese_garden/bamboo
include japanese_garden/torii_gate
include japanese_garden/wall
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.movement

window {
  Surface: {width: 1440, height: 960, vsync: true}
}

contact_shadows {
  Gtao: {radius: 0.5, final_value_power: 2}
}

lantern_bloom {
  Bloom: {intensity: 0.18, threshold: 1.2}
}

tonemap {
  Tonemap: {}
}

smaa {
  Smaa: {}
}

japanese_garden {
  Scene: {}
  LightBake: {probe_spacing: 1, bounds_padding: 0.3, bounces: 1, capture_size: 64, budget_ms: 8}
  ReflectionBake: {resolution: 128, budget_ms: 2, scene_probe: true, scene_probe_height: 2.6}
  AmbientLight: {sky: {130, 155, 207}, ground: {66, 73, 107}, intensity: 0.28}

  orbit {
    Position: {0, 0, 0}
    Rotation: {0, 0, 0}
    // AngularVelocity: {0, 0.15, 0}

    camera {
      Position: {-19.13, 11.83, 16.21}
      Rotation: {-0.4408, -0.8679, 0}
      Camera: {fov: 40, near_: 0.1, far_: 150}
      CameraController: {}
    }
  }

  predawn {
    Rotation: {0.18, -2.3, 0}
    DirectionalLight: {intensity: 0.28 * math.PI}
    Rgb: {155, 179, 236}
  }

  island {
    Position: {0, -0.43, 0}
    RoundedBox: {32, 0.85, 28, 0.4}
    Rgb: {83, 91, 103}
    PbrMaterial: {roughness: 0.9}
  }

  garden_floor {
    Position: {0, -0.035, 0}
    RoundedBox: {31.7, 0.16, 27.7, 0.35}
    Rgb: {144, 164, 134}
    PbrMaterial: {roughness: 0.95}
  }

  GardenPaths paths() { Position: {} }
  east_walk {
    Position: {8.05, 0.04, -4.69}
    CoveredWalk: {bays: 5}
  }

  for i in 0..3 {
    TeaHouse(variant: i + 1) {
      Position: {-10.6 + i * 7.05, 0.08, -10.25}
    }
    StoneLantern() {
      Position: {-13.1 + i * 7.05, 0.08, -8.05}
      Rotation: {0, -0.4, 0}
    }
    GardenBed(length: 4.8, flowers: 5) {
      Position: {-10.6 + i * 7.05, 0.05, -12.4}
    }
  }

  for i in 0..2 {
    TeaHouse(variant: i + 4) {
      Position: {-11.3, 0.08, -2.8 + i * 6.7}
      Rotation: {0, math.PI / 2, 0}
    }
    WaterBasin() { Position: {-9, 0.08, -4.5 + i * 6.7} }
    StoneLantern() { Position: {-8.8, 0.08, -0.6 + i * 6.7} }
    GardenBed(length: 4.9, flowers: 5, tint: {239, 174, 191}) {
      Position: {-14.25, 0.05, -2.8 + i * 6.7}
      Rotation: {0, math.PI / 2, 0}
    }
    TeaHouse(variant: i + 6, scale: 0.76) {
      Position: {3.4 + i * 6.65, 0.08, 10.2}
      Rotation: {0, math.PI, 0}
    }
    GardenBench() { Position: {0.6 + i * 6.65, 0.08, 11.4} }
    StoneLantern() { Position: {1.1 + i * 6.65, 0.08, 9.1} }
  }

  pagoda_court {
    Position: {11.5, 0.08, -9.7}
    paving {
      Position: {0, 0.04, -0.425}
      RoundedBox: {5.6, 0.12, 4.65, 0.15}
      Rgb: {190, 190, 173}
    }
    StonePagoda() { Position: {0, 0.08, -0.2} }
    for side in 0..2 {
      StoneLantern() { Position: {(side - 0.5) * 4.3, 0.1, 1.3} }
      FlowerBush(tint: {240, 178, 195}) { Position: {(side - 0.5) * 4.4, 0.1, -1.9} }
    }
  }

  zen_court {
    Position: {-11, 0.08, 9.9}
    sand {
      Position: {0, 0.04, 0}
      RoundedBox: {5.5, 0.12, 4.6, 0.3}
      Rgb: {223, 214, 188}
    }
    for i in 0..18 {
      {
        Position: {-2.45 + i * 0.29, 0.11, 0}
        Box: {0.018, 0.012, 4.1}
        Rgb: {178, 183, 165}
      }
    }
    GardenRock(size: 1.7) { Position: {-0.7, 0.12, -0.3} }
    GardenRock(size: 1.1) { Position: {0.3, 0.12, 0.2} }
    GardenRock(size: 0.65) { Position: {-0.1, 0.12, 1} }
    StoneLantern() { Position: {-2.05, 0.14, 1.9} }
    GardenBench() { Position: {0.75, 0.08, 2.8} }
    GardenBed(length: 4.2, flowers: 5) {
      Position: {-3.25, 0.04, 0}
      Rotation: {0, math.PI / 2, 0}
    }
  }

  east_grove {
    Position: {12.15, 0.07, 0.2}
    CherryTree(variant: 0) {
      Position: {0, 0, -2.9}
      Scale: {0.85, 0.85, 0.85}
    }
    WaterBasin() { Position: {-0.2, 0, 0.4} }
    StoneLantern() { Position: {-1.65, 0, 0.8} }
    GardenBench() { Position: {0, 0, 2.8} }
    GardenRock(size: 1) { Position: {1.4, 0, -0.4} }
    for i in 0..16 {
      Bamboo(height: 2.6 + math.sin(i * 2.4) * 0.6, phase: i * 0.71) {
        Position: {1.8 + math.sin(i * 1.9) * 0.55, 0, -4.5 + i * 0.56}
        Rotation: {0, 0, math.sin(i * 1.2) * 0.08}
      }
    }
    for i in 0..7 {
      {
        Position: {-0.8 + math.sin(i * 0.9) * 0.5, 0.11, -4 + i * 1.15}
        Rotation: {0, i * 1.2, 0}
        Cylinder: {radius: 0.37, length: 0.12, segments: 7}
        Rgb: GardenStone
      }
    }
    GardenBed(length: 4, flowers: 5, tint: {236, 194, 141}) {
      Position: {0.2, 0, 4.2}
    }
  }

  for i in 0..3 {
    ToriiGate() {
      Position: {-3.1, 0.1, 7.1 + i * 2.4}
      Scale: {1, 1 + i * 0.07, 1}
    }
    StoneLantern() {
      Position: {-4.85, 0.08, 7.8 + i * 2.35}
    }
    FlowerBush(tint: {240, 178, 195}) { Position: {-1.55, 0.08, 7.6 + i * 2.25} }
  }

  for i in 0..4 {
    GardenWall(length: 7.1) { Position: {-11.1 + i * 7.4, 0.04, -13.25} }
    for side in 0..2 {
      GardenWall(length: 6.25) {
        Position: {(side - 0.5) * 30.6, 0.04, -9.8 + i * 6.5}
        Rotation: {0, math.PI / 2, 0}
      }
    }
  }

  GardenWall(length: 8.5) { Position: {-10.3, 0.04, 13.3} }
  GardenWall(length: 6.5) { Position: {2.4, 0.04, 13.3} }
  GardenWall(length: 8.1) { Position: {10, 0.04, 13.3} }

  CherryTree(variant: 1) {
    Position: {-6.2, 0.08, 8.9}
    Scale: {0.65, 0.65, 0.65}
  }
  CherryTree(variant: 2) {
    Position: {-0.2, 0.08, 10.8}
    Scale: {0.65, 0.65, 0.65}
  }
  CherryTree(variant: 3) {
    Position: {13.4, 0.08, 7.5}
    Scale: {0.7, 0.7, 0.7}
  }
  CherryTree(variant: 4) {
    Position: {-6.9, 0.08, -10.2}
    Scale: {0.65, 0.65, 0.65}
  }
  CherryTree(variant: 5) {
    Position: {0, 0.08, -10.2}
    Scale: {0.65, 0.65, 0.65}
  }
  GardenBed(length: 5.2, flowers: 6) { Position: {3.5, 0.07, 4.7} }
  GardenBed(length: 3.2, flowers: 4, tint: {240, 178, 195}) {
    Position: {-5.5, 0.07, -4.7}
    Rotation: {0, math.PI / 2, 0}
  }
  GardenBed(length: 4.5, flowers: 5) { Position: {10.9, 0.07, 12.4} }
  GardenBed(length: 4.5, flowers: 5, tint: {240, 178, 195}) { Position: {3.7, 0.07, 12.4} }
  GardenBench() {
    Position: {0.5, 0.08, 5.5}
    Rotation: {0, math.PI, 0}
  }
  WaterBasin() { Position: {-5.6, 0.08, 0.2} }

  gravel {
    Position: {-3.35, 0.06, 2.3}
    RoundedBox: {6.4, 0.12, 6.3, 0.7, 8}
    Rgb: {211, 208, 185}
    PbrMaterial: {roughness: 1}
  }

  for i in 0..19 {
    {
      Position: {-6.2 + i * 0.31, 0.128, 2.8}
      Box: {0.025, 0.012, 4.6}
      Rgb: {174, 180, 161}
    }
  }

  for i in 0..9 {
    {
      Position: {-2.8 + math.sin(i * 0.7) * 0.42, 0.19, 5 - i * 0.77}
      Rotation: {0, i * 0.6, 0}
      Cylinder: {radius: 0.43, length: 0.14, segments: 7}
      Rgb: GardenStone
    }
  }

  pond_bank {
    Position: {2.7, 0.075, 1.4}
    Scale: {1.3, 1, 0.9}
    Cylinder: {radius: 2.75, length: 0.16, segments: 48}
    Rgb: {69, 101, 92}
  }

  pond {
    Position: {2.7, 0.17, 1.4}
    Scale: {1.3, 1, 0.9}
    Cylinder: {radius: 2.53, length: 0.06, segments: 48}
    Rgb: {54, 124, 140}
    PbrMaterial: {roughness: 0.06, metallic: 0.25}
  }

  // The pond, its bank and the bridge. The projection box reaches the trees, the bamboo, the
  // tea house and the beds around the pond, from the water up; the capture point is low over
  // the water, north of the bridge.
  pond_reflection {
    Position: {2.7, 2.2, 1.4}
    ReflectionProbe: {
      extent: {4.6, 3, 3.5},
      blend: 1,
      priority: 2,
      projection: {5.3, 2, 5},
      offset: {0, -1.7, -1.5}
    }
  }

  for i in 0..24 {
    GardenRock(size: 0.48 + math.sin(i * 2.4) * 0.12) {
      Position: {2.7 + math.cos(i * math.PI / 12) * 3.48, 0.08, 1.4 + math.sin(i * math.PI / 12) * 2.4}
      Rotation: {0, i * 1.2, 0}
    }
  }

  for i in 0..17 {
    const x = -0.18 + i * 0.36
    const arch = math.sin(i * math.PI / 16) * 0.61
    {
      Position: {x, 0.36 + arch, 1.2}
      Rotation: {0, 0, math.cos(i * math.PI / 16) * 0.32}
      Box: {0.37, 0.13, 1.28}
      Rgb: {182, 98, 68}
    }
    for side in 0..2 {
      {
        Position: {x, 1.04 + arch, 1.2 + (side - 0.5) * 1.4}
        Rotation: {0, 0, math.cos(i * math.PI / 16) * 0.32}
        Box: {0.39, 0.1, 0.1}
        Rgb: GardenVermilion
      }
      if i % 4 == 0 {
        {
          Position: {x, 0.72 + arch, 1.2 + (side - 0.5) * 1.4}
          Box: {0.13, 0.92, 0.13}
          Rgb: GardenVermilion
        }
        {
          Position: {x, 1.23 + arch, 1.2 + (side - 0.5) * 1.4}
          Sphere: {radius: 0.105, segments: 10, smooth: true}
          Rgb: {222, 170, 98}
        }
      }
    }
  }

  for i in 0..5 {
    {
      Position: {1.25 + i * 0.71, 0.212, 2.55 + math.sin(i * 1.9) * 0.37}
      Cylinder: {radius: 0.2 + i * 0.014, length: 0.018, segments: 14}
      Rgb: {115, 170, 120}
    }
    if i % 2 == 0 {
      for petal in 0..5 {
        {
          Position: {1.25 + i * 0.71 + math.cos(petal * 1.257) * 0.065, 0.27, 2.55 + math.sin(i * 1.9) * 0.37 + math.sin(petal * 1.257) * 0.065}
          Scale: {1, 1.2, 0.65}
          Sphere: {radius: 0.07, segments: 8, smooth: true}
          Rgb: GardenBlossom
        }
      }
    }
  }

  for i in 0..3 {
    {
      Position: {1.6 + i * 1.05, 0.222, 2.1 + math.sin(i * 2.4) * 0.25}
      Rotation: {0, i * 1.3, 0}
      Scale: {0.24, 0.025, 0.085}
      Sphere: {radius: 1, segments: 12, smooth: true}
      Rgb: {244, 172, 101}
    }
  }

  TeaHouse() {
    Position: {-2.7, 0.08, -3.25}
  }

  CherryTree(variant: 6) {
    Position: {3.55, 0.06, -3.35}
  }
  CherryTree(variant: 7) {
    Position: {-6, 0.06, -1.15}
    Scale: {0.7, 0.7, 0.7}
    Rotation: {0, 1.2, 0}
  }

  for i in 0..9 {
    Bamboo(height: 2.4 + math.sin(i * 1.8) * 0.45, phase: i * 0.83) {
      Position: {5.8 + math.sin(i * 2.4) * 0.55, 0.04, -4.8 + i * 0.29}
      Rotation: {0.03 * math.sin(i), 0, 0.06 * math.cos(i)}
    }
  }

  for i in 0..15 {
    {
      Position: {-7 + i, 0.69, -5.85}
      Cylinder: {radius: 0.055, length: 1.3, segments: 8}
      Rgb: {170, 147, 99}
    }
  }
  for i in 0..3 {
    {
      Position: {0, 0.3 + i * 0.41, -5.85}
      Box: {14.3, 0.075, 0.07}
      Rgb: {170, 147, 99}
    }
  }

  ToriiGate() { Position: {-3.1, 0.1, 4.75} }

  // The main paths, open to the sky, each between the buildings, fences and beds along it. The
  // capture points are at eye height above the paving, in the open between gates and trees. The
  // torii path runs through the gates inside the south path, so it is the inner one there.
  north_path_reflection {
    Position: {0, 1.7, -6.8}
    ReflectionProbe: {
      extent: {15.3, 2.5, 2.5},
      blend: 1,
      priority: 1,
      projection: {15.3, 1.5, 1.5},
      offset: {0, 0.2, 0}
    }
  }
  south_path_reflection {
    Position: {1.7, 1.7, 6.5}
    ReflectionProbe: {
      extent: {13.5, 2.5, 2.6},
      blend: 1,
      priority: 1,
      projection: {13.6, 1.5, 2.2},
      offset: {0, 0.2, 0}
    }
  }
  west_path_reflection {
    Position: {-7.6, 1.7, -0.15}
    ReflectionProbe: {
      extent: {1.975, 2.5, 7.65},
      blend: 1,
      priority: 1,
      projection: {1.75, 1.5, 6.65},
      offset: {0, 0.2, 1.75}
    }
  }
  torii_path_reflection {
    Position: {-3.1, 1.7, 9.55}
    ReflectionProbe: {
      extent: {2.075, 2.5, 5.1},
      blend: 1,
      priority: 2,
      projection: {1.8, 1.5, 4.1},
      offset: {0, 0.2, 1.15}
    }
  }

  StoneLantern() { Position: {-4.9, 0.13, 3.85} }
  StoneLantern() { Position: {-1.3, 0.13, 3.85} }
  StoneLantern() { Position: {-0.65, 0.13, -0.1} }
  StoneLantern() { Position: {6.1, 0.08, 1.5} }
  StoneLantern() { Position: {2.25, 0.08, -2.4} }

  GardenRock(size: 1.2) { Position: {5.8, 0.06, -1.45} }
  GardenRock(size: 0.8) { Position: {6.65, 0.06, -1.15} }
  GardenRock(size: 0.9) { Position: {-5.25, 0.14, 1.45} }
  GardenRock(size: 0.55) { Position: {-5.85, 0.14, 1.8} }

  for i in 0..12 {
    {
      Position: {-6.5 + i * 1.16, 0.3, -5.25 + math.sin(i * 2.4) * 0.2}
      Scale: {1, 0.65, 0.8}
      IcoSphere: {radius: 0.54, segments: 2, smooth: true}
      Rgb: GardenMoss
    }
  }

  for i in 0..8 {
    {
      Position: {0.4 + i * 0.77, 0.65 + math.sin(i * 2.1) * 0.3, 3.7 + math.sin(i * 2.4) * 0.6}
      Sphere: {radius: 0.024, segments: 6, smooth: true}
      Rgb: {213, 239, 153}
      Emissive: {strength: 6, color: {213, 239, 153}}
    }
  }
}

main_view {
  View: {
    camera: japanese_garden.orbit.camera,
    clear: {enabled: true, color: {51, 56, 81, 255}},
    lighting: {enabled: true, baked: true, reflections: true},
    shadows: {enabled: true, resolution: 2048, max_distance: 85},
    effects: [{effect: contact_shadows}, {effect: lantern_bloom}, {effect: tonemap}, {effect: smaa}]
  }
}

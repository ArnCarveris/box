// Fleet: a stress test, a giant space station with four liner gates and twenty rig bays.
// Its traffic never stops. Liners and rigs are the shipyard's preset designs (1 unit = 1 m).
include shipyard/ships
include fleet/materials
include fleet/kit
include fleet/hub
include fleet/yards
include fleet/rings
include fleet/outer
include fleet/traffic
include fleet/gates
include fleet/bays
include fleet/station

using flecs.script
using flecs.script.math
using box.transform
using box.camera
using box.view
using box.light
using box.material
using box.effects
using box.surface
using box.movement
using box.input
using box.controllers
using state
using assets

assets {
  fleet_stars {
    EnvironmentImage: {path: "etc/scenes/shipyard/assets/space.hdr"}
    Environment: {resolution: 1024}
  }
}

$ {
  box.app.FpsTarget: {60}
  Scene: {environment: true, blend_modes: true, transmission: true, fresnel: true, distortion: true}
  AmbientLight: {sky: {120, 140, 180}, ground: {50, 60, 84}, intensity: 0.4}
}

window { Surface: {width: 1600, height: 1000, vsync: true} }

// A free-fly camera (WASD, E/Q, Shift to boost, hold the right mouse button to look, wheel to
// zoom), starting above the station looking down on it.
camera {
  Position: {2300, 1900, 2300}
  Rotation: {-0.53, 0.785, 0}
  Camera: {fov: 45, near_: 2, far_: 40000}
  CameraController: {speed: 200, boost: 8, zoom: 60}
}

sun {
  Rotation: {0.7, 0.42, 0}
  DirectionalLight: {intensity: 6}
  Rgb: {255, 244, 226}
}

rim {
  Rotation: {0.35, 3.7, 0}
  DirectionalLight: {intensity: 1.8}
  Rgb: {110, 160, 255}
}

view {
  fleet_contact { Gtao: {radius: 9, final_value_power: 2.2} }
  fleet_bloom { Bloom: {intensity: 0.2, threshold: 1.1, threshold_softness: 0.45} }
  fleet_film { Tonemap: {operator_: TonyMcMapface} }
  fleet_edges { Smaa: {} }

  View: {
    camera: camera,
    clear: {enabled: true, color: {3, 5, 10, 255}},
    shadows: {
      enabled: true,
      cascades: 3,
      resolution: 2048,
      interval: [1, 2, 2],
      max_distance: 14000,
      filter_size: 2
    },
    lighting: {
      reflections: true,
      baked: false,
      environment: {source: assets.fleet_stars, intensity: 0.7, background: true}
    },
    effects: [
      {effect: fleet_contact},
      {effect: fleet_bloom},
      {effect: fleet_film},
      {effect: fleet_edges}
    ]
  }
}

station {
  HarborStation body

  for g in 0..4 {
    const a = g * HALF_PI
    LinerGate "gate_{g}"(
      idx: g,
      label: g == 0 ? "NORTH GATE" : g == 1 ? "EAST GATE" : g == 2 ? "SOUTH GATE" : "WEST GATE"
    ) {
      Position: {sin(a) * 1020, 0, cos(a) * 1020}
      Rotation: {0, a, 0}
    }
  }

  for q in 0..4 {
    for b in 0..5 {
      const a = q * HALF_PI + (25 + b * 10) * PI / 180
      RigBay "bay_{q * 5 + b}"(idx: q * 5 + b) {
        Position: {sin(a) * 915, 0, cos(a) * 915}
        Rotation: {0, a, 0}
      }
    }
  }
}

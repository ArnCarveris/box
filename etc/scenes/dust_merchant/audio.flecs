// The sound of the dust merchant, on the components of box.audio (docs/audio.md). The engine
// drone sits on the starboard pod; its level follows the main bus and the reactor, not eng_rpm.
//
// Included after state.flecs, whose muts the engine reads, and before widgets.flecs.
using flecs.script
using box.transform
using box.audio
using box.audio.synth
using state
using assets

assets {
  cabin_verb {
    Bus: {output: master, kind: ChannelReturn, effects: [cabin_verb]}
    Reverb: {decay: 0.75, damping: 0.6, predelay: 0.008, size: 0.25}
  }

  world {
    Bus: {output: master, kind: ChannelSfx, sends: [{bus: cabin_verb, level: 0.28}]}
  }

  ui { Bus: {output: master, kind: ChannelSfx, volume: 0.55} }
  music { Bus: {output: master, volume: 0.45} }

  prefab SfxToggle {
    Output: {bus: ui}
    Sound: {seed: 21, pitch_variance: 0.08, level_variance: 0.12}
    Envelope: {attack: 0.0005, decay: 0.04}
    Filter: {kind: HighPass, cutoff: 600, resonance: 0.15}
    snap {
      Oscillator: {wave: Noise, level: 0.5}
      Envelope: {attack: 0.0005, decay: 0.012}
    }

    tick {
      Oscillator: {wave: Triangle, frequency: 2600, frequency_end: 1400, sweep: 0.02, level: 0.45}
      Envelope: {attack: 0.0005, decay: 0.025}
    }

    knock {
      Oscillator: {wave: Sine, frequency: 1100, frequency_end: 700, sweep: 0.04, level: 0.35}
    }
  }

  // The red guard of the main switch
  prefab SfxGuard {
    Output: {bus: ui}
    Sound: {seed: 22, pitch_variance: 0.06, level_variance: 0.1}
    Envelope: {attack: 0.001, decay: 0.07}
    Filter: {kind: BandPass, cutoff: 950, resonance: 0.3}
    rub { Oscillator: {wave: Noise, level: 0.7} }
    thud {
      Oscillator: {wave: Triangle, frequency: 520, frequency_end: 300, sweep: 0.06, level: 0.4}
    }
  }

  prefab SfxDetent {
    Output: {bus: ui}
    Sound: {seed: 23, pitch_variance: 0.12, level_variance: 0.2}
    Envelope: {attack: 0.0005, decay: 0.008}
    Filter: {kind: HighPass, cutoff: 2500}
    grit { Oscillator: {wave: Noise, level: 0.4} }
    ping { Oscillator: {wave: Sine, frequency: 3400, level: 0.3} }
  }

  prefab SfxButton {
    Output: {bus: ui}
    Sound: {seed: 24, pitch_variance: 0.06, level_variance: 0.1}
    Envelope: {attack: 0.001, decay: 0.03}
    Filter: {kind: LowPass, cutoff: 2200}
    pad { Oscillator: {wave: Noise, level: 0.4} }
    tone { Oscillator: {wave: Sine, frequency: 720, frequency_end: 480, sweep: 0.03, level: 0.45} }
  }

  prefab SfxBreaker {
    Output: {bus: ui}
    Sound: {seed: 25, pitch_variance: 0.07, level_variance: 0.1}
    Envelope: {attack: 0.0005, decay: 0.035}
    Filter: {kind: BandPass, cutoff: 1500, resonance: 0.3}
    clack { Oscillator: {wave: Noise, level: 0.7} }
    body {
      Oscillator: {wave: Square, frequency: 900, frequency_end: 400, sweep: 0.025, level: 0.22}
    }
  }

  prefab SfxThump {
    Output: {bus: ui}
    Sound: {seed: 26, pitch_variance: 0.05, level_variance: 0.1}
    Envelope: {attack: 0.001, decay: 0.14}
    Filter: {kind: LowPass, cutoff: 600}
    boom { Oscillator: {wave: Sine, frequency: 130, frequency_end: 60, sweep: 0.09, level: 0.8} }
    slap {
      Oscillator: {wave: Noise, level: 0.5}
      Envelope: {attack: 0.001, decay: 0.04}
    }
  }

  // The engine: a low saw and its fifth through a resonant lowpass, a faint whine and a rumble of
  // noise. It loops one pass of 60 seconds; the edges of 2 ms where a pass restarts are a gap the
  // lowpass smooths over.
  prefab EngineHum {
    Sound: {seed: 11}
    Envelope: {attack: 0.002, sustain: 1, hold: 59.99, release: 0.002}
    Filter: {kind: LowPass, cutoff: 380, resonance: 0.35}
    base { Oscillator: {wave: Saw, frequency: 46, level: 0.5} }
    fifth { Oscillator: {wave: Square, frequency: 69.3, level: 0.16} }
    whine { Oscillator: {wave: Triangle, frequency: 368, level: 0.05} }
    rumble { Oscillator: {wave: Noise, level: 0.22} }
  }
}

// The ears are the camera of rig.flecs. Without a listener the camera of the first view would
// hear, and the screens render their own views before the main one.
camera { Listener }

dust_merchant {
  engine_sound {
    Position: {3.1, 0.6, 3.8}
    Source: {
      sound: assets.EngineHum,
      loop: true,
      volume: 0.3 + 0.2 * bool_f(bus) + 0.3 * bool_f(reactor_on)
    }
    Output: {bus: assets.world}
    Spatial: {min_distance: 1.5, max_distance: 30}
  }

  music_track {
    Stream: {path: "etc/scenes/dust_merchant/assets/dust_merchant_loop.ogg"}
    Output: {bus: assets.music}
  }
}

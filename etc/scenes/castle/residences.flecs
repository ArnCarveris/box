      Box: {0.08, 0.17, 0.015}
    }

    shut_b : CastleWood { Position: {0.53, 0.36, 0.52}; Box: {0.08, 0.17, 0.015} }

    if ruined {
      Boards boards_a(w: 0.18) { Position: {-0.4, 0.36, 0.53} }
      Boards boards_b(w: 0.18) { Position: {0.4, 0.36, 0.53} }

      if !ruined {
        lamp : CastleFlame {
          Position: {0.24, 0.62, 0.12}
          Sphere: {radius: 0.035, segments: 6}
        }
      }
    }

    well_ {
      Position: {-0.72, 0, -0.82}
      ring : CastleStone {
        Position: {0, 0.12, 0}
        Tube: {length: 0.24, radius: 0.16, thickness: 0.05, segments: 12}
      }

      water : CastleWater {
        Position: {0, 0.1, 0}
        Cylinder: {length: 0.02, radius: 0.12, segments: 12}
      }
    }

    Woodpile logs { Position: {0.0, 0, -0.84} }
    turret {
      Position: {0.66, 0, -0.66}
      body : CastleStone {
        Position: {0, 1.25, 0}
        Cylinder: {length: 2.5, radius: 0.22, segments: 14}
        texture.Transform: {scale_x: 1.4 / TS, scale_y: 2.5 / TS}

        if ruined { Rgb: grime }
      }

      rim : CastlePaleStone {
        Position: {0, 2.52, 0}
        Cylinder: {length: 0.07, radius: 0.26, segments: 14}
      }

      Pane slit(lit: lit) {
        Position: {0.11, 1.9, 0.19}
        Rotation: {0, 0.5, 0}
        Box: {0.06, 0.18, 0.02}
      }

      if ruined {
        stump : CastleDark {
          Position: {0, 2.6, 0}
          Cylinder: {length: 0.1, radius: 0.2, segments: 10}
        }
      } else {
        roof : CastleSlate {
          Position: {0, 2.9, 0}
          Cone: {length: 0.7, radius: 0.3, segments: 14}
          texture.Transform: {scale_x: 2, scale_y: 1}
        }

        finial : CastleGold {
          Position: {0, 3.28, 0}
          Sphere: {radius: 0.04, segments: 8, smooth: true}
        }

        pole : CastleIron {
          Position: {0, 3.5, 0}
          Cylinder: {length: 0.44, radius: 0.012, segments: 5}
        }

        pennant : CastleBannerBlue {
          Position: {0.13, 3.62, 0}
          Rotation: {0, 0, -HALF_PI}
          TrianglePrism: {0.14, 0.26, 0.012}
        }
      }
    }

    if ruined {
      Weeds weeds(seed: seed, r: 0.75)
    }
  }

  template HousePiece {
    prop level_: i32 = 1
    prop seed: f32 = 0
    prop ruined: bool = false

    const lvl = clamp(level_, 1, 3)

    if lvl == 1 {
      CottageFrame frame(level_: level_, seed: seed, ruined: ruined)
    } else if lvl == 2 {
      HouseFrame frame(level_: level_, seed: seed, ruined: ruined)
    } else {
      ManorFrame frame(level_: level_, seed: seed, ruined: ruined)
    }
  }
}

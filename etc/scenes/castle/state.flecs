// State and rules of Castlewright: the plot is a grid of GRID x GRID cells, each holding one piece
// (kind) at a level. Every rule is a function of the kind and level so that the board, the logic
// and the HUD agree on names, costs and prestige.

using flecs.script
using flecs.script.math

export const GRID: i32 = 14
export const CELLS: i32 = 196
export const PITCH: f32 = 2

export const K_EMPTY: i32 = 0
export const K_WALL: i32 = 1
export const K_TOWER: i32 = 2
export const K_GATE: i32 = 3
export const K_KEEP: i32 = 4
export const K_HOUSE: i32 = 5
export const K_QUARRY: i32 = 6
export const K_MOAT: i32 = 7
export const K_TREE: i32 = 8
export const K_PATH: i32 = 9
export const T_DEMOLISH: i32 = 10
export const TOOLS: i32 = 10

export const RANKS: i32 = 6

event Build(i: i32)
event PickTool(t: i32)
event Toast(text: string)
event RankUp(rank: i32)
event NewRealm()

fn kind_name(k: i32) -> string {
  match k {
    1: "Wall"
    2: "Tower"
    3: "Gatehouse"
    4: "Keep"
    5: "Cottage"
    6: "Quarry"
    7: "Moat"
    8: "Tree"
    9: "Path"
    10: "Demolish"
    _: "Meadow"
  }
}

fn kind_blurb(k: i32) -> string {
  match k {
    1: "Curtain wall. Walls, towers and gatehouses that close a ring turn the ground inside into a courtyard. Click a wall again to raise it."
    2: "Round tower with a slate roof. Joins the walls next to it. Click again to build it higher, up to three storeys."
    3: "A gatehouse with a portcullis. Turns to follow the wall it sits in, and closes the ring like a wall does."
    4: "The lord's keep, one per realm. Collects taxes and is worth twice the prestige inside the courtyard. Click again to raise it."
    5: "A cottage for your villagers. Pays 1 gold a second, 2 when it is safe inside the walls."
    6: "A stone quarry. Cuts 2 stone a second."
    7: "A moat of still water."
    8: "An oak or a pine. Cheap, and pleasant to look at."
    9: "A cobbled path."
    10: "Tear a piece down and get half of its cost back."
    _: ""
  }
}

fn max_level(k: i32) -> i32 {
  match k {
    1: 3
    2: 3
    4: 3
    _: 1
  }
}

fn cost_gold(k: i32, lvl: i32) -> i32 {
  match k {
    1: 0
    2: 10 + (lvl - 1) * 15
    3: 25
    4: 80 + (lvl - 1) * 60
    5: 25
    6: 40
    7: 8
    8: 3
    9: 2
    _: 0
  }
}

fn cost_stone(k: i32, lvl: i32) -> i32 {
  match k {
    1: 10
    2: 30 + (lvl - 1) * 10
    3: 40
    4: 120 + (lvl - 1) * 40
    5: 5
    9: 1
    _: 0
  }
}

fn cost_text(k: i32, lvl: i32) -> string {
  const g = cost_gold(k, lvl)
  const s = cost_stone(k, lvl)
  match g > 0 && s > 0 {
    true: "{g}g {s}s"
    _: match g > 0 {
      true: "{g} gold"
      _: match s > 0 {
        true: "{s} stone"
        _: "refund"
      }
    }
  }
}

fn spent_gold(k: i32, lvl: i32) -> i32 {
  match lvl {
    1: cost_gold(k, 1)
    2: cost_gold(k, 1) + cost_gold(k, 2)
    3: cost_gold(k, 1) + cost_gold(k, 2) + cost_gold(k, 3)
    _: 0
  }
}

fn spent_stone(k: i32, lvl: i32) -> i32 {
  match lvl {
    1: cost_stone(k, 1)
    2: cost_stone(k, 1) + cost_stone(k, 2)
    3: cost_stone(k, 1) + cost_stone(k, 2) + cost_stone(k, 3)
    _: 0
  }
}

fn barrier(k: i32) -> bool {
  k == 1 || k == 2 || k == 3
}

fn wall_height(k: i32, lvl: i32) -> f32 {
  match k {
    1: 1.2 + lvl * 0.7
    2: 2.6
    3: 2.6
    _: 0
  }
}

fn prestige_of(k: i32, lvl: i32, safe: bool) -> f64 {
  match k {
    1: lvl
    2: lvl * 4
    3: 6
    4: match safe { true: lvl * 40; _: lvl * 20 }
    5: match safe { true: 3; _: 2 }
    6: 1
    7: 1
    8: 1
    _: 0
  }
}

fn rank_need(r: i32) -> f64 {
  match r {
    0: 0
    1: 30
    2: 80
    3: 160
    4: 270
    5: 420
    _: 99999
  }
}

fn rank_name(r: i32) -> string {
  match r {
    0: "Hamlet"
    1: "Motte"
    2: "Fort"
    3: "Castle"
    4: "Stronghold"
    5: "Royal Citadel"
    _: ""
  }
}

fn rank_of(p: f64) -> i32 {
  match p >= rank_need(5) {
    true: 5
    _: match p >= rank_need(4) {
      true: 4
      _: match p >= rank_need(3) {
        true: 3
        _: match p >= rank_need(2) {
          true: 2
          _: match p >= rank_need(1) { true: 1; _: 0 }
        }
      }
    }
  }
}

fn cell_x(i: i32) -> f32 {
  ((i % GRID) - (GRID - 1) / 2.0) * PITCH
}

fn cell_z(i: i32) -> f32 {
  (floor(i / GRID) - (GRID - 1) / 2.0) * PITCH
}

fn fract(v: f64) -> f64 {
  v - floor(v)
}

fn hash(i: i32) -> f64 {
  fract(sin(i * 12.9898 + 4.1414) * 43758.5453)
}

fn bool_f(b: bool) -> f32 {
  match b { true: 1; _: 0 }
}

export mut kind: i32[196] = {}
export mut level: i32[196] = {}
export mut inside: bool[196] = {}

export mut tool: i32 = 0
export mut hover_tool: i32 = 0
export mut hover_cell: i32 = -1
export mut rising: i32 = -1

export mut gold: f64 = 150
export mut stone: f64 = 120
export mut gold_rate: f64 = 1
export mut stone_rate: f64 = 1
export mut prestige: f64 = 0
export mut rank: i32 = 0
export mut courtyard: i32 = 0
export mut pieces: i32 = 0
export mut keep_cell: i32 = -1
export mut crowned = false

export mut clock: f64 = 0
export mut toast: string = ""
export mut toast_until: f64 = 0

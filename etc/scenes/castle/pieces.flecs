// The pieces that can stand on a cell, each centered on the cell and standing on y = 0. hn, he, hs
// and hw are the heights of the WallArm on each side, 0 where there is no neighbor to join.

using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.particle
using box.transition
using box.movement
using box.animation
using box.light
using state
using assets

state {
  export const HALF_PI: f32 = 1.5708
}

assets {
  template Folk {
    prop seed: f32 = 0
    prop guard: bool = false

    const pick = floor(fract(seed * 17.3) * 4)
    const tunic: Rgb = match guard {
      true: {150, 34, 38}
      _: match pick {
        0: {150, 60, 44}
        1: {74, 104, 60}
        2: {62, 82, 130}
        _: {132, 100, 66}
      }
    }
    const hair: Rgb = match floor(fract(seed * 5.1) * 3) {
      0: {60, 40, 26}
      1: {150, 104, 52}
      _: {40, 32, 28}
    }
    const woman = !guard && fract(seed * 9.7) > 0.5

    leg_a : CastleDark { Position: {-0.035, 0.07, 0}; Box: {0.045, 0.14, 0.05} }
    leg_b : CastleDark { Position: {0.035, 0.07, 0}; Box: {0.045, 0.14, 0.05} }

    if woman {
      dress {
        Position: {0, 0.14, 0}
        Frustum: {length: 0.22, radius_bottom: 0.1, radius_top: 0.055, segments: 8}
        Rgb: tunic
        PbrMaterial: {roughness: 0.95}
      }
    }

    tunic_ {
      Position: {0, 0.22, 0}
      Frustum: {length: 0.16, radius_bottom: 0.075, radius_top: 0.06, segments: 8}
      Rgb: tunic
      PbrMaterial: {roughness: 0.95}
    }

    belt : CastleTimber {
      Position: {0, 0.17, 0}
      Cylinder: {length: 0.025, radius: 0.072, segments: 8}
    }

    arm_a {
      Position: {-0.075, 0.23, 0}
      Rotation: {0, 0, 0.12}
      Box: {0.035, 0.14, 0.04}
      Rgb: tunic
      PbrMaterial: {roughness: 0.95}
    }

    arm_b {
      Position: {0.075, 0.23, 0}
      Rotation: {0, 0, -0.12}
      Box: {0.035, 0.14, 0.04}
      Rgb: tunic
      PbrMaterial: {roughness: 0.95}
    }

    head : CastleSkin { Position: {0, 0.35, 0}; Sphere: {radius: 0.05, segments: 10, smooth: true} }

    if guard {
      helm : CastleIron { Position: {0, 0.365, 0}; HemiSphere: {radius: 0.056, segments: 10} }
      nasal : CastleIron { Position: {0, 0.35, 0.05}; Box: {0.012, 0.05, 0.01} }
      spear : CastleWood {
        Position: {0.1, 0.3, 0.02}
        Cylinder: {length: 0.62, radius: 0.01, segments: 5}
      }

      tip : CastleIron {
        Position: {0.1, 0.63, 0.02}
        Cone: {length: 0.06, radius: 0.02, segments: 5}
      }

      shield : CastleBannerBlue {
        Position: {-0.085, 0.22, 0.02}
        Rotation: {0, -0.3, 0}
        Box: {0.02, 0.12, 0.09}
      }
    } else {
      hair_ {
        Position: {0, 0.37, -0.008}
        HemiSphere: {radius: 0.053, segments: 10}
        Rgb: hair
        PbrMaterial: {roughness: 1}
      }

      if pick == 3 {
        hat : CastleHay { Position: {0, 0.39, 0}; Cone: {length: 0.06, radius: 0.08, segments: 10} }
      }
    }
  }

  template Sheep {
    prop seed: f32 = 0

    body : CastleWool {
      Position: {0, 0.17, 0}
      Scale: {1, 0.8, 1.35}
      IcoSphere: {radius: 0.12, segments: 1}
    }

    head : CastleDark { Position: {0, 0.2, 0.17}; Rotation: {0.3, 0, 0}; Box: {0.07, 0.08, 0.1} }
    ear_a : CastleDark { Position: {-0.045, 0.23, 0.15}; Box: {0.04, 0.015, 0.02} }
    ear_b : CastleDark { Position: {0.045, 0.23, 0.15}; Box: {0.04, 0.015, 0.02} }

    for l in 0..4 {
      const lx = match l % 2 { 0: -0.05; _: 0.05 }
      const lz = l < 2 ? -0.08 : 0.08
      "leg_{l}" : CastleDark { Position: {lx, 0.05, lz}; Box: {0.025, 0.1, 0.025} }
    }
  }

  template Barrel {
    body : CastleWood {
      Position: {0, 0.13, 0}
      Cylinder: {length: 0.26, radius: 0.1, segments: 12}
      texture.Transform: {scale_x: 0.6, scale_y: 0.4}
    }

    hoop_a : CastleIron {
      Position: {0, 0.05, 0}
      Cylinder: {length: 0.02, radius: 0.104, segments: 12}
    }

    hoop_b : CastleIron {
      Position: {0, 0.21, 0}
      Cylinder: {length: 0.02, radius: 0.104, segments: 12}
    }

    lid : CastleOldWood {
      Position: {0, 0.262, 0}
      Cylinder: {length: 0.01, radius: 0.092, segments: 12}
    }
  }

  template Crate {
    prop s: f32 = 0.2
    box : CastleOldWood {
      Position: {0, s / 2, 0}
      Box: {s, s, s}
      texture.Transform: {scale_x: s * 1.2, scale_y: s * 1.2}
    }

    band_a : CastleTimber { Position: {0, s / 2, 0}; Box: {s + 0.01, 0.025, s + 0.01} }
    band_b : CastleTimber { Position: {0, s / 2, 0}; Box: {0.025, s + 0.01, s + 0.01} }
  }

  template HayBale {
    bale : CastleHay {
      Position: {0, 0.1, 0}
      Rotation: {0, 0, HALF_PI}
      Cylinder: {length: 0.32, radius: 0.1, segments: 12}
      texture.Transform: {scale_x: 1, scale_y: 0.3}
    }
  }

  template Woodpile {
    for r in 0..3 {
      for c in 0..(3 - r) {
        "log_{r}_{c}" : CastleBark {
          Position: {(c - (2 - r) / 2.0) * 0.08, 0.04 + r * 0.068, 0}
          Rotation: {HALF_PI, 0, 0}
          Cylinder: {length: 0.34, radius: 0.04, segments: 7}
        }
      }
    }
  }

  template Tuft {
    prop seed: f32 = 0

    for b in 0..4 {
      const a = seed * 30 + b * 1.6
      "blade_{b}" : CastleLeaf {
        Position: {sin(a) * 0.04, 0.05, cos(a) * 0.04}
        Rotation: {sin(a) * 0.4, a, cos(a) * 0.4}
        Cone: {length: 0.12 + fract(a) * 0.08, radius: 0.025, segments: 3}
      }
    }
  }

  template Flowers {
    prop seed: f32 = 0
    const petal: Rgb = match floor(fract(seed * 11.1) * 4) {
      0: {250, 246, 230}
      1: {246, 206, 70}
      2: {214, 96, 140}
      _: {150, 130, 220}
    }

    for f in 0..5 {
      const a = seed * 50 + f * 1.26
      const r = 0.05 + fract(a * 3.3) * 0.12
      "stem_{f}" : CastleLeaf { Position: {sin(a) * r, 0.04, cos(a) * r}; Box: {0.01, 0.08, 0.01} }
      "head_{f}" {
        Position: {sin(a) * r, 0.085, cos(a) * r}
        Sphere: {radius: 0.022, segments: 6}
        Rgb: petal
        PbrMaterial: {roughness: 0.8}
      }
    }
  }

  template Torch {
    bracket : CastleIron { Position: {0, 0, 0.05}; Box: {0.04, 0.16, 0.08} }
    stick : CastleTimber {
      Position: {0, 0.1, 0.09}
      Cylinder: {length: 0.16, radius: 0.022, segments: 6}
    }

    flame : CastleFlame { Position: {0, 0.2, 0.09}; Sphere: {radius: 0.045, segments: 8} }
  }

  template HangingBanner {
    prop blue: bool = false
    prop len: f32 = 0.9

    pole : CastleIron { Position: {0, 0, 0.03}; Box: {0.42, 0.03, 0.03} }

    if blue {
      cloth : CastleBannerBlue { Position: {0, -len / 2, 0.02}; Box: {0.34, len, 0.015} }
    } else {
      cloth : CastleBanner { Position: {0, -len / 2, 0.02}; Box: {0.34, len, 0.015} }
    }

    if blue {
      tail_a : CastleBannerBlue {
        Position: {-0.085, -len - 0.06, 0.02}
        Rotation: {0, 0, 0.785}
        Box: {0.12, 0.12, 0.015}
      }

      tail_b : CastleBannerBlue {
        Position: {0.085, -len - 0.06, 0.02}
        Rotation: {0, 0, 0.785}
        Box: {0.12, 0.12, 0.015}
      }
    } else {
      tail_a : CastleBanner {
        Position: {-0.085, -len - 0.06, 0.02}
        Rotation: {0, 0, 0.785}
        Box: {0.12, 0.12, 0.015}
      }

      tail_b : CastleBanner {
        Position: {0.085, -len - 0.06, 0.02}
        Rotation: {0, 0, 0.785}
        Box: {0.12, 0.12, 0.015}
      }
    }

    charge : CastleGold {
      Position: {0, -len * 0.4, 0.03}
      Rotation: {0, 0, 0.785}
      Box: {0.12, 0.12, 0.01}
    }
  }

  template Pane {
    prop lit: bool = true
    prop glow: Rgb = {255, 170, 80}

    if lit {
      Rgb: {60, 40, 20}
      PbrMaterial: {roughness: 0.6}
      Emissive: {strength: 1.2, color: glow}
    } else {
      Rgb: {22, 19, 17}
      PbrMaterial: {roughness: 0.95}
    }
  }

  template Boards {
    prop w: f32 = 0.2

    a : CastleOldWood { Rotation: {0, 0, 0.5}; Box: {w * 1.3, 0.035, 0.015} }
    b : CastleOldWood {
      Position: {0, 0, 0.01}
      Rotation: {0, 0, -0.45}
      Box: {w * 1.3, 0.035, 0.015}
    }
  }

  template Weeds {
    prop seed: f32 = 0
    prop r: f32 = 0.8

    for t in 0..6 {
      const a = seed * 40 + t * 1.05
      Tuft "tuft_{t}"(seed: fract(seed + t * 0.17)) {
        Position: {sin(a) * r, 0, cos(a) * r * 0.9}
        Scale: {1.4, 1.6, 1.4}
      }
    }

    rubble_a : CastleRock {
      Position: {sin(seed * 9) * r * 0.8, 0.04, cos(seed * 9) * r * 0.8}
      Rotation: {seed, seed * 4, 0}
      IcoSphere: {radius: 0.09, segments: 1}
    }

    rubble_b : CastleRock {
      Position: {sin(seed * 9 + 2) * r * 0.7, 0.03, cos(seed * 9 + 2) * r * 0.7}
      Rotation: {seed * 3, seed, 0}
      IcoSphere: {radius: 0.07, segments: 1}
    }
  }

  template Ivy {
    prop h: f32 = 1
    prop w: f32 = 0.5

    a : CastleLeafDark {
      Position: {0, h * 0.5, 0}
      Scale: {w, h * 0.55, 0.12}
      IcoSphere: {radius: 1, segments: 1}
    }

    b : CastleLeaf {
      Position: {w * 0.3, h * 0.25, 0.02}
      Scale: {w * 0.6, h * 0.3, 0.1}
      IcoSphere: {radius: 1, segments: 1}
    }
  }

  template Chimney {
    prop h: f32 = 0.7
    prop smoke: bool = true
    prop seed: f32 = 0

    stack : CastleDarkStone {
      Position: {0, h / 2, 0}
      Box: {0.18, h, 0.18}
      texture.Transform: {scale_x: 0.15, scale_y: h * 0.7}
    }

    cap : CastlePaleStone { Position: {0, h + 0.02, 0}; Box: {0.22, 0.04, 0.22} }
    pot : CastleTile {
      Position: {0, h + 0.08, 0}
      Cylinder: {length: 0.1, radius: 0.04, segments: 8}
    }

    if smoke {
      plume {
        Position: {0, h + 0.18, 0}
        Emitter: {
          max: 24, rate: 3,
          shape: EmitterSphere, radius: 0.04,
          direction: {0, 1, 0}, spread: 12, speed: {0.25, 0.45},
          lifetime: {2.5, 4}, size: {0.14, 0.24}, opacity: {0.25, 0.4},
          acceleration: {0.08, 0.05, 0.03},
          color: {200, 196, 190}, color_variance: {12, 12, 12},
          seed: seed * 1000
        }
        Curves: {
          size: {keys: [{0, 0.6}, {0.333, 1.4}, {0.667, 2.2}, {1, 3}]},
          opacity: {keys: [{0, 0}, {0.333, 1}, {0.667, 0.6}, {1, 0}]}
        }
      }
    }
  }

  template Topiary {
    prop h: f32 = 0.3

    tub : CastleTile {
      Position: {0, 0.05, 0}
      Frustum: {length: 0.1, radius_bottom: 0.06, radius_top: 0.08, segments: 8}
    }

    bush : CastleLeafDark {
      Position: {0, 0.1 + h / 2, 0}
      Cone: {length: h, radius: h * 0.35, segments: 8}
    }
  }

  template Horse {
    prop seed: f32 = 0

    const coat: Rgb = match floor(fract(seed * 7.1) * 3) {
      0: {120, 78, 46}
      1: {70, 50, 36}
      _: {196, 186, 170}
    }

    body {
      Position: {0, 0.3, 0}
      Box: {0.14, 0.14, 0.36}
      Rgb: coat
      PbrMaterial: {roughness: 0.9}
    }

    neck {
      Position: {0, 0.4, 0.18}
      Rotation: {-0.6, 0, 0}
      Box: {0.08, 0.2, 0.08}
      Rgb: coat
      PbrMaterial: {roughness: 0.9}
    }

    head {
      Position: {0, 0.48, 0.27}
      Rotation: {0.5, 0, 0}
      Box: {0.07, 0.07, 0.15}
      Rgb: coat
      PbrMaterial: {roughness: 0.9}
    }

    mane : CastleDark { Position: {0, 0.44, 0.15}; Rotation: {-0.6, 0, 0}; Box: {0.03, 0.2, 0.04} }
    tail : CastleDark { Position: {0, 0.3, -0.2}; Rotation: {0.5, 0, 0}; Box: {0.03, 0.16, 0.03} }
    collar : CastleTimber {
      Position: {0, 0.37, 0.12}
      Rotation: {-0.6, 0, 0}
      Torus: {radius: 0.07, tube: 0.018, segments: 10, rings: 6}
    }

    for l in 0..4 {
      const lx = match l % 2 { 0: -0.05; _: 0.05 }
      const lz = l < 2 ? -0.13 : 0.13
      "leg_{l}" {
        Position: {lx, 0.12, lz}
        Box: {0.035, 0.24, 0.035}
        Rgb: coat
        PbrMaterial: {roughness: 0.9}
      }
    }
  }

  template Scarecrow {
    post : CastleTimber { Position: {0, 0.3, 0}; Box: {0.03, 0.6, 0.03} }
    arms : CastleTimber { Position: {0, 0.42, 0}; Box: {0.34, 0.025, 0.025} }
    coat : CastleTunicBlue {
      Position: {0, 0.38, 0}
      Frustum: {length: 0.2, radius_bottom: 0.08, radius_top: 0.05, segments: 6}
    }

    sleeves : CastleTunicBlue { Position: {0, 0.42, 0}; Box: {0.3, 0.05, 0.05} }
    head : CastleHay { Position: {0, 0.54, 0}; Sphere: {radius: 0.05, segments: 8} }
    hat : CastleHay { Position: {0, 0.6, 0}; Cone: {length: 0.07, radius: 0.09, segments: 8} }
  }

  template Stook {
    prop s: f32 = 1
    sheaf : CastleHay {
      Position: {0, 0.12 * s, 0}
      Cone: {length: 0.26 * s, radius: 0.1 * s, segments: 7}
      texture.Transform: {scale_x: 1, scale_y: 0.6}
    }

    band : CastleTimber {
      Position: {0, 0.15 * s, 0}
      Cylinder: {length: 0.02, radius: 0.06 * s, segments: 7}
    }
  }

  template Plough {
    beam : CastleWood { Position: {0, 0.1, 0}; Rotation: {0.25, 0, 0}; Box: {0.04, 0.04, 0.5} }
    handle_a : CastleWood {
      Position: {-0.06, 0.18, -0.25}
      Rotation: {0.7, 0, 0}
      Box: {0.025, 0.025, 0.24}
    }

    handle_b : CastleWood {
      Position: {0.06, 0.18, -0.25}
      Rotation: {0.7, 0, 0}
      Box: {0.025, 0.025, 0.24}
    }

    share : CastleIron {
      Position: {0, 0.04, -0.12}
      Rotation: {0.4, 0, 0}
      Box: {0.08, 0.02, 0.14}
    }

    wheel : CastleTimber {
      Position: {0, 0.07, 0.22}
      Rotation: {0, 0, HALF_PI}
      Cylinder: {length: 0.03, radius: 0.07, segments: 10}
    }
  }

  castle_marker_bob {
    Clip: {duration: 1}
    lift {
      Track: {
        component: Position,
        member: "y",
        curve: {kind: CurveBezier, keys: [{0, 0, 0, 0}, {1, 0.12, 0, 0}]}
      }
    }
  }

  template UpgradeMarker {
    Position: {0, 0, 0}
    Rotation: {0, 0, 0}
    AngularVelocity: {0, PI, 0}
    Animator: {clip: castle_marker_bob, mode: PingPong}

    shaft {
      Position: {0, 0, 0}
      Box: {0.08, 0.2, 0.08}
      Rgb: {255, 210, 90}
      Emissive: {strength: 2.5, color: {255, 196, 70}}
      NoShadow
    }

    head {
      Position: {0, 0.17, 0}
      Cone: {length: 0.16, radius: 0.13, segments: 4}
      Rgb: {255, 210, 90}
      Emissive: {strength: 2.5, color: {255, 196, 70}}
      NoShadow
    }
  }

  // A stretch of wall from start to the edge of the cell along +x, with merlons on both parapets
  template WallArm {
    prop h: f32 = 1.9
    prop lvl: i32 = 1
    prop start: f32 = 0.4
    prop merlons: bool = true
    prop seed: f32 = 0

    const len = 1.0 - start
    const cx = start + len / 2

    if lvl == 1 {
      bank : CastleSoil {
        Position: {cx, 0.07, 0}
        Box: {len + 0.02, 0.14, 0.46}
        texture.Transform: {scale_x: len, scale_y: 0.2}
      }

      for c in 0..5 {
        const lx = 0.1 + c * 0.2

        if lx > start {
          const lh = h - 0.12 + fract(seed * 5.1 + c * 0.37) * 0.24
          "log_{c}" : CastleBark {
            Position: {lx, lh / 2, 0}
            Cylinder: {length: lh, radius: 0.1, segments: 7}
            texture.Transform: {scale_x: 0.6, scale_y: lh}
          }

          "tip_{c}" : CastleBark {
            Position: {lx, lh + 0.1, 0}
            Cone: {length: 0.2, radius: 0.1, segments: 7}
          }
        }
      }

      rail_lo : CastleTimber { Position: {cx, h * 0.28, -0.12}; Box: {len + 0.02, 0.07, 0.05} }
      rail_hi : CastleTimber { Position: {cx, h * 0.72, -0.12}; Box: {len + 0.02, 0.07, 0.05} }
    } else {
      body : CastleStoneBlock {
        Position: {cx, h / 2, 0}
        Box: {len + 0.02, h, 0.8}
      }

      base : CastleDarkStoneBlock {
        Position: {cx, 0.22 + lvl * 0.06, 0}
        Box: {len + 0.02, 0.44 + lvl * 0.12, 0.96}
      }

      walk : CastleOldWood {
        Position: {cx, h + 0.01, 0}
        Box: {len + 0.02, 0.02, 0.42}
        texture.Transform: {scale_x: len, scale_y: 0.42}
      }

      moss : CastleLeafDark { Position: {cx, 0.03, 0.49}; Box: {len, 0.06, 0.04} }
      moss_b : CastleLeafDark { Position: {cx, 0.03, -0.49}; Box: {len, 0.06, 0.04} }

      if lvl >= 2 {
        string_ : CastlePaleStone {
          Position: {cx, h - 0.06, 0}
          Box: {len + 0.02, 0.07, 0.88}
          texture.Transform: {scale_x: len, scale_y: 0.1}
        }

        slit_a : CastleDark { Position: {cx, h * 0.55, 0.401}; Box: {0.05, 0.28, 0.01} }
        slit_b : CastleDark { Position: {cx, h * 0.55, -0.401}; Box: {0.05, 0.28, 0.01} }
      }

      if lvl >= 3 {
        mach : CastleStone {
          Position: {cx, h - 0.02, 0}
          Box: {len + 0.02, 0.16, 0.98}
          texture.Transform: {scale_x: len, scale_y: 0.2}
        }

        for c in 0..3 {
          "corbel_o_{c}" : CastlePaleStone {
            Position: {start + 0.1 + c * (len - 0.1) / 2.5, h - 0.17, 0.46}
            Box: {0.07, 0.14, 0.06}
          }

          "corbel_i_{c}" : CastlePaleStone {
            Position: {start + 0.1 + c * (len - 0.1) / 2.5, h - 0.17, -0.46}
            Box: {0.07, 0.14, 0.06}
          }
        }

        slit_c : CastleDark { Position: {cx, h * 0.28, 0.401}; Box: {0.05, 0.2, 0.01} }
      }

      if merlons {
        const mz = lvl >= 3 ? 0.36 : 0.3
        m_out : CastleStone { Position: {0.72, h + 0.17, mz}; Box: {0.3, 0.34, 0.2} }
        m_in : CastleStone { Position: {0.72, h + 0.17, 0 - mz}; Box: {0.3, 0.34, 0.2} }
        slit_out : CastleDark { Position: {0.72, h + 0.17, mz + 0.101}; Box: {0.04, 0.18, 0.01} }

        if lvl >= 2 {
          cap_out : CastlePaleStone { Position: {0.72, h + 0.35, mz}; Box: {0.33, 0.03, 0.23} }
          cap_in : CastlePaleStone { Position: {0.72, h + 0.35, 0 - mz}; Box: {0.33, 0.03, 0.23} }
        }
      }

      if fract(seed * 7.7 + start) > 0.82 {
        ivy : CastleLeafDark {
          Position: {cx, h * 0.3, 0.41}
          Scale: {1.2, 1.6, 0.25}
          IcoSphere: {radius: 0.22, segments: 1}
        }
      }
    }
  }

  template WallPiece {
    prop level_: i32 = 1
    prop seed: f32 = 0
    prop n: bool = false
    prop e: bool = false
    prop s: bool = false
    prop w: bool = false

    const lvl = clamp(level_, 1, 3)
    const h = wall_height(K_WALL, lvl)
    const straight_x = (e || w) && !n && !s
    const straight_z = (n || s) && !e && !w
    const mz = lvl >= 3 ? 0.36 : 0.3

    if lvl == 1 {
      bank : CastleSoil {
        Position: {0, 0.07, 0}
        Box: {0.5, 0.14, 0.5}
        texture.Transform: {scale_x: 0.5, scale_y: 0.2}
      }

      post : CastleBark {
        Position: {0, (h + 0.14) / 2, 0}
        Cylinder: {length: h + 0.14, radius: 0.13, segments: 8}
        texture.Transform: {scale_x: 0.8, scale_y: h}
      }

      post_tip : CastleBark {
        Position: {0, h + 0.25, 0}
        Cone: {length: 0.22, radius: 0.13, segments: 8}
      }

      if !n && !e && !s && !w {
        for c in 0..4 {
          const a = c * HALF_PI + 0.7854
          "log_{c}" : CastleBark {
            Position: {sin(a) * 0.2, (h - 0.1) / 2, cos(a) * 0.2}
            Cylinder: {length: h - 0.1, radius: 0.1, segments: 7}
            texture.Transform: {scale_x: 0.6, scale_y: h}
          }

          "tip_{c}" : CastleBark {
            Position: {sin(a) * 0.2, h + 0.0, cos(a) * 0.2}
            Cone: {length: 0.2, radius: 0.1, segments: 7}
          }
        }
      }
    } else {
      core : CastleStone {
        Position: {0, h / 2, 0}
        Rotation: {0, 0.7854, 0}
        Cylinder: {length: h, radius: 0.5657, segments: 4}
        texture.Transform: {scale_x: 3.2 / TS, scale_y: h / TS}
      }

      base : CastleDarkStoneBlock {
        Position: {0, 0.22 + lvl * 0.06, 0}
        Box: {0.96, 0.44 + lvl * 0.12, 0.96}
      }

      walk : CastleOldWood {
        Position: {0, h + 0.01, 0}
        Box: {0.42, 0.02, 0.42}
        texture.Transform: {scale_x: 0.42, scale_y: 0.42}
      }
    }

    if lvl >= 2 {
      string_ : CastlePaleStone {
        Position: {0, h - 0.06, 0}
        Box: {0.88, 0.07, 0.88}
        texture.Transform: {scale_x: 0.8, scale_y: 0.1}
      }
    }

    if lvl >= 3 {
      mach : CastleStone {
        Position: {0, h - 0.02, 0}
        Box: {0.98, 0.16, 0.98}
        texture.Transform: {scale_x: 0.8, scale_y: 0.2}
      }
    }

    if lvl >= 2 && straight_x {
      m_a : CastleStone { Position: {0, h + 0.17, mz}; Box: {0.3, 0.34, 0.2} }
      m_b : CastleStone { Position: {0, h + 0.17, 0 - mz}; Box: {0.3, 0.34, 0.2} }

      if lvl >= 2 {
        c_a : CastlePaleStone { Position: {0, h + 0.35, mz}; Box: {0.33, 0.03, 0.23} }
        c_b : CastlePaleStone { Position: {0, h + 0.35, 0 - mz}; Box: {0.33, 0.03, 0.23} }
      }
    } else if lvl >= 2 && straight_z {
      m_a : CastleStone { Position: {mz, h + 0.17, 0}; Box: {0.2, 0.34, 0.3} }
      m_b : CastleStone { Position: {0 - mz, h + 0.17, 0}; Box: {0.2, 0.34, 0.3} }

      if lvl >= 2 {
        c_a : CastlePaleStone { Position: {mz, h + 0.35, 0}; Box: {0.23, 0.03, 0.33} }
        c_b : CastlePaleStone { Position: {0 - mz, h + 0.35, 0}; Box: {0.23, 0.03, 0.33} }
      }
    } else if lvl >= 2 {
      m_a : CastleStone { Position: {mz, h + 0.17, mz}; Box: {0.2, 0.34, 0.2} }
      m_b : CastleStone { Position: {0 - mz, h + 0.17, 0 - mz}; Box: {0.2, 0.34, 0.2} }
      m_c : CastleStone { Position: {mz, h + 0.17, 0 - mz}; Box: {0.2, 0.34, 0.2} }
      m_d : CastleStone { Position: {0 - mz, h + 0.17, mz}; Box: {0.2, 0.34, 0.2} }
    }

    if lvl >= 2 && seed > 0.62 && seed < 0.8 {
      Folk sentry(seed: seed, guard: true) {
        Position: {0.05, h + 0.02, 0.02}
        Rotation: {0, seed * 12, 0}
      }
    }

    const torches = (lvl >= 2 && seed > 0.3 && seed < 0.42) ||
      (lvl >= 3 && seed > 0.42 && seed < 0.5)
    const banners = (lvl >= 2 && seed < 0.12) || (lvl >= 3 && seed > 0.85)

    if straight_x {
      if torches {
        Torch torch_a { Position: {0, h * 0.6, 0.4} }
        Torch torch_b { Position: {0, h * 0.6, -0.4}; Rotation: {0, PI, 0} }
      }

      if banners {
        HangingBanner flag_a(blue: seed < 0.06, len: h * 0.45) { Position: {0, h - 0.2, 0.5} }
        HangingBanner flag_b(blue: seed < 0.06, len: h * 0.45) {
          Position: {0, h - 0.2, -0.5}
          Rotation: {0, PI, 0}
        }
      }
    } else if straight_z {
      if torches {
        Torch torch_a { Position: {0.4, h * 0.6, 0}; Rotation: {0, HALF_PI, 0} }
        Torch torch_b { Position: {-0.4, h * 0.6, 0}; Rotation: {0, -HALF_PI, 0} }
      }

      if banners {
        HangingBanner flag_a(blue: seed < 0.06, len: h * 0.45) {
          Position: {0.5, h - 0.2, 0}
          Rotation: {0, HALF_PI, 0}
        }

        HangingBanner flag_b(blue: seed < 0.06, len: h * 0.45) {
          Position: {-0.5, h - 0.2, 0}
          Rotation: {0, -HALF_PI, 0}
        }
      }
    }

    const from = lvl == 1 ? 0.05 : 0.4

    if e { WallArm arm_e(h: h, lvl: lvl, start: from, seed: seed) }

    if n {
      WallArm arm_n(h: h, lvl: lvl, start: from, seed: seed + 0.2) { Rotation: {0, HALF_PI, 0} }
    }

    if w { WallArm arm_w(h: h, lvl: lvl, start: from, seed: seed + 0.4) { Rotation: {0, PI, 0} } }

    if s {
      WallArm arm_s(h: h, lvl: lvl, start: from, seed: seed + 0.6) { Rotation: {0, -HALF_PI, 0} }
    }
  }

  template TowerDoor {
    prop level_: i32 = 1
    prop face: i32 = 0

    const lvl = clamp(level_, 1, 3)

    Rotation: {0, face * HALF_PI, 0}
    leaf : CastleWood {
      Position: {0, 0.62, 0.84}
      Box: {0.36, 0.56, 0.05}
      texture.Transform: {scale_x: 0.4, scale_y: 0.6}
    }

    arch : CastleWood {
      Position: {0, 0.9, 0.84}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {length: 0.05, radius: 0.18, segments: 12}
    }

    frame_ : CastlePaleStone {
      Position: {0, 0.92, 0.82}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {length: 0.05, radius: 0.24, segments: 12}
    }

    strap_a : CastleIron { Position: {0, 0.5, 0.87}; Box: {0.34, 0.03, 0.01} }
    strap_b : CastleIron { Position: {0, 0.75, 0.87}; Box: {0.34, 0.03, 0.01} }
    step : CastleDarkStone { Position: {0, 0.36, 1.0}; Box: {0.46, 0.08, 0.24} }

    if lvl >= 2 {
      Torch torch_a { Position: {-0.32, 1.0, 0.82} }
      Torch torch_b { Position: {0.32, 1.0, 0.82} }
    }
  }

  template TowerDormer {
    prop level_: i32 = 1
    prop seed: f32 = 0
    prop d: i32 = 0

    const lvl = clamp(level_, 1, 3)
    const h = 2.8 + lvl * 0.8
    const da = seed * 6.283 + 1 + d * PI

    Position: {sin(da) * 0.72, h + 0.95, cos(da) * 0.72}
    Rotation: {0, da, 0}
    front : CastleOldWood { Position: {0, 0, 0.06}; Box: {0.3, 0.32, 0.2} }
    Pane glass { Position: {0, -0.02, 0.165}; Box: {0.14, 0.18, 0.01} }
    cap : CastleSlate {
      Position: {0, 0.24, 0.05}
      Rotation: {0, HALF_PI, 0}
      TrianglePrism: {0.3, 0.18, 0.38}
      texture.Transform: {scale_x: 1, scale_y: 0.5}
    }
  }

  template TowerSlit {
    prop level_: i32 = 1
    prop seed: f32 = 0
    prop k: i32 = 0

    const lvl = clamp(level_, 1, 3)
    const h = 2.8 + lvl * 0.8
    const a = seed * 6.283 + k * 2.1
    const ky = 1.1 + k * (h - 1.4) / lvl

    Position: {sin(a) * 0.835, ky, cos(a) * 0.835}
    Rotation: {0, a, 0}
    Pane glass { Position: {0, 0, 0}; Box: {0.16, 0.36, 0.04} }
    sill : CastlePaleStone { Position: {0, -0.2, 0.03}; Box: {0.26, 0.05, 0.08} }
    shutter_a : CastleWood {
      Position: {-0.15, 0, 0.04}
      Rotation: {0, -0.5, 0}
      Box: {0.12, 0.36, 0.02}
    }

    shutter_b : CastleWood {
      Position: {0.15, 0, 0.04}
      Rotation: {0, 0.5, 0}
      Box: {0.12, 0.36, 0.02}
    }
  }

  template TowerPiece {
    prop level_: i32 = 1
    prop seed: f32 = 0
    prop hn: f32 = 0
    prop he: f32 = 0
    prop hs: f32 = 0
    prop hw: f32 = 0
    prop face: i32 = 0
    prop tn: bool = false
    prop te: bool = false
    prop ts: bool = false
    prop tw: bool = false

    const lvl = clamp(level_, 1, 3)
    const h = 2.8 + lvl * 0.8
    const rl = 1.2 + lvl * 0.4
    const top = h + 0.62 + rl
    const circ = 2 * PI * 0.84

    if he > 0 { WallArm arm_e(h: he, lvl: te ? 1 : 2, start: 0.55, merlons: false, seed: seed) }

    if hn > 0 {
      WallArm arm_n(h: hn, lvl: tn ? 1 : 2, start: 0.55, merlons: false, seed: seed) {
        Rotation: {0, HALF_PI, 0}
      }
    }

    if hw > 0 {
      WallArm arm_w(h: hw, lvl: tw ? 1 : 2, start: 0.55, merlons: false, seed: seed) {
        Rotation: {0, PI, 0}
      }
    }

    if hs > 0 {
      WallArm arm_s(h: hs, lvl: ts ? 1 : 2, start: 0.55, merlons: false, seed: seed) {
        Rotation: {0, -HALF_PI, 0}
      }
    }

    plinth : CastleDarkStone {
      Position: {0, 0.35, 0}
      Frustum: {length: 0.7, radius_bottom: 1.02, radius_top: 0.84, segments: 24}
      texture.Transform: {scale_x: 6.4 / TR, scale_y: 0.7 / TR}
    }

    body : CastleStone {
      Position: {0, h / 2, 0}
      Cylinder: {length: h, radius: 0.84, segments: 24}
      texture.Transform: {scale_x: circ / TS, scale_y: h / TS}
    }

    for b in 1..lvl {
      "band_{b}" : CastlePaleStone {
        Position: {0, b * h / lvl, 0}
        Cylinder: {length: 0.07, radius: 0.87, segments: 24}
        texture.Transform: {scale_x: 4, scale_y: 0.1}
      }
    }

    if lvl == 1 {
      parapet : CastleStone {
        Position: {0, h + 0.08, 0}
        Tube: {length: 0.16, radius: 0.9, thickness: 0.2, segments: 24}
        texture.Transform: {scale_x: 4, scale_y: 0.2}
      }

      deck : CastleOldWood {
        Position: {0, h + 0.01, 0}
        Cylinder: {length: 0.02, radius: 0.72, segments: 16}
      }

      for m in 0..10 {
        const a = m * 0.6283
        "merlon_{m}" : CastleStone {
          Position: {sin(a) * 0.82, h + 0.32, cos(a) * 0.82}
          Rotation: {0, a, 0}
          Box: {0.26, 0.32, 0.18}
        }
      }

      pole : CastleTimber {
        Position: {0, h + 0.7, 0}
        Cylinder: {length: 1.4, radius: 0.025, segments: 6}
      }

      pennant : CastleBanner {
        Position: {0.24, h + 1.25, 0}
        Rotation: {0, 0, -HALF_PI}
        TrianglePrism: {0.24, 0.46, 0.02}
      }

      Folk lookout(seed: seed + 0.3, guard: true) {
        Position: {0.35, h + 0.02, 0.2}
        Rotation: {0, seed * 9, 0}
      }
    } else {
      corbel : CastlePaleStone {
        Position: {0, h + 0.1, 0}
        Frustum: {length: 0.24, radius_bottom: 0.84, radius_top: 1.0, segments: 24}
        texture.Transform: {scale_x: 4, scale_y: 0.2}
      }

      for c in 0..(lvl * 7) {
        const a = c * 6.283 / (lvl * 7)
        "corbel_{c}" : CastleStone {
          Position: {sin(a) * 0.9, h - 0.06, cos(a) * 0.9}
          Rotation: {0, a, 0}
          Box: {0.1, 0.2, 0.14}
        }
      }

      parapet : CastleStone {
        Position: {0, h + 0.38, 0}
        Cylinder: {length: 0.32, radius: 1.0, segments: 24}
        texture.Transform: {scale_x: 6.3 / TS, scale_y: 0.32 / TS}
      }

      rim : CastlePaleStone {
        Position: {0, h + 0.55, 0}
        Cylinder: {length: 0.04, radius: 1.03, segments: 24}
        texture.Transform: {scale_x: 4, scale_y: 0.1}
      }

      eave : CastleTimber {
        Position: {0, h + 0.6, 0}
        Cylinder: {length: 0.06, radius: 1.08, segments: 24}
      }

      roof : CastleSlate {
        Position: {0, h + 0.63 + rl / 2, 0}
        Cone: {length: rl, radius: 1.16, segments: 24}
        texture.Transform: {scale_x: 7, scale_y: rl / 0.7}
      }

      for d in 0..(lvl - 1) {
        TowerDormer "dormer_{d}"(level_: level_, seed: seed, d: d)
      }

      finial : CastleGold {
        Position: {0, top + 0.05, 0}
        Sphere: {radius: 0.1, segments: 10, smooth: true}
      }

      pole : CastleIron {
        Position: {0, top + 0.5, 0}
        Cylinder: {length: 0.9, radius: 0.025, segments: 6}
      }

      if lvl >= 3 {
        pennant : CastleBannerBlue {
          Position: {0.42, top + 0.72, 0}
          Rotation: {0, 0, -HALF_PI}
          TrianglePrism: {0.36, 0.8, 0.02}
        }

        stripe : CastleGold { Position: {0.3, top + 0.72, 0}; Box: {0.5, 0.05, 0.025} }
        crown : CastleGold {
          Position: {0, top + 0.98, 0}
          Sphere: {radius: 0.05, segments: 8, smooth: true}
        }

        HangingBanner flag_a(blue: true, len: h * 0.35) {
          Position: {sin(seed * 6.283) * 0.86, h - 0.2, cos(seed * 6.283) * 0.86}
          Rotation: {0, seed * 6.283, 0}
        }

        HangingBanner flag_b(len: h * 0.35) {
          Position: {sin(seed * 6.283 + 2.1) * 0.86, h - 0.2, cos(seed * 6.283 + 2.1) * 0.86}
          Rotation: {0, seed * 6.283 + 2.1, 0}
        }
      } else {
        pennant : CastleBanner {
          Position: {0.32, top + 0.78, 0}
          Rotation: {0, 0, -HALF_PI}
          TrianglePrism: {0.3, 0.62, 0.02}
        }
      }
    }

    TowerDoor door(level_: level_, face: face)

    for k in 0..(lvl + 1) {
      const a = seed * 6.283 + k * 2.1
      const ky = 1.1 + k * (h - 1.4) / lvl

      if k == lvl {
        TowerSlit "slit_{k}"(level_: level_, seed: seed, k: k)
      } else {
        "slit_{k}" : CastleDark {
          Position: {sin(a) * 0.835, ky, cos(a) * 0.835}
          Rotation: {0, a, 0}
          Box: {0.08, 0.42, 0.04}
        }
      }
    }
  }

  template TimberGate {
    prop along_z: bool = false
    prop seed: f32 = 0

    Rotation: {0, along_z ? HALF_PI : 0, 0}

    floor_ : CastleDirt {
      Position: {0, 0.02, 0}
      Box: {0.66, 0.04, 2.0}
      texture.Transform: {scale_x: 0.6, scale_y: 1.6}
    }

    for t in 0..2 {
      const tx = match t { 0: -0.66; _: 0.66 }
      const ox = match t { 0: -0.36; _: 0.36 }
      "tower_{t}" {
        Position: {tx, 0, 0}
        bank : CastleSoil {
          Position: {0, 0.07, 0}
          Box: {0.72, 0.14, 1.02}
          texture.Transform: {scale_x: 0.7, scale_y: 0.2}
        }

        body : CastleWood {
          Position: {0, 1.2, 0}
          Box: {0.6, 2.3, 0.86}
          texture.Transform: {scale_x: 0.86, scale_y: 2.3}
        }

        band : CastleTimber { Position: {0, 1.5, 0}; Box: {0.66, 0.08, 0.92} }

        for c in 0..4 {
          const px = match c % 2 { 0: -0.3; _: 0.3 }
          const pz = c < 2 ? -0.43 : 0.43
          "post_{c}" : CastleBark {
            Position: {px, 1.6, pz}
            Cylinder: {length: 3.2, radius: 0.07, segments: 7}
            texture.Transform: {scale_x: 0.5, scale_y: 3}
          }
        }

        deck : CastleOldWood {
          Position: {0, 2.4, 0}
          Box: {0.8, 0.06, 1.06}
          texture.Transform: {scale_x: 0.8, scale_y: 1}
        }

        breast_f : CastleOldWood {
          Position: {0, 2.58, 0.52}
          Box: {0.8, 0.3, 0.04}
          texture.Transform: {scale_x: 0.8, scale_y: 0.3}
        }

        breast_b : CastleOldWood {
          Position: {0, 2.58, -0.52}
          Box: {0.8, 0.3, 0.04}
          texture.Transform: {scale_x: 0.8, scale_y: 0.3}
        }

        breast_o : CastleOldWood {
          Position: {ox * 1.08, 2.58, 0}
          Box: {0.04, 0.3, 1.06}
          texture.Transform: {scale_x: 1, scale_y: 0.3}
        }

        roof : CastleThatch {
          Position: {0, 3.5, 0}
          Rotation: {0, 0.7854, 0}
          Cone: {length: 0.62, radius: 0.74, segments: 4}
          texture.Transform: {scale_x: 2, scale_y: 0.8}
        }

        slit : CastleDark { Position: {0, 1.85, 0.432}; Box: {0.06, 0.3, 0.01} }
      }
    }

    lintel : CastleTimber { Position: {0, 2.05, 0}; Box: {0.74, 0.18, 0.9} }
    walk : CastleOldWood {
      Position: {0, 2.4, 0}
      Box: {0.72, 0.06, 1.0}
      texture.Transform: {scale_x: 0.7, scale_y: 1}
    }

    breast_f : CastleOldWood {
      Position: {0, 2.58, 0.48}
      Box: {0.72, 0.3, 0.04}
      texture.Transform: {scale_x: 0.7, scale_y: 0.3}
    }

    breast_b : CastleOldWood {
      Position: {0, 2.58, -0.48}
      Box: {0.72, 0.3, 0.04}
      texture.Transform: {scale_x: 0.7, scale_y: 0.3}
    }

    for b in 0..2 {
      const bx = match b { 0: -0.3; _: 0.3 }
      "brace_{b}" : CastleTimber {
        Position: {bx * 0.75, 1.82, 0.42}
        Rotation: {0, 0, match b { 0: 0.7; _: -0.7 }}
        Box: {0.06, 0.34, 0.06}
      }
    }

    door_l : CastleWood {
      Position: {-0.3, 0.85, -0.3}
      Rotation: {0, -1.2, 0}
      Box: {0.32, 1.6, 0.06}
      texture.Transform: {scale_x: 0.4, scale_y: 1.6}
    }

    door_r : CastleWood {
      Position: {0.3, 0.85, -0.3}
      Rotation: {0, 1.2, 0}
      Box: {0.32, 1.6, 0.06}
      texture.Transform: {scale_x: 0.4, scale_y: 1.6}
    }

    bar_ : CastleTimber {
      Position: {0.42, 0.9, -0.05}
      Rotation: {0, 0, 0.12}
      Box: {0.06, 1.2, 0.08}
    }

    HangingBanner banner_f(len: 0.55) { Position: {0, 2.3, 0.52} }
    Torch torch_a { Position: {-0.4, 1.6, 0.44} }
    Torch torch_b { Position: {0.4, 1.6, 0.44} }
    Folk lookout(seed: seed + 0.5, guard: true) {
      Position: {0.66, 2.43, 0.2}
      Rotation: {0, seed * 9, 0}
    }

    Folk guard_a(seed: seed, guard: true) {
      Position: {-0.48, 0.04, 0.95}
      Rotation: {0, 0.3, 0}
    }
  }

  template StoneGate {
    prop along_z: bool = false
    prop seed: f32 = 0

    Rotation: {0, along_z ? HALF_PI : 0, 0}

    floor_ : CastleCobble {
      Position: {0, 0.02, 0}
      Box: {0.7, 0.04, 2.0}
      texture.Transform: {scale_x: 0.6, scale_y: 1.6}
    }

    left {
      Position: {-0.66, 1.75, 0}
      Scale: {0.68, 1, 1.3}
      mass : CastleStone {
        Rotation: {0, 0.7854, 0}
        Cylinder: {length: 3.5, radius: 0.7071, segments: 4}
        texture.Transform: {scale_x: 4 / TS, scale_y: 3.5 / TS}
      }
    }

    right {
      Position: {0.66, 1.75, 0}
      Scale: {0.68, 1, 1.3}
      mass : CastleStone {
        Rotation: {0, 0.7854, 0}
        Cylinder: {length: 3.5, radius: 0.7071, segments: 4}
        texture.Transform: {scale_x: 4 / TS, scale_y: 3.5 / TS}
      }
    }

    left_base : CastleDarkStoneBlock { Position: {-0.66, 0.22, 0}; Box: {0.78, 0.44, 1.4} }
    right_base : CastleDarkStoneBlock { Position: {0.66, 0.22, 0}; Box: {0.78, 0.44, 1.4} }
    lintel : CastleStoneBlock { Position: {0, 3.0, 0}; Box: {0.66, 1.0, 1.1} }
    arch : CastlePaleStone {
      Position: {0, 2.42, 0}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {length: 1.12, radius: 0.33, segments: 16}
    }

    voussoir_f : CastlePaleStone {
      Position: {0, 2.42, 0.56}
      Rotation: {HALF_PI, 0, 0}
      Tube: {length: 0.06, radius: 0.44, thickness: 0.11, segments: 16}
    }

    voussoir_b : CastlePaleStone {
      Position: {0, 2.42, -0.56}
      Rotation: {HALF_PI, 0, 0}
      Tube: {length: 0.06, radius: 0.44, thickness: 0.11, segments: 16}
    }

    string_ : CastlePaleStone {
      Position: {0, 3.4, 0}
      Box: {2.04, 0.08, 1.38}
      texture.Transform: {scale_x: 2, scale_y: 0.1}
    }

    walk : CastleOldWood {
      Position: {0, 3.45, 0}
      Box: {2.0, 0.02, 0.5}
      texture.Transform: {scale_x: 2, scale_y: 0.5}
    }

    machicolation : CastleStone { Position: {0, 3.15, 0.66}; Box: {0.8, 0.3, 0.16} }

    for c in 0..4 {
      "corbel_{c}" : CastlePaleStone {
        Position: {-0.3 + c * 0.2, 2.95, 0.66}
        Box: {0.08, 0.14, 0.14}
      }
    }

    for b in 0..5 {
      "bar_{b}" : CastleIron {
        Position: {-0.24 + b * 0.12, 1.6, 0.42}
        Box: {0.035, 1.8, 0.035}
      }
    }

    for r in 0..3 {
      "rail_{r}" : CastleIron { Position: {0, 1.0 + r * 0.55, 0.42}; Box: {0.64, 0.035, 0.035} }
    }

    for t in 0..5 {
      "tooth_{t}" : CastleIron {
        Position: {-0.24 + t * 0.12, 0.68, 0.42}
        Cone: {length: 0.08, radius: 0.025, segments: 4}
        Rotation: {PI, 0, 0}
      }
    }

    door_l : CastleWood {
      Position: {-0.3, 0.75, -0.3}
      Rotation: {0, -1.2, 0}
      Box: {0.34, 1.4, 0.05}
      texture.Transform: {scale_x: 0.4, scale_y: 1.4}
    }

    door_r : CastleWood {
      Position: {0.3, 0.75, -0.3}
      Rotation: {0, 1.2, 0}
      Box: {0.34, 1.4, 0.05}
      texture.Transform: {scale_x: 0.4, scale_y: 1.4}
    }

    for m in 0..4 {
      const mx = match m % 2 { 0: -0.2; _: 0.2 }
      const mz = m < 2 ? 0.54 : -0.54
      "merlon_l_{m}" : CastleStone { Position: {mx - 0.66, 3.63, mz}; Box: {0.2, 0.34, 0.22} }
      "merlon_r_{m}" : CastleStone { Position: {mx + 0.66, 3.63, mz}; Box: {0.2, 0.34, 0.22} }
    }

    for t in 0..2 {
      const tx = match t { 0: -0.9; _: 0.9 }
      "turret_{t}" {
        Position: {tx, 0, 0.5}
        body : CastleStone {
          Position: {0, 2.1, 0}
          Cylinder: {length: 4.2, radius: 0.28, segments: 14}
          texture.Transform: {scale_x: 1.76 / TS, scale_y: 4.2 / TS}
        }

        rim : CastlePaleStone {
          Position: {0, 4.22, 0}
          Cylinder: {length: 0.08, radius: 0.33, segments: 14}
        }

        roof : CastleSlate {
          Position: {0, 4.66, 0}
          Cone: {length: 0.84, radius: 0.38, segments: 14}
          texture.Transform: {scale_x: 2.5, scale_y: 1.2}
        }

        finial : CastleGold {
          Position: {0, 5.1, 0}
          Sphere: {radius: 0.05, segments: 8, smooth: true}
        }

        slit : CastleDark { Position: {0, 2.6, 0.27}; Box: {0.05, 0.26, 0.02} }
      }
    }

    HangingBanner banner_f(len: 0.7) { Position: {0, 3.25, 0.58} }
    HangingBanner banner_b(blue: true, len: 0.7) {
      Position: {0, 3.25, -0.58}
      Rotation: {0, PI, 0}
    }

    Torch torch_a { Position: {-0.42, 1.7, 0.62} }
    Torch torch_b { Position: {0.42, 1.7, 0.62} }

    Folk guard_a(seed: seed, guard: true) {
      Position: {-0.48, 0.04, 0.95}
      Rotation: {0, 0.3, 0}
    }

    Folk guard_b(seed: seed + 0.37, guard: true) {
      Position: {0.48, 0.04, 0.95}
      Rotation: {0, -0.3, 0}
    }
  }

  template GatePiece {
    prop level_: i32 = 1
    prop along_z: bool = false
    prop seed: f32 = 0

    if level_ <= 1 {
      TimberGate frame(along_z: along_z, seed: seed)
    } else {
      StoneGate frame(along_z: along_z, seed: seed)
    }
  }
}

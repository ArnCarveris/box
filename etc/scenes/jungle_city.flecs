include jungle_city/city
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers

window { Surface: {width: 1600, height: 1100, vsync: true} }
canopy_ao { Gtao: {radius: 1.3, final_value_power: 1.6} }
canopy_bloom { Bloom: {intensity: 0.045, threshold: 1.8} }
canopy_mist { HeightFog: {density: 0.002, falloff: 0.09, base_height: 0, max_opacity: 0.22, color: {170, 205, 183}, sun_inscatter: 0.3, ambient_inscatter: 0.6} }
canopy_tonemap { Tonemap: {} }
canopy_aa { Smaa: {} }

jungle_city {
  Scene: {}
  AmbientLight: {sky: {179, 214, 208}, ground: {92, 119, 76}, intensity: 0.42}
  LightBake: {probe_spacing: 6, bounds_padding: 0.3, bounces: 1, capture_size: 32, budget_ms: 8}
  assets.JungleCity city(rows: 9, columns: 10, spacing: 17, seed: 17) { camera {} }
}

main_view {
  View: {
    camera: jungle_city.city.camera,
    clear: {enabled: true, color: {85, 116, 119, 255}},
    lighting: {enabled: true, baked: true},
    shadows: {enabled: true, resolution: 4096, max_distance: 1000},
    effects: [{effect: canopy_ao}, {effect: canopy_mist}, {effect: canopy_bloom}, {effect: canopy_tonemap}, {effect: canopy_aa}]
  }
}

// Cornell box: a closed white room with a red and a green wall, lit by a spot light in the
// ceiling that only reaches the middle of the floor. Everything else is lit by baked indirect
// light, so the white surfaces next to the red wall turn pink and those next to the green wall
// turn green as the bounces bake. The front of the room is a quad facing inward: the bake sees
// a closed room, the camera outside looks through it. Fly with WASD (QE for down/up), hold the
// right mouse button to look around. Change room.LightBake.bounces to compare 0, 1 and 3.

using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers

window {
  Surface: {width: 1280, height: 720, vsync: true}
}

tonemap {
  Tonemap: {}
}

room {
  Scene: {}
  LightBake: {probe_spacing: 0.5, bounds_padding: -0.5, bounces: 3}
  AmbientLight: {sky: {0, 0, 0}, ground: {0, 0, 0}, intensity: 0}

  camera {
    Position: {0, 2.4, 8.5}
    Rotation: {-0.08, 0, 0}
    Camera: {fov: 50}
    CameraController: {}
  }

  darkness {
    DirectionalLight: {intensity: 0}
  }

  opening {
    Position: {0, 2, 2}
    Rotation: {0, 3.1416, 0}
    Quad: {4.4, 4.4}
    Rgb: {235, 235, 230}
  }

  floor {
    Position: {0, -0.1, 0}
    Box: {4.4, 0.2, 4.4}
    Rgb: {235, 235, 230}
  }

  ceiling {
    Position: {0, 4.1, 0}
    Box: {4.4, 0.2, 4.4}
    Rgb: {235, 235, 230}
  }

  back {
    Position: {0, 2, -2.1}
    Box: {4.4, 4, 0.2}
    Rgb: {235, 235, 230}
  }

  red_wall {
    Position: {-2.1, 2, 0}
    Box: {0.2, 4, 4}
    Rgb: {210, 30, 25}
  }

  green_wall {
    Position: {2.1, 2, 0}
    Box: {0.2, 4, 4}
    Rgb: {30, 200, 40}
  }

  tall_block {
    Position: {-0.7, 0.65, -0.6}
    Rotation: {0, 0.3, 0}
    Box: {1.1, 1.3, 1.1}
    Rgb: {235, 235, 230}
  }

  short_block {
    Position: {0.75, 0.35, 0.6}
    Rotation: {0, -0.3, 0}
    Box: {1.1, 0.7, 1.1}
    Rgb: {235, 235, 230}
  }

  lamp {
    Position: {0, 3.98, 0}
    Box: {0.6, 0.04, 0.6}
    Rgb: {255, 255, 255}
    Emissive: {strength: 2, color: {255, 255, 255}}
  }

  spot {
    Position: {0, 3.9, 0}
    Rotation: {1.5708, 0, 0}
    SpotLight: {intensity: 14, range: 10, inner_angle: 15, outer_angle: 25}
    Rgb: {255, 255, 255}
  }
}

main_view {
  View: {
    camera: room.camera,
    clear: {enabled: true, color: {12, 12, 14, 255}},
    effects: [{effect: tonemap}]
  }
}

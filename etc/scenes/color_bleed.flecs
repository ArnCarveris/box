// Cornell box lit by a ceiling spot light and baked indirect light, so the white surfaces turn
// pink and green next to the colored walls. Set Bake.bounces to 0, 1 or 3 to compare.

using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers

$ {
  box.app.FpsTarget: {60}
  Scene: {baked: true}
  Bake: {probe_spacing: 0.5, bounds_padding: -0.3, bounces: 3}
  AmbientLight: {sky: {0, 0, 0}, ground: {0, 0, 0}, intensity: 0}
}

window {
  Surface: {width: 1280, height: 720, vsync: true}
}

camera {
  Position: {0, 2, 7.6}
  Camera: {fov: 46}
  CameraController: {speed: 2, boost: 3}
}

sky {
  DirectionalLight: {intensity: 0}
}

view {
  tonemap {
    Tonemap: {}
  }

  smaa {
    Smaa: {}
  }

  View: {
    camera: camera,
    clear: {enabled: true, color: {0, 0, 0, 255}},
    effects: [{effect: tonemap}, {effect: smaa}]
  }
}

color_bleed {
  floor {
    Position: {0, 0, 0}
    Rotation: {-1.5708, 0, 0}
    Quad: {4, 4}
    Rgb: {250, 250, 246}
  }

  ceiling {
    Position: {0, 4, 0}
    Rotation: {1.5708, 0, 0}
    Quad: {4, 4}
    Rgb: {250, 250, 246}
  }

  back {
    Position: {0, 2, -2}
    Quad: {4, 4}
    Rgb: {250, 250, 246}
  }

  opening {
    Position: {0, 2, 2}
    Rotation: {0, 3.1416, 0}
    Quad: {4, 4}
    Rgb: {250, 250, 246}
  }

  red_wall {
    Position: {-2, 2, 0}
    Rotation: {0, 1.5708, 0}
    Quad: {4, 4}
    Rgb: {235, 30, 22}
  }

  green_wall {
    Position: {2, 2, 0}
    Rotation: {0, -1.5708, 0}
    Quad: {4, 4}
    Rgb: {28, 215, 36}
  }

  tall_block {
    Position: {-0.7, 0.65, -0.6}
    Rotation: {0, 0.3, 0}
    Box: {1.1, 1.3, 1.1}
    Rgb: {250, 250, 246}
  }

  short_block {
    Position: {0.75, 0.35, 0.6}
    Rotation: {0, -0.3, 0}
    Box: {1.1, 0.7, 1.1}
    Rgb: {250, 250, 246}
  }

  lamp {
    Position: {0, 3.98, 0}
    Box: {0.6, 0.04, 0.6}
    Rgb: {255, 255, 255}
    Emissive: {strength: 2, color: {255, 255, 255}}
  }

  spot {
    Position: {0, 3.9, 0}
    Rotation: {1.5708, 0, 0}
    SpotLight: {intensity: 35 * flecs.script.math.PI, range: 10, inner_angle: 15, outer_angle: 25}
    Rgb: {255, 255, 255}
  }
}

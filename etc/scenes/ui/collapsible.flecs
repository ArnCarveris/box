// Collapsible: a section whose header shows or hides its content.

module box.widgets

using flecs.script
using box.ui
using box.input
using box.picking
using box.layout
using box.geometry
using box.material
using box.text
using box.transform
using box.transition

// Behavior of a collapsible section: current is whether it is open. A click on the header, or
// Enter and Space while focused, toggle it. While closed the section is only as tall as its
// header and clips its content away.
template HeadlessCollapsible {
  prop title: string = ""
  prop value: bool = false
  prop disabled: bool = false
  prop width: f32 = 0
  prop header: f32 = 0

  mut current = value
  mut last_value = value
  mut hover = false
  mut down = false
  mut focused = false

  ClipChildren

  if !disabled {
    Focusable
  } else {
    Cursor: {CursorNotAllowed}
  }

  if current {
    Item: {width: {min: width, max: width}, height: {mode: Fit, value: 1}}
  } else {
    Item: {width: {min: width, max: width}, height: {mode: Fixed, value: header}}
  }

  head {
    if !disabled {
      Cursor: {CursorPointer}
    }
  }

  async {
    if value != last_value {
      last_value = value
      current = value
    }
  }

  // A disabled section ignores the pointer, so it never shows as hovered or pressed
  async {
    while true {
      await on.enter(head)
      hover = !disabled
    }
  }

  async {
    while true {
      await on.leave(head)
      hover = false
    }
  }

  async {
    while true {
      await on.press(head)
      down = !disabled
    }
  }

  async {
    while true {
      await on.release(head)
      down = false
    }
  }

  async {
    while true {
      const e = await on.focus(this)

      if e.target == this {
        focused = true
      }
    }
  }

  async {
    while true {
      const e = await on.blur(this)

      if e.target == this {
        focused = false
        down = false
      }
    }
  }

  async {
    while true {
      const e = await on.key_down(this)

      if focused && e.key == " " && !e.repeat {
        down = true
      }
    }
  }

  async {
    while true {
      const e = await on.key_up(this)

      if focused && e.key == " " {
        down = false
      }
    }
  }

  // The activations of the widgets in the content and the clicks on it bubble up and do nothing
  async {
    while true {
      const e = await on.activate(this)

      if ui.activation(e) == this {
        down = false

        if !disabled && (e.keyboard || hover) {
          current = !current
          await ui.changed(this)
        }
      }
    }
  }
}

// A collapsible section: a rounded card with a header row (bold title, chevron) above the
// content laid out in a column. A width fixes the outer width of the section, 0 fits it.
template Collapsible : HeadlessCollapsible {
  prop header: f32 = 32

  const t = box.ui.theme[Theme]
  const ring = focused && FocusStatus[FocusStatus].visible
  const bright: Rgb = {
    t.text.r + (255 - t.text.r) / 4, t.text.g + (255 - t.text.g) / 4,
    t.text.b + (255 - t.text.b) / 4
  }
  const light: Rgb = {
    (t.border.r + t.text.r) / 2, (t.border.g + t.text.g) / 2, (t.border.b + t.text.b) / 2
  }
  const edge = ring ? t.focus : hover ? light : t.border
  const fill = down ? t.pressed : t.surface_alt

  Layout: {
    direction: Column, spacing: t.spacing,
    padding: {0, current ? t.padding : 0, t.padding, t.padding}
  }
  Rect: {1, 1}
  Rgb: fill
  Border: {
    width: ring ? t.focus_width : 1, radius: t.radius * 1.5,
    color: {edge.r, edge.g, edge.b, 255}
  }
  Transition: [Rgb: WidgetFade, Border: WidgetFade]

  // The header has no box of its own; the Rect, in the color of the section, makes it pickable
  head {
    Layout: {direction: Row, spacing: t.spacing, v: Middle}
    Item: {width: {mode: Grow}, height: {mode: Fixed, value: header}}
    Rect: {1, 1}
    Rgb: fill
    Transition: [Rgb: WidgetFade]

    caption {
      Text: {value: title, size: t.font_size, font: box.text.DefaultFontBold}
      Rgb: hover ? bright : t.text
      Transition: [Rgb: WidgetFade]
    }

    gap {
      Item: {width: {mode: Grow}}
    }

    Chevron chevron(
      direction: current ? "down" : "right", color: hover ? t.text : t.text_muted
    )
  }

  if disabled {
    Opacity: {t.disabled_opacity}
  }
}

using flecs.script
using flecs.script.math
using box.app
using box.camera
using box.view
using box.effects
using box.surface
using box.geometry
using box.input
using box.layout
using box.material
using box.picking
using box.text
using box.texture
using box.transform
using box.transition
using box.ui
using box.widgets
using state

window {}

box {
  ui {
    theme {
      UiTheme: {
        background: {3, 10, 17},
        surface: {5, 16, 26},
        surface_alt: {9, 27, 41},
        border: {34, 86, 110},
        text: {214, 236, 246},
        text_muted: {112, 152, 176},
        accent: {95, 216, 255},
        accent_text: {5, 16, 26},
        hover: {14, 40, 58},
        pressed: {3, 10, 17},
        focus: {170, 238, 255},
        danger: {255, 92, 76},
        selection: {24, 70, 96},
        caret: {214, 236, 246},
        disabled_opacity: 0.38,
        font_size: 13,
        small_font_size: 11,
        heading_font_size: 13,
        radius: 1,
        padding: 8,
        spacing: 6,
        control_height: 26,
        focus_width: 2,
        caret_blink: 0.5
      }
    }
  }
}

assets {
  yard_font_body { Font: {path: "etc/scenes/shipyard/assets/fonts/ChakraPetch-Medium.ttf"} }
  yard_font_title { Font: {path: "etc/scenes/shipyard/assets/fonts/ChakraPetch-SemiBold.ttf"} }
  yard_font_mono { Font: {path: "etc/scenes/shipyard/assets/fonts/ShareTechMono-Regular.ttf"} }
  yard_icon_cockpit { Path: {path: "etc/scenes/shipyard/assets/icons/cockpit.svg", width: 96} }
  yard_icon_hab { Path: {path: "etc/scenes/shipyard/assets/icons/hab.svg", width: 96} }
  yard_icon_life { Path: {path: "etc/scenes/shipyard/assets/icons/life.svg", width: 96} }
  yard_icon_reactor { Path: {path: "etc/scenes/shipyard/assets/icons/reactor.svg", width: 96} }
  yard_icon_radiator { Path: {path: "etc/scenes/shipyard/assets/icons/radiator.svg", width: 96} }
  yard_icon_cargo { Path: {path: "etc/scenes/shipyard/assets/icons/cargo.svg", width: 96} }
  yard_icon_fuel { Path: {path: "etc/scenes/shipyard/assets/icons/fuel.svg", width: 96} }
  yard_icon_weapon { Path: {path: "etc/scenes/shipyard/assets/icons/weapon.svg", width: 96} }
  yard_icon_engine { Path: {path: "etc/scenes/shipyard/assets/icons/engine.svg", width: 96} }
  yard_icon_biome { Path: {path: "etc/scenes/shipyard/assets/icons/biome.svg", width: 96} }
  yard_icon_dock { Path: {path: "etc/scenes/shipyard/assets/icons/dock.svg", width: 96} }
  yard_icon_obs { Path: {path: "etc/scenes/shipyard/assets/icons/obs.svg", width: 96} }
  yard_icon_hull { Path: {path: "etc/scenes/shipyard/assets/icons/hull.svg", width: 96} }
  yard_icon_drill { Path: {path: "etc/scenes/shipyard/assets/icons/drill.svg", width: 96} }
  yard_icon_builder { Path: {path: "etc/scenes/shipyard/assets/icons/builder.svg", width: 96} }
  yard_icon_datacenter { Path: {path: "etc/scenes/shipyard/assets/icons/datacenter.svg", width: 96} }
  yard_icon_autopilot { Path: {path: "etc/scenes/shipyard/assets/icons/autopilot.svg", width: 96} }
  yard_icon_remove { Path: {path: "etc/scenes/shipyard/assets/icons/remove.svg", width: 96} }
  yard_icon_deck { Path: {path: "etc/scenes/shipyard/assets/icons/deck.svg", width: 96} }
  yard_icon_power { Path: {path: "etc/scenes/shipyard/assets/icons/power.svg", width: 96} }
  yard_icon_crew { Path: {path: "etc/scenes/shipyard/assets/icons/crew.svg", width: 96} }
  yard_icon_thrust { Path: {path: "etc/scenes/shipyard/assets/icons/thrust.svg", width: 96} }
  yard_icon_range { Path: {path: "etc/scenes/shipyard/assets/icons/range.svg", width: 96} }
  yard_icon_ok { Path: {path: "etc/scenes/shipyard/assets/icons/ok.svg", width: 96} }
  yard_icon_warn { Path: {path: "etc/scenes/shipyard/assets/icons/warn.svg", width: 96} }
  yard_icon_ship { Path: {path: "etc/scenes/shipyard/assets/icons/ship.svg", width: 96} }
  yard_icon_liner { Path: {path: "etc/scenes/shipyard/assets/icons/liner.svg", width: 96} }
  yard_icon_spine { Path: {path: "etc/scenes/shipyard/assets/icons/spine.svg", width: 96} }
  yard_icon_quarters { Path: {path: "etc/scenes/shipyard/assets/icons/quarters.svg", width: 96} }
  yard_icon_truss { Path: {path: "etc/scenes/shipyard/assets/icons/truss.svg", width: 96} }
  yard_icon_yoke { Path: {path: "etc/scenes/shipyard/assets/icons/yoke.svg", width: 96} }
  yard_icon_bridge { Path: {path: "etc/scenes/shipyard/assets/icons/bridge.svg", width: 96} }
  yard_icon_sensor { Path: {path: "etc/scenes/shipyard/assets/icons/sensor.svg", width: 96} }
  yard_icon_ring { Path: {path: "etc/scenes/shipyard/assets/icons/ring.svg", width: 96} }
  yard_icon_arbor { Path: {path: "etc/scenes/shipyard/assets/icons/arbor.svg", width: 96} }
  yard_icon_core { Path: {path: "etc/scenes/shipyard/assets/icons/core.svg", width: 96} }
  yard_icon_wing { Path: {path: "etc/scenes/shipyard/assets/icons/wing.svg", width: 96} }
  yard_icon_drive { Path: {path: "etc/scenes/shipyard/assets/icons/drive.svg", width: 96} }
  yard_icon_jump { Path: {path: "etc/scenes/shipyard/assets/icons/jump.svg", width: 96} }
  yard_icon_tanks { Path: {path: "etc/scenes/shipyard/assets/icons/tanks.svg", width: 96} }
  yard_icon_freight { Path: {path: "etc/scenes/shipyard/assets/icons/freight.svg", width: 96} }
  yard_icon_hangar { Path: {path: "etc/scenes/shipyard/assets/icons/hangar.svg", width: 96} }
  yard_icon_slip { Path: {path: "etc/scenes/shipyard/assets/icons/slip.svg", width: 96} }
  yard_icon_assembler { Path: {path: "etc/scenes/shipyard/assets/icons/assembler.svg", width: 96} }
  yard_icon_shield { Path: {path: "etc/scenes/shipyard/assets/icons/shield.svg", width: 96} }
  yard_icon_railgun { Path: {path: "etc/scenes/shipyard/assets/icons/railgun.svg", width: 96} }
  yard_icon_armor { Path: {path: "etc/scenes/shipyard/assets/icons/armor.svg", width: 96} }
  yard_icon_battery { Path: {path: "etc/scenes/shipyard/assets/icons/battery.svg", width: 96} }
  yard_icon_farm { Path: {path: "etc/scenes/shipyard/assets/icons/farm.svg", width: 96} }
}


state {
  export const UI_OK: i32 = 0
  export const UI_WARN: i32 = 1
  export const UI_BAD: i32 = 2
  export const UI_GOOD: i32 = 3
  export const UI_DIM: i32 = 4
  export const UI_MUTED: i32 = 5
  export const UI_NAVY: i32 = 6
  export const UI_TEXT: i32 = 7
  export const UI_HAZARD: i32 = 8
  export const UI_SOFT: i32 = 9

  fn ui_r(s: i32) -> i32 { match s { 0: 95; 1: 255; 2: 255; 3: 110; 4: 14; 5: 64; 6: 5; 8: 226; 9: 112; _: 214 } }
  fn ui_g(s: i32) -> i32 { match s { 0: 216; 1: 179; 2: 92; 3: 232; 4: 36; 5: 96; 6: 16; 8: 169; 9: 152; _: 236 } }
  fn ui_b(s: i32) -> i32 { match s { 0: 255; 1: 71; 2: 76; 3: 150; 4: 52; 5: 116; 6: 26; 8: 28; 9: 176; _: 246 } }

  fn kind_icon(k: i32) -> entity {
    match k {
      1: assets.yard_icon_cockpit
      2: assets.yard_icon_hab
      3: assets.yard_icon_life
      4: assets.yard_icon_reactor
      5: assets.yard_icon_cargo
      6: assets.yard_icon_fuel
      7: assets.yard_icon_weapon
      8: assets.yard_icon_engine
      9: assets.yard_icon_biome
      10: assets.yard_icon_obs
      11: assets.yard_icon_dock
      12: assets.yard_icon_hull
      13: assets.yard_icon_radiator
      14: assets.yard_icon_drill
      15: assets.yard_icon_builder
      16: assets.yard_icon_datacenter
      17: assets.yard_icon_autopilot
      40: assets.yard_icon_bridge
      41: assets.yard_icon_sensor
      42: assets.yard_icon_quarters
      43: assets.yard_icon_ring
      44: assets.yard_icon_arbor
      45: assets.yard_icon_core
      46: assets.yard_icon_wing
      47: assets.yard_icon_jump
      48: assets.yard_icon_drive
      49: assets.yard_icon_tanks
      50: assets.yard_icon_freight
      51: assets.yard_icon_hangar
      52: assets.yard_icon_assembler
      53: assets.yard_icon_slip
      54: assets.yard_icon_truss
      55: assets.yard_icon_yoke
      56: assets.yard_icon_armor
      57: assets.yard_icon_battery
      58: assets.yard_icon_farm
      59: assets.yard_icon_shield
      60: assets.yard_icon_railgun
      _: assets.yard_icon_remove
    }
  }

  fn lane_name(d: i32) -> string {
    match d { 0: "Core"; 1: "Port"; 2: "Stbd"; 3: "Dorsal"; _: "Ventral" }
  }

  fn op_selected(op: i32, d: i32) -> bool {
    op == OP_DECK + d || (op == OP_LINERS && liner) || (op == OP_RIGS && !liner) ||
    (op == OP_SHOW_UI && show_ui) || (op == OP_SHOW_GANTRY && show_gantry)
  }
}

assets {
  template YardIcon {
    prop icon: entity = 0
    prop size: f32 = 20
    prop state: i32 = 0

    Item: {width: {mode: Fixed, value: size}, height: {mode: Fixed, value: size}}
    Rect: {1, 1}
    Image: {texture: icon}
    Rgb: {ui_r(state), ui_g(state), ui_b(state)}
  }

  template YardHazard {
    prop w: f32 = 5

    Item: {width: {mode: Fixed, value: w}, height: {mode: Grow}}
    Rect: {1, 1}
    Image: {texture: yard_tex_hazard}
    ImageSlice: {scale: 0.05, edges: SliceTile, center: SliceTile}
    Border: {radius: 1}
  }

  template YardPanel {
    prop title: string = ""
    prop note: string = ""
    prop width: f32 = 0
    prop spacing: f32 = 8

    Layout: {direction: Column, padding: {10, 12, 12, 12}, spacing: spacing}
    Item: {width: {min: width, max: width}}
    Rect: {1, 1}
    Rgb: {5, 16, 26}
    Border: {width: 1, radius: 2, color: {34, 86, 110, 255}}
    BoxShadow: {offset_y: -4, blur: 18, spread: 1, color: {0, 0, 0, 160}}
    InputBlocker

    if title != "" {
      heading {
        Layout: {direction: Row, spacing: 8, v: Middle}
        Item: {width: {mode: Grow}}
        tab {
          Layout: {padding: {2, 2, 7, 7}}
          Rect: {1, 1}
          Rgb: {95, 216, 255}
          Border: {radius: 1}
          name {
            Text: {value: title, size: 12, font: yard_font_title}
            Rgb: {5, 16, 26}
          }
        }
        rail {
          Item: {width: {mode: Grow}, height: {mode: Fixed, value: 3}}
          Rect: {1, 1}
          Rgb: {28, 74, 96}
        }
        if note != "" {
          aside {
            Text: {value: note, size: 12, font: yard_font_mono}
            Rgb: {112, 152, 176}
          }
        }
      }
    }
  }

  template YardStrip {
    Layout: {direction: Row, padding: {3, 3, 3, 3}, spacing: 2, v: Middle}
    Rect: {1, 1}
    Rgb: {5, 16, 26}
    Border: {width: 1, radius: 2, color: {34, 86, 110, 255}}
    BoxShadow: {offset_y: -3, blur: 14, spread: 1, color: {0, 0, 0, 150}}
    InputBlocker
  }

  template YardStripLabel {
    prop text: string = ""

    Layout: {padding: {0, 0, 8, 6}}
    caption {
      Text: {value: text, size: 10, font: yard_font_title}
      Rgb: {72, 118, 142}
    }
  }

  template YardDivider {
    Item: {width: {mode: Fixed, value: 1}, height: {mode: Fixed, value: 16}}
    Rect: {1, 1}
    Rgb: {28, 74, 96}
  }

  template YardRule {
    Item: {width: {mode: Grow}, height: {mode: Fixed, value: 1}}
    Rect: {1, 1}
    Rgb: {18, 48, 64}
  }

  template YardFiller {
    Item: {width: {mode: Grow}}
  }

  template YardAction : HeadlessButton {
    prop op: i32 = 0

    async {
      while true {
        const e = await on.activate(this)
        if ui.activation(e) == this {
          emit Request(op: op)
        }
      }
    }
  }

  template YardSegmentFace {
    prop op: i32 = 0
    prop label: string = ""
    prop icon: entity = 0
    prop hover: bool = false
    prop down: bool = false

    const selected = op_selected(op, liner ? lane : deck)

    Layout: {direction: Row, padding: {0, 0, 10, 10}, spacing: 6, h: Center, v: Middle}
    Item: {width: {mode: Grow}, height: {mode: Grow}}
    Rect: {1, 1}
    if selected {
      Rgb: {95, 216, 255}
    } else if down {
      Rgb: {3, 10, 17}
    } else if hover {
      Rgb: {14, 40, 58}
    } else {
      Rgb: {5, 16, 26}
    }
    Border: {radius: 1}
    Transition: [Rgb: {duration: 0.08}]

    if icon != 0 {
      YardIcon glyph(icon: icon, size: 14, state: selected ? UI_NAVY : UI_SOFT)
    }
    name {
      Text: {value: label, size: 12, font: selected ? yard_font_title : yard_font_body}
      if selected {
        Rgb: {5, 16, 26}
      } else if hover {
        Rgb: {214, 236, 246}
      } else {
        Rgb: {150, 184, 204}
      }
    }
  }

  template YardSegment : YardAction {
    prop icon: entity = 0
    prop grow: bool = false

    if grow {
      Item: {width: {mode: Grow}, height: {mode: Fixed, value: 26}}
    } else {
      Item: {width: {min: 30}, height: {mode: Fixed, value: 26}}
    }
    Layout: {}

    YardSegmentFace face(op: op, label: label, icon: icon, hover: hover, down: down)
  }

  template YardGhostFace {
    prop label: string = ""
    prop icon: entity = 0
    prop danger: bool = false
    prop hover: bool = false
    prop down: bool = false

    Layout: {direction: Row, padding: {4, 4, danger ? 4 : 10, 10}, spacing: 7, h: Center, v: Middle}
    Item: {width: {mode: Grow}, height: {mode: Grow}}
    Rect: {1, 1}
    if down {
      Rgb: {3, 10, 17}
    } else if hover {
      Rgb: {14, 40, 58}
    } else {
      Rgb: {5, 16, 26}
    }
    Border: {radius: 1}
    Transition: [Rgb: {duration: 0.08}]

    if danger {
      YardHazard stripe(w: 4)
    }
    if icon != 0 {
      YardIcon glyph(icon: icon, size: 14, state: danger ? UI_HAZARD : UI_SOFT)
    }
    name {
      Text: {value: label, size: 12, font: yard_font_body}
      if hover {
        Rgb: {214, 236, 246}
      } else {
        Rgb: {150, 184, 204}
      }
    }
  }

  template YardGhost : YardAction {
    prop icon: entity = 0
    prop danger: bool = false

    Item: {height: {mode: Fixed, value: 26}}
    Layout: {}

    YardGhostFace face(label: label, icon: icon, danger: danger, hover: hover, down: down)
  }

  template YardTileFace {
    prop op: i32 = 0
    prop label: string = ""
    prop key_hint: string = ""
    prop hover: bool = false
    prop down: bool = false

    const selected = op == tool
    const danger = op == T_REMOVE

    Layout: {direction: Row, padding: {danger ? 4 : 0, danger ? 4 : 0, danger ? 4 : 8, 6}, spacing: 8, v: Middle}
    Item: {width: {mode: Grow}, height: {mode: Grow}}
    Rect: {1, 1}
    if selected && danger {
      Rgb: {226, 169, 28}
      Border: {width: 1, radius: 1, color: {255, 214, 110, 255}}
    } else if selected {
      Rgb: {95, 216, 255}
      Border: {width: 1, radius: 1, color: {170, 238, 255, 255}}
    } else if down {
      Rgb: {5, 16, 26}
      Border: {width: 1, radius: 1, color: {95, 216, 255, 255}}
    } else if hover {
      Rgb: {14, 40, 58}
      Border: {width: 1, radius: 1, color: {95, 216, 255, 255}}
    } else {
      Rgb: {9, 27, 41}
      Border: {width: 1, radius: 1, color: {22, 58, 78, 255}}
    }
    Transition: [Rgb: {duration: 0.08}]

    if danger {
      YardHazard stripe(w: 5)
    }
    YardIcon glyph(icon: kind_icon(op), size: 16, state: selected ? UI_NAVY : danger ? UI_HAZARD : UI_OK)
    words {
      Layout: {direction: Column}
      Item: {width: {mode: Grow}}
      name {
        Text: {value: label, size: 12, font: selected ? yard_font_title : yard_font_body}
        if selected {
          Rgb: {5, 16, 26}
        } else {
          Rgb: {214, 236, 246}
        }
      }
    }
    if key_hint != "" {
      hint {
        Layout: {padding: {1, 1, 5, 5}}
        Rect: {1, 1}
        Rgb: {5, 16, 26}
        Border: {width: 1, radius: 1, color: {34, 86, 110, 255}}
        key {
          Text: {value: key_hint, size: 11, font: yard_font_mono}
          Rgb: {150, 184, 204}
        }
      }
    }
  }

  template YardTile : YardAction {
    prop key_hint: string = ""

    Item: {width: {mode: Grow}, height: {mode: Fixed, value: 30}}
    Layout: {direction: Column}

    YardTileFace face(op: op, label: label, key_hint: key_hint, hover: hover, down: down)
  }

  template YardGroup {
    prop title: string = ""

    Layout: {direction: Column, spacing: 4}
    Item: {width: {mode: Grow}}
    heading {
      Layout: {direction: Row, spacing: 6, padding: {0, 1, 0, 0}, v: Middle}
      Item: {width: {mode: Grow}}
      name {
        Text: {value: title, size: 10, font: yard_font_title}
        Rgb: {84, 132, 158}
      }
      YardRule rule()
    }
  }

  template YardTileRow {
    Layout: {direction: Row, spacing: 4}
    Item: {width: {mode: Grow}}
  }

  template YardMeter {
    prop ratio: f32 = 0
    prop state: i32 = 0

    const fill = clamp(ratio, 0.0, 1.0)

    Layout: {direction: Row}
    Item: {width: {mode: Grow}, height: {mode: Fixed, value: 3}}
    Rect: {1, 1}
    Rgb: {ui_r(UI_DIM), ui_g(UI_DIM), ui_b(UI_DIM)}
    lit {
      Item: {width: {mode: Grow, value: fill, content_min: false}, height: {mode: Grow}}
      Rect: {1, 1}
      Rgb: {ui_r(state), ui_g(state), ui_b(state)}
    }
    unlit {
      Item: {width: {mode: Grow, value: 1 - fill, content_min: false}}
    }
  }

  template YardStat {
    prop icon: entity = 0
    prop label: string = ""
    prop value: string = ""
    prop ratio: f32 = 0
    prop state: i32 = 0

    const shown = state == UI_OK ? UI_TEXT : state

    Layout: {direction: Column, spacing: 4}
    Item: {width: {mode: Grow}}
    head {
      Layout: {direction: Row, spacing: 8, v: Middle}
      Item: {width: {mode: Grow}}
      YardIcon glyph(icon: icon, size: 14, state: state)
      name {
        Text: {value: label, size: 11, font: yard_font_body}
        Rgb: {112, 152, 176}
      }
      gap {
        Item: {width: {mode: Grow}}
      }
      amount {
        Text: {value: value, size: 13, font: yard_font_mono}
        Rgb: {ui_r(shown), ui_g(shown), ui_b(shown)}
      }
    }
    YardMeter meter(ratio: ratio, state: state)
  }

  template YardCheck {
    prop label: string = ""
    prop ok: bool = false

    Layout: {direction: Row, spacing: 8, v: Middle}
    Item: {width: {mode: Grow}}
    YardIcon glyph(icon: ok ? yard_icon_ok : yard_icon_warn, size: 13, state: ok ? UI_GOOD : UI_WARN)
    name {
      Text: {value: label, size: 11, font: yard_font_body}
      if ok {
        Rgb: {112, 152, 176}
      } else {
        Rgb: {255, 210, 150}
      }
    }
  }

  template YardVerdict {
    prop label: string = ""
    prop ok: bool = false

    const s = ok ? UI_GOOD : UI_WARN

    Layout: {direction: Row, padding: {4, 4, 8, 8}, spacing: 7, v: Middle}
    Item: {width: {mode: Grow}}
    Rect: {1, 1}
    Rgb: {ui_r(s), ui_g(s), ui_b(s)}
    Border: {radius: 1}
    YardIcon glyph(icon: ok ? yard_icon_ok : yard_icon_warn, size: 14, state: UI_NAVY)
    name {
      Text: {value: label, size: 12, font: yard_font_title}
      Rgb: {5, 16, 26}
    }
  }

  template ModulesCard : YardPanel {
    YardGroup command(title: "COMMAND") {
      YardTileRow row_a {
        YardTile cockpit(label: liner ? "Bridge" : "Cockpit", op: liner ? L_BRIDGE : K_COCKPIT)
        YardTile autopilot(label: liner ? "Sensor Mast" : "Autopilot", op: liner ? L_SENSOR : K_AUTO)
      }
    }
    YardGroup crew_group(title: liner ? "HABITATION" : "CREW") {
      YardTileRow row_a {
        YardTile hab(label: liner ? "Quarters" : "Habitat", op: liner ? L_QUARTERS : K_HAB)
        YardTile life(label: liner ? "Hab Ring" : "Life Support", op: liner ? L_HABRING : K_LIFE)
      }
      YardTileRow row_b {
        YardTile biome(label: liner ? "Estate Ring" : "Biome", op: liner ? L_ESTATE : K_BIOME)
        if liner {
          YardTile farm(label: "Agri Ring", op: L_FARM)
        } else {
          YardTile obs(label: "Observation", op: K_OBS)
        }
      }
    }
    YardGroup systems(title: liner ? "POWER & JUMP" : "POWER & COMPUTE") {
      YardTileRow row_a {
        YardTile power(label: liner ? "Reactor" : "Power Plant", op: liner ? L_REACTOR : K_POWER)
        YardTile radiator(label: "Radiator", op: liner ? L_RADIATOR : K_RADIATOR)
      }
      YardTileRow row_b {
        YardTile datacenter(label: liner ? "Jump Drive" : "Datacenter", op: liner ? L_JUMP : K_DATA)
        YardFiller filler()
      }
    }
    YardGroup drive(title: "PROPULSION") {
      YardTileRow row_a {
        YardTile engine(label: liner ? "Main Drive" : "Engine", op: liner ? L_DRIVE : K_ENGINE)
        YardTile fuel(label: liner ? "Tank Cluster" : "Fuel Tank", op: liner ? L_TANKS : K_FUEL)
      }
    }
    YardGroup industry(title: "INDUSTRY & LOGISTICS") {
      YardTileRow row_a {
        YardTile cargo(label: liner ? "Container Block" : "Cargo Bay", op: liner ? L_CARGO : K_CARGO)
        YardTile dock(label: liner ? "Hangar" : "Docking Port", op: liner ? L_HANGAR : K_DOCK)
      }
      YardTileRow row_b {
        YardTile drill(label: liner ? "Heavy Assembler" : "Mining Drill", op: liner ? L_ASSEMBLER : K_DRILL)
        YardTile builder(label: liner ? "Fab Bay" : "Constructor", op: liner ? L_FAB : K_BUILDER)
      }
    }
    YardGroup hull(title: liner ? "STRUCTURE & DEFENSE" : "HULL & DEFENSE") {
      YardTileRow row_a {
        YardTile fairing(label: liner ? "Armor" : "Hull Fairing", op: liner ? L_ARMOR : K_HULL)
        YardTile weapon(label: liner ? "Gun Turret" : "Weapons", op: liner ? L_TURRET : K_WEAPON)
      }
      if liner {
        YardTileRow row_b {
          YardTile shield(label: "Shield", op: L_SHIELD)
          YardTile railgun(label: "Railgun", op: L_RAILGUN)
        }
        YardTileRow row_c {
          YardTile truss(label: "Truss", op: L_TRUSS)
          YardTile yoke(label: "Yoke", op: L_YOKE)
        }
      }
    }
    YardRule remove_rule()
    YardTile remove(label: "Remove", op: T_REMOVE, key_hint: "X")
  }
}

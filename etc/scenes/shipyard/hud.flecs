using flecs.script
using flecs.script.math
using box.app
using box.camera
using box.view
using box.effects
using box.surface
using box.geometry
using box.input
using box.layout
using box.material
using box.picking
using box.text
using box.texture
using box.transform
using box.transition
using box.ui
using box.widgets
using state

window {}

box {
  ui {
    theme {
      UiTheme: {
        background: {6, 12, 20},
        surface: {7, 13, 23},
        surface_alt: {11, 24, 37},
        border: {44, 104, 134},
        text: {214, 236, 246},
        text_muted: {146, 176, 196},
        accent: {92, 222, 255},
        accent_text: {6, 18, 26},
        hover: {18, 44, 62},
        pressed: {8, 22, 34},
        focus: {150, 240, 255},
        danger: {255, 88, 74},
        selection: {20, 78, 104},
        caret: {214, 236, 246},
        disabled_opacity: 0.38,
        font_size: 13,
        small_font_size: 11,
        heading_font_size: 13,
        radius: 2,
        padding: 8,
        spacing: 6,
        control_height: 26,
        focus_width: 2,
        caret_blink: 0.5
      }
    }
  }
}


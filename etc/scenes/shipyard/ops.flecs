using flecs.script
using flecs.script.math
using box.app
using box.material
using state

state {
  export const CHANNELS: i32 = 9
  export const MAX_BARS: i32 = 8
  export const REACTOR_BARS: i32 = 12
  export const U_REACTOR: i32 = 0
  export const U_JUMP: i32 = 1

  export const C_LIFE: i32 = 0
  export const C_HAB: i32 = 1
  export const C_JUMP: i32 = 2
  export const C_WEAPONS: i32 = 3
  export const C_DRIVE: i32 = 4
  export const C_FAB: i32 = 5
  export const C_MINING: i32 = 6
  export const C_DATA: i32 = 7
  export const C_SHIELDS: i32 = 8

  export const OP_DRIVE: i32 = 170
  export const OP_REFUEL: i32 = 171
  export const OP_UNIT: i32 = 200
  export const OP_POWER: i32 = 300

  export const TICK: f32 = 0.1
  export const COOLING: f32 = 1.6
  export const PASSIVE: f32 = 0.15
  export const BURN_TIME: f32 = 90
  export const HEAT_STEPS: i32 = 8

  struct OpsUnit(cell: i32, kind: i32, on: bool, trip: bool, heat: f32, charge: f32)

  export mut units: OpsUnit[] = []
  export mut slot_on: LinerFlags = {}
  export mut slot_trip: LinerFlags = {}
  export mut slot_heat: LinerLevels = {}
  export mut cell_on: RigFlags = {}
  export mut cell_trip: RigFlags = {}
  export mut cell_heat: RigLevels = {}
  export mut ship_heat: f32 = 0
  export mut heat_falling: bool = false

  export mut need: i32[CHANNELS] = {}
  export mut want: i32[CHANNELS] = {}
  export mut alloc: i32[CHANNELS] = {}
  export mut pf: f32[CHANNELS] = {}
  export mut supply: i32 = 0
  export mut radiators: i32 = 0
  export mut drives: i32 = 0
  export mut tanks: i32 = 0

  export mut drive_on: bool = false
  export mut burning: bool = false
  export mut fuel: f32 = 1

  fn chan_name(c: i32) -> string {
    match c {
      0: "LIFE"
      1: "HAB"
      2: "JUMP"
      3: "WPN"
      4: "DRV"
      5: "FAB"
      6: "MINE"
      7: "DATA"
      _: "SHLD"
    }
  }

  fn chan_title(c: i32) -> string {
    match c {
      0: "Life support"; 1: "Habitats"; 2: "Jump drive"; 3: "Weapons"; 4: "Main drive"
      5: "Manufacturing"; 6: "Mining"; 7: "Datacenter"; _: "Shields"
    }
  }

  fn chan_rank(c: i32) -> i32 {
    match c { 0: 0; 1: 1; 7: 2; 4: 3; 8: 4; 2: 5; 3: 6; 5: 7; _: 8 }
  }

  fn chan_at_rank(r: i32) -> i32 {
    match r { 0: 0; 1: 1; 2: 7; 3: 4; 4: 8; 5: 2; 6: 3; 7: 5; _: 6 }
  }

  fn liner_chan(k: i32) -> i32 {
    match k {
      58: C_LIFE; 42: C_HAB; 43: C_HAB; 44: C_HAB; 47: C_JUMP; 57: C_WEAPONS; 60: C_WEAPONS
      48: C_DRIVE; 52: C_FAB; 53: C_FAB; 51: C_MINING; 40: C_DATA; 41: C_DATA; 59: C_SHIELDS
      _: -1
    }
  }

  fn rig_chan(k: i32) -> i32 {
    match k {
      3: C_LIFE; 9: C_LIFE; 1: C_HAB; 2: C_HAB; 10: C_HAB; 7: C_WEAPONS; 8: C_DRIVE
      15: C_FAB; 14: C_MINING; 16: C_DATA; 17: C_DATA
      _: -1
    }
  }

  fn liner_souls() -> i32 {
    lc(L_QUARTERS) * 60 + lc(L_HABRING) * 900 + lc(L_BRIDGE) * 40 + lc(L_HANGAR) * 30 +
    lc(L_ASSEMBLER) * 30 + lc(L_FAB) * 30 + lc(L_TURRET) * 15 + lc(L_RAILGUN) * 20
  }

  fn bar_size() -> f32 { liner ? 10 : 2.5 }

  fn power_unit() -> string { liner ? "GW" : "MW" }

  fn chan_demand(c: i32) -> f32 {
    mut d: f32 = 0

    if liner {
      for k in L_BASE..L_END {
        if liner_chan(k) == c {
          d += lc(k) * lkind_power(k)
        }
      }

      if c == C_LIFE {
        d += liner_souls() * 0.01
      }
    } else {
      for k in 1..KINDS {
        if rig_chan(k) == c {
          d += counts[k] * kind_power(k)
        }
      }
    }

    d
  }

  fn bars_for(d: f32) -> i32 {
    mut n: i32 = 0

    while n < MAX_BARS && n * bar_size() < d - 0.001 {
      n += 1
    }

    n
  }

  fn used_bars() -> i32 {
    mut n: i32 = 0

    for c in 0..CHANNELS {
      n += alloc[c]
    }

    n
  }

  fn free_bars() -> i32 { supply - used_bars() }

  fn online() -> i32 {
    mut n: i32 = 0

    for u in 0..units.count() {
      if units[u].kind == U_REACTOR && units[u].on {
        n += 1
      }
    }

    n
  }

  fn unit_count(kind: i32) -> i32 {
    mut n: i32 = 0

    for u in 0..units.count() {
      if units[u].kind == kind {
        n += 1
      }
    }

    n
  }

  fn unit_ordinal(u: i32) -> i32 {
    mut n: i32 = 1

    for v in 0..u {
      if units[v].kind == units[u].kind {
        n += 1
      }
    }

    n
  }

  fn unit_place(i: i32) -> string {
    liner ? "{lane_name(lane_of(i))} {slot_of(i) + 1}" : "Deck {cell_y(i) + 1}"
  }

  fn heat_kelvin(h: f32) -> i32 { 290 + h * 1910 }

  fn ship_mass() -> f32 {
    mut m: f32 = 0

    if liner {
      m = liner_mass()
    } else {
      for k in 1..KINDS {
        m += counts[k] * kind_mass(k)
      }
    }

    m
  }

  fn full_thrust() -> f32 {
    liner ? drives * 60.0 / max(ship_mass(), 1) : drives * 260.0 / max(ship_mass(), 1)
  }

  fn burn_rate() -> f32 {
    tanks == 0 ? 0 : drives * pf[C_DRIVE] / (BURN_TIME * tanks)
  }

  // Power fraction of a channel, 1 for what is on no channel
  fn chan_power(c: i32) -> f32 {
    mut p: f32 = 1

    if c >= 0 {
      p = pf[c]
    }

    p
  }

  fn ops_live(idx: i32, k: i32) -> f32 {
    match k {
      45: slot_on[idx] ? 1 : 0
      47: slot_on[idx] ? 0.25 + 0.75 * pf[C_JUMP] : 0
      48: burning ? pf[C_DRIVE] : 0
      _: chan_power(liner_chan(k))
    }
  }

  // The power level of each slot of the liner for the Liner template, which fires the drives
  // itself while burning: what ops_live gives for each slot, without the burn of the drives.
  fn liner_levels() -> LinerLevels {
    mut p: LinerLevels = {}

    for i in 0..LCELLS {
      const k = lgrid[i]
      p[i] = k == L_DRIVE ? pf[C_DRIVE] : ops_live(i, k)
    }

    p
  }

  // Share of the supply that the channels draw, in quarters, so it changes only with the routing
  fn load_level() -> f32 {
    mut q: f32 = 0

    if supply > 0 {
      q = round(used_bars() * 4.0 / supply) / 4
    }

    q
  }

  // Power level 0..1 of the rig module of kind k at cell i, like ops_live for liner slots. A
  // power plant follows its unit and runs harder with the load, an engine shows its burn and
  // every other module the power of its channel.
  fn rig_live(i: i32, k: i32) -> f32 {
    mut p: f32 = 0

    if k == K_POWER {
      if cell_on[i] {
        p = 0.5 + 0.5 * load_level()
      }
    } else if k == K_ENGINE {
      p = burning ? pf[C_DRIVE] : 0
    } else {
      p = chan_power(rig_chan(k))
    }

    p
  }

  // Heat level of the rig module at cell i: its unit for a power plant, the ship for a radiator
  fn rig_heat(i: i32, k: i32) -> f32 {
    mut h: f32 = 0

    if k == K_RADIATOR {
      h = ship_heat
    } else if k == K_POWER {
      h = cell_heat[i]
    }

    h
  }

  fn rig_trip(i: i32) -> bool { cell_trip[i] }

  fn rig_power() -> RigPower {
    mut live: RigLevels = {}
    mut heat: RigLevels = {}
    mut trip: RigFlags = {}

    for i in 0..CELLS {
      const k = grid[i]

      if k != 0 {
        live[i] = rig_live(i, k)
        heat[i] = rig_heat(i, k)
        trip[i] = k == K_POWER && rig_trip(i)
      }
    }

    const p: RigPower = {lit: true, live: live, heat: heat, trip: trip, cool: heat_falling}
    p
  }

  // Heat in HEAT_STEPS levels, so that what shows it changes a few times per heat cycle and
  // not every tick; a transition at least as long as a step bridges the levels.
  fn heat_level(h: f32) -> f32 { round(clamp(h, 0, 1) * HEAT_STEPS) / HEAT_STEPS }

  // Heat level of the units and of the ship, updated only when a level changes
  fn mark_heat() {
    mut sh: LinerLevels = {}
    mut ch: RigLevels = {}
    mut top: f32 = 0

    for u in 0..units.count() {
      if liner {
        sh[units[u].cell] = heat_level(units[u].heat)
      } else {
        ch[units[u].cell] = heat_level(units[u].heat)
      }

      top = max(top, units[u].heat)
    }

    mut same_cells = true

    for i in 0..CELLS {
      if ch[i] != cell_heat[i] {
        same_cells = false
      }
    }

    if !same_cells {
      cell_heat = ch
    }

    mut same = true

    for i in 0..LCELLS {
      if sh[i] != slot_heat[i] {
        same = false
      }
    }

    if !same {
      slot_heat = sh
    }

    // Radiators hold working units at a heat of about 0.3 to 0.6; scaling by 1.6 spreads that
    // over the whole glow range, so a ship at work glows and a cooling one fades through the levels
    const q = radiators > 0 ? heat_level(top * 1.6) : 0

    if q != ship_heat {
      heat_falling = q < ship_heat
      ship_heat = q
    }
  }

  fn route() {
    mut left: i32 = supply
    mut a: i32[CHANNELS] = {}

    for r in 0..CHANNELS {
      const c = chan_at_rank(r)
      const n = min(want[c], left)
      a[c] = n
      left -= n
    }

    alloc = a
    mut f: f32[CHANNELS] = {}
    mut same = true

    for c in 0..CHANNELS {
      f[c] = need[c] > 0 ? a[c] * 1.0 / need[c] : 0

      if f[c] != pf[c] {
        same = false
      }
    }

    if !same {
      pf = f
    }
  }

  fn resupply() {
    const s = online() * REACTOR_BARS

    if s != supply {
      supply = s
    }

    route()
  }

  fn mark_slots() {
    mut so: LinerFlags = {}
    mut st: LinerFlags = {}
    mut co: RigFlags = {}
    mut ct: RigFlags = {}

    for u in 0..units.count() {
      if liner {
        so[units[u].cell] = units[u].on
        st[units[u].cell] = units[u].trip
      } else {
        co[units[u].cell] = units[u].on
        ct[units[u].cell] = units[u].trip
      }
    }

    slot_on = so
    slot_trip = st
    cell_on = co
    cell_trip = ct
  }

  fn ops_sync() {
    mut nu: OpsUnit[] = []
    const total = liner ? LCELLS : CELLS

    for i in 0..total {
      const k = liner ? lgrid[i] : grid[i]
      const kind = liner ? (k == L_REACTOR ? U_REACTOR : k == L_JUMP ? U_JUMP : -1) :
        (k == K_POWER ? U_REACTOR : -1)

      if kind >= 0 {
        mut unit: OpsUnit = {cell: i, kind: kind, on: kind == U_REACTOR}

        for u in 0..units.count() {
          if units[u].cell == i && units[u].kind == kind {
            unit = units[u]
          }
        }

        nu.push(unit)
      }
    }

    units = nu
    mark_slots()

    radiators = liner ? lc(L_RADIATOR) : counts[K_RADIATOR]
    drives = liner ? lc(L_DRIVE) : counts[K_ENGINE]
    const t = liner ? lc(L_TANKS) : counts[K_FUEL]

    if t > tanks && tanks == 0 {
      fuel = 1
    }

    tanks = t

    if tanks == 0 {
      fuel = 0
    }

    mut nn: i32[CHANNELS] = {}
    mut nw: i32[CHANNELS] = {}

    for c in 0..CHANNELS {
      nn[c] = bars_for(chan_demand(c))
      nw[c] = want[c] >= need[c] ? nn[c] : min(want[c], nn[c])
    }

    need = nn
    want = nw

    resupply()
    mark_heat()
  }

  fn toggle_unit(u: i32) {
    if u >= 0 && u < units.count() {
      mut us = units
      us[u].on = !us[u].on

      if us[u].on {
        us[u].trip = false
      }

      units = us
      mark_slots()
      resupply()
    }
  }

  fn set_power(c: i32, level: i32) {
    if c >= 0 && c < CHANNELS {
      want[c] = clamp(want[c] == level ? level - 1 : level, 0, need[c])
      route()
    }
  }

  fn ops_step(dt: f32) {
    const load: f32 = supply > 0 ? used_bars() * 1.0 / supply : 0
    mut active: i32 = 0

    for u in 0..units.count() {
      if units[u].on || units[u].heat > 0.02 {
        active += 1
      }
    }

    const share: f32 = radiators * COOLING / max(active, 1) + PASSIVE
    mut us = units
    mut tripped = false

    for u in 0..us.count() {
      mut gain: f32 = 0

      if us[u].on && us[u].kind == U_REACTOR {
        gain = 0.25 + 0.75 * load
      } else if us[u].on {
        gain = us[u].charge < 1 ? 1.1 * pf[C_JUMP] : 0.3
        us[u].charge = min(us[u].charge + dt * 0.08 * pf[C_JUMP], 1)
      } else {
        us[u].charge = max(us[u].charge - dt * 0.02, 0)
      }

      us[u].heat = max(us[u].heat + (gain - share * us[u].heat) * 0.25 * dt, 0)

      if us[u].heat > 1 && us[u].on {
        us[u].on = false
        us[u].trip = true
        tripped = true
      }
    }

    units = us

    if tripped {
      mark_slots()
      resupply()
    }

    mark_heat()

    if drive_on && (fuel <= 0 || drives == 0) {
      drive_on = false
    }

    if drive_on {
      fuel = max(fuel - dt * burn_rate(), 0)
    }

    const burn = drive_on && fuel > 0 && pf[C_DRIVE] > 0

    if burn != burning {
      burning = burn
    }
  }
}

async {
  mut seen: i32 = -1
  mut was_liner = false

  while true {
    if layout_rev != seen || liner != was_liner {
      seen = layout_rev
      was_liner = liner
      ops_sync()
    }

    ops_step(TICK)
    await delay(TICK)
  }
}

async {
  while true {
    const e = await Request
    const op = e.op

    if op == OP_DRIVE {
      drive_on = !drive_on && fuel > 0 && drives > 0
    } else if op == OP_REFUEL {
      fuel = tanks > 0 ? 1 : 0
    } else if op >= OP_UNIT && op < OP_UNIT + units.count() {
      toggle_unit(op - OP_UNIT)
    } else if op >= OP_POWER && op < OP_POWER + CHANNELS * 10 {
      set_power((op - OP_POWER - (op - OP_POWER) % 10) / 10, (op - OP_POWER) % 10)
    }
  }
}

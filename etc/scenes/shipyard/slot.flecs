using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.picking
using box.input
using box.spatial
using box.transition
using box.movement
using box.particle
using box.light
using box.animation
using state

assets {
  template SlotCursor {
    prop r: f32 = 1
    prop color: Rgb = {255, 255, 255}

    const cr = r * 1.4

    for s in 0..2 {
      "hoop_{s}" {
        Position: {0, 0, (s - 0.5) * SEG}
        Rotation: {HALF_PI, 0, 0}
        Torus: {radius: cr, tube: 0.045, segments: 40, rings: 3}
        Rgb: color
        Emissive: {strength: 3, color: color}
        NoShadow
        Ignore
      }
    }

    for i in 0..4 {
      const a = PI / 4 + i * HALF_PI
      "edge_{i}" {
        Position: {cos(a) * cr, sin(a) * cr, 0}
        Box: {0.05, 0.05, SEG}
        Rgb: color
        Emissive: {strength: 3, color: color}
        NoShadow
        Ignore
      }
    }
  }

  // The Liner instance leaves the segments of the lane being worked on out and the slot draws its
  // segment itself, so a pick on any part of it reaches the slot.
  template LinerSlot {
    prop idx: i32 = 0
    mut rising = false
    mut sparking = false

    const l = lane_of(idx)
    const z = slot_of(idx)
    const k = lgrid[idx]
    const r = lane_r(l)
    const active = l == lane
    const hovered = lhover == idx
    const t = tool
    const editing = t > 0
    const placing = editing && t != T_REMOVE
    const swap = placing && k != t
    const fault = lstatus[idx]

    Position: {lane_x(l), lane_y(l), slot_z(z)}

    if active {
      Interactive
      Cursor: {CursorPointer}
    }

    if active && k != 0 {
      const tint: Tint = match t == T_REMOVE {
        true: {255, 70, 50, 150}
        _: match swap { true: {90, 255, 160, 120}; _: {0, 0, 0, 0} }
      }
      LinerPart unit(
        idx: idx, k: k, n: liner_near(lgrid, l, z), live: ops_live(idx, k),
        heat: k == L_RADIATOR ? ship_heat : slot_heat[idx], trip: slot_trip[idx],
        cool: k == L_RADIATOR && heat_falling,
        lifted: rising,
        tinted: hovered && tint.a > 0,
        tint: tint
      )
    }

    if k != 0 && fault != 0 {
      warning {
        Position: {0, r * 1.5 + 1.4, 0}
        AngularVelocity: {0, 1.6, 0}
        Ignore
        NoShadow
        gem : ShipWarning {
          Position: {0, 0, 0}
          Rotation: {0.7854, 0, 0.7854}
          Box: {0.6, 0.6, 0.6}
        }

        glow { Position: {0, 0, 0}; PointLight: {intensity: 3, range: 5}; Rgb: {255, 60, 40} }
      }
    }

    if active && k == 0 && editing {
      pad {
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: r, length: SEG * 0.94, segments: 32, smooth: true}
        Rgb: {60, 180, 255}
        Emissive: {strength: hovered ? 0.6 : 0.08, color: {60, 180, 255}}
        Opacity: {hovered ? 0.2 : 0.05}
        NoShadow
      }
    }

    if hovered {
      const color: Rgb = match swap {
        true: {90, 255, 140}
        _: match t == T_REMOVE && k != 0 { true: {255, 110, 60}; _: {140, 220, 255} }
      }
      SlotCursor cursor(r: r, color: color)

      if placing && k == 0 {
        ghost {
          Rotation: {0, 0, lane_angle(l)}
          Opacity: {0.55}
          Tint: {90, 255, 160, 120}
          Ignore
          NoShadow
          LinerSegment part(k: t, l: l, z: z, seed: idx, n: liner_near(lgrid, l, z))
        }
      }
    }

    if sparking {
      sparks {
        Position: {0, 0, 0}
        Emitter: {
          max: 240, rate: 260, shape: EmitterBox, extents: {r, r, 1.9},
          direction: {0, 1, 0}, spread: 70, speed: {1.5, 5},
          lifetime: {0.25, 0.7}, size: {0.03, 0.08}, opacity: {0.6, 1},
          acceleration: {0, -4, 0}, color: {140, 220, 255}, seed: 30 + idx
        }
        Appearance: {blend: Additive, stretch: 0.06}
        Curves: {opacity: {keys: [{0, 1}, {0.7, 0.8}, {1, 0}]}}
      }
    }

    async {
      while true {
        await on.enter(this)
        lhover = idx
      }
    }

    async {
      while true {
        await on.leave(this)

        if lhover == idx {
          lhover = -1
        }
      }
    }

    async {
      while true {
        const ev = await on.click(this)

        if ev.button == 0 {
          emit SlotClick(slot: idx)
        }
      }
    }

    async {
      while true {
        const e = await Built

        if e.cell == idx {
          rising = true
          sparking = true
          await delay(0.12)
          rising = false
          await delay(0.7)
          sparking = false
        }
      }
    }
  }

  // While a tool is out the Liner instance fades and lets picks pass, so only the lane being
  // worked on, which the editor draws itself, stands out. The editor is authored in the units of
  // the segments and scaled by LINER_SCALE to the liner.
  template YardLiner {
    Liner ship(
      design: lgrid, power: liner_levels(), shield: pf[C_SHIELDS], burning: burning,
      heat: slot_heat, radiator_heat: ship_heat, cooling: heat_falling, trip: slot_trip, skip: lane
    ) {
      Position: {0, AXIS_Y * LINER_SCALE, 0}

      if tool > 0 {
        Opacity: {0.16}
        Ignore
      }
    }

    editor {
      Position: {0, 0, 0}
      Scale: {LINER_SCALE, LINER_SCALE, LINER_SCALE}
      texture.Frame
      slots {
        Position: {0, AXIS_Y, 0}

        for i in 0..LCELLS {
          LinerSlot "edit_{i}"(idx: i)
        }
      }
    }
  }
}

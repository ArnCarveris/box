    LINER_BATTLESHIP, 4, 10, 12, L_HANGAR
  ]

  fn lane_of(i: i32) -> i32 { (i - i % SLOTS) / SLOTS }
  fn slot_of(i: i32) -> i32 { i % SLOTS }
  fn lcell(l: i32, z: i32) -> i32 { l * SLOTS + z }

  fn lane_angle(l: i32) -> f32 {
    match l { 1: PI; 3: HALF_PI; 4: 0 - HALF_PI; _: 0 }
  }

  fn lane_x(l: i32) -> f32 { l == 0 ? 0 : cos(lane_angle(l)) * OUT_D }
  fn lane_y(l: i32) -> f32 { l == 0 ? 0 : sin(lane_angle(l)) * OUT_D }
  fn lane_r(l: i32) -> f32 { l == 0 ? R_CORE : R_OUT }
  fn slot_z(z: i32) -> f32 { (z - SLOTS / 2.0 + 0.5) * SEG }

  fn ringed(k: i32) -> bool { k == L_HABRING || k == L_ESTATE || k == L_FARM }
  fn housed(k: i32) -> bool { k == L_QUARTERS || ringed(k) }
  fn core_only(k: i32) -> bool { ringed(k) || k == L_YOKE }

  // The kind in slot z of lane l of design d, 0 outside the liner.
  fn lkind(d: LinerDesign, l: i32, z: i32) -> i32 {
    const k = d[lcell(clamp(l, 0, LANES - 1), clamp(z, 0, SLOTS - 1))]
    z >= 0 && z < SLOTS && l >= 0 && l < LANES ? k : 0
  }

  fn liner_near(d: LinerDesign, l: i32, z: i32) -> LinerNear {
    const n: LinerNear = {
      kf: lkind(d, l, z + 1), kb: lkind(d, l, z - 1),
      p1: lkind(d, 1, z) == L_TRUSS, p2: lkind(d, 2, z) == L_TRUSS,
      p3: lkind(d, 3, z) == L_TRUSS, p4: lkind(d, 4, z) == L_TRUSS
    }
    n
  }

  fn liner_count(d: LinerDesign, k: i32) -> i32 {
    mut n: i32 = 0

    for i in 0..LCELLS {
      if d[i] == k {
        n += 1
      }
    }

    n
  }

  // The front (bow, +z) and back of the occupied slots of design d along the spine.
  fn liner_front(d: LinerDesign) -> f32 {
    mut z1: i32 = -1

    for i in 0..LCELLS {
      if d[i] != 0 {
        z1 = max(z1, slot_of(i))
      }
    }

    slot_z(z1) + SEG / 2
  }

  fn liner_back(d: LinerDesign) -> f32 {
    mut z0: i32 = SLOTS

    for i in 0..LCELLS {
      if d[i] != 0 {
        z0 = min(z0, slot_of(i))
      }
    }

    slot_z(z0) - SEG / 2
  }

  // The design of preset p (LINER_PASSENGER to LINER_BATTLESHIP), empty for any other p.
  fn liner_preset(p: i32) -> LinerDesign {
    mut g: LinerDesign = {}

    for b in 0..LPLAN_ROWS {
      const o = b * 5

      if liner_plan[o] == p {
        for z in liner_plan[o + 2]..liner_plan[o + 3] + 1 {
          g[lcell(liner_plan[o + 1], z)] = liner_plan[o + 4]
        }
      }
    }

    g
  }

  export const passenger_design: LinerDesign = liner_preset(LINER_PASSENGER)
  export const freighter_design: LinerDesign = liner_preset(LINER_FREIGHTER)
  export const tender_design: LinerDesign = liner_preset(LINER_TENDER)
  export const battleship_design: LinerDesign = liner_preset(LINER_BATTLESHIP)

  fn liner_fill(v: f32) -> LinerLevels {
    mut p: LinerLevels = {}

    for i in 0..LCELLS {
      p[i] = v
    }

    p
  }

  export const liner_full_power: LinerLevels = liner_fill(1)

  // How much a segment of kind k at power level p works: a drive fires only while burning.
  fn liner_live(k: i32, p: f32, burning: bool) -> f32 { k == L_DRIVE && !burning ? 0 : p }

  // How much a part at heat level h glows, 0 below about 480 K to 1 at about 1830 K
  fn heat_glow(h: f32) -> f32 { clamp((h - 0.1) / 0.7, 0, 1) }

  // Color of a part that glows g: dull red, through orange, to yellow
  fn heat_rgb(g: f32) -> Rgb { {255, 40 + 140 * g, 12 + 70 * g} }

  // Share 0..1 of section i, of n sections, lit at power p: at partial power the first
  // sections are lit and the rest are dark, instead of all of them being dim.
  fn lit_share(p: f32, i: i32, n: i32) -> f32 { clamp(p * n - i % n, 0, 1) }
}

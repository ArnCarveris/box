using flecs.script
using flecs.script.math
using box.material
using state

// The design of a liner that a game can use without the editor: its lanes and slots, the kinds
// of its segments, the preset plans and the helpers that the Liner template draws it with.
state {
  export const LANES: i32 = 5
  export const SLOTS: i32 = 18
  export const LCELLS: i32 = 90
  export const SEG: f32 = 4
  export const R_CORE: f32 = 2.4
  export const R_OUT: f32 = 1.7
  export const OUT_D: f32 = 8.5
  export const RING_R: f32 = 14
  // Meters per unit of the segments, which are authored at about 10 m to the unit. The Liner
  // template scales them by it, so a liner is in meters as a rig.
  export const LINER_SCALE: f32 = 10

  export const LANE_CORE: i32 = 0
  export const LANE_PORT: i32 = 1
  export const LANE_STBD: i32 = 2
  export const LANE_DORSAL: i32 = 3
  export const LANE_VENTRAL: i32 = 4

  export const L_BASE: i32 = 40
  export const L_BRIDGE: i32 = 40
  export const L_SENSOR: i32 = 41
  export const L_QUARTERS: i32 = 42
  export const L_HABRING: i32 = 43
  export const L_ESTATE: i32 = 44
  export const L_REACTOR: i32 = 45
  export const L_RADIATOR: i32 = 46
  export const L_JUMP: i32 = 47
  export const L_DRIVE: i32 = 48
  export const L_TANKS: i32 = 49
  export const L_CARGO: i32 = 50
  export const L_HANGAR: i32 = 51
  export const L_ASSEMBLER: i32 = 52
  export const L_FAB: i32 = 53
  export const L_TRUSS: i32 = 54
  export const L_YOKE: i32 = 55
  export const L_ARMOR: i32 = 56
  export const L_TURRET: i32 = 57
  export const L_FARM: i32 = 58
  export const L_SHIELD: i32 = 59
  export const L_RAILGUN: i32 = 60
  export const L_END: i32 = 61
  export const LKINDS: i32 = 21

  export const LINER_PASSENGER: i32 = 0
  export const LINER_FREIGHTER: i32 = 1
  export const LINER_TENDER: i32 = 2
  export const LINER_BATTLESHIP: i32 = 3

  // The kind of each slot of a liner, lane by lane from the core, 0 for an empty slot.
  array LinerDesign(type: i32, count: 90)

  // A level per slot, such as the power or the heat of its segment.
  array LinerLevels(type: f32, count: 90)

  // A flag per slot, such as whether its reactor tripped.
  array LinerFlags(type: bool, count: 90)

  // The kinds of the segments ahead (kf) and behind (kb) a slot on its lane, and whether the
  // outriggers 1 to 4 hold a truss beside it.
  struct LinerNear(kf: i32, kb: i32, p1: bool, p2: bool, p3: bool, p4: bool)

  export const LPLAN_ROWS: i32 = 142
  export const liner_plan: i32[710] = [
    LINER_PASSENGER, 0, 0, 0, L_DRIVE,

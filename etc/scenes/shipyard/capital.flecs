  template DriveMount {
    prop seed: i32 = 0
    prop mounted: bool = true

    const cy = CH / 2
    const bz = 0.45

    plate : ShipHullDarkFine { Position: {0, cy, 1.94}; RoundedBox: {3.84, 2.9, 0.12, 0.05, segments: 2} }
    for i in 0..16 {
      const a = i * PI / 8
      "stud_{i}" : ShipChrome { Position: {cos(a) * 1.25, cy + sin(a) * 1.25, 1.87}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.03, length: 0.03, segments: 4, smooth: true} }
    }
    thrust : ShipSteel { Position: {0, cy, 1.4}; Rotation: {0 - HALF_PI, 0, 0}; Frustum: {radius_bottom: 1.15, radius_top: 0.55, length: 0.95, segments: 16, smooth: true} }
    for i in 0..12 {
      const a = i * PI / 6 + PI / 12
      "rib_{i}" : ShipTrim { Position: {cos(a) * 0.87, cy + sin(a) * 0.87, 1.4}; Rotation: {0, 0, a}; Box: {0.03, 0.03, 0.92} }
    }
    chamber : ShipSteel { Position: {0, cy, 0.75}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.55, length: 0.55, segments: 16, smooth: true} }
    for i in 0..6 {
      "coil_{i}" : ShipCopper { Position: {0, cy, 0.53 + i * 0.09}; Rotation: {HALF_PI, 0, 0}; Torus: {radius: 0.56, tube: 0.018, segments: 16, rings: 3, smooth: true} }
    }
    for p in 0..4 {
      const px = p % 2 == 0 ? -0.82 : 0.82
      const py = p < 2 ? -0.62 : 0.62
      "pump_{p}" : ShipChrome { Position: {px, cy + py, 1.15}; Rotation: {HALF_PI, 0, 0}; Capsule: {radius: 0.1, length: 0.3, segments: 6, smooth: true} }
      "pump_band_{p}" : ShipOrange { Position: {px, cy + py, 1.15}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.105, length: 0.06, segments: 6, smooth: true} }
      "feed_{p}" : ShipCopper { Position: {px * 0.75, cy + py * 0.75, 0.8}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.03, length: 0.5, segments: 4, smooth: true} }
    }
    main { Position: {0, cy, bz}; DriveBell b() }
    for i in 0..4 {
      const t = match i { 0: 0.5; 1: 1.0; 2: 1.5; _: 1.95 }
      const r = match i { 0: 0.62; 1: 0.83; 2: 1.06; _: 1.28 }
      "band_{i}" : ShipTrim { Position: {0, cy, bz - t}; Rotation: {HALF_PI, 0, 0}; Torus: {radius: r, tube: 0.018, segments: 24, rings: 3, smooth: true} }
    }
    for v in 0..4 {
      const vx = v % 2 == 0 ? -1.55 : 1.55
      const vy = v < 2 ? -1.12 : 1.12
      "vernier_{v}" {
        Position: {vx, cy + vy, 1.6}
        Scale: {0.22, 0.22, 0.22}
        DriveBell b()
      }
      "vernier_mount_{v}" : ShipTrim { Position: {vx, cy + vy, 1.75}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.12, length: 0.3, segments: 8, smooth: true} }
    }
    glow {
      Position: {0, cy, bz - 1.1}
      Rotation: {0 - HALF_PI, 0, 0}
      Frustum: {radius_bottom: 0.4, radius_top: 1.25, length: 2.1, segments: 16, smooth: true}
      Rgb: {120, 190, 255}
      Emissive: {strength: 2.5, color: {90, 170, 255}}
      Opacity: {0.14}
      BlendMode: Additive
      NoShadow
      SpatialIgnore
    }
    plume_core : ShipPlumeCore {
      Position: {0, cy, bz - 1.7}
      Rotation: {0 - HALF_PI, 0, 0}
      Scale: {1.15, 1.25, 1.15}
      Lathe: {profile: plume_core_shape, segments: 16, rings: 8}
      NoShadow
      SpatialIgnore
    }
    exhaust {
      Position: {0, cy, -1.9}
      ParticleEmitter: {
        max: 200, rate: 320, shape: EmitterDisc, radius: 0.7,
        direction: {0, 0, -1}, spread: 3, speed: {18, 26},
        lifetime: {0.25, 0.45}, size: {0.12, 0.26}, opacity: {0.3, 0.55},
        color: {170, 215, 255}, seed: 90 + seed
      }
      ParticleForces: {gravity: {0, 0, 0}, turbulence: 14, turbulence_scale: 0.8}
      ParticleAppearance: {blend: ParticleAdditive, stretch: 0.06}
      ParticleCurves: {
        size: {keys: [{0, 0.8}, {1, 1.3}]},
        opacity: {keys: [{0, 0}, {0.08, 1}, {0.4, 0.45}, {1, 0}]},
        color: {keys: [{0, {255, 255, 255}}, {0.3, {130, 190, 255}}, {1, {90, 60, 255}}]}
      }
      SpatialIgnore
    }
    light {
      Position: {0, cy, -2.6}
      PointLight: {intensity: 22, range: 9}
      Rgb: {120, 180, 255}
    }
  }


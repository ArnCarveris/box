  template FabSlip {
    prop seed: i32 = 0

    floor : ShipHullDarkFine { Position: {0, 0.03, 0}; Box: {3.8, 0.04, 3.8} }
    for s in 0..2 {
      "edge_{s}" : ShipHazard { Position: {s == 0 ? -1.6 : 1.6, 0.052, 0}; Box: {0.08, 0.006, 3.8} }
    }
    for i in 0..4 {
      "cradle_{i}" : ShipTrim { Position: {0, 0.1, -1.35 + i * 0.9}; Box: {0.9, 0.12, 0.08} }
    }
    hull {
      Position: {0, 0.16, 0}
      Scale: {0.1, 0.1, 0.1}
      keel : ShipHullDark { Position: {0, 0.3, 0}; Box: {2, 0.6, 32} }
      aft : ShipHull { Position: {0, 3.6, -9.5}; RoundedBox: {12, 7, 13, 1.2, segments: 2} }
      aft_band : ShipStripe { Position: {0, 4.7, -9.5}; Box: {12.06, 0.6, 12} }
      for e in 0..2 {
        "bell_{e}" : ShipSteel { Position: {e == 0 ? -3 : 3, 3.4, -16.8}; Rotation: {0 - HALF_PI, 0, 0}; Frustum: {radius_bottom: 1.2, radius_top: 2.2, length: 2.6, segments: 10, smooth: true} }
      }
      for r in 0..8 {
        const rz = -1.5 + r * 2.3
        "rib_a_{r}" : ShipSteel { Position: {-5.8, 3.5, rz}; Box: {0.4, 7, 0.5} }
        "rib_b_{r}" : ShipSteel { Position: {5.8, 3.5, rz}; Box: {0.4, 7, 0.5} }
        if r < 5 {
          "rib_c_{r}" : ShipSteel { Position: {0, 6.9, rz}; Box: {12, 0.4, 0.5} }
        }
      }
      for p in 0..3 {
        "plate_{p}" : ShipHull { Position: {-5.95, 2.4 + p * 0.1, -1.5 + p * 2.3}; Box: {0.2, 4.6 - p * 1.2, 2.2} }
      }
      stringer_a : ShipSteel { Position: {-5.8, 6.9, 6.5}; Box: {0.4, 0.4, 16} }
      stringer_b : ShipSteel { Position: {5.8, 6.9, 6.5}; Box: {0.4, 0.4, 16} }
    }
    for g in 0..2 {
      "gantry_{g}" {
        Position: {0, 0, 0}
        Animator: {clip: yard_gantry_travel, mode: AnimationPingPong, time: g * 4.5 + seed * 0.7}
        beam : ShipYellow { Position: {0, CH - 0.2, 0}; Box: {3.82, 0.12, 0.16} }
        trolley : ShipTrim { Position: {g == 0 ? -0.4 : 0.5, CH - 0.33, 0}; Box: {0.3, 0.14, 0.3} }
        cable : ShipSteel { Position: {g == 0 ? -0.4 : 0.5, CH - 1.0, 0}; Cylinder: {radius: 0.008, length: 1.2, segments: 3} }
        hook : ShipYellow { Position: {g == 0 ? -0.4 : 0.5, CH - 1.62, 0}; Box: {0.08, 0.08, 0.08} }
        lamp : ShipAmberLight { Position: {1.9, CH - 0.12, 0}; Sphere: {radius: 0.04, segments: 3, smooth: true} }
      }
    }
    for w in 0..3 {
      const wz = -1.2 + w * 1.2
      "arc_{w}" : ShipWeld { Position: {w % 2 == 0 ? -0.62 : 0.62, 0.45 + w * 0.08, wz}; Sphere: {radius: 0.018, segments: 3, smooth: true}; NoShadow }
    }
    sparks {
      Position: {-0.62, 0.45, -1.2}
      ParticleEmitter: {
        max: 60, rate: 80, shape: EmitterDisc, radius: 0.01,
        direction: {0, 1, 0}, spread: 75, speed: {0.4, 1.4},
        lifetime: {0.2, 0.5}, size: {0.008, 0.02}, opacity: {0.7, 1},
        color: {255, 190, 110}, seed: 600 + seed
      }
      ParticleAppearance: {blend: ParticleAdditive, stretch: 0.05}
      ParticleCurves: {opacity: {keys: [{0, 1}, {0.6, 0.7}, {1, 0}]}}
      SpatialIgnore
    }
    light { Position: {0, 1.6, 0}; PointLight: {intensity: 3, range: 4}; Rgb: {200, 220, 255} }
  }

  template Refinery {
    floor : ShipHullDarkFine { Position: {0, 0.03, 0}; Box: {3.8, 0.04, 3.8} }
    for s in 0..3 {
      const sz = -1.25 + s * 1.25
      "silo_{s}" : ShipWhite { Position: {-1.15, 1.45, sz}; Cylinder: {radius: 0.44, length: 1.9, segments: 16, smooth: true} }
      "silo_top_{s}" : ShipWhite { Position: {-1.15, 2.4, sz}; HemiSphere: {radius: 0.44, segments: 4, smooth: true} }
      "silo_cone_{s}" : ShipTrim { Position: {-1.15, 0.28, sz}; Frustum: {radius_bottom: 0.12, radius_top: 0.44, length: 0.46, segments: 12, smooth: true} }
      "silo_band_a_{s}" : ShipTeal { Position: {-1.15, 0.9, sz}; Cylinder: {radius: 0.445, length: 0.08, segments: 16, smooth: true} }
      "silo_band_b_{s}" : ShipTeal { Position: {-1.15, 2.0, sz}; Cylinder: {radius: 0.445, length: 0.08, segments: 16, smooth: true} }
      "chute_{s}" : ShipCopper { Position: {-0.15, 2.6, sz}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: 0.045, length: 2.0, segments: 6, smooth: true} }
    }
    smelter : ShipHullDarkFine { Position: {0.9, 0.7, -0.2}; RoundedBox: {1.4, 1.3, 2.6, 0.08, segments: 2} }
    smelter_band : ShipStripe { Position: {0.9, 1.2, -0.2}; Box: {1.42, 0.06, 2.62} }
    mouth : ShipHeat { Position: {0.9, 0.55, 1.105}; Box: {0.9, 0.16, 0.012} }
    for i in 0..5 {
      "vent_{i}" : ShipRecess { Position: {1.605, 0.4 + i * 0.12, -0.2}; Box: {0.01, 0.05, 2.2} }
    }
    hopper : ShipSteel { Position: {0.9, 1.7, -0.6}; Frustum: {radius_bottom: 0.25, radius_top: 0.6, length: 0.7, segments: 12, smooth: true} }
    rack : ShipTrim { Position: {0.9, 2.6, 0}; Box: {0.1, 0.1, 3.8} }
    channel : ShipHeat { Position: {0.9, 0.08, 1.55}; Box: {0.14, 0.03, 0.9} }
    ladle : ShipTrim { Position: {0.9, 0.22, 1.75}; Cylinder: {radius: 0.26, length: 0.36, segments: 12, smooth: true} }
    melt : ShipHeat { Position: {0.9, 0.41, 1.75}; Cylinder: {radius: 0.22, length: 0.02, segments: 12, smooth: true} }
    for i in 0..4 {
      "ingot_{i}" : ShipGold { Position: {1.55, 0.09, 1.2 + i * 0.16}; Box: {0.22, 0.07, 0.1} }
    }
    light { Position: {0.9, 0.8, 1.6}; PointLight: {intensity: 4, range: 4}; Rgb: {255, 140, 60} }
  }

  template CapitalBay {
    prop k: i32 = 0
    prop px: bool = true
    prop nx: bool = true
    prop py: bool = true
    prop pe: bool = true
    prop ne: bool = true
    prop roof: bool = false
    prop seed: i32 = 0

    CapFrame frame(px: px, nx: nx, py: py, pe: pe, ne: ne)
    if k == K_CORE {
      FusionCore core()
    } else if k == K_JUMP {
      JumpDrive drive()
    } else if k == K_TANKS {
      TankFarm tanks()
    } else if k == K_FREIGHT {
      ContainerSpine spine(roof: roof, seed: seed)
    } else if k == K_SLIP {
      FabSlip slip(seed: seed)
    } else if k == K_REFINERY {
      Refinery plant()
    }
  }

  template BatteryTurret {
    prop seed: i32 = 0

    plate : ShipHullDarkFine { Position: {0, 0.025, 0}; RoundedBox: {3.3, 0.05, 3.3, 0.02, segments: 2} }
    barbette : ShipTrim { Position: {0, 0.15, 0}; Cylinder: {radius: 1.3, length: 0.26, segments: 24, smooth: true} }
    race : ShipSteel { Position: {0, 0.28, 0}; Torus: {radius: 1.31, tube: 0.025, segments: 24, rings: 3, smooth: true} }
    house {
      Position: {0, 0.28, -0.2}
      Rotation: {0, (seed % 5 - 2) * 0.12, 0}
      Scale: {1.4, 1.4, 1.4}
      body : ShipHullFine { Position: {0, 0.25, -0.2}; RoundedBox: {1.7, 0.5, 1.9, 0.07, segments: 2} }
      glacis : ShipHullFine { Position: {0, 0.24, 0.8}; Rotation: {-0.55, 0, 0}; RoundedBox: {1.7, 0.46, 0.3, 0.05, segments: 2} }
      roof : ShipHullDarkFine { Position: {0, 0.51, -0.3}; RoundedBox: {1.4, 0.04, 1.5, 0.02, segments: 2} }
      band : ShipStripe { Position: {0, 0.36, -0.2}; Box: {1.715, 0.05, 1.915} }
      finder : ShipTrim { Position: {0, 0.62, -0.8}; Box: {2.3, 0.1, 0.14} }
      for s in 0..2 {
        "lens_{s}" : ShipCanopy { Position: {s == 0 ? -1.15 : 1.15, 0.62, -0.72}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.045, length: 0.02, segments: 8, smooth: true} }
        "vent_{s}" : ShipRecess { Position: {s == 0 ? -0.856 : 0.856, 0.25, -0.4}; Box: {0.01, 0.2, 1.0} }
      }
      hatch : ShipTrim { Position: {0.35, 0.54, -0.6}; Cylinder: {radius: 0.12, length: 0.03, segments: 8, smooth: true} }
      for b in 0..3 {
        const bx = (b - 1) * 0.42
        "sleeve_{b}" : ShipRecess { Position: {bx, 0.28, 1.0}; RoundedBox: {0.18, 0.18, 0.2, 0.05, segments: 2} }
        "barrel_{b}" : ShipSteel { Position: {bx, 0.28, 1.55}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.045, length: 1.0, segments: 8, smooth: true} }
        "jacket_{b}" : ShipTrim { Position: {bx, 0.28, 1.25}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.06, length: 0.35, segments: 8, smooth: true} }
        "muzzle_{b}" : ShipTrim { Position: {bx, 0.28, 2.04}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.058, length: 0.06, segments: 8, smooth: true} }
      }
    }
    for p in 0..2 {
      const sx = p == 0 ? -1.45 : 1.45
      "pd_{p}" {
        Position: {sx, 0.05, 1.3}
        Rotation: {0, sx * 0.4, 0}
        base : ShipTrim { Position: {0, 0.05, 0}; Cylinder: {radius: 0.17, length: 0.1, segments: 10, smooth: true} }
        dome : ShipHullFine { Position: {0, 0.1, 0}; HemiSphere: {radius: 0.14, segments: 4, smooth: true} }
        for g in 0..2 {
          "gun_{g}" : ShipSteel { Position: {g == 0 ? -0.04 : 0.04, 0.2, 0.15}; Rotation: {HALF_PI - 0.4, 0, 0}; Cylinder: {radius: 0.012, length: 0.32, segments: 4} }
        }
        eye : ShipRedLight { Position: {0, 0.17, 0.11}; Sphere: {radius: 0.02, segments: 3, smooth: true} }
      }
    }
  }

  template BatteryMount {
    prop side: i32 = 1
    prop seed: i32 = 0

    if side == 2 {
      mount { Position: {-2, CH / 2, 0}; Rotation: {0, 0, 0 - HALF_PI}; BatteryTurret turret(seed: seed) }
    } else if side == 3 {
      mount { Position: {2, CH / 2, 0}; Rotation: {0, 0, HALF_PI}; BatteryTurret turret(seed: seed) }
    } else {
      BatteryTurret turret(seed: seed)
    }
  }
}

  template WingMount {
    prop side: i32 = 2

    if side == 3 {
      turn { Rotation: {0, PI, 0}; HeatWing wing() }
    } else if side == 5 {
      turn { Rotation: {0, 0 - HALF_PI, 0}; HeatWing wing() }
    } else if side == 4 {
      turn { Rotation: {0, HALF_PI, 0}; HeatWing wing() }
    } else {
      HeatWing wing()
    }
  }


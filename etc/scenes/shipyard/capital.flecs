using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.light
using box.movement
using box.particle
using box.spatial
using box.animation
using state

// Modules of capital ships. A capital cell has the size of a craft cell but stands for a section
// ten times larger, so its detail is ten times finer: decks of cabin windows instead of a row of
// portholes, container stacks instead of crates, and small craft that fit in a hangar.

assets {
  cap_prow_shape {
    Path2D: {
      start: {2, 0},
      segments: [
        {kind: Line, end: {2, 1.35}},
        {kind: CubicBezier, end: {1.85, 1.5}, control1: {2, 1.433}, control2: {1.933, 1.5}},
        {kind: Line, end: {-1.85, 1.5}},
        {kind: CubicBezier, end: {-2, 1.35}, control1: {-1.933, 1.5}, control2: {-2, 1.433}},
        {kind: Line, end: {-2, -1.35}},
        {kind: CubicBezier, end: {-1.85, -1.5}, control1: {-2, -1.433}, control2: {-1.933, -1.5}},
        {kind: Line, end: {1.85, -1.5}},
        {kind: CubicBezier, end: {2, -1.35}, control1: {1.933, -1.5}, control2: {2, -1.433}}
      ],
      closed: true
    }
  }
  cap_prow_profile { Profile2D: {outer: cap_prow_shape} }
  cap_stripe_shape { Path2D: {start: {2.012, 1.085}, segments: [{kind: Line, end: {2.012, 1.155}}, {kind: Line, end: {1.99, 1.155}}, {kind: Line, end: {1.99, 1.085}}], closed: true} }
  cap_stripe_profile { Profile2D: {outer: cap_stripe_shape} }
  cap_stripe_n_shape { Path2D: {start: {-2.012, 1.085}, segments: [{kind: Line, end: {-1.99, 1.085}}, {kind: Line, end: {-1.99, 1.155}}, {kind: Line, end: {-2.012, 1.155}}], closed: true} }
  cap_stripe_n_profile { Profile2D: {outer: cap_stripe_n_shape} }

  cap_rib_shape {
    Path2D: {
      start: {1.975, 0},
      segments: [
        {kind: CubicBezier, end: {0, 1.975}, control1: {1.975, 1.091}, control2: {1.091, 1.975}},
        {kind: CubicBezier, end: {-1.975, 0}, control1: {-1.091, 1.975}, control2: {-1.975, 1.091}},
        {kind: Line, end: {-1.945, 0}},
        {kind: CubicBezier, end: {0, 1.945}, control1: {-1.945, 1.074}, control2: {-1.074, 1.945}},
        {kind: CubicBezier, end: {1.945, 0}, control1: {1.074, 1.945}, control2: {1.945, 1.074}}
      ],
      closed: true
    }
  }
  cap_rib_profile { Profile2D: {outer: cap_rib_shape} }
}

state {
  export const VAULT: f32 = 1.3
  export const VAULT_Y: f32 = 0.33

  fn prow_w(t: f32) -> f32 { 1 - 0.2 * pow(t, 2.4) }
  fn prow_h(t: f32) -> f32 { 1 - 0.1 * pow(t, 1.6) }
  fn prow_y(t: f32) -> f32 { 1.5 + 0.12 * t }
  fn prow_z(t: f32) -> f32 { 2 + 1.1 * t }

  fn prow_sec(p: entity, t: f32) -> box.geometry.LoftSection {
    {profile: p, offset: {0, prow_y(t), prow_z(t)}, rotation: {0 - HALF_PI, 0, 0}, scale: {0 - prow_w(t), prow_h(t)}}
  }

  fn vault_sec(p: entity, z: f32) -> box.geometry.LoftSection {
    {profile: p, offset: {0, VAULT_Y, z}, rotation: {0 - HALF_PI, 0, 0}, scale: {-1, VAULT}}
  }

  fn rnd(seed: i32, i: i32, n: i32) -> i32 { (seed * 37 + i * 53 + seed * i * 11) % n }
}

assets {
  // A small craft in the units of the craft yard, for scale; set its Scale to 0.1 to stand it
  // in a capital cell.
  template MiniShuttle {
    prop paint: i32 = 0

    body : ShipHull { Position: {0, 1.5, -0.4}; RoundedBox: {4, 3, 4.8, 0.42, segments: 2} }
    if paint == 0 {
      band : ShipStripe { Position: {0, 1.98, -0.4}; Box: {4.02, 0.22, 4.0} }
    } else {
      band : ShipOrange { Position: {0, 1.98, -0.4}; Box: {4.02, 0.22, 4.0} }
    }
    CockpitNose nose(px: true, nx: true)
    drive : ShipHullDark { Position: {0, 1.5, -2.9}; Box: {2.6, 1.8, 0.3} }
    glow : ShipPlasma { Position: {0, 1.5, -3.06}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.6, length: 0.04, segments: 8, smooth: true} }
    for s in 0..2 {
      "skid_{s}" : ShipTrim { Position: {s == 0 ? -1.4 : 1.4, -0.15, -0.4}; Box: {0.3, 0.3, 4} }
    }
  }

  // The open frame of a capital bay. The ends close where the next cell is not a bay, and an
  // exposed side or roof gets cross bracing.
  template CapFrame {
    prop px: bool = true
    prop nx: bool = true
    prop py: bool = true
    prop pe: bool = true
    prop ne: bool = true

    const b = 0.09
    const ex = 2 - b / 2
    for c in 0..4 {
      const cx = c % 2 == 0 ? 0 - ex : ex
      const cy = c < 2 ? b / 2 : CH - b / 2
      "long_{c}" : ShipHullDarkFine { Position: {cx, cy, 0}; Box: {b, b, 4} }
    }
    for e in 0..2 {
      const ez = e == 0 ? 0 - ex : ex
      if (e == 0 && ne) || (e == 1 && pe) {
        "post_a_{e}" : ShipHullDarkFine { Position: {0 - ex, CH / 2, ez}; Box: {b, CH - b * 2, b} }
        "post_b_{e}" : ShipHullDarkFine { Position: {ex, CH / 2, ez}; Box: {b, CH - b * 2, b} }
        "sill_{e}" : ShipHullDarkFine { Position: {0, b / 2, ez}; Box: {4 - b * 2, b, b} }
        "lintel_{e}" : ShipHullDarkFine { Position: {0, CH - b / 2, ez}; Box: {4 - b * 2, b, b} }
        "cap_a_{e}" : ShipHazard { Position: {0 - ex, CH - 0.01, ez}; Box: {b + 0.01, 0.03, b + 0.01} }
        "cap_b_{e}" : ShipHazard { Position: {ex, CH - 0.01, ez}; Box: {b + 0.01, 0.03, b + 0.01} }
      }
    }
    for s in 0..2 {
      const sx = s == 0 ? 0 - ex : ex
      if (s == 0 && nx) || (s == 1 && px) {
        "brace_a_{s}" : ShipSteel { Position: {sx, CH / 2, 0}; Rotation: {0.6435, 0, 0}; Box: {0.03, 0.03, 4.9} }
        "brace_b_{s}" : ShipSteel { Position: {sx, CH / 2, 0}; Rotation: {-0.6435, 0, 0}; Box: {0.03, 0.03, 4.9} }
        "lamps_{s}" : ShipRunLights { Position: {sx + (s == 0 ? -0.05 : 0.05), CH - b / 2, 0}; Box: {0.012, 0.03, 3.9} }
      }
    }
    if py {
      roof_a : ShipSteel { Position: {0, CH - b / 2, 0}; Rotation: {0, 0.785, 0}; Box: {0.03, 0.03, 5.5} }
      roof_b : ShipSteel { Position: {0, CH - b / 2, 0}; Rotation: {0, -0.785, 0}; Box: {0.03, 0.03, 5.5} }
    }
  }

  template CabinFace {
    prop low: bool = false

    for d in 0..3 {
      const dy = 0.62 + d * 0.62
      if !(low && d == 0) {
        "deck_{d}" : ShipCabins { Position: {0, dy, 0.006}; Box: {3.72, 0.5, 0.012} }
      }
    }
    if low {
      well : ShipRecess { Position: {0, 0.6, 0.004}; Box: {3.72, 0.3, 0.008} }
      for i in 0..6 {
        const bx = -1.55 + i * 0.62
        "boat_{i}" : ShipOrange { Position: {bx, 0.6, 0.06}; Rotation: {0, 0, HALF_PI}; Capsule: {radius: 0.06, length: 0.3, segments: 6, smooth: true} }
        "canopy_{i}" : ShipWhite { Position: {bx, 0.66, 0.06}; Box: {0.38, 0.025, 0.09} }
      }
    }
    promenade : ShipVisor { Position: {0, 2.3, 0.006}; Box: {3.72, 0.12, 0.012} }
    promenade_glow : ShipRunLights { Position: {0, 2.22, 0.012}; Box: {3.72, 0.015, 0.006} }
  }

  template CapSides {
    prop px: bool = false
    prop nx: bool = false
    prop pz: bool = false
    prop nz: bool = false
    prop low: bool = false

    if px {
      face_px { Position: {2, 0, 0}; Rotation: {0, HALF_PI, 0}; CabinFace f(low: low) }
    }
    if nx {
      face_nx { Position: {-2, 0, 0}; Rotation: {0, -HALF_PI, 0}; CabinFace f(low: low) }
    }
    if pz {
      face_pz { Position: {0, 0, 2}; CabinFace f(low: low) }
    }
    if nz {
      face_nz { Position: {0, 0, -2}; Rotation: {0, PI, 0}; CabinFace f(low: low) }
    }
  }

  template SunDeck {
    prop seed: i32 = 0

    const v = seed % 5
    for s in 0..2 {
      "rail_{s}" : ShipRunLights { Position: {0, 0.012, s == 0 ? -1.84 : 1.84}; Box: {3.6, 0.02, 0.02} }
    }
    if v == 0 {
      surround : ShipTeak { Position: {-0.4, 0.008, 0.2}; Box: {2.0, 0.016, 1.3} }
      rim : ShipWhite { Position: {-0.55, 0.02, 0.2}; Box: {1.3, 0.025, 0.8} }
      pool : ShipWater { Position: {-0.55, 0.034, 0.2}; Box: {1.18, 0.006, 0.68} }
      for i in 0..10 {
        "lounger_{i}" : ShipWhite { Position: {0.4 + (i % 2) * 0.16, 0.025, -0.3 + (i - i % 2) * 0.11}; Box: {0.06, 0.02, 0.15} }
      }
    } else if v == 1 {
      court : ShipCourt { Position: {0.4, 0.008, -0.3}; Box: {1.4, 0.016, 0.9} }
      line_a : ShipWhite { Position: {0.4, 0.017, -0.3}; Box: {0.012, 0.003, 0.8} }
      line_b : ShipWhite { Position: {0.4, 0.017, -0.3}; Box: {1.3, 0.003, 0.012} }
      net : ShipWhite { Position: {0.4, 0.05, -0.3}; Box: {0.008, 0.05, 0.9} }
    } else if v == 2 {
      for i in 0..6 {
        const tx = -1.2 + (i % 3) * 1.2
        const tz = (i < 3) ? -0.9 : 0.9
        "planter_{i}" : ShipTrim { Position: {tx, 0.02, tz}; Box: {0.5, 0.04, 0.5} }
        "tree_{i}" : ShipLeaf { Position: {tx, 0.12, tz}; IcoSphere: {radius: 0.12, segments: 0} }
      }
    } else if v == 3 {
      for i in 0..3 {
        "vent_{i}" : ShipTrim { Position: {-1 + i, 0.06, -0.8}; RoundedBox: {0.6, 0.12, 0.5, 0.03, segments: 2} }
        "fan_{i}" : ShipRecess { Position: {-1 + i, 0.121, -0.8}; Cylinder: {radius: 0.18, length: 0.004, segments: 10, smooth: true} }
      }
      dish : ShipWhite { Position: {1.2, 0.18, 1.0}; Sphere: {radius: 0.16, segments: 4, smooth: true} }
    }
  }

  template BridgeProw {
    prop px: bool = true
    prop nx: bool = true

    shell : ShipHullFine {
      Position: {0, 0, 0}; Loft: {
        sections: [
          prow_sec(cap_prow_profile, 0), prow_sec(cap_prow_profile, 0.4), prow_sec(cap_prow_profile, 0.65), prow_sec(cap_prow_profile, 0.82),
          prow_sec(cap_prow_profile, 0.93), prow_sec(cap_prow_profile, 1)
        ],
        cap_start: false, cap_end: true, segments: 2, rings: 3
      }
    }
    if px {
      stripe_p : ShipStripe {
        Position: {0, 0, 0}; Loft: {sections: [prow_sec(cap_stripe_n_profile, 0), prow_sec(cap_stripe_n_profile, 0.4), prow_sec(cap_stripe_n_profile, 0.7), prow_sec(cap_stripe_n_profile, 0.9)], cap_start: true, cap_end: true, segments: 2, rings: 3}
      }
    }
    if nx {
      stripe_n : ShipStripe {
        Position: {0, 0, 0}; Loft: {sections: [prow_sec(cap_stripe_profile, 0), prow_sec(cap_stripe_profile, 0.4), prow_sec(cap_stripe_profile, 0.7), prow_sec(cap_stripe_profile, 0.9)], cap_start: true, cap_end: true, segments: 2, rings: 3}
      }
    }
    const fz = prow_z(1)
    const fw = 4 * prow_w(1)
    const top = prow_y(1) + 1.5 * prow_h(1)
    face {
      Position: {0, 0, fz}
      glass : ShipCanopy { Position: {0, top - 0.3, 0.006}; Box: {fw - 0.3, 0.3, 0.012} }
      for i in 0..9 {
        "mullion_{i}" : ShipTrim { Position: {(i - 4) * (fw - 0.3) / 8, top - 0.3, 0.014}; Box: {0.018, 0.3, 0.01} }
      }
      brow : ShipStripe { Position: {0, top - 0.11, 0.008}; Box: {fw - 0.3, 0.04, 0.016} }
      cabins : ShipCabins { Position: {0, 1.5, 0.006}; Box: {fw - 0.3, 1.25, 0.012} }
      number : ShipRunLights { Position: {0, 0.62, 0.01}; Box: {fw - 0.6, 0.03, 0.01} }
    }
  }

  template BridgeWing {
    prop sx: f32 = 1

    deck : ShipHullFine { Position: {sx * 2.28, 2.62, 1.75}; RoundedBox: {0.56, 0.34, 1.0, 0.06, segments: 2} }
    glass : ShipCanopy { Position: {sx * 2.28, 2.66, 2.256}; Box: {0.46, 0.16, 0.012} }
    side : ShipCanopy { Position: {sx * 2.564, 2.66, 1.75}; Box: {0.012, 0.16, 0.8} }
    if sx > 0 {
      lamp : ShipBeaconRed { Position: {sx * 2.56, 2.82, 2.2}; Sphere: {radius: 0.035, segments: 3, smooth: true} }
    } else {
      lamp : ShipBeaconGreen { Position: {sx * 2.56, 2.82, 2.2}; Sphere: {radius: 0.035, segments: 3, smooth: true} }
    }
  }

  template BridgeMast {
    for s in 0..2 {
      const sx = s == 0 ? -1 : 1
      "leg_{s}" : ShipWhite { Position: {sx * 0.55, 0.32, -0.6}; Rotation: {0, 0, sx * -0.2}; Box: {0.07, 0.64, 0.1} }
      "radome_{s}" : ShipWhite { Position: {sx * 1.2, 0.2, -1.2}; Sphere: {radius: 0.17, segments: 4, smooth: true} }
      "plinth_{s}" : ShipTrim { Position: {sx * 1.2, 0.03, -1.2}; Cylinder: {radius: 0.12, length: 0.06, segments: 8, smooth: true} }
    }
    beam : ShipWhite { Position: {0, 0.64, -0.6}; Box: {0.9, 0.07, 0.12} }
    scanner {
      Position: {0, 0.74, -0.6}
      AngularVelocity: {0, 1.4, 0}
      bar : ShipTrim { Position: {0, 0, 0}; Box: {0.7, 0.05, 0.05} }
      hub : ShipSteel { Position: {0, -0.04, 0}; Cylinder: {radius: 0.04, length: 0.06, segments: 6, smooth: true} }
    }
    mast : ShipSteel { Position: {0, 0.7, 0.4}; Cylinder: {radius: 0.025, length: 1.4, segments: 4, smooth: true} }
    yard : ShipSteel { Position: {0, 1.15, 0.4}; Box: {0.6, 0.02, 0.02} }
    tip : ShipBeaconWhite { Position: {0, 1.42, 0.4}; Sphere: {radius: 0.04, segments: 3, smooth: true} }
    for i in 0..3 {
      "whip_{i}" : ShipSteel { Position: {-0.9 + i * 0.9, 0.3, 1.2}; Cylinder: {radius: 0.008, length: 0.6, segments: 3} }
    }
  }

  template SensorTop {
    plinth : ShipTrim { Position: {0, 0.07, 0}; Cylinder: {radius: 0.55, length: 0.14, segments: 12, smooth: true} }
    pylon : ShipWhite { Position: {0, 0.45, 0}; Cylinder: {radius: 0.14, length: 0.7, segments: 8, smooth: true} }
    collar : ShipStripe { Position: {0, 0.62, 0}; Cylinder: {radius: 0.145, length: 0.06, segments: 8, smooth: true} }
    head {
      Position: {0, 0.86, 0}
      AngularVelocity: {0, 0.15, 0}
      tilt {
        Rotation: {0.55, 0, 0}
        dish : ShipWhite { Position: {0, 0.3, 0}; EllipsoidShell: {radius: {1.15, 0.34, 1.15}, longitude_start: 0, longitude_end: 6.2832, latitude_start: 0 - HALF_PI, latitude_end: 0, thickness: 0.03, rims: true, segments: 16, rings: 4} }
        hub : ShipTrim { Position: {0, 0, 0}; Cylinder: {radius: 0.2, length: 0.14, segments: 8, smooth: true} }
        for i in 0..3 {
          const a = i * 2.0944
          "strut_{i}" : ShipSteel { Position: {cos(a) * 0.4, 0.62, sin(a) * 0.4}; Rotation: {sin(a) * 0.5, 0, 0 - cos(a) * 0.5}; Cylinder: {radius: 0.012, length: 0.75, segments: 3} }
        }
        feed : ShipChrome { Position: {0, 0.96, 0}; Sphere: {radius: 0.07, segments: 3, smooth: true} }
        lamp : ShipBeaconRed { Position: {0, 1.04, 0}; Sphere: {radius: 0.025, segments: 3, smooth: true} }
      }
    }
    for s in 0..2 {
      const sx = s == 0 ? -1 : 1
      "array_{s}" : ShipVisor { Position: {sx * 1.35, 0.42, 1.2}; Rotation: {0.5, sx * -0.35, 0}; Box: {0.9, 0.7, 0.04} }
      "array_rim_{s}" : ShipTrim { Position: {sx * 1.35, 0.42, 1.18}; Rotation: {0.5, sx * -0.35, 0}; Box: {0.96, 0.76, 0.03} }
      "radome_{s}" : ShipWhite { Position: {sx * 1.35, 0.2, -1.3}; Sphere: {radius: 0.2, segments: 4, smooth: true} }
      "radome_base_{s}" : ShipTrim { Position: {sx * 1.35, 0.03, -1.3}; Cylinder: {radius: 0.14, length: 0.06, segments: 8, smooth: true} }
    }
  }

  template CapitalExterior {
    prop k: i32 = 0
    prop px: bool = false
    prop nx: bool = false
    prop py: bool = false
    prop pz: bool = false
    prop nz: bool = false
    prop low: bool = false
    prop seed: i32 = 0
    prop fpx: bool = false
    prop fnx: bool = false

    if k == K_RESIDENCE {
      CapSides sides(px: px, nx: nx, pz: pz, nz: nz, low: low)
      if py {
        SunDeck top(seed: seed) { Position: {0, CH, 0} }
      }
    } else if k == K_BRIDGE {
      CapSides sides(px: px, nx: nx, nz: nz, low: low)
      if pz {
        BridgeProw prow(px: px || fpx, nx: nx || fnx)
      }
      if px {
        BridgeWing wing_p(sx: 1)
      }
      if nx {
        BridgeWing wing_n(sx: -1)
      }
      if py {
        BridgeMast top() { Position: {0, CH, 0} }
      }
    } else if k == K_SENSOR {
      for s in 0..2 {
        const sx = s == 0 ? -1 : 1
        if (s == 0 && nx) || (s == 1 && px) {
          "vent_{s}" : ShipRecess { Position: {sx * 2.004, 1.2, 0}; Box: {0.008, 0.9, 3.2} }
          for i in 0..8 {
            "slat_{s}_{i}" : ShipTrim { Position: {sx * 2.01, 0.8 + i * 0.11, 0}; Box: {0.01, 0.03, 3.2} }
          }
        }
      }
      if py {
        SensorTop top() { Position: {0, CH, 0} }
      }
    }
  }

  template SpinRing {
    prop seed: i32 = 0

    spine : ShipHullFine { Position: {0, CH / 2, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.55, length: 4, segments: 16, smooth: true} }
    for s in 0..2 {
      const sz = s == 0 ? -1 : 1
      "band_{s}" : ShipStripe { Position: {0, CH / 2, sz * 1.65}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.56, length: 0.07, segments: 16, smooth: true} }
      "bearing_{s}" : ShipChrome { Position: {0, CH / 2, sz * 0.55}; Rotation: {HALF_PI, 0, 0}; Torus: {radius: 0.62, tube: 0.06, segments: 16, rings: 4, smooth: true} }
      "lamps_{s}" : ShipRunLightsCyan { Position: {0, CH / 2, sz * 1.3}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.555, length: 0.03, segments: 16, smooth: true} }
    }
    rotor {
      Position: {0, CH / 2, 0}
      AngularVelocity: {0, 0, 0.3}
      hub : ShipHullDarkFine { Position: {0, 0, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.8, length: 0.9, segments: 16, smooth: true} }
      for i in 0..6 {
        "spoke_{i}" {
          Rotation: {0, 0, i * 1.0472 + seed * 0.1}
          arm : ShipHullFine { Position: {0, 1.3, 0}; Box: {0.13, 1.05, 0.22} }
          lift : ShipRunLights { Position: {0, 1.3, 0.115}; Box: {0.05, 0.95, 0.01} }
        }
      }
      rim : ShipHullFine { Position: {0, 0, 0}; Rotation: {HALF_PI, 0, 0}; Tube: {radius: 1.94, thickness: 0.18, length: 0.8, segments: 48, smooth: true} }
      cabins : ShipCabins { Position: {0, 0, 0}; Rotation: {HALF_PI, 0, 0}; Tube: {radius: 1.946, thickness: 0.01, length: 0.42, segments: 48, smooth: true} }
      for s in 0..2 {
        "lip_{s}" : ShipStripe { Position: {0, 0, s == 0 ? -0.4 : 0.4}; Rotation: {HALF_PI, 0, 0}; Torus: {radius: 1.86, tube: 0.04, segments: 48, rings: 4, smooth: true} }
      }
    }
  }

  template Arboretum {
    prop px: bool = true
    prop nx: bool = true
    prop pz: bool = true
    prop nz: bool = true
    prop seed: i32 = 0

    const z0: f32 = nz ? -1.0 : -2.0
    const z1: f32 = pz ? 1.0 : 2.0
    const v = seed % 3

    base : ShipHullFine { Position: {0, 0.16, 0}; Box: {4, 0.32, 4} }
    if px {
      band_px : ShipStripe { Position: {2.006, 0.2, 0}; Box: {0.012, 0.05, 4} }
      lamps_px : ShipRunLights { Position: {2.006, 0.1, 0}; Box: {0.012, 0.02, 4} }
    }
    if nx {
      band_nx : ShipStripe { Position: {-2.006, 0.2, 0}; Box: {0.012, 0.05, 4} }
      lamps_nx : ShipRunLights { Position: {-2.006, 0.1, 0}; Box: {0.012, 0.02, 4} }
    }
    lawn : ShipMoss { Position: {0, 0.335, 0}; Box: {3.9, 0.03, 3.96} }
    hill : ShipMoss { Position: {-0.9, 0.33, 0.5 - v * 0.4}; EllipsoidShell: {radius: {0.8, 0.22, 1.0}, longitude_start: 0, longitude_end: 6.2832, latitude_start: 0, latitude_end: HALF_PI, segments: 10, rings: 3} }
    lake : ShipWater { Position: {0.75, 0.352, -0.6 + v * 0.5}; Scale: {1.3, 1, 0.8}; Cylinder: {radius: 0.5, length: 0.01, segments: 16, smooth: true} }
    path_a : ShipWhite { Position: {-0.1, 0.352, 0}; Box: {0.04, 0.004, 3.9} }
    path_b : ShipWhite { Position: {0, 0.352, 0.9 - v * 0.6}; Box: {3.8, 0.004, 0.04} }
    pavilion : ShipWhite { Position: {0.3, 0.37, 0.9 - v * 0.6}; Cylinder: {radius: 0.12, length: 0.04, segments: 8, smooth: true} }
    pavilion_roof : ShipGlass { Position: {0.3, 0.39, 0.9 - v * 0.6}; HemiSphere: {radius: 0.11, segments: 3, smooth: true} }
    for i in 0..16 {
      const tx = -1.75 + rnd(seed, i, 35) * 0.1
      const tz = -1.85 + rnd(seed + 3, i * 7 + 1, 37) * 0.1
      const r = 0.08 + rnd(seed, i * 3, 5) * 0.015
      if abs(tx - 0.75) > 0.7 || abs(tz + 0.6 - v * 0.5) > 0.5 {
        if i % 3 == 0 {
          "tree_{i}" : ShipLeafDark { Position: {tx, 0.34 + r * 0.9, tz}; IcoSphere: {radius: r, segments: 0} }
        } else {
          "tree_{i}" : ShipLeaf { Position: {tx, 0.34 + r * 0.9, tz}; IcoSphere: {radius: r, segments: 0} }
        }
      }
    }

    vault : ShipGlass {
      Position: {0, 0, 0}; Loft: {sections: [vault_sec(yard_arch_profile, z0), vault_sec(yard_arch_profile, z1)], cap_start: false, cap_end: false, segments: 2, rings: 3}
    }
    for i in 0..8 {
      const rz = -1.75 + i * 0.5
      if rz > z0 + 0.05 && rz < z1 - 0.05 {
        "rib_{i}" : ShipTrim { Position: {0, 0, 0}; Loft: {sections: [vault_sec(cap_rib_profile, rz - 0.012), vault_sec(cap_rib_profile, rz + 0.012)], cap_start: true, cap_end: true, segments: 2, rings: 3} }
      }
    }
    for e in 0..2 {
      const ez = e == 0 ? z0 : z1
      const open = e == 0 ? nz : pz
      if open {
        "apse_{e}" : ShipGlass { Position: {0, VAULT_Y, ez}; Rotation: {0, e == 0 ? PI : 0, 0}; EllipsoidShell: {radius: {1.95, 1.95 * VAULT, 0.95}, longitude_start: 0, longitude_end: PI, latitude_start: 0, latitude_end: HALF_PI, segments: 8, rings: 4} }
        "end_{e}" : ShipTrim { Position: {0, 0, 0}; Loft: {sections: [vault_sec(cap_rib_profile, ez - 0.012), vault_sec(cap_rib_profile, ez + 0.012)], cap_start: true, cap_end: true, segments: 2, rings: 3} }
      }
    }
    for s in 0..2 {
      const sx = s == 0 ? -1 : 1
      "purlin_{s}" : ShipTrim { Position: {sx * 1.38, VAULT_Y + 1.38 * VAULT, (z0 + z1) / 2}; Box: {0.025, 0.025, z1 - z0} }
    }
    ridge : ShipTrim { Position: {0, VAULT_Y + 1.95 * VAULT, (z0 + z1) / 2}; Box: {0.05, 0.025, z1 - z0} }
    grow : ShipGrowLight { Position: {0, VAULT_Y + 1.95 * VAULT - 0.03, (z0 + z1) / 2}; Box: {0.03, 0.015, z1 - z0} }
    light { Position: {0, 2, 0}; PointLight: {intensity: 3, range: 4}; Rgb: {220, 255, 190} }
  }


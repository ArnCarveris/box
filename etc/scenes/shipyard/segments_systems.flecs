using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.picking
using box.input
using box.spatial
using box.transition
using box.movement
using box.particle
using box.light
using box.animation
using state

assets {
  prefab AgriLoam { Rgb: {116, 82, 46}; PbrMaterial: {roughness: 0.95} }
  prefab AgriStraw {
    Rgb: {190, 152, 82}
    PbrMaterial: {roughness: 0.9}
    Sheen: {color: {255, 226, 160}, roughness: 0.6}
  }

  prefab AgriStubble {
    Rgb: {210, 180, 114}
    PbrMaterial: {roughness: 0.92}
    Sheen: {color: {255, 236, 180}, roughness: 0.7}
  }

  prefab AgriWheat {
    Rgb: {230, 178, 58}
    PbrMaterial: {roughness: 0.8}
    Sheen: {color: {255, 230, 140}, roughness: 0.45}
  }

  prefab AgriWheatPale {
    Rgb: {240, 206, 112}
    PbrMaterial: {roughness: 0.8}
    Sheen: {color: {255, 240, 180}, roughness: 0.45}
  }

  prefab AgriBarley {
    Rgb: {214, 146, 52}
    PbrMaterial: {roughness: 0.82}
    Sheen: {color: {255, 210, 130}, roughness: 0.5}
  }

  prefab AgriCanola {
    Rgb: {252, 214, 28}
    PbrMaterial: {roughness: 0.7}
    DiffuseTransmission: {factor: 0.3, color: {255, 240, 120}}
  }

  prefab AgriSunflower {
    Rgb: {252, 184, 22}
    PbrMaterial: {roughness: 0.7}
    DiffuseTransmission: {factor: 0.25, color: {255, 220, 90}}
  }

  prefab AgriOrchard {
    Rgb: {200, 160, 48}
    PbrMaterial: {roughness: 0.85}
    DiffuseTransmission: {factor: 0.35, color: {255, 220, 110}}
  }

  prefab AgriMeadow {
    Rgb: {168, 154, 70}
    PbrMaterial: {roughness: 0.95}
    Sheen: {color: {240, 230, 150}, roughness: 0.6}
  }

  prefab AgriSeed { Rgb: {96, 58, 26}; PbrMaterial: {roughness: 0.9} }
  prefab AgriLamp {
    Rgb: {120, 108, 90}
    Emissive: {strength: 3, color: {255, 196, 120}}
    Transition: [Emissive: {duration: 1.2, timing_function: EaseInOut}]
  }

  template AgriRingRows {
    prop seed: i32 = 0
    prop i: i32 = 0
    prop field: i32 = 0
    prop reap: bool = false
    prop g: f32 = 1
    prop arc: f32 = 0
    prop c0: f32 = 0

    for k in 0..6 {
      const zk = (k - 2.5) * 0.44
      const pale = seg_hash(seed + k, i, 3) == 0

      if field < 3 {
        "base_{k}" : AgriStraw {
          Position: {0, 0, zk}
          Rotation: {0 - HALF_PI, 0, 0}
          Tube: {
            radius: g + 0.004,
            thickness: 0.035,
            length: 0.4,
            segments: 4,
            smooth: true,
            arc: arc
          }
        }

        if reap && (k == 3 || k == 4) {
          "stand_{k}" {
            Rotation: {0, 0, c0}
            top : AgriWheat {
              Position: {0, 0, zk}
              Rotation: {0 - HALF_PI, 0, 0}
              TorusShell: {
                radius: g + 0.1625,
                tube: 0.2425,
                ring_start: 0,
                ring_end: arc - c0,
                tube_start: PI - 0.8384,
                tube_end: PI + 0.8384,
                thickness: 0.08,
                segments: 4,
                rings: 8
              }
            }
          }
        } else if pale {
          "top_{k}" : AgriWheatPale {
            Position: {0, 0, zk}
            Rotation: {0 - HALF_PI, 0, 0}
            TorusShell: {
              radius: g + 0.1625,
              tube: 0.2425,
              ring_start: 0,
              ring_end: arc,
              tube_start: PI - 0.8384,
              tube_end: PI + 0.8384,
              thickness: 0.08,
              segments: 6,
              rings: 8
            }
          }
        } else {
          "top_{k}" : AgriWheat {
            Position: {0, 0, zk}
            Rotation: {0 - HALF_PI, 0, 0}
            TorusShell: {
              radius: g + 0.1625,
              tube: 0.2425,
              ring_start: 0,
              ring_end: arc,
              tube_start: PI - 0.8384,
              tube_end: PI + 0.8384,
              thickness: 0.08,
              segments: 6,
              rings: 8
            }
          }
        }
      } else if field < 5 {
        "base_{k}" : ShipLeafDark {
          Position: {0, 0, zk}
          Rotation: {0 - HALF_PI, 0, 0}
          Tube: {
            radius: g + 0.004,
            thickness: 0.035,
            length: 0.38,
            segments: 4,
            smooth: true,
            arc: arc
          }
        }

        "top_{k}" : AgriCanola {
          Position: {0, 0, zk}
          Rotation: {0 - HALF_PI, 0, 0}
          TorusShell: {
            radius: g + 0.0945,
            tube: 0.1945,
            ring_start: 0,
            ring_end: arc,
            tube_start: PI - 1.0636,
            tube_end: PI + 1.0636,
            thickness: 0.1,
            segments: 6,
            rings: 8
          }
        }
      } else if field == 5 {
        if k == 2 || k == 3 {
          "base_{k}" : ShipLeafDark {
            Position: {0, 0, zk}
            Rotation: {0 - HALF_PI, 0, 0}
            TorusShell: {
              radius: g - 0.0494,
              tube: 0.1206,
              ring_start: 0,
              ring_end: arc,
              tube_start: PI - 1.15,
              tube_end: PI + 1.15,
              thickness: 0.12,
              segments: 6,
              rings: 8
            }
          }
        } else {
          "base_{k}" : AgriStraw {
            Position: {0, 0, zk}
            Rotation: {0 - HALF_PI, 0, 0}
            Tube: {
              radius: g + 0.004,
              thickness: 0.035,
              length: 0.4,
              segments: 4,
              smooth: true,
              arc: arc
            }
          }

          "top_{k}" : AgriBarley {
            Position: {0, 0, zk}
            Rotation: {0 - HALF_PI, 0, 0}
            TorusShell: {
              radius: g + 0.0972,
              tube: 0.1872,
              ring_start: 0,
              ring_end: arc,
              tube_start: PI - 1.0255,
              tube_end: PI + 1.0255,
              thickness: 0.09,
              segments: 6,
              rings: 8
            }
          }
        }
      } else if field == 6 {
        "base_{k}" : AgriMeadow {
          Position: {0, 0, zk}
          Rotation: {0 - HALF_PI, 0, 0}
          Tube: {
            radius: g + 0.004,
            thickness: 0.02,
            length: 0.4,
            segments: 4,
            smooth: true,
            arc: arc
          }
        }
      } else {
        "base_{k}" : AgriStubble {
          Position: {0, 0, zk}
          Rotation: {0 - HALF_PI, 0, 0}
          Tube: {
            radius: g + 0.004,
            thickness: 0.018,
            length: 0.4,
            segments: 4,
            smooth: true,
            arc: arc
          }
        }
      }
    }
  }

  template AgriRingDepot {
    prop g: f32 = 1
    prop lit: f32 = 1

    for q in 0..3 {
      const px = -1.25 + q * 0.32
      "silo_{q}" {
        Rotation: {0, 0, tilt(g, px)}
        Position: {px, ground(g, px), -0.6}
        body : ShipVilla {
          Position: {0, -0.31, 0}
          Cylinder: {radius: 0.13, length: 0.62, segments: 20, smooth: true}
        }

        band : ShipYellow {
          Position: {0, -0.46, 0}
          Cylinder: {radius: 0.135, length: 0.03, segments: 20, smooth: true}
        }

        cap : ShipSteel {
          Position: {0, -0.68, 0}
          Rotation: {PI, 0, 0}
          Cone: {radius: 0.14, length: 0.12, segments: 20, smooth: true}
        }

        chute : ShipTrim { Position: {0.16, -0.38, 0}; Box: {0.03, 0.5, 0.03} }
      }
    }

    conveyor {
      Rotation: {0, 0, tilt(g, -0.3)}
      Position: {-0.3, ground(g, -0.3), -0.6}
      belt : ShipTrim {
        Position: {-0.15, -0.34, 0}
        Rotation: {0, 0, -0.45}
        Box: {0.05, 0.76, 0.06}
      }

      hopper : ShipYellow { Position: {0.02, -0.05, 0}; Box: {0.12, 0.1, 0.12} }
      grain : AgriWheat { Position: {0.02, -0.102, 0}; Box: {0.1, 0.006, 0.1} }
    }

    barn {
      Rotation: {0, 0, tilt(g, 0.7)}
      Position: {0.7, ground(g, 0.7), -0.5}
      body : ShipRed {
        Position: {0, -0.15, 0}
        RoundedBox: {0.8, 0.3, 0.46, 0.015, segments: 2}
      }

      roof : ShipTrim {
        Position: {0, -0.31, 0}
        RoundedBox: {0.84, 0.03, 0.5, 0.01, segments: 2}
      }

      door : ShipHullDark { Position: {0, -0.1, 0.232}; Box: {0.24, 0.2, 0.006} }
      lamp : PowerWindow {
        Position: {0, -0.23, 0.236}
        Box: {0.08, 0.02, 0.006}
        Emissive: {strength: 3.2 * lit, color: {255, 204, 136}}
      }

      for w in 0..2 {
        "window_{w}" : PowerWindow {
          Position: {(w - 0.5) * 0.5, -0.2, 0.233}
          Box: {0.1, 0.05, 0.006}
          Emissive: {strength: 3.2 * lit, color: {255, 204, 136}}
        }
      }
    }

    for v in 0..2 {
      const vz = 0.42 + v * 0.3
      "tank_{v}" : ShipTankSkin {
        Position: {-0.75, g - 0.11, vz}
        Rotation: {0, 0, HALF_PI}
        Cylinder: {radius: 0.1, length: 0.9, segments: 16, smooth: true}
      }

      for b in 0..3 {
        "tank_band_{v}_{b}" : ShipTeal {
          Position: {-1.15 + b * 0.4, g - 0.11, vz}
          Rotation: {0, 0, HALF_PI}
          Cylinder: {radius: 0.106, length: 0.03, segments: 16, smooth: true}
        }
      }
    }

    for b in 0..6 {
      const bx = 0.05 + (b % 3) * 0.15
      const by = b < 3 ? 0 : 0.08
      "bale_{b}" : AgriStraw {
        Rotation: {0, 0, tilt(g, bx)}
        Position: {bx + (b < 3 ? 0 : 0.07), ground(g, bx) - 0.04 - by, 0.1}
        Box: {0.14, 0.08, 0.1}
      }
    }

    harvester {
      Rotation: {0, 0, tilt(g, 0.7)}
      Position: {0.7, ground(g, 0.7), 0.6}
      body : ShipYellow {
        Position: {0, -0.09, 0}
        RoundedBox: {0.32, 0.12, 0.18, 0.02, segments: 2}
      }

      cab : ShipGlass { Position: {0.08, -0.19, 0}; Box: {0.1, 0.08, 0.12} }
      header : ShipTrim { Position: {-0.2, -0.04, 0}; Box: {0.06, 0.05, 0.3} }

      for w in 0..2 {
        "wheel_{w}" : ShipRubber {
          Position: {0.06, -0.035, (w - 0.5) * 0.2}
          Rotation: {HALF_PI, 0, 0}
          Cylinder: {radius: 0.035, length: 0.025, segments: 10, smooth: true}
        }
      }
    }
  }

  template AgriRingField {
    prop seed: i32 = 0
    prop i: i32 = 0
    prop field: i32 = 0
    prop reap: bool = false
    prop g: f32 = 1
    prop xg: f32 = 0
    prop xc: f32 = 0
    prop lit: f32 = 1

    gantry {
      Rotation: {0, 0, tilt(g, xg)}
      Position: {xg, ground(g, xg), 0}
      beam : ShipYellow { Position: {0, -0.62, 0}; Box: {0.06, 0.05, 2.72} }
      lamp : AgriLamp {
        Position: {0, -0.592, 0}
        Box: {0.09, 0.008, 2.5}
        Emissive: {strength: 3 * lit, color: {255, 196, 120}}
      }

      for s in 0..2 {
        const sz = (s - 0.5) * 2
        "leg_{s}" : ShipSteel {
          Position: {0, -0.31, sz * 1.32}
          Box: {0.035, 0.6, 0.035}
        }

        "truck_{s}" : ShipTrim {
          Position: {0, -0.03, sz * 1.32}
          Box: {0.16, 0.05, 0.06}
        }
      }

      for d in 0..3 {
        "drop_{d}" : ShipTeal {
          Position: {0, -0.49, (d - 1) * 0.88}
          Box: {0.014, 0.22, 0.014}
        }
      }
    }

    if reap {
      combine {
        Rotation: {0, 0, tilt(g, xc)}
        Position: {xc, ground(g, xc), 0.44}
        body : ShipRed {
          Position: {0.06, -0.12, 0}
          RoundedBox: {0.36, 0.15, 0.2, 0.025, segments: 2}
        }

        hopper : ShipRed {
          Position: {0.14, -0.225, 0}
          RoundedBox: {0.18, 0.07, 0.18, 0.015, segments: 2}
        }

        load : AgriWheat { Position: {0.14, -0.262, 0}; Box: {0.15, 0.01, 0.15} }
        cab : ShipGlass { Position: {-0.07, -0.245, 0}; Box: {0.1, 0.1, 0.12} }
        lid : ShipWhite { Position: {-0.07, -0.3, 0}; Box: {0.12, 0.012, 0.14} }
        feeder : ShipTrim { Position: {-0.16, -0.08, 0}; Box: {0.1, 0.06, 0.12} }
        header : ShipYellow { Position: {-0.23, -0.035, 0}; Box: {0.08, 0.05, 0.9} }
        reel : ShipYellow {
          Position: {-0.27, -0.1, 0}
          Rotation: {HALF_PI, 0, 0}
          Cylinder: {radius: 0.03, length: 0.86, segments: 8, smooth: true}
        }

        auger : ShipSteel {
          Position: {0.12, -0.24, 0.2}
          Rotation: {HALF_PI, 0, 0}
          Cylinder: {radius: 0.014, length: 0.26, segments: 6, smooth: true}
        }

        beacon : PowerLamp {
          Position: {-0.07, -0.31, 0}
          Box: {0.02, 0.012, 0.02}
          Emissive: {strength: 4 * lit, color: {255, 160, 50}}
        }

        for w in 0..2 {
          const wz = (w - 0.5) * 0.22
          "wheel_{w}" : ShipRubber {
            Position: {-0.04, -0.06, wz}
            Rotation: {HALF_PI, 0, 0}
            Cylinder: {radius: 0.06, length: 0.04, segments: 12, smooth: true}
          }

          "rear_{w}" : ShipRubber {
            Position: {0.18, -0.04, wz}
            Rotation: {HALF_PI, 0, 0}
            Cylinder: {radius: 0.04, length: 0.03, segments: 10, smooth: true}
          }
        }
      }
    }

    if field == 5 {
      for h in 0..12 {
        const hx = -0.95 + (h % 6) * 0.48 + seg_hash(seed + h, i, 3) * 0.04
        const hz = h < 6 ? -0.22 : 0.22
        "head_{h}" : AgriSunflower {
          Rotation: {0, 0, tilt(g, hx)}
          Position: {hx, ground(g, hx) - 0.2, hz}
          Cylinder: {radius: 0.065, length: 0.02, segments: 12, smooth: true}
        }

        "eye_{h}" : AgriSeed {
          Rotation: {0, 0, tilt(g, hx)}
          Position: {hx, ground(g, hx) - 0.211, hz}
          Cylinder: {radius: 0.03, length: 0.006, segments: 10, smooth: true}
        }
      }
    } else if field == 6 {
      for t in 0..8 {
        const tx = -0.75 + (t % 4) * 0.7 + seg_hash(seed + t, i, 3) * 0.03
        const tz = t < 4 ? -0.66 : 0.66
        const th = 0.2 + seg_hash(seed + t * 3, i, 3) * 0.03
        "trunk_{t}" : ShipBark {
          Rotation: {0, 0, tilt(g, tx)}
          Position: {tx, ground(g, tx) - th * 0.4, tz}
          Cylinder: {radius: 0.02, length: th * 0.8, segments: 6, smooth: true}
        }

        if seg_hash(seed + t * 5, i, 3) == 0 {
          "crown_{t}" : ShipLeaf {
            Rotation: {0, 0, tilt(g, tx)}
            Position: {tx, ground(g, tx) - th - 0.05, tz}
            Sphere: {radius: 0.13, segments: 10, smooth: true}
          }
        } else {
          "crown_{t}" : AgriOrchard {
            Rotation: {0, 0, tilt(g, tx)}
            Position: {tx, ground(g, tx) - th - 0.05, tz}
            Sphere: {radius: 0.13, segments: 10, smooth: true}
          }
        }
      }

      for b in 0..3 {
        const bx = 1.0 + (b % 2) * 0.13
        "crate_{b}" : ShipCrate {
          Rotation: {0, 0, tilt(g, bx)}
          Position: {
            bx,
            ground(g, bx) - 0.035 - (b / 2 >= 1 ? 0.07 : 0),
            0.06 * (b == 2 ? 1 : 0)
          }
          Box: {0.12, 0.07, 0.09}
        }
      }
    } else if field == 7 {
      for b in 0..12 {
        const bx = -0.9 + (b % 6) * 0.44 + (b < 6 ? 0 : 0.22)
        const bz = b < 6 ? -0.66 : 0.66
        "stook_{b}" : AgriWheatPale {
          Rotation: {PI, 0, tilt(g, bx)}
          Position: {bx, ground(g, bx) - 0.08, bz}
          Cone: {radius: 0.07, length: 0.16, segments: 10, smooth: true}
        }
      }

      tractor {
        Rotation: {0, 0, tilt(g, 0.2)}
        Position: {0.2, ground(g, 0.2), 0}
        body : ShipOrange {
          Position: {-0.02, -0.07, 0}
          RoundedBox: {0.22, 0.07, 0.1, 0.015, segments: 2}
        }

        cab : ShipGlass { Position: {0.04, -0.15, 0}; Box: {0.08, 0.09, 0.09} }
        roof : ShipWhite { Position: {0.04, -0.2, 0}; Box: {0.1, 0.01, 0.11} }
        hitch : ShipTrim { Position: {0.14, -0.04, 0}; Box: {0.08, 0.015, 0.015} }
        bed : ShipTrim { Position: {0.33, -0.07, 0}; Box: {0.26, 0.03, 0.15} }
        load : AgriStraw { Position: {0.33, -0.12, 0}; Box: {0.22, 0.07, 0.12} }

        for w in 0..2 {
          const wz = (w - 0.5) * 0.12
          "rear_{w}" : ShipRubber {
            Position: {0.04, -0.045, wz}
            Rotation: {HALF_PI, 0, 0}
            Cylinder: {radius: 0.045, length: 0.025, segments: 10, smooth: true}
          }

          "front_{w}" : ShipRubber {
            Position: {-0.1, -0.03, wz}
            Rotation: {HALF_PI, 0, 0}
            Cylinder: {radius: 0.03, length: 0.02, segments: 8, smooth: true}
          }

          "trailer_wheel_{w}" : ShipRubber {
            Position: {0.33, -0.03, (w - 0.5) * 0.17}
            Rotation: {HALF_PI, 0, 0}
            Cylinder: {radius: 0.03, length: 0.02, segments: 8, smooth: true}
          }
        }
      }
    }
  }

  template AgriRing {
    prop r: f32 = 1
    prop seed: i32 = 0
    prop power: f32 = 1

    const dir = seed % 2 == 0 ? 1 : -1
    const ro = RING_R
    const rl = RING_DECK
    const sky = RING_SKY
    const g = ro - 0.62
    const n = RING_MODS
    const step = 2 * PI / n
    const am = step / 2
    const rise = rl - sky
    const vr = (rise * rise + RING_W * RING_W) / (2 * rise)
    const va = asin(RING_W / vr)
    const gz = (RING_IN + RING_W) / 2
    const gap = 0.004
    const arc = step - 2 * gap
    const xg = -1.3
    const xc = 0.55
    const c0 = step / 2 - (xc - 0.24) / g - gap

    RingHub hub(r: r)
    phase {
      Rotation: {0, 0, ring_phase(seed)}
      rotor {
        AngularVelocity: {0, 0, dir * ring_spin(seed)}
        RingChassis chassis(r: r, seed: seed, power: power)
        soil : AgriLoam {
          Rotation: {HALF_PI, 0, 0}
          Tube: {
            radius: ro - 0.3,
            thickness: 0.32,
            length: 2 * RING_IN,
            segments: 144,
            smooth: true
          }
        }

        vault : ShipGlass {
          Rotation: {HALF_PI, 0, 0}
          TorusShell: {
            radius: sky + vr,
            tube: vr,
            ring_start: 0,
            ring_end: 2 * PI,
            tube_start: PI - va,
            tube_end: PI + va,
            thickness: 0.04,
            segments: 144,
            rings: 32
          }
        }

        for c in 0..5 {
          "channel_{c}" : ShipWater {
            Position: {0, 0, (c - 2) * 0.44}
            Rotation: {HALF_PI, 0, 0}
            Tube: {radius: g + 0.002, thickness: 0.008, length: 0.05, segments: 144, smooth: true}
          }
        }

        sun : PowerLamp {
          Rotation: {HALF_PI, 0, 0}
          Torus: {radius: sky - 0.02, tube: 0.04, segments: 144, rings: 4, smooth: true}
          Emissive: {strength: 4 * power, color: {220, 236, 255}}
        }

        for s in 0..2 {
          const sz = (s - 0.5) * 2
          "gallery_{s}" : ShipGlass {
            Position: {0, 0, sz * gz}
            Rotation: {HALF_PI, 0, 0}
            Tube: {radius: rl - 0.02, thickness: 0.22, length: 0.36, segments: 144, smooth: true}
          }

          "gallery_bed_{s}" : ShipLeafDark {
            Position: {0, 0, sz * gz}
            Rotation: {HALF_PI, 0, 0}
            Tube: {radius: rl - 0.02, thickness: 0.05, length: 0.3, segments: 144, smooth: true}
          }

          "gallery_bloom_{s}" : AgriCanola {
            Position: {0, 0, sz * gz}
            Rotation: {HALF_PI, 0, 0}
            Tube: {radius: rl - 0.02, thickness: 0.08, length: 0.14, segments: 144, smooth: true}
          }

          "rail_{s}" : ShipSteel {
            Position: {0, 0, sz * 1.32}
            Rotation: {HALF_PI, 0, 0}
            Torus: {radius: g - 0.012, tube: 0.012, segments: 144, rings: 4, smooth: true}
          }
        }

        for i in 0..6 {
          "daylight_{i}" {
            Rotation: {0, 0, i * PI / 3}
            glow : PowerLight {
              Position: {0, sky + 0.3, 0}
              PointLight: {intensity: 30 * lit_share(power, i, 6), range: 9}
              Rgb: {255, 230, 190}
            }
          }
        }

        for i in 0..n {
          const depot = i % 4 == 1
          const field = agri_field(seed, i)
          const reap = field < 3 && (i * 7 + seed * 5) % 4 < 2
          const lit = lit_share(power, seg_hash(seed + 5, i, 4), 4)
          "plot_{i}" {
            Rotation: {0, 0, i * step}

            if depot {
              yard : ShipPaving {
                Rotation: {0 - HALF_PI, 0, 0}
                Tube: {
                  radius: g + 0.004,
                  thickness: 0.014,
                  length: 2 * RING_IN - 0.06,
                  segments: 4,
                  smooth: true,
                  arc: step
                }
              }
            } else {
              path : ShipPaving { Position: {g - 0.004, 0, 0}; Box: {0.012, 0.09, 2.66} }
              AgriRingRows rows(
                seed: seed,
                i: i,
                field: field,
                reap: reap,
                g: g,
                arc: arc,
                c0: c0
              ) {
                Rotation: {0, 0, gap}
              }
            }

            for s in 0..2 {
              const sz = (s - 0.5) * 2
              "gallery_rib_{s}" : ShipTrim {
                Position: {cos(am) * (rl - 0.13), sin(am) * (rl - 0.13), sz * gz}
                Rotation: {0, 0, am}
                Box: {0.22, 0.02, 0.38}
              }
            }
          }

          if depot {
            AgriRingDepot "zone_{i}"(g: g, lit: lit) {
              Rotation: {0, 0, (i + 0.5) * step - HALF_PI}
            }
          } else {
            AgriRingField "zone_{i}"(
              seed: seed,
              i: i,
              field: field,
              reap: reap,
              g: g,
              xg: xg,
              xc: xc,
              lit: lit
            ) {
              Rotation: {0, 0, (i + 0.5) * step - HALF_PI}
            }
          }
        }
      }
    }
  }

  template Reactor {
    prop r: f32 = 1
    prop fe: i32 = 0
    prop be: i32 = 0
    prop power: f32 = 1
    prop heat: f32 = 0
    prop trip: bool = false

    const tr = r * 0.98
    const tt = r * 0.42
    const vf = fe == 0 ? 0 : 0.01
    const vb = be == 0 ? 0 : 0.01
    const on = power > 0
    const hg = heat_glow(heat)
    // A tripped reactor glows red while it is still hot; one switched off only has its idle seam
    const alarm = trip && !on && heat > 0
    const seam_glow: Emissive = match on {
      true: {7 * power, {200, 110, 255}}
      _: match alarm { true: {2 + 4 * heat, {255, 40, 24}}; _: {0.3, {200, 110, 255}} }
    }
    const light_rgb: Rgb = match alarm { true: {255, 60, 40}; _: {200, 120, 255} }
    const shell_rgb: Rgb = match alarm { true: {255, 24, 12}; _: heat_rgb(hg) }
    vessel : ShipHullDark {
      Position: {0, 0, (vb - vf) / 2}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: r * 0.78, length: SEG - vf - vb, segments: 32, smooth: true}
    }

    shell : ShipHullDarkFine {
      Rotation: {HALF_PI, 0, 0}
      Torus: {radius: tr, tube: tt, segments: 48, rings: 20, smooth: true}
      Emissive: {strength: 2.5 * hg, color: shell_rgb}

      if on {
        Transition: [Emissive: {duration: 3, timing_function: EaseInOut}]
      } else {
        Transition: [Emissive: {duration: 7, timing_function: EaseOut}]
      }
    }

    seam : ShipFusionSeam {
      Rotation: {HALF_PI, 0, 0}
      Torus: {radius: tr + tt, tube: 0.05, segments: 64, rings: 4, smooth: true}
      Emissive: seam_glow
    }

    flare : ShipFusionFade {
      Rotation: {HALF_PI, 0, 0}
      Torus: {radius: tr + tt, tube: 0.06, segments: 64, rings: 4, smooth: true}
      Opacity: {on ? power : 0}
    }

    glow : PowerLight {
      Position: {0, 0, 0}
      PointLight: {intensity: on ? 3 * power : (alarm ? 1 + 2 * heat : 0), range: r * 4}
      Rgb: light_rgb
    }

    for i in 0..10 {
      "coil_{i}" {
        Rotation: {0, 0, i * PI / 5}
        winding : ShipCopper {
          Position: {tr, 0, 0}
          Torus: {radius: tt + 0.1, tube: 0.1, segments: 20, rings: 6, smooth: true}
        }
      }
    }

    for s in 0..2 {
      "hazard_{s}" : ShipHazard {
        Position: {0, 0, (s - 0.5) * 3.3}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: r * 0.8, length: 0.3, segments: 32, smooth: true}
      }

      if alarm {
        for i in 0..2 {
          "alarm_{s}_{i}" : ShipWarning {
            Position: {0, (i - 0.5) * 2 * (r * 0.8 + 0.08), (s - 0.5) * 3.3}
            Sphere: {radius: 0.14, segments: 8, smooth: true}
          }
        }
      }
    }

    SpineEnds ends(r: r, fe: fe, be: be)
  }

  template RadiatorWing {
    prop r: f32 = 1
    prop core: bool = true
    prop heat: f32 = 0
    prop cool: bool = false
    prop p: i32 = 0

    const span = core ? 10 : 5.6
    const bays = core ? 6 : 3
    const bay = span / bays
    const hr = r * 0.85
    const x0 = hr + 0.86
    const x1 = x0 + span
    const bh = 0.17
    const pin = 0.25
    const pw = core ? 1.78 : 1.5
    const pc = (pw + pin) / 2
    const pl = pw - pin
    const dl = sqrt(bay * bay + 4 * bh * bh)
    const dt = atan(2 * bh / bay)
    const ax = cos(0.62) * hr
    const ay = sin(0.62) * hr
    const bx = x0 + bay * 1.4
    const sl = sqrt((bx - ax) * (bx - ax) + (ay - bh) * (ay - bh))
    const st = atan2(ay - bh, bx - ax)
    const glow: Rgb = {255, 90 + 165 * heat, 60 + 195 * heat}
    const pump: Emissive = match heat > 0 {
      true: {1.5 + 3 * heat, {90, 255, 110}}
      _: {0.5, {255, 160, 50}}
    }
    station : ShipHullDarkFine { Position: {hr + 0.12, 0, 0}; Box: {0.62, 1.1, 3.1} }
    roof : ShipTrim { Position: {hr + 0.44, 0, 0}; Box: {0.04, 1.14, 3.14} }

    for s in 0..2 {
      const sz = (s - 0.5) * 1.7
      "pump_{s}" : ShipSteel {
        Position: {hr + 0.66, 0, sz}
        Cylinder: {radius: 0.2, length: 0.8, segments: 16, smooth: true}
      }

      for e in 0..2 {
        "motor_{s}_{e}" : ShipTrim {
          Position: {hr + 0.66, (e - 0.5) * 0.9, sz}
          Cylinder: {radius: 0.23, length: 0.16, segments: 16, smooth: true}
        }
      }

      "riser_{s}" : ShipSteel {
        Position: {hr + 0.66, 0, sz * 0.62}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: 0.07, length: abs(sz) * 0.75, segments: 8, smooth: true}
      }

      "valve_{s}" : ShipTrim {
        Position: {hr + 0.66, 0, sz * 0.4}
        Rotation: {HALF_PI, 0, 0}
        Torus: {radius: 0.11, tube: 0.025, segments: 12, rings: 4}
      }
    }

    status : PowerLamp {
      Position: {hr + 0.47, 0.42, 1.3}
      Box: {0.02, 0.1, 0.18}
      Emissive: pump
    }

    joint : ShipSteel {
      Position: {hr + 0.68, 0, 0}
      Rotation: {0, 0, HALF_PI}
      Cylinder: {radius: 0.3, length: 0.36, segments: 20, smooth: true}
    }

    bearing : ShipTrim {
      Position: {hr + 0.78, 0, 0}
      Rotation: {0, 0, HALF_PI}
      Cylinder: {radius: 0.34, length: 0.08, segments: 20, smooth: true}
    }

    for c in 0..4 {
      const cy = (c % 2 - 0.5) * 2 * bh
      const cz = ((c - c % 2) / 2 - 0.5) * 2 * bh
      "chord_{c}" : ShipSteel { Position: {(x0 + x1) / 2, cy, cz}; Box: {span, 0.05, 0.05} }
    }

    for s in 0..2 {
      const sy = (s - 0.5) * 2
      "line_{s}" : ShipInsulation {
        Position: {(x0 + x1) / 2, sy * 0.07, 0}
        Rotation: {0, 0, HALF_PI}
        Cylinder: {radius: 0.05, length: span, segments: 8, smooth: true}
      }

      "strut_{s}" : ShipSteel {
        Position: {(ax + bx) / 2, sy * (ay + bh) / 2, 0}
        Rotation: {0, 0, 0 - sy * st - HALF_PI}
        Cylinder: {radius: 0.045, length: sl, segments: 6, smooth: true}
      }

      "foot_{s}" : ShipTrim {
        Position: {ax, sy * ay, 0}
        Rotation: {0, 0, sy * 0.62}
        Box: {0.14, 0.24, 0.24}
      }

      "edge_{s}" : ShipTrim {
        Position: {(x0 + x1) / 2, 0, sy * (pw + 0.025)}
        Box: {span, 0.07, 0.05}
      }
    }

    for b in 0..bays + 1 {
      const fx = x0 + b * bay
      "batten_y_{b}" : ShipSteel { Position: {fx, 0, 0}; Box: {0.04, 2 * bh, 2 * bh + 0.05} }
      "spar_{b}" : ShipTrim { Position: {fx, 0, 0}; Box: {0.07, 0.06, 2 * pw} }
    }

    for b in 0..bays {
      const mx = x0 + (b + 0.5) * bay
      const flip = (b % 2 - 0.5) * 2
      const hot = 4 * pow(0.45, b * 6.0 / bays) * heat

      for s in 0..2 {
        const sz = (s - 0.5) * 2
        const tone = 200 + seg_hash(p * 2 + s + 5, b, 6) * 10
        "panel_{b}_{s}" : ShipRadiatorPanel {
          Position: {mx, 0, sz * pc}
          Box: {bay - 0.08, 0.04, pl}
          Rgb: {tone, tone, tone}
          Emissive: {strength: hot, color: glow}

          if cool {
            Transition: [Emissive: {duration: 7, timing_function: EaseOut}]
          } else {
            Transition: [Emissive: {duration: 3, timing_function: EaseInOut}]
          }
        }

        "diag_z_{b}_{s}" : YardGirder {
          Position: {mx, 0, sz * bh}
          Rotation: {0, 0, flip * dt}
          Box: {dl, 0.035, 0.035}
        }

        "diag_y_{b}_{s}" : YardGirder {
          Position: {mx, sz * bh, 0}
          Rotation: {0, flip * dt, 0}
          Box: {dl, 0.035, 0.035}
        }
      }
    }

    tip : ShipTrim { Position: {x1 + 0.06, 0, 0}; Box: {0.12, 0.4, 2 * pw + 0.1} }
    lamp : ShipBeaconRed {
      Position: {x1 + 0.16, 0, 0}
      Sphere: {radius: 0.08, segments: 3, smooth: true}
    }
  }

  template Radiator {
    prop r: f32 = 1
    prop core: bool = true
    prop heat: f32 = 0
    prop cool: bool = false

    const n = core ? 4 : 2
    const hr = r * 0.85
    body : ShipHullDarkFine {
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: hr, length: SEG, segments: 32, smooth: true}
    }

    for s in 0..2 {
      const sz = (s - 0.5) * 2
      "flange_{s}" : ShipTrim {
        Position: {0, 0, sz * (SEG / 2 - 0.15)}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: hr + 0.1, length: 0.3, segments: 32, smooth: true}
      }

      "rib_{s}" : ShipTrim {
        Position: {0, 0, sz * 0.55}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: hr + 0.05, length: 0.12, segments: 32, smooth: true}
      }
    }

    supply : ShipSteel {
      Position: {0, 0, 1.45}
      Rotation: {HALF_PI, 0, 0}
      Torus: {radius: hr + 0.2, tube: 0.13, segments: 40, rings: 8, smooth: true}
    }

    return : ShipInsulation {
      Position: {0, 0, -1.45}
      Rotation: {HALF_PI, 0, 0}
      Torus: {radius: hr + 0.2, tube: 0.15, segments: 40, rings: 8, smooth: true}
    }

    for i in 0..4 {
      const a = i * HALF_PI + (core ? 0 : PI / 8)
      "trunk_{i}" : ShipInsulation {
        Position: {cos(a) * (hr + 0.1), sin(a) * (hr + 0.1), 0}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: 0.12, length: SEG - 0.3, segments: 10, smooth: true}
      }

      for s in 0..3 {
        "strap_{i}_{s}" : ShipTrim {
          Position: {cos(a) * (hr + 0.1), sin(a) * (hr + 0.1), (s - 1) * 0.9}
          Rotation: {HALF_PI, 0, 0}
          Cylinder: {radius: 0.145, length: 0.08, segments: 10, smooth: true}
        }
      }
    }

    for p in 0..n {
      RadiatorWing "wing_{p}"(r: r, core: core, heat: heat, cool: cool, p: p) {
        Rotation: {0, 0, core ? PI / 4 + p * HALF_PI : (p == 0 ? PI / 4 : 0 - PI / 4)}
      }
    }
  }

  template JumpDriveCatwalk {
    prop r: f32 = 1
    prop power: f32 = 1

    Position: {0, r * 0.8 + 0.03, 0}
    deck : ShipDeckFine { Box: {0.5, 0.04, 3.3} }

    for s in 0..2 {
      const sx = (s - 0.5) * 0.46
      "rail_{s}" : ShipSteel { Position: {sx, 0.14, 0}; Box: {0.025, 0.025, 3.3} }
      "edge_{s}" : PowerRunLightsCyan {
        Position: {(s - 0.5) * 0.51, 0, 0}
        Box: {0.02, 0.015, 3.3}
        Emissive: {strength: 6 * power, color: {90, 214, 255}}
      }

      for p in 0..7 {
        "post_{s}_{p}" : ShipSteel {
          Position: {sx, 0.08, p * 0.55 - 1.65}
          Box: {0.02, 0.12, 0.02}
        }
      }
    }
  }

  template JumpDriveRotor {
    prop r: f32 = 1
    prop power: f32 = 1
    prop spin: f32 = 1

    const coil: Emissive = {6 * power, {110, 236, 255}}
    const pr = r * 1.15
    AngularVelocity: {0, 0, 0.3 * spin}

    for g in 0..2 {
      const gz = (g - 0.5) * 1.3
      "ring_{g}" : ShipChrome {
        Position: {0, 0, gz}
        Rotation: {HALF_PI, 0, 0}
        Torus: {radius: pr, tube: 0.05, segments: 40, rings: 4, smooth: true}
      }

      for i in 0..6 {
        const a = i * PI / 3 + g * PI / 6
        "vane_{g}_{i}" : ShipTrim {
          Position: {cos(a) * pr, sin(a) * pr, gz}
          Rotation: {0, 0, a}
          Box: {0.5, 0.03, 0.36}
        }

        "node_{g}_{i}" : ShipJumpCoil {
          Position: {cos(a) * (pr + 0.26), sin(a) * (pr + 0.26), gz}
          Rotation: {0, 0, a}
          Box: {0.06, 0.12, 0.12}
          Emissive: coil
        }

        "pulse_{g}_{i}" : ShipJumpFade {
          Position: {cos(a) * (pr + 0.26), sin(a) * (pr + 0.26), gz}
          Rotation: {0, 0, a}
          Box: {0.07, 0.13, 0.13}
          Opacity: {power}
        }
      }
    }
  }

  template JumpDrive {
    prop r: f32 = 1
    prop fe: i32 = 0
    prop be: i32 = 0
    prop power: f32 = 1
    prop spin: f32 = 1

    const cr = r * 1.55
    const hub = r * 0.78
    shaft : ShipHullDarkFine {
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: r * 0.6, length: SEG, segments: 24, smooth: true}
    }

    for s in 0..2 {
      "seam_{s}" : ShipRecess {
        Position: {0, 0, (s - 0.5) * 0.6}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: r * 0.605, length: 0.03, segments: 24, smooth: true}
      }

      "joint_{s}" : ShipRecess {
        Position: {0, 0, (s - 0.5) * 2}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: r * 0.605, length: 0.03, segments: 24, smooth: true}
      }

      "manifold_{s}" : ShipTrim {
        Position: {0, 0, (s - 0.5) * 3.3}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: r * 0.8, length: 0.18, segments: 32, smooth: true}
      }
    }

    for c in 0..3 {
      const cz = (c - 1) * 1.3
      "collar_{c}" : ShipHullDark {
        Position: {0, 0, cz}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: hub, length: 0.44, segments: 32, smooth: true}
      }

      "hazard_{c}" : ShipHazard {
        Position: {0, 0, cz}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: r * 0.79, length: 0.12, segments: 32, smooth: true}
      }

      for s in 0..2 {
        "lip_{c}_{s}" : ShipSteel {
          Position: {0, 0, cz + (s - 0.5) * 0.4}
          Rotation: {HALF_PI, 0, 0}
          Cylinder: {radius: r * 0.8, length: 0.06, segments: 32, smooth: true}
        }
      }

      "coil_{c}" : ShipJumpCoil {
        Position: {0, 0, cz}
        Rotation: {HALF_PI, 0, 0}
        Torus: {radius: cr, tube: 0.12, segments: 48, rings: 8, smooth: true}
        Rgb: {96 + 74 * power, 128 + 122 * power, 136 + 119 * power}
        Emissive: {strength: 6 * lit_share(power, c, 3), color: {110, 236, 255}}
      }

      "pulse_{c}" : ShipJumpFade {
        Position: {0, 0, cz}
        Rotation: {HALF_PI, 0, 0}
        Torus: {radius: cr, tube: 0.13, segments: 48, rings: 8, smooth: true}
        Opacity: {lit_share(power, c, 3)}
      }

      for w in 0..4 {
        const ws = (w % 2 - 0.5) * 2
        "winding_{c}_{w}" : ShipCopper {
          Position: {0, 0, cz + ws * (0.2 + (w - w % 2) * 0.06)}
          Rotation: {HALF_PI, 0, 0}
          Torus: {radius: cr, tube: 0.05, segments: 48, rings: 6, smooth: true}
        }
      }

      for i in 0..12 {
        const a = i * PI / 6
        "clamp_{c}_{i}" : ShipTrim {
          Position: {cos(a) * cr, sin(a) * cr, cz}
          Rotation: {0, 0, a}
          Box: {0.38, 0.24, 0.82}
        }

        "cap_{c}_{i}" : ShipSteel {
          Position: {cos(a) * (cr + 0.21), sin(a) * (cr + 0.21), cz}
          Rotation: {0, 0, a}
          Box: {0.05, 0.16, 0.6}
        }
      }

      for s in 0..4 {
        const a = PI / 4 + s * HALF_PI
        const sr = (hub - 0.05 + cr - 0.05) / 2
        const sl = cr - hub
        "spoke_{c}_{s}" : ShipTrim {
          Position: {cos(a) * sr, sin(a) * sr, cz}
          Rotation: {0, 0, a}
          Box: {sl, 0.14, 0.26}
        }

        "feed_{c}_{s}" : ShipCopper {
          Position: {cos(a) * sr, sin(a) * sr, cz + 0.19}
          Rotation: {0, 0, a - HALF_PI}
          Cylinder: {radius: 0.04, length: sl, segments: 6}
        }
      }
    }

    for i in 0..6 {
      const a = PI / 6 + i * PI / 3
      "stringer_{i}" : ShipSteel {
        Position: {cos(a) * (cr + 0.13), sin(a) * (cr + 0.13), 0}
        Rotation: {0, 0, a}
        Box: {0.1, 0.12, 3.3}
      }
    }

    for c in 0..2 {
      const bz = (c - 0.5) * 2.6
      "beacon_top_{c}" : ShipBeaconWhite {
        Position: {0, cr + 0.3, bz}
        Sphere: {radius: 0.07, segments: 3, smooth: true}
      }

      "beacon_port_{c}" : ShipBeaconRed {
        Position: {0 - cr - 0.3, 0, bz}
        Sphere: {radius: 0.07, segments: 3, smooth: true}
      }

      "beacon_stbd_{c}" : ShipBeaconGreen {
        Position: {cr + 0.3, 0, bz}
        Sphere: {radius: 0.07, segments: 3, smooth: true}
      }
    }

    for i in 0..4 {
      const a = PI / 4 + i * HALF_PI
      "conduit_{i}" : ShipCopper {
        Position: {cos(a) * r * 0.68, sin(a) * r * 0.68, 0}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: 0.09, length: 3.3, segments: 8, smooth: true}
      }

      "line_{i}" : ShipTeal {
        Position: {cos(a + 0.22) * r * 0.645, sin(a + 0.22) * r * 0.645, 0}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: 0.05, length: 3.3, segments: 6, smooth: true}
      }
    }

    for g in 0..2 {
      for i in 0..3 {
        const a = (i - 2) * HALF_PI
        "cell_{g}_{i}" : ShipHullDark {
          Position: {cos(a) * r * 0.667, sin(a) * r * 0.667, (g - 0.5) * 1.3}
          Rotation: {0, 0, a}
          Box: {0.36, 0.7, 0.6}
        }

        "charge_{g}_{i}" : PowerLamp {
          Position: {cos(a) * (r * 0.667 + 0.19), sin(a) * (r * 0.667 + 0.19), (g - 0.5) * 1.3}
          Rotation: {0, 0, a}
          Box: {0.03, 0.5, 0.06}
          Emissive: {strength: 4 * lit_share(power, g * 3 + i, 6), color: {80, 214, 255}}
        }
      }
    }

    JumpDriveCatwalk catwalk(r: r, power: power)
    JumpDriveRotor rotor(r: r, power: power, spin: spin)

    field : ShipJumpFieldFade {
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: r * 1.45, length: SEG * 0.9, segments: 40, smooth: true}
      Opacity: {0.1 * power}
    }

    glow : PowerLight {
      Position: {0, 0, 0}
      PointLight: {intensity: 4 * power, range: r * 5}
      Rgb: {110, 236, 255}
    }

    SpineEnds ends(r: r, fe: fe, be: be)
  }
}

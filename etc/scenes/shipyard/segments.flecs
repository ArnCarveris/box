using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.picking
using box.input
using box.spatial
using box.transition
using box.movement
using box.particle
using box.light
using box.animation
using state

state {
  fn cargo_tint(n: i32) -> Rgb {
    match n % 6 {
      0: {214, 96, 58}
      1: {64, 112, 168}
      2: {222, 178, 70}
      3: {70, 146, 122}
      4: {214, 216, 222}
      _: {140, 70, 96}
    }
  }

  fn seg_hash(seed: i32, i: i32, n: i32) -> i32 { (seed * 31 + i * 17 + seed * i * 7) % n }

  export const RING_W: f32 = 1.8
  export const RING_IN: f32 = 1.35
  export const RING_KEEL: f32 = RING_R - 0.28
  export const RING_DECK: f32 = RING_R - 1.6
  export const RING_SKY: f32 = RING_R - 2.6
  export const RING_MODS: i32 = 24
  export const LIFT_LO: f32 = R_CORE * 1.28 + 0.92
  export const LIFT_HI: f32 = RING_SKY - 1.0
  export const LIFT_CYCLE: f32 = 104

  fn ring_service(i: i32) -> bool { i % 6 == 2 }

  fn ring_phase(seed: i32) -> f32 { ((seed * 37) % 23) * HALF_PI / 23 }

  fn ring_spin(seed: i32) -> f32 { 0.11 + ((seed * 13) % 5) * 0.005 }

  fn agri_field(seed: i32, i: i32) -> i32 { (seed * 13 + i * 5 + (i * i) % 7 + (i % 5) * 2) % 8 }

  fn ground(g: f32, x: f32) -> f32 { sqrt(g * g - x * x) }

  fn tilt(g: f32, x: f32) -> f32 { 0 - asin(x / g) }

  fn bell_x(t: f32) -> f32 {
    const u = 1 - t
    u * u * u * 0.3 + 3 * u * u * t * 0.62 + 3 * u * t * t * 0.95 + t * t * t
  }

  fn bell_y(t: f32) -> f32 {
    const u = 1 - t
    3 * u * u * t * 0.3 + 3 * u * t * t * 1.4 + t * t * t * 2.4
  }
}

assets {
  prefab ShipFusionSeam {
    Rgb: {120, 96, 140}
    Emissive: {strength: 0.3, color: {200, 110, 255}}
    Transition: [Emissive: {duration: 1.2, timing_function: EaseInOut}]
  }

  prefab ShipJumpCoil {
    Rgb: {96, 128, 136}
    Emissive: {strength: 0.25, color: {110, 236, 255}}
    Transition: [Emissive: {duration: 1, timing_function: EaseInOut}, Rgb: {duration: 1}]
  }

  liner_bell_outer {
    Path2D: {
      start: {0.3, 0},
      segments: [{kind: CubicBezier, end: {1.0, 2.4}, control1: {0.62, 0.3}, control2: {0.95, 1.4}}]
    }
  }

  liner_bell_inner {
    Path2D: {
      start: {0.26, 0},
      segments: [
        {kind: CubicBezier, end: {0.96, 2.4}, control1: {0.58, 0.32}, control2: {0.91, 1.42}}
      ]
    }
  }

  template MiniShuttle {
    prop paint: i32 = 0

    body : ShipHull { Position: {0, 1.5, -0.4}; RoundedBox: {4, 3, 4.8, 0.42, segments: 2} }

    if paint == 0 {
      band : ShipStripe { Position: {0, 1.98, -0.4}; Box: {4.02, 0.22, 4.0} }
    } else {
      band : ShipOrange { Position: {0, 1.98, -0.4}; Box: {4.02, 0.22, 4.0} }
    }

    CockpitNose nose(px: true, nx: true)
    drive : ShipHullDark { Position: {0, 1.5, -2.9}; Box: {2.6, 1.8, 0.3} }
    glow : ShipPlasma {
      Position: {0, 1.5, -3.06}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: 0.6, length: 0.04, segments: 8, smooth: true}
    }

    for s in 0..2 {
      "skid_{s}" : ShipTrim { Position: {s == 0 ? -1.4 : 1.4, -0.15, -0.4}; Box: {0.3, 0.3, 4} }
    }
  }

  template SpineEnd {
    prop r: f32 = 1
    prop side: f32 = 1
    prop open: bool = false

    flange : ShipTrim {
      Position: {0, 0, side * (SEG / 2 - 0.125)}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: r * 1.06, length: 0.24, segments: 32, smooth: true}
    }

    if open {
      dome {
        Position: {0, 0, side * (SEG / 2 - 0.02)}
        Rotation: {side * HALF_PI, 0, 0}
        flat {
          Scale: {1, 0.32, 1}
          shell : ShipHullFine {
            Position: {0, 0, 0}
            HemiSphere: {radius: r * 0.98, segments: 32, smooth: true}
          }
        }
      }

      port : ShipHullDark {
        Position: {0, 0, side * (SEG / 2 + r * 0.3)}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: r * 0.28, length: 0.16, segments: 16, smooth: true}
      }

      beacon : ShipBeaconWhite {
        Position: {0, 0, side * (SEG / 2 + r * 0.3 + 0.1)}
        Sphere: {radius: 0.09, segments: 3, smooth: true}
      }
    }
  }

  template SpineEnds {
    prop r: f32 = 1
    prop fe: i32 = 0
    prop be: i32 = 0

    if fe != 0 {
      SpineEnd front(r: r, side: 1, open: fe == 2)
    }

    if be != 0 {
      SpineEnd rear(r: r, side: -1, open: be == 2)
    }
  }

  template SpineTruss {
    prop r: f32 = 1

    const d = r * 0.62
    const w = d * 2
    const tilt = atan(w / SEG)
    const brace = sqrt(w * w + SEG * SEG)

    for i in 0..4 {
      const a = PI / 4 + i * HALF_PI
      "rail_{i}" : ShipSteel {
        Position: {cos(a) * d * 1.41421, sin(a) * d * 1.41421, 0}
        Rotation: {0, 0, a}
        Box: {0.2, 0.2, SEG}
      }

      "face_{i}" {
        Rotation: {0, 0, i * HALF_PI}
        brace_a : YardGirder {
          Position: {d, 0, 0}
          Rotation: {tilt, 0, 0}
          Box: {0.09, 0.09, brace}
        }

        brace_b : YardGirder {
          Position: {d, 0, 0}
          Rotation: {0 - tilt, 0, 0}
          Box: {0.09, 0.09, brace}
        }

        rung_a : ShipSteel { Position: {d, 0, SEG / 2 - 0.1}; Box: {0.14, w, 0.14} }
        rung_b : ShipSteel { Position: {d, 0, 0.1 - SEG / 2}; Box: {0.14, w, 0.14} }
      }
    }

    duct : ShipTeal {
      Position: {r * 0.22, 0 - r * 0.1, 0}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: r * 0.22, length: SEG, segments: 12, smooth: true}
    }

    cable : ShipCopper {
      Position: {0 - r * 0.26, r * 0.14, 0}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: r * 0.1, length: SEG, segments: 8, smooth: true}
    }

    walk : ShipRunLights { Position: {0, 0 - r * 0.38, 0}; Box: {r * 0.5, 0.04, SEG} }
  }

  template Quarters {
    prop r: f32 = 1
    prop fe: i32 = 0
    prop be: i32 = 0
    prop seed: i32 = 0
    prop power: f32 = 1

    const hatch: Emissive = match power > 0 {
      true: {4 * power, {90, 255, 110}}
      _: {1.2, {255, 50, 30}}
    }
    hull : ShipHullFine {
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: r, length: SEG, segments: 40, smooth: true}
    }

    for w in 0..3 {
      "deck_{w}" : PowerCabins {
        Position: {0, 0, (w - 1) * 1.15}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: r * 1.006, length: 0.62, segments: 40, smooth: true}
        Emissive: {strength: 1.8 * lit_share(power, w, 3), color: {255, 255, 255}}
      }
    }

    stripe : ShipStripe {
      Position: {0, 0, 1.78}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: r * 1.008, length: 0.12, segments: 40, smooth: true}
    }

    for h in 0..2 {
      "hatch_{h}" {
        Rotation: {0, 0, h * PI}
        door : ShipHullDark { Position: {r * 0.98, 0, -1.72}; Box: {0.12, r * 0.42, 0.34} }
        lamp : PowerLamp {
          Position: {r * 1.04, r * 0.26, -1.72}
          Box: {0.03, 0.06, 0.06}
          Emissive: hatch
        }
      }
    }

    SpineEnds ends(r: r, fe: fe, be: be)
  }

  template RingHub {
    prop r: f32 = 1

    housing : ShipHullDark {
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: r * 1.04, length: SEG, segments: 32, smooth: true}
    }

    for s in 0..2 {
      "race_{s}" : ShipChrome {
        Position: {0, 0, (s - 0.5) * 2.1}
        Rotation: {HALF_PI, 0, 0}
        Torus: {radius: r * 1.08, tube: 0.1, segments: 32, rings: 6, smooth: true}
      }

      "seal_{s}" : ShipYellow {
        Position: {0, 0, (s - 0.5) * 3.5}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: r * 1.08, length: 0.14, segments: 32, smooth: true}
      }
    }
  }

  prefab yard_lift {
    Clip: {duration: LIFT_CYCLE}
    y {
      Track: {
        component: Position,
        member: "y",
        curve: {
          kind: CurveBezier,
          keys: [
            {0, LIFT_LO, 0, 0},
            {12, LIFT_LO, 0, 0},
            {52, LIFT_HI, 0, 0},
            {64, LIFT_HI, 0, 0},
            {LIFT_CYCLE, LIFT_LO, 0, 0}
          ]
        }
      }
    }
  }

  template RingSpoke {
    prop r0: f32 = 1
    prop r1: f32 = 10
    prop phase: i32 = 0
    prop power: f32 = 1

    const len = r1 - r0
    const mid = (r0 + r1) / 2
    shaft : ShipHullSpin {
      Position: {0, mid, 0}
      Cylinder: {radius: 0.26, length: len - 0.02, segments: 12, smooth: true}
    }

    lift : PowerRunLightsCyan {
      Position: {0, mid, 0.25}
      Box: {0.08, len - 0.4, 0.04}
      Emissive: {strength: 6 * power, color: {90, 214, 255}}
    }

    for c in 0..3 {
      const a = c * 2.0944 + 0.5236
      "rail_{c}" : ShipSteel {
        Position: {cos(a) * 0.52, mid, sin(a) * 0.52}
        Cylinder: {radius: 0.055, length: len - 0.5, segments: 6, smooth: true}
      }
    }

    for b in 0..6 {
      "hoop_{b}" : ShipTrim {
        Position: {0, r0 + 0.25 + (b + 0.5) * (len - 0.5) / 6, 0}
        Torus: {radius: 0.52, tube: 0.045, segments: 12, rings: 4}
      }
    }

    for k in 0..2 {
      "car_{k}" {
        Position: {0, LIFT_LO, k == 0 ? 0.36 : -0.36}
        Animator: {clip: yard_lift, time: (phase + k * 52) % 104, speed: 1.5}
        const f = k == 0 ? 1 : -1
        cab : ShipHullSpin { RoundedBox: {0.3, 0.38, 0.15, 0.03, segments: 2} }
        stripe : ShipStripe { Position: {0, -0.1, 0}; Box: {0.304, 0.03, 0.154} }
        glazing : PowerWindow {
          Position: {0, 0.05, f * 0.076}
          Box: {0.24, 0.1, 0.006}
          Emissive: {strength: 3.2 * power, color: {255, 204, 136}}
        }

        for m in 0..3 {
          "mullion_{m}" : ShipTrim {
            Position: {(m - 1) * 0.08, 0.05, f * 0.08}
            Box: {0.01, 0.11, 0.006}
          }
        }

        for e in 0..2 {
          const ey = (e - 0.5) * 2
          "coupler_{e}" : ShipHullDarkSpin { Position: {0, ey * 0.2, 0}; Box: {0.26, 0.04, 0.13} }
          "buffer_{e}" : ShipTrim { Position: {0, ey * 0.23, 0}; Box: {0.14, 0.02, 0.08} }
          "fin_{e}" : ShipTrim { Position: {ey * 0.152, 0, 0}; Box: {0.006, 0.32, 0.11} }
          "door_{e}" : ShipHullDarkSpin {
            Position: {ey * 0.153, -0.01, 0}
            Box: {0.004, 0.2, 0.07}
          }

          "door_lamp_{e}" : PowerLamp {
            Position: {ey * 0.154, 0.11, 0}
            Box: {0.004, 0.015, 0.03}
            Emissive: {strength: 4 * power, color: {90, 255, 110}}
          }

          "shoe_{e}" : ShipSteel {
            Position: {ey * 0.09, 0, 0 - f * 0.085}
            Box: {0.05, 0.34, 0.025}
          }

          for w in 0..2 {
            "roller_{e}_{w}" : ShipRubber {
              Position: {ey * 0.09, (w - 0.5) * 0.26, 0 - f * 0.1}
              Rotation: {0, 0, HALF_PI}
              Cylinder: {radius: 0.018, length: 0.04, segments: 8, smooth: true}
            }
          }
        }

        beacon_up : ShipBeaconRed {
          Position: {0, 0.255, f * 0.04}
          Sphere: {radius: 0.014, segments: 4, smooth: true}
        }

        beacon_down : ShipBeaconWhite {
          Position: {0, -0.255, f * 0.04}
          Sphere: {radius: 0.014, segments: 4, smooth: true}
        }
      }
    }

    hub_foot : ShipHullDarkSpin {
      Position: {0, r0 + 0.3, 0}
      Cylinder: {radius: 0.62, length: 0.6, segments: 12, smooth: true}
    }

    junction : ShipHullDarkSpin {
      Position: {0, r1 - 0.35, 0}
      Frustum: {radius_bottom: 0.34, radius_top: 0.62, length: 0.7, segments: 20, smooth: true}
    }

    junction_ring : ShipTrim {
      Position: {0, r1 - 0.5, 0}
      Torus: {radius: 0.52, tube: 0.03, segments: 20, rings: 4, smooth: true}
    }

    for k in 0..4 {
      const ka = k * HALF_PI + PI / 4
      "junction_lamp_{k}" : PowerWindow {
        Position: {cos(ka) * 0.57, r1 - 0.2, sin(ka) * 0.57}
        Sphere: {radius: 0.025, segments: 6, smooth: true}
        Emissive: {strength: 3.2 * power, color: {255, 204, 136}}
      }
    }
  }

  template RingDeck {
    prop ro: f32 = 14
    prop ri: f32 = 12
    prop len: f32 = 1
    prop arc: f32 = 0.26
    prop shift: f32 = 0
    prop dark: bool = false
    prop lit: f32 = 1

    for j in 0..3 {
      "part_{j}" {
        Rotation: {0, 0, j * arc / 3}

        if dark {
          block : ShipHullDarkSpin {
            Rotation: {0 - HALF_PI, 0, 0}
            Tube: {
              radius: ro,
              thickness: ro - ri,
              length: len,
              segments: 2,
              smooth: true,
              arc: arc / 3
            }
          }
        } else {
          block : PowerCabins {
            Rotation: {0 - HALF_PI, 0, 0}
            Tube: {
              radius: ro,
              thickness: ro - ri,
              length: len,
              segments: 2,
              smooth: true,
              arc: arc / 3
            }
            texture.Transform: {scale_x: 1, scale_y: 1, offset_x: shift + j * 0.37, offset_y: 0}
            Emissive: {strength: 1.8 * lit, color: {255, 255, 255}}
          }
        }
      }
    }
  }

  template RingChassis {
    prop r: f32 = 1
    prop seed: i32 = 0
    prop power: f32 = 1

    const ro = RING_R
    const rk = RING_KEEL
    const rl = RING_DECK
    const step = 2 * PI / RING_MODS
    const am = step / 2
    collar : ShipHullSpin {
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: r * 1.28, length: 1.6, segments: 32, smooth: true}
    }

    for i in 0..4 {
      RingSpoke "spoke_{i}"(
        r0: r * 1.28,
        r1: RING_SKY,
        phase: (seed * 37 + i * 29) % 104,
        power: power
      ) {
        Rotation: {0, 0, i * HALF_PI + PI / 4}
      }
    }

    const kw = RING_W + 0.05
    const gw = 0.08
    const gz = 1.1

    for b in 0..2 {
      const bs = (b - 0.5) * 2
      "keel_outer_{b}" : ShipHullSpin {
        Position: {0, 0, bs * (kw + gz + gw) / 2}
        Rotation: {HALF_PI, 0, 0}
        Tube: {radius: ro, thickness: ro - rk, length: kw - gz - gw, segments: 144, smooth: true}
      }

      "keel_inner_{b}" : ShipHullSpin {
        Position: {0, 0, bs * gz / 2}
        Rotation: {HALF_PI, 0, 0}
        Tube: {radius: ro, thickness: ro - rk, length: gz - 2 * gw, segments: 144, smooth: true}
      }
    }

    for c in 0..3 {
      const cz = (c - 1) * gz
      "gutter_{c}" : ShipHullSpin {
        Position: {0, 0, cz}
        Rotation: {HALF_PI, 0, 0}
        Tube: {
          radius: ro - 0.09,
          thickness: ro - 0.09 - rk,
          length: 2 * gw + 0.004,
          segments: 144,
          smooth: true
        }
      }

      for e in 0..2 {
        "gutter_lip_{c}_{e}" : ShipHullSpin {
          Position: {0, 0, cz + (e - 0.5) * 2 * (gw + 0.012)}
          Rotation: {HALF_PI, 0, 0}
          Tube: {radius: ro + 0.025, thickness: 0.045, length: 0.024, segments: 144, smooth: true}
        }
      }
    }

    for s in 0..2 {
      "lip_{s}" : ShipTrim {
        Position: {0, 0, (s - 0.5) * 2 * (RING_W + 0.05)}
        Rotation: {HALF_PI, 0, 0}
        Torus: {radius: ro - 0.14, tube: 0.06, segments: 144, rings: 4, smooth: true}
      }
    }

    for i in 0..RING_MODS {
      const svc = ring_service(i)
      const lit = lit_share(power, seg_hash(seed + 3, i, 4), 4)
      "mod_{i}" {
        Rotation: {0, 0, i * step}

        for s in 0..2 {
          const sz = (s - 0.5) * 2
          const zc = sz * (RING_W + RING_IN) / 2
          const ox = seg_hash(seed + s, i, 7) * 0.31
          RingDeck "deck_{s}"(
            ro: rk,
            ri: rl,
            len: RING_W - RING_IN,
            arc: step,
            shift: ox,
            dark: svc,
            lit: lit
          ) {
            Position: {0, 0, zc}
          }

          if svc {
            "dock_{s}" : ShipSteel {
              Position: {cos(am) * (rl + 0.65), sin(am) * (rl + 0.65), sz * RING_W}
              Rotation: {HALF_PI, 0, 0}
              Cylinder: {radius: 0.32, length: 0.3, segments: 20, smooth: true}
            }

            "dock_ring_{s}" : ShipTrim {
              Position: {cos(am) * (rl + 0.65), sin(am) * (rl + 0.65), sz * (RING_W + 0.16)}
              Rotation: {HALF_PI, 0, 0}
              Torus: {radius: 0.3, tube: 0.04, segments: 20, rings: 4, smooth: true}
            }

            "dock_lamp_{s}" : ShipBeaconGreen {
              Position: {cos(am) * (rl + 1.05), sin(am) * (rl + 1.05), sz * (RING_W + 0.02)}
              Sphere: {radius: 0.04, segments: 4, smooth: true}
            }

            for f in 0..4 {
              const fa = step * (0.12 + f * 0.25)
              "fin_{s}_{f}" : ShipHeatFin {
                Position: {cos(fa) * (rl + 0.25), sin(fa) * (rl + 0.25), sz * (RING_W + 0.01)}
                Rotation: {0, 0, fa}
                Box: {0.4, 0.04, 0.02}
              }
            }
          }

          "cap_{s}" : ShipHullSpin {
            Position: {0, 0, zc}
            Rotation: {0 - HALF_PI, 0, 0}
            Tube: {
              radius: rl + 0.03,
              thickness: 0.05,
              length: RING_W - RING_IN + 0.02,
              segments: 4,
              smooth: true,
              arc: step
            }
          }

          "rib_{s}" : ShipHullDarkSpin {
            Position: {(ro + rl) / 2 - 0.02, 0, zc}
            Box: {ro - rl + 0.02, 0.1, RING_W - RING_IN + 0.06}
          }

          "bracket_{s}" : ShipTrim {
            Position: {ro - 0.05, 0, sz * gz}
            Box: {0.08, 0.05, 2 * gw + 0.05}
          }

          "seam_{s}" : ShipTrim {
            Position: {(ro + rl) / 2 - 0.02, 0, sz * (RING_W + 0.03)}
            Box: {ro - rl - 0.1, 0.03, 0.02}
          }

          "rail_{s}" : ShipTrim {
            Position: {cos(am) * (rl - 0.04), sin(am) * (rl - 0.04), sz * (RING_W - 0.01)}
            Rotation: {0, 0, am}
            Box: {0.05, step * rl, 0.015}
          }

          for k in 0..2 {
            const la = step * (0.25 + k * 0.5)
            const emergency = power == 0 && k == 0
            const lamp: Emissive = match emergency {
              true: {1.0, {255, 50, 30}}
              _: {4 * lit, {220, 236, 255}}
            }
            "lamp_{s}_{k}" : PowerLamp {
              Position: {cos(la) * (ro - 0.12), sin(la) * (ro - 0.12), sz * (RING_W + 0.06)}
              Box: {0.05, 0.05, 0.02}
              Emissive: lamp
            }
          }
        }
      }
    }
  }

  template HabRing {
    prop r: f32 = 1
    prop seed: i32 = 0
    prop power: f32 = 1

    const dir = seed % 2 == 0 ? 1 : -1
    const rk = RING_KEEL
    const rl = RING_DECK
    const ru = rl - 0.95
    const rs = ru - 0.42
    const step = 2 * PI / RING_MODS
    const am = step / 2

    RingHub hub(r: r)
    phase {
      Rotation: {0, 0, ring_phase(seed)}
      rotor {
        AngularVelocity: {0, 0, dir * ring_spin(seed)}
        RingChassis chassis(r: r, seed: seed, power: power)
        spine : ShipHullDarkSpin {
          Rotation: {HALF_PI, 0, 0}
          Tube: {radius: ru, thickness: ru - rs, length: 0.64, segments: 144, smooth: true}
        }

        for s in 0..2 {
          const sz = (s - 0.5) * 2
          "spine_edge_{s}" : ShipHullDarkSpin {
            Position: {0, 0, sz * 0.495}
            Rotation: {HALF_PI, 0, 0}
            Tube: {radius: ru, thickness: ru - rs, length: 0.11, segments: 144, smooth: true}
          }

          "gutter_{s}" : ShipHullSpin {
            Position: {0, 0, sz * 0.38}
            Rotation: {HALF_PI, 0, 0}
            Tube: {
              radius: ru,
              thickness: ru - rs - 0.07,
              length: 0.124,
              segments: 144,
              smooth: true
            }
          }

          for e in 0..2 {
            "gutter_lip_{s}_{e}" : ShipHullSpin {
              Position: {0, 0, sz * 0.38 + (e - 0.5) * 0.14}
              Rotation: {HALF_PI, 0, 0}
              Tube: {
                radius: rs + 0.01,
                thickness: 0.035,
                length: 0.018,
                segments: 144,
                smooth: true
              }
            }
          }
        }

        for i in 0..RING_MODS {
          const oy = seg_hash(seed + 9, i, 5) * 0.23
          "mod_{i}" {
            Rotation: {0, 0, i * step}
            core : ShipHullDarkSpin {
              Rotation: {0 - HALF_PI, 0, 0}
              Tube: {
                radius: rk,
                thickness: rk - rl,
                length: 2 * RING_IN,
                segments: 4,
                smooth: true,
                arc: step
              }
            }

            terrace : ShipHullSpin {
              Rotation: {0 - HALF_PI, 0, 0}
              Tube: {
                radius: rl + 0.03,
                thickness: 0.05,
                length: 2 * RING_IN,
                segments: 4,
                smooth: true,
                arc: step
              }
            }

            RingDeck up(
              ro: rl + 0.02,
              ri: ru,
              len: 2.5,
              arc: step,
              shift: oy,
              lit: lit_share(power, seg_hash(seed + 3, i, 4), 4)
            )
            roof : ShipHullSpin {
              Rotation: {0 - HALF_PI, 0, 0}
              Tube: {
                radius: ru + 0.03,
                thickness: 0.05,
                length: 2.54,
                segments: 4,
                smooth: true,
                arc: step
              }
            }

            rib_hi : ShipHullDarkSpin {
              Position: {(rl + ru) / 2, 0, 0}
              Box: {rl - ru + 0.06, 0.1, 2.56}
            }

            rib_sp : ShipTrim {
              Position: {(ru + rs) / 2 - 0.02, 0, 0}
              Box: {ru - rs + 0.06, 0.14, 1.16}
            }

            for s in 0..2 {
              const sz = (s - 0.5) * 2
              "edge_{s}" : ShipTrim {
                Position: {cos(am) * (ru - 0.03), sin(am) * (ru - 0.03), sz * 1.26}
                Rotation: {0, 0, am}
                Box: {0.04, step * ru, 0.02}
              }

              "plant_{s}" : ShipHullDarkSpin {
                Position: {cos(am) * (ru - 0.06), sin(am) * (ru - 0.06), sz * 0.85}
                Rotation: {0, 0, am}
                Box: {0.12, 0.7, 0.36}
              }

              "vent_{s}" : ShipHeatFin {
                Position: {cos(am) * (ru - 0.125), sin(am) * (ru - 0.125), sz * 0.85}
                Rotation: {0, 0, am}
                Box: {0.02, 0.5, 0.26}
              }
            }
          }
        }
      }
    }
  }

  template RingTree {
    prop h: f32 = 0.38
    prop kind: i32 = 0

    trunk : ShipBark {
      Position: {0, 0 - h * 0.45, 0}
      Cylinder: {radius: h * 0.06, length: h * 0.9, segments: 8, smooth: true}
    }

    if kind == 0 {
      for c in 0..3 {
        "tier_{c}" : ShipLeafDark {
          Position: {0, 0 - h * (0.75 + c * 0.32), 0}
          Rotation: {PI, 0, 0}
          Cone: {radius: h * (0.42 - c * 0.1), length: h * 0.62, segments: 14, smooth: true}
        }
      }
    } else if kind == 1 {
      crown : ShipLeaf {
        Position: {0, 0 - h * 1.12, 0}
        Sphere: {radius: h * 0.42, segments: 14, smooth: true}
      }

      lobe_a : ShipLeaf {
        Position: {h * 0.26, 0 - h * 0.95, h * 0.1}
        Sphere: {radius: h * 0.3, segments: 12, smooth: true}
      }

      lobe_b : ShipLeafDark {
        Position: {0 - h * 0.22, 0 - h * 0.98, 0 - h * 0.14}
        Sphere: {radius: h * 0.3, segments: 12, smooth: true}
      }

      lobe_c : ShipLeaf {
        Position: {0 - h * 0.05, 0 - h * 1.38, h * 0.12}
        Sphere: {radius: h * 0.24, segments: 12, smooth: true}
      }
    } else {
      crown : ShipLeafDark {
        Position: {0, 0 - h * 1.0, 0}
        Scale: {1, 0.72, 1}
        Sphere: {radius: h * 0.55, segments: 14, smooth: true}
      }

      lobe_a : ShipLeafDark {
        Position: {h * 0.3, 0 - h * 1.05, 0 - h * 0.18}
        Scale: {1, 0.8, 1}
        Sphere: {radius: h * 0.32, segments: 12, smooth: true}
      }

      lobe_b : ShipLeaf {
        Position: {0 - h * 0.28, 0 - h * 1.12, h * 0.2}
        Scale: {1, 0.8, 1}
        Sphere: {radius: h * 0.3, segments: 12, smooth: true}
      }
    }
  }

  template RingHouse {
    prop w: f32 = 0.5
    prop d: f32 = 0.4
    prop h: f32 = 0.3
    prop f: f32 = 1
    prop tower: bool = false
    prop lit: f32 = 1

    if tower {
      const hs = h * 0.78
      podium : ShipVilla {
        Position: {0, -0.06, 0}
        RoundedBox: {w * 1.35, 0.12, d * 1.35, 0.02, segments: 2}
      }

      shaft : PowerCabins {
        Position: {0, 0 - hs / 2, 0}
        RoundedBox: {w, hs, d, 0.03, segments: 2}
        Emissive: {strength: 1.8 * lit, color: {255, 255, 255}}
      }

      top : PowerCabins {
        Position: {0, 0 - hs - (h - hs) / 2, 0}
        RoundedBox: {w * 0.72, h - hs, d * 0.72, 0.025, segments: 2}
        Emissive: {strength: 1.8 * lit, color: {255, 255, 255}}
      }

      for k in 0..3 {
        "ledge_{k}" : ShipTrim {
          Position: {0, 0 - (k + 1) * hs / 4, 0}
          Box: {w + 0.02, 0.012, d + 0.02}
        }
      }

      setback : ShipMoss { Position: {0, 0 - hs - 0.006, 0}; Box: {w - 0.04, 0.012, d - 0.04} }
      crown : ShipTrim { Position: {0, 0 - h - 0.01, 0}; Box: {w * 0.76, 0.02, d * 0.76} }
      mast : ShipTrim {
        Position: {0, 0 - h - 0.08, 0}
        Cylinder: {radius: 0.006, length: 0.14, segments: 4}
      }

      beacon : ShipBeaconRed {
        Position: {0, 0 - h - 0.15, 0}
        Sphere: {radius: 0.014, segments: 4, smooth: true}
      }
    } else {
      const fl = h > 0.27 ? 2 : 1
      const fh = h / fl
      body : ShipVilla { Position: {0, 0 - h / 2, 0}; RoundedBox: {w, h, d, 0.012, segments: 2} }
      roof : ShipTrim {
        Position: {0, 0 - h - 0.008, 0}
        RoundedBox: {w + 0.04, 0.016, d + 0.04, 0.006, segments: 2}
      }

      parapet : ShipVilla {
        Position: {0, 0 - h - 0.024, f * (d / 2 + 0.01)}
        Box: {w + 0.04, 0.02, 0.012}
      }

      unit : ShipHullDarkSpin {
        Position: {w * 0.25, 0 - h - 0.03, 0 - f * d * 0.15}
        Box: {0.08, 0.04, 0.06}
      }

      for k in 0..fl {
        const ky = 0 - fh * (k + 0.55)
        "glaze_{k}" : PowerWindow {
          Position: {0, ky, f * (d / 2 + 0.003)}
          Box: {w * 0.82, fh * 0.5, 0.006}
          Emissive: {strength: 3.2 * lit, color: {255, 204, 136}}
        }

        "side_{k}" : PowerWindow {
          Position: {w / 2 + 0.003, ky, 0}
          Box: {0.006, fh * 0.4, d * 0.4}
          Emissive: {strength: 3.2 * lit, color: {255, 204, 136}}
        }

        for m in 0..4 {
          "mullion_{k}_{m}" : ShipTrim {
            Position: {(m - 1.5) * w * 0.27, ky, f * (d / 2 + 0.007)}
            Box: {0.008, fh * 0.52, 0.006}
          }
        }

        if k > 0 {
          "balcony_{k}" : ShipVilla {
            Position: {0, 0 - fh * k, f * (d / 2 + 0.05)}
            Box: {w * 0.7, 0.012, 0.1}
          }

          "balustrade_{k}" : ShipGlass {
            Position: {0, 0 - fh * k - 0.03, f * (d / 2 + 0.1)}
            Box: {w * 0.7, 0.05, 0.006}
          }
        }
      }

      porch : ShipPaving { Position: {0, -0.006, f * (d / 2 + 0.08)}; Box: {w * 0.9, 0.012, 0.16} }
    }
  }

  template EstateRingZoneBase {
    prop seed: i32 = 0
    prop i: i32 = 0
    prop lit: f32 = 1

    const g = RING_R - 0.62

    for s in 0..2 {
      const sz = (s - 0.5) * 2
      "shade_{s}" : RingTree {
        Rotation: {0, 0, tilt(g, 0.55)}
        Position: {0.55, ground(g, 0.55), sz * 0.42}
      }

      "shade_b_{s}" : RingTree {
        Rotation: {0, 0, tilt(g, -0.95)}
        Position: {-0.95, ground(g, -0.95), sz * 0.42}
      }

      "streetlamp_{s}" : PowerWindow {
        Rotation: {0, 0, tilt(g, -0.2)}
        Position: {-0.2, ground(g, -0.2) - 0.3, sz * 0.31}
        Sphere: {radius: 0.022, segments: 8, smooth: true}
        Emissive: {strength: 3.2 * lit, color: {255, 204, 136}}
      }

      "streetpole_{s}" : ShipTrim {
        Rotation: {0, 0, tilt(g, -0.2)}
        Position: {-0.2, ground(g, -0.2) - 0.14, sz * 0.31}
        Cylinder: {radius: 0.008, length: 0.28, segments: 6, smooth: true}
      }
    }

    if i % 2 == 0 {
      bridge : ShipPaving { Position: {0, g - 0.04, 0}; Box: {0.16, 0.03, 0.46} }

      for s in 0..2 {
        "bridge_rail_{s}" : ShipTrim {
          Position: {(s - 0.5) * 0.15, g - 0.08, 0}
          Box: {0.012, 0.05, 0.44}
        }
      }
    }
  }

  template EstateRingZone : EstateRingZoneBase {
    const g = RING_R - 0.62

    for s in 0..2 {
      const sz = (s - 0.5) * 2
      const kind = seg_hash(seed + s * 5, i, 4)
      const zc = sz * 0.84

      if kind == 0 {
        for b in 0..5 {
          const tall = seg_hash(seed + b, i, 5) == 0
          const hi = 0.9 + seg_hash(seed + b * 2, i, 3) * 0.15
          const lo = 0.26 + seg_hash(seed + b * 3, i, 4) * 0.06
          const bh = tall ? hi : lo
          RingHouse "house_{s}_{b}"(
            w: tall ? 0.4 : 0.5,
            d: tall ? 0.4 : 0.38,
            h: bh,
            f: 0 - sz,
            tower: tall,
            lit: lit
          ) {
            Rotation: {0, 0, tilt(g, (b - 2) * 0.64)}
            Position: {
              (b - 2) * 0.64,
              ground(g, (b - 2) * 0.64),
              zc + ((b % 2) - 0.5) * 0.36
            }
          }
        }

        for q in 0..3 {
          "plaza_{s}_{q}" : ShipPaving {
            Rotation: {0, 0, tilt(g, (q - 1) * 1.05)}
            Position: {(q - 1) * 1.05, ground(g, (q - 1) * 1.05) - 0.006, zc}
            Box: {1.05, 0.012, 0.16}
          }
        }
      } else if kind == 1 {
        for p in 0..3 {
          const px = (p - 1) * 1.1

          if seg_hash(seed + p, i, 3) == 0 {
            "house_glass_{s}_{p}" : ShipGlass {
              Rotation: {0, 0, tilt(g, px) + HALF_PI}
              Position: {px, ground(g, px), zc}
              Cylinder: {radius: 0.3, length: 0.95, segments: 24, smooth: true}
            }

            "house_grow_{s}_{p}" : PowerLamp {
              Rgb: {255, 150, 220}
              Rotation: {0, 0, tilt(g, px)}
              Position: {px, ground(g, px) - 0.28, zc}
              Box: {0.9, 0.008, 0.06}
              Emissive: {strength: 0.5 * lit, color: {255, 150, 220}}
            }

            for k in 0..5 {
              "house_hoop_{s}_{p}_{k}" : ShipTrim {
                Rotation: {0, 0, tilt(g, px + (k - 2) * 0.22) + HALF_PI}
                Position: {px + (k - 2) * 0.22, ground(g, px + (k - 2) * 0.22), zc}
                Tube: {
                  radius: 0.305,
                  thickness: 0.012,
                  length: 0.014,
                  segments: 24,
                  smooth: true
                }
              }
            }

            for q in 0..4 {
              "house_bed_{s}_{p}_{q}" : ShipLeaf {
                Rotation: {0, 0, tilt(g, px)}
                Position: {px, ground(g, px) - 0.015, zc + (q - 1.5) * 0.13}
                Box: {0.9, 0.03, 0.08}
              }
            }
          } else {
            for q in 0..3 {
              const crop = seg_hash(seed + p * 3 + q, i, 3)

              if crop == 0 {
                "plot_{s}_{p}_{q}" : ShipLeaf {
                  Rotation: {0, 0, tilt(g, px)}
                  Position: {px, ground(g, px) - 0.006, zc + (q - 1) * 0.3}
                  Box: {1.0, 0.012, 0.27}
                }
              } else if crop == 1 {
                "plot_{s}_{p}_{q}" : ShipLeafDark {
                  Rotation: {0, 0, tilt(g, px)}
                  Position: {px, ground(g, px) - 0.006, zc + (q - 1) * 0.3}
                  Box: {1.0, 0.012, 0.27}
                }
              } else {
                "plot_{s}_{p}_{q}" : ShipSoil {
                  Rotation: {0, 0, tilt(g, px)}
                  Position: {px, ground(g, px) - 0.006, zc + (q - 1) * 0.3}
                  Box: {1.0, 0.012, 0.27}
                }
              }
            }
          }
        }

        RingHouse "barn_{s}"(w: 0.3, d: 0.5, h: 0.26, f: 0 - sz, lit: lit) {
          Rotation: {0, 0, tilt(g, 1.62)}
          Position: {1.62, ground(g, 1.62), zc}
        }

        "silo_{s}" : ShipSteel {
          Rotation: {0, 0, tilt(g, 1.62)}
          Position: {1.62, ground(g, 1.62) - 0.25, zc + sz * 0.38}
          Cylinder: {radius: 0.09, length: 0.5, segments: 20, smooth: true}
        }
      } else if kind == 2 {
        "hill_{s}" : ShipMoss {
          Position: {0.2, g + 0.02, zc}
          Rotation: {PI, 0, 0}
          Scale: {1, 0.22, 0.7}
          HemiSphere: {radius: 1.2, segments: 40, smooth: true}
        }

        "pond_{s}" : ShipWater {
          Rotation: {0, 0, tilt(g, -1.3)}
          Position: {-1.3, ground(g, -1.3) - 0.007, zc - sz * 0.15}
          Scale: {1.5, 1, 1}
          Cylinder: {radius: 0.22, length: 0.014, segments: 32, smooth: true}
        }

        for t in 0..9 {
          const tx = (t - 4) * 0.36 + seg_hash(seed + t, i, 3) * 0.06
          const tz = zc + (seg_hash(seed + t * 2, i, 5) - 2) * 0.16
          const lift = tx > -0.9 ? 0.18 * (1 - abs(tx - 0.2) / 1.2) : 0
          RingTree "tree_{s}_{t}"(
            h: 0.3 + seg_hash(seed + t, i, 4) * 0.05,
            kind: seg_hash(seed + t * 5, i, 3)
          ) {
            Rotation: {0, 0, tilt(g, tx)}
            Position: {tx, ground(g, tx) - lift, tz}
          }
        }
      } else {
        for v in 0..2 {
          const vx = v == 0 ? -0.8 : 0.9
          RingHouse "villa_{s}_{v}"(w: 0.8, d: 0.46, h: 0.28, f: 0 - sz, lit: lit) {
            Rotation: {0, 0, tilt(g, vx)}
            Position: {vx, ground(g, vx), zc + sz * 0.12}
          }

          RingHouse "villa_wing_{s}_{v}"(w: 0.42, d: 0.34, h: 0.24, f: 0 - sz, lit: lit) {
            Rotation: {0, 0, tilt(g, vx + 0.18)}
            Position: {vx + 0.18, ground(g, vx + 0.18) - 0.28, zc + sz * 0.16}
          }

          "pool_{s}_{v}" : ShipPool {
            Rotation: {0, 0, tilt(g, vx - 0.1)}
            Position: {vx - 0.1, ground(g, vx - 0.1) - 0.009, zc - sz * 0.27}
            Box: {0.5, 0.014, 0.16}
          }

          "hedge_{s}_{v}" : ShipLeafDark {
            Rotation: {0, 0, tilt(g, vx)}
            Position: {vx, ground(g, vx) - 0.04, zc + sz * 0.38}
            Box: {0.9, 0.08, 0.05}
          }

          RingTree "garden_tree_{s}_{v}"(h: 0.34, kind: 1) {
            Rotation: {0, 0, tilt(g, vx + 0.42)}
            Position: {vx + 0.42, ground(g, vx + 0.42), zc - sz * 0.22}
          }
        }
      }
    }
  }

  template EstateRing {
    prop r: f32 = 1
    prop seed: i32 = 0
    prop power: f32 = 1

    const dir = seed % 2 == 0 ? 1 : -1
    const ro = RING_R
    const rl = RING_DECK
    const sky = RING_SKY
    const g = ro - 0.62
    const t1 = rl
    const n = RING_MODS
    const step = 2 * PI / n
    const am = step / 2
    const rise = rl - sky
    const vr = (rise * rise + RING_W * RING_W) / (2 * rise)
    const va = asin(RING_W / vr)

    RingHub hub(r: r)
    phase {
      Rotation: {0, 0, ring_phase(seed)}
      rotor {
        AngularVelocity: {0, 0, dir * ring_spin(seed)}
        RingChassis chassis(r: r, seed: seed, power: power)
        lawn : ShipMoss {
          Rgb: {58, 104, 56}
          Rotation: {HALF_PI, 0, 0}
          Tube: {
            radius: ro - 0.3,
            thickness: 0.32,
            length: 2 * RING_IN,
            segments: 144,
            smooth: true
          }
        }

        canal : ShipWater {
          Rotation: {HALF_PI, 0, 0}
          Tube: {radius: g + 0.02, thickness: 0.04, length: 0.32, segments: 144, smooth: true}
        }

        vault : ShipGlass {
          Rotation: {HALF_PI, 0, 0}
          TorusShell: {
            radius: sky + vr,
            tube: vr,
            ring_start: 0,
            ring_end: 2 * PI,
            tube_start: PI - va,
            tube_end: PI + va,
            thickness: 0.04,
            segments: 144,
            rings: 32
          }
        }

        sun : PowerLamp {
          Rotation: {HALF_PI, 0, 0}
          Torus: {radius: sky - 0.02, tube: 0.04, segments: 144, rings: 4, smooth: true}
          Emissive: {strength: 4 * power, color: {220, 236, 255}}
        }

        for s in 0..2 {
          const sz = (s - 0.5) * 2
          "quay_{s}" : ShipPaving {
            Position: {0, 0, sz * 0.2}
            Rotation: {HALF_PI, 0, 0}
            Tube: {radius: g + 0.015, thickness: 0.03, length: 0.08, segments: 144, smooth: true}
          }

          "road_{s}" : ShipPaving {
            Position: {0, 0, sz * 0.31}
            Rotation: {HALF_PI, 0, 0}
            Tube: {radius: g + 0.015, thickness: 0.025, length: 0.07, segments: 144, smooth: true}
          }

          "garden_{s}" : ShipMoss {
            Position: {0, 0, sz * (RING_IN + 0.17)}
            Rotation: {HALF_PI, 0, 0}
            Tube: {radius: rl - 0.015, thickness: 0.03, length: 0.3, segments: 144, smooth: true}
          }

          "balustrade_{s}" : ShipGlass {
            Position: {0, 0, sz * (RING_IN + 0.01)}
            Rotation: {HALF_PI, 0, 0}
            Tube: {radius: rl - 0.02, thickness: 0.05, length: 0.006, segments: 144, smooth: true}
          }

          for k in 0..3 {
            "ledge_{s}_{k}" : ShipTrim {
              Position: {0, 0, sz * (RING_IN - 0.025)}
              Rotation: {HALF_PI, 0, 0}
              Tube: {
                radius: g - (k + 1) * 0.245 + 0.008,
                thickness: 0.016,
                length: 0.05,
                segments: 144,
                smooth: true
              }
            }
          }
        }

        for i in 0..6 {
          "daylight_{i}" {
            Rotation: {0, 0, i * PI / 3}
            glow : PowerLight {
              Position: {0, sky + 0.3, 0}
              PointLight: {intensity: 30 * lit_share(power, i, 6), range: 9}
              Rgb: {255, 238, 210}
            }
          }
        }

        for i in 0..n {
          const lit = lit_share(power, seg_hash(seed + 5, i, 4), 4)
          "frame_{i}" {
            Rotation: {0, 0, i * step}

            for s in 0..2 {
              const sz = (s - 0.5) * 2
              RingTree "terrace_tree_{s}"(h: 0.24, kind: 2) {
                Position: {cos(am) * rl, sin(am) * rl, sz * (RING_IN + 0.1)}
                Rotation: {0, 0, am - HALF_PI}
              }

              "planter_{s}" : ShipLeafDark {
                Position: {
                  cos(step * 0.2) * (rl - 0.04),
                  sin(step * 0.2) * (rl - 0.04),
                  sz * (RING_IN + 0.32)
                }
                Rotation: {0, 0, step * 0.2}
                RoundedBox: {0.07, 0.6, 0.1, 0.03, segments: 2}
              }
            }
          }

          EstateRingZone "zone_{i}"(seed: seed, i: i, lit: lit) {
            Rotation: {0, 0, (i + 0.5) * step}
          }
        }
      }
    }
  }
}

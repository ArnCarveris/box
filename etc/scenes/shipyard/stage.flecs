using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.texture
using box.light
using box.movement
using box.spatial
using box.transition
using state

assets {
  yard_planet_tex { Path: {path: "etc/scenes/shipyard/assets/planet.jpg"} }
  yard_planet_night_tex { Path: {path: "etc/scenes/shipyard/assets/planet_night.jpg"} }
  yard_cloud_tex { Path: {path: "etc/scenes/shipyard/assets/clouds.png"} }
  yard_halo_tex { Path: {path: "etc/scenes/shipyard/assets/halo.png"} }

  // Drydock surfaces: weathered plating at the 10 m per unit scale of the liner, emissive dot
  // textures for windows and running lights so they read from the default camera distance
  prefab DockHull { Rgb: {134, 132, 126}; PbrMaterial: {metallic: 0.55, roughness: 0.62}; PbrTextures: {albedo: assets.yard_tex_hull, normal: assets.yard_tex_hull_normal, orm: assets.yard_tex_hull_orm}; TextureMapping: {MappingFrame, size: 3.5, blend: 0.3} }
  prefab DockHullDark { Rgb: {78, 82, 88}; PbrMaterial: {metallic: 0.65, roughness: 0.58}; PbrTextures: {albedo: assets.yard_tex_hull, normal: assets.yard_tex_hull_normal, orm: assets.yard_tex_hull_orm}; TextureMapping: {MappingFrame, size: 2.5, blend: 0.3} }
  prefab DockGrime { Rgb: {98, 84, 70}; PbrMaterial: {metallic: 0.4, roughness: 0.8}; PbrTextures: {albedo: assets.yard_tex_hull, normal: assets.yard_tex_hull_normal, orm: assets.yard_tex_hull_orm}; TextureMapping: {MappingFrame, size: 2, blend: 0.3} }
  prefab DockPipe { Rgb: {150, 134, 104}; PbrMaterial: {metallic: 0.6, roughness: 0.55} }
  prefab DockWindows { Rgb: {30, 33, 38}; PbrMaterial: {metallic: 0.5, roughness: 0.4}; Emissive: {strength: 1.4, color: {255, 220, 175}}; PbrTextures: {emissive: assets.yard_tex_windows}; TextureMapping: {MappingObject, size: 1.2} }
  prefab DockRunLights { Rgb: {40, 44, 52}; PbrMaterial: {metallic: 0.5, roughness: 0.5}; Emissive: {strength: 7, color: {255, 196, 120}}; PbrTextures: {emissive: assets.yard_tex_dots}; TextureMapping: {MappingObject, size: 1.5} }
  prefab DockRunLightsCyan { Rgb: {40, 44, 52}; PbrMaterial: {metallic: 0.5, roughness: 0.5}; Emissive: {strength: 7, color: {90, 214, 255}}; PbrTextures: {emissive: assets.yard_tex_dots}; TextureMapping: {MappingObject, size: 1.5} }

  template HoloLine {
    prop len: f32 = 1
    prop glow: f32 = 1.2

    Box: {len, 0.03, 0.03}
    Rgb: {70, 200, 255}
    Emissive: {strength: glow, color: {60, 190, 255}}
    NoShadow
    SpatialIgnore
  }

  template DeckGrid {
    prop level: i32 = 0

    const y = level * CH + 0.14
    for i in 0..GX + 1 {
      HoloLine "z_{i}"(len: GZ * CW, glow: i == 0 || i == GX ? 2.4 : 0.9) { Position: {(i - GX / 2.0) * CW, y, 0}; Rotation: {0, HALF_PI, 0} }
    }
    for i in 0..GZ + 1 {
      HoloLine "x_{i}"(len: GX * CW, glow: i == 0 || i == GZ ? 2.4 : 0.9) { Position: {0, y, (i - GZ / 2.0) * CW} }
    }
    for i in 0..4 {
      const sx = i % 2 == 0 ? -1 : 1
      const sz = i < 2 ? -1 : 1
      "corner_{i}" : YardHolo { Position: {sx * GX * CW / 2, y + 0.02, sz * GZ * CW / 2}; Cylinder: {radius: 0.22, length: 0.04, segments: 16}; NoShadow; SpatialIgnore }
    }
  }

  template SpineGuide {
    prop l: i32 = 0

    const r = lane_r(l)
    Position: {lane_x(l), AXIS_Y + lane_y(l), 0}
    HoloLine axis(len: SLOTS * SEG + 6, glow: 1.6) { Rotation: {0, HALF_PI, 0} }
    for i in 0..SLOTS + 1 {
      "tick_{i}" : YardHolo {
        Position: {0, 0, (i - SLOTS / 2.0) * SEG}
        Rotation: {HALF_PI, 0, 0}
        Torus: {radius: r * 1.5, tube: 0.03, segments: 32, rings: 3}
        NoShadow
        SpatialIgnore
      }
    }
  }

  template BuildFrame {
    const hx = GX * CW / 2 + 0.6
    const hz = GZ * CW / 2 + 0.6
    const top = GY * CH + 0.6
    for i in 0..4 {
      const sx = i % 2 == 0 ? -1 : 1
      const sz = i < 2 ? -1 : 1
      HoloLine "post_{i}"(len: top + 2.2, glow: 0.6) { Position: {sx * hx, top / 2 - 1.1, sz * hz}; Rotation: {0, 0, HALF_PI} }
      HoloLine "cap_x_{i}"(len: 2.4, glow: 2) { Position: {sx * (hx - 1.2), top, sz * hz} }
      HoloLine "cap_z_{i}"(len: 2.4, glow: 2) { Position: {sx * hx, top, sz * (hz - 1.2)}; Rotation: {0, HALF_PI, 0} }
    }
  }

  template Slipway {
    const w = GX * CW + 8
    const l = GZ * CW + 8
    slab : YardDeck { Position: {0, -3.2, 0}; Box: {w, 0.6, l} }
    rim_a : YardGirder { Position: {0 - w / 2, -2.84, 0}; Box: {0.5, 0.18, l + 0.4} }
    rim_b : YardGirder { Position: {w / 2, -2.84, 0}; Box: {0.5, 0.18, l + 0.4} }
    rim_c : YardGirder { Position: {0, -2.84, 0 - l / 2}; Box: {w + 0.4, 0.18, 0.5} }
    rim_d : YardGirder { Position: {0, -2.84, l / 2}; Box: {w + 0.4, 0.18, 0.5} }
    for s in 0..2 {
      const sx = s == 0 ? -1 : 1
      "edge_light_{s}" : ShipCyanLight { Position: {sx * (w / 2 + 0.1), -2.9, 0}; Box: {0.06, 0.08, l - 0.4} }
      for r in 0..2 {
        "rail_{s}_{r}" : ShipHullDark { Position: {sx * (r == 0 ? 6 : 14), -2.85, 0}; Box: {0.5, 0.2, l - 9} }
      }
    }
    for i in 0..GZ {
      "cradle_{i}" {
        Position: {0, -2.9, (i - GZ / 2.0 + 0.5) * CW}
        beam : YardGirder { Position: {0, 0.2, 0}; Box: {GX * CW - 10, 0.4, 0.5} }
        for s in 0..4 {
          "pad_{s}" : ShipHazard { Position: {(s - 1.5) * 8, 0.42, 0}; Box: {1.6, 0.06, 0.6} }
        }
      }
    }
    for i in 0..2 {
      "end_light_{i}" : ShipAmberLight { Position: {0, -2.9, i == 0 ? -0.1 - l / 2 : l / 2 + 0.1}; Box: {w - 1, 0.08, 0.06} }
    }
  }

  template YardRailing {
    prop len: f32 = 10
    prop n: i32 = 12

    for r in 0..2 {
      "rail_{r}" : ShipSteel { Position: {0, r == 0 ? 0.11 : 0.06, 0}; Box: {0.016, 0.016, len} }
    }
    for i in 0..n + 1 {
      "post_{i}" : ShipSteel { Position: {0, 0.055, (i - n / 2.0) * len / n}; Box: {0.014, 0.11, 0.014} }
    }
  }

  template MiniTug {
    prop seed: i32 = 0

    hull { Scale: {0.1, 0.1, 0.1}; MiniShuttle body(paint: seed % 2) }
    plume : ShipPlasma { Position: {0, 0.15, -0.34}; Sphere: {radius: 0.07, segments: 3, smooth: true}; NoShadow }
    beacon : ShipBeaconRed { Position: {0, 0.33, -0.1}; Sphere: {radius: 0.03, segments: 3, smooth: true} }
    glow { Position: {0, 0.15, -0.6}; PointLight: {intensity: 1.5, range: 2}; Rgb: {120, 180, 255} }
  }

  // Habitation or control block of many floors on the outer keel of a drydock wing, base at the
  // origin. The window shell wraps the four sides, floor bands and lit corners mark its height.
  template DockBlock {
    prop w: f32 = 3.6
    prop d: f32 = 10
    prop h: f32 = 10

    core : DockHullDark { Position: {0, h / 2, 0}; Box: {w, h, d}; NoShadow }
    windows : DockWindows { Position: {0, h / 2 - 0.2, 0}; Box: {w + 0.04, h - 1.6, d + 0.04}; NoShadow }
    base : DockHull { Position: {0, 0.3, 0}; Box: {w + 0.3, 0.6, d + 0.3} }
    roof : DockHull { Position: {0, h - 0.3, 0}; Box: {w + 0.3, 0.6, d + 0.3}; NoShadow }
    for b in 0..10 {
      const by = 0.6 + (b + 1) * 2.4
      if by < h - 1.6 {
        "band_{b}" : DockHull { Position: {0, by, 0}; Box: {w + 0.1, 0.24, d + 0.1}; NoShadow }
      }
    }
    for c in 0..4 {
      const cx = c % 2 == 0 ? -1 : 1
      const cz = c < 2 ? -1 : 1
      "corner_{c}" : DockRunLights { Position: {cx * (w / 2 + 0.05), h / 2, cz * (d / 2 + 0.05)}; Box: {0.08, h - 1.4, 0.08}; NoShadow }
    }
    for s in 0..2 {
      const sx = s == 0 ? -1 : 1
      for k in 0..3 {
        "airlock_{s}_{k}" : DockHullDark { Position: {sx * (w / 2 + 0.035), 0.75, (k - 1) * d * 0.3}; Box: {0.03, 0.3, 0.2} }
        "airlock_lamp_{s}_{k}" : ShipAmberLight { Position: {sx * (w / 2 + 0.035), 0.95, (k - 1) * d * 0.3}; Box: {0.03, 0.03, 0.14} }
      }
      YardRailing "roof_rail_x_{s}"(len: d + 0.2, n: 14) { Position: {sx * (w / 2 + 0.1), h, 0} }
      YardRailing "roof_rail_z_{s}"(len: w + 0.2, n: 5) { Position: {0, h, sx * (d / 2 + 0.1)}; Rotation: {0, HALF_PI, 0} }
    }
    plant : DockHull { Position: {0, h + 0.4, d * 0.2}; Box: {w * 0.6, 0.8, d * 0.35} }
    for v in 0..3 {
      "vent_{v}" : ShipHeatFin { Position: {0, h + 0.3, 0 - d * 0.1 - v * 0.6}; Box: {w * 0.5, 0.6, 0.06} }
    }
    mast : ShipSteel { Position: {w * 0.25, h + 2, 0 - d * 0.38}; Cylinder: {radius: 0.07, length: 4, segments: 6} }
    mast_yard : ShipSteel { Position: {w * 0.25, h + 3.2, 0 - d * 0.38}; Box: {0.05, 0.05, 1.6} }
    mast_top : ShipBeaconRed { Position: {w * 0.25, h + 4.05, 0 - d * 0.38}; Sphere: {radius: 0.12, segments: 3, smooth: true} }
    dish_post : ShipTrim { Position: {0 - w * 0.2, h + 0.3, 0 - d * 0.3}; Cylinder: {radius: 0.12, length: 0.6, segments: 8} }
    dish {
      Position: {0 - w * 0.2, h + 0.9, 0 - d * 0.3}
      Rotation: {-0.6, 0.8, 0}
      bowl : ShipWhite { Rotation: {HALF_PI, 0, 0}; Cone: {radius: 0.9, length: 0.35, segments: 20, smooth: true} }
      feed : ShipSteel { Position: {0, 0, 0.45}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.03, length: 0.9, segments: 6} }
    }
  }

  // Manipulator arm of about 20 units on the outer keel, reaching toward the ship along -x and
  // stopping well outside the clear envelope
  template DockManipulator {
    const sy = 2.2
    const ex = -6
    const ey = 8.5
    const wx = -12.6
    const wy = 2.8
    const ua = atan2(ey - sy, ex)
    const ul = sqrt(ex * ex + (ey - sy) * (ey - sy))
    const fa = atan2(wy - ey, wx - ex)
    const fl = sqrt((wx - ex) * (wx - ex) + (wy - ey) * (wy - ey))

    base : DockHullDark { Position: {0, 0.5, 0}; Cylinder: {radius: 1.8, length: 1, segments: 24, smooth: true} }
    base_band : ShipHazard { Position: {0, 0.85, 0}; Cylinder: {radius: 1.82, length: 0.3, segments: 24, smooth: true} }
    turret : DockHull { Position: {0, 1.5, 0}; Box: {2.4, 1.4, 2.6} }
    shoulder : ShipTrim { Position: {0, sy, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.9, length: 2.2, segments: 20, smooth: true} }
    upper {
      Position: {ex / 2, (sy + ey) / 2, 0}
      Rotation: {0, 0, ua}
      beam : DockHull { Box: {ul, 1.2, 1.2} }
      band : ShipHazard { Position: {ul * 0.38, 0, 0}; Box: {0.8, 1.22, 1.22} }
      lights : DockRunLights { Position: {0, 0.62, 0}; Box: {ul - 1.6, 0.04, 0.16} }
      for s in 0..2 {
        "ram_{s}" : ShipSteel { Position: {0, -0.75, (s - 0.5) * 0.7}; Box: {ul * 0.7, 0.2, 0.2} }
      }
    }
    elbow : ShipTrim { Position: {ex, ey, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.75, length: 1.8, segments: 20, smooth: true} }
    elbow_beacon : ShipBeaconRed { Position: {ex, ey + 0.85, 0}; Sphere: {radius: 0.14, segments: 3, smooth: true} }
    fore {
      Position: {(ex + wx) / 2, (ey + wy) / 2, 0}
      Rotation: {0, 0, fa}
      beam : DockHullDark { Box: {fl, 0.9, 0.9} }
      lights : DockRunLightsCyan { Position: {0, 0.47, 0}; Box: {fl - 1.4, 0.04, 0.14} }
      cable : DockPipe { Position: {0, -0.55, 0.3}; Box: {fl - 0.6, 0.14, 0.14} }
    }
    wrist : ShipTrim { Position: {wx, wy, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.55, length: 1.2, segments: 16, smooth: true} }
    hand {
      Position: {wx, wy, 0}
      Rotation: {0, 0, fa}
      palm : DockHull { Position: {0.9, 0, 0}; Box: {1, 0.8, 1} }
      for s in 0..2 {
        "finger_{s}" : ShipSteel { Position: {1.9, (s - 0.5) * 0.6, 0}; Box: {1.1, 0.18, 0.3} }
      }
      lamp : ShipWhiteLight { Position: {1.41, 0, 0}; Box: {0.02, 0.3, 0.5} }
    }
  }

  // Docking and umbilical arm on the inner ledge, its collar facing the ship along -x
  template DockUmbilical {
    const hx = -4.6
    const hy = 7
    const ba = atan2(hy - 1, hx)
    const bl = sqrt(hx * hx + (hy - 1) * (hy - 1))

    pedestal : DockHullDark { Position: {0, 0.5, 0}; Box: {1.8, 1, 1.8} }
    pivot : ShipTrim { Position: {0, 1, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.55, length: 1.4, segments: 16, smooth: true} }
    boom {
      Position: {hx / 2, (hy + 1) / 2, 0}
      Rotation: {0, 0, ba}
      beam : DockHull { Box: {bl, 0.8, 0.9} }
      hose_a : DockPipe { Position: {0, -0.52, 0.28}; Box: {bl - 0.4, 0.22, 0.22} }
      hose_b : ShipTeal { Position: {0, -0.5, -0.28}; Box: {bl - 0.4, 0.16, 0.16} }
      lights : DockRunLightsCyan { Position: {0, 0.42, 0}; Box: {bl - 0.8, 0.04, 0.14} }
    }
    head : DockHullDark { Position: {hx, hy, 0}; Box: {1.2, 1.6, 1.6} }
    head_band : ShipHazard { Position: {hx, hy - 0.55, 0}; Box: {1.22, 0.25, 1.62} }
    collar : ShipTrim { Position: {hx - 0.75, hy, 0}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: 0.6, length: 0.3, segments: 20, smooth: true} }
    collar_ring : ShipAmberLight { Position: {hx - 0.92, hy, 0}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: 0.62, length: 0.04, segments: 20, smooth: true} }
    seal : ShipRecess { Position: {hx - 0.95, hy, 0}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: 0.42, length: 0.04, segments: 20, smooth: true} }
    beacon : ShipBeaconWhite { Position: {hx, hy + 0.95, 0}; Sphere: {radius: 0.14, segments: 3, smooth: true} }
  }

  // Floodlight pylon of about 50 m on the inner ledge, its lamp bank tilted up toward the ship
  template DockFlood {
    prop lit: bool = false

    foot : DockHullDark { Position: {0, 0.2, 0}; Box: {1, 0.4, 1} }
    mast : DockHullDark { Position: {0, 2.2, 0}; Box: {0.4, 4, 0.4} }
    head {
      Position: {-0.2, 4.4, 0}
      Rotation: {0, 0, -0.35}
      housing : ShipTrim { Position: {0.15, 0, 0}; Box: {0.4, 1.0, 2.2} }
      for r in 0..2 {
        "lamp_{r}" : ShipWhiteLight { Position: {-0.06, (r - 0.5) * 0.46, 0}; Box: {0.04, 0.36, 2.0} }
      }
      if lit {
        beam {
          Rotation: {0, 0 - HALF_PI, 0}
          SpotLight: {intensity: 1200, range: 60, inner_angle: 16, outer_angle: 28}
          Rgb: {235, 240, 255}
        }
      }
    }
    beacon : ShipBeaconRed { Position: {0, 5.05, 0}; Sphere: {radius: 0.1, segments: 3, smooth: true} }
  }

  // One side structure of the liner drydock, built for the starboard side (x > 0) and turned by
  // PI for port. Nothing reaches inside |x| < 24 or past |z| = 46, so the liner and its shield
  // bubble stay clear. The structure rises away from the ship, so from the default camera the
  // near wing stays below the lower half of the hab rings.
  template DockWing {
    prop side: i32 = 1
    prop high: f32 = 13

    const len = 88
    const bay = 11
    const rib_a = atan2(11.0, 8.0)
    const rib_l = sqrt(185.0)
    const gx = 40 - 0.6 * sin(rib_a)
    const gy = -4.5 + 0.6 * cos(rib_a)

    keel_low : DockHullDark { Position: {36, -10, 0}; Box: {5, 4, len} }
    keel_high : DockHullDark { Position: {44, 1, 0}; Box: {4, 4, len} }
    keel_inner : DockHullDark { Position: {28.5, -9, 0}; Box: {3, 2, len - 6} }
    keel_foot : DockHullDark { Position: {45.6, -12.6, 0}; Box: {2.4, 2.4, len} }
    stringer : DockHull { Position: {45.8, -6, 0}; Box: {1.4, 1.4, len} }
    spine_windows : DockWindows { Position: {44, 0.7, 0}; Box: {4.04, 2.2, len - 4} }

    for k in 0..9 {
      "station_{k}" {
        Position: {0, 0, (k - 4) * bay}
        rib : DockHull { Position: {40, -4.5, 0}; Rotation: {0, 0, rib_a}; Box: {rib_l + 2, 3, 2} }
        post : DockHull { Position: {45.6, -6, 0}; Box: {2.6, 13, 2.4} }
        chord : DockHull { Position: {40.5, -12.6, 0}; Box: {11, 2.2, 2} }
        node_low : DockHullDark { Position: {36, -10, 0}; Box: {6, 5, 3} }
        node_high : DockHullDark { Position: {44.2, 1, 0}; Box: {5, 5, 3} }
        lamp : ShipAmberLight { Position: {46.72, 2.6, 0}; Box: {0.04, 0.3, 1.6} }
        if k > 0 && k < 8 {
          beam : DockHullDark { Position: {31.5, -9.3, 0}; Box: {9, 1.6, 1.4} }
        } else {
          band_low : ShipHazard { Position: {36, -8.1, 0}; Box: {6.04, 0.6, 3.04} }
          band_high : ShipHazard { Position: {44.2, 2.9, 0}; Box: {5.04, 0.6, 3.04} }
          if side == 0 {
            beacon : ShipBeaconRed { Position: {46, 3.8, 0}; Sphere: {radius: 0.3, segments: 3, smooth: true} }
          } else {
            beacon : ShipBeaconGreen { Position: {46, 3.8, 0}; Sphere: {radius: 0.3, segments: 3, smooth: true} }
          }
        }
      }
    }

    for b in 0..8 {
      const bz = (b - 3.5) * bay
      for d in 0..2 {
        "brace_{b}_{d}" : DockHullDark { Position: {45.6, -6, bz}; Rotation: {d == 0 ? 0.907 : -0.907, 0, 0}; Box: {0.9, 0.9, 14} }
      }
      if b == 1 || b == 2 || b == 5 || b == 6 {
        "radiator_root_{b}" : DockHullDark { Position: {41, -13.9, bz}; Box: {1.2, 0.8, 9.4} }
        "radiator_{b}" : ShipRadiatorPanel { Position: {41, -17.4, bz}; Box: {0.25, 6.8, 9}; NoShadow }
      }
    }

    glacis {
      Position: {gx, gy, 0}
      Rotation: {0, 0, rib_a}
      plate : DockHull { Box: {rib_l - 1, 0.4, len - 2} }
      gallery_a : DockWindows { Position: {2.6, 0.22, 0}; Box: {1.4, 0.04, len - 6} }
      gallery_b : DockWindows { Position: {-1.8, 0.22, 0}; Box: {0.9, 0.04, len - 6} }
      lights_top : DockRunLights { Position: {5.4, 0.22, 0}; Box: {0.14, 0.05, len - 4} }
      lights_low : DockRunLightsCyan { Position: {-5.4, 0.22, 0}; Box: {0.14, 0.05, len - 4} }
      for b in 0..8 {
        const bz = (b - 3.5) * bay
        "seam_{b}" : ShipRecess { Position: {0.4, 0.21, bz}; Box: {rib_l - 1.4, 0.03, 0.12} }
        for h in 0..2 {
          "hatch_{b}_{h}" : DockGrime { Position: {-3.7, 0.23, bz + (h - 0.5) * 4}; Box: {1, 0.06, 1} }
          "hatch_lamp_{b}_{h}" : ShipAmberLight { Position: {-3.05, 0.24, bz + (h - 0.5) * 4}; Box: {0.08, 0.06, 0.5} }
        }
      }
    }

    ledge : YardDeckFine { Position: {29.75, -7.9, 0}; Box: {7.5, 0.2, len - 6} }
    ledge_lip : DockHullDark { Position: {26.15, -8.1, 0}; Box: {0.3, 0.6, len - 6} }
    ledge_lights : DockRunLights { Position: {25.98, -8.15, 0}; Box: {0.04, 0.14, len - 7} }
    YardRailing ledge_rail(len: len - 6, n: 82) { Position: {26.1, -7.8, 0} }
    tray : DockGrime { Position: {28.5, -10.15, 0}; Box: {1.6, 0.3, len - 8} }
    for p in 0..3 {
      "pipe_{p}" : DockPipe { Position: {33.1, -9.6 - p * 0.75, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: p == 0 ? 0.36 : 0.24, length: len - 2, segments: 12, smooth: true} }
    }
    keel_lights : DockRunLightsCyan { Position: {33.48, -11.75, 0}; Box: {0.04, 0.14, len - 2} }

    walk : YardDeckFine { Position: {42.6, 3.04, 0}; Box: {1.2, 0.08, len} }
    YardRailing walk_rail(len: len, n: 88) { Position: {42.05, 3.08, 0} }
    walk_lights : DockRunLights { Position: {41.97, 2.5, 0}; Box: {0.04, 0.14, len - 2} }
    outer_lights : DockRunLightsCyan { Position: {46.02, -0.75, 0}; Box: {0.04, 0.14, len - 2} }
    for g in 0..22 {
      const gh = seg_hash(side + 3, g, 4)
      if gh > 0 {
        "kit_{g}" : DockHull { Position: {44.6, 3 + gh * 0.25, (g - 10.5) * 4}; Box: {1.6 + gh * 0.3, gh * 0.5, 1.2 + gh * 0.4} }
      }
    }

    DockBlock block_a(w: 3.6, d: 12, h: high - 3) { Position: {44.9, 3, -33} }
    DockBlock tower(w: 3.4, d: 6, h: high - 1) { Position: {44.9, 3, 5.5} }
    DockBlock block_c(w: 3.6, d: 8, h: (high - 3) * 0.6) { Position: {44.9, 3, 19} }

    DockManipulator arm_a() { Position: {43.4, 3, -16.5} }
    DockManipulator arm_b() { Position: {43.4, 3, 33} }
    for u in 0..3 {
      DockUmbilical "umbilical_{u}"() { Position: {30.6, -7.8, (u * 2 - 2.5) * bay} }
    }
    for k in 1..8 {
      DockFlood "flood_{k}"(lit: k % 2 == 0) { Position: {27.2, -7.8, (k - 4) * bay} }
    }
    for c in 0..6 {
      "container_{c}" : ShipContainers { Position: {31.6 + (c % 3) * 0.27, -7.67, (c < 3 ? -18 : -16.76)}; Box: {0.24, 0.26, 1.2}; Rgb: cargo_tint(side * 5 + c) }
    }

    hangar {
      Position: {36.5, -4.5, 38.5}
      body : DockHull { Box: {9, 7, 9} }
      roof_kit : DockHullDark { Position: {1.5, 3.9, 0}; Box: {4, 0.8, 6} }
      mouth : ShipRecess { Position: {-4.52, -0.9, 0}; Box: {0.06, 4.6, 7} }
      bay_floor : ShipLounge { Position: {-4.5, -3.15, 0}; Box: {0.08, 0.12, 6.8} }
      bay_lights : ShipWhiteLight { Position: {-4.54, 1.25, 0}; Box: {0.04, 0.08, 6.6} }
      door : DockHullDark { Position: {-4.62, 1.9, 0}; Box: {0.14, 1.4, 7.4} }
      door_band : ShipHazard { Position: {-4.7, 1.3, 0}; Box: {0.02, 0.24, 7.4} }
      gallery : DockWindows { Position: {-4.52, 3.0, 0}; Box: {0.04, 0.6, 8} }
      for s in 0..2 {
        const sz = s == 0 ? -1 : 1
        "jamb_{s}" : DockHullDark { Position: {-4.6, -0.9, sz * 3.7}; Box: {0.3, 4.8, 0.4} }
        "airlock_{s}" : DockHullDark { Position: {-4.52, -3.15, sz * 4.1}; Box: {0.03, 0.3, 0.2} }
        "airlock_lamp_{s}" : ShipAmberLight { Position: {-4.52, -2.95, sz * 4.1}; Box: {0.03, 0.03, 0.14} }
        "corner_beacon_{s}" : ShipBeaconWhite { Position: {-4.3, 3.65, sz * 4.3}; Sphere: {radius: 0.15, segments: 3, smooth: true} }
      }
    }

    MiniTug tug_dock(seed: side) { Position: {29.4, -7.8, 38.5}; Rotation: {0, HALF_PI, 0} }
    MiniTug tug_hover(seed: side + 1) { Position: {29.6, -4.6, 30.5}; Rotation: {0, -0.8, 0} }
    MiniTug tug_high(seed: side) { Position: {34, 6.5, -24}; Rotation: {0, 2.4, 0} }
  }

  // The liner drydock: two side structures that leave the liner and its shield bubble clear.
  // The port wing stands behind the ship from the default camera and may rise higher.
  template Drydock {
    DockWing port(side: 0, high: 22) { Rotation: {0, PI, 0} }
    DockWing starboard(side: 1, high: 13)
  }

  template YardPlanet {
    surface {
      Position: {0, 0, 0}
      Rotation: {0, 0, 0.3}
      AngularVelocity: {0, 0.004, 0}
      Sphere: {radius: 420, segments: 64, smooth: true}
      Rgb: {255, 255, 255}
      PbrMaterial: {roughness: 0.75}
      Emissive: {strength: 0.8, color: {255, 214, 160}}
      PbrTextures: {albedo: yard_planet_tex, emissive: yard_planet_night_tex}
      NoShadow
      SpatialIgnore
    }
    clouds {
      Position: {0, 0, 0}
      Rotation: {0, 0, 0.3}
      AngularVelocity: {0, 0.006, 0}
      Sphere: {radius: 424, segments: 64, smooth: true}
      Rgb: {255, 255, 255}
      PbrMaterial: {roughness: 0.9}
      BlendMode: AlphaBlend
      PbrTextures: {albedo: yard_cloud_tex}
      NoShadow
      SpatialIgnore
    }
  }
}

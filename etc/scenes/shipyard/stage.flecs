using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.texture
using box.light
using box.movement
using box.spatial
using box.transition
using state

assets {
  yard_planet_tex { TexturePath: {path: "etc/scenes/shipyard/assets/planet.jpg"} }
  yard_planet_night_tex { TexturePath: {path: "etc/scenes/shipyard/assets/planet_night.jpg"} }
  yard_cloud_tex { TexturePath: {path: "etc/scenes/shipyard/assets/clouds.png"} }
  yard_halo_tex { TexturePath: {path: "etc/scenes/shipyard/assets/halo.png"} }

  template HoloLine {
    prop len: f32 = 1
    prop glow: f32 = 1.2

    Box: {len, 0.03, 0.03}
    Rgb: {70, 200, 255}
    Emissive: {strength: glow, color: {60, 190, 255}}
    NoShadow
    SpatialIgnore
  }

  template DeckGrid {
    prop level: i32 = 0

    const y = level * CH + 0.14
    for i in 0..GX + 1 {
      HoloLine "z_{i}"(len: GZ * CW, glow: i == 0 || i == GX ? 2.4 : 0.9) { Position: {(i - GX / 2.0) * CW, y, 0}; Rotation: {0, HALF_PI, 0} }
    }
    for i in 0..GZ + 1 {
      HoloLine "x_{i}"(len: GX * CW, glow: i == 0 || i == GZ ? 2.4 : 0.9) { Position: {0, y, (i - GZ / 2.0) * CW} }
    }
    for i in 0..4 {
      const sx = i % 2 == 0 ? -1 : 1
      const sz = i < 2 ? -1 : 1
      "corner_{i}" : YardHolo { Position: {sx * GX * CW / 2, y + 0.02, sz * GZ * CW / 2}; Cylinder: {radius: 0.22, length: 0.04, segments: 16}; NoShadow; SpatialIgnore }
    }
  }

  template SpineGuide {
    prop l: i32 = 0

    const r = lane_r(l)
    Position: {lane_x(l), AXIS_Y + lane_y(l), 0}
    HoloLine axis(len: SLOTS * SEG + 6, glow: 1.6) { Rotation: {0, HALF_PI, 0} }
    for i in 0..SLOTS + 1 {
      "tick_{i}" : YardHolo {
        Position: {0, 0, (i - SLOTS / 2.0) * SEG}
        Rotation: {HALF_PI, 0, 0}
        Torus: {radius: r * 1.5, tube: 0.03, segments: 32, rings: 3}
        NoShadow
        SpatialIgnore
      }
    }
  }

  template BuildFrame {
    const hx = GX * CW / 2 + 0.6
    const hz = GZ * CW / 2 + 0.6
    const top = GY * CH + 0.6
    for i in 0..4 {
      const sx = i % 2 == 0 ? -1 : 1
      const sz = i < 2 ? -1 : 1
      HoloLine "post_{i}"(len: top + 2.2, glow: 0.6) { Position: {sx * hx, top / 2 - 1.1, sz * hz}; Rotation: {0, 0, HALF_PI} }
      HoloLine "cap_x_{i}"(len: 2.4, glow: 2) { Position: {sx * (hx - 1.2), top, sz * hz} }
      HoloLine "cap_z_{i}"(len: 2.4, glow: 2) { Position: {sx * hx, top, sz * (hz - 1.2)}; Rotation: {0, HALF_PI, 0} }
    }
  }

  template Slipway {
    const w = GX * CW + 8
    const l = GZ * CW + 8
    slab : YardDeck { Position: {0, -3.2, 0}; Box: {w, 0.6, l} }
    rim_a : YardGirder { Position: {0 - w / 2, -2.84, 0}; Box: {0.5, 0.18, l + 0.4} }
    rim_b : YardGirder { Position: {w / 2, -2.84, 0}; Box: {0.5, 0.18, l + 0.4} }
    rim_c : YardGirder { Position: {0, -2.84, 0 - l / 2}; Box: {w + 0.4, 0.18, 0.5} }
    rim_d : YardGirder { Position: {0, -2.84, l / 2}; Box: {w + 0.4, 0.18, 0.5} }
    for s in 0..2 {
      const sx = s == 0 ? -1 : 1
      "edge_light_{s}" : ShipCyanLight { Position: {sx * (w / 2 + 0.1), -2.9, 0}; Box: {0.06, 0.08, l - 0.4} }
      for r in 0..2 {
        "rail_{s}_{r}" : ShipHullDark { Position: {sx * (r == 0 ? 6 : 14), -2.85, 0}; Box: {0.5, 0.2, l - 9} }
      }
    }
    for i in 0..GZ {
      "cradle_{i}" {
        Position: {0, -2.9, (i - GZ / 2.0 + 0.5) * CW}
        beam : YardGirder { Position: {0, 0.2, 0}; Box: {GX * CW - 10, 0.4, 0.5} }
        for s in 0..4 {
          "pad_{s}" : ShipHazard { Position: {(s - 1.5) * 8, 0.42, 0}; Box: {1.6, 0.06, 0.6} }
        }
      }
    }
    for i in 0..2 {
      "end_light_{i}" : ShipAmberLight { Position: {0, -2.9, i == 0 ? -0.1 - l / 2 : l / 2 + 0.1}; Box: {w - 1, 0.08, 0.06} }
    }
  }

  template YardTruss {
    prop len: f32 = 88
    prop w: f32 = 3
    prop h: f32 = 4
    prop bays: i32 = 22

    const bl = len / bays
    const tilt = atan2(h, bl)
    const diag = sqrt(h * h + bl * bl)
    const sweep = atan2(w, bl)
    const span = sqrt(w * w + bl * bl)
    for c in 0..4 {
      "chord_{c}" : YardGirder { Position: {c % 2 == 0 ? 0 : w, c < 2 ? 0 - h / 2 : h / 2, 0}; Box: {0.35, 0.35, len} }
    }
    for f in 0..bays + 1 {
      const fz = (f - bays / 2.0) * bl
      for s in 0..2 {
        "post_{f}_{s}" : YardGirder { Position: {s * w, 0, fz}; Box: {0.22, h, 0.22} }
      }
      "tie_top_{f}" : YardGirder { Position: {w / 2, h / 2, fz}; Box: {w, 0.2, 0.2} }
      "tie_bot_{f}" : YardGirder { Position: {w / 2, 0 - h / 2, fz}; Box: {w, 0.2, 0.2} }
    }
    for b in 0..bays {
      const bz = (b - bays / 2.0 + 0.5) * bl
      for s in 0..2 {
        "web_{b}_{s}" : YardGirder { Position: {s * w, 0, bz}; Rotation: {b % 2 == 0 ? 0 - tilt : tilt, 0, 0}; Box: {0.12, 0.12, diag - 0.2} }
      }
      "brace_{b}" : YardGirder { Position: {w / 2, 0 - h / 2, bz}; Rotation: {0, b % 2 == 0 ? sweep : 0 - sweep, 0}; Box: {0.1, 0.1, span - 0.2} }
    }
  }

  template YardSpan {
    prop len: f32 = 36
    prop d: f32 = 1.6
    prop n: i32 = 12

    const pl = len / n
    const da = atan2(d, pl)
    const dl = sqrt(d * d + pl * pl)
    for c in 0..2 {
      "chord_{c}" : YardGirder { Position: {0, (c - 0.5) * d, 0}; Box: {len, 0.3, 0.6} }
    }
    for i in 0..n + 1 {
      "post_{i}" : YardGirder { Position: {(i - n / 2.0) * pl, 0, 0}; Box: {0.2, d, 0.4} }
    }
    for i in 0..n {
      "web_{i}" : YardGirder { Position: {(i - n / 2.0 + 0.5) * pl, 0, 0}; Rotation: {0, 0, i % 2 == 0 ? da : 0 - da}; Box: {dl - 0.2, 0.12, 0.25} }
    }
  }

  template YardRailing {
    prop len: f32 = 10
    prop n: i32 = 12

    for r in 0..2 {
      "rail_{r}" : ShipSteel { Position: {0, r == 0 ? 0.11 : 0.06, 0}; Box: {0.016, 0.016, len} }
    }
    for i in 0..n + 1 {
      "post_{i}" : ShipSteel { Position: {0, 0.055, (i - n / 2.0) * len / n}; Box: {0.014, 0.11, 0.014} }
    }
  }

  template YardLamp {
    pole : ShipSteel { Position: {0, 0.35, 0}; Cylinder: {radius: 0.012, length: 0.7, segments: 6} }
    arm : ShipSteel { Position: {-0.08, 0.69, 0}; Box: {0.16, 0.012, 0.012} }
    head : ShipTrim { Position: {-0.16, 0.685, 0}; Box: {0.09, 0.02, 0.045} }
    lens : ShipWhiteLight { Position: {-0.16, 0.672, 0}; Box: {0.07, 0.006, 0.035} }
  }

  template YardStack {
    prop seed: i32 = 0

    for c in 0..5 {
      for r in 0..2 {
        const tiers = 1 + seg_hash(seed, c * 2 + r, 3)
        for t in 0..tiers {
          "box_{c}_{r}_{t}" : ShipContainers { Position: {c * 0.27, 0.13 + t * 0.265, r * 1.24}; Box: {0.24, 0.26, 1.2}; Rgb: cargo_tint(seed + c * 3 + r * 5 + t) }
        }
      }
    }
  }

  template YardCrane {
    prop w: f32 = 3
    prop boom: f32 = 11
    prop luff: f32 = 1.02

    const px = w / 2
    const py = 2.1
    const tx = px - cos(luff) * boom
    const ty = py + sin(luff) * boom
    const mx = px + 0.3
    const my = py + 2
    const pd = sqrt((tx - mx) * (tx - mx) + (ty - my) * (ty - my))
    const bx = px + 2.4
    const by = py + 0.1

    for s in 0..2 {
      const sx = s == 0 ? 0.5 : w - 0.5
      "bogie_{s}" : ShipTrim { Position: {sx, 0.16, 0}; Box: {0.2, 0.12, 2.4} }
      for k in 0..4 {
        "wheel_{s}_{k}" : ShipRubber { Position: {sx, 0.07, (k - 1.5) * 0.55}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: 0.07, length: 0.14, segments: 10, smooth: true} }
      }
      for e in 0..2 {
        "leg_{s}_{e}" : ShipYellow { Position: {sx, 0.98, (e - 0.5) * 1.8}; Box: {0.2, 1.56, 0.2} }
      }
      "cross_{s}" : ShipYellow { Position: {sx, 0.98, 0}; Rotation: {atan2(1.56, 1.8), 0, 0}; Box: {0.07, 0.07, 2.3} }
    }
    deck : ShipYellow { Position: {px, 1.86, 0}; Box: {w - 0.6, 0.2, 2.2} }
    for e in 0..2 {
      "edge_{e}" : ShipHazard { Position: {px, 1.86, (e - 0.5) * 2.206}; Box: {w - 0.6, 0.12, 0.006}; TextureMapping: {MappingFrame, size: 0.3} }
    }
    turntable : ShipTrim { Position: {px, 2.0, 0}; Cylinder: {radius: 0.8, length: 0.1, segments: 20, smooth: true} }
    house : ShipHullFine { Position: {px + 0.5, 2.4, 0}; Box: {1.4, 0.6, 1.0} }
    house_door : ShipHullDark { Position: {px + 0.9, 2.21, 0.503}; Box: {0.12, 0.2, 0.006} }
    for k in 0..4 {
      "house_window_{k}" : ShipWindow { Position: {px + 0.1 + k * 0.2, 2.5, -0.503}; Box: {0.1, 0.05, 0.006} }
    }
    cab : ShipWhite { Position: {px - 0.45, 2.25, 0.62}; Box: {0.3, 0.3, 0.26} }
    cab_glass : ShipCanopy { Position: {px - 0.603, 2.28, 0.62}; Box: {0.006, 0.18, 0.22} }
    for s in 0..2 {
      "mast_{s}" : ShipYellow { Position: {mx, py + 1, (s - 0.5) * 0.6}; Rotation: {(0.5 - s) * 0.28, 0, 0}; Box: {0.1, 2.05, 0.1} }
    }
    mast_cap : ShipBeaconRed { Position: {mx, my + 0.08, 0}; Sphere: {radius: 0.06, segments: 3, smooth: true} }
    counter_jib : YardGirder { Position: {px + 1.6, by, 0}; Box: {2.4, 0.2, 0.6} }
    counterweight : ShipHullDark { Position: {bx, py - 0.3, 0}; Box: {0.7, 0.7, 0.9} }
    weight_band : ShipHazard { Position: {bx, py + 0.02, 0}; Box: {0.71, 0.08, 0.91}; TextureMapping: {MappingFrame, size: 0.3} }
    pendant : ShipSteel { Position: {(tx + mx) / 2, (ty + my) / 2, 0}; Rotation: {0, 0, atan2(ty - my, tx - mx)}; Box: {pd, 0.03, 0.03} }
    back_stay : ShipSteel { Position: {(bx + mx) / 2, (by + my) / 2, 0}; Rotation: {0, 0, atan2(by - my, bx - mx)}; Box: {sqrt((bx - mx) * (bx - mx) + (my - by) * (my - by)), 0.03, 0.03} }
    jib {
      Position: {px, py, 0}
      Rotation: {0, 0, PI - luff}
      for s in 0..2 {
        "chord_{s}" : ShipYellow { Position: {boom / 2, 0, (s - 0.5) * 0.7}; Box: {boom, 0.12, 0.12} }
      }
      spine : ShipYellow { Position: {boom / 2, 0.55, 0}; Box: {boom, 0.12, 0.12} }
      for i in 0..10 {
        "lace_{i}" : ShipYellow { Position: {(i + 0.5) * boom / 10, 0.27, 0}; Box: {0.05, 0.55, 0.7} }
      }
      foot : ShipTrim { Position: {0, 0, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.15, length: 0.7, segments: 10, smooth: true} }
      sheave : ShipTrim { Position: {boom, 0, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.18, length: 0.3, segments: 10, smooth: true} }
      tip : ShipBeaconRed { Position: {boom, 0.3, 0}; Sphere: {radius: 0.06, segments: 3, smooth: true} }
    }
    cable : ShipSteel { Position: {tx, ty - 1, 0}; Box: {0.025, 2, 0.025} }
    block : ShipYellow { Position: {tx, ty - 2.1, 0}; Box: {0.25, 0.3, 0.25} }
    hook : ShipTrim { Position: {tx, ty - 2.35, 0}; Box: {0.08, 0.2, 0.08} }
  }

  template YardControl {
    prop w: f32 = 3

    const cx = w / 2
    hall : ShipHullFine { Position: {cx, 0.45, 0}; Box: {2.2, 0.9, 2.6} }
    for f in 0..3 {
      const fy = 0.17 + f * 0.3
      "floor_{f}" : ShipTrim { Position: {cx, f * 0.3 + 0.3, 0}; Box: {2.22, 0.02, 2.62} }
      for k in 0..10 {
        "window_{f}_{k}" : ShipWindow { Position: {cx - 1.103, fy, (k - 4.5) * 0.24}; Box: {0.006, 0.07, 0.14} }
      }
      for k in 0..8 {
        "window_end_{f}_{k}" : ShipWindow { Position: {cx + (k - 3.5) * 0.24, fy, -1.303}; Box: {0.14, 0.07, 0.006} }
      }
    }
    door : ShipHullDark { Position: {cx - 1.104, 0.11, 1.05}; Box: {0.006, 0.22, 0.18} }
    door_lamp : ShipAmberLight { Position: {cx - 1.106, 0.25, 1.05}; Box: {0.006, 0.02, 0.08} }
    roof : ShipTrim { Position: {cx, 0.92, 0}; Box: {2.28, 0.04, 2.68} }
    for s in 0..2 {
      YardRailing "roof_rail_{s}"(len: 2.6, n: 6) { Position: {cx + (s - 0.5) * 2.22, 0.94, 0} }
    }
    tower : ShipHullFine { Position: {cx + 0.2, 1.12, 0.5}; Box: {1.2, 0.36, 1.2} }
    tower_glass : ShipCanopy { Position: {cx - 0.403, 1.15, 0.5}; Box: {0.006, 0.18, 1.1} }
    tower_glass_end : ShipCanopy { Position: {cx + 0.2, 1.15, 1.103}; Box: {1.1, 0.18, 0.006} }
    tower_roof : ShipTrim { Position: {cx + 0.2, 1.315, 0.5}; Box: {1.26, 0.03, 1.26} }
    for v in 0..2 {
      "vent_{v}" : ShipHeatFin { Position: {cx + 0.3, 1.04, -0.6 - v * 0.25}; Box: {0.6, 0.2, 0.006} }
    }
    mast : ShipSteel { Position: {cx + 0.7, 2.2, 0.9}; Cylinder: {radius: 0.02, length: 1.8, segments: 6} }
    mast_top : ShipBeaconWhite { Position: {cx + 0.7, 3.12, 0.9}; Sphere: {radius: 0.05, segments: 3, smooth: true} }
    dish_post : ShipTrim { Position: {cx - 0.4, 1.09, -0.7}; Cylinder: {radius: 0.03, length: 0.3, segments: 6} }
    dish {
      Position: {cx - 0.4, 1.3, -0.7}
      Rotation: {-0.5, -0.9, 0}
      bowl : ShipWhite { Position: {0, 0, 0}; Rotation: {HALF_PI, 0, 0}; Cone: {radius: 0.32, length: 0.14, segments: 16, smooth: true} }
      feed : ShipSteel { Position: {0, 0, 0.17}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.012, length: 0.35, segments: 6} }
    }
  }

  template YardGantry {
    prop len: f32 = 88

    const w = 3
    const h = 4
    const top = h / 2 + 0.3
    const bays = 22
    const bl = len / bays

    YardTruss truss(len: len, w: w, h: h, bays: bays)
    deck : YardDeckFine { Position: {w / 2, top - 0.06, 0}; Box: {w + 0.6, 0.12, len} }
    for e in 0..2 {
      "edge_{e}" : ShipHazard { Position: {e == 0 ? -0.18 : w + 0.18, top + 0.003, 0}; Box: {0.12, 0.006, len}; TextureMapping: {MappingFrame, size: 0.3} }
      YardRailing "railing_{e}"(len: len, n: 110) { Position: {e == 0 ? -0.27 : w + 0.27, top, 0} }
      "track_{e}" : ShipTrim { Position: {e == 0 ? 0.5 : w - 0.5, top + 0.03, 0}; Box: {0.1, 0.06, len} }
    }
    lights_top : ShipRunLights { Position: {-0.19, h / 2, 0}; Box: {0.02, 0.08, len - 2} }
    lights_low : ShipRunLightsCyan { Position: {-0.19, 0 - h / 2, 0}; Box: {0.02, 0.08, len - 2} }
    for f in 0..bays + 1 {
      const fz = (f - bays / 2.0) * bl
      if f % 3 == 1 {
        "flood_{f}" {
          Position: {-0.32, top - 0.35, fz}
          Rotation: {0, 0, -0.55}
          housing : ShipTrim { Position: {0.06, 0, 0}; Box: {0.16, 0.16, 0.34} }
          lens : ShipWhiteLight { Position: {-0.03, 0, 0}; Box: {0.02, 0.12, 0.28} }
        }
      }
      if f % 2 == 0 && f > 0 && f < bays {
        YardLamp "lamp_{f}"() { Position: {-0.1, top, fz} }
      }
    }
    for e in 0..2 {
      const ez = (e - 0.5) * len
      "cap_{e}" : ShipHullDarkFine { Position: {w / 2, 0, ez}; Box: {w + 0.6, h + 0.6, 0.6} }
      "cap_band_{e}" : ShipHazard { Position: {w / 2, h / 2 - 0.1, ez + (e - 0.5) * 0.61}; Box: {w + 0.6, 0.16, 0.01}; TextureMapping: {MappingFrame, size: 0.3} }
      "beacon_{e}" : ShipBeaconRed { Position: {-0.2, top + 0.2, ez + (0.5 - e) * 0.4}; Sphere: {radius: 0.07, segments: 3, smooth: true} }
    }
    YardCrane crane(w: w) { Position: {0, top, -20} }
    YardControl control(w: w) { Position: {0, top, len / 2 - 3} }
    for t in 0..3 {
      const tz = -11 + (t - 1) * 1.1
      "tank_{t}" : ShipWhite { Position: {w / 2 + 0.4, top + 0.6, tz}; Cylinder: {radius: 0.45, length: 1.2, segments: 20, smooth: true} }
      "tank_band_{t}" : ShipTeal { Position: {w / 2 + 0.4, top + 0.85, tz}; Cylinder: {radius: 0.456, length: 0.1, segments: 20, smooth: true} }
      "tank_cap_{t}" : ShipSteel { Position: {w / 2 + 0.4, top + 1.22, tz}; Cylinder: {radius: 0.3, length: 0.04, segments: 20, smooth: true} }
    }
    manifold : ShipCopper { Position: {w / 2 - 0.2, top + 0.12, -11}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.05, length: 3.4, segments: 8, smooth: true} }
    for k in 0..4 {
      YardStack "stack_{k}"(seed: k * 3 + 1) { Position: {0.35, top, k < 2 ? 9 + k * 3 : 16 + k * 3} }
    }
    shed : ShipHullDarkFine { Position: {w / 2, top + 0.35, -31}; Box: {2.2, 0.7, 3.4} }
    shed_roof : ShipTrim { Position: {w / 2, top + 0.725, -31}; Box: {2.3, 0.05, 3.5} }
    shed_door : ShipHullDark { Position: {w / 2 - 1.103, top + 0.25, -31}; Box: {0.006, 0.5, 1.8} }
    shed_lintel : ShipHazard { Position: {w / 2 - 1.104, top + 0.54, -31}; Box: {0.006, 0.06, 1.9}; TextureMapping: {MappingFrame, size: 0.3} }
    for k in 0..12 {
      "shed_window_{k}" : ShipWindow { Position: {w / 2 + 1.103, top + 0.55, -31 + (k - 5.5) * 0.26}; Box: {0.006, 0.05, 0.12} }
    }
    for v in 0..3 {
      "shed_vent_{v}" : ShipHeatFin { Position: {w / 2 + 0.3, top + 0.85, -32 + v * 0.8}; Box: {0.8, 0.2, 0.006} }
    }
    pipe : ShipTeal { Position: {w * 0.7, 0 - h / 2 + 0.4, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.16, length: len, segments: 10, smooth: true} }
    pipe_b : ShipCopper { Position: {w * 0.7 + 0.4, 0 - h / 2 + 0.35, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.09, length: len, segments: 8, smooth: true} }
  }

  template YardGoliath {
    prop span: f32 = 41
    prop high: f32 = 18

    const gx = span / 2
    const lean = atan2(1.5, high - 0.5)
    const leg = sqrt((high - 0.5) * (high - 0.5) + 2.25)
    for s in 0..2 {
      const sx = s == 0 ? -1 : 1
      "sill_{s}" : ShipYellow { Position: {sx * gx, 0.45, 0}; Box: {0.6, 0.3, 5.6} }
      for k in 0..8 {
        "wheel_{s}_{k}" : ShipRubber { Position: {sx * gx, 0.12, (k - 3.5) * 0.7}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: 0.12, length: 0.2, segments: 10, smooth: true} }
      }
      "bogie_{s}" : ShipTrim { Position: {sx * gx, 0.24, 0}; Box: {0.3, 0.14, 5.4} }
      for e in 0..2 {
        const ez = (e - 0.5) * 2
        "leg_{s}_{e}" : ShipYellow { Position: {sx * gx, (high + 0.6) / 2, ez * 1.65}; Rotation: {0 - ez * lean, 0, 0}; Box: {0.5, leg, 0.5} }
      }
      for k in 0..3 {
        const ky = (k + 1) * high / 4
        "tie_{s}_{k}" : ShipYellow { Position: {sx * gx, ky, 0}; Box: {0.2, 0.2, 2 * (2.4 - 1.5 * ky / high)} }
      }
      "head_{s}" : ShipYellow { Position: {sx * gx, high + 0.7, 0}; Box: {1.2, 1.6, 2.6} }
      "head_band_{s}" : ShipHazard { Position: {sx * gx, high - 0.02, 0}; Box: {1.21, 0.16, 2.61}; TextureMapping: {MappingFrame, size: 0.3} }
      "beacon_{s}" : ShipBeaconRed { Position: {sx * gx, high + 1.62, 0}; Sphere: {radius: 0.08, segments: 3, smooth: true} }
      "lift_{s}" : ShipHullFine { Position: {sx * (gx + 0.55), high / 2, 0}; Box: {0.3, high, 0.3} }
      "lift_lights_{s}" : ShipRunLights { Position: {sx * (gx + 0.71), high / 2, 0}; Box: {0.01, high - 0.4, 0.04} }
    }
    for g in 0..2 {
      "girder_{g}" : ShipYellow { Position: {0, high + 0.7, (g - 0.5) * 1.5}; Box: {span, 1.4, 0.5} }
    }
    walkway : YardDeckFine { Position: {0, high + 1.43, 0}; Box: {span, 0.06, 2.0} }
    for s in 0..2 {
      YardRailing "railing_{s}"(len: span, n: 52) { Position: {0, high + 1.46, (s - 0.5) * 1.96}; Rotation: {0, HALF_PI, 0} }
    }
    trolley {
      Position: {-5, high + 1.46, 0}
      frame : ShipHullDark { Position: {0, 0.3, 0}; Box: {2.2, 0.6, 1.9} }
      drum : ShipTrim { Position: {0.3, 0.7, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.25, length: 1.4, segments: 14, smooth: true} }
      cab : ShipWhite { Position: {-0.9, 0.78, 0.6}; Box: {0.34, 0.36, 0.4} }
      cab_glass : ShipCanopy { Position: {-1.073, 0.8, 0.6}; Box: {0.006, 0.2, 0.34} }
      beacon : ShipBeaconWhite { Position: {0.9, 0.66, -0.7}; Sphere: {radius: 0.06, segments: 3, smooth: true} }
    }
    for c in 0..4 {
      "fall_{c}" : ShipSteel { Position: {-5 + (c % 2 - 0.5) * 0.8, high, (c < 2 ? -0.3 : 0.3)}; Box: {0.03, 3, 0.03} }
    }
    spreader : ShipYellow { Position: {-5, high - 1.55, 0}; Box: {1.6, 0.18, 0.8} }
    spreader_lamp : ShipAmberLight { Position: {-5, high - 1.65, 0}; Box: {1.2, 0.02, 0.4} }
  }

  template YardMast {
    prop high: f32 = 6
    prop levels: i32 = 7

    const hw = 0.45
    const lv = high / levels
    const dx = atan2(lv, 2 * hw)
    const dl = sqrt(lv * lv + 4 * hw * hw)
    for p in 0..4 {
      "post_{p}" : YardGirder { Position: {p % 2 == 0 ? 0 - hw : hw, high / 2, p < 2 ? 0 - hw : hw}; Box: {0.1, high, 0.1} }
    }
    for i in 0..levels {
      const iy = (i + 1) * lv
      const my = (i + 0.5) * lv
      const sg = i % 2 == 0 ? 1 : -1
      for s in 0..2 {
        const so = s == 0 ? 0 - hw : hw
        "tie_x_{i}_{s}" : ShipYellow { Position: {0, iy, so}; Box: {2 * hw, 0.05, 0.05} }
        "tie_z_{i}_{s}" : ShipYellow { Position: {so, iy, 0}; Box: {0.05, 0.05, 2 * hw} }
        "diag_x_{i}_{s}" : YardGirder { Position: {0, my, so}; Rotation: {0, 0, sg * dx}; Box: {dl, 0.04, 0.04} }
        "diag_z_{i}_{s}" : YardGirder { Position: {so, my, 0}; Rotation: {sg * dx, 0, 0}; Box: {0.04, 0.04, dl} }
      }
    }
    for s in 0..2 {
      "stringer_{s}" : ShipSteel { Position: {hw + 0.08, high / 2, (s - 0.5) * 0.12}; Box: {0.012, high, 0.012} }
    }
    for k in 0..levels * 9 {
      "rung_{k}" : ShipSteel { Position: {hw + 0.08, (k + 0.5) * lv / 9, 0}; Box: {0.012, 0.012, 0.12} }
    }
    platform : ShipHullDarkFine { Position: {0, high + 0.04, 0}; Box: {1.4, 0.08, 1.4} }
    for s in 0..2 {
      YardRailing "rail_x_{s}"(len: 1.4, n: 4) { Position: {(s - 0.5) * 1.38, high + 0.08, 0} }
      YardRailing "rail_z_{s}"(len: 1.4, n: 4) { Position: {0, high + 0.08, (s - 0.5) * 1.38}; Rotation: {0, HALF_PI, 0} }
    }
    head {
      Position: {0, high + 0.6, 0}
      Rotation: {-0.35, 0, 0}
      frame : ShipTrim { Position: {0, 0, 0}; Box: {1.2, 0.7, 0.14} }
      for i in 0..6 {
        "lamp_{i}" : ShipWhiteLight { Position: {(i % 3 - 1) * 0.38, i < 3 ? -0.16 : 0.16, -0.075}; Box: {0.32, 0.26, 0.02} }
      }
    }
    beacon : ShipBeaconRed { Position: {0, high + 1.05, 0.2}; Sphere: {radius: 0.07, segments: 3, smooth: true} }
  }

  template MiniTug {
    prop seed: i32 = 0

    hull { Scale: {0.1, 0.1, 0.1}; MiniShuttle body(paint: seed % 2) }
    plume : ShipPlasma { Position: {0, 0.15, -0.34}; Sphere: {radius: 0.07, segments: 3, smooth: true}; NoShadow }
    beacon : ShipBeaconRed { Position: {0, 0.33, -0.1}; Sphere: {radius: 0.03, segments: 3, smooth: true} }
    glow { Position: {0, 0.15, -0.6}; PointLight: {intensity: 1.5, range: 2}; Rgb: {120, 180, 255} }
  }

  template Drydock {
    const len = SLOTS * SEG + 16
    const w = 3
    const gap = RING_R + 5
    const dl = AXIS_Y - 1.5
    const cx = gap + w / 2
    const bot = AXIS_Y - RING_R - 3
    const roof = AXIS_Y + RING_R + 3
    const pz = len / 2 + 0.8

    for s in 0..2 {
      YardGantry "gantry_{s}"(len: len) { Position: {s == 0 ? 0 - gap : gap, dl - 2.3, 0}; Rotation: {0, s == 0 ? PI : 0, 0} }
    }
    for r in 0..2 {
      "portal_{r}" {
        Position: {0, 0, (r == 0 ? -1 : 1) * pz}
        YardSpan floor(len: cx * 2, d: 1.6, n: 14) { Position: {0, bot, 0} }
        YardSpan lintel(len: cx * 2, d: 1.6, n: 14) { Position: {0, roof, 0} }
        for s in 0..2 {
          const sx = s == 0 ? -1 : 1
          YardSpan "column_{s}"(len: roof - bot, d: 1.6, n: 12) { Position: {sx * cx, (roof + bot) / 2, 0}; Rotation: {0, 0, HALF_PI} }
          for k in 0..2 {
            const ky = k == 0 ? bot : roof
            "node_{s}_{k}" : ShipHullDarkFine { Position: {sx * cx, ky, 0}; Box: {1.8, 1.8, 1.0} }
            "node_lamp_{s}_{k}" : ShipAmberLight { Position: {sx * cx, ky + (k == 0 ? -0.91 : 0.91), 0}; Box: {0.5, 0.02, 0.5} }
          }
          YardMast "mast_{s}"(high: 6, levels: 7) { Position: {sx * cx, roof + 0.92, 0}; Rotation: {0, r == 0 ? PI : 0, 0} }
        }
      }
    }
    YardGoliath goliath(span: cx * 2, high: roof - dl) { Position: {0, dl, 4} }

    MiniTug tug_a(seed: 0) { Position: {gap - 4, roof - 3, 30}; Rotation: {0, -0.4, 0} }
    MiniTug tug_b(seed: 1) { Position: {0 - gap + 3, bot + 4, -24}; Rotation: {0, 2.6, 0} }
  }

  template YardPlanet {
    surface {
      Position: {0, 0, 0}
      Rotation: {0, 0, 0.3}
      AngularVelocity: {0, 0.004, 0}
      Sphere: {radius: 420, segments: 64, smooth: true}
      Rgb: {255, 255, 255}
      PbrMaterial: {roughness: 0.75}
      Emissive: {strength: 0.8, color: {255, 214, 160}}
      PbrTextures: {albedo: yard_planet_tex, emissive: yard_planet_night_tex}
      NoShadow
      SpatialIgnore
    }
    clouds {
      Position: {0, 0, 0}
      Rotation: {0, 0, 0.3}
      AngularVelocity: {0, 0.006, 0}
      Sphere: {radius: 424, segments: 64, smooth: true}
      Rgb: {255, 255, 255}
      PbrMaterial: {roughness: 0.9}
      BlendMode: AlphaBlend
      PbrTextures: {albedo: yard_cloud_tex}
      NoShadow
      SpatialIgnore
    }
  }
}

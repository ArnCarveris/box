using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.texture
using box.light
using box.movement
using box.spatial
using box.transition
using state

assets {
  yard_planet_tex { TexturePath: {path: "etc/scenes/shipyard/assets/planet.jpg"} }
  yard_planet_night_tex { TexturePath: {path: "etc/scenes/shipyard/assets/planet_night.jpg"} }
  yard_cloud_tex { TexturePath: {path: "etc/scenes/shipyard/assets/clouds.png"} }
  yard_halo_tex { TexturePath: {path: "etc/scenes/shipyard/assets/halo.png"} }

  template HoloLine {
    prop len: f32 = 1
    prop glow: f32 = 1.2

    Box: {len, 0.03, 0.03}
    Rgb: {70, 200, 255}
    Emissive: {strength: glow, color: {60, 190, 255}}
    NoShadow
    SpatialIgnore
  }

  template DeckGrid {
    prop level: i32 = 0

    const y = level * CH + 0.14
    for i in 0..GX + 1 {
      HoloLine "z_{i}"(len: GZ * CW, glow: i == 0 || i == GX ? 2.4 : 0.9) { Position: {(i - GX / 2.0) * CW, y, 0}; Rotation: {0, HALF_PI, 0} }
    }
    for i in 0..GZ + 1 {
      HoloLine "x_{i}"(len: GX * CW, glow: i == 0 || i == GZ ? 2.4 : 0.9) { Position: {0, y, (i - GZ / 2.0) * CW} }
    }
    for i in 0..4 {
      const sx = i % 2 == 0 ? -1 : 1
      const sz = i < 2 ? -1 : 1
      "corner_{i}" : YardHolo { Position: {sx * GX * CW / 2, y + 0.02, sz * GZ * CW / 2}; Cylinder: {radius: 0.22, length: 0.04, segments: 16}; NoShadow; SpatialIgnore }
    }
  }

  template BuildFrame {
    const hx = GX * CW / 2 + 0.6
    const hz = GZ * CW / 2 + 0.6
    const top = GY * CH + 0.6
    for i in 0..4 {
      const sx = i % 2 == 0 ? -1 : 1
      const sz = i < 2 ? -1 : 1
      HoloLine "post_{i}"(len: top + 2.2, glow: 0.6) { Position: {sx * hx, top / 2 - 1.1, sz * hz}; Rotation: {0, 0, HALF_PI} }
      HoloLine "cap_x_{i}"(len: 2.4, glow: 2) { Position: {sx * (hx - 1.2), top, sz * hz} }
      HoloLine "cap_z_{i}"(len: 2.4, glow: 2) { Position: {sx * hx, top, sz * (hz - 1.2)}; Rotation: {0, HALF_PI, 0} }
    }
  }

  template Slipway {
    const w = GX * CW + 8
    const l = GZ * CW + 8
    slab : YardDeck { Position: {0, -3.2, 0}; Box: {w, 0.6, l} }
    rim_a : YardGirder { Position: {0 - w / 2, -2.84, 0}; Box: {0.5, 0.18, l + 0.4} }
    rim_b : YardGirder { Position: {w / 2, -2.84, 0}; Box: {0.5, 0.18, l + 0.4} }
    rim_c : YardGirder { Position: {0, -2.84, 0 - l / 2}; Box: {w + 0.4, 0.18, 0.5} }
    rim_d : YardGirder { Position: {0, -2.84, l / 2}; Box: {w + 0.4, 0.18, 0.5} }
    for s in 0..2 {
      const sx = s == 0 ? -1 : 1
      "edge_light_{s}" : ShipCyanLight { Position: {sx * (w / 2 + 0.1), -2.9, 0}; Box: {0.06, 0.08, l - 0.4} }
      for r in 0..2 {
        "rail_{s}_{r}" : ShipHullDark { Position: {sx * (r == 0 ? 6 : 14), -2.85, 0}; Box: {0.5, 0.2, l - 9} }
      }
    }
    for i in 0..GZ {
      "cradle_{i}" {
        Position: {0, -2.9, (i - GZ / 2.0 + 0.5) * CW}
        beam : YardGirder { Position: {0, 0.2, 0}; Box: {GX * CW - 10, 0.4, 0.5} }
        for s in 0..4 {
          "pad_{s}" : ShipHazard { Position: {(s - 1.5) * 8, 0.42, 0}; Box: {1.6, 0.06, 0.6} }
        }
      }
    }
    for i in 0..2 {
      "end_light_{i}" : ShipAmberLight { Position: {0, -2.9, i == 0 ? -0.1 - l / 2 : l / 2 + 0.1}; Box: {w - 1, 0.08, 0.06} }
    }
  }

  template YardClamp {
    housing : ShipHullDarkFine { Position: {1.4, 0, 0}; Box: {2.8, 3.4, 4.2} }
    collar : ShipTrim { Position: {-0.05, 0, 0}; Box: {0.3, 3.8, 4.6} }
    for p in 0..2 {
      "rod_{p}" : ShipChrome { Position: {-0.35, (p - 0.5) * 2.2, 0}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: 0.22, length: 0.5, segments: 8, smooth: true} }
    }
    shoe : ShipYellow { Position: {-0.85, 0, 0}; Box: {0.6, 3.2, 3.6} }
    pad : ShipRecess { Position: {-1.18, 0, 0}; Box: {0.08, 2.4, 2.8} }
    for j in 0..2 {
      "jaw_{j}" : ShipSteel { Position: {-0.95, (j - 0.5) * 3.6, 0}; Box: {1.0, 0.4, 3.9} }
    }
    for t in 0..4 {
      "tooth_{t}" : ShipTrim { Position: {-1.24, -1.05 + t * 0.7, 0}; Box: {0.1, 0.3, 2.4} }
    }
    stripe : ShipHazard { Position: {-0.85, 1.62, 0}; Box: {0.62, 0.04, 3.6} }
    lamp : ShipGreenLight { Position: {1.4, 1.75, 1.6}; Box: {0.5, 0.12, 0.5} }
  }

  template YardWing {
    prop len: f32 = 80

    const bays = 3
    const bl = len / bays
    const dz = bl / 2 - 1
    const tilt = atan(6 / dz)
    const strut = sqrt(dz * dz + 36)
    for c in 0..2 {
      const cx = c == 0 ? 0.6 : 9.4
      "top_{c}" : YardGirder { Position: {cx, 3, 0}; Box: {1.2, 1, len} }
      "cap_{c}" : ShipYellow { Position: {cx, 3.58, 0}; Box: {1.3, 0.16, len} }
      "bottom_{c}" : YardGirder { Position: {cx, -4, 0}; Box: {1.2, 1, len} }
      "rail_{c}" : ShipSteel { Position: {c == 0 ? 0.3 : 9.7, 4.4, 0}; Box: {0.08, 0.08, len} }
      for b in 0..bays {
        const bz = (b - bays / 2.0 + 0.5) * bl
        "rise_{c}_{b}" : ShipYellow { Position: {cx, -0.5, bz - dz / 2}; Rotation: {0 - tilt, 0, 0}; Box: {0.4, 0.4, strut} }
        "fall_{c}_{b}" : ShipYellow { Position: {cx, -0.5, bz + dz / 2}; Rotation: {tilt, 0, 0}; Box: {0.4, 0.4, strut} }
      }
      for e in 0..2 {
        "beacon_{c}_{e}" : ShipBeaconRed { Position: {cx, 3.9, (e - 0.5) * len}; Sphere: {radius: 0.2, segments: 3, smooth: true} }
      }
    }
    for i in 0..21 {
      const pz = (i - 10) * (len - 2) / 20
      "post_{i}" : ShipSteel { Position: {0.3, 4.0, pz}; Box: {0.06, 0.8, 0.06} }
    }
    lights : ShipRunLights { Position: {-0.02, 3, 0}; Box: {0.04, 0.3, len - 2} }
    pipe : ShipTeal { Position: {1.8, -2.7, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.35, length: len, segments: 8, smooth: true} }
    for f in 0..bays + 1 {
      const fz = (f - bays / 2.0) * bl
      "frame_{f}" : YardGirder { Position: {5, -0.5, fz}; Box: {10.4, 8, 1} }
      "band_{f}" : ShipYellow { Position: {5, 2.6, fz}; Box: {10.6, 1, 1.1} }
    }
    for b in 0..bays {
      const bz = (b - bays / 2.0 + 0.5) * bl
      "core_{b}" : ShipRecess { Position: {5.5, -0.6, bz}; Box: {6, 5.4, bl - 3} }
      "deck_{b}" : ShipHullDarkFine { Position: {5, 3.45, bz}; Box: {8.4, 0.2, bl - 1} }
      "lane_{b}" : ShipHazard { Position: {1.6, 3.56, bz}; Box: {0.3, 0.02, bl - 2} }
      YardClamp "clamp_{b}"() { Position: {0, 0.4, bz} }
    }
    for t in 0..3 {
      "tank_{t}" : ShipWhite { Position: {6.8, 4.5, -bl + (t - 1) * 2.4}; Cylinder: {radius: 0.9, length: 1.9, segments: 12, smooth: true} }
      "tank_band_{t}" : ShipTeal { Position: {6.8, 4.8, -bl + (t - 1) * 2.4}; Cylinder: {radius: 0.92, length: 0.2, segments: 12, smooth: true} }
    }
    for q in 0..4 {
      "stack_{q}" : ShipContainers { Position: {q % 2 == 0 ? 4.6 : 7.2, 3.55 + (q < 2 ? 0.6 : 0.45), (q < 2 ? -2 : 3)}; Box: {2.2, q < 2 ? 1.2 : 0.9, 3.8} }
    }
    for r in 0..5 {
      "fin_{r}" : ShipHeatFin { Position: {6.5, 4.35, bl - 4 + r * 1.6}; Box: {4.2, 1.4, 0.06} }
    }
  }

  template MiniTug {
    prop seed: i32 = 0

    hull { Scale: {0.1, 0.1, 0.1}; MiniShuttle body(paint: seed % 2) }
    plume : ShipPlasma { Position: {0, 0.15, -0.34}; Sphere: {radius: 0.07, segments: 3, smooth: true}; NoShadow }
    beacon : ShipBeaconRed { Position: {0, 0.33, -0.1}; Sphere: {radius: 0.03, segments: 3, smooth: true} }
    glow { Position: {0, 0.15, -0.6}; PointLight: {intensity: 1.5, range: 2}; Rgb: {120, 180, 255} }
  }

  template Drydock {
    const l = GZ * CW + 8
    const gap = GX * CW / 2 + 4

    for s in 0..2 {
      YardWing "wing_{s}"(len: l) { Position: {s == 0 ? 0 - gap : gap, 0, 0}; Rotation: {0, s == 0 ? PI : 0, 0} }
    }
    MiniTug tug_a(seed: 0) { Position: {gap + 14, 5, 8}; Rotation: {0, -0.3, 0} }
    MiniTug tug_b(seed: 1) { Position: {0 - gap - 12, 2, -14}; Rotation: {0, 2.6, 0} }
  }

  template YardPlanet {
    surface {
      Position: {0, 0, 0}
      Rotation: {0, 0, 0.3}
      AngularVelocity: {0, 0.004, 0}
      Sphere: {radius: 420, segments: 64, smooth: true}
      Rgb: {255, 255, 255}
      PbrMaterial: {roughness: 0.75}
      Emissive: {strength: 0.8, color: {255, 214, 160}}
      PbrTextures: {albedo: yard_planet_tex, emissive: yard_planet_night_tex}
      NoShadow
      SpatialIgnore
    }
    clouds {
      Position: {0, 0, 0}
      Rotation: {0, 0, 0.3}
      AngularVelocity: {0, 0.006, 0}
      Sphere: {radius: 424, segments: 64, smooth: true}
      Rgb: {255, 255, 255}
      PbrMaterial: {roughness: 0.9}
      BlendMode: AlphaBlend
      PbrTextures: {albedo: yard_cloud_tex}
      NoShadow
      SpatialIgnore
    }
  }
}

state {
  export const NOSE_LEN: f32 = 3.6

  fn nose_w(t: f32) -> f32 { 0.12 + 0.88 * sqrt(max(1 - pow(t, 1.9), 0)) }
  fn nose_h(t: f32) -> f32 { 0.1 + 0.9 * sqrt(max(1 - pow(t, 1.35), 0)) }
  fn nose_y(t: f32) -> f32 { 0.7 * t * t + 1.5 * nose_h(t) }
  fn nose_z(t: f32) -> f32 { 2 + NOSE_LEN * t }

  fn nose_sec(t: f32, grow: f32) -> box.geometry.LoftSection {
    {
      profile: assets.yard_nose_profile,
      offset: {0, nose_y(t), nose_z(t)},
      rotation: {0 - HALF_PI, 0, 0},
      scale: {0 - nose_w(t) * grow, nose_h(t) * grow}
    }
  }

  fn glass_sec(t: f32, grow: f32) -> box.geometry.LoftSection {
    {
      profile: assets.yard_canopy_profile,
      offset: {0, nose_y(t), nose_z(t)},
      rotation: {0 - HALF_PI, 0, 0},
      scale: {0 - nose_w(t) * grow, nose_h(t) * grow}
    }
  }

  fn band_sec(p: entity, t: f32) -> box.geometry.LoftSection {
    {
      profile: p,
      offset: {0, nose_y(t), nose_z(t)},
      rotation: {0 - HALF_PI, 0, 0},
      scale: {0 - nose_w(t), nose_h(t)}
    }
  }

  fn arch_sec(p: entity, z: f32) -> box.geometry.LoftSection {
    {profile: p, offset: {0, 0.6, z}, rotation: {0 - HALF_PI, 0, 0}, scale: {-1, 1}}
  }
}

assets {
  template HabSide {
    prop power: f32 = 1

    for c in 0..3 {
      const pane: Emissive = match power > 0 {
        true: {3.2 * lit_share(power, c, 3), {255, 204, 136}}
        _: match c == 1 { true: {0.35, {255, 50, 30}}; _: {0, {255, 50, 30}} }
      }
      "frame_{c}" : ShipTrim {
        Position: {-1.1 + c * 1.1, 1.15, 0.02}
        RoundedBox: {0.78, 0.56, 0.06, 0.08, segments: 2}
      }

      "pane_{c}" : PowerWindow {
        Position: {-1.1 + c * 1.1, 1.15, 0.045}
        RoundedBox: {0.62, 0.4, 0.04, 0.06, segments: 2}
        Emissive: pane
      }

      "sill_{c}" : ShipSteel { Position: {-1.1 + c * 1.1, 0.83, 0.05}; Box: {0.7, 0.04, 0.06} }
    }

    vent : ShipTrim { Position: {0.9, 2.5, 0.02}; Box: {0.8, 0.22, 0.04} }

    for i in 0..4 {
      "slat_{i}" : ShipRecess { Position: {0.62 + i * 0.19, 2.5, 0.041}; Box: {0.08, 0.16, 0.01} }
    }
  }

  template ObsSide {
    prop power: f32 = 1

    const lounge: Emissive = match power > 0 {
      true: {0.7 * power, {255, 186, 120}}
      _: {0.15, {255, 50, 30}}
    }
    backdrop : PowerWindow {
      Position: {0, 1.66, 0.012}
      Box: {3.3, 1.66, 0.02}
      Rgb: {70, 54, 40}
      Emissive: lounge
    }

    sill : ShipHull { Position: {0, 0.78, 0.32}; Box: {3.56, 0.12, 0.64} }
    head : ShipHull { Position: {0, 2.55, 0.43}; Box: {3.56, 0.12, 0.86} }
    head_trim : ShipStripe { Position: {0, 2.55, 0.866}; Box: {3.56, 0.08, 0.012} }

    for s in 0..2 {
      "cheek_{s}" : ShipHull {
        Position: {s == 0 ? -1.74 : 1.74, 1.66, 0.4}
        Box: {0.08, 1.66, 0.8}
      }
    }

    glass : ShipGlass { Position: {0, 1.66, 0.6}; Rotation: {0.18, 0, 0}; Box: {3.4, 1.68, 0.03} }

    for i in 0..4 {
      "mullion_{i}" : ShipTrim {
        Position: {-1.2 + i * 0.8, 1.66, 0.62}
        Rotation: {0.18, 0, 0}
        Box: {0.05, 1.7, 0.06}
      }
    }

    couch : ShipFabric {
      Position: {-0.6, 0.98, 0.22}
      RoundedBox: {1.5, 0.28, 0.36, 0.08, segments: 2}
    }

    couch_back : ShipFabric {
      Position: {-0.6, 1.2, 0.07}
      RoundedBox: {1.5, 0.4, 0.12, 0.05, segments: 2}
    }

    plant : ShipLeaf { Position: {1.15, 1.08, 0.24}; IcoSphere: {radius: 0.22, segments: 0} }
    pot : ShipWhite {
      Position: {1.15, 0.9, 0.24}
      Cylinder: {radius: 0.12, length: 0.2, segments: 6, smooth: true}
    }

    underglow : PowerLamp {
      Position: {0, 0.71, 0.55}
      Box: {3.3, 0.02, 0.04}
      Emissive: {strength: 4 * power, color: {220, 236, 255}}
    }
  }

  template SideFeature {
    prop k: i32 = 0
    prop power: f32 = 1

    if k == K_HAB {
      HabSide f(power: power)
    } else if k == K_OBS {
      ObsSide f(power: power)
    }
  }

  template Sides {
    prop k: i32 = 0
    prop px: bool = false
    prop nx: bool = false
    prop pz: bool = false
    prop nz: bool = false
    prop power: f32 = 1

    if px {
      face_px { Position: {2, 0, 0}; Rotation: {0, HALF_PI, 0}; SideFeature f(k: k, power: power) }
    }

    if nx {
      face_nx {
        Position: {-2, 0, 0}
        Rotation: {0, -HALF_PI, 0}
        SideFeature f(k: k, power: power)
      }
    }

    if pz {
      face_pz { Position: {0, 0, 2}; SideFeature f(k: k, power: power) }
    }

    if nz {
      face_nz { Position: {0, 0, -2}; Rotation: {0, PI, 0}; SideFeature f(k: k, power: power) }
    }
  }

  template WeaponTurret {
    prop power: f32 = 1

    pad : ShipHullDark { Position: {0, 0.03, 0}; RoundedBox: {2.7, 0.06, 2.7, 0.03, segments: 2} }

    for i in 0..4 {
      const bx = i % 2 == 0 ? -1.15 : 1.15
      const bz = i < 2 ? -1.15 : 1.15
      "bolt_{i}" : ShipChrome {
        Position: {bx, 0.08, bz}
        Cylinder: {radius: 0.07, length: 0.05, segments: 4, smooth: true}
      }
    }

    base : ShipTrim {
      Position: {0, 0.13, 0}
      Cylinder: {radius: 1.15, length: 0.22, segments: 8, smooth: true}
    }

    ring : ShipSteel {
      Position: {0, 0.25, 0}
      Torus: {radius: 1.08, tube: 0.05, segments: 8, rings: 3, smooth: true}
    }

    head {
      Position: {0, 0.26, 0}
      housing : ShipHullDark {
        Position: {0, 0.38, -0.15}
        RoundedBox: {1.5, 0.72, 1.7, 0.2, segments: 3}
      }

      cap : ShipHull { Position: {0, 0.76, -0.25}; RoundedBox: {1.2, 0.1, 1.2, 0.05, segments: 2} }
      mantlet : ShipTrim {
        Position: {0, 0.4, 0.74}
        RoundedBox: {1.0, 0.5, 0.24, 0.08, segments: 2}
      }

      for s in 0..2 {
        const bx = s == 0 ? -0.26 : 0.26
        "shroud_{s}" : ShipTrim {
          Position: {bx, 0.4, 1.0}
          Rotation: {HALF_PI, 0, 0}
          Cylinder: {radius: 0.13, length: 0.5, segments: 6, smooth: true}
        }

        "barrel_{s}" : ShipSteel {
          Position: {bx, 0.4, 1.3}
          Rotation: {HALF_PI, 0, 0}
          Cylinder: {radius: 0.075, length: 1.1, segments: 4, smooth: true}
        }

        "muzzle_{s}" : ShipTrim {
          Position: {bx, 0.4, 1.8}
          Rotation: {HALF_PI, 0, 0}
          Cylinder: {radius: 0.11, length: 0.16, segments: 6, smooth: true}
        }
      }

      eye : PowerLamp {
        Position: {0.6, 0.55, 0.62}
        Sphere: {radius: 0.08, segments: 3, smooth: true}
        Emissive: {strength: 5 * power, color: {255, 60, 40}}
      }

      for i in 0..3 {
        "status_{i}" : PowerLamp {
          Position: {0.36, 0.816, -0.62 + i * 0.2}
          Box: {0.18, 0.012, 0.1}
          Emissive: {strength: 4 * lit_share(power, i, 3), color: {90, 255, 110}}
        }
      }

      vent_a : ShipRecess { Position: {-0.76, 0.38, -0.3}; Box: {0.02, 0.36, 0.9} }
      vent_b : ShipRecess { Position: {0.76, 0.38, -0.3}; Box: {0.02, 0.36, 0.9} }
    }
  }

  template HabTop {
    hatch : ShipTrim {
      Position: {0.7, 0.03, 0.6}
      Cylinder: {radius: 0.45, length: 0.06, segments: 8, smooth: true}
    }

    lid : ShipHull {
      Position: {0.7, 0.07, 0.6}
      Cylinder: {radius: 0.36, length: 0.04, segments: 8, smooth: true}
    }

    stalk : ShipSteel {
      Position: {-0.8, 0.3, -0.8}
      Cylinder: {radius: 0.05, length: 0.6, segments: 4, smooth: true}
    }

    dish : ShipWhite {
      Position: {-0.8, 0.62, -0.8}
      Rotation: {PI - 0.5, 0, 0}
      HemiSphere: {radius: 0.42, segments: 4, smooth: true}
    }

    feed : ShipSteel {
      Position: {-0.8, 0.55, -0.65}
      Cylinder: {radius: 0.02, length: 0.4, segments: 4, smooth: true}
    }
  }

  template LandingLeg {
    strut : ShipSteel {
      Position: {0, -0.46, 0}
      Cylinder: {radius: 0.09, length: 0.88, segments: 4, smooth: true}
    }

    sleeve : ShipTrim {
      Position: {0, -0.25, 0}
      Cylinder: {radius: 0.14, length: 0.4, segments: 6, smooth: true}
    }

    foot : ShipTrim {
      Position: {0, -0.92, 0}
      Cylinder: {radius: 0.32, length: 0.08, segments: 8, smooth: true}
    }
  }

  template CargoBelly {
    frame : ShipHazard { Position: {0, -0.02, 0}; Box: {2.7, 0.04, 2.9} }
    ramp : ShipHullDark { Position: {0, -0.045, 0}; Box: {2.4, 0.04, 2.6} }

    for i in 0..6 {
      "rib_{i}" : ShipTrim { Position: {0, -0.07, -1.05 + i * 0.42}; Box: {2.3, 0.02, 0.06} }
    }

    LandingLeg leg_a() { Position: {-1.2, 0, -1.2} }
    LandingLeg leg_b() { Position: {1.2, 0, -1.2} }
    LandingLeg leg_c() { Position: {-1.2, 0, 1.2} }
    LandingLeg leg_d() { Position: {1.2, 0, 1.2} }
    flood : ShipWhiteLight { Position: {0, -0.08, 1.5}; Box: {0.6, 0.04, 0.12} }
  }

  template WeaponMount {
    prop side: i32 = 1
    prop power: f32 = 1

    if side == 2 {
      mount {
        Position: {-2, CH / 2, 0}
        Rotation: {0, 0, 0 - HALF_PI}
        WeaponTurret turret(power: power)
      }
    } else if side == 3 {
      mount {
        Position: {2, CH / 2, 0}
        Rotation: {0, 0, HALF_PI}
        WeaponTurret turret(power: power)
      }
    } else {
      WeaponTurret turret(power: power)
    }
  }

  template RackFrame {
    prop pz: bool = true
    prop nz: bool = true

    const bw = 0.22
    const ex = 2 - bw / 2

    for c in 0..4 {
      const cx = c % 2 == 0 ? 0 - ex : ex
      const cy = c < 2 ? bw / 2 : CH - bw / 2
      "long_{c}" : ShipHullDark { Position: {cx, cy, 0}; Box: {bw, bw, 4} }
    }

    for e in 0..2 {
      const ez = e == 0 ? 0 - ex : ex

      if (e == 0 && nz) || (e == 1 && pz) {
        const post_z = ez - (e == 0 ? -0.0015 : 0.0015)
        "post_a_{e}" : ShipHullDark {
          Position: {0 - ex, CH / 2, post_z}
          Box: {bw, CH - bw * 2, bw - 0.003}
        }

        "post_b_{e}" : ShipHullDark {
          Position: {ex, CH / 2, post_z}
          Box: {bw, CH - bw * 2, bw - 0.003}
        }

        "sill_{e}" : ShipHullDark { Position: {0, bw / 2, ez}; Box: {4 - bw * 2, bw, bw} }
        "lintel_{e}" : ShipHullDark { Position: {0, CH - bw / 2, ez}; Box: {4 - bw * 2, bw, bw} }
        "cap_a_{e}" : ShipHazard {
          Position: {0 - ex, CH - 0.02, ez}
          Box: {bw + 0.02, 0.06, bw + 0.02}
        }

        "cap_b_{e}" : ShipHazard {
          Position: {ex, CH - 0.02, ez}
          Box: {bw + 0.02, 0.06, bw + 0.02}
        }
      }
    }
  }

  template CargoContainer {
    prop tint: Rgb = {164, 70, 44}
    prop rib_p: bool = false
    prop rib_n: bool = false
    prop roof: bool = false
    prop front: bool = false
    prop back: bool = false

    const w = 1.7
    const h = 1.22
    const l = 3.5

    body : ShipCrate { Position: {0, 0, 0}; Box: {w - 0.08, h - 0.08, l - 0.1}; Rgb: tint }

    for e in 0..2 {
      "end_{e}" : ShipCrate {
        Position: {0, 0, e == 0 ? 0.05 - l / 2 : l / 2 - 0.05}
        Box: {w - 0.02, h - 0.02, 0.1}
        Rgb: tint
      }
    }

    for c in 0..4 {
      const cx = c % 2 == 0 ? 0.05 - w / 2 : w / 2 - 0.05
      const cy = c < 2 ? 0.05 - h / 2 : h / 2 - 0.05
      "rail_{c}" : ShipTrim { Position: {cx, cy, 0}; Box: {0.1, 0.1, l + 0.02} }
    }

    for i in 0..8 {
      const rz = -1.33 + i * 0.38

      if rib_p {
        "rib_p_{i}" : ShipCrate {
          Position: {w / 2 - 0.03, 0, rz}
          Box: {0.04, h - 0.2, 0.1}
          Rgb: tint
        }
      }

      if rib_n {
        "rib_n_{i}" : ShipCrate {
          Position: {0.03 - w / 2, 0, rz}
          Box: {0.04, h - 0.2, 0.1}
          Rgb: tint
        }
      }

      if roof {
        "rib_t_{i}" : ShipCrate {
          Position: {0, h / 2 - 0.03, rz}
          Box: {w - 0.2, 0.04, 0.1}
          Rgb: tint
        }
      }
    }

    for e in 0..2 {
      const ez = e == 0 ? 0 - l / 2 - 0.01 : l / 2 + 0.01

      if (e == 0 && back) || (e == 1 && front) {
        "seam_{e}" : ShipRecess { Position: {0, 0, ez}; Box: {0.02, h - 0.14, 0.02} }

        for b in 0..2 {
          const bx = b == 0 ? -0.22 : 0.22
          "bar_{e}_{b}" : ShipSteel { Position: {bx, 0, ez}; Box: {0.035, h - 0.18, 0.04} }
          "grip_{e}_{b}" : ShipSteel {
            Position: {bx + (b == 0 ? -0.05 : 0.05), -0.1, ez}
            Box: {0.1, 0.03, 0.05}
          }
        }
      }
    }
  }

  template CargoRack {
    prop px: bool = false
    prop nx: bool = false
    prop py: bool = false
    prop pz: bool = true
    prop nz: bool = true
    prop belly: bool = true
    prop seed: i32 = 0

    RackFrame frame(pz: pz, nz: nz)
    floor : ShipHullDark { Position: {0, 0.19, 0}; Box: {3.56, 0.06, 3.56} }

    for s in 0..4 {
      const right = s % 2 == 1
      const upper = s >= 2
      const pick = (seed * 37 + s * 13) % 6
      const tint: Rgb = match pick {
        0: {164, 70, 44}
        1: {38, 76, 132}
        2: {52, 106, 72}
        3: {206, 154, 38}
        4: {124, 130, 138}
        _: {30, 112, 120}
      }

      if !(upper && py && (seed * 29 + s * 7) % 5 == 0) {
        CargoContainer "crate_{s}"(
          tint: tint,
          rib_p: right && px,
          rib_n: !right && nx,
          roof: upper && py,
          front: pz,
          back: nz
        ) {
          Position: {right ? 0.92 : -0.92, upper ? 2.09 : 0.83, 0}
        }
      }
    }

    if belly {
      CargoBelly belly()
    }
  }

  template FuelRack {
    prop px: bool = true
    prop nx: bool = true
    prop pz: bool = true
    prop nz: bool = true
    prop tp: bool = false
    prop tn: bool = false

    const r = 1.22
    const z0 = tn ? -2 : -1.2
    const z1 = tp ? 2 : 1.2
    const brace = 0.6233

    RackFrame frame(pz: pz, nz: nz)
    tank : ShipWhite {
      Position: {0, 1.5, (z0 + z1) / 2}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: r, length: z1 - z0, segments: 8, smooth: true}
    }

    if !tp {
      dome_p : ShipWhite {
        Position: {0, 1.5, 1.2}
        EllipsoidShell: {
          radius: {r, r, 0.58},
          longitude_start: 0,
          longitude_end: PI,
          latitude_start: 0 - HALF_PI,
          latitude_end: HALF_PI,
          segments: 4,
          rings: 4
        }
      }

      boss_p : ShipSteel {
        Position: {0, 1.5, 1.8}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: 0.16, length: 0.1, segments: 6, smooth: true}
      }
    }

    if !tn {
      dome_n : ShipWhite {
        Position: {0, 1.5, -1.2}
        Rotation: {0, PI, 0}
        EllipsoidShell: {
          radius: {r, r, 0.58},
          longitude_start: 0,
          longitude_end: PI,
          latitude_start: 0 - HALF_PI,
          latitude_end: HALF_PI,
          segments: 4,
          rings: 4
        }
      }

      boss_n : ShipSteel {
        Position: {0, 1.5, -1.8}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: 0.16, length: 0.1, segments: 6, smooth: true}
      }
    }

    for s in 0..2 {
      const sz = s == 0 ? -1.0 : 1.0
      "band_{s}" : ShipOrange {
        Position: {0, 1.5, s == 0 ? -0.5 : 0.5}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: r + 0.02, length: 0.2, segments: 8, smooth: true}
      }

      "strap_{s}" : ShipTrim {
        Position: {0, 1.5, sz}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: r + 0.025, length: 0.08, segments: 8, smooth: true}
      }

      "cross_{s}" : ShipHullDark { Position: {0, 0.11, sz}; Box: {3.56, 0.18, 0.2} }
      "saddle_{s}" : ShipTrim { Position: {0, 0.38, sz}; Box: {1.6, 0.36, 0.26} }
      "clip_{s}" : ShipTrim { Position: {0, 2.8, sz}; Box: {0.14, 0.12, 0.1} }
    }

    const pz0 = nz ? -1.998 : -2
    const pz1 = pz ? 1.998 : 2
    pipe : ShipCopper {
      Position: {0, 2.9, (pz0 + pz1) / 2}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: 0.07, length: pz1 - pz0, segments: 4, smooth: true}
    }

    riser : ShipSteel {
      Position: {0, 2.98, 0}
      Cylinder: {radius: 0.04, length: 0.14, segments: 4, smooth: true}
    }

    wheel : ShipRed {
      Position: {0, 3.04, 0}
      Torus: {radius: 0.13, tube: 0.025, segments: 6, rings: 3, smooth: true}
    }

    if px {
      gauge_p : ShipAmberLight {
        Position: {r + 0.01, 1.5, 0}
        Rotation: {0, 0, HALF_PI}
        Cylinder: {radius: 0.12, length: 0.03, segments: 6, smooth: true}
      }

      brace_pa : ShipSteel {
        Position: {1.89, 1.5, 0}
        Rotation: {brace, 0, 0}
        Box: {0.08, 0.08, 4.38}
      }

      brace_pb : ShipSteel {
        Position: {1.89, 1.5, 0}
        Rotation: {0 - brace, 0, 0}
        Box: {0.08, 0.08, 4.38}
      }
    }

    if nx {
      gauge_n : ShipAmberLight {
        Position: {0 - r - 0.01, 1.5, 0}
        Rotation: {0, 0, HALF_PI}
        Cylinder: {radius: 0.12, length: 0.03, segments: 6, smooth: true}
      }

      brace_na : ShipSteel {
        Position: {-1.89, 1.5, 0}
        Rotation: {brace, 0, 0}
        Box: {0.08, 0.08, 4.38}
      }

      brace_nb : ShipSteel {
        Position: {-1.89, 1.5, 0}
        Rotation: {0 - brace, 0, 0}
        Box: {0.08, 0.08, 4.38}
      }
    }
  }

  template CockpitNose {
    prop px: bool = true
    prop nx: bool = true
    prop power: f32 = 1

    const console: Emissive = match power > 0 {
      true: {0.5 * power, {60, 150, 210}}
      _: {0.02, {255, 50, 30}}
    }

    shell : ShipHull {
      Position: {0, 0, 0}; Loft: {
        sections: [
          nose_sec(0, 1),
          nose_sec(0.12, 1),
          nose_sec(0.25, 1),
          nose_sec(0.38, 1),
          nose_sec(0.5, 1),
          nose_sec(0.62, 1),
          nose_sec(0.72, 1),
          nose_sec(0.8, 1),
          nose_sec(0.87, 1),
          nose_sec(0.93, 1),
          nose_sec(0.97, 1),
          nose_sec(1, 1)
        ],
        cap_start: false, cap_end: true, segments: 2, rings: 4
      }
    }

    canopy : PowerCanopy {
      Position: {0, 0, 0}; Loft: {
        sections: [
          glass_sec(0, 1.012),
          glass_sec(0.12, 1.012),
          glass_sec(0.25, 1.012),
          glass_sec(0.38, 1.012),
          glass_sec(0.5, 1.012),
          glass_sec(0.6, 1.012)
        ],
        cap_start: true, cap_end: true, segments: 2, rings: 3
      }
      Emissive: console
    }

    for i in 0..4 {
      const t = match i { 0: 0.003; 1: 0.2; 2: 0.4; _: 0.585 }
      "frame_{i}" : ShipTrim {
        Position: {0, 0, 0}
        Loft: {
          sections: [
            glass_sec(t, 1.03),
            glass_sec(t + 0.018, 1.03)
          ],
          cap_start: true, cap_end: true, segments: 2, rings: 3
        }
      }
    }

    ridge : ShipTrim {
      Position: {0, 0, 0}
      Loft: {
        sections: [
          band_sec(yard_spine_profile, 0.003),
          band_sec(yard_spine_profile, 0.2),
          band_sec(yard_spine_profile, 0.4),
          band_sec(yard_spine_profile, 0.597)
        ],
        cap_start: true, cap_end: true, segments: 2, rings: 3
      }
    }

    if px {
      stripe_p : ShipStripe {
        Position: {0, 0, 0}
        Loft: {
          sections: [
            band_sec(yard_stripe_n_profile, 0),
            band_sec(yard_stripe_n_profile, 0.25),
            band_sec(yard_stripe_n_profile, 0.5),
            band_sec(yard_stripe_n_profile, 0.7),
            band_sec(yard_stripe_n_profile, 0.84)
          ],
          cap_start: true, cap_end: true, segments: 2, rings: 3
        }
      }

      line_p : ShipTrim {
        Position: {0, 0, 0}
        Loft: {
          sections: [
            band_sec(yard_line_n_profile, 0),
            band_sec(yard_line_n_profile, 0.25),
            band_sec(yard_line_n_profile, 0.5),
            band_sec(yard_line_n_profile, 0.7),
            band_sec(yard_line_n_profile, 0.8)
          ],
          cap_start: true, cap_end: true, segments: 2, rings: 3
        }
      }
    }

    if nx {
      stripe_n : ShipStripe {
        Position: {0, 0, 0}
        Loft: {
          sections: [
            band_sec(yard_stripe_profile, 0),
            band_sec(yard_stripe_profile, 0.25),
            band_sec(yard_stripe_profile, 0.5),
            band_sec(yard_stripe_profile, 0.7),
            band_sec(yard_stripe_profile, 0.84)
          ],
          cap_start: true, cap_end: true, segments: 2, rings: 3
        }
      }

      line_n : ShipTrim {
        Position: {0, 0, 0}
        Loft: {
          sections: [
            band_sec(yard_line_profile, 0),
            band_sec(yard_line_profile, 0.25),
            band_sec(yard_line_profile, 0.5),
            band_sec(yard_line_profile, 0.7),
            band_sec(yard_line_profile, 0.8)
          ],
          cap_start: true, cap_end: true, segments: 2, rings: 3
        }
      }
    }

    tip : ShipChrome {
      Position: {0, nose_y(1), nose_z(1) - 0.05}
      Sphere: {radius: 0.16, segments: 4, smooth: true}
    }

    for s in 0..2 {
      const sx = s == 0 ? -1 : 1
      "lamp_{s}" : PowerLamp {
        Position: {sx * (2 * nose_w(0.55) + 0.01), nose_y(0.55) - nose_h(0.55) * 0.5, nose_z(0.55)}
        Box: {0.02, 0.05, 0.36}
        Emissive: {strength: 4 * lit_share(power, s, 2), color: {220, 236, 255}}
      }
    }
  }

  template CockpitFlank {
    prop sx: f32 = 1
    prop power: f32 = 1

    const console: Emissive = match power > 0 {
      true: {0.5 * power, {60, 150, 210}}
      _: {0.02, {255, 50, 30}}
    }
    frame : ShipTrim { Position: {sx * 2.004, 2.36, 0.88}; Box: {0.02, 0.56, 2.32} }
    glass : PowerCanopy {
      Position: {sx * 2.012, 2.36, 0.9}
      Box: {0.02, 0.44, 2.2}
      Emissive: console
    }

    for i in 0..2 {
      "post_{i}" : ShipTrim {
        Position: {sx * 2.024, 2.36, 0.1 + i * 0.75}
        Box: {0.02, 0.46, 0.05}
      }
    }
  }

  template CockpitTop {
    fairing : ShipHull { Position: {0, 0.1, 0.1}; RoundedBox: {0.7, 0.2, 3.4, 0.09, segments: 3} }
    cap : ShipTrim { Position: {0, 0.205, 0.1}; Box: {0.3, 0.02, 3.0} }

    for s in 0..2 {
      const sx = s == 0 ? -1.1 : 1.1
      "vent_{s}" : ShipRecess { Position: {sx, 0.006, -1.0}; Box: {0.5, 0.01, 0.9} }

      for i in 0..4 {
        "slat_{s}_{i}" : ShipTrim {
          Position: {sx, 0.02, -1.36 + i * 0.24}
          Box: {0.46, 0.02, 0.06}
        }
      }
    }

    mast : ShipSteel {
      Position: {0, 0.5, -1.2}
      Cylinder: {radius: 0.03, length: 0.6, segments: 4, smooth: true}
    }

    tip : ShipBeaconWhite {
      Position: {0, 0.82, -1.2}
      Sphere: {radius: 0.06, segments: 3, smooth: true}
    }
  }

  template EngineMountBell {
    prop cy: f32 = 0
    prop power: f32 = 1

    const fire = power > 0
    const hot: Emissive = match fire { true: {4 * power, {255, 255, 255}}; _: {0, {255, 40, 10}} }

    Position: {0, cy, 0.34}
    Rotation: {0 - HALF_PI, 0, 0}
    Lathe: {
      profile: bell_outer,
      inner: bell_inner,
      cap_start: true,
      cap_end: true,
      segments: 8,
      rings: 3
    }
    Rgb: {128, 120, 116}
    PbrMaterial: {metallic: 0.9, roughness: 0.32}
    SurfaceMaterials: {inner: {color: {70, 80, 104, 255}, metallic: 0.9, roughness: 0.4}}
    PbrTextures: {emissive: yard_tex_nozzle_glow}
    Emissive: hot

    if fire {
      Transition: [Emissive: {duration: 2.5, timing_function: EaseInOut}]
    } else {
      Transition: [Emissive: {duration: 8, timing_function: EaseOut}]
    }
  }

  template EngineMountHaze {
    prop cy: f32 = 0
    prop seed: i32 = 0
    prop fire: bool = true

    Position: {0, cy, -1.6}
    Emitter: {
      max: 56, rate: 80, shape: EmitterDisc, radius: 0.5,
      direction: {0, 0, -1}, spread: 6, speed: {11, 15},
      lifetime: {0.45, 0.7}, size: {1.5, 2.1}, opacity: {0.07, 0.11},
      color: {110, 150, 255}, seed: 170 + seed
    }

    if fire {
      Playback: {state: Playing}
    } else {
      Playback: {state: Stopped}
    }

    Appearance: {blend: Additive, stretch: 0.05}
    Curves: {
      size: {keys: [{0, 0.7}, {1, 1.5}]},
      opacity: {keys: [{0, 0}, {0.15, 1}, {0.6, 0.6}, {1, 0}]},
      color: {keys: [{0, {200, 230, 255}}, {0.4, {255, 255, 255}}, {1, {170, 110, 255}}]}
    }
    Ignore
  }

  template EngineMountExhaust {
    prop cy: f32 = 0
    prop seed: i32 = 0
    prop fire: bool = true

    Position: {0, cy, -1.9}
    Emitter: {
      max: 160, rate: 260, shape: EmitterDisc, radius: 0.6,
      direction: {0, 0, -1}, spread: 3, speed: {18, 26},
      lifetime: {0.22, 0.42}, size: {0.22, 0.4}, opacity: {0.3, 0.55},
      color: {170, 215, 255}, seed: 70 + seed
    }

    if fire {
      Playback: {state: Playing}
    } else {
      Playback: {state: Stopped}
    }

    Forces: {gravity: {0, 0, 0}, turbulence: 14, turbulence_scale: 0.8}
    Appearance: {blend: Additive, stretch: 0.06}
    Curves: {
      size: {keys: [{0, 0.8}, {1, 1.3}]},
      opacity: {keys: [{0, 0}, {0.08, 1}, {0.4, 0.45}, {1, 0}]},
      color: {keys: [{0, {255, 255, 255}}, {0.3, {130, 190, 255}}, {1, {90, 60, 255}}]}
    }
    Ignore
  }

  template EngineMount {
    prop seed: i32 = 0
    prop mounted: bool = true
    prop power: f32 = 1

    const cy = CH / 2
    const fire = power > 0
    const lip_glow: Emissive = match fire {
      true: {5 * power, {255, 110, 40}}
      _: {0, {255, 40, 10}}
    }

    plate : ShipHullDark {
      Position: {0, cy, 1.93}
      RoundedBox: {3.0, 2.5, 0.14, 0.12, segments: 2}
    }

    for i in 0..4 {
      const bx = i % 2 == 0 ? -1.32 : 1.32
      const by = i < 2 ? -1.07 : 1.07
      "bolt_{i}" : ShipChrome {
        Position: {bx, cy + by, 1.85}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: 0.06, length: 0.04, segments: 4, smooth: true}
      }
    }

    flange : ShipTrim {
      Position: {0, cy, 1.78}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: 1.12, length: 0.16, segments: 8, smooth: true}
    }

    for i in 0..10 {
      const a = i * PI / 5
      "stud_{i}" : ShipChrome {
        Position: {cos(a) * 1.0, cy + sin(a) * 1.0, 1.68}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: 0.045, length: 0.05, segments: 4, smooth: true}
      }
    }

    thrust : ShipSteel {
      Position: {0, cy, 1.3}
      Rotation: {0 - HALF_PI, 0, 0}
      Frustum: {radius_bottom: 0.95, radius_top: 0.5, length: 0.8, segments: 8, smooth: true}
    }

    for i in 0..6 {
      const a = i * PI / 3 + PI / 6
      "rib_{i}" : ShipTrim {
        Position: {cos(a) * 0.72, cy + sin(a) * 0.72, 1.3}
        Rotation: {0, 0, a}
        Box: {0.06, 0.06, 0.78}
      }
    }

    chamber : ShipSteel {
      Position: {0, cy, 0.62}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: 0.5, length: 0.6, segments: 8, smooth: true}
    }

    for i in 0..3 {
      "coil_{i}" : ShipCopper {
        Position: {0, cy, 0.42 + i * 0.2}
        Torus: {radius: 0.52, tube: 0.035, segments: 8, rings: 3, smooth: true}
        Rotation: {HALF_PI, 0, 0}
      }
    }

    for s in 0..2 {
      const sx = s == 0 ? -0.86 : 0.86
      "pump_{s}" : ShipChrome {
        Position: {sx, cy + 0.42, 0.95}
        Rotation: {HALF_PI, 0, 0}
        Capsule: {radius: 0.18, length: 0.4, segments: 4, smooth: true}
      }

      "pump_band_{s}" : ShipOrange {
        Position: {sx, cy + 0.42, 0.95}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: 0.19, length: 0.1, segments: 6, smooth: true}
      }

      "feed_{s}" : ShipCopper {
        Position: {sx, cy + 0.42, 1.42}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: 0.06, length: 0.5, segments: 4, smooth: true}
      }

      "line_{s}" : ShipCopper {
        Position: {sx * 0.66, cy + 0.3, 0.7}
        Rotation: {0, 0, 0 - sx * 0.6}
        Cylinder: {radius: 0.045, length: 0.5, segments: 4, smooth: true}
      }

      "ram_{s}" : ShipSteel {
        Position: {sx * 0.95, cy - 0.5, 0.9}
        Rotation: {HALF_PI - 0.25, 0, 0}
        Cylinder: {radius: 0.05, length: 1.6, segments: 4, smooth: true}
      }

      "ram_sleeve_{s}" : ShipTrim {
        Position: {sx * 0.95, cy - 0.6, 1.3}
        Rotation: {HALF_PI - 0.25, 0, 0}
        Cylinder: {radius: 0.08, length: 0.7, segments: 4, smooth: true}
      }
    }

    EngineMountBell bell(cy: cy, power: power)

    band_a : ShipTrim {
      Position: {0, cy, 0.34 - 0.87}
      Rotation: {HALF_PI, 0, 0}
      Torus: {radius: 0.67, tube: 0.04, segments: 8, rings: 3, smooth: true}
    }

    band_b : ShipTrim {
      Position: {0, cy, 0.34 - 1.69}
      Rotation: {HALF_PI, 0, 0}
      Torus: {radius: 1.04, tube: 0.04, segments: 8, rings: 3, smooth: true}
    }

    lip : ShipHeatFade {
      Position: {0, cy, 0.34 - 2.25}
      Rotation: {HALF_PI, 0, 0}
      Torus: {radius: 1.36, tube: 0.04, segments: 8, rings: 3, smooth: true}
      Emissive: lip_glow

      if fire {
        Transition: [Emissive: {duration: 2.5, timing_function: EaseInOut}]
      } else {
        Transition: [Emissive: {duration: 8, timing_function: EaseOut}]
      }
    }

    core : ShipPlasma {
      Position: {0, cy, 0.3}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: 0.4, length: 0.04, segments: 8, smooth: true}
      Emissive: {strength: 10 * power, color: {110, 190, 255}}
      Transition: [Emissive: {duration: 1, timing_function: EaseInOut}]
    }

    throat : ShipPlasma {
      Position: {0, cy, 0.2}
      Rotation: {HALF_PI, 0, 0}
      Torus: {radius: 0.42, tube: 0.05, segments: 8, rings: 3, smooth: true}
      Emissive: {strength: 10 * power, color: {110, 190, 255}}
      Transition: [Emissive: {duration: 1, timing_function: EaseInOut}]
    }

    glow {
      Position: {0, cy, 0.34 - 1.1}
      Rotation: {0 - HALF_PI, 0, 0}
      Frustum: {radius_bottom: 0.4, radius_top: 1.25, length: 2.1, segments: 8, smooth: true}
      Rgb: {120, 190, 255}
      Emissive: {strength: 2.5 * power, color: {90, 170, 255}}
      Opacity: {0.14 * power}
      Transition: [
        Emissive: {duration: 1, timing_function: EaseInOut},
        Opacity: {duration: 1, timing_function: EaseInOut}
      ]
      BlendMode: Additive
      NoShadow
      Ignore
    }

    plume_core : ShipPlumeCore {
      Position: {0, cy, 0.34 - 1.7}
      Rotation: {0 - HALF_PI, 0, 0}
      Lathe: {profile: plume_core_shape, segments: 12, rings: 8}
      Opacity: {0.2 * power}
      Transition: [Opacity: {duration: 1, timing_function: EaseInOut}]
      NoShadow
      Ignore
    }

    EngineMountHaze haze(cy: cy, seed: seed, fire: fire)

    EngineMountExhaust exhaust(cy: cy, seed: seed, fire: fire)

    light : PowerLight {
      Position: {0, cy, -2.6}
      PointLight: {intensity: 22 * power, range: 9}
      Rgb: {120, 180, 255}
    }
  }

  template PlantPipe {
    prop len: f32 = 1
    prop r: f32 = 0.07
    prop copper: bool = false

    if copper {
      run : ShipCopper {
        Position: {0, 0, 0}
        Cylinder: {radius: r, length: len, segments: 4, smooth: true}
      }
    } else {
      run : ShipSteel {
        Position: {0, 0, 0}
        Cylinder: {radius: r, length: len, segments: 4, smooth: true}
      }
    }

    if len > 1.2 {
      flange_a : ShipTrim {
        Position: {0, len / 2 - 0.2, 0}
        Cylinder: {radius: r * 1.6, length: 0.06, segments: 6, smooth: true}
      }

      flange_b : ShipTrim {
        Position: {0, 0.2 - len / 2, 0}
        Cylinder: {radius: r * 1.6, length: 0.06, segments: 6, smooth: true}
      }
    }
  }

  template PlantElbow {
    prop r: f32 = 0.07
    prop copper: bool = false

    if copper {
      ball : ShipCopper {
        Position: {0, 0, 0}
        Sphere: {radius: r * 1.25, segments: 3, smooth: true}
      }
    } else {
      ball : ShipSteel {
        Position: {0, 0, 0}
        Sphere: {radius: r * 1.25, segments: 3, smooth: true}
      }
    }
  }

  template ReactorVessel {
    prop h: f32 = 1.9
    prop r: f32 = 0.6
    prop jacket: bool = false

    skirt : ShipTrim {
      Position: {0, 0.15, 0}
      Cylinder: {radius: r * 0.85, length: 0.3, segments: 8, smooth: true}
    }

    shell : ShipWhite {
      Position: {0, 0.3 + h / 2, 0}
      Cylinder: {radius: r, length: h, segments: 8, smooth: true}
    }

    head : ShipWhite {
      Position: {0, 0.3 + h, 0}
      EllipsoidShell: {
        radius: {r, r * 0.5, r},
        longitude_start: 0,
        longitude_end: 6.2832,
        latitude_start: 0,
        latitude_end: HALF_PI,
        segments: 8,
        rings: 3
      }
    }

    foot : ShipWhite {
      Position: {0, 0.3, 0}
      EllipsoidShell: {
        radius: {r, r * 0.3, r},
        longitude_start: 0,
        longitude_end: 6.2832,
        latitude_start: 0 - HALF_PI,
        latitude_end: 0,
        segments: 8,
        rings: 3
      }
    }

    if jacket {
      for i in 0..6 {
        "coil_{i}" : ShipCopper {
          Position: {0, 0.55 + i * (h - 0.5) / 5, 0}
          Torus: {radius: r + 0.03, tube: 0.035, segments: 8, rings: 3, smooth: true}
        }
      }

      motor : ShipTeal {
        Position: {0, 0.3 + h + r * 0.5 + 0.18, 0}
        RoundedBox: {0.36, 0.36, 0.36, 0.05, segments: 2}
      }

      shaft : ShipChrome {
        Position: {0, 0.3 + h + r * 0.5, 0}
        Cylinder: {radius: 0.06, length: 0.12, segments: 4, smooth: true}
      }
    } else {
      band_a : ShipTeal {
        Position: {0, 0.3 + h * 0.18, 0}
        Cylinder: {radius: r + 0.015, length: 0.14, segments: 8, smooth: true}
      }

      band_b : ShipTeal {
        Position: {0, 0.3 + h * 0.86, 0}
        Cylinder: {radius: r + 0.015, length: 0.14, segments: 8, smooth: true}
      }

      nozzle : ShipSteel {
        Position: {0, 0.3 + h + r * 0.5 + 0.08, 0}
        Cylinder: {radius: 0.09, length: 0.2, segments: 4, smooth: true}
      }

      nozzle_cap : ShipTrim {
        Position: {0, 0.3 + h + r * 0.5 + 0.19, 0}
        Cylinder: {radius: 0.14, length: 0.04, segments: 6, smooth: true}
      }
    }

    for s in 0..2 {
      const a = s == 0 ? 0.0 : PI
      "sight_{s}" : ShipAlgae {
        Position: {cos(a) * (r + 0.005), 0.3 + h / 2, sin(a) * (r + 0.005)}
        Rotation: {0, 0 - a, 0}
        Box: {0.02, h * 0.6, 0.07}
      }

      "sight_rim_{s}" : ShipTrim {
        Position: {cos(a) * r, 0.3 + h / 2, sin(a) * r}
        Rotation: {0, 0 - a, 0}
        Box: {0.02, h * 0.6 + 0.08, 0.13}
      }
    }

    manway : ShipTrim {
      Position: {0, 0.3 + h * 0.4, r}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: 0.18, length: 0.06, segments: 6, smooth: true}
    }
  }

  template LifePlantSabatier {
    Position: {-1.3, 2.18, 0.6}
    shell : ShipWhite {
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: 0.3, length: 1.6, segments: 8, smooth: true}
    }

    for e in 0..2 {
      "head_{e}" : ShipWhite {
        Position: {0, 0, e == 0 ? -0.8 : 0.8}
        Rotation: {0, e == 0 ? PI : 0, 0}
        EllipsoidShell: {
          radius: {0.3, 0.3, 0.14},
          longitude_start: 0,
          longitude_end: PI,
          latitude_start: 0 - HALF_PI,
          latitude_end: HALF_PI,
          segments: 3,
          rings: 4
        }
      }
    }

    for i in 0..7 {
      "fin_{i}" : ShipCopper {
        Position: {0, 0, -0.6 + i * 0.2}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: 0.34, length: 0.03, segments: 8, smooth: true}
      }
    }

    band : ShipOrange {
      Position: {0, 0, 0.72}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: 0.31, length: 0.08, segments: 8, smooth: true}
    }

    for e in 0..2 {
      "saddle_{e}" : ShipTrim {
        Position: {0, -0.62, e == 0 ? -0.55 : 0.55}
        Box: {0.4, 0.66, 0.12}
      }
    }
  }

  template LifePlantStack {
    prop power: f32 = 1

    Position: {-1.1, 0.22, 0.6}
    skid : ShipHullDark { Position: {0, 0.05, 0}; Box: {0.95, 0.1, 1.5} }

    for e in 0..2 {
      "end_{e}" : ShipTrim { Position: {0, 0.62, e == 0 ? -0.66 : 0.66}; Box: {0.92, 1.0, 0.1} }
    }

    for i in 0..9 {
      if i % 2 == 0 {
        "cell_{i}" : ShipSteel { Position: {0, 0.6, -0.52 + i * 0.13}; Box: {0.82, 0.86, 0.08} }
      } else {
        "cell_{i}" : ShipTeal { Position: {0, 0.6, -0.52 + i * 0.13}; Box: {0.78, 0.82, 0.06} }
      }
    }

    for i in 0..4 {
      const rx = i % 2 == 0 ? -0.38 : 0.38
      const ry = i < 2 ? 0.22 : 1.0
      "rod_{i}" : ShipChrome {
        Position: {rx, ry, 0}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: 0.025, length: 1.46, segments: 4, smooth: true}
      }
    }

    bus_a : ShipCopper { Position: {-0.2, 1.14, 0}; Box: {0.08, 0.04, 1.4} }
    bus_b : ShipCopper { Position: {0.2, 1.14, 0}; Box: {0.08, 0.04, 1.4} }
    led : PowerLamp {
      Position: {0.47, 0.9, -0.66}
      Box: {0.02, 0.05, 0.08}
      Emissive: {strength: 4 * power, color: {90, 255, 110}}
    }
  }

  template LifePlantColumn {
    Position: {1.32, 0.22, -1.3}
    skirt : ShipTrim {
      Position: {0, 0.12, 0}
      Cylinder: {radius: 0.26, length: 0.24, segments: 6, smooth: true}
    }

    body : ShipSteel {
      Position: {0, 1.18, 0}
      Cylinder: {radius: 0.28, length: 1.92, segments: 6, smooth: true}
    }

    cap : ShipSteel {
      Position: {0, 2.14, 0}
      HemiSphere: {radius: 0.28, segments: 4, smooth: true}
    }

    for i in 0..7 {
      "tray_{i}" : ShipTrim {
        Position: {0, 0.45 + i * 0.27, 0}
        Torus: {radius: 0.29, tube: 0.022, segments: 8, rings: 3, smooth: true}
      }
    }

    for s in 0..2 {
      "rail_{s}" : ShipYellow {
        Position: {s == 0 ? -0.12 : 0.12, 1.2, 0.36}
        Box: {0.025, 2.0, 0.025}
      }
    }

    for i in 0..10 {
      "rung_{i}" : ShipYellow { Position: {0, 0.3 + i * 0.2, 0.36}; Box: {0.24, 0.02, 0.02} }
    }

    sight : ShipAlgae { Position: {-0.285, 1.2, 0}; Box: {0.02, 1.2, 0.06} }
  }

  template LifePlantTank {
    prop power: f32 = 1

    Position: {1.08, 0, -0.1}
    ball : ShipWhite { Position: {0, 1.0, 0}; Sphere: {radius: 0.52, segments: 6, smooth: true} }
    belt : ShipTeal {
      Position: {0, 1.0, 0}
      Torus: {radius: 0.52, tube: 0.03, segments: 8, rings: 3, smooth: true}
    }

    for i in 0..4 {
      const a = i * HALF_PI + 0.785
      "leg_{i}" : ShipSteel {
        Position: {cos(a) * 0.38, 0.58, sin(a) * 0.38}
        Cylinder: {radius: 0.04, length: 0.72, segments: 4, smooth: true}
      }
    }

    gauge : PowerLamp {
      Position: {0, 1.0, 0.53}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: 0.09, length: 0.02, segments: 4, smooth: true}
      Emissive: {strength: 4 * power, color: {255, 160, 50}}
    }
  }

  template LifePlantPump {
    prop power: f32 = 1

    Position: {0.1, 0.22, -0.5}
    body : ShipTeal {
      Position: {0, 0.22, 0}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: 0.18, length: 0.42, segments: 6, smooth: true}
    }

    motor : ShipTrim {
      Position: {0, 0.22, 0.36}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: 0.15, length: 0.34, segments: 6, smooth: true}
    }

    skid : ShipHullDark { Position: {0, 0.03, 0.12}; Box: {0.36, 0.06, 0.9} }
    led : PowerLamp {
      Position: {0, 0.4, 0.36}
      Box: {0.12, 0.03, 0.12}
      Emissive: {strength: 4 * power, color: {90, 255, 110}}
    }
  }

  template LifePlantCabinet {
    prop power: f32 = 1

    Position: {-0.3, 0.22, 1.55}
    body : ShipWhite { Position: {0, 0.6, 0}; RoundedBox: {0.6, 1.2, 0.36, 0.04, segments: 2} }
    screen : PowerScreen {
      Position: {0, 0.86, 0.185}
      Box: {0.44, 0.3, 0.01}
      Emissive: {strength: 1.8 * power, color: {90, 210, 255}}
    }

    for i in 0..3 {
      "led_{i}" : PowerLamp {
        Position: {-0.15 + i * 0.15, 0.55, 0.185}
        Box: {0.06, 0.03, 0.01}
        Emissive: {strength: 4 * lit_share(power, i, 3), color: {90, 255, 110}}
      }
    }

    conduit : ShipTrim {
      Position: {0, 1.82, 0}
      Cylinder: {radius: 0.04, length: 1.24, segments: 4, smooth: true}
    }
  }

  template LifePlant {
    prop pz: bool = true
    prop nz: bool = true
    prop roof: bool = false
    prop seed: i32 = 0
    prop power: f32 = 1

    const tag_glow: Emissive = match power > 0 {
      true: {4 * power, {90, 255, 110}}
      _: {0.5, {255, 50, 30}}
    }

    RackFrame frame(pz: pz, nz: nz)
    deck : ShipHullDark { Position: {0, 0.19, 0}; Box: {3.56, 0.06, 3.56} }

    for i in 0..9 {
      "grate_{i}" : ShipRecess { Position: {0, 0.225, -1.6 + i * 0.4}; Box: {3.4, 0.012, 0.04} }
    }

    walk : ShipHazard { Position: {0.32, 0.228, 0}; Box: {0.08, 0.01, 3.56} }

    if roof {
      lid : ShipHullDark { Position: {0, CH - 0.05, 0}; Box: {3.56, 0.08, 3.56} }
    }

    for s in 0..2 {
      ReactorVessel "bed_{s}"(h: 1.6, r: 0.34) { Position: {s == 0 ? -1.38 : -0.62, 0.22, -1.3} }
      PlantPipe "bed_up_{s}"(len: 0.18, r: 0.06) { Position: {s == 0 ? -1.38 : -0.62, 2.46, -1.3} }
      PlantElbow "bed_knee_{s}"(r: 0.06) { Position: {s == 0 ? -1.38 : -0.62, 2.55, -1.3} }
    }

    PlantPipe bed_link(len: 1.38, r: 0.06) {
      Position: {-0.69, 2.55, -1.3}
      Rotation: {0, 0, HALF_PI}
    }

    bed_valve : ShipRed {
      Position: {-1.0, 2.55, -1.18}
      Rotation: {HALF_PI, 0, 0}
      Torus: {radius: 0.11, tube: 0.02, segments: 6, rings: 3, smooth: true}
    }

    bed_valve_body : ShipSteel { Position: {-1.0, 2.55, -1.3}; Box: {0.16, 0.16, 0.2} }

    LifePlantSabatier sabatier()

    PlantPipe sab_out(len: 0.72, r: 0.06) {
      Position: {-0.64, 2.18, 0.6}
      Rotation: {0, 0, HALF_PI}
    }

    PlantElbow sab_knee(r: 0.06) { Position: {-0.28, 2.18, 0.6} }
    PlantPipe sab_up(len: 0.22, r: 0.06) { Position: {-0.28, 2.29, 0.6} }

    LifePlantStack stack(power: power)

    PlantPipe o2_out(len: 0.36, r: 0.05) {
      Position: {-0.47, 0.82, -0.2}
      Rotation: {0, 0, HALF_PI}
    }

    PlantElbow o2_knee(r: 0.05) { Position: {-0.28, 0.82, -0.2} }
    PlantPipe o2_up(len: 1.56, r: 0.05) { Position: {-0.28, 1.6, -0.2} }
    PlantElbow o2_top(r: 0.05) { Position: {-0.28, 2.4, -0.2} }

    LifePlantColumn column()

    PlantPipe col_out(len: 0.74, r: 0.06) { Position: {0.67, 2.2, -1.3}; Rotation: {0, 0, HALF_PI} }
    PlantElbow col_knee(r: 0.06) { Position: {0.3, 2.2, -1.3} }
    PlantPipe col_up(len: 0.2, r: 0.06) { Position: {0.3, 2.3, -1.3} }

    LifePlantTank tank(power: power)

    PlantPipe tank_up(len: 0.48, r: 0.055) { Position: {1.08, 1.76, -0.1} }
    PlantElbow tank_knee(r: 0.055) { Position: {1.08, 2.0, -0.1} }
    PlantPipe tank_over(len: 0.78, r: 0.055) {
      Position: {0.69, 2.0, -0.1}
      Rotation: {0, 0, HALF_PI}
    }

    PlantElbow tank_joint(r: 0.055) { Position: {0.3, 2.0, -0.1} }
    PlantPipe tank_rise(len: 0.4, r: 0.055) { Position: {0.3, 2.2, -0.1} }
    tank_valve : ShipRed {
      Position: {0.69, 2.0, 0.02}
      Rotation: {HALF_PI, 0, 0}
      Torus: {radius: 0.1, tube: 0.02, segments: 6, rings: 3, smooth: true}
    }

    for i in 0..4 {
      const tx = 0.62 + i * 0.36
      "algae_{i}" {
        Position: {tx, 0.22, 1.42}
        fluid : PowerLamp {
          Position: {0, 1.05, 0}
          Cylinder: {radius: 0.1, length: 1.7, segments: 6, smooth: true}
          Rgb: {70, 200, 110}
          PbrMaterial: {roughness: 0.25}
          Emissive: {strength: 1.3 * lit_share(power, i, 4), color: {90, 255, 140}}
        }

        tube : ShipGlass {
          Position: {0, 1.05, 0}
          Cylinder: {radius: 0.13, length: 1.8, segments: 6, smooth: true}
        }

        cap_a : ShipTrim {
          Position: {0, 0.13, 0}
          Cylinder: {radius: 0.15, length: 0.08, segments: 6, smooth: true}
        }

        cap_b : ShipTrim {
          Position: {0, 1.97, 0}
          Cylinder: {radius: 0.15, length: 0.08, segments: 6, smooth: true}
        }
      }
    }

    PlantPipe algae_low(len: 1.4, r: 0.06) {
      Position: {1.16, 0.32, 1.42}
      Rotation: {0, 0, HALF_PI}
    }

    PlantPipe algae_high(len: 1.5, r: 0.06) {
      Position: {1.11, 2.22, 1.42}
      Rotation: {0, 0, HALF_PI}
    }

    PlantElbow algae_knee(r: 0.06) { Position: {0.3, 2.22, 1.42} }
    PlantPipe algae_rise(len: 0.18, r: 0.06) { Position: {0.3, 2.31, 1.42} }
    glow : PowerLight {
      Position: {1.1, 1.3, 1.0}
      PointLight: {intensity: 2.5 * power, range: 2.6}
      Rgb: {110, 255, 150}
    }

    PlantPipe header_a(len: 4, r: 0.09, copper: true) {
      Position: {0, 2.55, 0}
      Rotation: {HALF_PI, 0, 0}
    }

    PlantPipe header_b(len: 4, r: 0.07) { Position: {0.3, 2.4, 0}; Rotation: {HALF_PI, 0, 0} }
    header_c : ShipTeal {
      Position: {-0.28, 2.4, 0}
      Rotation: {HALF_PI, 0, 0}
      Cylinder: {radius: 0.06, length: 4, segments: 4, smooth: true}
    }

    PlantPipe low_line(len: 4, r: 0.07, copper: true) {
      Position: {1.68, 0.4, 0}
      Rotation: {HALF_PI, 0, 0}
    }

    for i in 0..3 {
      "hanger_{i}" : ShipTrim { Position: {0.01, 2.66, -1.3 + i * 1.3}; Box: {0.7, 0.04, 0.06} }
      "hanger_post_{i}" : ShipTrim {
        Position: {0.01, 2.7, -1.3 + i * 1.3}
        Box: {0.04, 0.12, 0.04}
      }
    }

    for s in 0..2 {
      const sx = s == 0 ? -1.6 : 1.6
      "tray_{s}" : ShipHullDark { Position: {sx, 2.7, 0}; Box: {0.3, 0.03, 4} }
      "cable_a_{s}" : ShipRed {
        Position: {sx - 0.08, 2.74, 0}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: 0.03, length: 4, segments: 4, smooth: true}
      }

      "cable_b_{s}" : ShipYellow {
        Position: {sx, 2.74, 0}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: 0.03, length: 4, segments: 4, smooth: true}
      }

      "cable_c_{s}" : ShipTeal {
        Position: {sx + 0.08, 2.74, 0}
        Rotation: {HALF_PI, 0, 0}
        Cylinder: {radius: 0.03, length: 4, segments: 4, smooth: true}
      }
    }

    LifePlantPump pump(power: power)

    PlantPipe pump_up(len: 2.0, r: 0.07, copper: true) { Position: {0.1, 1.48, -0.72} }
    PlantElbow pump_top(r: 0.07, copper: true) { Position: {0.1, 2.5, -0.72} }

    LifePlantCabinet cabinet(power: power)

    tag : PowerLamp { Position: {-1.89, 2.3, 0}; Box: {0.04, 0.05, 0.6}; Emissive: tag_glow }
    tag_b : PowerLamp { Position: {1.89, 2.3, 0}; Box: {0.04, 0.05, 0.6}; Emissive: tag_glow }
  }
}

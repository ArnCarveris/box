using flecs.script
using flecs.script.math
using state

// The state of the shipyard editor: the rig being built, its faults and the tool, deck and cell
// that the editor works on.
state {
  export const T_REMOVE: i32 = 18

  export const OP_CANCEL: i32 = 100
  export const OP_DECK: i32 = 110
  export const OP_DECK_UP: i32 = 120
  export const OP_DECK_DOWN: i32 = 121
  export const OP_FRIGATE: i32 = 130
  export const OP_SCOUT: i32 = 131
  export const OP_CLEAR: i32 = 132
  export const OP_MINER: i32 = 133
  export const OP_RIGS: i32 = 140
  export const OP_LINERS: i32 = 141
  export const OP_PASSENGER: i32 = 150
  export const OP_FREIGHTER: i32 = 151
  export const OP_TENDER: i32 = 152
  export const OP_BATTLESHIP: i32 = 153
  export const OP_SHOW_UI: i32 = 160
  export const OP_SHOW_GANTRY: i32 = 161

  event Click(cell: i32)
  event Built(cell: i32)
  event Request(op: i32)

  export mut grid: RigGrid = {}
  export mut status: i32[1080] = {}
  export mut counts: i32[18] = {}
  export mut modules: i32 = 0
  export mut problems: i32 = 0
  export mut air: bool[1080] = {}
  export mut placed: RigGrid = {}
  export mut stamp: i32 = 0
  export mut yard_design: RigDesign = {}

  export mut liner: bool = false
  export mut show_ui: bool = true
  export mut show_gantry: bool = true
  export mut span: i32 = 0
  export mut layout_rev: i32 = 0

  export mut tool: i32 = 0
  export mut deck: i32 = 2
  export mut hover: i32 = -1

  fn rule_code(g: RigGrid, shape: RigGrid, x: i32, y: i32, z: i32, k: i32) -> i32 {
    const n = near_in(g, x, y, z)
    !touches_any(n) ? 0 :
    piloted(k) && n.nz == 0 ? 3 :
    piloted(k) && !clear_ahead(g, x, y, z) ? 4 :
    k == K_ENGINE && n.pz == 0 ? 5 :
    k == K_ENGINE && !clear_behind(g, x, y, z) ? 6 :
    k == K_WEAPON && mount_side(n) == 0 ? 7 :
    k == K_FUEL && !touches(n, K_ENGINE) && !touches(n, K_FUEL) ? 9 :
    k == K_POWER && (touches(n, K_HAB) || touches(n, K_COCKPIT)) ? 10 :
    k == K_BIOME && n.py != 0 ? 18 :
    k == K_OBS && !open_side(n) ? 20 :
    k == K_DOCK && dock_side(n) == 0 ? 21 :
    shaped(k) && shape[cell_at(x, y, z)] == 0 ? 22 :
    k == K_RADIATOR && cool_side(n) == 0 ? 23 :
    k == K_DRILL && drill_side(n) == 0 ? 24 :
    k == K_BUILDER && mount_side(n) == 0 ? 25 :
    k == K_DATA && !touches(n, K_RADIATOR) ? 26 :
    0
  }

  fn validate() {
    mut st: i32[1080] = {}
    mut aired: bool[1080] = {}
    mut queue: i32[1080] = {}
    mut tally: i32[18] = {}
    mut front: i32 = GZ
    mut back: i32 = -1
    mut total: i32 = 0

    for i in 0..CELLS {
      const k = grid[i]

      if k != 0 {
        total += 1
        tally[k] += 1
        front = min(front, cell_z(i))
        back = max(back, cell_z(i))
      }
    }

    mut head: i32 = 0
    mut tail: i32 = 0

    for i in 0..CELLS {
      if grid[i] == K_LIFE || grid[i] == K_OBS {
        aired[i] = true
        queue[tail] = i
        tail += 1
      }
    }

    while head < tail {
      const c = queue[head]
      head += 1
      const x = cell_x(c)
      const y = cell_y(c)
      const z = cell_z(c)

      if x > 0 && crewed(grid[c - 1]) && !aired[c - 1] {
        aired[c - 1] = true
        queue[tail] = c - 1
        tail += 1
      }

      if x < GX - 1 && crewed(grid[c + 1]) && !aired[c + 1] {
        aired[c + 1] = true
        queue[tail] = c + 1
        tail += 1
      }

      if z > 0 && crewed(grid[c - GX]) && !aired[c - GX] {
        aired[c - GX] = true
        queue[tail] = c - GX
        tail += 1
      }

      if z < GZ - 1 && crewed(grid[c + GX]) && !aired[c + GX] {
        aired[c + GX] = true
        queue[tail] = c + GX
        tail += 1
      }

      if y > 0 && crewed(grid[c - LAYER]) && !aired[c - LAYER] {
        aired[c - LAYER] = true
        queue[tail] = c - LAYER
        tail += 1
      }

      if y < GY - 1 && crewed(grid[c + LAYER]) && !aired[c + LAYER] {
        aired[c + LAYER] = true
        queue[tail] = c + LAYER
        tail += 1
      }
    }

    const d = rig_design(grid, placed)

    mut bad: i32 = 0

    for i in 0..CELLS {
      const k = grid[i]

      if k != 0 {
        const own = rule_code(grid, d.shape, cell_x(i), cell_y(i), cell_z(i), k)

        if own != 0 {
          st[i] = own
        } else if k == K_HAB && !aired[i] &&
          touches_any(near_in(grid, cell_x(i), cell_y(i), cell_z(i))) {
          st[i] = 17
        }

        if st[i] != 0 {
          bad += 1
        }
      }
    }

    yard_design = d
    status = st
    air = aired
    counts = tally
    modules = total
    problems = bad
    span = max(back - front + 1, 0)
    layout_rev += 1
  }
}

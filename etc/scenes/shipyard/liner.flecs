using flecs.script
using flecs.script.math
using state

// The liner that the shipyard editor works on, its lane, cursor and faults, and the rules it checks.
state {
  event SlotClick(slot: i32)

  // Height of the spine axis of the liner above the yard, in the units of the segments (10 m)
  export const AXIS_Y: f32 = 6

  export mut lane: i32 = 0
  export mut lhover: i32 = -1
  export mut lgrid: LinerDesign = {}
  export mut lstatus: i32[90] = {}
  export mut lcounts: i32[21] = {}
  export mut lmodules: i32 = 0
  export mut lproblems: i32 = 0
  export mut lspan: i32 = 0
  export mut lloaded: bool = false

  fn lc(k: i32) -> i32 { lcounts[clamp(k - L_BASE, 0, LKINDS - 1)] }

  fn outriggers_at(z: i32) -> i32 {
    (lkind(lgrid, 1, z) != 0 ? 1 : 0) + (lkind(lgrid, 2, z) != 0 ? 1 : 0) + (lkind(lgrid, 3, z) != 0 ? 1 : 0) + (lkind(lgrid, 4, z) != 0 ? 1 : 0)
  }

  fn trusses_at(z: i32) -> i32 {
    (lkind(lgrid, 1, z) == L_TRUSS ? 1 : 0) + (lkind(lgrid, 2, z) == L_TRUSS ? 1 : 0) + (lkind(lgrid, 3, z) == L_TRUSS ? 1 : 0) + (lkind(lgrid, 4, z) == L_TRUSS ? 1 : 0)
  }

  fn open_ahead(l: i32, z: i32) -> bool {
    match z >= SLOTS - 1 {
      true: true
      _: lkind(lgrid, l, z + 1) == 0 && open_ahead(l, z + 1)
    }
  }

  fn open_behind(l: i32, z: i32) -> bool {
    match z <= 0 {
      true: true
      _: lkind(lgrid, l, z - 1) == 0 && open_behind(l, z - 1)
    }
  }

  fn lrule(l: i32, z: i32, k: i32) -> i32 {
    l != 0 && core_only(k) ? 1 :
    k == L_BRIDGE && !open_ahead(l, z) ? 2 :
    k == L_DRIVE && !open_behind(l, z) ? 3 :
    ringed(k) && outriggers_at(z) > 0 ? 4 :
    k == L_YOKE && trusses_at(z) == 0 ? 5 :
    housed(k) && (lkind(lgrid, l, z - 1) == L_REACTOR || lkind(lgrid, l, z + 1) == L_REACTOR) ? 6 :
    k == L_HANGAR && l == 0 && lkind(lgrid, LANE_VENTRAL, z) != 0 ? 7 :
    k == L_RAILGUN && !open_ahead(l, z) ? 10 :
    0
  }

  fn rule_text(code: i32) -> string {
    match code {
      1: "Rings and yokes sit on the core"
      2: "A bridge needs open space ahead"
      3: "A drive needs open space behind"
      4: "A ring needs the outriggers clear beside it"
      5: "A yoke needs an outrigger truss to hold"
      6: "Living space too close to a reactor"
      7: "The hangar opens onto the ventral spine"
      8: "Cut off from the rest of the core"
      9: "This outrigger has no yoke to the core"
      10: "A railgun needs a clear line of fire ahead"
      _: ""
    }
  }

  fn lvalidate() {
    mut st: i32[90] = {}
    mut tally: i32[21] = {}
    mut front: i32 = SLOTS
    mut back: i32 = -1
    mut total: i32 = 0

    for i in 0..LCELLS {
      const k = lgrid[i]
      if k != 0 {
        total += 1
        tally[clamp(k - L_BASE, 0, LKINDS - 1)] += 1
        front = min(front, slot_of(i))
        back = max(back, slot_of(i))
        st[i] = lrule(lane_of(i), slot_of(i), k)
      }
    }

    mut run: i32 = 0
    mut best: i32 = 0
    mut best_end: i32 = 0
    for z in 0..SLOTS + 1 {
      if lkind(lgrid, 0, z) != 0 {
        run += 1
      } else {
        if run > best {
          best = run
          best_end = z
        }
        run = 0
      }
    }
    const best_start = best_end - best

    for z in 0..SLOTS {
      if lgrid[z] != 0 && st[z] == 0 && (z < best_start || z >= best_end) {
        st[z] = 8
      }
    }

    for l in 1..LANES {
      mut start: i32 = -1
      for z in 0..SLOTS + 1 {
        const on = lkind(lgrid, l, z) != 0
        if on && start < 0 {
          start = z
        }
        if !on && start >= 0 {
          mut tied = false
          for q in start..z {
            if lkind(lgrid, 0, q) == L_YOKE && lkind(lgrid, l, q) == L_TRUSS && q >= best_start && q < best_end {
              tied = true
            }
          }
          if !tied {
            for q in start..z {
              if st[lcell(l, q)] == 0 {
                st[lcell(l, q)] = 9
              }
            }
          }
          start = -1
        }
      }
    }

    mut bad: i32 = 0
    for i in 0..LCELLS {
      if st[i] != 0 {
        bad += 1
      }
    }

    lstatus = st
    lcounts = tally
    lmodules = total
    lproblems = bad
    lspan = max(back - front + 1, 0)
    layout_rev += 1
  }

  fn load_liner(op: i32) {
    const none: LinerDesign = {}
    lgrid = op == OP_PASSENGER ? passenger_design : op == OP_FREIGHTER ? freighter_design : op == OP_TENDER ? tender_design : op == OP_BATTLESHIP ? battleship_design : none
    lvalidate()
  }

  fn lkind_mass(k: i32) -> f32 {
    match k {
      40: 18; 41: 8; 42: 10; 43: 30; 44: 34; 45: 26; 46: 6; 47: 34; 48: 24
      49: 18; 50: 14; 51: 12; 52: 22; 53: 16; 54: 3; 55: 8; 56: 20; 57: 18; 58: 32; 59: 16; 60: 20
      _: 0
    }
  }

  fn lkind_power(k: i32) -> f32 {
    match k {
      40: 2; 41: 4; 42: 1; 43: 6; 44: 4; 47: 30; 48: 10; 49: 0.2; 50: 0.2; 51: 2; 52: 8; 53: 6; 57: 6; 58: 2; 59: 15; 60: 20
      _: 0
    }
  }

  fn liner_mass() -> f32 {
    mut m: f32 = 0
    for k in L_BASE..L_END {
      m += lc(k) * lkind_mass(k)
    }
    m
  }

  fn liner_power() -> f32 {
    mut w: f32 = 0
    for k in L_BASE..L_END {
      w += lc(k) * lkind_power(k)
    }
    w
  }
}

using flecs.script
using flecs.script.math
using box.input
using state

state {
  actions {
    Tool1 { Action: {description: "Pick the cockpit"}; Binding: {key: Num1} }
    Tool2 { Action: {description: "Pick the habitat"}; Binding: {key: Num2} }
    Tool3 { Action: {description: "Pick life support"}; Binding: {key: Num3} }
    Tool4 { Action: {description: "Pick the power plant"}; Binding: {key: Num4} }
    Tool5 { Action: {description: "Pick the cargo bay"}; Binding: {key: Num5} }
    Tool6 { Action: {description: "Pick the fuel tank"}; Binding: {key: Num6} }
    Tool7 { Action: {description: "Pick weapons"}; Binding: {key: Num7} }
    Tool8 { Action: {description: "Pick the engine"}; Binding: {key: Num8} }
    Tool9 { Action: {description: "Pick the biome"}; Binding: {key: Num9} }
    Tool10 { Action: {description: "Pick the observation deck"}; Binding: {key: Num0} }
    Tool11 { Action: {description: "Pick the docking port"}; Binding: {key: P} }
    Tool12 { Action: {description: "Pick the hull fairing"}; Binding: {key: H} }
    Tool13 { Action: {description: "Pick the radiator"}; Binding: {key: R} }
    Remove { Action: {description: "Pick the remove tool"}; Binding: {key: X} }
    Cancel { Action: {description: "Put the tool away"}; Binding: {key: Escape} }
    View { Action: {description: "Switch between the exterior and the interior"}; Binding: {key: Tab} }
    DeckUp { Action: {description: "Work on the deck above"}; Binding: {key: PageUp}; alt { Binding: {key: E} } }
    DeckDown { Action: {description: "Work on the deck below"}; Binding: {key: PageDown}; alt { Binding: {key: Q} } }
  }

  proc load(design: i32) {
    mut g: i32[1080] = {}
    mut top: i32 = 0
    for i in 0..PLAN_CELLS {
      const k = design == OP_FRIGATE ? frigate_plan[i] : design == OP_SCOUT ? scout_plan[i] : 0
      if k != 0 {
        const py = (i - i % PLAN_LAYER) / PLAN_LAYER
        g[cell_at(i % PLAN_X + PLAN_OX, py, ((i - i % PLAN_X) / PLAN_X) % PLAN_Z + PLAN_OZ)] = k
        top = max(top, py)
      }
    }
    mut fresh: i32[1080] = {}
    grid = g
    placed = fresh
    deck = top
    validate()
  }
}

assets {
  template HotKey {
    prop action: entity = 0
    prop op: i32 = 0

    async {
      while true {
        await on.pressed(action)
        emit Request(op: op)
      }
    }
  }
}

state {
  hotkeys {
    assets.HotKey k1(action: actions.Tool1, op: K_COCKPIT)
    assets.HotKey k2(action: actions.Tool2, op: K_HAB)
    assets.HotKey k3(action: actions.Tool3, op: K_LIFE)
    assets.HotKey k4(action: actions.Tool4, op: K_POWER)
    assets.HotKey k5(action: actions.Tool5, op: K_CARGO)
    assets.HotKey k6(action: actions.Tool6, op: K_FUEL)
    assets.HotKey k7(action: actions.Tool7, op: K_WEAPON)
    assets.HotKey k8(action: actions.Tool8, op: K_ENGINE)
    assets.HotKey k9(action: actions.Tool9, op: K_BIOME)
    assets.HotKey k10(action: actions.Tool10, op: K_OBS)
    assets.HotKey k11(action: actions.Tool11, op: K_DOCK)
    assets.HotKey k12(action: actions.Tool12, op: K_HULL)
    assets.HotKey k13(action: actions.Tool13, op: K_RADIATOR)
    assets.HotKey kx(action: actions.Remove, op: T_REMOVE)
    assets.HotKey kc(action: actions.Cancel, op: OP_CANCEL)
    assets.HotKey kv(action: actions.View, op: OP_VIEW)
    assets.HotKey ku(action: actions.DeckUp, op: OP_DECK_UP)
    assets.HotKey kd(action: actions.DeckDown, op: OP_DECK_DOWN)
  }
}

async {
  load(OP_FRIGATE)
}

async {
  while true {
    const e = await Click
    const i = e.cell
    const k = grid[i]
    if tool > 0 && tool != T_REMOVE {
      if k != tool {
        const built = tool
        emit Built(cell: i)
        await next_frame()
        grid[i] = built
        stamp += 1
        placed[i] = stamp
        validate()
      }
    } else if tool == T_REMOVE && k != K_EMPTY {
      grid[i] = K_EMPTY
      validate()
    }
  }
}

async {
  while true {
    const e = await Request
    const op = e.op
    if op > 0 && op <= T_REMOVE {
      tool = tool == op ? 0 : op
    } else if op == OP_CANCEL {
      tool = 0
    } else if op == OP_EXTERIOR {
      interior = false
    } else if op == OP_INTERIOR {
      interior = true
    } else if op == OP_VIEW {
      interior = !interior
    } else if op >= OP_DECK && op < OP_DECK + GY {
      hover = -1
      deck = op - OP_DECK
    } else if op == OP_DECK_UP {
      hover = -1
      deck = min(deck + 1, GY - 1)
    } else if op == OP_DECK_DOWN {
      hover = -1
      deck = max(deck - 1, 0)
    } else if op == OP_FRIGATE || op == OP_SCOUT || op == OP_CLEAR {
      load(op)
    }
  }
}

using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.picking
using box.input
using box.spatial
using box.transition
using box.movement
using box.particle
using box.light
using state

assets {
  template CursorEdge {
    prop len: f32 = 4
    prop color: Rgb = {255, 255, 255}

    Box: {len, 0.05, 0.05}
    Rgb: color
    Emissive: {strength: 3, color: color}
    NoShadow
    Ignore
  }

  template CellCursor {
    prop color: Rgb = {255, 255, 255}

    const h = CH
    for i in 0..4 {
      const sx = i % 2 == 0 ? -1 : 1
      const sz = i < 2 ? -1 : 1
      CursorEdge "v_{i}"(len: h, color: color) { Position: {sx * 2, h / 2, sz * 2}; Rotation: {0, 0, HALF_PI} }
    }
    for i in 0..2 {
      const y = i * h
      CursorEdge "xa_{i}"(len: 4, color: color) { Position: {0, y, -2} }
      CursorEdge "xb_{i}"(len: 4, color: color) { Position: {0, y, 2} }
      CursorEdge "za_{i}"(len: 4, color: color) { Position: {-2, y, 0}; Rotation: {0, HALF_PI, 0} }
      CursorEdge "zb_{i}"(len: 4, color: color) { Position: {2, y, 0}; Rotation: {0, HALF_PI, 0} }
    }
  }

  // The editor over cell idx of the rig, whose view in the design is v: picking on the deck
  // being worked on, the build pad, the cursor, the fault warning and the sparks of a build. The
  // Rig instance leaves the modules of that deck out and the cell draws its module itself, so a
  // pick on any part of it reaches the cell. The module is tinted for the tool when hovered,
  // rises after a build, and a ghost of the module of the tool shows in a hovered empty cell.
  template ShipCell {
    prop idx: i32 = 0
    prop v: RigCellView = {}
    mut rising = false
    mut sparking = false

    const y = cell_y(idx)
    const k = grid[idx]
    const shown = y <= deck
    const active = y == deck
    const hovered = hover == idx
    const t = tool
    const placing = t > 0 && t != T_REMOVE
    const swap = placing && k != t
    const fault = status[idx]

    Position: {wx(idx), wy(idx), wz(idx)}

    if active {
      Interactive
      Cursor: {CursorPointer}
    }

    if active && k != 0 {
      const tint: Tint = match t == T_REMOVE {
        true: {255, 70, 50, 150}
        _: match swap { true: {90, 255, 160, 120}; _: {0, 0, 0, 0} }
      }
      RigModule unit(
        idx: idx, k: k, v: v, burning: burning && k == K_ENGINE, lifted: rising,
        tinted: hovered && tint.a > 0, tint: tint
      )
    }

    if active && k == 0 && hovered && placing {
      ghost {
        Opacity: {0.55}
        Tint: {90, 255, 160, 120}
        Ignore
        NoShadow
        ModuleView view(
          k: t, v: rig_ghost_view(yard_design, v, deck, idx, t), y: y, seed: idx, burning: burning
        )
      }
    }

    if shown && k != 0 && fault != 0 {
      warning {
        Position: {0, CH + 0.9, 0}
        AngularVelocity: {0, 1.6, 0}
        Ignore
        NoShadow
        gem : ShipWarning { Position: {0, 0, 0}; Rotation: {0.7854, 0, 0.7854}; Box: {0.45, 0.45, 0.45} }
        glow { Position: {0, 0, 0}; PointLight: {intensity: 3, range: 4}; Rgb: {255, 60, 40} }
      }
    }

    if active && k == 0 && t > 0 {
      pad {
        Position: {0, 0.02, 0}
        Box: {3.9, 0.04, 3.9}
        Rgb: {60, 180, 255}
        Emissive: {strength: hovered ? 0.6 : 0.08, color: {60, 180, 255}}
        Opacity: {hovered ? 0.18 : 0.04}
        NoShadow
      }
    }

    if hovered {
      const color: Rgb = match swap {
        true: {90, 255, 140}
        _: match t == T_REMOVE && k != 0 { true: {255, 110, 60}; _: {140, 220, 255} }
      }
      CellCursor cursor(color: color)
    }

    if sparking {
      sparks {
        Position: {0, 0.2, 0}
        Emitter: {
          max: 200, rate: 220, shape: EmitterBox, extents: {1.8, 0.05, 1.8},
          direction: {0, 1, 0}, spread: 50, speed: {1.5, 5},
          lifetime: {0.25, 0.7}, size: {0.03, 0.08}, opacity: {0.6, 1},
          acceleration: {0, -4, 0}, color: {140, 220, 255}, seed: 30 + idx
        }
        Appearance: {blend: Additive, stretch: 0.06}
        Curves: {opacity: {keys: [{0, 1}, {0.7, 0.8}, {1, 0}]}}
      }
    }

    async {
      while true {
        await on.enter(this)
        hover = idx
      }
    }

    async {
      while true {
        await on.leave(this)
        if hover == idx {
          hover = -1
        }
      }
    }

    async {
      while true {
        const ev = await on.click(this)
        if ev.button == 0 {
          emit Click(cell: idx)
        }
      }
    }

    async {
      while true {
        const e = await Built
        if e.cell == idx {
          rising = true
          sparking = true
          await delay(0.12)
          rising = false
          await delay(0.7)
          sparking = false
        }
      }
    }
  }
}

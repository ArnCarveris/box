include radiator
include turret

using flecs.script
using box.transform
using box.geometry
using box.spatial
using box.material
using box.texture
using box.light

template FrigateShoulder {
  prop side: f32 = 1
  root { AttachmentFrame: {} }
  underwing : RecessMetal {
    Position: {}
    BeveledPrism: {footprint: [{0 * side, 39}, {7 * side, 27}, {28 * side, -42}, {0 * side, -49}], depth: 5, inset: 0.6, bevel: 0.5}
  }
  leading : HullArmor {
    Position: {0, 1.7, 0}
    BeveledPrism: {footprint: [{0 * side, 40}, {6 * side, 28}, {24 * side, -29}, {14 * side, -31}], depth: 4.4, inset: 1.2, bevel: 0.5}
  }
  trailing : HullArmor {
    Position: {0, 2.1, 0}
    BeveledPrism: {footprint: [{1 * side, 18}, {17 * side, -7}, {24 * side, -40}, {1 * side, -46}], depth: 4.2, inset: 0.9, bevel: 0.5}
  }
  tip : RustRed {
    Position: {0, 1.3, 0}
    BeveledPrism: {footprint: [{25 * side, -32}, {29 * side, -42}, {25 * side, -49}, {20 * side, -44}], depth: 4, inset: 0.5, bevel: 0.4}
  }

  for i in 0..7 {
  "brace_{i}" : Titanium { Position: {(8 + i * 1.8) * side, 3, 10 - i * 6}; Rotation: {0, -0.34 * side, 0}; Box: {3.6, 0.4, 0.55} }
  "stripe_{i}" : RustRed { Position: {(6.8 + i * 2.1) * side, 4.05, 15 - i * 6}; Rotation: {0, -0.34 * side, 0}; Box: {2.5, 0.12, 3.8} }
}
  for i in 0..4 {
  "radiator_{i}" { FrigateRadiator: {width: 4.6, length: 7.2}; Position: {(4.8 + i * 3.3) * side, 4.3, -7 - i * 9}; Rotation: {0, -0.32 * side, 0} }
}
  tip_light : IceLight { Position: {27 * side, 3.7, -41}; Box: {0.6, 0.3, 2.1} }
  turret { FrigateTurret: {}; Position: {7 * side, 4.5, -30} }
  for j in 0..12 {
  "access_{j}" : DarkArmor { Position: {2.5 * side, 4.4, -38 + j * 3.4}; Box: {2, 0.12, 2.8} }
  "latch_{j}" : Titanium { Position: {2.8 * side, 4.55, -38 + j * 3.4}; Box: {0.3, 0.1, 0.7} }
}

  for i in 0..6 {
    "feather_bay_{i}" {
      feather : PaleArmor {
        Position: {(7.3 + i * 2.7) * side, 4.25, 4 - i * 7.4}
        Rotation: {0, -0.34 * side, 0}
        BeveledPrism: {footprint: [{-1.7, 3.4}, {1.4, 2.5}, {1.8, -3.3}, {-1.7, -2.4}], depth: 0.35, inset: 0.18, bevel: 0.1}
        fasteners {
          Position: {-1, 0.25, -1.8}
          Array: {axis: Z, count: 3, spacing: 1.6}
          rivet : Titanium { Position: {}; Cylinder: {radius: 0.09, length: 0.14, segments: 6} }
        }
      }
      underside_spar : DarkArmor {
        Position: {(6.2 + i * 2.5) * side, -2.7, 3 - i * 7.2}
        Rotation: {0, -0.34 * side, 0}
        BeveledPrism: {footprint: [{-4, 1}, {4, 1}, {3, -1}, {-3, -1}], depth: 1.1, inset: 0.25, bevel: 0.25}
        web : Titanium { Box: {5.2, 0.18, 0.26}; Align: {target: underside_spar, self: Top, other: Bottom} }
      }
    }
  }
  root_knuckle : DarkArmor {
    Position: {2.2 * side, -0.8, -24}
    BeveledPrism: {footprint: [{-2, 13}, {2, 11}, {2, -12}, {-2, -13}], depth: 7.8, inset: 0.6, bevel: 0.7}
    hinges {
      Array: {axis: Z, count: 4, spacing: 6.1}
      Align: {target: root_knuckle, self: {x: Center, y: Center, z: Center}, other: {x: Center, y: Center, z: Center}}
      barrel : Titanium { Rotation: {0, 0, 1.5707963}; Cylinder: {radius: 1.3, length: 5.1, segments: 12} }
    }
  }
  trailing_service : RecessMetal {
    Position: {11 * side, 4.35, -39}
    Rotation: {0, -0.24 * side, 0}
    Box: {8, 0.16, 3.5}
    cells {
      Array: {axis: X, count: 6, spacing: 1.1}
      Align: {target: trailing_service, self: Bottom, other: Top}
      cell : DarkArmor { Position: {};
        Box: {0.8, 0.35, 2.8}
        cap : Titanium { Box: {0.55, 0.08, 0.28}; Position: {0, 0.215, 0} }
      }
    }
  }
}


using flecs.script
using box.transform
using box.geometry
using box.spatial
using box.material
using box.texture
using box.light

assets {
  template ShipBeam {
    prop ax: f32 = 0
    prop ay: f32 = 0
    prop az: f32 = 0
    prop bx: f32 = 0
    prop by: f32 = 1
    prop bz: f32 = 0
    prop radius: f32 = 0.2
    const dx = bx - ax
    const dy = by - ay
    const dz = bz - az
    const length = math.sqrt(dx * dx + dy * dy + dz * dz)
    Position: {(ax + bx) / 2, (ay + by) / 2, (az + bz) / 2}
    Rotation: {math.acos(dy / length), math.atan2(dx, dz), 0}
    Cylinder: {radius: radius, length: length, segments: 8}
    Rgb: {81, 104, 116}
    PbrMaterial: {metallic: 0.8, roughness: 0.4}
  }
  template HullPanel {
    prop width: f32 = 3
    prop length: f32 = 5
    plate : HullArmor { Position: {}; Box: {width, 0.16, length} }
    latch : Titanium { Position: {width / 2 - 0.24, 0.11, length / 2 - 0.4}; Box: {0.12, 0.06, 0.42} }
    for i in 0..2 {
    "bolt_{i}" : Titanium { Position: {(i - 0.5) * (width - 0.35), 0.11, -length / 2 + 0.2}; Cylinder: {radius: 0.055, length: 0.05, segments: 6} }
  }
  }
}

include catwalk
include dock_equipment
using flecs.script
using box.transform
using box.geometry
using box.spatial
using box.material
using box.texture
using box.light

@tree Parent
template DockModule {
  prop bay: i32 = 0
  for side in 0..2 {
    {
      const x = (side - 0.5) * 39
      for tier in 0..2 {
        {
          chord : DarkArmor { Position: {x, -6 + tier * 13, 0}; BeveledPrism: {footprint: [{-2, -15}, {2, -15}, {2, 15}, {-2, 15}], depth: 2.8, inset: 0.3, bevel: 0.3} }
          flange : Titanium { Position: {x, -4.5 + tier * 10, 0}; Box: {4.5, 0.5, 30} }
        }
      }
      for j in 0..3 {
        {
          strut { ShipBeam: {ax: x, ay: -5, az: -14 + j * 9.3, bx: x, by: 6, bz: -4.7 + j * 9.3, radius: 0.65} }
          reverse { ShipBeam: {ax: x, ay: 6, az: -14 + j * 9.3, bx: x, by: -5, bz: -4.7 + j * 9.3, radius: 0.35} }
          gusset : DockYellow { Position: {x, 6, -14 + j * 9.3}; Box: {4.8, 2, 2.8} }
        }
      }
      walkway { DockCatwalk: {length: 29}; Position: {x, 8.8, 0} }
      for j in 0..10 {
        {
          fastener : Titanium { Position: {x + 2.05, -5.5, -13.5 + j * 3}; Rotation: {0, 0, 1.5707963}; Cylinder: {radius: 0.17, length: 0.2, segments: 6} }
          safety_light : AmberLight { Position: {x, 10.7, -13.5 + j * 3}; Box: {0.3, 0.2, 0.3} }
        }
      }
    }
  }
  for zside in 0..2 {
    {
      crossmember : DarkArmor { Position: {0, 0, (zside - 0.5) * 27}; Box: {41, 9, 2.3} }
      upper : DockYellow { Position: {0, 5.5, (zside - 0.5) * 27}; Box: {42, 2, 2.6} }
      lower : DarkArmor { Position: {0, -5.5, (zside - 0.5) * 27}; Box: {42, 2, 2.6} }
      for k in 0..11 {
        {
          rib : Titanium { Position: {-19 + k * 3.8, 0, (zside - 0.5) * 29.5}; Box: {0.25, 8.4, 0.4} }
          recess : RecessMetal { Position: {-17.5 + k * 3.4, 0, (zside - 0.5) * 29.4}; Box: {2.8, 6.6, 0.1} }
        }
      }
    }
  }
  core : RecessMetal { Position: {}; Box: {27, 7, 24} }
  cap : DarkArmor { Box: {1, 0.8, 1}; Fit: {target: core, axes: XZ, padding: {0.5, 0, 0.5}}; Align: {target: core, self: {y: Min}, other: {y: Max}} }
  deck : DarkArmor { Position: {0, 4.15, 0}; Box: {27, 0.25, 24} }
  for i in 0..5 {
    {
      seam : Titanium { Position: {-12 + i * 6, 4.3, 0}; Box: {0.04, 0.02, 23} }
    }
  }
  for side in 0..2 {
    {
      lane : DockYellow { Position: {(side - 0.5) * 25, 4.32, 0}; Box: {0.16, 0.03, 23} }
      pipe : ServiceTeal { Position: {(side - 0.5) * 32, -2.8, 0}; Rotation: {1.5707963, 0, 0}; Cylinder: {radius: 0.7, length: 30.5, segments: 12} }
      for j in 0..4 {
        {
          coupling : Titanium { Position: {(side - 0.5) * 32, -2.8, -12 + j * 8}; Rotation: {1.5707963, 0, 0}; Tube: {radius: 0.88, thickness: 0.2, length: 0.4, segments: 12} }
        }
      }
    }
  }
  if bay == 0 {
    fuel_markings { Position: {0, 4.34, 0}; Rotation: {-1.5707963, 0, 0}; Quad: {27, 24}; Rgb: {255, 255, 255}; PbrTextures: {albedo: dock_deck_fuel}; PbrMaterial: {roughness: 0.85}; AlphaCutoff: {0.5}; NoShadow }
    tank_a { DockTank: {}; Position: {-6, 4.4, -3} }
    tank_b { DockTank: {}; Position: {2, 4.4, 1} }
    pump { DockPower: {}; Position: {0, 4.7, 9}; Scale: {0.6, 0.6, 0.6} }
    technician { DockCrew: {suit: {180, 206, 210}}; Position: {-8, 4.4, 5} }
  }
  if bay == 1 {
    power_markings { Position: {0, 4.34, 0}; Rotation: {-1.5707963, 0, 0}; Quad: {27, 24}; Rgb: {255, 255, 255}; PbrTextures: {albedo: dock_deck_power}; PbrMaterial: {roughness: 0.85}; AlphaCutoff: {0.5}; NoShadow }
    power { DockPower: {}; Position: {-5, 4.7, -5} }
    power_b { DockPower: {}; Position: {5, 4.7, 5}; Rotation: {0, 3.1415927, 0} }
    spool : RustRed { Position: {5, 6, -6}; Rotation: {1.5707963, 0, 0}; Cylinder: {radius: 1.5, length: 2.5, segments: 16} }
    for end in 0..2 {
      {
        flange : DockYellow { Position: {5, 6, -6 + (end - 0.5) * 2.5}; Rotation: {1.5707963, 0, 0}; Cylinder: {radius: 2, length: 0.2, segments: 16} }
      }
    }
  }
  if bay == 2 {
    cargo_markings { Position: {0, 4.34, 0}; Rotation: {-1.5707963, 0, 0}; Quad: {27, 24}; Rgb: {255, 255, 255}; PbrTextures: {albedo: dock_deck_cargo}; PbrMaterial: {roughness: 0.85}; AlphaCutoff: {0.5}; NoShadow }
    cargo_a { DockCargo: {length: 9}; Position: {-7, 4.4, -4} }
    cargo_b { DockCargo: {length: 6, color: {70, 113, 125}}; Position: {-7, 9, -4} }
    cargo_c { DockCargo: {length: 6, color: {187, 170, 118}}; Position: {0, 4.4, -5} }
    tug { DockTug: {}; Position: {7, 4.4, 6}; Rotation: {0, 0.35, 0} }
    marshal { DockCrew: {}; Position: {3, 4.4, 8}; Rotation: {0, 1.2, 0} }
  }
  if bay == 3 {
    repair_markings { Position: {0, 4.34, 0}; Rotation: {-1.5707963, 0, 0}; Quad: {27, 24}; Rgb: {255, 255, 255}; PbrTextures: {albedo: dock_deck_repair}; PbrMaterial: {roughness: 0.85}; AlphaCutoff: {0.5}; NoShadow }
    bench : Titanium { Position: {-3, 5.6, -4}; Box: {12, 0.4, 5} }
    for side in 0..2 {
      {
        leg : DarkArmor { Position: {-3 + (side - 0.5) * 10, 4.9, -4}; Box: {0.5, 1.4, 4} }
      }
    }
    spare : ReplacementArmor { Position: {-3, 6.4, -4}; Rotation: {0, 0, 1.5707963}; Tube: {radius: 2, thickness: 0.5, length: 7, segments: 16} }
    crate { DockCargo: {length: 4, color: {72, 110, 122}}; Position: {7, 4.4, -6}; Scale: {0.65, 0.65, 0.65} }
    mechanic { DockCrew: {}; Position: {-3, 4.4, 0}; Rotation: {0, 3.1415927, 0} }
    supervisor { DockCrew: {suit: {170, 198, 200}}; Position: {0, 4.4, 2}; Rotation: {0, -2.3, 0} }
  }
  floodbar : DarkArmor { Position: {-15, 10, -8}; Rotation: {0, 0, -0.4}; Box: {1, 5, 8} }
  floodface : WhiteLight { Position: {-15.55, 10.2, -8}; Rotation: {0, 0, -0.4}; Box: {0.15, 3, 6}; Emissive: {strength: 1.2, color: {195, 230, 255}} }
  worklight { Position: {-17, 11, -8}; PointLight: {intensity: 380, range: 40}; Rgb: {176, 215, 245} }
}

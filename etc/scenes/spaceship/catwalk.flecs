
using flecs.script
using box.transform
using box.geometry
using box.spatial
using box.material
using box.texture
using box.light

@tree Parent
template DockCatwalk {
  prop length: f32 = 24
  deck : DarkArmor { Box: {4, 0.4, length} }
  grating { Position: {0, 0.25, -length / 2 + 0.2}; Array: {axis: Z, count: 60, spacing: length / 60}; rung : Titanium { Box: {3.7, 0.1, 0.12} } }
  for side in 0..2 {
    {
      sill : DockYellow { Position: {(side - 0.5) * 4.1, 0.4, 0}; Box: {0.16, 0.3, length} }
      handrail : Titanium { Position: {(side - 0.5) * 4.1, 1.8, 0}; Box: {0.09, 0.09, length} }
      midrail : Titanium { Position: {(side - 0.5) * 4.1, 1.1, 0}; Box: {0.07, 0.07, length} }
      posts { Position: {(side - 0.5) * 4.1, 1, -length / 2}; Array: {axis: Z, count: 13, spacing: length / 12}; upright : Titanium { Box: {0.09, 1.6, 0.09} } }
    }
  }
}

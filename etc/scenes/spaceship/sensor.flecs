    steps { Position: {0, 1, -4.05}; Array: {axis: Y, count: 11, spacing: 0.55}; step : Titanium { Position: {}; Box: {0.8, 0.08, 0.4} } }
    processor : RecessMetal { Position: {0, 5.9, -3.5}; Box: {2.2, 1.3, 0.8} }
    processor_fins { Position: {-0.9, 5.9, -3.95}; Array: {axis: X, count: 7, spacing: 0.3}; fin : Titanium { Position: {}; Box: {0.06, 1.1, 0.22} } }

  }

using flecs.script
using box.transform
using box.geometry
using box.spatial
using box.material
using box.texture
using box.light

assets {
  template FrigateSensor {
    foot : DarkArmor { Position: {}; Box: {3.8, 0.8, 6} }
    spar : HullArmor { Position: {0, 4.6, -1}; BeveledPrism: {footprint: [{-1.5, -3}, {1.5, -3}, {0.6, 2}, {-0.6, 2}], depth: 8.4, inset: 0.3, offset: {0, -2}, bevel: 0.3} }
    array : DarkArmor { Position: {0, 7, -2}; Rotation: {0, 0.3, 0}; Box: {9, 2.2, 0.7}
      for row in 0..3 {
      for col in 0..16 {
      "receiver_{row}_{col}" : Titanium { Position: {-4 + col * 0.53, -0.65 + row * 0.64, 0.4}; Box: {0.4, 0.4, 0.13} }
  }
  }
    }
    antenna : Titanium { Position: {0, 11, -2}; Cylinder: {radius: 0.12, length: 6, segments: 8} }
    beacon : BeaconLight { Position: {0, 14, -2}; Sphere: {radius: 0.22, segments: 8} }
    for i in 0..3 {
    "yard_{i}" : Titanium { Position: {0, 9 + i * 1.3, -2}; Box: {5 - i, 0.12, 0.12} }
  }
    socket : Titanium { Align: {target: foot, self: {y: Min}, other: {y: Max}}; Cylinder: {radius: 1.4, length: 0.45, segments: 12} }
    for side in 0..2 {
      "mast_brace_{side}" : DarkArmor { Position: {(side - 0.5) * 2.8, 2.8, -1.4}; Rotation: {0.26, 0, (side - 0.5) * 0.4}; Box: {0.4, 5.7, 0.5} }
      "cable_{side}" : RustRed { Position: {(side - 0.5) * 1.35, 4.5, -3.1}; Rotation: {0.2, 0, 0}; Cylinder: {radius: 0.09, length: 6.5, segments: 6} }
      "radar_cap_{side}" : HullArmor { Position: {(side - 0.5) * 9.2, 7, -2}; Rotation: {0, 0.3, 0}; Box: {0.3, 2.5, 1} }
      "outrigger_{side}" : Titanium { Position: {(side - 0.5) * 6, 4.6, -1.5}; Rotation: {0, 0, (side - 0.5) * 0.6}; Box: {3.7, 0.22, 0.3} }
      "receiver_pod_{side}" : DarkArmor { Position: {(side - 0.5) * 9, 5.2, -1.5}; BeveledPrism: {footprint: [{-0.45, -0.65}, {0.45, -0.65}, {0.3, 0.65}, {-0.3, 0.65}], depth: 1.4, inset: 0.12, bevel: 0.1} }
      "lens_{side}" : IceLight { Position: {(side - 0.5) * 9, 5.2, -0.84}; Box: {0.4, 0.5, 0.05} }

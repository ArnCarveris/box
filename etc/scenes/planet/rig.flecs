using flecs.script
using flecs.script.math
using box.transform
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using state
using planets
using box.transition

window {
  Surface: {width: 1600, height: 1000, vsync: true}
}

fn star_distance(radius: f32) -> f32 { 18 * radius + 2 }

rig {
  Position: {0, 0, 0}
  Rotation: {0 - orbit_pitch, orbit_yaw, 0}

  // cam_dist is eased in logic.flecs, so the camera needs no transition
  camera {
    Position: {-1.4 * cam_dist / 27, 0, cam_dist}
    Camera: {fov: 16, near_: 0.5, far_: 20000}
  }
}

sun {
  Rotation: {0.3, sun_angle * PI / 180, 0}
  DirectionalLight: {intensity: mode == MODE_STAR ? 0 : 6.5}
  Rgb: {255, 246, 232}
}

view {
  bloom { Bloom: {intensity: 0.22, threshold: 1.1, threshold_softness: 0.5} }
  film { Tonemap: {operator_: TonyMcMapface} }
  edges { Smaa: {} }

  View: {
    camera: rig.camera,
    clear: {enabled: true, color: {2, 3, 6, 255}},
    effects: [{effect: bloom}, {effect: film}, {effect: edges}]
  }
}

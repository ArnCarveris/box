using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.movement
using box.texture
using box.transition
using box.spatial
using box.atmosphere

planets {
  struct Col(r: f32, g: f32, b: f32)

  fn h01(seed: i32, salt: i32) -> f32 {
    const x: f64 = sin(seed * 127.1 + salt * 311.7 + 1.3) * 43758.5453
    x - floor(x)
  }

  fn sat(x: f32) -> f32 { clamp(x, 0, 1) }

  // Inverse of the normal distribution at a fraction, by the logistic approximation: the height
  // in standard deviations below which that fraction of a noise lies
  fn probit(f: f32) -> f32 {
    const q: f32 = clamp(f, 0.02, 0.98)
    log(q / (1 - q)) / 1.702
  }

  fn mixc(a: Col, b: Col, t: f32) -> Col {
    {a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t}
  }

  fn mulc(a: Col, b: Col) -> Col { {a.r * b.r / 255, a.g * b.g / 255, a.b * b.b / 255} }

  fn pal_a(i: i32) -> Col {
    match i {
      0: {66, 62, 62}; 1: {112, 104, 98}; 2: {156, 148, 138}; 3: {194, 188, 180}
      4: {168, 112, 66}; 5: {212, 158, 96}; 6: {190, 124, 76}; 7: {142, 88, 60}
      8: {120, 156, 192}; 9: {176, 202, 224}; 10: {214, 228, 240}; 11: {240, 246, 252}
      12: {34, 24, 24}; 13: {54, 42, 40}; 14: {74, 60, 56}; 15: {98, 86, 80}
      20: {156, 136, 96}; 21: {146, 120, 84}; 22: {128, 112, 96}; 23: {150, 146, 142}
      _: {128, 128, 128}
    }
  }

  fn pal_b(i: i32) -> Col {
    match i {
      0: {92, 60, 48}; 1: {140, 92, 66}; 2: {176, 128, 96}; 3: {204, 172, 148}
      4: {190, 150, 84}; 5: {228, 196, 128}; 6: {204, 160, 96}; 7: {160, 116, 70}
      8: {108, 168, 176}; 9: {168, 214, 216}; 10: {208, 236, 236}; 11: {238, 250, 250}
      12: {30, 28, 36}; 13: {48, 46, 56}; 14: {68, 66, 76}; 15: {92, 90, 100}
      20: {170, 120, 86}; 21: {150, 104, 76}; 22: {120, 100, 92}; 23: {156, 150, 150}
      _: {128, 128, 128}
    }
  }

  fn pal(kind: i32, lvl: i32, v: f32) -> Col {
    mixc(pal_a(kind * 4 + lvl), pal_b(kind * 4 + lvl), v)
  }

  fn terrain(kind: i32, v: f32, e: f32) -> Col {
    const lo: Col = mixc(pal(kind, 0, v), pal(kind, 1, v), sat(e / 0.22))
    const mid: Col = mixc(lo, pal(kind, 2, v), sat((e - 0.22) / 0.33))
    mixc(mid, pal(kind, 3, v), sat((e - 0.55) / 0.4))
  }

  fn veg(vv: f32, e: f32) -> Col {
    const lo: Col = mixc({78, 132, 52}, {44, 124, 96}, vv)
    const mid: Col = mixc({30, 84, 38}, {24, 76, 66}, vv)
    const hi: Col = mixc({96, 104, 56}, {70, 96, 78}, vv)
    mixc(mixc(lo, mid, sat(e * 3.2)), hi, sat((e - 0.34) * 3.5))
  }

  fn land(kind: i32, v: f32, vv: f32, e: f32, bio: f32, hot: f32, wet: f32) -> Col {
    const base: Col = mixc(terrain(kind, v, e), {112, 92, 70}, wet * 0.35 * sat(1 - e * 2))
    const cover: f32 = sat((bio * 0.85 - e) * 4.5 + bio * 0.3) * (bio > 0 ? 1 : 0)
    const green: Col = mixc(veg(vv, e), {158, 146, 78}, sat(hot * 1.2))
    const grown: Col = mixc(base, green, cover * 0.94)
    const parched: Col = mixc(grown, {150, 84, 50}, hot * 0.4)
    mixc(parched, {52, 34, 30}, sat(hot * 2.5 - 1.5) * 0.7)
  }

  // Bare ground of a kind at a palette level, darkened where wet and parched where hot: the
  // keys of the ramp of the ground by altitude
  fn ground(kind: i32, v: f32, lvl: i32, e: f32, hot: f32, wet: f32) -> Col {
    const base: Col = mixc(pal(kind, lvl, v), {112, 92, 70}, wet * 0.35 * sat(1 - e * 2))
    const parched: Col = mixc(base, {150, 84, 50}, hot * 0.4)
    mixc(parched, {52, 34, 30}, sat(hot * 2.5 - 1.5) * 0.7)
  }

  fn sea_col(depth: i32, vs: f32, frozen: f32, hot: f32) -> Col {
    const a: Col = match depth {
      0: {4, 14, 52}; 1: {8, 38, 96}; 2: {12, 60, 122}; _: {26, 96, 140}
    }
    const b: Col = match depth {
      0: {4, 26, 52}; 1: {8, 56, 88}; 2: {14, 84, 108}; _: {36, 122, 136}
    }
    const ice: Col = match depth {
      0: {150, 186, 216}; 1: {176, 206, 228}; 2: {200, 222, 238}; _: {222, 236, 246}
    }
    const w: Col = mixc(mixc(a, b, vs), {70, 96, 84}, hot * 0.5)
    mixc(w, ice, frozen)
  }

  fn gas_col(p: i32, i: i32) -> Col {
    match p * 5 + i {
      0: {214, 186, 148}; 1: {168, 118, 82}; 2: {236, 220, 190}; 3: {142, 92, 66}
      4: {198, 152, 110}
      5: {70, 110, 190}; 6: {40, 66, 150}; 7: {120, 170, 226}; 8: {30, 48, 120}; 9: {86, 136, 206}
      10: {226, 204, 140}; 11: {196, 168, 104}; 12: {240, 228, 180}; 13: {170, 140, 90}
      14: {214, 190, 128}
      15: {104, 176, 168}; 16: {58, 128, 132}; 17: {160, 216, 200}; 18: {40, 96, 110}
      19: {120, 190, 176}
      20: {186, 132, 170}; 21: {120, 78, 140}; 22: {226, 184, 196}; 23: {88, 56, 116}
      24: {170, 112, 160}
      _: {200, 200, 200}
    }
  }

  fn haze(kind: i32) -> Col {
    match kind {
      0: {170, 150, 130}; 1: {232, 160, 96}; 2: {170, 214, 240}; 3: {255, 104, 48}
      4: {190, 200, 220}
      _: {150, 180, 230}
    }
  }

  ring_tex { TexturePath: {path: "etc/scenes/planet/assets/rings.png"} }

  // A planet whose maps are texture graphs on the sphere domain. For a kind and a detail the
  // nodes are fixed: the sliders (atm, water, temp, bio, seed, lights) change their parameters
  // only, so no slider compiles a graph again. A feature that is off keeps its nodes with a zero
  // contribution.
  //
  // One height (s_h) feeds every map of a rocky planet: warped fbm continents, ridged mountain
  // ranges masked to some regions, craters and, for ice and lava, cracked plates. The climate
  // follows from it: a temperature (s_t) from the latitude, the temp prop and the altitude, a
  // moisture (s_m) from the water prop, the distance to the sea (the land mask blurred) and the
  // latitude bands. The land is the ground of the kind by altitude, covered by the vegetation of
  // the biome table (lut, by temperature and moisture), rock on steep ground, sand at the coast
  // and snow where it is cold; the sea is tinted by depth and freezes where it is cold. The
  // clouds (cld) and the bands of a gas giant are animated.
  template Planet {
    prop kind: i32 = 0
    prop seed: i32 = 0
    prop atm: f32 = 0
    prop water: f32 = 0
    prop temp: f32 = 50
    prop bio: f32 = 0
    prop radius: f32 = 1
    prop lights: bool = false
    prop rings: bool = false
    prop detail: i32 = 1
    prop spin: f32 = 0.05
    prop air_scale: f32 = 1

    const qa: i32 = clamp(floor(atm / 5 + 0.5), 0, 20)
    const qw: i32 = clamp(floor(water / 5 + 0.5), 0, 20)
    const qt: i32 = clamp(floor(temp / 5 + 0.5), 0, 20)
    const qb: i32 = clamp(floor(bio / 5 + 0.5), 0, 20)
    const is_gas: bool = kind == 4
    const k: i32 = (kind < 0 || kind > 5) ? 0 : kind
    const a: f32 = qa / 20
    const w: f32 = is_gas ? 0 : qw / 20
    const t: f32 = qt / 20
    const b: f32 = is_gas ? 0 : qb / 20

    const sd: i32 = seed < 0 ? 0 - seed : seed
    const v1: f32 = h01(sd, 1)
    const v2: f32 = h01(sd, 2)
    const v3: f32 = h01(sd, 3)
    const v4: f32 = h01(sd, 4)

    const cold: f32 = sat((0.42 - t) / 0.42)
    const hot: f32 = sat((t - 0.62) / 0.38)
    const frozen: f32 = max(smoothstep(0.2, 0.5, cold), sat(1 - a * 8))
    const shelf: f32 = 0.035 + 0.82 * min(w, 0.25) + 0.575 * clamp(w - 0.25, 0, 0.4)
    const deep: f32 = 0.698 * clamp(w - 0.65, 0, 0.15) + 1.435 * max(w - 0.8, 0)
    const sea: f32 = qw > 0 ? shelf + deep : -0.08
    const damp: f32 = sat(w * 4 + a * 1.2)
    const snow: f32 = max(0.365 + 0.936 * t + (1 - damp) * 0.8 + hot * 1.9, sea + 0.01)
    const span: f32 = max(snow - sea - 0.006, 0.003)
    const top: f32 = max(0.95 - max(sea, 0), 0.2)
    const l2: f32 = sea + 0.006 + span * 0.16
    const c2: Col = land(k, v1, v2, sat((l2 - sea) / top), b, hot, w)
    const s0: Col = sea_col(0, v3, 0, hot)
    const s1: Col = sea_col(1, v3, 0, hot)
    const s2: Col = sea_col(2, v3, 0, hot)
    const s3: Col = sea_col(3, v3, 0, hot)
    const s1f: Col = sea_col(1, v3, frozen, hot)

    const gp: i32 = sd % 5
    const warm: Col = mixc({255, 255, 255}, {255, 196, 150}, hot * 0.5)
    const gtint: Col = mixc(warm, {170, 200, 255}, cold * 0.5)
    const g0: Col = mulc(mixc(gas_col(gp, 0), gas_col((gp + 1) % 5, 0), v2 * 0.35), gtint)
    const g1: Col = mulc(mixc(gas_col(gp, 1), gas_col((gp + 1) % 5, 1), v2 * 0.35), gtint)
    const g2: Col = mulc(mixc(gas_col(gp, 2), gas_col((gp + 1) % 5, 2), v2 * 0.35), gtint)
    const g3: Col = mulc(mixc(gas_col(gp, 3), gas_col((gp + 1) % 5, 3), v2 * 0.35), gtint)
    const g4: Col = mulc(mixc(gas_col(gp, 4), gas_col((gp + 1) % 5, 4), v2 * 0.35), gtint)

    const heat: f32 = sat((t - (k == 3 ? 0.55 : 0.8)) / 0.2) * sat(1 - w * 8)
    const lava_lvl: f32 = heat * (k == 3 ? 0.16 : 0.14)
    const lava_on: bool = !is_gas && detail > 0 && lava_lvl > 0
    const city_on: bool = !is_gas && detail > 0 && lights && !lava_on

    const cover: f32 = is_gas ? 0 : sat(a * (0.3 + 1.25 * w)) * (1 - hot * 0.3)
    const breath: f32 = smoothstep(0.3, 0.8, a) * sat(0.25 + w + b)
    const airc: Col = mixc(mixc(haze(k), {96, 160, 255}, breath), mixc(g2, g1, 0.4), is_gas ? 1 : 0)
    const air_k: f32 = is_gas ? 0.5 : a
    const air_max: f32 = max(max(airc.r, airc.g), max(airc.b, 1))
    const air_on: bool = detail > 0 && air_k > 0.02
    const lift: f32 = 16 * air_scale * (0.7 + 0.6 * air_k)
    const dens: f32 = is_gas ? 1 : 0.1 + 0.9 * a
    const ray_k: f32 = match k { 0: 1.1; 1: 0.3; 2: 1.2; 3: 0.4; 4: 0.25; _: 1 }
    const mie_k: f32 = match k { 0: 2; 1: 28; 2: 22; 3: 44; 4: 6; _: 2 }
    const ray_h: f32 = match k { 0: 8; 1: 9; 2: 5; 3: 11; 4: 9; _: 8 }
    const mie_h: f32 = match k { 0: 1.5; 1: 8; 2: 3; 3: 10; 4: 7; _: 1.5 }
    const mie_g: f32 = match k { 0: 0.75; 1: 0.4; 2: 0.7; 3: 0.4; 4: 0.5; _: 0.75 }
    const dust: Col = mixc({214, 204, 184}, {196, 170, 140}, v1)
    const ringc: Col = mixc(dust, mixc(g2, {255, 255, 255}, 0.4), is_gas ? 0.35 : 0)
    const mist: Col = mixc(mixc(haze(k), {255, 255, 255}, 0.25), {255, 255, 255}, sat(w * 4))
    const pale: f32 = sat(0.9 - snow) * 0.9 + cover * 0.15
    const far: Col = mixc(mixc(c2, s1f, sat(w * 1.3)), {236, 242, 250}, pale)
    const flat: Col = mixc(far, g0, is_gas ? 1 : 0)

    const tw: i32 = detail > 1 ? 1024 : 512
    const seg: i32 = detail > 1 ? 96 : (detail > 0 ? 48 : 20)
    const oct: i32 = detail > 1 ? 7 : 6
    const lean: f32 = 0.1 + v3 * 0.2
    const tilt: f32 = (v4 - 0.5) * 0.5 + (v4 > 0.5 ? 0.12 : -0.12)
    const surf_on: bool = detail > 0 && !is_gas
    const gas_on: bool = detail > 0 && is_gas

    // Height: fbm continents at warped coordinates with unwarped detail, remapped to about 0.5
    // with a standard deviation of 1/6 over the sphere, so the sea level that leaves a fraction w
    // of the surface under water is their quantile. Mountain ranges, craters and cracked plates
    // are added on top
    const f1: f32 = match k {
      0: 1.1 + (sd % 3) * 0.15; 5: 1.1 + (sd % 3) * 0.15; 1: 1.2 + (sd % 2) * 0.2
      _: 1.4 + (sd % 2) * 0.2
    }
    const warp_amt: f32 = 0.8 + v4 * 0.4
    const mtn: f32 = match k { 0: 0.12; 1: 0.16; 2: 0.06; 3: 0.1; _: 0.2 }
    const mtn_lo: f32 = 0.5 + (v2 - 0.5) * 0.06
    const crater: f32 = match k { 0: 0.5; 1: 0.16; 2: 0.06; _: 0 }
    const crack: f32 = match k { 2: 0.03; 3: 0.08; _: 0 }
    const cn: i32 = match k { 2: 90 + sd % 60; 3: 50 + sd % 40; _: 64 }
    const sea_h: f32 = qw > 0 ? 0.5 + probit(w) / 6 : -1
    const base_h: f32 = qw > 0 ? sea_h : 0.15
    const top_h: f32 = max(0.92 + mtn * 0.6, base_h + 0.25)
    const nstr: f32 = match k { 2: 2.5; 3: 3; _: 3.5 }
    const rock_lo: f32 = 0.25
    const rock_hi: f32 = 0.5

    // Climate: the temperature at sea level falls from t_eq at the equator by t_lat at the
    // poles and by t_alt at the highest ground, less in a thin air; below sn_t it snows, colder
    // on a dry world. The moisture is wet near the sea, at the equator and around 55 degrees and
    // dry around 30 degrees and inland
    const t_eq: f32 = 0.25 + 0.9 * t
    const t_lat: f32 = 0.6 + 0.15 * damp
    const t_alt: f32 = 0.12 + 0.33 * a
    const freeze: f32 = 0.1 + 0.75 * frozen
    const wet: f32 = sat(w * 1.4 + a * 0.35) * (1 - hot * 0.5)
    const snow_k: f32 = sat(0.25 + w * 4 + a * 0.6)
    const sn_t: f32 = 0.02 + 0.11 * damp
    const sand: f32 = qw > 0 ? 0.45 * (1 - frozen) : 0
    const veg_k: f32 = sat(b * 1.15) * 0.95
    const tl_hi: f32 = 0.2 + 0.55 * b
    const tl_lo: f32 = tl_hi - 0.25
    const gvar: f32 = match k { 0: 0.18; 1: 0.25; 5: 0.15; _: 0.12 }
    const crack_k: f32 = match k { 2: 0.55; 3: 0.8; _: 0 }
    const crack_c: Col = mixc({150, 98, 70}, {26, 12, 10}, k == 3 ? 1 : 0)

    // Colors of the ramps
    const tc0: Col = ground(k, v1, 0, 0, hot, w)
    const tc1: Col = ground(k, v1, 1, 0.22, hot, w)
    const tc2: Col = ground(k, v1, 2, 0.55, hot, w)
    const tc3: Col = ground(k, v1, 3, 0.95, hot, w)
    const rk0: Col = mixc(tc1, {92, 88, 84}, 0.5)
    const rk1: Col = mixc(tc2, {120, 116, 112}, 0.45)
    const gr2: Col = mixc({118, 140, 66}, {96, 136, 80}, v2)
    const fo2: Col = mixc({36, 82, 36}, {30, 74, 52}, v2)

    // Lava fills the lowlands up to lava_h and glows in the cracks of the plates
    const lava_h: f32 = 0.5 + probit(max(heat * (k == 3 ? 0.14 : 0.1), 0.02)) / 6
    const lava_k: f32 = lava_on ? 1 : 0
    const crack_glow: f32 = k == 3 ? 0.7 * heat : 0

    // City lights: towns at the points of cells, lit where the density beats their id
    const city_k: f32 = city_on ? 1 : 0
    const towns: i32 = detail > 1 ? 9000 : 3000

    // Clouds: a fraction cf of the sky has some cloud, thr the threshold of the noise in
    // standard deviations that leaves it
    const cf: f32 = 0.22 + 0.33 * cover
    const thr: f32 = 1.28 * probit(1 - cf)

    // Gas giants: zones and belts from the sine of the latitude, jets that drift the bands
    // back and forth by up to drift degrees over a period of 20 minutes, storm ovals on a
    // fraction of the cells, held between two jets
    const bf: f32 = 13 + v1 * 6
    const drift: f32 = 35 + v2 * 20
    const storm_frac: f32 = 0.12 + v4 * 0.12
    const st0: Col = mixc(g3, {196, 84, 56}, 0.65)
    const st1: Col = mixc(g2, {250, 246, 236}, 0.7)

    if air_on {
      PlanetAtmosphere: {
        sun: sun
        radius: radius
        thickness: max(ray_h, mie_h) * lift * 6
        rayleigh: {scale_height: ray_h * lift, scattering_scale: ray_k * dens / lift}
        mie: {
          scale_height: mie_h * lift, anisotropy: mie_g, scattering_scale: mie_k * dens / lift,
          tint: {airc.r * 255 / air_max, airc.g * 255 / air_max, airc.b * 255 / air_max}
        }
        ozone_scale: 0
      }
    }

    lut {}
    geo {}
    alb {}
    orm {}
    glow {}
    town {}
    cld {}

    if surf_on {
      // Continents
      s_wn { TexNoise: {channels: 3, frequency: 1.3, octaves: 3, seed: sd * 16 + 2} }
      s_wp { TexWarp: {offset: s_wn, amount_value: warp_amt} }
      s_cn { TexNoise: {coords: s_wp, frequency: f1, octaves: 5, seed: sd * 16 + 1} }
      s_dn { TexNoise: {frequency: 12, octaves: oct - 3, seed: sd * 16 + 9} }
      s_dt {
        TexMath: {op: MathRemap, a: s_dn, from_min: 0, from_max: 1, to_min: -0.07, to_max: 0.07}
      }
      s_cd { TexMath: {op: MathAdd, a: s_cn, b: s_dt} }
      s_c {
        TexMath: {op: MathRemap, a: s_cd, from_min: 0.25, from_max: 0.75, to_min: 0, to_max: 1}
      }

      // Mountain ranges: ridged noise in some regions, rising inland from the coast
      s_rn {
        TexNoise: {
          coords: s_wp, frequency: 2.4, octaves: oct - 1, fractal: NoiseRidged, seed: sd * 16 + 3
        }
      }
      s_r {
        TexMath: {op: MathSmoothstep, a: s_rn, b_value: {0.45, 0, 0, 0}, c_value: {1, 0, 0, 0}}
      }
      s_mn { TexNoise: {frequency: 0.9, octaves: 2, seed: sd * 16 + 4} }
      s_mm {
        TexMath: {
          op: MathSmoothstep, a: s_mn, b_value: {mtn_lo, 0, 0, 0}, c_value: {mtn_lo + 0.1, 0, 0, 0}
        }
      }
      s_ml {
        TexMath: {
          op: MathSmoothstep, a: s_c, b_value: {sea_h, 0, 0, 0}, c_value: {sea_h + 0.08, 0, 0, 0}
        }
      }
      s_m0 { TexMath: {op: MathMultiply, a: s_r, b: s_mm} }
      s_m1 { TexMath: {op: MathMultiply, a: s_m0, b: s_ml} }
      s_m2 { TexMath: {op: MathMultiply, a: s_m1, b_value: {mtn, 0, 0, 0}} }

      // Craters of two sizes: bowls with a rim, deeper the wider they are, around the points
      // of cells whose size is random
      s_k1 { TexCells: {count: 60, jitter: 0.9, seed: sd * 16 + 5} }
      s_k1d { TexSplit: {input: s_k1, channel: ChannelR} }
      s_k1z { TexSplit: {input: s_k1, channel: ChannelB} }
      s_k1r {
        TexMath: {op: MathRemap, a: s_k1z, from_min: 0, from_max: 1, to_min: 0.08, to_max: 0.32}
      }
      s_k1n { TexMath: {op: MathDivide, a: s_k1d, b: s_k1r} }
      s_k1p {
        TexCurve: {input: s_k1n, curve: {kind: CurveCatmullRom, keys: [
          {0, -1}, {0.5, -0.85}, {0.85, -0.2}, {1, 0.3}, {1.3, 0.06}, {1.8, 0}, {4, 0}
        ]}}
      }
      s_k1h { TexMath: {op: MathMultiply, a: s_k1p, b: s_k1r} }
      s_k2 { TexCells: {count: 700, jitter: 0.9, seed: sd * 16 + 6} }
      s_k2d { TexSplit: {input: s_k2, channel: ChannelR} }
      s_k2z { TexSplit: {input: s_k2, channel: ChannelB} }
      s_k2r {
        TexMath: {op: MathRemap, a: s_k2z, from_min: 0, from_max: 1, to_min: 0.04, to_max: 0.12}
      }
      s_k2n { TexMath: {op: MathDivide, a: s_k2d, b: s_k2r} }
      s_k2p {
        TexCurve: {input: s_k2n, curve: {kind: CurveCatmullRom, keys: [
          {0, -1}, {0.5, -0.85}, {0.85, -0.2}, {1, 0.3}, {1.3, 0.06}, {1.8, 0}, {4, 0}
        ]}}
      }
      s_k2h { TexMath: {op: MathMultiply, a: s_k2p, b: s_k2r} }
      s_k0 { TexMath: {op: MathAdd, a: s_k1h, b: s_k2h} }
      s_k { TexMath: {op: MathMultiply, a: s_k0, b_value: {crater, 0, 0, 0}} }

      // Cracked plates of ice and lava worlds: 0 on the border of two cells
      s_cl {
        TexCells: {
          coords: s_wp, count: cn, jitter: 1, distance: CellsEdge, edge: 0.25, seed: sd * 16 + 7
        }
      }
      s_clx { TexSplit: {input: s_cl, channel: ChannelR} }
      s_ck {
        TexMath: {op: MathRemap, a: s_clx, from_min: 0, from_max: 1, to_min: 0 - crack, to_max: 0}
      }

      // Height, the relief with flat seas, altitude above the sea, land and slope
      s_h0 { TexMath: {op: MathAdd, a: s_c, b: s_m2} }
      s_h1 { TexMath: {op: MathAdd, a: s_h0, b: s_k} }
      s_h { TexMath: {op: MathAdd, a: s_h1, b: s_ck} }
      s_relief { TexMath: {op: MathMax, a: s_h, b_value: {sea_h, 0, 0, 0}} }
      s_slope { TexSlope: {height: s_relief, strength: nstr} }
      s_alt {
        TexMath: {
          op: MathRemapClamped, a: s_h, from_min: base_h, from_max: top_h, to_min: 0, to_max: 1
        }
      }
      s_land {
        TexMath: {
          op: MathSmoothstep, a: s_h, b_value: {sea_h - 0.002, 0, 0, 0},
          c_value: {sea_h + 0.002, 0, 0, 0}
        }
      }

      // Temperature at sea level (s_t0) from the warped latitude, so the climate zones meander,
      // and with the altitude (s_t)
      s_wy { TexSplit: {input: s_wp, channel: ChannelG} }
      s_ay { TexMath: {op: MathAbs, a: s_wy} }
      s_y2 { TexMath: {op: MathMultiply, a: s_wy, b: s_wy} }
      s_tl {
        TexMath: {
          op: MathRemap, a: s_y2, from_min: 0, from_max: 1, to_min: t_eq, to_max: t_eq - t_lat
        }
      }
      s_jn { TexNoise: {channels: 3, frequency: 2.5, octaves: 3, seed: sd * 16 + 8} }
      s_jt { TexSplit: {input: s_jn, channel: ChannelR} }
      s_jm { TexSplit: {input: s_jn, channel: ChannelG} }
      s_jg { TexSplit: {input: s_jn, channel: ChannelB} }
      s_tj {
        TexMath: {op: MathRemap, a: s_jt, from_min: 0.4, from_max: 0.6, to_min: -0.05, to_max: 0.05}
      }
      s_t0 { TexMath: {op: MathAdd, a: s_tl, b: s_tj} }
      s_ta { TexMath: {op: MathMultiply, a: s_alt, b_value: {t_alt, 0, 0, 0}} }
      s_t { TexMath: {op: MathSubtract, a: s_t0, b: s_ta} }
      s_icem {
        TexMath: {
          op: MathSmoothstep, a: s_t0, b_value: {freeze + 0.03, 0, 0, 0},
          c_value: {freeze - 0.03, 0, 0, 0}
        }
      }

      // Moisture: the land around (s_near) dries the inland, the latitude bands
      s_near { TexBlur: {input: s_land, radius: 24} }
      s_band {
        TexCurve: {input: s_ay, curve: {kind: CurveCatmullRom, keys: [
          {0, 1}, {0.2, 0.85}, {0.42, 0.35}, {0.55, 0.35}, {0.78, 0.8}, {0.9, 0.7}, {1, 0.4}
        ]}}
      }
      s_mc {
        TexMath: {
          op: MathRemapClamped, a: s_near, from_min: 0.35, from_max: 1, to_min: wet,
          to_max: wet * 0.3
        }
      }
      s_mb { TexMath: {op: MathMultiply, a: s_mc, b: s_band} }
      s_mj {
        TexMath: {op: MathRemap, a: s_jm, from_min: 0.4, from_max: 0.6, to_min: -0.1, to_max: 0.1}
      }
      s_m { TexMath: {op: MathAdd, a: s_mb, b: s_mj} }
      s_hab {
        TexCurve: {input: s_t, curve: {keys: [{0, 0}, {0.16, 0}, {0.32, 1}, {0.8, 1}, {1, 0.2}]}}
      }

      // Biome table: the vegetation by temperature (u) and moisture (v), its cover in alpha
      lut {
        l_uv { TexCoords: {} }
        l_t { TexSplit: {input: l_uv, channel: ChannelR} }
        l_m { TexSplit: {input: l_uv, channel: ChannelG} }
        l_dry {
          TexRamp: {input: l_t, keys: [
            {0.1, {128, 122, 96}}
            {0.3, {118, 126, 78}}
            {0.55, {gr2.r, gr2.g, gr2.b}}
            {0.78, {160, 150, 82}}
            {1, {176, 152, 92}}
          ]}
        }
        l_wet {
          TexRamp: {input: l_t, keys: [
            {0.1, {88, 96, 74}}
            {0.25, {40, 64, 48}}
            {0.5, {fo2.r, fo2.g, fo2.b}}
            {0.75, {30, 86, 34}}
            {1, {24, 74, 30}}
          ]}
        }
        l_lush {
          TexMath: {op: MathSmoothstep, a: l_m, b_value: {0.3, 0, 0, 0}, c_value: {0.7, 0, 0, 0}}
        }
        l_veg { TexMath: {op: MathMix, a: l_dry, b: l_wet, c: l_lush} }
        l_hab {
          TexCurve: {
            input: l_t,
            curve: {keys: [{0, 0}, {0.1, 0}, {0.22, 0.6}, {0.3, 1}, {0.85, 1}, {1, 0.6}]}
          }
        }
        l_moist {
          TexMath: {op: MathSmoothstep, a: l_m, b_value: {0.06, 0, 0, 0}, c_value: {0.35, 0, 0, 0}}
        }
        l_cov0 { TexMath: {op: MathMultiply, a: l_hab, b: l_moist} }
        l_cov { TexMath: {op: MathMultiply, a: l_cov0, b_value: {veg_k, 0, 0, 0}} }
        l_cova { TexSplat: {in: l_cov} }
        l_alpha { TexMath: {op: MathMultiply, a: l_cova, b_value: {0, 0, 0, 1}} }
        l_rgb { TexMath: {op: MathMultiply, a: l_veg, b_value: {1, 1, 1, 0}} }
        l_out { TexMath: {op: MathAdd, a: l_rgb, b: l_alpha} }
        TextureGraph: {output: l_out, width: 32, height: 32}
      }

      geo {
        n_normal { TexNormal: {height: s_relief, strength: nstr} }
        TextureGraph: {
          output: n_normal, width: tw, height: tw / 2, domain: DomainSphere, format: GraphLinear
        }
      }

      // Land: the ground of the kind by altitude, varied by a noise, covered by the vegetation
      // of the biome below the treeline, rock on steep ground, sand at the shore and snow where
      // it is cold. Sea: tinted by depth, frozen where it is cold
      alb {
        a_lut { TexLut: {texture: lut, u: s_t, v: s_m} }
        a_cov0 { TexSplit: {input: a_lut, channel: ChannelA} }
        a_tree {
          TexMath: {
            op: MathSmoothstep, a: s_alt, b_value: {tl_hi, 0, 0, 0}, c_value: {tl_lo, 0, 0, 0}
          }
        }
        a_cov { TexMath: {op: MathMultiply, a: a_cov0, b: a_tree} }
        a_gv {
          TexMath: {
            op: MathRemap, a: s_jg, from_min: 0.4, from_max: 0.6, to_min: 0 - gvar, to_max: gvar
          }
        }
        a_gh { TexMath: {op: MathAdd, a: s_alt, b: a_gv} }
        a_ground {
          TexRamp: {input: a_gh, keys: [
            {0, {tc0.r, tc0.g, tc0.b}}
            {0.22, {tc1.r, tc1.g, tc1.b}}
            {0.55, {tc2.r, tc2.g, tc2.b}}
            {0.95, {tc3.r, tc3.g, tc3.b}}
          ]}
        }
        a_land0 { TexMath: {op: MathMix, a: a_ground, b: a_lut, c: a_cov} }
        a_rockm {
          TexMath: {
            op: MathSmoothstep, a: s_slope, b_value: {rock_lo, 0, 0, 0}, c_value: {rock_hi, 0, 0, 0}
          }
        }
        a_rock {
          TexRamp: {input: s_alt, keys: [{0, {rk0.r, rk0.g, rk0.b}}, {1, {rk1.r, rk1.g, rk1.b}}]}
        }
        a_land1 { TexMath: {op: MathMix, a: a_land0, b: a_rock, c: a_rockm} }
        a_shore {
          TexMath: {op: MathSmoothstep, a: s_alt, b_value: {0.025, 0, 0, 0}, c_value: {0, 0, 0, 0}}
        }
        a_beach { TexMath: {op: MathMultiply, a: a_shore, b_value: {sand, 0, 0, 0}} }
        a_sand { TexRamp: {keys: [{0, {212, 196, 150}}]} }
        a_land2 { TexMath: {op: MathMix, a: a_land1, b: a_sand, c: a_beach} }
        a_crk {
          TexMath: {
            op: MathRemapClamped, a: s_clx, from_min: 0, from_max: 0.7, to_min: crack_k, to_max: 0
          }
        }
        a_crc { TexRamp: {keys: [{0, {crack_c.r, crack_c.g, crack_c.b}}]} }
        a_land3 { TexMath: {op: MathMix, a: a_land2, b: a_crc, c: a_crk} }
        a_cold {
          TexMath: {
            op: MathSmoothstep, a: s_t, b_value: {sn_t, 0, 0, 0}, c_value: {sn_t - 0.07, 0, 0, 0}
          }
        }
        a_snowm { TexMath: {op: MathMultiply, a: a_cold, b_value: {snow_k, 0, 0, 0}} }
        a_snow { TexRamp: {keys: [{0, {236, 242, 250}}]} }
        a_land { TexMath: {op: MathMix, a: a_land3, b: a_snow, c: a_snowm} }
        a_shelf {
          TexMath: {
            op: MathRemapClamped, a: s_h, from_min: sea_h, from_max: sea_h - 0.12, to_min: 0,
            to_max: 1
          }
        }
        a_open {
          TexMath: {
            op: MathRemapClamped, a: s_near, from_min: 0.35, from_max: 0, to_min: 0.3, to_max: 1
          }
        }
        a_depth { TexMath: {op: MathMultiply, a: a_shelf, b: a_open} }
        a_water {
          TexRamp: {input: a_depth, keys: [
            {0.02, {s3.r, s3.g, s3.b}}
            {0.12, {s2.r, s2.g, s2.b}}
            {0.4, {s1.r, s1.g, s1.b}}
            {0.9, {s0.r, s0.g, s0.b}}
          ]}
        }
        a_ice { TexRamp: {input: a_depth, keys: [{0, {226, 238, 248}}, {1, {170, 198, 222}}]} }
        a_sea { TexMath: {op: MathMix, a: a_water, b: a_ice, c: s_icem} }
        a_out { TexMath: {op: MathMix, a: a_sea, b: a_land, c: s_land} }
        TextureGraph: {output: a_out, width: tw, height: tw / 2, domain: DomainSphere}
      }

      // Roughness: glossy open sea, rough ice and land
      orm {
        o_sea {
          TexMath: {op: MathRemap, a: s_icem, from_min: 0, from_max: 1, to_min: 0.42, to_max: 0.85}
        }
        o_rough { TexMath: {op: MathMix, a: o_sea, b_value: {1, 0, 0, 0}, c: s_land} }
        o_out { TexCombine: {r_value: 1, g: o_rough, b_value: 0, a_value: 1} }
        TextureGraph: {
          output: o_out, width: tw / 2, height: tw / 4, domain: DomainSphere, format: GraphLinear
        }
      }

      glow {
        e_low {
          TexMath: {
            op: MathRemapClamped, a: s_h, from_min: lava_h - 0.06, from_max: lava_h, to_min: 1,
            to_max: 0
          }
        }
        e_crack {
          TexMath: {
            op: MathRemapClamped, a: s_clx, from_min: 0, from_max: 0.5, to_min: crack_glow,
            to_max: 0
          }
        }
        e_v0 { TexMath: {op: MathMax, a: e_low, b: e_crack} }
        e_v { TexMath: {op: MathMultiply, a: e_v0, b_value: {lava_k, 0, 0, 0}} }
        e_col {
          TexRamp: {input: e_v, keys: [
            {0, {0, 0, 0}}
            {0.04, {36, 4, 0}}
            {0.25, {160, 28, 6}}
            {0.6, {250, 96, 18}}
            {1, {255, 176, 70}}
          ]}
        }
        TextureGraph: {output: e_col, width: tw, height: tw / 2, domain: DomainSphere}
      }

      // City lights: the density is habitable, watered, flat land, thickest near the coast and
      // in clusters. Cities and smaller towns at the points of two cells light up where the
      // density is at least their id, with a faint glow where it is highest
      town {
        w_wet {
          TexMath: {op: MathSmoothstep, a: s_m, b_value: {0.05, 0, 0, 0}, c_value: {0.3, 0, 0, 0}}
        }
        w_coast {
          TexMath: {
            op: MathRemapClamped, a: s_near, from_min: 0.55, from_max: 0.95, to_min: 1,
            to_max: 0.25
          }
        }
        w_flat {
          TexMath: {
            op: MathSmoothstep, a: s_slope, b_value: {rock_hi, 0, 0, 0}, c_value: {rock_lo, 0, 0, 0}
          }
        }
        w_cn { TexNoise: {frequency: 3.5, octaves: 3, seed: sd * 16 + 9} }
        w_cl {
          TexMath: {op: MathSmoothstep, a: w_cn, b_value: {0.46, 0, 0, 0}, c_value: {0.62, 0, 0, 0}}
        }
        w_d0 { TexMath: {op: MathMultiply, a: s_land, b: s_hab} }
        w_d1 { TexMath: {op: MathMultiply, a: w_d0, b: w_wet} }
        w_d2 { TexMath: {op: MathMultiply, a: w_d1, b: w_flat} }
        w_d3 { TexMath: {op: MathMultiply, a: w_d2, b: w_coast} }
        w_d4 { TexMath: {op: MathMultiply, a: w_d3, b: w_cl} }
        w_d { TexMath: {op: MathMultiply, a: w_d4, b_value: {1.6, 0, 0, 0}} }
        w_c1 { TexCells: {count: towns, jitter: 1, seed: sd * 16 + 10} }
        w_c1x { TexSplit: {input: w_c1, channel: ChannelR} }
        w_c1y { TexSplit: {input: w_c1, channel: ChannelG} }
        w_c1z { TexSplit: {input: w_c1, channel: ChannelB} }
        w_dot1 {
          TexMath: {
            op: MathSmoothstep, a: w_c1x, b_value: {0.22, 0, 0, 0}, c_value: {0.03, 0, 0, 0}
          }
        }
        w_g1 { TexMath: {op: MathStep, a: w_d, b: w_c1y} }
        w_l1 { TexMath: {op: MathMultiply, a: w_dot1, b: w_g1} }
        w_b1 {
          TexMath: {op: MathRemap, a: w_c1z, from_min: 0, from_max: 1, to_min: 0.45, to_max: 1}
        }
        w_t1 { TexMath: {op: MathMultiply, a: w_l1, b: w_b1} }
        w_c2 { TexCells: {count: towns * 4, jitter: 1, seed: sd * 16 + 11} }
        w_c2x { TexSplit: {input: w_c2, channel: ChannelR} }
        w_c2y { TexSplit: {input: w_c2, channel: ChannelG} }
        w_dot2 {
          TexMath: {
            op: MathSmoothstep, a: w_c2x, b_value: {0.16, 0, 0, 0}, c_value: {0.02, 0, 0, 0}
          }
        }
        w_d2s { TexMath: {op: MathMultiply, a: w_d, b_value: {0.45, 0, 0, 0}} }
        w_g2 { TexMath: {op: MathStep, a: w_d2s, b: w_c2y} }
        w_l2 { TexMath: {op: MathMultiply, a: w_dot2, b: w_g2} }
        w_t2 { TexMath: {op: MathMultiply, a: w_l2, b_value: {0.55, 0, 0, 0}} }
        w_dd { TexMath: {op: MathMultiply, a: w_d, b: w_d} }
        w_haze { TexMath: {op: MathMultiply, a: w_dd, b_value: {0.035, 0, 0, 0}} }
        w_v0 { TexMath: {op: MathMax, a: w_t1, b: w_t2} }
        w_v1 { TexMath: {op: MathAdd, a: w_v0, b: w_haze} }
        w_v { TexMath: {op: MathMultiply, a: w_v1, b_value: {city_k, 0, 0, 0}} }
        w_col {
          TexRamp: {input: w_v, keys: [
            {0, {0, 0, 0}}
            {0.02, {0, 0, 0}}
            {0.12, {70, 36, 14}}
            {0.35, {255, 160, 80}}
            {0.7, {255, 214, 140}}
            {1, {255, 244, 210}}
          ]}
        }
        TextureGraph: {output: w_col, width: tw, height: tw / 2, domain: DomainSphere}
      }

      // Clouds of the seed: weather systems of a noise that evolves slowly at warped coordinates
      // stretched along the parallels, banded by the latitude (rising at the equator and around
      // 55 degrees, sinking around 30 degrees), their edges broken up by a finer billow noise.
      // The warp, the bands and the billows do not depend on the time, so they are computed
      // once and each update evaluates the coverage only
      cld {
        k_time { TexTime: {scale: 0.01, offset: v3 * 40} }
        k_w1 { TexNoise: {channels: 3, frequency: 1.2, octaves: 2, seed: sd * 16 + 12} }
        k_p1 { TexWarp: {offset: k_w1, amount_value: 0.7} }
        k_st { TexTransform: {coords: k_p1, scale: {1, 1.6, 1}} }
        k_n {
          TexNoise: {coords: k_st, frequency: 1.8, octaves: 3, evolve: k_time, seed: sd * 16 + 13}
        }
        k_z {
          TexMath: {op: MathRemap, a: k_n, from_min: 0.49, from_max: 0.585, to_min: 0, to_max: 1}
        }
        k_f {
          TexNoise: {
            coords: k_st, frequency: 6, octaves: oct - 2, gain: 0.6, fractal: NoiseBillow,
            seed: sd * 16 + 15
          }
        }
        k_fz {
          TexMath: {op: MathRemap, a: k_f, from_min: 0.23, from_max: 0.32, to_min: 0, to_max: 0.8}
        }
        k_y { TexSplit: {input: k_p1, channel: ChannelG} }
        k_ay { TexMath: {op: MathAbs, a: k_y} }
        k_band {
          TexCurve: {input: k_ay, curve: {kind: CurveCatmullRom, keys: [
            {0, 0.7}, {0.15, 0.3}, {0.42, -0.9}, {0.58, -0.3}, {0.8, 0.7}, {0.92, 0.4}, {1, -0.4}
          ]}}
        }
        k_s0 { TexMath: {op: MathAdd, a: k_z, b: k_band} }
        k_sum { TexMath: {op: MathAdd, a: k_s0, b: k_fz} }
        k_d {
          TexMath: {
            op: MathSmoothstep, a: k_sum, b_value: {thr, 0, 0, 0}, c_value: {thr + 1.8, 0, 0, 0}
          }
        }
        k_s { TexSplat: {in: k_d} }
        k_out {
          TexMath: {op: MathMix, a_value: {0.72, 0.74, 0.78, 0}, b_value: {1, 1, 1, 1}, c: k_s}
        }
        TextureGraph: {output: k_out, width: tw, height: tw / 2, domain: DomainSphere, rate: 3}
      }
    } else if gas_on {
      // Zones and belts from the sine of the latitude, made irregular by a noise of the latitude
      g_dir { TexCoords: {} }
      g_y { TexSplit: {input: g_dir, channel: ChannelG} }
      g_line { TexCombine: {r_value: v2 * 7, g: g_y, b_value: v4 * 7, a_value: 1} }
      g_ln { TexNoise: {coords: g_line, frequency: 2, octaves: 2, seed: sd * 16 + 3} }
      g_lo {
        TexMath: {op: MathRemap, a: g_ln, from_min: 0.5, from_max: 1, to_min: 0, to_max: 0.6}
      }
      g_lat { TexMath: {op: MathAdd, a: g_y, b: g_lo} }
      g_ph { TexMath: {op: MathMultiply, a: g_lat, b_value: {bf, 0, 0, 0}} }
      g_sin { TexMath: {op: MathSin, a: g_ph} }

      // The bands in their own frame, computed once: turbulence of warped noise stretched along
      // the bands, wavy band edges and storm ovals held between two jets
      bands {
        b_wn { TexNoise: {channels: 3, frequency: 2.5, octaves: 2, seed: sd * 16 + 5} }
        b_wp { TexWarp: {offset: b_wn, amount_value: 0.3} }
        b_st { TexTransform: {coords: b_wp, scale: {1, 4, 1}} }
        b_tn {
          TexNoise: {coords: b_st, frequency: 3, octaves: oct - 1, gain: 0.55, seed: sd * 16 + 6}
        }
        b_wy { TexSplit: {input: b_wp, channel: ChannelG} }
        b_wl { TexMath: {op: MathAdd, a: b_wy, b: g_lo} }
        b_wph { TexMath: {op: MathMultiply, a: b_wl, b_value: {bf, 0, 0, 0}} }
        b_ws { TexMath: {op: MathSin, a: b_wph} }
        b_sub { TexCombine: {r_value: v2 * 7 + 3, g: b_wy, b_value: v4 * 7 + 3, a_value: 1} }
        b_sn { TexNoise: {coords: b_sub, frequency: 9, octaves: 3, gain: 0.6, seed: sd * 16 + 1} }
        b_b0 {
          TexMath: {op: MathRemap, a: b_ws, from_min: -1, from_max: 1, to_min: 0.2, to_max: 0.8}
        }
        b_b1 {
          TexMath: {op: MathRemap, a: b_sn, from_min: 0.4, from_max: 0.6, to_min: -0.2, to_max: 0.2}
        }
        b_t {
          TexMath: {
            op: MathRemap, a: b_tn, from_min: 0.4, from_max: 0.6, to_min: -0.07, to_max: 0.07
          }
        }
        b_v0 { TexMath: {op: MathAdd, a: b_b0, b: b_b1} }
        b_v { TexMath: {op: MathAdd, a: b_v0, b: b_t} }
        b_col {
          TexRamp: {input: b_v, keys: [
            {0.15, {g3.r, g3.g, g3.b}}
            {0.35, {g1.r, g1.g, g1.b}}
            {0.5, {g4.r, g4.g, g4.b}}
            {0.65, {g0.r, g0.g, g0.b}}
            {0.85, {g2.r, g2.g, g2.b}}
          ]}
        }
        b_sc { TexTransform: {scale: {1, 2.2, 1}} }
        b_cells { TexCells: {coords: b_sc, count: 48, jitter: 0.8, seed: sd * 16 + 4} }
        b_cx { TexSplit: {input: b_cells, channel: ChannelR} }
        b_cz { TexSplit: {input: b_cells, channel: ChannelB} }
        b_cw { TexSplit: {input: b_cells, channel: ChannelA} }
        b_core {
          TexMath: {op: MathSmoothstep, a: b_cx, b_value: {0.42, 0, 0, 0}, c_value: {0.34, 0, 0, 0}}
        }
        b_gate { TexMath: {op: MathStep, a_value: {storm_frac, 0, 0, 0}, b: b_cz} }
        b_as { TexMath: {op: MathAbs, a: g_sin} }
        b_pl {
          TexMath: {op: MathSmoothstep, a: b_as, b_value: {0.35, 0, 0, 0}, c_value: {0.9, 0, 0, 0}}
        }
        b_st0 { TexMath: {op: MathMultiply, a: b_core, b: b_gate} }
        b_storm { TexMath: {op: MathMultiply, a: b_st0, b: b_pl} }
        b_sk { TexMath: {op: MathMultiply, a: b_storm, b_value: {0.9, 0, 0, 0}} }
        b_ring {
          TexMath: {
            op: MathRemapClamped, a: b_cx, from_min: 0, from_max: 0.42, to_min: 0.7, to_max: 1.1
          }
        }
        b_scol0 {
          TexRamp: {input: b_cw, keys: [{0, {st0.r, st0.g, st0.b}}, {1, {st1.r, st1.g, st1.b}}]}
        }
        b_scol { TexMath: {op: MathMultiply, a: b_scol0, b: b_ring} }
        b_out { TexMath: {op: MathMix, a: b_col, b: b_scol, c: b_sk} }
        TextureGraph: {output: b_out, width: tw, height: tw / 2, domain: DomainSphere}
      }

      // Differential rotation: each band turns about the pole at the speed of its jet, the
      // jets alternating with the bands. The angle swings with a period of 20 minutes, so the
      // shear between the bands stays bounded, and the bands are sampled at the turned
      // direction, so an update costs a lookup per texel
      alb {
        a_jet {
          TexMath: {
            op: MathSmoothstep, a: g_sin, b_value: {-0.8, 0, 0, 0}, c_value: {0.8, 0, 0, 0}
          }
        }
        a_amp {
          TexMath: {
            op: MathRemap, a: a_jet, from_min: 0, from_max: 1, to_min: 0 - drift, to_max: drift
          }
        }
        a_time { TexTime: {scale: 0.00524, offset: -0.3 - v3 * 0.4} }
        a_swing { TexMath: {op: MathSin, a: a_time} }
        a_ang { TexMath: {op: MathMultiply, a: a_amp, b: a_swing} }
        a_rot { TexTransform: {coords: g_dir, angle: a_ang} }
        a_img { TexImage: {texture: bands, coords: a_rot} }
        TextureGraph: {output: a_img, width: tw, height: tw / 2, domain: DomainSphere, rate: 12}
      }
    }

    const ready: bool = detail > 0 && alb[TextureStatus].revision > 0
    const lava_ready: bool = lava_on && glow[TextureStatus].revision > 0
    const city_ready: bool = city_on && town[TextureStatus].revision > 0
    const cloud_ready: bool = surf_on && cld[TextureStatus].revision > 0

    axis {
      Position: {0, 0, 0}
      Rotation: {lean, 0, tilt}

      body {
        Position: {0, 0, 0}
        AngularVelocity: {0, spin, 0}
        Sphere: {radius: radius, segments: seg, smooth: true}
        PbrMaterial: {roughness: is_gas ? 0.8 : 0.92}
        NoShadow
        if ready {
          Rgb: {255, 255, 255}
          if is_gas {
            PbrTextures: {albedo: alb}
          } else {
            PbrTextures: {albedo: alb, normal: geo, orm: orm, emissive: glow}
          }
        } else {
          Rgb: {flat.r, flat.g, flat.b}
        }
        if detail <= 0 && air_k > 0.1 {
          Fresnel: {color: {airc.r, airc.g, airc.b}, strength: 0.6 * air_k, power: 2.5}
        }
        if lava_ready {
          Emissive: {strength: 1.8, color: {255, 200, 150}}
        } else if detail <= 0 && heat > 0 && !is_gas {
          Emissive: {strength: 0.3 * heat, color: {255, 96, 32}}
        }
        if city_ready {
          city {
            Position: {0, 0, 0}
            Sphere: {radius: radius * 1.002, segments: seg, smooth: true}
            Rgb: {0, 0, 0}
            PbrMaterial: {roughness: 1}
            Emissive: {strength: 0.6, color: {255, 224, 176}}
            PbrTextures: {emissive: town}
            BlendMode: Max
            NoShadow
            SpatialIgnore
          }
        }
      }

      if cloud_ready && cover > 0.02 {
        clouds {
          Position: {0, 0, 0}
          AngularVelocity: {0, spin * 1.25 + 0.004, 0}
          Sphere: {radius: radius * 1.012, segments: seg, smooth: true}
          Rgb: {mist.r, mist.g, mist.b}
          PbrMaterial: {roughness: 1}
          PbrTextures: {albedo: cld}
          BlendMode: AlphaBlend
          Opacity: {cover}
          Transition: [Opacity: {duration: 2}, Rgb: {duration: 2}]
          NoShadow
          SpatialIgnore
        }
      }

      if rings {
        ring {
          Position: {0, 0, 0}
          Rotation: {0 - PI / 2, 0, 0}
          Quad: {radius * 4.6, radius * 4.6}
          Rgb: {ringc.r * 0.6, ringc.g * 0.6, ringc.b * 0.6}
          PbrMaterial: {roughness: 1}
          Emissive: {strength: 0.4, color: {ringc.r, ringc.g, ringc.b}}
          PbrTextures: {albedo: ring_tex, emissive: ring_tex}
          BlendMode: AlphaBlend
          NoShadow
          SpatialIgnore
        }
        ring_back {
          Position: {0, 0, 0}
          Rotation: {PI / 2, 0, 0}
          Quad: {radius * 4.6, radius * 4.6}
          Rgb: {ringc.r * 0.6, ringc.g * 0.6, ringc.b * 0.6}
          PbrMaterial: {roughness: 1}
          Emissive: {strength: 0.4, color: {ringc.r, ringc.g, ringc.b}}
          PbrTextures: {albedo: ring_tex, emissive: ring_tex}
          BlendMode: AlphaBlend
          NoShadow
          SpatialIgnore
        }
      }
    }
  }
}

using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.movement
using box.texture
using box.transition
using box.spatial
using box.atmosphere

planets {
  struct Col(r: f32, g: f32, b: f32)

  fn h01(seed: i32, salt: i32) -> f32 {
    const x: f64 = sin(seed * 127.1 + salt * 311.7 + 1.3) * 43758.5453
    x - floor(x)
  }

  fn sat(x: f32) -> f32 { clamp(x, 0, 1) }

  // Inverse of the normal distribution at a fraction, by the logistic approximation: the height
  // in standard deviations below which that fraction of a noise lies
  fn probit(f: f32) -> f32 {
    const q: f32 = clamp(f, 0.02, 0.98)
    log(q / (1 - q)) / 1.702
  }

  fn mixc(a: Col, b: Col, t: f32) -> Col {
    {a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t}
  }

  fn mulc(a: Col, b: Col) -> Col { {a.r * b.r / 255, a.g * b.g / 255, a.b * b.b / 255} }

  fn pal_a(i: i32) -> Col {
    match i {
      0: {66, 62, 62}; 1: {112, 104, 98}; 2: {156, 148, 138}; 3: {194, 188, 180}
      4: {168, 112, 66}; 5: {212, 158, 96}; 6: {190, 124, 76}; 7: {142, 88, 60}
      8: {120, 156, 192}; 9: {176, 202, 224}; 10: {214, 228, 240}; 11: {240, 246, 252}
      12: {34, 24, 24}; 13: {54, 42, 40}; 14: {74, 60, 56}; 15: {98, 86, 80}
      20: {156, 136, 96}; 21: {146, 120, 84}; 22: {128, 112, 96}; 23: {150, 146, 142}
      _: {128, 128, 128}
    }
  }

  fn pal_b(i: i32) -> Col {
    match i {
      0: {92, 60, 48}; 1: {140, 92, 66}; 2: {176, 128, 96}; 3: {204, 172, 148}
      4: {190, 150, 84}; 5: {228, 196, 128}; 6: {204, 160, 96}; 7: {160, 116, 70}
      8: {108, 168, 176}; 9: {168, 214, 216}; 10: {208, 236, 236}; 11: {238, 250, 250}
      12: {30, 28, 36}; 13: {48, 46, 56}; 14: {68, 66, 76}; 15: {92, 90, 100}
      20: {170, 120, 86}; 21: {150, 104, 76}; 22: {120, 100, 92}; 23: {156, 150, 150}
      _: {128, 128, 128}
    }
  }

  fn pal(kind: i32, lvl: i32, v: f32) -> Col {
    mixc(pal_a(kind * 4 + lvl), pal_b(kind * 4 + lvl), v)
  }

  fn terrain(kind: i32, v: f32, e: f32) -> Col {
    const lo: Col = mixc(pal(kind, 0, v), pal(kind, 1, v), sat(e / 0.22))
    const mid: Col = mixc(lo, pal(kind, 2, v), sat((e - 0.22) / 0.33))
    mixc(mid, pal(kind, 3, v), sat((e - 0.55) / 0.4))
  }

  fn veg(vv: f32, e: f32) -> Col {
    const lo: Col = mixc({78, 132, 52}, {44, 124, 96}, vv)
    const mid: Col = mixc({30, 84, 38}, {24, 76, 66}, vv)
    const hi: Col = mixc({96, 104, 56}, {70, 96, 78}, vv)
    mixc(mixc(lo, mid, sat(e * 3.2)), hi, sat((e - 0.34) * 3.5))
  }

  fn land(kind: i32, v: f32, vv: f32, e: f32, bio: f32, hot: f32, wet: f32) -> Col {
    const base: Col = mixc(terrain(kind, v, e), {112, 92, 70}, wet * 0.35 * sat(1 - e * 2))
    const cover: f32 = sat((bio * 0.85 - e) * 4.5 + bio * 0.3) * (bio > 0 ? 1 : 0)
    const green: Col = mixc(veg(vv, e), {158, 146, 78}, sat(hot * 1.2))
    const grown: Col = mixc(base, green, cover * 0.94)
    const parched: Col = mixc(grown, {150, 84, 50}, hot * 0.4)
    mixc(parched, {52, 34, 30}, sat(hot * 2.5 - 1.5) * 0.7)
  }

  // Bare ground of a kind at a palette level, darkened where wet and parched where hot: the
  // keys of the ramp of the ground by altitude
  fn ground(kind: i32, v: f32, lvl: i32, e: f32, hot: f32, wet: f32) -> Col {
    const base: Col = mixc(pal(kind, lvl, v), {112, 92, 70}, wet * 0.35 * sat(1 - e * 2))
    const parched: Col = mixc(base, {150, 84, 50}, hot * 0.4)
    mixc(parched, {52, 34, 30}, sat(hot * 2.5 - 1.5) * 0.7)
  }

  fn sea_col(depth: i32, vs: f32, frozen: f32, hot: f32) -> Col {
    const a: Col = match depth {
      0: {4, 14, 52}; 1: {8, 38, 96}; 2: {12, 60, 122}; _: {26, 96, 140}
    }
    const b: Col = match depth {
      0: {4, 26, 52}; 1: {8, 56, 88}; 2: {14, 84, 108}; _: {36, 122, 136}
    }
    const ice: Col = match depth {
      0: {150, 186, 216}; 1: {176, 206, 228}; 2: {200, 222, 238}; _: {222, 236, 246}
    }
    const w: Col = mixc(mixc(a, b, vs), {70, 96, 84}, hot * 0.5)
    mixc(w, ice, frozen)
  }

  fn gas_col(p: i32, i: i32) -> Col {
    match p * 5 + i {
      0: {214, 186, 148}; 1: {168, 118, 82}; 2: {236, 220, 190}; 3: {142, 92, 66}
      4: {198, 152, 110}
      5: {70, 110, 190}; 6: {40, 66, 150}; 7: {120, 170, 226}; 8: {30, 48, 120}; 9: {86, 136, 206}
      10: {226, 204, 140}; 11: {196, 168, 104}; 12: {240, 228, 180}; 13: {170, 140, 90}
      14: {214, 190, 128}
      15: {104, 176, 168}; 16: {58, 128, 132}; 17: {160, 216, 200}; 18: {40, 96, 110}
      19: {120, 190, 176}
      20: {186, 132, 170}; 21: {120, 78, 140}; 22: {226, 184, 196}; 23: {88, 56, 116}
      24: {170, 112, 160}
      _: {200, 200, 200}
    }
  }

  fn haze(kind: i32) -> Col {
    match kind {
      0: {170, 150, 130}; 1: {232, 160, 96}; 2: {170, 214, 240}; 3: {255, 104, 48}
      4: {190, 200, 220}
      _: {150, 180, 230}
    }
  }

  ring_tex { TexturePath: {path: "etc/scenes/planet/assets/rings.png"} }

  // A planet whose maps are texture graphs on the sphere domain. For a kind and a detail the
  // nodes are fixed: the sliders (atm, water, temp, bio, seed, lights) change their parameters
  // only, so no slider compiles a graph again. A feature that is off keeps its nodes with a zero
  // contribution.
  //
  // One height (s_h) feeds every map of a rocky planet: warped fbm continents, ridged mountain
  // ranges masked to some regions and, for ice and lava, cracked plates. The climate follows from
  // it: a temperature (s_t) from the latitude, the temp prop and the altitude, a moisture (s_m)
  // from the water prop, the distance to the sea (the land mask blurred) and the latitude bands.
  // The land is the ground of the kind by altitude, covered by the vegetation of the biome table
  // (lut, by temperature and moisture), rock on steep ground, sand at the coast and snow where it
  // is cold; the sea is tinted by depth and freezes where it is cold.
  template Planet {
    prop kind: i32 = 0
    prop seed: i32 = 0
    prop atm: f32 = 0
    prop water: f32 = 0
    prop temp: f32 = 50
    prop bio: f32 = 0
    prop radius: f32 = 1
    prop lights: bool = false
    prop rings: bool = false
    prop detail: i32 = 1
    prop spin: f32 = 0.05
    prop air_scale: f32 = 1

    const qa: i32 = clamp(floor(atm / 5 + 0.5), 0, 20)
    const qw: i32 = clamp(floor(water / 5 + 0.5), 0, 20)
    const qt: i32 = clamp(floor(temp / 5 + 0.5), 0, 20)
    const qb: i32 = clamp(floor(bio / 5 + 0.5), 0, 20)
    const is_gas: bool = kind == 4
    const k: i32 = (kind < 0 || kind > 5) ? 0 : kind
    const a: f32 = qa / 20
    const w: f32 = is_gas ? 0 : qw / 20
    const t: f32 = qt / 20
    const b: f32 = is_gas ? 0 : qb / 20

    const sd: i32 = seed < 0 ? 0 - seed : seed
    const v1: f32 = h01(sd, 1)
    const v2: f32 = h01(sd, 2)
    const v3: f32 = h01(sd, 3)
    const v4: f32 = h01(sd, 4)

    const cold: f32 = sat((0.42 - t) / 0.42)
    const hot: f32 = sat((t - 0.62) / 0.38)
    const frozen: f32 = max(smoothstep(0.2, 0.5, cold), sat(1 - a * 8))
    const shelf: f32 = 0.035 + 0.82 * min(w, 0.25) + 0.575 * clamp(w - 0.25, 0, 0.4)
    const deep: f32 = 0.698 * clamp(w - 0.65, 0, 0.15) + 1.435 * max(w - 0.8, 0)
    const sea: f32 = qw > 0 ? shelf + deep : -0.08
    const damp: f32 = sat(w * 4 + a * 1.2)
    const snow: f32 = max(0.365 + 0.936 * t + (1 - damp) * 0.8 + hot * 1.9, sea + 0.01)
    const span: f32 = max(snow - sea - 0.006, 0.003)
    const top: f32 = max(0.95 - max(sea, 0), 0.2)
    const l2: f32 = sea + 0.006 + span * 0.16
    const c2: Col = land(k, v1, v2, sat((l2 - sea) / top), b, hot, w)
    const s0: Col = sea_col(0, v3, 0, hot)
    const s1: Col = sea_col(1, v3, 0, hot)
    const s2: Col = sea_col(2, v3, 0, hot)
    const s3: Col = sea_col(3, v3, 0, hot)
    const s1f: Col = sea_col(1, v3, frozen, hot)

    const gp: i32 = sd % 5
    const warm: Col = mixc({255, 255, 255}, {255, 196, 150}, hot * 0.5)
    const gtint: Col = mixc(warm, {170, 200, 255}, cold * 0.5)
    const g0: Col = mulc(mixc(gas_col(gp, 0), gas_col((gp + 1) % 5, 0), v2 * 0.35), gtint)
    const g1: Col = mulc(mixc(gas_col(gp, 1), gas_col((gp + 1) % 5, 1), v2 * 0.35), gtint)
    const g2: Col = mulc(mixc(gas_col(gp, 2), gas_col((gp + 1) % 5, 2), v2 * 0.35), gtint)
    const g3: Col = mulc(mixc(gas_col(gp, 3), gas_col((gp + 1) % 5, 3), v2 * 0.35), gtint)
    const g4: Col = mulc(mixc(gas_col(gp, 4), gas_col((gp + 1) % 5, 4), v2 * 0.35), gtint)

    const heat: f32 = sat((t - (k == 3 ? 0.55 : 0.8)) / 0.2) * sat(1 - w * 8)
    const lava_lvl: f32 = heat * (k == 3 ? 0.16 : 0.14)
    const lava_on: bool = !is_gas && detail > 0 && lava_lvl > 0
    const city_on: bool = !is_gas && detail > 0 && lights && !lava_on

    const cover: f32 = is_gas ? 0 : sat(a * (0.3 + 1.25 * w)) * (1 - hot * 0.3)
    const breath: f32 = smoothstep(0.3, 0.8, a) * sat(0.25 + w + b)
    const airc: Col = mixc(mixc(haze(k), {96, 160, 255}, breath), mixc(g2, g1, 0.4), is_gas ? 1 : 0)
    const air_k: f32 = is_gas ? 0.5 : a
    const air_max: f32 = max(max(airc.r, airc.g), max(airc.b, 1))
    const air_on: bool = detail > 0 && air_k > 0.02
    const lift: f32 = 16 * air_scale * (0.7 + 0.6 * air_k)
    const dens: f32 = is_gas ? 1 : 0.1 + 0.9 * a
    const ray_k: f32 = match k { 0: 1.1; 1: 0.3; 2: 1.2; 3: 0.4; 4: 0.25; _: 1 }
    const mie_k: f32 = match k { 0: 2; 1: 28; 2: 22; 3: 44; 4: 6; _: 2 }
    const ray_h: f32 = match k { 0: 8; 1: 9; 2: 5; 3: 11; 4: 9; _: 8 }
    const mie_h: f32 = match k { 0: 1.5; 1: 8; 2: 3; 3: 10; 4: 7; _: 1.5 }
    const mie_g: f32 = match k { 0: 0.75; 1: 0.4; 2: 0.7; 3: 0.4; 4: 0.5; _: 0.75 }
    const dust: Col = mixc({214, 204, 184}, {196, 170, 140}, v1)
    const ringc: Col = mixc(dust, mixc(g2, {255, 255, 255}, 0.4), is_gas ? 0.35 : 0)
    const mist: Col = mixc(mixc(haze(k), {255, 255, 255}, 0.25), {255, 255, 255}, sat(w * 4))
    const pale: f32 = sat(0.9 - snow) * 0.9 + cover * 0.15
    const far: Col = mixc(mixc(c2, s1f, sat(w * 1.3)), {236, 242, 250}, pale)
    const flat: Col = mixc(far, g0, is_gas ? 1 : 0)

    const tw: i32 = detail > 1 ? 1024 : 512
    const seg: i32 = detail > 1 ? 96 : (detail > 0 ? 48 : 20)
    const oct: i32 = detail > 1 ? 6 : 5
    const lean: f32 = 0.1 + v3 * 0.2
    const tilt: f32 = (v4 - 0.5) * 0.5 + (v4 > 0.5 ? 0.12 : -0.12)
    const surf_on: bool = detail > 0 && !is_gas
    const gas_on: bool = detail > 0 && is_gas

    // Height: continents of fbm about 0.5 with a standard deviation of h_std, so the sea level
    // that leaves a fraction w of the surface under water is its quantile
    const h_std: f32 = 0.125
    const f1: f32 = match k {
      0: 1.1 + (sd % 3) * 0.2; 5: 1 + (sd % 3) * 0.2; 1: 1.3 + (sd % 2) * 0.3
      _: 1.5 + (sd % 2) * 0.3
    }
    const g1n: f32 = match k { 0: 0.58; 1: 0.5; 2: 0.5; 3: 0.56; _: 0.52 }
    const warp_amt: f32 = 1.6 + v4 * 0.8
    const mtn: f32 = match k { 0: 0.26; 1: 0.22; 2: 0.12; 3: 0.2; _: 0.24 }
    const mtn_lo: f32 = 0.47 + (v2 - 0.5) * 0.06
    const a3: f32 = match k { 2: 0.05; 3: 0.12; _: 0 }
    const cn: i32 = match k { 2: 90 + sd % 60; 3: 50 + sd % 40; _: 64 }
    const sea_h: f32 = qw > 0 ? 0.5 + h_std * probit(w) : -1
    const base_h: f32 = max(sea_h, 0.2)
    const top_h: f32 = max(1 - base_h, 0.3)
    const nstr: f32 = match k { 2: 1.8; 3: 2.6; _: 2.4 }
    const rock_lo: f32 = 0.08
    const rock_hi: f32 = 0.2

    // Climate: the temperature at sea level falls from t_eq at the equator by t_lat at the
    // poles and by t_alt at the highest ground; 0.04 to 0.14 is the snow line
    const t_eq: f32 = 0.25 + 0.9 * t
    const t_lat: f32 = 0.75
    const t_alt: f32 = 0.5
    const freeze: f32 = 0.1 + 0.75 * frozen
    const wet: f32 = sat(w * 1.4 + a * 0.35) * (1 - hot * 0.5)
    const snow_k: f32 = sat(0.3 + w * 4 + a * 0.5)
    const sand: f32 = qw > 0 ? 0.5 * (1 - frozen) : 0
    const veg_k: f32 = sat(b * 1.15) * 0.94
    const tl_hi: f32 = 0.15 + 0.6 * b
    const tl_lo: f32 = tl_hi - 0.25

    // Colors of the ramps
    const tc0: Col = ground(k, v1, 0, 0, hot, w)
    const tc1: Col = ground(k, v1, 1, 0.22, hot, w)
    const tc2: Col = ground(k, v1, 2, 0.55, hot, w)
    const tc3: Col = ground(k, v1, 3, 0.95, hot, w)
    const rk0: Col = mixc(tc1, {92, 88, 84}, 0.45)
    const rk1: Col = mixc(tc2, {118, 114, 110}, 0.4)
    const gr2: Col = mixc({78, 132, 52}, {44, 124, 96}, v2)
    const fo2: Col = mixc({30, 84, 38}, {24, 76, 66}, v2)

    // Lava fills the lowlands up to lava_h and glows in the cracks of the plates
    const lava_h: f32 = 0.5 + h_std * probit(max(heat * (k == 3 ? 0.3 : 0.18), 0.02))
    const lava_k: f32 = lava_on ? 1 : 0
    const crack_glow: f32 = k == 3 ? 0.6 * heat : 0

    // City lights: towns at the points of cells, lit where the density beats their id
    const city_k: f32 = city_on ? 1 : 0
    const towns: i32 = detail > 1 ? 7000 : 2500

    // Clouds: a fraction cf of the sky covered, thr the threshold of the noise that leaves it
    const cf: f32 = 0.3 + 0.35 * cover
    const thr: f32 = 0.5 + h_std * probit(1 - cf) - 0.09

    // Gas giants: jets in degrees per second, storms on a fraction of the cells
    const jet: f32 = 1.2 + v1 * 1.2
    const storm_frac: f32 = 0.12 + v4 * 0.12
    const st0: Col = mixc(g3, {200, 90, 60}, 0.5)
    const st1: Col = mixc(g2, {250, 246, 236}, 0.6)

    if air_on {
      PlanetAtmosphere: {
        sun: sun
        radius: radius
        thickness: max(ray_h, mie_h) * lift * 6
        rayleigh: {scale_height: ray_h * lift, scattering_scale: ray_k * dens / lift}
        mie: {
          scale_height: mie_h * lift, anisotropy: mie_g, scattering_scale: mie_k * dens / lift,
          tint: {airc.r * 255 / air_max, airc.g * 255 / air_max, airc.b * 255 / air_max}
        }
        ozone_scale: 0
      }
    }

    if surf_on {
      // Height
      s_dir { TexCoords: {} }
      s_y { TexSplit: {input: s_dir, channel: ChannelG} }
      s_ay { TexMath: {op: MathAbs, a: s_y} }
      s_wn { TexNoise: {channels: 3, frequency: 1.2, octaves: 3, seed: sd * 8 + 2} }
      s_wp { TexWarp: {offset: s_wn, amount_value: warp_amt} }
      s_cn { TexNoise: {coords: s_wp, frequency: f1, octaves: oct, gain: g1n, seed: sd * 8 + 1} }
      s_c {
        TexMath: {op: MathRemap, a: s_cn, from_min: 0.25, from_max: 0.75, to_min: 0, to_max: 1}
      }
      s_rn {
        TexNoise: {
          coords: s_wp, frequency: 2.6, octaves: oct, gain: 0.5, fractal: NoiseRidged,
          seed: sd * 8 + 3
        }
      }
      s_r { TexMath: {op: MathSmoothstep, a: s_rn, b_value: {0.4, 0, 0, 0}, c_value: {1, 0, 0, 0}} }
      s_mn { TexNoise: {frequency: 1.1, octaves: 2, seed: sd * 8 + 4} }
      s_mm {
        TexMath: {
          op: MathSmoothstep, a: s_mn, b_value: {mtn_lo, 0, 0, 0}, c_value: {mtn_lo + 0.1, 0, 0, 0}
        }
      }
      s_ml {
        TexMath: {
          op: MathSmoothstep, a: s_c, b_value: {sea_h - 0.02, 0, 0, 0},
          c_value: {sea_h + 0.1, 0, 0, 0}
        }
      }
      s_m0 { TexMath: {op: MathMultiply, a: s_r, b: s_mm} }
      s_m1 { TexMath: {op: MathMultiply, a: s_m0, b: s_ml} }
      s_m2 { TexMath: {op: MathMultiply, a: s_m1, b_value: {mtn, 0, 0, 0}} }
      s_h0 { TexMath: {op: MathAdd, a: s_c, b: s_m2} }
      s_cl {
        TexCells: {
          coords: s_wp, count: cn, jitter: 1, distance: CellsEdge, edge: 0.3, seed: sd * 8 + 5
        }
      }
      s_clx { TexSplit: {input: s_cl, channel: ChannelR} }
      s_ck {
        TexMath: {
          op: MathRemap, a: s_clx, from_min: 0, from_max: 1, to_min: 0 - a3 * 0.7, to_max: a3 * 0.3
        }
      }
      s_h { TexMath: {op: MathAdd, a: s_h0, b: s_ck} }
      s_relief { TexMath: {op: MathMax, a: s_h, b_value: {sea_h, 0, 0, 0}} }
      s_slope { TexSlope: {height: s_relief, strength: nstr} }
      s_alt {
        TexMath: {
          op: MathRemapClamped, a: s_h, from_min: base_h, from_max: base_h + top_h, to_min: 0,
          to_max: 1
        }
      }
      s_land {
        TexMath: {
          op: MathSmoothstep, a: s_h, b_value: {sea_h - 0.003, 0, 0, 0},
          c_value: {sea_h + 0.003, 0, 0, 0}
        }
      }

      // Temperature, s_t0 at sea level
      s_y2 { TexMath: {op: MathMultiply, a: s_y, b: s_y} }
      s_tl {
        TexMath: {
          op: MathRemap, a: s_y2, from_min: 0, from_max: 1, to_min: t_eq, to_max: t_eq - t_lat
        }
      }
      s_jn { TexNoise: {channels: 3, frequency: 2.5, octaves: 3, seed: sd * 8 + 6} }
      s_jt { TexSplit: {input: s_jn, channel: ChannelR} }
      s_jm { TexSplit: {input: s_jn, channel: ChannelG} }
      s_tj {
        TexMath: {op: MathRemap, a: s_jt, from_min: 0.3, from_max: 0.7, to_min: -0.08, to_max: 0.08}
      }
      s_t0 { TexMath: {op: MathAdd, a: s_tl, b: s_tj} }
      s_ta { TexMath: {op: MathMultiply, a: s_alt, b_value: {t_alt, 0, 0, 0}} }
      s_t { TexMath: {op: MathSubtract, a: s_t0, b: s_ta} }
      s_icem {
        TexMath: {
          op: MathSmoothstep, a: s_t0, b_value: {freeze + 0.03, 0, 0, 0},
          c_value: {freeze - 0.03, 0, 0, 0}
        }
      }

      // Moisture: wet near the sea, at the equator and around 50 degrees, dry around 30
      s_near { TexBlur: {input: s_land, radius: 18} }
      s_band {
        TexCurve: {input: s_ay, curve: {kind: CurveCatmullRom, keys: [
          {0, 1}, {0.2, 0.8}, {0.45, 0.3}, {0.55, 0.32}, {0.75, 0.75}, {0.88, 0.7}, {1, 0.35}
        ]}}
      }
      s_mc {
        TexMath: {
          op: MathRemapClamped, a: s_near, from_min: 0.2, from_max: 1, to_min: wet,
          to_max: wet * 0.3
        }
      }
      s_mb { TexMath: {op: MathMultiply, a: s_mc, b: s_band} }
      s_mj {
        TexMath: {op: MathRemap, a: s_jm, from_min: 0.3, from_max: 0.7, to_min: -0.12, to_max: 0.12}
      }
      s_m { TexMath: {op: MathAdd, a: s_mb, b: s_mj} }
      s_hab {
        TexCurve: {input: s_t, curve: {keys: [{0, 0}, {0.12, 0}, {0.3, 1}, {0.8, 1}, {1, 0.3}]}}
      }
    }

    // Biome table: the vegetation by temperature (u) and moisture (v) with its cover in alpha
    lut {
      if surf_on {
        l_uv { TexCoords: {} }
        l_t { TexSplit: {input: l_uv, channel: ChannelR} }
        l_m { TexSplit: {input: l_uv, channel: ChannelG} }
        l_grass {
          TexRamp: {input: l_t, keys: [
            {0.1, {116, 118, 84}}
            {0.3, {112, 138, 64}}
            {0.55, {gr2.r, gr2.g, gr2.b}}
            {0.8, {158, 146, 78}}
            {1, {176, 150, 86}}
          ]}
        }
        l_forest {
          TexRamp: {input: l_t, keys: [
            {0.1, {74, 86, 64}}
            {0.3, {34, 66, 44}}
            {0.55, {fo2.r, fo2.g, fo2.b}}
            {0.8, {26, 92, 34}}
            {1, {44, 88, 30}}
          ]}
        }
        l_lush {
          TexMath: {op: MathSmoothstep, a: l_m, b_value: {0.3, 0, 0, 0}, c_value: {0.75, 0, 0, 0}}
        }
        l_veg { TexMath: {op: MathMix, a: l_grass, b: l_forest, c: l_lush} }
        l_hab {
          TexCurve: {input: l_t, curve: {keys: [{0, 0}, {0.12, 0}, {0.3, 1}, {0.8, 1}, {1, 0.3}]}}
        }
        l_moist {
          TexMath: {op: MathSmoothstep, a: l_m, b_value: {0.04, 0, 0, 0}, c_value: {0.4, 0, 0, 0}}
        }
        l_cov0 { TexMath: {op: MathMultiply, a: l_hab, b: l_moist} }
        l_cov { TexMath: {op: MathMultiply, a: l_cov0, b_value: {veg_k, 0, 0, 0}} }
        l_cova { TexSplat: {in: l_cov} }
        l_alpha { TexMath: {op: MathMultiply, a: l_cova, b_value: {0, 0, 0, 1}} }
        l_rgb { TexMath: {op: MathMultiply, a: l_veg, b_value: {1, 1, 1, 0}} }
        l_out { TexMath: {op: MathAdd, a: l_rgb, b: l_alpha} }
        TextureGraph: {output: l_out, width: 32, height: 32}
      }
    }

    geo {
      if surf_on {
        n_normal { TexNormal: {height: s_relief, strength: nstr} }
        TextureGraph: {
          output: n_normal, width: tw, height: tw / 2, domain: DomainSphere, format: GraphLinear
        }
      }
    }

    alb {
      if gas_on {
        // Bands from the latitude, drifting at the speed of their jet (g_rot), turbulence from
        // warped noise stretched along the bands and storm ovals that drift with their band
        g_dir { TexCoords: {} }
        g_y { TexSplit: {input: g_dir, channel: ChannelG} }
        g_time { TexTime: {scale: 1, offset: v3 * 60} }
        g_line { TexCombine: {r_value: v2 * 7, g: g_y, b_value: v4 * 7, a_value: 1} }
        g_jn { TexNoise: {coords: g_line, frequency: 2.5, octaves: 2, seed: sd * 8 + 3} }
        g_jet {
          TexMath: {
            op: MathRemap, a: g_jn, from_min: 0.35, from_max: 0.65, to_min: 0 - jet, to_max: jet
          }
        }
        g_ang { TexMath: {op: MathMultiply, a: g_time, b: g_jet} }
        g_rot { TexTransform: {coords: g_dir, angle: g_ang} }
        g_evo { TexTime: {scale: 0.02, offset: v3 * 10} }
        g_wn {
          TexNoise: {
            coords: g_rot, channels: 3, frequency: 2.2, octaves: 3, evolve: g_evo, seed: sd * 8 + 5
          }
        }
        g_wp { TexWarp: {coords: g_rot, offset: g_wn, amount_value: 1.1} }
        g_st { TexTransform: {coords: g_wp, scale: {1, 5, 1}} }
        g_tn {
          TexNoise: {
            coords: g_st, frequency: 2.5, octaves: oct, gain: 0.55, evolve: g_evo, seed: sd * 8 + 6
          }
        }
        g_wy { TexSplit: {input: g_wp, channel: ChannelG} }
        g_bline { TexCombine: {r_value: v2 * 7, g: g_wy, b_value: v4 * 7 + 3, a_value: 1} }
        g_bn {
          TexNoise: {coords: g_bline, frequency: 4.5, octaves: 3, gain: 0.6, seed: sd * 8 + 1}
        }
        g_b {
          TexMath: {op: MathRemap, a: g_bn, from_min: 0.3, from_max: 0.7, to_min: 0, to_max: 1}
        }
        g_t {
          TexMath: {op: MathRemap, a: g_tn, from_min: 0.3, from_max: 0.7, to_min: -0.1, to_max: 0.1}
        }
        g_v { TexMath: {op: MathAdd, a: g_b, b: g_t} }
        g_col {
          TexRamp: {input: g_v, keys: [
            {0.12, {g3.r, g3.g, g3.b}}
            {0.26, {g0.r, g0.g, g0.b}}
            {0.33, {g1.r, g1.g, g1.b}}
            {0.4, {g2.r, g2.g, g2.b}}
            {0.46, {g4.r, g4.g, g4.b}}
            {0.52, {g1.r, g1.g, g1.b}}
            {0.58, {g2.r, g2.g, g2.b}}
            {0.65, {g0.r, g0.g, g0.b}}
            {0.74, {g3.r, g3.g, g3.b}}
            {0.88, {g1.r, g1.g, g1.b}}
          ]}
        }
        g_sc { TexTransform: {coords: g_rot, scale: {1, 2.2, 1}} }
        g_cells { TexCells: {coords: g_sc, count: 26, jitter: 0.8, seed: sd * 8 + 4} }
        g_cx { TexSplit: {input: g_cells, channel: ChannelR} }
        g_cz { TexSplit: {input: g_cells, channel: ChannelB} }
        g_cw { TexSplit: {input: g_cells, channel: ChannelA} }
        g_core {
          TexMath: {op: MathSmoothstep, a: g_cx, b_value: {0.3, 0, 0, 0}, c_value: {0.08, 0, 0, 0}}
        }
        g_gate { TexMath: {op: MathStep, a_value: {storm_frac, 0, 0, 0}, b: g_cz} }
        g_storm { TexMath: {op: MathMultiply, a: g_core, b: g_gate} }
        g_sk { TexMath: {op: MathMultiply, a: g_storm, b_value: {0.85, 0, 0, 0}} }
        g_scol {
          TexRamp: {input: g_cw, keys: [{0, {st0.r, st0.g, st0.b}}, {1, {st1.r, st1.g, st1.b}}]}
        }
        g_out { TexMath: {op: MathMix, a: g_col, b: g_scol, c: g_sk} }
        TextureGraph: {output: g_out, width: tw, height: tw / 2, domain: DomainSphere, rate: 12}
      } else if surf_on {
        a_lut { TexLut: {texture: lut, u: s_t, v: s_m} }
        a_cov0 { TexSplit: {input: a_lut, channel: ChannelA} }
        a_tree {
          TexMath: {
            op: MathSmoothstep, a: s_alt, b_value: {tl_hi, 0, 0, 0}, c_value: {tl_lo, 0, 0, 0}
          }
        }
        a_cov { TexMath: {op: MathMultiply, a: a_cov0, b: a_tree} }
        a_ground {
          TexRamp: {input: s_alt, keys: [
            {0, {tc0.r, tc0.g, tc0.b}}
            {0.22, {tc1.r, tc1.g, tc1.b}}
            {0.55, {tc2.r, tc2.g, tc2.b}}
            {0.95, {tc3.r, tc3.g, tc3.b}}
          ]}
        }
        a_land0 { TexMath: {op: MathMix, a: a_ground, b: a_lut, c: a_cov} }
        a_rockm {
          TexMath: {
            op: MathSmoothstep, a: s_slope, b_value: {rock_lo, 0, 0, 0}, c_value: {rock_hi, 0, 0, 0}
          }
        }
        a_rock {
          TexRamp: {input: s_alt, keys: [{0, {rk0.r, rk0.g, rk0.b}}, {1, {rk1.r, rk1.g, rk1.b}}]}
        }
        a_land1 { TexMath: {op: MathMix, a: a_land0, b: a_rock, c: a_rockm} }
        a_shore {
          TexMath: {op: MathSmoothstep, a: s_alt, b_value: {0.03, 0, 0, 0}, c_value: {0, 0, 0, 0}}
        }
        a_beach { TexMath: {op: MathMultiply, a: a_shore, b_value: {sand, 0, 0, 0}} }
        a_sand { TexRamp: {keys: [{0, {214, 200, 150}}]} }
        a_land2 { TexMath: {op: MathMix, a: a_land1, b: a_sand, c: a_beach} }
        a_cold {
          TexMath: {op: MathSmoothstep, a: s_t, b_value: {0.14, 0, 0, 0}, c_value: {0.04, 0, 0, 0}}
        }
        a_snowm { TexMath: {op: MathMultiply, a: a_cold, b_value: {snow_k, 0, 0, 0}} }
        a_snow { TexRamp: {keys: [{0, {236, 242, 250}}]} }
        a_land { TexMath: {op: MathMix, a: a_land2, b: a_snow, c: a_snowm} }
        a_depth {
          TexMath: {
            op: MathRemapClamped, a: s_h, from_min: sea_h, from_max: sea_h - 0.45, to_min: 0,
            to_max: 1
          }
        }
        a_water {
          TexRamp: {input: a_depth, keys: [
            {0.011, {s3.r, s3.g, s3.b}}
            {0.078, {s2.r, s2.g, s2.b}}
            {0.356, {s1.r, s1.g, s1.b}}
            {1, {s0.r, s0.g, s0.b}}
          ]}
        }
        a_ice { TexRamp: {input: a_depth, keys: [{0, {222, 236, 246}}, {1, {150, 186, 216}}]} }
        a_sea { TexMath: {op: MathMix, a: a_water, b: a_ice, c: s_icem} }
        a_out { TexMath: {op: MathMix, a: a_sea, b: a_land, c: s_land} }
        TextureGraph: {output: a_out, width: tw, height: tw / 2, domain: DomainSphere}
      }
    }

    orm {
      if surf_on {
        o_sea {
          TexMath: {op: MathRemap, a: s_icem, from_min: 0, from_max: 1, to_min: 0.47, to_max: 0.9}
        }
        o_rough { TexMath: {op: MathMix, a: o_sea, b_value: {1, 0, 0, 0}, c: s_land} }
        o_out { TexCombine: {r_value: 1, g: o_rough, b_value: 0, a_value: 1} }
        TextureGraph: {
          output: o_out, width: tw / 2, height: tw / 4, domain: DomainSphere, format: GraphLinear
        }
      }
    }

    glow {
      if surf_on {
        e_low {
          TexMath: {
            op: MathRemapClamped, a: s_h, from_min: lava_h - 0.1, from_max: lava_h, to_min: 1,
            to_max: 0
          }
        }
        e_crack {
          TexMath: {
            op: MathRemapClamped, a: s_clx, from_min: 0, from_max: 0.6, to_min: crack_glow,
            to_max: 0
          }
        }
        e_v0 { TexMath: {op: MathMax, a: e_low, b: e_crack} }
        e_v { TexMath: {op: MathMultiply, a: e_v0, b_value: {lava_k, 0, 0, 0}} }
        e_col {
          TexRamp: {input: e_v, keys: [
            {0, {0, 0, 0}}
            {0.04, {36, 4, 0}}
            {0.25, {160, 28, 6}}
            {0.6, {250, 96, 18}}
            {1, {255, 176, 70}}
          ]}
        }
        TextureGraph: {output: e_col, width: tw, height: tw / 2, domain: DomainSphere}
      }
    }

    town {
      if surf_on {
        // Density: habitable, watered, flat land, thickest at the coast and in clusters
        w_wet {
          TexMath: {op: MathSmoothstep, a: s_m, b_value: {0.06, 0, 0, 0}, c_value: {0.3, 0, 0, 0}}
        }
        w_coast {
          TexMath: {
            op: MathSmoothstep, a: s_near, b_value: {0.95, 0, 0, 0}, c_value: {0.6, 0, 0, 0}
          }
        }
        w_cst {
          TexMath: {op: MathRemap, a: w_coast, from_min: 0, from_max: 1, to_min: 0.2, to_max: 1}
        }
        w_flat {
          TexMath: {
            op: MathSmoothstep, a: s_slope, b_value: {rock_hi, 0, 0, 0}, c_value: {rock_lo, 0, 0, 0}
          }
        }
        w_cn { TexNoise: {frequency: 5, octaves: 3, seed: sd * 8 + 7} }
        w_cl {
          TexMath: {op: MathSmoothstep, a: w_cn, b_value: {0.47, 0, 0, 0}, c_value: {0.6, 0, 0, 0}}
        }
        w_clr {
          TexMath: {op: MathRemap, a: w_cl, from_min: 0, from_max: 1, to_min: 0.08, to_max: 1}
        }
        w_d0 { TexMath: {op: MathMultiply, a: s_land, b: s_hab} }
        w_d1 { TexMath: {op: MathMultiply, a: w_d0, b: w_wet} }
        w_d2 { TexMath: {op: MathMultiply, a: w_d1, b: w_flat} }
        w_d3 { TexMath: {op: MathMultiply, a: w_d2, b: w_cst} }
        w_d { TexMath: {op: MathMultiply, a: w_d3, b: w_clr} }

        // Towns at the points of cells, lit where the density is at least their id
        w_cells { TexCells: {count: towns, jitter: 1, seed: sd * 8 + 9} }
        w_cx { TexSplit: {input: w_cells, channel: ChannelR} }
        w_cy { TexSplit: {input: w_cells, channel: ChannelG} }
        w_cz { TexSplit: {input: w_cells, channel: ChannelB} }
        w_dot {
          TexMath: {op: MathSmoothstep, a: w_cx, b_value: {0.3, 0, 0, 0}, c_value: {0.05, 0, 0, 0}}
        }
        w_gate { TexMath: {op: MathStep, a: w_d, b: w_cy} }
        w_lit { TexMath: {op: MathMultiply, a: w_dot, b: w_gate} }
        w_br {
          TexMath: {op: MathRemap, a: w_cz, from_min: 0, from_max: 1, to_min: 0.35, to_max: 1}
        }
        w_town { TexMath: {op: MathMultiply, a: w_lit, b: w_br} }
        w_haze { TexMath: {op: MathMultiply, a: w_d, b_value: {0.12, 0, 0, 0}} }
        w_v0 { TexMath: {op: MathAdd, a: w_town, b: w_haze} }
        w_v { TexMath: {op: MathMultiply, a: w_v0, b_value: {city_k, 0, 0, 0}} }
        w_col {
          TexRamp: {input: w_v, keys: [
            {0, {0, 0, 0}}
            {0.02, {0, 0, 0}}
            {0.12, {255, 170, 90}}
            {0.5, {255, 220, 150}}
            {1, {255, 246, 214}}
          ]}
        }
        TextureGraph: {output: w_col, width: tw, height: tw / 2, domain: DomainSphere}
      }
    }

    // Clouds of the seed, swirled by two warps that evolve slowly, stretched along the parallels
    // and banded by latitude: rising at the equator and around 50 degrees, sinking around 30
    cld {
      if surf_on {
        k_time { TexTime: {scale: 0.012, offset: v3 * 40} }
        k_w1 {
          TexNoise: {
            channels: 3, frequency: 1.4, octaves: 2, evolve: k_time, seed: sd * 8 + 10
          }
        }
        k_p1 { TexWarp: {offset: k_w1, amount_value: 2.4} }
        k_w2 {
          TexNoise: {
            coords: k_p1, channels: 3, frequency: 3, octaves: 2, evolve: k_time, seed: sd * 8 + 11
          }
        }
        k_p2 { TexWarp: {coords: k_p1, offset: k_w2, amount_value: 1.2} }
        k_st { TexTransform: {coords: k_p2, scale: {1, 2, 1}} }
        k_n {
          TexNoise: {
            coords: k_st, frequency: 2.2, octaves: oct, gain: 0.55, evolve: k_time,
            seed: sd * 8 + 12
          }
        }
        k_c {
          TexMath: {op: MathRemap, a: k_n, from_min: 0.25, from_max: 0.75, to_min: 0, to_max: 1}
        }
        k_band {
          TexCurve: {input: s_ay, curve: {kind: CurveCatmullRom, keys: [
            {0, 0.1}, {0.2, 0.02}, {0.5, -0.12}, {0.72, 0.08}, {0.88, 0.06}, {1, -0.04}
          ]}}
        }
        k_sum { TexMath: {op: MathAdd, a: k_c, b: k_band} }
        k_d {
          TexMath: {
            op: MathSmoothstep, a: k_sum, b_value: {thr, 0, 0, 0},
            c_value: {thr + 0.18, 0, 0, 0}
          }
        }
        k_s { TexSplat: {in: k_d} }
        k_sh { TexMath: {op: MathMultiply, a: k_s, b_value: {0.22, 0.22, 0.22, 1}} }
        k_out { TexMath: {op: MathAdd, a: k_sh, b_value: {0.78, 0.78, 0.78, 0}} }
        TextureGraph: {output: k_out, width: tw, height: tw / 2, domain: DomainSphere, rate: 12}
      }
    }

    const ready: bool = detail > 0 && alb[TextureStatus].revision > 0
    const lava_ready: bool = lava_on && glow[TextureStatus].revision > 0
    const city_ready: bool = city_on && town[TextureStatus].revision > 0
    const cloud_ready: bool = surf_on && cld[TextureStatus].revision > 0

    axis {
      Position: {0, 0, 0}
      Rotation: {lean, 0, tilt}

      body {
        Position: {0, 0, 0}
        AngularVelocity: {0, spin, 0}
        Sphere: {radius: radius, segments: seg, smooth: true}
        PbrMaterial: {roughness: is_gas ? 0.8 : 0.92}
        NoShadow
        if ready {
          Rgb: {255, 255, 255}
          if is_gas {
            PbrTextures: {albedo: alb}
          } else {
            PbrTextures: {albedo: alb, normal: geo, orm: orm, emissive: glow}
          }
        } else {
          Rgb: {flat.r, flat.g, flat.b}
        }
        if detail <= 0 && air_k > 0.1 {
          Fresnel: {color: {airc.r, airc.g, airc.b}, strength: 0.6 * air_k, power: 2.5}
        }
        if lava_ready {
          Emissive: {strength: 1.8, color: {255, 200, 150}}
        } else if detail <= 0 && heat > 0 && !is_gas {
          Emissive: {strength: 0.3 * heat, color: {255, 96, 32}}
        }
        if city_ready {
          city {
            Position: {0, 0, 0}
            Sphere: {radius: radius * 1.002, segments: seg, smooth: true}
            Rgb: {0, 0, 0}
            PbrMaterial: {roughness: 1}
            Emissive: {strength: 0.6, color: {255, 224, 176}}
            PbrTextures: {emissive: town}
            BlendMode: Max
            NoShadow
            SpatialIgnore
          }
        }
      }

      if cloud_ready && cover > 0.02 {
        clouds {
          Position: {0, 0, 0}
          AngularVelocity: {0, spin * 1.25 + 0.004, 0}
          Sphere: {radius: radius * 1.012, segments: seg, smooth: true}
          Rgb: {mist.r, mist.g, mist.b}
          PbrMaterial: {roughness: 1}
          PbrTextures: {albedo: cld}
          BlendMode: AlphaBlend
          Opacity: {cover}
          Transition: [Opacity: {duration: 2}, Rgb: {duration: 2}]
          NoShadow
          SpatialIgnore
        }
      }

      if rings {
        ring {
          Position: {0, 0, 0}
          Rotation: {0 - PI / 2, 0, 0}
          Quad: {radius * 4.6, radius * 4.6}
          Rgb: {ringc.r * 0.6, ringc.g * 0.6, ringc.b * 0.6}
          PbrMaterial: {roughness: 1}
          Emissive: {strength: 0.4, color: {ringc.r, ringc.g, ringc.b}}
          PbrTextures: {albedo: ring_tex, emissive: ring_tex}
          BlendMode: AlphaBlend
          NoShadow
          SpatialIgnore
        }
        ring_back {
          Position: {0, 0, 0}
          Rotation: {PI / 2, 0, 0}
          Quad: {radius * 4.6, radius * 4.6}
          Rgb: {ringc.r * 0.6, ringc.g * 0.6, ringc.b * 0.6}
          PbrMaterial: {roughness: 1}
          Emissive: {strength: 0.4, color: {ringc.r, ringc.g, ringc.b}}
          PbrTextures: {albedo: ring_tex, emissive: ring_tex}
          BlendMode: AlphaBlend
          NoShadow
          SpatialIgnore
        }
      }
    }
  }
}

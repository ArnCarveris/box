using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.movement
using box.texture
using box.transition
using box.spatial
using box.atmosphere
using box.light
using box.particle

planets {
  struct Col(r: f32, g: f32, b: f32)

  fn h01(seed: i32, salt: i32) -> f32 {
    const x: f64 = sin(seed * 127.1 + salt * 311.7 + 1.3) * 43758.5453
    x - floor(x)
  }

  fn sat(x: f32) -> f32 { clamp(x, 0, 1) }

  // Inverse of the normal distribution at a fraction, by the logistic approximation: the height
  // in standard deviations below which that fraction of a noise lies
  fn probit(f: f32) -> f32 {
    const q: f32 = clamp(f, 0.02, 0.98)
    log(q / (1 - q)) / 1.702
  }

  fn mixc(a: Col, b: Col, t: f32) -> Col {
    {a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t}
  }

  fn mulc(a: Col, b: Col) -> Col { {a.r * b.r / 255, a.g * b.g / 255, a.b * b.b / 255} }

  fn pal_a(i: i32) -> Col {
    match i {
      0: {66, 62, 62}; 1: {112, 104, 98}; 2: {156, 148, 138}; 3: {194, 188, 180}
      4: {168, 112, 66}; 5: {212, 158, 96}; 6: {190, 124, 76}; 7: {142, 88, 60}
      8: {120, 156, 192}; 9: {176, 202, 224}; 10: {214, 228, 240}; 11: {240, 246, 252}
      12: {34, 24, 24}; 13: {54, 42, 40}; 14: {74, 60, 56}; 15: {98, 86, 80}
      20: {156, 136, 96}; 21: {146, 120, 84}; 22: {128, 112, 96}; 23: {150, 146, 142}
      _: {128, 128, 128}
    }
  }

  fn pal_b(i: i32) -> Col {
    match i {
      0: {92, 60, 48}; 1: {140, 92, 66}; 2: {176, 128, 96}; 3: {204, 172, 148}
      4: {190, 150, 84}; 5: {228, 196, 128}; 6: {204, 160, 96}; 7: {160, 116, 70}
      8: {108, 168, 176}; 9: {168, 214, 216}; 10: {208, 236, 236}; 11: {238, 250, 250}
      12: {30, 28, 36}; 13: {48, 46, 56}; 14: {68, 66, 76}; 15: {92, 90, 100}
      20: {170, 120, 86}; 21: {150, 104, 76}; 22: {120, 100, 92}; 23: {156, 150, 150}
      _: {128, 128, 128}
    }
  }

  fn pal(kind: i32, lvl: i32, v: f32) -> Col {
    mixc(pal_a(kind * 4 + lvl), pal_b(kind * 4 + lvl), v)
  }

  // Bare ground of a kind at a palette level, darkened where wet and parched where hot: the
  // keys of the ramp of the ground by altitude
  fn ground(kind: i32, v: f32, lvl: i32, e: f32, hot: f32, wet: f32) -> Col {
    const base: Col = mixc(pal(kind, lvl, v), {112, 92, 70}, wet * 0.35 * sat(1 - e * 2))
    const parched: Col = mixc(base, {150, 84, 50}, hot * 0.4)
    mixc(parched, {52, 34, 30}, sat(hot * 2.5 - 1.5) * 0.7)
  }

  fn sea_col(depth: i32, vs: f32, frozen: f32, hot: f32) -> Col {
    const a: Col = match depth {
      0: {4, 14, 52}; 1: {8, 38, 96}; 2: {12, 60, 122}; _: {26, 96, 140}
    }
    const b: Col = match depth {
      0: {4, 26, 52}; 1: {8, 56, 88}; 2: {14, 84, 108}; _: {36, 122, 136}
    }
    const ice: Col = match depth {
      0: {150, 186, 216}; 1: {176, 206, 228}; 2: {200, 222, 238}; _: {222, 236, 246}
    }
    const w: Col = mixc(mixc(a, b, vs), {70, 96, 84}, hot * 0.5)
    mixc(w, ice, frozen)
  }

  fn gas_col(p: i32, i: i32) -> Col {
    match p * 5 + i {
      0: {214, 186, 148}; 1: {168, 118, 82}; 2: {236, 220, 190}; 3: {142, 92, 66}
      4: {198, 152, 110}
      5: {70, 110, 190}; 6: {40, 66, 150}; 7: {120, 170, 226}; 8: {30, 48, 120}; 9: {86, 136, 206}
      10: {226, 204, 140}; 11: {196, 168, 104}; 12: {240, 228, 180}; 13: {170, 140, 90}
      14: {214, 190, 128}
      15: {104, 176, 168}; 16: {58, 128, 132}; 17: {160, 216, 200}; 18: {40, 96, 110}
      19: {120, 190, 176}
      20: {186, 132, 170}; 21: {120, 78, 140}; 22: {226, 184, 196}; 23: {88, 56, 116}
      24: {170, 112, 160}
      _: {200, 200, 200}
    }
  }

  fn haze(kind: i32) -> Col {
    match kind {
      0: {170, 150, 130}; 1: {232, 160, 96}; 2: {170, 214, 240}; 3: {255, 104, 48}
      4: {190, 200, 220}
      _: {150, 180, 230}
    }
  }

  // Tint of the bands of a gas giant of the presets, a giant of a temperate equator
  fn gas_white() -> Col { {252.98, 253.69, 255} }

  // Color i of the bands of a gas giant of a seed: a palette of the seed, nudged toward the next
  fn gas_tone(sd: i32, i: i32, tint: Col) -> Col {
    const gp: i32 = sd % 5
    mulc(mixc(gas_col(gp, i), gas_col((gp + 1) % 5, i), h01(sd, 2) * 0.35), tint)
  }

  // The parameters of a planet, in the units of the generation. Heights are in units of the
  // height map, whose continents are about 0.5 with a standard deviation of 1/6; temperatures
  // are in units of the climate, about 0.15 where the vegetation starts and 0.3 where it thrives;
  // the atmosphere is in km of a planet of 6360 km.

  // The body: radius in world units, the axis tilted by tilt degrees about the view and leaned
  // by lean degrees toward it, spin in radians per second
  struct PlanetBody(radius: f32, tilt: f32, lean: f32, spin: f32)

  // The relief of a rocky planet: the fraction of the surface under the sea, the frequency of
  // the continents and the warp of their coordinates, the height of the mountain ranges and the
  // fraction of the regions they cover, the depth of the craters, the depth of the cracks between
  // the plates, the number of plates and how dark their cracks are, the strength of the normal
  // map, the variation of the ground color and the sand at the shore
  struct PlanetSurface(
    ocean: f32, continents: f32, warp: f32, mountains: f32, mountain_cover: f32, craters: f32,
    cracks: f32, plates: f32, crack_shade: f32, normal: f32, variation: f32, beach: f32)

  // The climate: the temperature at sea level at the equator and at the poles, its fall at the
  // highest ground, the temperature below which the sea freezes and below which the land is
  // snow, the amount of snow, the moisture near the sea, the vegetation cover and the treeline
  // in altitude of 0 (the shore) to 1 (the highest ground)
  struct PlanetClimate(
    equator: f32, poles: f32, lapse: f32, ice: f32, snow_line: f32, snow: f32, moisture: f32,
    vegetation: f32, treeline: f32)

  // The atmosphere: density, a scale of both scatterings, the Rayleigh and Mie scale heights in
  // km and scattering scales, the Mie anisotropy and the tint of the haze. No atmosphere at a
  // density of 0
  struct PlanetAir(
    density: f32, rayleigh_height: f32, rayleigh: f32, mie_height: f32, mie: f32,
    anisotropy: f32, tint: Col)

  // The clouds: the fraction of the sky with some cloud, the opacity of the layer (none below
  // 0.02), the frequency of the weather systems, their speed over the ground in radians per
  // second, how fast they change and their color
  struct PlanetClouds(
    cover: f32, opacity: f32, frequency: f32, speed: f32, evolve: f32, color: Col)

  // The night side: city lights, how densely they fill the habitable land and their brightness
  struct PlanetNight(lights: bool, density: f32, brightness: f32)

  // Lava: the fraction of the lowlands it fills (none at 0), the glow of the cracks between the
  // plates and the strength of its emission
  struct PlanetLava(level: f32, cracks: f32, emission: f32)

  // A gas giant: the frequency of the bands over the sine of the latitude, the turbulence of
  // their edges, how far in degrees the jets drift them, the fraction of cells with a storm and
  // the tint of the colors of the bands, warm for a hot giant and blue for a cold one
  struct PlanetGas(bands: f32, turbulence: f32, drift: f32, storms: f32, tint: Col)

  // Rings: their outer radius in planet radii, opacity and color
  struct PlanetRings(enabled: bool, size: f32, opacity: f32, color: Col)

  // Presets of the kinds (0 rock, 1 desert, 2 ice, 3 lava, 4 gas giant, 5 garden) for a seed
  fn seed_of(seed: i32) -> i32 { seed < 0 ? 0 - seed : seed }

  fn body_preset(seed: i32) -> PlanetBody {
    const v3: f32 = h01(seed_of(seed), 3)
    const v4: f32 = h01(seed_of(seed), 4)
    const lean: f32 = 0.1 + v3 * 0.2
    const tilt: f32 = (v4 - 0.5) * 0.5 + (v4 > 0.5 ? 0.12 : -0.12)
    {radius: 2.2, tilt: tilt * 180 / PI, lean: lean * 180 / PI, spin: 0.12}
  }

  fn surface_preset(kind: i32, seed: i32) -> PlanetSurface {
    const sd: i32 = seed_of(seed)
    const ocean: f32 = match kind { 0: 0.05; 1: 0.05; 2: 0.5; 5: 0.65; _: 0 }
    const continents: f32 = match kind {
      0: 1.1 + (sd % 3) * 0.15; 5: 1.1 + (sd % 3) * 0.15; 1: 1.2 + (sd % 2) * 0.2
      _: 1.4 + (sd % 2) * 0.2
    }
    const mountains: f32 = match kind { 0: 0.12; 1: 0.16; 2: 0.06; 3: 0.1; _: 0.2 }
    const craters: f32 = match kind { 0: 0.5; 1: 0.16; 2: 0.06; _: 0 }
    const cracks: f32 = match kind { 2: 0.03; 3: 0.08; _: 0 }
    const plates: f32 = match kind { 2: 90 + sd % 60; 3: 50 + sd % 40; _: 64 }
    const crack_shade: f32 = match kind { 2: 0.55; 3: 0.8; _: 0 }
    const normal: f32 = match kind { 2: 2.5; 3: 3; _: 3.5 }
    const variation: f32 = match kind { 0: 0.18; 1: 0.25; 5: 0.15; _: 0.12 }
    const beach: f32 = match kind { 0: 0.18; 1: 0.45; 5: 0.45; _: 0 }
    {
      ocean: ocean, continents: continents, warp: 0.8 + h01(sd, 4) * 0.4, mountains: mountains,
      mountain_cover: 0.5 - (h01(sd, 2) - 0.5) * 0.06, craters: craters, cracks: cracks,
      plates: plates, crack_shade: crack_shade, normal: normal, variation: variation, beach: beach
    }
  }

  fn climate_preset(kind: i32) -> PlanetClimate {
    const equator: f32 = match kind { 0: 0.61; 1: 0.88; 2: 0.385; 3: 1.105; 4: 0.61; _: 0.7 }
    const poles: f32 = match kind { 0: -0.029; 1: 0.214; 2: -0.365; 3: 0.451; 4: -0.14; _: -0.05 }
    const lapse: f32 = match kind { 0: 0.1365; 1: 0.186; 2: 0.1695; 3: 0.219; 4: 0.45; _: 0.417 }
    const ice: f32 = match kind { 0: 0.55; 2: 0.85; _: 0.1 }
    const snow_line: f32 = match kind { 0: 0.0486; 1: 0.0684; 3: 0.0596; _: 0.13 }
    const snow: f32 = match kind { 0: 0.48; 1: 0.57; 3: 0.43; 4: 0.85; _: 1 }
    const moisture: f32 = match kind {
      0: 0.0875; 1: 0.1253; 2: 0.7525; 3: 0.0594; 4: 0.35; _: 1
    }
    {
      equator: equator, poles: poles, lapse: lapse, ice: ice, snow_line: snow_line, snow: snow,
      moisture: moisture, vegetation: kind == 5 ? 0.9286 : 0, treeline: kind == 5 ? 0.6675 : 0.2
    }
  }

  fn air_preset(kind: i32, seed: i32) -> PlanetAir {
    const sd: i32 = seed_of(seed)
    const g: Col = mixc(gas_tone(sd, 2, gas_white()), gas_tone(sd, 1, gas_white()), 0.4)
    const g_max: f32 = max(max(g.r, g.g), max(g.b, 1))
    const tint: Col = match kind {
      0: {255, 225, 195}; 1: {255, 175.9, 105.5}; 2: {180.6, 227.4, 255}; 3: {255, 104, 48}
      4: {g.r * 255 / g_max, g.g * 255 / g_max, g.b * 255 / g_max}
      _: {96, 160, 255}
    }
    const density: f32 = match kind { 0: 0.145; 1: 0.28; 2: 0.235; 3: 0.37; 4: 1; _: 0.91 }
    const rayleigh_height: f32 = match kind {
      0: 93.44; 1: 118.08; 2: 63.2; 3: 154.88; 4: 144; _: 158.72
    }
    const rayleigh: f32 = match kind {
      0: 0.094178; 1: 0.022866; 2: 0.094937; 3: 0.028409; 4: 0.015625; _: 0.050403
    }
    const mie_height: f32 = match kind { 0: 17.52; 1: 104.96; 2: 37.92; 3: 140.8; 4: 112; _: 29.76 }
    const mie: f32 = match kind {
      0: 0.171233; 1: 2.134146; 2: 1.740506; 3: 3.125; 4: 0.375; _: 0.100806
    }
    const anisotropy: f32 = match kind { 0: 0.75; 1: 0.4; 2: 0.7; 3: 0.4; 4: 0.5; _: 0.75 }
    {
      density: density, rayleigh_height: rayleigh_height, rayleigh: rayleigh,
      mie_height: mie_height, mie: mie, anisotropy: anisotropy, tint: tint
    }
  }

  fn clouds_preset(kind: i32) -> PlanetClouds {
    const cover: f32 = match kind {
      0: 0.225981; 1: 0.242414; 2: 0.265788; 3: 0.241962; 4: 0.22; _: 0.55
    }
    const opacity: f32 = match kind {
      0: 0.018125; 1: 0.067921; 2: 0.13875; 3: 0.066553; 4: 0; _: 1
    }
    const color: Col = match kind {
      0: {204, 192, 180}; 1: {241.2, 198, 159.6}; 3: {255, 141.8, 99.8}; _: {255, 255, 255}
    }
    {
      cover: cover, opacity: opacity, frequency: 1.8, speed: 0.034, evolve: 0.01, color: color
    }
  }

  fn night_preset(kind: i32) -> PlanetNight {
    {lights: kind == 5, density: 1.6, brightness: 0.6}
  }

  fn lava_preset(kind: i32) -> PlanetLava {
    {level: kind == 3 ? 0.14 : 0, cracks: kind == 3 ? 0.7 : 0, emission: 1.8}
  }

  fn gas_preset(seed: i32) -> PlanetGas {
    const sd: i32 = seed_of(seed)
    {
      bands: 13 + h01(sd, 1) * 6, turbulence: 0.07, drift: 35 + h01(sd, 2) * 20,
      storms: 0.12 + h01(sd, 4) * 0.12, tint: gas_white()
    }
  }

  fn rings_preset(kind: i32, seed: i32) -> PlanetRings {
    const sd: i32 = seed_of(seed)
    const dust: Col = mixc({214, 204, 184}, {196, 170, 140}, h01(sd, 1))
    const ice: Col = mixc(gas_tone(sd, 2, gas_white()), {255, 255, 255}, 0.4)
    {enabled: kind == 4, size: 2.3, opacity: 1, color: mixc(dust, ice, kind == 4 ? 0.35 : 0)}
  }

  const garden_body: PlanetBody = body_preset(23)
  const garden_surface: PlanetSurface = surface_preset(5, 23)
  const garden_climate: PlanetClimate = climate_preset(5)
  const garden_air: PlanetAir = air_preset(5, 23)
  const garden_clouds: PlanetClouds = clouds_preset(5)
  const garden_night: PlanetNight = night_preset(5)
  const garden_lava: PlanetLava = lava_preset(5)
  const garden_gas: PlanetGas = gas_preset(23)
  const garden_rings: PlanetRings = rings_preset(5, 23)

  ring_tex { Path: {path: "etc/scenes/planet/assets/rings.png"} }

  // A planet whose maps are texture graphs on the sphere domain, from its kind (the palettes and
  // whether it is a rocky planet or a gas giant), seed, detail and parameters, which default to a
  // garden planet. For a kind and a detail the nodes are fixed: the parameters and the seed
  // change the values of nodes only, so no parameter compiles a graph again. A feature that is
  // off keeps its nodes with a zero contribution.
  //
  // One height (s_h) feeds every map of a rocky planet: warped fbm continents, ridged mountain
  // ranges masked to some regions, craters and, for ice and lava, cracked plates. The climate
  // follows from it: a temperature (s_t) from the latitude and the altitude, a moisture (s_m)
  // from the distance to the sea (the land mask blurred) and the latitude bands. The land is the
  // ground of the kind by altitude, covered by the vegetation of the biome table (lut, by
  // temperature and moisture), rock on steep ground, sand at the coast and snow where it is
  // cold; the sea is tinted by depth and freezes where it is cold. The clouds (cld) and the
  // bands of a gas giant are animated.
  template Planet {
    prop kind: i32 = 5
    prop seed: i32 = 23
    prop detail: i32 = 1
    prop body: PlanetBody = garden_body
    prop surface: PlanetSurface = garden_surface
    prop climate: PlanetClimate = garden_climate
    prop air: PlanetAir = garden_air
    prop clouds: PlanetClouds = garden_clouds
    prop night: PlanetNight = garden_night
    prop lava: PlanetLava = garden_lava
    prop gas: PlanetGas = garden_gas
    prop rings: PlanetRings = garden_rings

    const is_gas: bool = kind == 4
    const k: i32 = (kind < 0 || kind > 5) ? 0 : kind
    const radius: f32 = body.radius
    const w: f32 = is_gas ? 0 : sat(surface.ocean)
    const has_sea: bool = w > 0

    const sd: i32 = seed_of(seed)
    const v1: f32 = h01(sd, 1)
    const v2: f32 = h01(sd, 2)
    const v3: f32 = h01(sd, 3)
    const v4: f32 = h01(sd, 4)

    // The ground parches and the sea turns murky with the heat of the equator
    const t: f32 = (climate.equator - 0.25) / 0.9
    const hot: f32 = sat((t - 0.62) / 0.38)
    const s0: Col = sea_col(0, v3, 0, hot)
    const s1: Col = sea_col(1, v3, 0, hot)
    const s2: Col = sea_col(2, v3, 0, hot)
    const s3: Col = sea_col(3, v3, 0, hot)

    const g0: Col = gas_tone(sd, 0, gas.tint)
    const g1: Col = gas_tone(sd, 1, gas.tint)
    const g2: Col = gas_tone(sd, 2, gas.tint)
    const g3: Col = gas_tone(sd, 3, gas.tint)
    const g4: Col = gas_tone(sd, 4, gas.tint)

    const lava_on: bool = !is_gas && detail > 0 && lava.level > 0
    const city_on: bool = !is_gas && detail > 0 && night.lights && !lava_on

    const air_on: bool = detail > 0 && air.density > 0
    const air_k: f32 = min(air.density, 1)
    const tint: Col = air.tint

    const tw: i32 = detail > 1 ? 1024 : 512
    const seg: i32 = detail > 1 ? 96 : (detail > 0 ? 48 : 20)
    const oct: i32 = detail > 1 ? 7 : 6
    const lean: f32 = body.lean * PI / 180
    const tilt: f32 = body.tilt * PI / 180
    const surf_on: bool = detail > 0 && !is_gas
    const gas_on: bool = detail > 0 && is_gas

    // Height: fbm continents at warped coordinates with unwarped detail, remapped to about 0.5
    // with a standard deviation of 1/6 over the sphere, so the sea level that leaves a fraction w
    // of the surface under water is their quantile. Mountain ranges, craters and cracked plates
    // are added on top
    const f1: f32 = surface.continents
    const warp_amt: f32 = surface.warp
    const mtn: f32 = surface.mountains
    const mtn_lo: f32 = 1 - surface.mountain_cover
    const crater: f32 = surface.craters
    const crack: f32 = surface.cracks
    const cn: i32 = max(surface.plates, 1)
    const sea_h: f32 = has_sea ? 0.5 + probit(w) / 6 : -1
    const base_h: f32 = has_sea ? sea_h : 0.15
    const top_h: f32 = max(0.92 + mtn * 0.6, base_h + 0.25)
    const nstr: f32 = surface.normal
    const rock_lo: f32 = 0.25
    const rock_hi: f32 = 0.5

    // Climate: the temperature at sea level falls from t_eq at the equator to t_pole at the
    // poles and by t_alt at the highest ground; below sn_t it snows. The moisture is wet near
    // the sea, at the equator and around 55 degrees and dry around 30 degrees and inland
    const t_eq: f32 = climate.equator
    const t_pole: f32 = climate.poles
    const t_alt: f32 = climate.lapse
    const freeze: f32 = climate.ice
    const wet: f32 = climate.moisture
    const snow_k: f32 = climate.snow
    const sn_t: f32 = climate.snow_line
    const sand: f32 = has_sea ? surface.beach : 0
    const veg_k: f32 = climate.vegetation
    const tl_hi: f32 = climate.treeline
    const tl_lo: f32 = tl_hi - 0.25
    const gvar: f32 = surface.variation
    const crack_k: f32 = surface.crack_shade
    const crack_c: Col = mixc({150, 98, 70}, {26, 12, 10}, k == 3 ? 1 : 0)

    // Colors of the ramps
    const tc0: Col = ground(k, v1, 0, 0, hot, w)
    const tc1: Col = ground(k, v1, 1, 0.22, hot, w)
    const tc2: Col = ground(k, v1, 2, 0.55, hot, w)
    const tc3: Col = ground(k, v1, 3, 0.95, hot, w)
    const rk0: Col = mixc(tc1, {92, 88, 84}, 0.5)
    const rk1: Col = mixc(tc2, {120, 116, 112}, 0.45)
    const gr2: Col = mixc({118, 140, 66}, {96, 136, 80}, v2)
    const fo2: Col = mixc({36, 82, 36}, {30, 74, 52}, v2)

    // Color of the planet until its maps are ready and without them: the low ground, its
    // vegetation, the sea and the sea ice
    const frost: f32 = sat((freeze - 0.1) / 0.75)
    const lowland: Col = mixc(tc1, gr2, veg_k * 0.6)
    const far: Col = mixc(mixc(lowland, s1, sat(w * 1.3)), {236, 242, 250}, frost * 0.6)
    const flat: Col = mixc(far, g0, is_gas ? 1 : 0)

    // Lava fills the lowlands up to lava_h and glows in the cracks of the plates
    const lava_h: f32 = 0.5 + probit(max(lava.level, 0.02)) / 6
    const lava_k: f32 = lava_on ? 1 : 0
    const crack_glow: f32 = lava.cracks

    // City lights: towns at the points of cells, lit where the density beats their id
    const city_k: f32 = city_on ? 1 : 0
    const towns: i32 = detail > 1 ? 9000 : 3000

    // Clouds: a fraction cf of the sky has some cloud, thr the threshold of the noise in
    // standard deviations that leaves it
    const cf: f32 = clouds.cover
    const thr: f32 = 1.28 * probit(1 - cf)

    // Gas giants: zones and belts from the sine of the latitude, jets that drift the bands
    // back and forth by up to drift degrees over a period of 20 minutes, storm ovals on a
    // fraction of the cells, held between two jets
    const bf: f32 = gas.bands
    const drift: f32 = gas.drift
    const storm_frac: f32 = gas.storms
    const turb: f32 = gas.turbulence
    const st0: Col = mixc(g3, {196, 84, 56}, 0.65)
    const st1: Col = mixc(g2, {250, 246, 236}, 0.7)
    const ringc: Col = rings.color

    if air_on {
      PlanetAtmosphere: {
        radius: radius
        thickness: max(air.rayleigh_height, air.mie_height) * 6
        rayleigh: {
          scale_height: air.rayleigh_height, scattering_scale: air.rayleigh * air.density
        }
        mie: {
          scale_height: air.mie_height, anisotropy: air.anisotropy,
          scattering_scale: air.mie * air.density, tint: {tint.r, tint.g, tint.b}
        }
        ozone_scale: 0
      }
    }

    lut {}
    geo {}
    alb {}
    orm {}
    glow {}
    town {}
    cld {}

    if surf_on {
      // Continents
      s_wn { nodes.Noise: {channels: 3, frequency: 1.3, octaves: 3, seed: sd * 16 + 2} }
      s_wp { nodes.Warp: {offset: s_wn, amount_value: warp_amt} }
      s_cn { nodes.Noise: {coords: s_wp, frequency: f1, octaves: 5, seed: sd * 16 + 1} }
      s_dn { nodes.Noise: {frequency: 12, octaves: oct - 3, seed: sd * 16 + 9} }
      s_dt {
        nodes.Remap: {input: s_dn, from_min: 0, from_max: 1, to_min: -0.07, to_max: 0.07}
      }
      s_cd { nodes.Add: {a: s_cn, b: s_dt} }
      s_c {
        nodes.Remap: {input: s_cd, from_min: 0.25, from_max: 0.75, to_min: 0, to_max: 1}
      }

      // Mountain ranges: ridged noise in some regions, rising inland from the coast
      s_rn {
        nodes.Noise: {
          coords: s_wp, frequency: 2.4, octaves: oct - 1, fractal: NoiseRidged, seed: sd * 16 + 3
        }
      }
      s_r {
        nodes.Smoothstep: {input: s_rn, edge0_value: {0.45, 0, 0, 0}, edge1_value: {1, 0, 0, 0}}
      }
      s_mn { nodes.Noise: {frequency: 0.9, octaves: 2, seed: sd * 16 + 4} }
      s_mm {
        nodes.Smoothstep: {
          input: s_mn, edge0_value: {mtn_lo, 0, 0, 0}, edge1_value: {mtn_lo + 0.1, 0, 0, 0}
        }
      }
      s_ml {
        nodes.Smoothstep: {
          input: s_c, edge0_value: {sea_h, 0, 0, 0}, edge1_value: {sea_h + 0.08, 0, 0, 0}
        }
      }
      s_m0 { nodes.Multiply: {a: s_r, b: s_mm} }
      s_m1 { nodes.Multiply: {a: s_m0, b: s_ml} }
      s_m2 { nodes.Multiply: {a: s_m1, b_value: {mtn, 0, 0, 0}} }

      // Craters of two sizes: bowls with a rim, deeper the wider they are, around the points
      // of cells whose size is random
      s_k1 { nodes.Cells: {count: 60, jitter: 0.9, seed: sd * 16 + 5} }
      s_k1d { nodes.Split: {input: s_k1, channel: ChannelR} }
      s_k1z { nodes.Split: {input: s_k1, channel: ChannelB} }
      s_k1r {
        nodes.Remap: {input: s_k1z, from_min: 0, from_max: 1, to_min: 0.08, to_max: 0.32}
      }
      s_k1n { nodes.Divide: {a: s_k1d, b: s_k1r} }
      s_k1p {
        nodes.Curve: {input: s_k1n, curve: {kind: CurveCatmullRom, keys: [
          {0, -1}, {0.5, -0.85}, {0.85, -0.2}, {1, 0.3}, {1.3, 0.06}, {1.8, 0}, {4, 0}
        ]}}
      }
      s_k1h { nodes.Multiply: {a: s_k1p, b: s_k1r} }
      s_k2 { nodes.Cells: {count: 700, jitter: 0.9, seed: sd * 16 + 6} }
      s_k2d { nodes.Split: {input: s_k2, channel: ChannelR} }
      s_k2z { nodes.Split: {input: s_k2, channel: ChannelB} }
      s_k2r {
        nodes.Remap: {input: s_k2z, from_min: 0, from_max: 1, to_min: 0.04, to_max: 0.12}
      }
      s_k2n { nodes.Divide: {a: s_k2d, b: s_k2r} }
      s_k2p {
        nodes.Curve: {input: s_k2n, curve: {kind: CurveCatmullRom, keys: [
          {0, -1}, {0.5, -0.85}, {0.85, -0.2}, {1, 0.3}, {1.3, 0.06}, {1.8, 0}, {4, 0}
        ]}}
      }
      s_k2h { nodes.Multiply: {a: s_k2p, b: s_k2r} }
      s_k0 { nodes.Add: {a: s_k1h, b: s_k2h} }
      s_k { nodes.Multiply: {a: s_k0, b_value: {crater, 0, 0, 0}} }

      // Cracked plates of ice and lava worlds: 0 on the border of two cells
      s_cl {
        nodes.Cells: {
          coords: s_wp, count: cn, jitter: 1, distance: CellsEdge, edge: 0.25, seed: sd * 16 + 7
        }
      }
      s_clx { nodes.Split: {input: s_cl, channel: ChannelR} }
      s_ck {
        nodes.Remap: {input: s_clx, from_min: 0, from_max: 1, to_min: 0 - crack, to_max: 0}
      }

      // Height, the relief with flat seas, altitude above the sea, land and slope
      s_h0 { nodes.Add: {a: s_c, b: s_m2} }
      s_h1 { nodes.Add: {a: s_h0, b: s_k} }
      s_h { nodes.Add: {a: s_h1, b: s_ck} }
      s_relief { nodes.Max: {a: s_h, b_value: {sea_h, 0, 0, 0}} }
      s_slope { nodes.Slope: {height: s_relief, strength: nstr} }
      s_alt {
        nodes.Remap: {
          input: s_h, from_min: base_h, from_max: top_h, to_min: 0, to_max: 1, clamp: true
        }
      }
      s_land {
        nodes.Smoothstep: {
          input: s_h, edge0_value: {sea_h - 0.002, 0, 0, 0},
          edge1_value: {sea_h + 0.002, 0, 0, 0}
        }
      }

      // Temperature at sea level (s_t0) from the warped latitude, so the climate zones meander,
      // and with the altitude (s_t)
      s_wy { nodes.Split: {input: s_wp, channel: ChannelG} }
      s_ay { nodes.Abs: {input: s_wy} }
      s_y2 { nodes.Multiply: {a: s_wy, b: s_wy} }
      s_tl {
        nodes.Remap: {
          input: s_y2, from_min: 0, from_max: 1, to_min: t_eq, to_max: t_pole
        }
      }
      s_jn { nodes.Noise: {channels: 3, frequency: 2.5, octaves: 3, seed: sd * 16 + 8} }
      s_jt { nodes.Split: {input: s_jn, channel: ChannelR} }
      s_jm { nodes.Split: {input: s_jn, channel: ChannelG} }
      s_jg { nodes.Split: {input: s_jn, channel: ChannelB} }
      s_tj {
        nodes.Remap: {input: s_jt, from_min: 0.4, from_max: 0.6, to_min: -0.05, to_max: 0.05}
      }
      s_t0 { nodes.Add: {a: s_tl, b: s_tj} }
      s_ta { nodes.Multiply: {a: s_alt, b_value: {t_alt, 0, 0, 0}} }
      s_t { nodes.Subtract: {a: s_t0, b: s_ta} }
      s_icem {
        nodes.Smoothstep: {
          input: s_t0, edge0_value: {freeze + 0.03, 0, 0, 0},
          edge1_value: {freeze - 0.03, 0, 0, 0}
        }
      }

      // Moisture: the land around (s_near) dries the inland, the latitude bands
      s_near { nodes.Blur: {input: s_land, radius: 24} }
      s_band {
        nodes.Curve: {input: s_ay, curve: {kind: CurveCatmullRom, keys: [
          {0, 1}, {0.2, 0.85}, {0.42, 0.35}, {0.55, 0.35}, {0.78, 0.8}, {0.9, 0.7}, {1, 0.4}
        ]}}
      }
      s_mc {
        nodes.Remap: {
          input: s_near, from_min: 0.35, from_max: 1, to_min: wet,
          to_max: wet * 0.3, clamp: true
        }
      }
      s_mb { nodes.Multiply: {a: s_mc, b: s_band} }
      s_mj {
        nodes.Remap: {input: s_jm, from_min: 0.4, from_max: 0.6, to_min: -0.1, to_max: 0.1}
      }
      s_m { nodes.Add: {a: s_mb, b: s_mj} }
      s_hab {
        nodes.Curve: {input: s_t, curve: {keys: [{0, 0}, {0.16, 0}, {0.32, 1}, {0.8, 1}, {1, 0.2}]}}
      }

      // Biome table: the vegetation by temperature (u) and moisture (v), its cover in alpha
      lut {
        l_uv { nodes.Coords: {} }
        l_t { nodes.Split: {input: l_uv, channel: ChannelR} }
        l_m { nodes.Split: {input: l_uv, channel: ChannelG} }
        l_dry {
          nodes.Ramp: {input: l_t, keys: [
            {0.1, {128, 122, 96}}
            {0.3, {118, 126, 78}}
            {0.55, {gr2.r, gr2.g, gr2.b}}
            {0.78, {160, 150, 82}}
            {1, {176, 152, 92}}
          ]}
        }
        l_wet {
          nodes.Ramp: {input: l_t, keys: [
            {0.1, {88, 96, 74}}
            {0.25, {40, 64, 48}}
            {0.5, {fo2.r, fo2.g, fo2.b}}
            {0.75, {30, 86, 34}}
            {1, {24, 74, 30}}
          ]}
        }
        l_lush {
          nodes.Smoothstep: {input: l_m, edge0_value: {0.3, 0, 0, 0}, edge1_value: {0.7, 0, 0, 0}}
        }
        l_veg { nodes.Mix: {a: l_dry, b: l_wet, factor: l_lush} }
        l_hab {
          nodes.Curve: {
            input: l_t,
            curve: {keys: [{0, 0}, {0.1, 0}, {0.22, 0.6}, {0.3, 1}, {0.85, 1}, {1, 0.6}]}
          }
        }
        l_moist {
          nodes.Smoothstep: {input: l_m, edge0_value: {0.06, 0, 0, 0}, edge1_value: {0.35, 0, 0, 0}}
        }
        l_cov0 { nodes.Multiply: {a: l_hab, b: l_moist} }
        l_cov { nodes.Multiply: {a: l_cov0, b_value: {veg_k, 0, 0, 0}} }
        l_cova { nodes.Splat: {in: l_cov} }
        l_alpha { nodes.Multiply: {a: l_cova, b_value: {0, 0, 0, 1}} }
        l_rgb { nodes.Multiply: {a: l_veg, b_value: {1, 1, 1, 0}} }
        l_out { nodes.Add: {a: l_rgb, b: l_alpha} }
        Graph: {output: l_out, width: 32, height: 32}
      }

      geo {
        n_normal { nodes.Normal: {height: s_relief, strength: nstr} }
        Graph: {
          output: n_normal, width: tw, height: tw / 2, domain: DomainSphere, format: GraphLinear
        }
      }

      // Land: the ground of the kind by altitude, varied by a noise, covered by the vegetation
      // of the biome below the treeline, rock on steep ground, sand at the shore and snow where
      // it is cold. Sea: tinted by depth, frozen where it is cold
      alb {
        a_lut { nodes.Lut: {texture: lut, u: s_t, v: s_m} }
        a_cov0 { nodes.Split: {input: a_lut, channel: ChannelA} }
        a_tree {
          nodes.Smoothstep: {
            input: s_alt, edge0_value: {tl_hi, 0, 0, 0}, edge1_value: {tl_lo, 0, 0, 0}
          }
        }
        a_cov { nodes.Multiply: {a: a_cov0, b: a_tree} }
        a_gv {
          nodes.Remap: {
            input: s_jg, from_min: 0.4, from_max: 0.6, to_min: 0 - gvar, to_max: gvar
          }
        }
        a_gh { nodes.Add: {a: s_alt, b: a_gv} }
        a_ground {
          nodes.Ramp: {input: a_gh, keys: [
            {0, {tc0.r, tc0.g, tc0.b}}
            {0.22, {tc1.r, tc1.g, tc1.b}}
            {0.55, {tc2.r, tc2.g, tc2.b}}
            {0.95, {tc3.r, tc3.g, tc3.b}}
          ]}
        }
        a_land0 { nodes.Mix: {a: a_ground, b: a_lut, factor: a_cov} }
        a_rockm {
          nodes.Smoothstep: {
            input: s_slope, edge0_value: {rock_lo, 0, 0, 0}, edge1_value: {rock_hi, 0, 0, 0}
          }
        }
        a_rock {
          nodes.Ramp: {input: s_alt, keys: [{0, {rk0.r, rk0.g, rk0.b}}, {1, {rk1.r, rk1.g, rk1.b}}]}
        }
        a_land1 { nodes.Mix: {a: a_land0, b: a_rock, factor: a_rockm} }
        a_shore {
          nodes.Smoothstep: {input: s_alt, edge0_value: {0.025, 0, 0, 0}, edge1_value: {0, 0, 0, 0}}
        }
        a_beach { nodes.Multiply: {a: a_shore, b_value: {sand, 0, 0, 0}} }
        a_sand { nodes.Ramp: {keys: [{0, {212, 196, 150}}]} }
        a_land2 { nodes.Mix: {a: a_land1, b: a_sand, factor: a_beach} }
        a_crk {
          nodes.Remap: {
            input: s_clx, from_min: 0, from_max: 0.7, to_min: crack_k, to_max: 0, clamp: true
          }
        }
        a_crc { nodes.Ramp: {keys: [{0, {crack_c.r, crack_c.g, crack_c.b}}]} }
        a_land3 { nodes.Mix: {a: a_land2, b: a_crc, factor: a_crk} }
        a_cold {
          nodes.Smoothstep: {
            input: s_t, edge0_value: {sn_t, 0, 0, 0}, edge1_value: {sn_t - 0.07, 0, 0, 0}
          }
        }
        a_snowm { nodes.Multiply: {a: a_cold, b_value: {snow_k, 0, 0, 0}} }
        a_snow { nodes.Ramp: {keys: [{0, {236, 242, 250}}]} }
        a_land { nodes.Mix: {a: a_land3, b: a_snow, factor: a_snowm} }
        a_shelf {
          nodes.Remap: {
            input: s_h, from_min: sea_h, from_max: sea_h - 0.12, to_min: 0,
            to_max: 1, clamp: true
          }
        }
        a_open {
          nodes.Remap: {
            input: s_near, from_min: 0.35, from_max: 0, to_min: 0.3, to_max: 1, clamp: true
          }
        }
        a_depth { nodes.Multiply: {a: a_shelf, b: a_open} }
        a_water {
          nodes.Ramp: {input: a_depth, keys: [
            {0.02, {s3.r, s3.g, s3.b}}
            {0.12, {s2.r, s2.g, s2.b}}
            {0.4, {s1.r, s1.g, s1.b}}
            {0.9, {s0.r, s0.g, s0.b}}
          ]}
        }
        a_ice { nodes.Ramp: {input: a_depth, keys: [{0, {226, 238, 248}}, {1, {170, 198, 222}}]} }
        a_sea { nodes.Mix: {a: a_water, b: a_ice, factor: s_icem} }
        a_out { nodes.Mix: {a: a_sea, b: a_land, factor: s_land} }
        Graph: {output: a_out, width: tw, height: tw / 2, domain: DomainSphere}
      }

      // Roughness: glossy open sea, rough ice and land
      orm {
        o_sea {
          nodes.Remap: {input: s_icem, from_min: 0, from_max: 1, to_min: 0.42, to_max: 0.85}
        }
        o_rough { nodes.Mix: {a: o_sea, b_value: {1, 0, 0, 0}, factor: s_land} }
        o_out { nodes.Combine: {r_value: 1, g: o_rough, b_value: 0, a_value: 1} }
        Graph: {
          output: o_out, width: tw / 2, height: tw / 4, domain: DomainSphere, format: GraphLinear
        }
      }

      glow {
        e_low {
          nodes.Remap: {
            input: s_h, from_min: lava_h - 0.06, from_max: lava_h, to_min: 1,
            to_max: 0, clamp: true
          }
        }
        e_crack {
          nodes.Remap: {
            input: s_clx, from_min: 0, from_max: 0.5, to_min: crack_glow,
            to_max: 0, clamp: true
          }
        }
        e_v0 { nodes.Max: {a: e_low, b: e_crack} }
        e_v { nodes.Multiply: {a: e_v0, b_value: {lava_k, 0, 0, 0}} }
        e_col {
          nodes.Ramp: {input: e_v, keys: [
            {0, {0, 0, 0}}
            {0.04, {36, 4, 0}}
            {0.25, {160, 28, 6}}
            {0.6, {250, 96, 18}}
            {1, {255, 176, 70}}
          ]}
        }
        Graph: {output: e_col, width: tw, height: tw / 2, domain: DomainSphere}
      }

      // City lights: the density is habitable, watered, flat land, thickest near the coast and
      // in clusters. Cities and smaller towns at the points of two cells light up where the
      // density is at least their id, with a faint glow where it is highest
      town {
        w_wet {
          nodes.Smoothstep: {input: s_m, edge0_value: {0.05, 0, 0, 0}, edge1_value: {0.3, 0, 0, 0}}
        }
        w_coast {
          nodes.Remap: {
            input: s_near, from_min: 0.55, from_max: 0.95, to_min: 1,
            to_max: 0.25, clamp: true
          }
        }
        w_flat {
          nodes.Smoothstep: {
            input: s_slope, edge0_value: {rock_hi, 0, 0, 0}, edge1_value: {rock_lo, 0, 0, 0}
          }
        }
        w_cn { nodes.Noise: {frequency: 3.5, octaves: 3, seed: sd * 16 + 9} }
        w_cl {
          nodes.Smoothstep: {input: w_cn, edge0_value: {0.46, 0, 0, 0}, edge1_value: {0.62, 0, 0, 0}}
        }
        w_d0 { nodes.Multiply: {a: s_land, b: s_hab} }
        w_d1 { nodes.Multiply: {a: w_d0, b: w_wet} }
        w_d2 { nodes.Multiply: {a: w_d1, b: w_flat} }
        w_d3 { nodes.Multiply: {a: w_d2, b: w_coast} }
        w_d4 { nodes.Multiply: {a: w_d3, b: w_cl} }
        w_d { nodes.Multiply: {a: w_d4, b_value: {night.density, 0, 0, 0}} }
        w_c1 { nodes.Cells: {count: towns, jitter: 1, seed: sd * 16 + 10} }
        w_c1x { nodes.Split: {input: w_c1, channel: ChannelR} }
        w_c1y { nodes.Split: {input: w_c1, channel: ChannelG} }
        w_c1z { nodes.Split: {input: w_c1, channel: ChannelB} }
        w_dot1 {
          nodes.Smoothstep: {
            input: w_c1x, edge0_value: {0.22, 0, 0, 0}, edge1_value: {0.03, 0, 0, 0}
          }
        }
        w_g1 { nodes.Step: {input: w_d, edge: w_c1y} }
        w_l1 { nodes.Multiply: {a: w_dot1, b: w_g1} }
        w_b1 {
          nodes.Remap: {input: w_c1z, from_min: 0, from_max: 1, to_min: 0.45, to_max: 1}
        }
        w_t1 { nodes.Multiply: {a: w_l1, b: w_b1} }
        w_c2 { nodes.Cells: {count: towns * 4, jitter: 1, seed: sd * 16 + 11} }
        w_c2x { nodes.Split: {input: w_c2, channel: ChannelR} }
        w_c2y { nodes.Split: {input: w_c2, channel: ChannelG} }
        w_dot2 {
          nodes.Smoothstep: {
            input: w_c2x, edge0_value: {0.16, 0, 0, 0}, edge1_value: {0.02, 0, 0, 0}
          }
        }
        w_d2s { nodes.Multiply: {a: w_d, b_value: {0.45, 0, 0, 0}} }
        w_g2 { nodes.Step: {input: w_d2s, edge: w_c2y} }
        w_l2 { nodes.Multiply: {a: w_dot2, b: w_g2} }
        w_t2 { nodes.Multiply: {a: w_l2, b_value: {0.55, 0, 0, 0}} }
        w_dd { nodes.Multiply: {a: w_d, b: w_d} }
        w_haze { nodes.Multiply: {a: w_dd, b_value: {0.035, 0, 0, 0}} }
        w_v0 { nodes.Max: {a: w_t1, b: w_t2} }
        w_v1 { nodes.Add: {a: w_v0, b: w_haze} }
        w_v { nodes.Multiply: {a: w_v1, b_value: {city_k, 0, 0, 0}} }
        w_col {
          nodes.Ramp: {input: w_v, keys: [
            {0, {0, 0, 0}}
            {0.02, {0, 0, 0}}
            {0.12, {70, 36, 14}}
            {0.35, {255, 160, 80}}
            {0.7, {255, 214, 140}}
            {1, {255, 244, 210}}
          ]}
        }
        Graph: {output: w_col, width: tw, height: tw / 2, domain: DomainSphere}
      }

      // Clouds of the seed: weather systems of a noise that evolves slowly at warped coordinates
      // stretched along the parallels, banded by the latitude (rising at the equator and around
      // 55 degrees, sinking around 30 degrees), their edges broken up by a finer billow noise.
      // The warp, the bands and the billows do not depend on the time, so they are computed
      // once and each update evaluates the coverage only
      cld {
        k_time { nodes.Time: {scale: clouds.evolve, offset: v3 * 40} }
        k_w1 { nodes.Noise: {channels: 3, frequency: 1.2, octaves: 2, seed: sd * 16 + 12} }
        k_p1 { nodes.Warp: {offset: k_w1, amount_value: 0.7} }
        k_st { nodes.Transform: {coords: k_p1, scale: {1, 1.6, 1}} }
        k_n {
          nodes.Noise: {
            coords: k_st, frequency: clouds.frequency, octaves: 3, evolve: k_time,
            seed: sd * 16 + 13
          }
        }
        k_z {
          nodes.Remap: {input: k_n, from_min: 0.49, from_max: 0.585, to_min: 0, to_max: 1}
        }
        k_f {
          nodes.Noise: {
            coords: k_st, frequency: clouds.frequency * 10 / 3, octaves: oct - 2, gain: 0.6,
            fractal: NoiseBillow, seed: sd * 16 + 15
          }
        }
        k_fz {
          nodes.Remap: {input: k_f, from_min: 0.23, from_max: 0.32, to_min: 0, to_max: 0.8}
        }
        k_y { nodes.Split: {input: k_p1, channel: ChannelG} }
        k_ay { nodes.Abs: {input: k_y} }
        k_band {
          nodes.Curve: {input: k_ay, curve: {kind: CurveCatmullRom, keys: [
            {0, 0.7}, {0.15, 0.3}, {0.42, -0.9}, {0.58, -0.3}, {0.8, 0.7}, {0.92, 0.4}, {1, -0.4}
          ]}}
        }
        k_s0 { nodes.Add: {a: k_z, b: k_band} }
        k_sum { nodes.Add: {a: k_s0, b: k_fz} }
        k_d {
          nodes.Smoothstep: {
            input: k_sum, edge0_value: {thr, 0, 0, 0}, edge1_value: {thr + 1.8, 0, 0, 0}
          }
        }
        k_s { nodes.Splat: {in: k_d} }
        k_out {
          nodes.Mix: {a_value: {0.72, 0.74, 0.78, 0}, b_value: {1, 1, 1, 1}, factor: k_s}
        }
        Graph: {output: k_out, width: tw, height: tw / 2, domain: DomainSphere, rate: 3,
          interpolate: true}
      }
    } else if gas_on {
      // Zones and belts from the sine of the latitude, made irregular by a noise of the latitude
      g_dir { nodes.Coords: {} }
      g_y { nodes.Split: {input: g_dir, channel: ChannelG} }
      g_line { nodes.Combine: {r_value: v2 * 7, g: g_y, b_value: v4 * 7, a_value: 1} }
      g_ln { nodes.Noise: {coords: g_line, frequency: 2, octaves: 2, seed: sd * 16 + 3} }
      g_lo {
        nodes.Remap: {input: g_ln, from_min: 0.5, from_max: 1, to_min: 0, to_max: 0.6}
      }
      g_lat { nodes.Add: {a: g_y, b: g_lo} }
      g_ph { nodes.Multiply: {a: g_lat, b_value: {bf, 0, 0, 0}} }
      g_sin { nodes.Sin: {input: g_ph} }

      // The bands in their own frame, computed once: turbulence of warped noise stretched along
      // the bands, wavy band edges and storm ovals held between two jets
      bands {
        b_wn { nodes.Noise: {channels: 3, frequency: 2.5, octaves: 2, seed: sd * 16 + 5} }
        b_wp { nodes.Warp: {offset: b_wn, amount_value: 0.3} }
        b_st { nodes.Transform: {coords: b_wp, scale: {1, 4, 1}} }
        b_tn {
          nodes.Noise: {coords: b_st, frequency: 3, octaves: oct - 1, gain: 0.55, seed: sd * 16 + 6}
        }
        b_wy { nodes.Split: {input: b_wp, channel: ChannelG} }
        b_wl { nodes.Add: {a: b_wy, b: g_lo} }
        b_wph { nodes.Multiply: {a: b_wl, b_value: {bf, 0, 0, 0}} }
        b_ws { nodes.Sin: {input: b_wph} }
        b_sub { nodes.Combine: {r_value: v2 * 7 + 3, g: b_wy, b_value: v4 * 7 + 3, a_value: 1} }
        b_sn { nodes.Noise: {coords: b_sub, frequency: 9, octaves: 3, gain: 0.6, seed: sd * 16 + 1} }
        b_b0 {
          nodes.Remap: {input: b_ws, from_min: -1, from_max: 1, to_min: 0.2, to_max: 0.8}
        }
        b_b1 {
          nodes.Remap: {input: b_sn, from_min: 0.4, from_max: 0.6, to_min: -0.2, to_max: 0.2}
        }
        b_t {
          nodes.Remap: {
            input: b_tn, from_min: 0.4, from_max: 0.6, to_min: 0 - turb, to_max: turb
          }
        }
        b_v0 { nodes.Add: {a: b_b0, b: b_b1} }
        b_v { nodes.Add: {a: b_v0, b: b_t} }
        b_col {
          nodes.Ramp: {input: b_v, keys: [
            {0.15, {g3.r, g3.g, g3.b}}
            {0.35, {g1.r, g1.g, g1.b}}
            {0.5, {g4.r, g4.g, g4.b}}
            {0.65, {g0.r, g0.g, g0.b}}
            {0.85, {g2.r, g2.g, g2.b}}
          ]}
        }
        b_sc { nodes.Transform: {scale: {1, 2.2, 1}} }
        b_cells { nodes.Cells: {coords: b_sc, count: 48, jitter: 0.8, seed: sd * 16 + 4} }
        b_cx { nodes.Split: {input: b_cells, channel: ChannelR} }
        b_cz { nodes.Split: {input: b_cells, channel: ChannelB} }
        b_cw { nodes.Split: {input: b_cells, channel: ChannelA} }
        b_core {
          nodes.Smoothstep: {input: b_cx, edge0_value: {0.42, 0, 0, 0}, edge1_value: {0.34, 0, 0, 0}}
        }
        b_gate { nodes.Step: {input_value: {storm_frac, 0, 0, 0}, edge: b_cz} }
        b_as { nodes.Abs: {input: g_sin} }
        b_pl {
          nodes.Smoothstep: {input: b_as, edge0_value: {0.35, 0, 0, 0}, edge1_value: {0.9, 0, 0, 0}}
        }
        b_st0 { nodes.Multiply: {a: b_core, b: b_gate} }
        b_storm { nodes.Multiply: {a: b_st0, b: b_pl} }
        b_sk { nodes.Multiply: {a: b_storm, b_value: {0.9, 0, 0, 0}} }
        b_ring {
          nodes.Remap: {
            input: b_cx, from_min: 0, from_max: 0.42, to_min: 0.7, to_max: 1.1, clamp: true
          }
        }
        b_scol0 {
          nodes.Ramp: {input: b_cw, keys: [{0, {st0.r, st0.g, st0.b}}, {1, {st1.r, st1.g, st1.b}}]}
        }
        b_scol { nodes.Multiply: {a: b_scol0, b: b_ring} }
        b_out { nodes.Mix: {a: b_col, b: b_scol, factor: b_sk} }
        Graph: {output: b_out, width: tw, height: tw / 2, domain: DomainSphere}
      }

      // Differential rotation: each band turns about the pole at the speed of its jet, the
      // jets alternating with the bands. The angle swings with a period of 20 minutes, so the
      // shear between the bands stays bounded, and the bands are sampled at the turned
      // direction, so an update costs a lookup per texel
      alb {
        a_jet {
          nodes.Smoothstep: {
            input: g_sin, edge0_value: {-0.8, 0, 0, 0}, edge1_value: {0.8, 0, 0, 0}
          }
        }
        a_amp {
          nodes.Remap: {
            input: a_jet, from_min: 0, from_max: 1, to_min: 0 - drift, to_max: drift
          }
        }
        a_time { nodes.Time: {scale: 0.00524, offset: -0.3 - v3 * 0.4} }
        a_swing { nodes.Sin: {input: a_time} }
        a_ang { nodes.Multiply: {a: a_amp, b: a_swing} }
        a_rot { nodes.Transform: {coords: g_dir, angle: a_ang} }
        a_img { nodes.Image: {texture: bands, coords: a_rot} }
        Graph: {output: a_img, width: tw, height: tw / 2, domain: DomainSphere, rate: 12,
          interpolate: true}
      }
    }

    const ready: bool = detail > 0 && alb[box.texture.Status].revision > 0
    const lava_ready: bool = lava_on && glow[box.texture.Status].revision > 0
    const city_ready: bool = city_on && town[box.texture.Status].revision > 0
    const cloud_ready: bool = surf_on && cld[box.texture.Status].revision > 0

    axis {
      Position: {0, 0, 0}
      Rotation: {lean, 0, tilt}

      globe {
        Position: {0, 0, 0}
        AngularVelocity: {0, body.spin, 0}
        Sphere: {radius: radius, segments: seg, smooth: true}
        PbrMaterial: {roughness: is_gas ? 0.8 : 0.92}
        NoShadow
        if ready {
          Rgb: {255, 255, 255}
          if is_gas {
            PbrTextures: {albedo: alb}
          } else {
            PbrTextures: {albedo: alb, normal: geo, orm: orm, emissive: glow}
          }
        } else {
          Rgb: {flat.r, flat.g, flat.b}
        }
        if detail <= 0 && air_k > 0.1 {
          Fresnel: {color: {tint.r, tint.g, tint.b}, strength: 0.6 * air_k, power: 2.5}
        }
        if lava_ready {
          Emissive: {strength: lava.emission, color: {255, 200, 150}}
        } else if detail <= 0 && lava.level > 0 && !is_gas {
          Emissive: {strength: lava.emission / 6, color: {255, 96, 32}}
        }
        if city_ready {
          city {
            Position: {0, 0, 0}
            Sphere: {radius: radius * 1.002, segments: seg, smooth: true}
            Rgb: {0, 0, 0}
            PbrMaterial: {roughness: 1}
            Emissive: {strength: night.brightness, color: {255, 224, 176}}
            PbrTextures: {emissive: town}
            BlendMode: Max
            NoShadow
            Ignore
          }
        }
      }

      if cloud_ready && clouds.opacity > 0.02 {
        cloud_layer {
          Position: {0, 0, 0}
          AngularVelocity: {0, body.spin + clouds.speed, 0}
          Sphere: {radius: radius * 1.012, segments: seg, smooth: true}
          Rgb: {clouds.color.r, clouds.color.g, clouds.color.b}
          PbrMaterial: {roughness: 1}
          PbrTextures: {albedo: cld}
          BlendMode: AlphaBlend
          Opacity: {clouds.opacity}
          Transition: [Opacity: {duration: 2}, Rgb: {duration: 2}]
          NoShadow
          Ignore
        }
      }

      if rings.enabled {
        ring {
          Position: {0, 0, 0}
          Rotation: {0 - PI / 2, 0, 0}
          Quad: {radius * rings.size * 2, radius * rings.size * 2}
          Rgb: {ringc.r * 0.6, ringc.g * 0.6, ringc.b * 0.6}
          PbrMaterial: {roughness: 1}
          Emissive: {strength: 0.4, color: {ringc.r, ringc.g, ringc.b}}
          PbrTextures: {albedo: ring_tex, emissive: ring_tex}
          BlendMode: AlphaBlend
          if rings.opacity < 1 {
            Opacity: {rings.opacity}
          }
          NoShadow
          Ignore
        }
        ring_back {
          Position: {0, 0, 0}
          Rotation: {PI / 2, 0, 0}
          Quad: {radius * rings.size * 2, radius * rings.size * 2}
          Rgb: {ringc.r * 0.6, ringc.g * 0.6, ringc.b * 0.6}
          PbrMaterial: {roughness: 1}
          Emissive: {strength: 0.4, color: {ringc.r, ringc.g, ringc.b}}
          PbrTextures: {albedo: ring_tex, emissive: ring_tex}
          BlendMode: AlphaBlend
          if rings.opacity < 1 {
            Opacity: {rings.opacity}
          }
          NoShadow
          Ignore
        }
      }
    }
  }

  // Color of a black body at a temperature in kelvin, display encoded with the brightest channel
  // at 255: the fit of Tanner Helland to the blackbody colors, red below about 3000 K, white
  // around 6600 K and blue above
  fn blackbody(kelvin: f32) -> Col {
    const t: f32 = clamp(kelvin, 1000, 40000) / 100
    const r: f32 = t <= 66 ? 255 : 329.698727446 * pow(max(t - 60, 1), 0 - 0.1332047592)
    const g_lo: f32 = 99.4708025861 * log(t) - 161.1195681661
    const g_hi: f32 = 288.1221695283 * pow(max(t - 60, 1), 0 - 0.0755148492)
    const g: f32 = t <= 66 ? g_lo : g_hi
    const b_lo: f32 = 138.5177312231 * log(max(t - 10, 1)) - 305.0447927307
    const b: f32 = t >= 66 ? 255 : (t <= 19 ? 0 : b_lo)
    {clamp(r, 0, 255), clamp(g, 0, 255), clamp(b, 0, 255)}
  }

  // Emission of a star surface of a temperature, in the units of Emissive.strength: it rises
  // slowly with the temperature, so a hot star blooms more while the disc keeps its color and
  // its limb darkening through the tonemapper
  fn star_emission(kelvin: f32) -> f32 { 3.2 * pow(max(kelvin, 1000) / 5772, 0.25) }

  // Light of a star: its luminosity, the square of the radius times the fourth power of the
  // temperature relative to the sun, compressed by a square root so every preset lights a scene
  fn star_light(kelvin: f32, radius: f32) -> f32 {
    const l: f32 = radius * radius / 2.56 * pow(max(kelvin, 1000) / 5772, 4)
    40 * sqrt(l)
  }

  // Limb darkening coefficient of a star, u of the law 1 - u (1 - mu)^0.8: stronger than the
  // linear law of the sun (about 0.6) so the tonemapped disc still darkens visibly to the edge,
  // and a little weaker for hot stars
  fn limb_coefficient(kelvin: f32) -> f32 { clamp(1.05 - kelvin * 0.00001, 0.8, 0.95) }

  // The parameters of a star: the surface temperature in kelvin, the radius in world units, the
  // sunspot amount (0 none to 1 a very active star), the size of the granules relative to those
  // of the sun, the contrast of the granulation, the amount of prominences on the limb and the
  // spin in radians per second and the strength of the glow of the corona and the halo
  struct StarParams(
    temperature: f32, radius: f32, sunspots: f32, granulation: f32, contrast: f32,
    prominences: f32, spin: f32, corona: f32)

  // Presets of the star types: 0 red dwarf, 1 yellow dwarf (the sun), 2 white, 3 blue giant,
  // 4 red giant
  fn star_preset(kind: i32) -> StarParams {
    match kind {
      0: {3100, 1.1, 0.7, 0.8, 0.38, 0.7, 0.14, 1}
      1: {5772, 1.6, 0.35, 1, 0.3, 0.3, 0.05, 1}
      2: {9600, 1.8, 0, 0.7, 0.16, 0.05, 0.16, 1}
      3: {24000, 2.8, 0, 1.6, 0.14, 0.2, 0.1, 1}
      4: {3600, 3.6, 0.15, 3.2, 0.42, 0.25, 0.02, 1}
      _: {5772, 1.6, 0.35, 1, 0.3, 0.3, 0.05, 1}
    }
  }

  // Distance of the camera that frames a star of a radius with its corona
  fn star_distance(radius: f32) -> f32 { 18 * radius + 2 }

  const sun_star: StarParams = star_preset(1)

  // A star of a temperature, radius, activity, spin, seed and detail, which default to the sun.
  // It is lit by nothing: its base color is black and metallic, so neither the directional sun
  // of the scene nor the ambient light reach it, and all it shows is its emission.
  //
  // The surface (surf) is an animated texture graph on the sphere domain: granules of cells
  // whose points move with the time, the network of supergranules, sunspots
  // with umbra and penumbra in two latitude bands and bright faculae around them. It is the
  // brightness of the surface relative to the photosphere, the spots redder, which the Emissive
  // colors by the temperature, so a temperature changes no texel. As for the planets, the
  // parameters change the values of nodes only, so no slider compiles a graph again.
  //
  // The limb darkens and reddens by a shell just above the surface that blends toward a cooler
  // color by a Fresnel opacity of power 0.8, close to the linear limb darkening law, from any
  // angle. The corona is camera facing sprites of streamers around the center, hidden by the
  // disc where they cross it, and a wider soft halo; active stars throw prominences off their
  // surface. A point light of the color of the star lights what is around it.
  template Star {
    prop temperature: f32 = sun_star.temperature
    prop radius: f32 = sun_star.radius
    prop sunspots: f32 = sun_star.sunspots
    prop granulation: f32 = sun_star.granulation
    prop contrast: f32 = sun_star.contrast
    prop prominences: f32 = sun_star.prominences
    prop spin: f32 = sun_star.spin
    prop corona: f32 = sun_star.corona
    prop seed: i32 = 7
    prop detail: i32 = 1

    const sd: i32 = seed_of(seed)
    const v1: f32 = h01(sd, 1)
    const v2: f32 = h01(sd, 2)
    const v3: f32 = h01(sd, 3)

    const r: f32 = max(radius, 0.1)
    const col: Col = blackbody(temperature)
    const limb_col: Col = blackbody(temperature * 0.7)
    const hal_col: Col = mixc(col, {255, 255, 255}, 0.2)
    const prom_col: Col = mixc(col, {255, 120, 80}, 0.5)
    const glow: f32 = star_emission(temperature)
    const limb_u: f32 = limb_coefficient(temperature)

    const tw: i32 = detail > 1 ? 1024 : (detail > 0 ? 512 : 256)
    const seg: i32 = detail > 1 ? 96 : (detail > 0 ? 64 : 32)

    // Granulation: about gcount granules over the sphere, fewer for larger granules and never
    // smaller than about 7 texels, gcell the size of one in radians
    const gsize: f32 = clamp(granulation, 0.3, 5)
    const gcount: i32 = max(min(5200 / (gsize * gsize), tw * tw / 50), 12)
    const gcell: f32 = sqrt(4 * PI / gcount)
    const gc: f32 = clamp(contrast, 0, 1)

    // Sunspots: the spot noise plus the latitude bands beats sp_th in the penumbra and a little
    // more in the umbra; faculae brighten the network around them
    const spots: f32 = sat(sunspots)
    const sp_th: f32 = spots > 0.005 ? 0.75 - 0.17 * spots : 9
    const fac_k: f32 = 0.12 + 0.5 * spots

    const prom: f32 = sat(prominences)
    const cor: f32 = max(corona, 0)

    surf {
      t_g { nodes.Time: {scale: 0.3, offset: v1 * 60} }
      t_s { nodes.Time: {scale: 0.04, offset: v2 * 60} }

      // Granules: bright cells with dark lanes between them, the points of the cells moving
      // with the time, each cell a little brighter or darker
      g_wn {
        nodes.Noise: {
          channels: 3, frequency: 1.4 / gcell, octaves: 2, evolve: t_g, seed: sd * 16 + 1
        }
      }
      g_wp { nodes.Warp: {offset: g_wn, amount_value: gcell * 0.7} }
      g_c {
        nodes.Cells: {
          coords: g_wp, count: gcount, jitter: 1, distance: CellsEdge, edge: 0.3,
          evolve: t_g, seed: sd * 16 + 2
        }
      }
      g_e { nodes.Split: {input: g_c, channel: ChannelR} }
      g_z { nodes.Split: {input: g_c, channel: ChannelB} }
      g_ez {
        nodes.Remap: {input: g_z, from_min: 0, from_max: 1, to_min: -0.12, to_max: 0.12}
      }
      g_fn {
        nodes.Noise: {
          frequency: 3.5 / gcell, octaves: detail > 1 ? 2 : 1, evolve: t_g, seed: sd * 16 + 3
        }
      }
      g_fd {
        nodes.Remap: {input: g_fn, from_min: 0.3, from_max: 0.7, to_min: -0.1, to_max: 0.1}
      }
      g_s0 { nodes.Add: {a: g_e, b: g_ez} }
      g_raw { nodes.Add: {a: g_s0, b: g_fd} }
      g_v {
        nodes.Remap: {input: g_raw, from_min: 0, from_max: 1, to_min: 1 - gc, to_max: 1}
      }

      // The network of the supergranules, about 25 granules across, bright on their borders
      n_c {
        nodes.Cells: {
          count: max(gcount / 25, 8), jitter: 1, distance: CellsEdge, edge: 0.12, evolve: t_s,
          seed: sd * 16 + 4
        }
      }
      n_x { nodes.Split: {input: n_c, channel: ChannelR} }
      n_net {
        nodes.Remap: {input: n_x, from_min: 0, from_max: 1, to_min: 1, to_max: 0, clamp: true}
      }

      // Sunspots: a slowly changing noise, held to two bands from about 5 to 35 degrees of
      // latitude, a penumbra where it beats the threshold and an umbra inside it
      s_n {
        nodes.Noise: {
          frequency: 5, octaves: detail > 1 ? 5 : 4, evolve: t_s, seed: sd * 16 + 5
        }
      }
      s_uv { nodes.Coords: {} }
      s_y { nodes.Split: {input: s_uv, channel: ChannelG} }
      s_ay { nodes.Abs: {input: s_y} }
      s_band {
        nodes.Curve: {input: s_ay, curve: {kind: CurveCatmullRom, keys: [
          {0, -0.25}, {0.08, -0.06}, {0.18, 0}, {0.48, 0}, {0.62, -0.12}, {0.8, -0.45},
          {1, -0.6}
        ]}}
      }
      s_v { nodes.Add: {a: s_n, b: s_band} }
      s_pen {
        nodes.Smoothstep: {
          input: s_v, edge0_value: {sp_th, 0, 0, 0}, edge1_value: {sp_th + 0.012, 0, 0, 0}
        }
      }
      s_umb {
        nodes.Smoothstep: {
          input: s_v, edge0_value: {sp_th + 0.03, 0, 0, 0},
          edge1_value: {sp_th + 0.045, 0, 0, 0}
        }
      }

      // Faculae: the network in the active regions around the spots, and a bright ring at
      // their edge
      f_act {
        nodes.Smoothstep: {
          input: s_v, edge0_value: {sp_th - 0.16, 0, 0, 0},
          edge1_value: {sp_th - 0.01, 0, 0, 0}
        }
      }
      f_ring {
        nodes.Smoothstep: {
          input: s_v, edge0_value: {sp_th - 0.07, 0, 0, 0},
          edge1_value: {sp_th - 0.01, 0, 0, 0}
        }
      }
      f_net { nodes.Multiply: {a: n_net, b: f_act} }
      f_rk { nodes.Multiply: {a: f_ring, b_value: {0.6, 0, 0, 0}} }
      f_m { nodes.Max: {a: f_net, b: f_rk} }
      f_k { nodes.Multiply: {a: f_m, b_value: {fac_k, 0, 0, 0}} }
      f_up { nodes.Add: {a: f_k, b_value: {1, 0, 0, 0}} }

      // Brightness: the granules, brightened by the faculae, darkened in the penumbra and more
      // in the umbra, and the spots redder
      i_0 { nodes.Multiply: {a: g_v, b: f_up} }
      i_pm {
        nodes.Remap: {input: s_pen, from_min: 0, from_max: 1, to_min: 1, to_max: 0.52}
      }
      i_1 { nodes.Multiply: {a: i_0, b: i_pm} }
      i_um {
        nodes.Remap: {input: s_umb, from_min: 0, from_max: 1, to_min: 1, to_max: 0.25}
      }
      i_2 { nodes.Multiply: {a: i_1, b: i_um} }
      c_cool { nodes.Add: {a: s_pen, b: s_umb} }
      c_tint {
        nodes.Ramp: {input: c_cool, keys: [
          {0, {255, 255, 255}}
          {1, {255, 222, 196}}
          {2, {255, 168, 118}}
        ]}
      }
      out { nodes.Multiply: {a: c_tint, b: i_2} }
      Graph: {
        output: out, width: tw, height: tw / 2, domain: DomainSphere, format: GraphHdr,
        rate: detail > 1 ? 10 : 8, interpolate: true
      }
    }

    // A streamer of the corona, a sprite whose alpha is 1 inside the disc (at 0.2 of the
    // sprite from the center), falls off beyond it and is broken up into rays by a noise of the
    // angle around the center
    streamer {
      c_uv { nodes.Coords: {} }
      c_p { nodes.Subtract: {a: c_uv, b_value: {0.5, 0.5, 0, 0}} }
      c_r { nodes.Length: {input: c_p} }
      c_dir { nodes.Normalize: {input: c_p} }
      c_dn { nodes.Multiply: {a: c_dir, b_value: {2.5, 2.5, 2.5, 1}} }
      c_n { nodes.Noise: {coords: c_dn, frequency: 2, octaves: 3, gain: 0.6, seed: sd * 16 + 6} }
      c_ray {
        nodes.Remap: {input: c_n, from_min: 0.3, from_max: 0.7, to_min: 0.3, to_max: 1.5}
      }
      c_rw {
        nodes.Remap: {
          input: c_r, from_min: 0.2, from_max: 0.34, to_min: 0, to_max: 1, clamp: true
        }
      }
      c_m { nodes.Mix: {a_value: {1, 1, 1, 1}, b: c_ray, factor: c_rw} }
      c_fall {
        nodes.Curve: {input: c_r, curve: {kind: CurveCatmullRom, keys: [
          {0, 1}, {0.2, 1}, {0.23, 0.62}, {0.28, 0.3}, {0.35, 0.12}, {0.42, 0.04}, {0.5, 0}
        ]}}
      }
      c_a0 { nodes.Multiply: {a: c_fall, b: c_m} }
      c_a { nodes.Clamp: {input: c_a0, min_value: {0, 0, 0, 0}, max_value: {1, 0, 0, 0}} }
      c_out { nodes.Combine: {r_value: 1, g_value: 1, b_value: 1, a: c_a} }
      Graph: {output: c_out, width: 256, height: 256, format: GraphLinear}
    }

    const ready: bool = surf[box.texture.Status].revision > 0
    const streamer_ready: bool = streamer[box.texture.Status].revision > 0

    axis {
      Position: {0, 0, 0}
      Rotation: {0.12, 0, 0.1}

      globe {
        Position: {0, 0, 0}
        AngularVelocity: {0, spin, 0}
        Sphere: {radius: r, segments: seg, smooth: true}
        Rgb: {0, 0, 0}
        PbrMaterial: {metallic: 1, roughness: 1}
        Emissive: {strength: glow, color: {col.r, col.g, col.b}}
        if ready {
          PbrTextures: {emissive: surf}
        }
        NoShadow
      }

      // Limb darkening: alpha u (1 - mu)^0.8 toward a cooler, dimmer color
      limb {
        Position: {0, 0, 0}
        Sphere: {radius: r * 1.0015, segments: seg, smooth: true}
        Rgb: {0, 0, 0}
        PbrMaterial: {metallic: 1, roughness: 1}
        Emissive: {strength: glow * 0.12, color: {limb_col.r, limb_col.g, limb_col.b}}
        Fresnel: {color: {0, 0, 0}, strength: 0, power: 0.8, bias: 0, opacity: limb_u}
        BlendMode: AlphaBlend
        Opacity: {0.001}
        NoShadow
        Ignore
      }

      // The corona: streamers that turn slowly and fade in and out, about six at a time
      if streamer_ready {
        corona {
          Position: {0, 0, 0}
          Emitter: {
            max: 16, rate: 1.1, shape: EmitterPoint, direction: {0, 0, 0}, speed: {0, 0},
            lifetime: {4, 7}, size: {r * 5, r * 5.6}, rotation: {0, 360}, spin: {-4, 4},
            opacity: {0.11 * cor, 0.15 * cor}, color: {hal_col.r, hal_col.g, hal_col.b}, seed: sd * 16 + 7,
            local: true
          }
          Burst: {count: 6, at: 0}
          Appearance: {
            shape: Sprite, blend: Additive, texture: streamer, softness: 0
          }
          Curves: {opacity: {keys: [{0, 0.35}, {0.2, 1}, {0.75, 1}, {1, 0}]}}
        }
      }

      // A wide soft halo
      halo {
        Position: {0, 0, 0}
        Emitter: {
          max: 8, rate: 0.6, shape: EmitterPoint, direction: {0, 0, 0}, speed: {0, 0},
          lifetime: {5, 8}, size: {r * 4.4, r * 5}, opacity: {0.04 * cor, 0.05 * cor},
          color: {col.r, col.g, col.b}, seed: sd * 16 + 8, local: true
        }
        Burst: {count: 4, at: 0}
        Appearance: {shape: Circle, blend: Additive, softness: 0}
        Curves: {opacity: {keys: [{0, 0.4}, {0.2, 1}, {0.75, 1}, {1, 0}]}}
      }

      // Prominences: thin jets of plasma thrown off the surface that rise, slow and fall back,
      // stretched along their motion so they arc over the limb
      prominence {
        Position: {0, 0, 0}
        Emitter: {
          max: detail > 1 ? 1200 : 600, rate: prom * (detail > 0 ? 300 : 150),
          shape: EmitterMesh, source: globe, direction: {0, 0, 0}, speed: {0, 0},
          radial: {r * 0.12, r * 0.3}, lifetime: {1.4, 2.6}, size: {r * 0.025, r * 0.05},
          opacity: {0.6, 1}, color: {prom_col.r, prom_col.g, prom_col.b},
          color_variance: {10, 30, 20}, seed: sd * 16 + 9, local: true
        }
        Motion: {speed: {keys: [{0, 1}, {0.45, 0.15}, {1, -0.9}]}}
        Appearance: {shape: Circle, blend: Additive, stretch: 6}
        Curves: {
          size: {keys: [{0, 0.6}, {0.3, 1}, {1, 0.7}]},
          opacity: {keys: [{0, 0}, {0.15, 1}, {0.7, 0.8}, {1, 0}]}
        }
      }
    }

    shine {
      Position: {0, 0, 0}
      PointLight: {intensity: star_light(temperature, r), range: r * 400}
      Rgb: {col.r, col.g, col.b}
    }
  }
}

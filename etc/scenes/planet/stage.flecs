using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.texture
using box.spatial
using box.picking
using state
using planets

assets {
  sky_tex { Path: {path: "etc/scenes/planet/assets/sky.jpg"} }
}

stage {
  sky {
    Position: {0, 0, 0}
    Rotation: {0.4, 1.2, 0.3}
    EllipsoidShell: {
      radius: {6000, 6000, 6000}, longitude_start: 0, longitude_end: 2 * PI,
      latitude_start: 0 - PI / 2, latitude_end: PI / 2, thickness: 1, segments: 64, rings: 32
    }
    Rgb: {0, 0, 0}
    PbrMaterial: {metallic: 1, roughness: 0.03}
    Emissive: {strength: 0.45, color: {235, 240, 255}}
    PbrTextures: {emissive: assets.sky_tex}
    NoShadow
    SpatialIgnore
  }

  orbit {
    Position: {0, 0, 0}
    Interactive

    if mode == MODE_STAR {
      Star hero_star(
        temperature: star.temperature, radius: star.radius, sunspots: star.sunspots,
        granulation: star.granulation, contrast: star.contrast, prominences: star.prominences,
        spin: star.spin, corona: star.corona, seed: star_seed, detail: star_detail
      ) {
        Position: {0, 0, 0}
      }
    } else {
      Planet hero(
        kind: shown_kind, seed: shown_seed, detail: shown_detail, body: body,
        surface: shown_surface, climate: shown_climate, air: air, clouds: shown_clouds,
        night: shown_night, lava: shown_lava, gas: shown_gas, rings: rings
      ) {
        Position: {0, 0, 0}
      }
    }
  }
}

using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.texture
using box.spatial
using box.picking
using box.light
using state
using planets

assets {
  // In the coordinates of the hero graph the patch is centered on +x, its longitude along z and its
  // latitude along -y. Its shell is centered on -Z before its yaw and pitch
  template SkyHeroGas {
    prop params: BackgroundParams = background_preset()

    const ns: i32 = seed_of(params.nebula_seed)

    // s is the size of the patch against the default 48 degrees
    const pw: f32 = clamp(params.span, 16, 90) * PI / 180
    const ph: f32 = pw * 0.625
    const s: f32 = pw / (48 * PI / 180)
    const tw: f32 = sin(pw / 2) / cos(pw / 2)
    const sh: f32 = sin(ph / 2)

    const sd: f32 = 0 - 0.05 * pw
    const sl: f32 = 0.06 * ph
    const sx: f32 = cos(sl) * cos(sd)
    const sy: f32 = 0 - sin(sl)
    const sz: f32 = cos(sl) * sin(sd)

    // Kind weights: kr for a remnant, kf for a reflection nebula, ke for an emission nebula
    const kr: f32 = params.nebula_kind == NEBULA_REMNANT ? 1 : 0
    const kf: f32 = params.nebula_kind == NEBULA_REFLECTION ? 1 : 0
    const ke: f32 = 1 - kr - kf

    // Falloffs 1 / (1 + q2 / a0^2) of the square q2 of the chord from the star, about the square
    // of the angle: k = 1 / a0^2 for a falloff to half at a0
    const kwide: f32 = 1 / pow((0.16 * ke + 0.5 * kr + 0.09 * kf) * s, 2)
    const kmid: f32 = 1 / pow((0.06 * ke + 0.5 * kr + 0.05 * kf) * s, 2)
    const kcore: f32 = 1 / pow((0.01 - 0.003 * kf) * s, 2)
    const kclu: f32 = 1 / pow(0.05 * s, 2)
    const kstar: f32 = 1 / pow(0.0011, 2)
    const khalo: f32 = 1 / pow(0.0045, 2)

    const kw: f32 = 0.85 - 0.6 * kf
    const fil: f32 = clamp(params.filaments, 0, 1)

    // The shell of a remnant: its radius rr, its half width rw in the units of q2 and its center
    // beside the star, where the shell frames the body of the default view
    const rr: f32 = 0.16 * s
    const rw: f32 = 2 * rr * 0.02 * s
    const rd: f32 = sd - 0.15 * s
    const rl: f32 = sl - 0.025 * s
    const rx: f32 = cos(rl) * cos(rd)
    const ry: f32 = 0 - sin(rl)
    const rz: f32 = cos(rl) * sin(rd)

    // The share of the filament field along the direction from the star, the rest along the curl
    // field
    const kfl: f32 = 0.45 + 0.4 * kr

    // The cavity around the star of an emission nebula: depth, from q2 cv0 to cv1
    const kcv: f32 = 0.9 * ke
    const cv0: f32 = pow(0.03 * s, 2)
    const cv1: f32 = pow(0.09 * s, 2)

    // The oval r is 1 at the middle of the edges of the patch, jittered by a noise so the fade is
    // not a regular oval
    h_c { nodes.Coords: {} }
    h_x { nodes.Split: {input: h_c, channel: ChannelR} }
    h_y { nodes.Split: {input: h_c, channel: ChannelG} }
    h_z { nodes.Split: {input: h_c, channel: ChannelB} }
    h_t { nodes.Divide: {a: h_z, b: h_x} }
    h_e { nodes.Combine: {r: h_t, g: h_y, b_value: 0, a_value: 0} }
    h_es { nodes.Multiply: {a: h_e, b_value: {1 / tw, 1 / sh, 0, 0}} }
    h_r { nodes.Length: {input: h_es} }
    h_rn { nodes.Noise: {frequency: 3 / s, octaves: 3, seed: ns * 32 + 1} }
    h_rj {
      nodes.Remap: {
        input: h_rn, from_min: 0, from_max: 1, to_min: -0.12, to_max: 0.12, clamp: true
      }
    }

    h_rr { nodes.Add: {a: h_r, b: h_rj} }
    h_edge {
      nodes.Smoothstep: {input: h_rr, edge0_value: {0.86, 0, 0, 0}, edge1_value: {0.35, 0, 0, 0}}
    }

    // The star has coordinates of its own so q2 keeps full precision (1 - cos of stored coordinates
    // shows rings). A Flow projects its field on the tangent, so c - s loses its part along c
    h_sc { nodes.Coords: {} }
    h_sv { nodes.Subtract: {a: h_sc, b_value: {sx, sy, sz, 0}} }
    h_q2 { nodes.Dot: {a: h_sv, b: h_sv} }
    h_nw0 { nodes.Remap: {input: h_q2, from_min: 0, from_max: 1, to_min: 1, to_max: 1 + kwide} }
    h_nw { nodes.Divide: {a_value: {1, 0, 0, 0}, b: h_nw0} }
    h_nm0 { nodes.Remap: {input: h_q2, from_min: 0, from_max: 1, to_min: 1, to_max: 1 + kmid} }
    h_nm { nodes.Divide: {a_value: {1, 0, 0, 0}, b: h_nm0} }
    h_nc0 { nodes.Remap: {input: h_q2, from_min: 0, from_max: 1, to_min: 1, to_max: 1 + kcore} }
    h_nc { nodes.Divide: {a_value: {1, 0, 0, 0}, b: h_nc0} }
    h_nk0 { nodes.Remap: {input: h_q2, from_min: 0, from_max: 1, to_min: 1, to_max: 1 + kclu} }
    h_nk { nodes.Divide: {a_value: {1, 0, 0, 0}, b: h_nk0} }
    h_ns0 {
      nodes.Remap: {input: h_q2, from_min: 0, from_max: 1, to_min: 1, to_max: 1 + kstar}
    }

    h_ns { nodes.Divide: {a_value: {1, 0, 0, 0}, b: h_ns0} }
    h_nh0 {
      nodes.Remap: {input: h_q2, from_min: 0, from_max: 1, to_min: 1, to_max: 1 + khalo}
    }

    h_nh { nodes.Divide: {a_value: {0.15, 0, 0, 0}, b: h_nh0} }
    h_tn { nodes.Normalize: {input: h_sv} }

    h_wn { nodes.Noise: {channels: 3, frequency: 4 / s, octaves: 3, seed: ns * 32 + 2} }
    h_wp { nodes.Warp: {offset: h_wn, amount_value: 0.1 * s} }
    h_gas {
      nodes.Noise: {coords: h_wp, frequency: 12 / s, octaves: 7, gain: 0.58, seed: ns * 32 + 3}
    }

    h_body {
      nodes.Smoothstep: {input: h_gas, edge0_value: {0.42, 0, 0, 0}, edge1_value: {0.64, 0, 0, 0}}
    }

    h_rdg {
      nodes.Noise: {
        coords: h_wp, frequency: 22 / s, octaves: 5, fractal: NoiseRidged, offset: 0.9,
        seed: ns * 32 + 4
      }
    }

    h_rs {
      nodes.Smoothstep: {input: h_rdg, edge0_value: {0.3, 0, 0, 0}, edge1_value: {0.6, 0, 0, 0}}
    }

    h_rdm {
      nodes.Remap: {input: h_rs, from_min: 0, from_max: 1, to_min: 1 - kw, to_max: 1 + 0.8 * kw}
    }

    h_fn {
      nodes.Noise: {coords: h_wp, frequency: 50 / s, octaves: 3, gain: 0.6, seed: ns * 32 + 10}
    }

    h_fm0 {
      nodes.Remap: {
        input: h_fn, from_min: 0.3, from_max: 0.7, to_min: 0.45, to_max: 1.3, clamp: true
      }
    }

    h_cl0 { nodes.Multiply: {a: h_body, b: h_rdm} }
    h_cl { nodes.Multiply: {a: h_cl0, b: h_fm0} }
    h_big { nodes.Noise: {frequency: 2.5 / s, octaves: 3, seed: ns * 32 + 5} }
    h_env {
      nodes.Remap: {
        input: h_big, from_min: 0.35, from_max: 0.65, to_min: 0.15, to_max: 1, clamp: true
      }
    }

    h_cd0 { nodes.Multiply: {a: h_cl, b: h_env} }

    // The cavity the star blew into the gas of an emission nebula: its walls face the star
    h_cav0 {
      nodes.Smoothstep: {input: h_q2, edge0_value: {cv0, 0, 0, 0}, edge1_value: {cv1, 0, 0, 0}}
    }

    h_cav { nodes.Remap: {input: h_cav0, from_min: 0, from_max: 1, to_min: 1 - kcv, to_max: 1} }
    h_cd { nodes.Multiply: {a: h_cd0, b: h_cav} }

    // A remnant: a thin shell rr from its center, wobbling with the warp, ridged
    h_wv { nodes.Subtract: {a: h_wp, b_value: {rx, ry, rz, 0}} }
    h_wq { nodes.Dot: {a: h_wv, b: h_wv} }
    h_wo { nodes.Subtract: {a: h_wq, b_value: {rr * rr, 0, 0, 0}} }
    h_wa { nodes.Abs: {input: h_wo} }
    h_ring {
      nodes.Smoothstep: {input: h_wa, edge0_value: {rw, 0, 0, 0}, edge1_value: {0, 0, 0, 0}}
    }

    h_rd0 { nodes.Multiply: {a: h_ring, b: h_rdm} }
    h_rd { nodes.Multiply: {a: h_rd0, b: h_fm0} }
    h_d0 { nodes.Mix: {a: h_cd, b: h_rd, factor_value: {kr, kr, kr, 1}} }

    // The curl keeps its length, so the field turns smoothly where the noise is flat, and the
    // streaks fade out in the cavity, where the field from the star would split them into creases
    h_cn0 { nodes.Noise: {frequency: 4 / s, octaves: 2, seed: ns * 32 + 8} }
    h_gb { nodes.Gradient: {height: h_cn0, strength: 40} }
    h_curl { nodes.Cross: {a: h_c, b: h_gb} }
    h_tan { nodes.Cross: {a: h_c, b_value: {rx, ry, rz, 0}} }
    h_tg { nodes.Normalize: {input: h_tan} }
    h_alt { nodes.Mix: {a: h_tn, b: h_tg, factor_value: {kr, kr, kr, 1}} }
    h_fld { nodes.Mix: {a: h_curl, b: h_alt, factor_value: {kfl, kfl, kfl, 1}} }
    h_dn {
      nodes.Noise: {coords: h_wp, frequency: 9 / s, octaves: 5, gain: 0.6, seed: ns * 32 + 7}
    }

    h_dm {
      nodes.Smoothstep: {input: h_dn, edge0_value: {0.5, 0, 0, 0}, edge1_value: {0.72, 0, 0, 0}}
    }

    h_fv { nodes.Combine: {r: h_d0, g: h_dm, b_value: 0, a_value: 0} }
    h_fil { nodes.Flow: {input: h_fv, field: h_fld, length: h_cav0, reach: fil * 4 * s} }
    h_fd { nodes.Split: {input: h_fil, channel: ChannelR} }
    h_den { nodes.Mix: {a: h_d0, b: h_fd, factor_value: {0.75, 0.75, 0.75, 1}} }
  }

  template SkyHero : SkyHeroGas {
    const ns: i32 = seed_of(params.nebula_seed)

    const har: f32 = pow(clamp(params.halpha.r, 0, 255) / 255, 2.2)
    const hag: f32 = pow(clamp(params.halpha.g, 0, 255) / 255, 2.2)
    const hab: f32 = pow(clamp(params.halpha.b, 0, 255) / 255, 2.2)
    const o3r: f32 = pow(clamp(params.oiii.r, 0, 255) / 255, 2.2)
    const o3g: f32 = pow(clamp(params.oiii.g, 0, 255) / 255, 2.2)
    const o3b: f32 = pow(clamp(params.oiii.b, 0, 255) / 255, 2.2)
    const s2r: f32 = pow(clamp(params.sii.r, 0, 255) / 255, 2.2)
    const s2g: f32 = pow(clamp(params.sii.g, 0, 255) / 255, 2.2)
    const s2b: f32 = pow(clamp(params.sii.b, 0, 255) / 255, 2.2)

    const pw: f32 = clamp(params.span, 16, 90) * PI / 180
    const ph: f32 = pw * 0.625
    const s: f32 = pw / (48 * PI / 180)
    const l0: f32 = 0 - PI / 2 - pw / 2
    const l1: f32 = pw / 2 - PI / 2

    const sd: f32 = 0 - 0.05 * pw
    const sl: f32 = 0.06 * ph
    const sx: f32 = cos(sl) * cos(sd)
    const sy: f32 = 0 - sin(sl)
    const sz: f32 = cos(sl) * sin(sd)

    // Kind weights: kr for a remnant, kf for a reflection nebula, ke for an emission nebula
    const kr: f32 = params.nebula_kind == NEBULA_REMNANT ? 1 : 0
    const kf: f32 = params.nebula_kind == NEBULA_REFLECTION ? 1 : 0
    const ke: f32 = 1 - kr - kf

    const pil: f32 = clamp(params.pillars, 0, 1)
    const dst: f32 = clamp(params.dust, 0, 1)
    const g: f32 = max(params.glow, 0) * (1 - kr)
    const rr: f32 = 0.16 * s

    // The weights of the layers: H-alpha, OIII, the glow in H-alpha and in OIII, the rims and the
    // blue starlight scattered by the dust of a reflection nebula
    const wha: f32 = 4 * (1 - 0.8 * kf)
    const wo3: f32 = 4 * (1 - 0.85 * kf)
    const wgh: f32 = 0.08 * ke + 0.04 * kf
    const wgo: f32 = 0.5 * ke + 0.1 * kf
    const wrim: f32 = 6 * ke + 0.8 * kr + 1.2 * kf
    const wref: f32 = 5 * kf

    h_edge {}
    h_nw {}
    h_nm {}
    h_nc {}
    h_nk {}
    h_ns {}
    h_nh {}
    h_tn {}
    h_wp {}
    h_wq {}
    h_fil {}
    h_den {}

    // The dense clumps shade what lies behind them, pillars and globules with dark tails, and are
    // lit on their rims that face the star
    h_opq {
      nodes.Smoothstep: {input: h_den, edge0_value: {0.25, 0, 0, 0}, edge1_value: {0.6, 0, 0, 0}}
    }

    h_opb { nodes.Blur: {input: h_opq, radius: 0.5} }
    h_tr {
      nodes.Transmittance: {
        density: h_opb, light: {sx, sy, sz}, absorption: pil * 2.2, range: 10 * s, steps: 128
      }
    }

    h_dd { nodes.Multiply: {a: h_den, b: h_den} }
    h_lit { nodes.Multiply: {a: h_dd, b: h_tr} }
    h_gd { nodes.Gradient: {height: h_opb, strength: 1} }
    h_face { nodes.Dot: {a: h_gd, b: h_tn} }
    h_fm {
      nodes.Smoothstep: {input: h_face, edge0_value: {-0.2, 0, 0, 0}, edge1_value: {1.2, 0, 0, 0}}
    }

    h_rim0 { nodes.Multiply: {a: h_opq, b: h_tr} }
    h_rim1 { nodes.Multiply: {a: h_rim0, b: h_fm} }
    h_rim { nodes.Multiply: {a: h_rim1, b: h_nm} }

    // The glow of the ionized gas around the star, hidden where the clumps lie in front of it
    h_gn { nodes.Noise: {coords: h_wp, frequency: 5 / s, octaves: 4, seed: ns * 32 + 9} }
    h_gv {
      nodes.Remap: {
        input: h_gn, from_min: 0.3, from_max: 0.7, to_min: 0.2, to_max: 1, clamp: true
      }
    }

    h_occ { nodes.Remap: {input: h_opq, from_min: 0, from_max: 1, to_min: 1, to_max: 0.08} }
    h_gl0 { nodes.Multiply: {a: h_gv, b: h_occ} }
    h_glh { nodes.Multiply: {a: h_gl0, b_value: {wgh, 0, 0, 0}} }
    h_gl1 { nodes.Multiply: {a: h_gl0, b: h_nm} }
    h_glo { nodes.Multiply: {a: h_gl1, b_value: {wgo, 0, 0, 0}} }

    // H-alpha is wide, also in the shade, OIII near the star (on the outer side of the shell of a
    // remnant) and SII on the rims; a reflection nebula scatters the blue light of its star
    h_trs { nodes.Remap: {input: h_tr, from_min: 0, from_max: 1, to_min: 0.2, to_max: 1} }
    h_ha0 { nodes.Multiply: {a: h_dd, b: h_trs} }
    h_ha1 { nodes.Add: {a: h_ha0, b: h_glh} }
    h_out0 {
      nodes.Smoothstep: {
        input: h_wq, edge0_value: {rr * rr * 0.9, 0, 0, 0}, edge1_value: {rr * rr * 1.15, 0, 0, 0}
      }
    }

    h_haw {
      nodes.Remap: {input: h_out0, from_min: 0, from_max: 1, to_min: 1, to_max: 1 - 0.8 * kr}
    }

    h_ha2 { nodes.Multiply: {a: h_ha1, b: h_nw} }
    h_ha { nodes.Multiply: {a: h_ha2, b: h_haw} }
    h_o3w { nodes.Mix: {a: h_nm, b: h_out0, factor_value: {kr, kr, kr, 1}} }
    h_o30 { nodes.Add: {a: h_lit, b: h_glo} }
    h_o3 { nodes.Multiply: {a: h_o30, b: h_o3w} }
    h_cha { nodes.Constant: {value: {wha * har, wha * hag, wha * hab, 1}} }
    h_co3 { nodes.Constant: {value: {wo3 * o3r, wo3 * o3g, wo3 * o3b, 1}} }
    h_cs2 { nodes.Constant: {value: {s2r * 0.6, s2g * 0.6, s2b * 0.6, 1}} }
    h_crm {
      nodes.Constant: {value: {
        wrim * (0.6 * har + 0.5 * o3r + 0.15), wrim * (0.6 * hag + 0.5 * o3g + 0.15),
        wrim * (0.6 * hab + 0.5 * o3b + 0.15), 1
      }}
    }

    h_cref { nodes.Constant: {value: {wref * 0.22, wref * 0.42, wref, 1}} }
    h_lha { nodes.Multiply: {a: h_ha, b: h_cha} }
    h_lo3 { nodes.Multiply: {a: h_o3, b: h_co3} }
    h_ls2 { nodes.Multiply: {a: h_rim0, b: h_cs2} }
    h_lrm { nodes.Multiply: {a: h_rim, b: h_crm} }
    h_rf0 { nodes.Multiply: {a: h_ha0, b: h_nw} }
    h_lrf { nodes.Multiply: {a: h_rf0, b: h_cref} }
    h_e0 { nodes.Add: {a: h_lha, b: h_lo3} }
    h_e1 { nodes.Add: {a: h_e0, b: h_ls2} }
    h_e2 { nodes.Add: {a: h_e1, b: h_lrm} }
    h_e3 { nodes.Add: {a: h_e2, b: h_lrf} }

    // The core: the gas closest to the star, bright in OIII and white
    h_cdn { nodes.Remap: {input: h_den, from_min: 0, from_max: 1, to_min: 0.4, to_max: 1.4} }
    h_core { nodes.Multiply: {a: h_nc, b: h_cdn} }
    h_ccr {
      nodes.Constant: {value: {
        g * 1.2 * (0.6 * o3r + 0.5), g * 1.2 * (0.6 * o3g + 0.5), g * 1.2 * (0.6 * o3b + 0.5), 1
      }}
    }

    h_lcr { nodes.Multiply: {a: h_core, b: h_ccr} }

    // The cluster: small glows at the points of cells around the star, a few bright
    h_cel { nodes.Cells: {count: 120000 / (s * s), jitter: 1, seed: ns * 32 + 6} }
    h_cf { nodes.Split: {input: h_cel, channel: ChannelR} }
    h_cid { nodes.Split: {input: h_cel, channel: ChannelG} }
    h_cp {
      nodes.Smoothstep: {input: h_cf, edge0_value: {0.12, 0, 0, 0}, edge1_value: {0, 0, 0, 0}}
    }

    h_cb { nodes.Power: {a: h_cid, b_value: {4, 0, 0, 0}} }
    h_cq { nodes.Multiply: {a: h_cp, b: h_cb} }
    h_cg { nodes.Multiply: {a: h_cq, b: h_nk} }
    h_ccl { nodes.Constant: {value: {g * 6 * 0.8, g * 6 * 0.88, g * 6, 1}} }
    h_lcl { nodes.Multiply: {a: h_cg, b: h_ccl} }

    // Dust: the smeared lanes, dimming and reddening what is behind: exp(-tau k) per channel,
    // the constant exp(-k) to the power tau
    h_dl { nodes.Split: {input: h_fil, channel: ChannelG} }
    h_tau { nodes.Multiply: {a: h_dl, b_value: {dst * 2.5, 0, 0, 0}} }
    h_ext { nodes.Constant: {value: {exp(0 - 0.55), exp(0 - 0.8), exp(0 - 1.2), 1}} }
    h_att { nodes.Power: {a: h_ext, b: h_tau} }

    // The star and its halo in front of the dust
    h_st { nodes.Add: {a: h_ns, b: h_nh} }
    h_cst { nodes.Constant: {value: {g * 8 * 0.78, g * 8 * 0.86, g * 8, 1}} }
    h_lst { nodes.Multiply: {a: h_st, b: h_cst} }

    h_em0 { nodes.Add: {a: h_e3, b: h_lcr} }
    h_em1 { nodes.Add: {a: h_em0, b: h_lcl} }
    h_dim { nodes.Multiply: {a: h_em1, b: h_att} }
    h_all { nodes.Add: {a: h_dim, b: h_lst} }
    h_out { nodes.Multiply: {a: h_all, b: h_edge} }
    Graph: {
      output: h_out, width: 2048, height: 1280, domain: DomainSphere, format: GraphHdr,
      longitude_start: l0, longitude_end: l1, latitude_start: 0 - ph / 2,
      latitude_end: ph / 2
    }
  }

  // Parameters and seeds only change the values of the nodes, so no parameter compiles the graphs
  // again. The shells are black mirrors that reflect nothing, Additive so the stars show through
  template SkyBackground {
    prop params: BackgroundParams = background_preset()

    const ns: i32 = seed_of(params.nebula_seed)
    const bw: f32 = sin(clamp(params.band_width, 0.5, 60) * 2.2 * PI / 180)
    const bk: f32 = clamp(params.band, 0, 1) * 0.16
    const n: i32 = max(params.count, 0)
    const ss: i32 = seed_of(params.star_seed)

    const har: f32 = pow(clamp(params.halpha.r, 0, 255) / 255, 2.2)
    const hag: f32 = pow(clamp(params.halpha.g, 0, 255) / 255, 2.2)
    const hab: f32 = pow(clamp(params.halpha.b, 0, 255) / 255, 2.2)
    const o3r: f32 = pow(clamp(params.oiii.r, 0, 255) / 255, 2.2)
    const o3g: f32 = pow(clamp(params.oiii.g, 0, 255) / 255, 2.2)
    const o3b: f32 = pow(clamp(params.oiii.b, 0, 255) / 255, 2.2)

    const pw: f32 = clamp(params.span, 16, 90) * PI / 180
    const ph: f32 = pw * 0.625
    const l0: f32 = 0 - PI / 2 - pw / 2
    const l1: f32 = pw / 2 - PI / 2

    Position: {0, 0, 0}
    Rotation: {0, params.yaw * PI / 180, params.tilt * PI / 180}

    neb {
      n_wn { nodes.Noise: {channels: 3, frequency: 1.4, octaves: 3, seed: ns * 16 + 1} }
      n_wp { nodes.Warp: {offset: n_wn, amount_value: 0.7} }
      n_gas {
        nodes.Noise: {coords: n_wp, frequency: 2, octaves: 5, gain: 0.58, seed: ns * 16 + 2}
      }

      n_body {
        nodes.Smoothstep: {input: n_gas, edge0_value: {0.36, 0, 0, 0}, edge1_value: {0.8, 0, 0, 0}}
      }

      n_big { nodes.Noise: {frequency: 0.9, octaves: 3, seed: ns * 16 + 3} }
      n_cloud {
        nodes.Smoothstep: {input: n_big, edge0_value: {0.42, 0, 0, 0}, edge1_value: {0.66, 0, 0, 0}}
      }

      n_lane {
        nodes.Noise: {coords: n_wp, frequency: 5.2, octaves: 4, gain: 0.6, seed: ns * 16 + 4}
      }

      n_lit {
        nodes.Smoothstep: {
          input: n_lane,
          edge0_value: {0.38, 0, 0, 0},
          edge1_value: {0.58, 0, 0, 0}
        }
      }

      n_dk {
        nodes.Remap: {input: n_lit, from_min: 0, from_max: 1, to_min: 0.06, to_max: 1}
      }

      n_d0 { nodes.Multiply: {a: n_body, b: n_cloud} }
      n_d { nodes.Multiply: {a: n_d0, b: n_dk} }
      n_col {
        nodes.Constant: {value: {
          0.1 * har + 0.03 * o3r + 0.03, 0.1 * hag + 0.03 * o3g + 0.03,
          0.1 * hab + 0.03 * o3b + 0.12, 1
        }}
      }

      n_neb { nodes.Multiply: {a: n_d, b: n_col} }

      // The band: unresolved stars within about the band width of the plane
      n_uv { nodes.Coords: {} }
      n_y { nodes.Split: {input: n_uv, channel: ChannelG} }
      n_ay { nodes.Abs: {input: n_y} }
      n_bm {
        nodes.Smoothstep: {input: n_ay, edge0_value: {bw, 0, 0, 0}, edge1_value: {0, 0, 0, 0}}
      }

      n_bn { nodes.Noise: {coords: n_wp, frequency: 2.4, octaves: 4, seed: ns * 16 + 5} }
      n_bv {
        nodes.Remap: {
          input: n_bn, from_min: 0.36, from_max: 0.66, to_min: 0, to_max: 1.4, clamp: true
        }
      }

      n_b0 { nodes.Multiply: {a: n_bm, b: n_bv} }
      n_b1 { nodes.Multiply: {a: n_b0, b: n_dk} }
      n_bcol { nodes.Constant: {value: {bk, bk * 0.86, bk * 0.7, 1}} }
      n_band { nodes.Multiply: {a: n_b1, b: n_bcol} }

      n_out { nodes.Add: {a: n_neb, b: n_band} }
      Graph: {
        output: n_out, width: 1024, height: 512, domain: DomainSphere, format: GraphHdr
      }
    }

    SkyHero hero(params: params)

    const ready: bool = neb[box.texture.Status].revision > 0
    const hero_ready: bool = hero?[box.texture.Status] && hero[box.texture.Status].revision > 0

    shell {
      Position: {0, 0, 0}
      EllipsoidShell: {
        radius: {6000, 6000, 6000}, longitude_start: 0, longitude_end: 2 * PI,
        latitude_start: 0 - PI / 2, latitude_end: PI / 2, thickness: 1, segments: 96, rings: 48
      }
      Rgb: {0, 0, 0}
      PbrMaterial: {metallic: 1, roughness: 0}
      Emissive: {strength: ready ? max(params.intensity, 0) * 0.5 : 0, color: {255, 255, 255}}

      if ready {
        PbrTextures: {emissive: neb}
      }

      BlendMode: Additive
      NoShadow
      Ignore
    }

    patch {
      Position: {0, 0, 0}
      Rotation: {params.nebula_pitch * PI / 180, params.nebula_yaw * PI / 180, 0}
      EllipsoidShell: {
        radius: {5990, 5990, 5990}, longitude_start: l0, longitude_end: l1,
        latitude_start: 0 - ph / 2, latitude_end: ph / 2, thickness: 1, segments: 48, rings: 32
      }
      Rgb: {0, 0, 0}
      PbrMaterial: {metallic: 1, roughness: 0}
      Emissive: {strength: hero_ready ? max(params.intensity, 0) : 0, color: {255, 255, 255}}

      if hero_ready {
        PbrTextures: {emissive: hero}
      }

      BlendMode: Additive
      NoShadow
      Ignore
    }

    stars {
      Position: {0, 0, 0}
      StarField: {
        count: n, seed: ss, brightness: params.brightness, falloff: params.falloff,
        size: params.size, temperature_min: params.temperature_min,
        temperature_max: max(params.temperature_max, params.temperature_min),
        saturation: params.saturation, band: params.band, band_width: params.band_width
      }
    }
  }
}

stage {
  assets.SkyBackground sky(params: background)

  orbit {
    Position: {0, 0, 0}
    Interactive

    if mode == MODE_STAR {
      Star hero_star(
        temperature: star.temperature, radius: star.radius, sunspots: star.sunspots,
        granulation: star.granulation, contrast: star.contrast, prominences: star.prominences,
        spin: star.spin, corona: star.corona, seed: star_seed, detail: star_detail
      ) {
        Position: {0, 0, 0}
      }
    } else {
      Planet hero(
        kind: shown_kind, seed: shown_seed, detail: shown_detail, body: body,
        surface: shown_surface, climate: shown_climate, air: air, clouds: shown_clouds,
        night: shown_night, lava: shown_lava, gas: shown_gas, rings: rings, sun: sun
      ) {
        Position: {0, 0, 0}
      }
    }
  }
}

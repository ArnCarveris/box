using flecs.script
using flecs.script.math
using box.input
using box.ui
using box.widgets
using box.task
using box.app
using state
using planets

state {
  // Load the preset of a kind for the seed: every parameter as that kind looks by default
  fn preset(target: i32) {
    state.kind = target
    state.body = body_preset(state.seed)
    state.surface = surface_preset(target, state.seed)
    state.climate = climate_preset(target)
    state.air = air_preset(target, state.seed)
    state.clouds = clouds_preset(target)
    state.night = night_preset(target)
    state.lava = lava_preset(target)
    state.gas = gas_preset(state.seed)
    state.rings = rings_preset(target, state.seed)
    state.edits += 1
  }

  fn reset() {
    state.seed = START_SEED
    state.detail = 2
    preset(START_KIND)
    state.sun_angle = SUN_DAY
    state.orbit_yaw = 0
    state.orbit_pitch = 0
    state.zoom = 1
  }

  // Distance of the camera that frames the body the scene shows: the star with its corona,
  // farther for a larger star
  fn framing() -> f32 { state.mode == MODE_STAR ? star_distance(state.star.radius) : 27 }

  // Radius of the outermost part of the body. A planet: its atmosphere shell, its top
  // (planet_radius + thickness) km over a planet_radius of 6360 km scaled to the radius in world
  // units as the atmosphere does, the cloud layer and the rings when they are on. A star: its
  // corona, camera facing sprites up to 5.6 radii wide, whose corners reach 4 radii
  fn outer() -> f32 {
    state.mode == MODE_STAR ? max(state.star.radius, 0.1) * 4 : max(
      state.body.radius * max(
        (6360 + max(state.air.rayleigh_height, state.air.mie_height) * 6) / 6360, 1.012),
      state.rings.enabled ? state.body.radius * state.rings.size : 0)
  }

  // The closest zoom: the camera stays 10% outside the outermost part of the body, and past the
  // near plane of the camera (0.5)
  fn zoom_min() -> f32 { min((outer() * 1.1 + 0.6) / framing(), 1) }

  // Load the preset of a star type
  fn star_load(target: i32) {
    state.star_kind = target
    state.star = star_preset(target)
  }

  fn star_reset() {
    state.star_seed = START_STAR_SEED
    state.star_detail = 2
    star_load(START_STAR)
    state.orbit_yaw = 0
    state.orbit_pitch = 0
    state.zoom = 1
  }

  // Set the parameter of the slider n of the star group to v
  fn edit_star(n: string, v: f32) {
    if n == "temperature" { state.star.temperature = v }
    else if n == "radius" { state.star.radius = v }
    else if n == "sunspots" { state.star.sunspots = v }
    else if n == "granulation" { state.star.granulation = v }
    else if n == "contrast" { state.star.contrast = v }
    else if n == "prominences" { state.star.prominences = v }
    else if n == "spin" { state.star.spin = v }
    else if n == "corona" { state.star.corona = v }
  }

  fn apply() {
    state.shown_kind = state.kind
    state.shown_seed = state.seed
    state.shown_detail = state.detail
    state.shown_surface = state.surface
    state.shown_climate = state.climate
    state.shown_clouds = state.clouds
    state.shown_night = state.night
    state.shown_lava = state.lava
    state.shown_gas = state.gas
    state.shown_edits = state.edits
  }

  // A color with one channel, r, g or b, set to v
  fn with_channel(c: Col, channel: string, v: f32) -> Col {
    {channel == "r" ? v : c.r, channel == "g" ? v : c.g, channel == "b" ? v : c.b}
  }

  // Set the parameter of the slider n in the group of the panel g to v
  fn edit(g: string, n: string, v: f32) {
    if g == "planet_page" {
      if n == "sun" { state.sun_angle = v }
    } else if g == "body" {
      if n == "radius" { state.body.radius = v }
      else if n == "tilt" { state.body.tilt = v }
      else if n == "lean" { state.body.lean = v }
      else if n == "spin" { state.body.spin = v }
    } else if g == "surface" {
      if n == "ocean" { state.surface.ocean = v }
      else if n == "continents" { state.surface.continents = v }
      else if n == "warp" { state.surface.warp = v }
      else if n == "mountains" { state.surface.mountains = v }
      else if n == "mountain_cover" { state.surface.mountain_cover = v }
      else if n == "craters" { state.surface.craters = v }
      else if n == "cracks" { state.surface.cracks = v }
      else if n == "plates" { state.surface.plates = v }
      else if n == "crack_shade" { state.surface.crack_shade = v }
      else if n == "normal" { state.surface.normal = v }
      else if n == "variation" { state.surface.variation = v }
      else if n == "beach" { state.surface.beach = v }
    } else if g == "climate" {
      if n == "equator" { state.climate.equator = v }
      else if n == "poles" { state.climate.poles = v }
      else if n == "lapse" { state.climate.lapse = v }
      else if n == "ice" { state.climate.ice = v }
      else if n == "snow_line" { state.climate.snow_line = v }
      else if n == "snow" { state.climate.snow = v }
      else if n == "moisture" { state.climate.moisture = v }
      else if n == "vegetation" { state.climate.vegetation = v }
      else if n == "treeline" { state.climate.treeline = v }
    } else if g == "air" {
      if n == "density" { state.air.density = v }
      else if n == "rayleigh_height" { state.air.rayleigh_height = v }
      else if n == "rayleigh" { state.air.rayleigh = v }
      else if n == "mie_height" { state.air.mie_height = v }
      else if n == "mie" { state.air.mie = v }
      else if n == "anisotropy" { state.air.anisotropy = v }
    } else if g == "clouds" {
      if n == "cover" { state.clouds.cover = v }
      else if n == "opacity" { state.clouds.opacity = v }
      else if n == "frequency" { state.clouds.frequency = v }
      else if n == "speed" { state.clouds.speed = v }
      else if n == "evolve" { state.clouds.evolve = v }
    } else if g == "night" {
      if n == "density" { state.night.density = v }
      else if n == "brightness" { state.night.brightness = v }
      else if n == "urban" { state.night.urban = v }
    } else if g == "lava" {
      if n == "level" { state.lava.level = v }
      else if n == "cracks" { state.lava.cracks = v }
      else if n == "emission" { state.lava.emission = v }
    } else if g == "gas" {
      if n == "bands" { state.gas.bands = v }
      else if n == "turbulence" { state.gas.turbulence = v }
      else if n == "drift" { state.gas.drift = v }
      else if n == "storms" { state.gas.storms = v }
    } else if g == "rings" {
      if n == "size" { state.rings.size = v }
      else if n == "inner" { state.rings.inner = v }
      else if n == "ringlets" { state.rings.ringlets = v }
      else if n == "gaps" { state.rings.gaps = v }
      else if n == "opacity" { state.rings.opacity = v }
    }
  }

  // Set channel c of the color n in the group of the panel g to v
  fn edit_color(g: string, n: string, c: string, v: f32) {
    if g == "air" {
      state.air.tint = with_channel(state.air.tint, c, v)
    } else if g == "clouds" {
      state.clouds.color = with_channel(state.clouds.color, c, v)
    } else if g == "gas" {
      state.gas.tint = with_channel(state.gas.tint, c, v)
    } else if g == "rings" {
      state.rings.color = with_channel(state.rings.color, c, v)
    }
  }

  // Set the switch n in the group of the panel g to on
  fn edit_switch(g: string, n: string, on: bool) {
    if g == "night" {
      state.night.lights = on
    } else if g == "rings" {
      state.rings.enabled = on
    }
  }
}

// A change of a widget of the panel sets the value it stands for: a new type loads its preset,
// the other widgets set their parameter, found by the names of the widget and of its group. Only
// the widget that changed is read, so the other parameters keep their exact values
async {
  while true {
    const e = await on.change(hud.screen.side.panel)
    const w = e.widget
    if w.has(Dropdown) {
      const picked: i32 = w[Dropdown.mut].current
      if w.name() == "star_kind" {
        if picked != state.star_kind {
          star_load(picked)
        }
      } else if picked != state.kind {
        preset(picked)
      }
    } else if w.has(Stepper) {
      if w.name() == "star_seed" {
        state.star_seed = w[Stepper.mut].current
      } else if w.name() == "star_detail" {
        state.star_detail = w[Stepper.mut].current
      } else {
        if w.name() == "seed" {
          state.seed = w[Stepper.mut].current
        } else {
          state.detail = w[Stepper.mut].current
        }
        state.edits += 1
      }
    } else if w.has(Checkbox) {
      edit_switch(w.parent().name(), w.name(), w[Checkbox.mut].current)
      state.edits += 1
    } else if w.has(Slider) {
      const v: f32 = w[Slider.mut].current
      const p = w.parent()
      if p.name() == "star" {
        edit_star(w.name(), v)
      } else if p.name() == "channels" {
        const field = p.parent()
        edit_color(field.parent().name(), field.name(), w.name(), v)
      } else {
        edit(p.name(), w.name(), v)
      }
      if p.name() != "star" {
        state.edits += 1
      }
    }
  }
}

async {
  while true {
    await on.pressed(state.actions.random_seed)
    if state.mode == MODE_STAR {
      state.star_seed = (state.star_seed * 621 + 271) % 1000
    } else {
      state.seed = (state.seed * 621 + 271) % 1000
      state.edits += 1
    }
  }
}

async {
  while true {
    await on.pressed(state.actions.reset)
    if state.mode == MODE_STAR {
      star_reset()
    } else {
      reset()
    }
  }
}

// The Planet / Star switch: each side keeps its values in the state, so switching back shows
// the planet or the star as it was
async {
  while true {
    await on.pressed(state.actions.show_planet)
    state.mode = MODE_PLANET
    state.zoom = 1
  }
}

async {
  while true {
    await on.pressed(state.actions.show_star)
    state.mode = MODE_STAR
    state.zoom = 1
  }
}

async {
  while true {
    const e = await on.drag(stage.orbit)
    state.orbit_yaw = state.orbit_yaw - e.delta_x * 0.006
    state.orbit_pitch = clamp(state.orbit_pitch + e.delta_y * 0.006, -1.2, 1.2)
  }
}

// The wheel zooms anywhere outside the panel, whose InputBlocker zeroes the scroll over it, so the
// panel keeps scrolling its parameters. Each notch scales the zoom, held between the closest zoom
// of the body as it is now and 3 times the framing, and the camera eases toward its distance
async {
  mut last: f64 = box.app.Status[box.app.Status].elapsed
  while true {
    await next_frame()
    const now = box.app.Status[box.app.Status].elapsed
    const fixed = App[App].delta_time
    const dt: f32 = fixed > 0 ? fixed : clamp(now - last, 0.001, 0.1)
    last = now

    const scroll: f32 = Input[Input].mouse.scroll.y
    const z: f32 = clamp(state.zoom * clamp(1 - scroll * 0.12, 0.5, 1.5), zoom_min(), 3)
    if z != state.zoom {
      state.zoom = z
    }
    // The camera eases toward its distance, but never through the body when it grows
    const target: f32 = framing() * state.zoom
    if abs(target - state.cam_dist) > 0.002 {
      state.cam_dist = max(state.cam_dist + (target - state.cam_dist) * min(dt * 12, 1),
        framing() * zoom_min())
    } else if target != state.cam_dist {
      state.cam_dist = target
    }
  }
}

// Show the latest values once the planet's graphs are evaluated, or after 1.5 seconds
async {
  mut waited: f32 = 0
  while true {
    await delay(0.1)
    if state.edits != state.shown_edits {
      if InProgressTask[InProgressTask].blocking == 0 || waited >= 1.5 {
        apply()
        waited = 0
      } else {
        waited += 0.1
      }
    } else {
      waited = 0
    }
  }
}

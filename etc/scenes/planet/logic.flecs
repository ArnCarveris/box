using flecs.script
using flecs.script.math
using box.input
using box.ui
using box.widgets
using box.task
using state
using planets

state {
  // Load the preset of a kind for the seed: every parameter as that kind looks by default
  fn preset(target: i32) {
    state.kind = target
    state.body = body_preset(state.seed)
    state.surface = surface_preset(target, state.seed)
    state.climate = climate_preset(target)
    state.air = air_preset(target, state.seed)
    state.clouds = clouds_preset(target)
    state.night = night_preset(target)
    state.lava = lava_preset(target)
    state.gas = gas_preset(state.seed)
    state.rings = rings_preset(target, state.seed)
    state.edits += 1
  }

  fn reset() {
    state.seed = 23
    state.detail = 2
    preset(KIND_GARDEN)
    state.sun_angle = SUN_DAY
    state.orbit_yaw = 0
    state.orbit_pitch = 0
  }

  fn apply() {
    state.shown_kind = state.kind
    state.shown_seed = state.seed
    state.shown_detail = state.detail
    state.shown_surface = state.surface
    state.shown_climate = state.climate
    state.shown_clouds = state.clouds
    state.shown_night = state.night
    state.shown_lava = state.lava
    state.shown_gas = state.gas
    state.shown_edits = state.edits
  }
}

// A change of a widget of the panel reads the values of the widgets: a new type loads its
// preset, else the parameters of the groups the type shows take the values of their sliders
async {
  while true {
    const e = await on.change(hud.screen.side.panel)
    const picked: i32 = hud.screen.side.panel.type.kind[Dropdown.mut].current
    if e.widget.has(Button) {
      // The Random and Reset buttons act through their actions
    } else if picked != state.kind {
      preset(picked)
    } else {
      const g = hud.screen.side.panel.lookup("groups")
      state.seed = hud.screen.side.panel.variant.seed[Stepper.mut].current
      state.detail = hud.screen.side.panel.level.detail[Stepper.mut].current
      state.sun_angle = hud.screen.side.panel.sun[Slider.mut].current

      const b = g.lookup("body")
      state.body = {
        radius: b.lookup("radius")[Slider.mut].current,
        tilt: b.lookup("tilt")[Slider.mut].current,
        lean: b.lookup("lean")[Slider.mut].current,
        spin: b.lookup("spin")[Slider.mut].current
      }

      const a = g.lookup("air")
      const at = a.lookup("tint").lookup("channels")
      state.air = {
        density: a.lookup("density")[Slider.mut].current,
        rayleigh_height: a.lookup("rayleigh_height")[Slider.mut].current,
        rayleigh: a.lookup("rayleigh")[Slider.mut].current,
        mie_height: a.lookup("mie_height")[Slider.mut].current,
        mie: a.lookup("mie")[Slider.mut].current,
        anisotropy: a.lookup("anisotropy")[Slider.mut].current,
        tint: {
          at.lookup("r")[Slider.mut].current,
          at.lookup("g")[Slider.mut].current,
          at.lookup("b")[Slider.mut].current
        }
      }

      const r = g.lookup("rings")
      const rc = r.lookup("color").lookup("channels")
      state.rings = {
        enabled: r.lookup("enabled")[Checkbox.mut].current,
        size: r.lookup("size")[Slider.mut].current,
        opacity: r.lookup("opacity")[Slider.mut].current,
        color: {
          rc.lookup("r")[Slider.mut].current,
          rc.lookup("g")[Slider.mut].current,
          rc.lookup("b")[Slider.mut].current
        }
      }

      if state.kind == state.KIND_GAS {
        const gg = g.lookup("gas")
        state.gas = {
          bands: gg.lookup("bands")[Slider.mut].current,
          turbulence: gg.lookup("turbulence")[Slider.mut].current,
          drift: gg.lookup("drift")[Slider.mut].current,
          storms: gg.lookup("storms")[Slider.mut].current
        }
      } else {
        const s = g.lookup("surface")
        state.surface = {
          ocean: s.lookup("ocean")[Slider.mut].current,
          continents: s.lookup("continents")[Slider.mut].current,
          warp: s.lookup("warp")[Slider.mut].current,
          mountains: s.lookup("mountains")[Slider.mut].current,
          mountain_cover: s.lookup("mountain_cover")[Slider.mut].current,
          craters: s.lookup("craters")[Slider.mut].current,
          cracks: s.lookup("cracks")[Slider.mut].current,
          plates: s.lookup("plates")[Slider.mut].current,
          crack_shade: s.lookup("crack_shade")[Slider.mut].current,
          normal: s.lookup("normal")[Slider.mut].current,
          variation: s.lookup("variation")[Slider.mut].current,
          beach: s.lookup("beach")[Slider.mut].current
        }

        const c = g.lookup("climate")
        state.climate = {
          equator: c.lookup("equator")[Slider.mut].current,
          poles: c.lookup("poles")[Slider.mut].current,
          lapse: c.lookup("lapse")[Slider.mut].current,
          ice: c.lookup("ice")[Slider.mut].current,
          snow_line: c.lookup("snow_line")[Slider.mut].current,
          snow: c.lookup("snow")[Slider.mut].current,
          moisture: c.lookup("moisture")[Slider.mut].current,
          vegetation: c.lookup("vegetation")[Slider.mut].current,
          treeline: c.lookup("treeline")[Slider.mut].current
        }

        const k = g.lookup("clouds")
        const kc = k.lookup("color").lookup("channels")
        state.clouds = {
          cover: k.lookup("cover")[Slider.mut].current,
          opacity: k.lookup("opacity")[Slider.mut].current,
          frequency: k.lookup("frequency")[Slider.mut].current,
          speed: k.lookup("speed")[Slider.mut].current,
          evolve: k.lookup("evolve")[Slider.mut].current,
          color: {
            kc.lookup("r")[Slider.mut].current,
            kc.lookup("g")[Slider.mut].current,
            kc.lookup("b")[Slider.mut].current
          }
        }

        const n = g.lookup("night")
        state.night = {
          lights: n.lookup("lights")[Checkbox.mut].current,
          density: n.lookup("density")[Slider.mut].current,
          brightness: n.lookup("brightness")[Slider.mut].current
        }

        const l = g.lookup("lava")
        state.lava = {
          level: l.lookup("level")[Slider.mut].current,
          cracks: l.lookup("cracks")[Slider.mut].current,
          emission: l.lookup("emission")[Slider.mut].current
        }
      }

      state.edits += 1
    }
  }
}

async {
  while true {
    await on.pressed(state.actions.random_seed)
    state.seed = (state.seed * 621 + 271) % 1000
    state.edits += 1
  }
}

async {
  while true {
    await on.pressed(state.actions.reset)
    reset()
  }
}

async {
  while true {
    const e = await on.drag(stage.orbit)
    state.orbit_yaw = state.orbit_yaw - e.delta_x * 0.006
    state.orbit_pitch = clamp(state.orbit_pitch + e.delta_y * 0.006, -1.2, 1.2)
  }
}

// Show the latest values once the planet's graphs are evaluated, or after 1.5 seconds
async {
  mut waited: f32 = 0
  while true {
    await delay(0.1)
    if state.edits != state.shown_edits {
      if InProgressTask[InProgressTask].blocking == 0 || waited >= 1.5 {
        apply()
        waited = 0
      } else {
        waited += 0.1
      }
    } else {
      waited = 0
    }
  }
}

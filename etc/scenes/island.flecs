using box.view

$ {
  box.app.FpsTarget: {120}
  Scene: {
    reflections: true,
    environment: true,
    aerial_perspective: true,
    cookies: true,
    shader_features: {
      Extended: {
        alpha_cutout: true,
        blend_modes: true,
        texture_blend: true,
        water: true,
        texture_layers: true,
        wind: true
      },
      Terrain: {
        texture_blend: true,
        texture_layers: true,
        triplanar: true
      }
    }
  }
}

using flecs.script
using flecs.script.math
using box.texture

// Procedural bark and dead wood. Every bark is a set of texture graphs made by one template
// with a map prop: albedo, normal, height (for blends) and ORM, tiling, the features running
// along v, so a bark mapped by length up a trunk and around it does not stretch.
trees {
  export const TREE_BARK_RES: i32 = 1024

  // The maps of a bark
  export const TREE_MAP_ALBEDO: i32 = 0
  export const TREE_MAP_NORMAL: i32 = 1
  export const TREE_MAP_HEIGHT: i32 = 2
  export const TREE_MAP_ORM: i32 = 3

  // Beech: smooth grey bark, mottled in lighter and darker greys with a hint of green, fine
  // horizontal wrinkles and a few dark eye marks. Also the bark of the fir, tinted darker
  template TreeBeechBarkMap {
    prop map: i32 = 0

    warp_n { nodes.Noise: {channels: 3, frequency: 3, octaves: 2, seed: 201} }
    warp { nodes.Warp: {offset: warp_n, amount_value: 0.03} }
    mottle { nodes.Noise: {coords: warp, frequency: 6, octaves: 5, seed: 202} }
    across { nodes.Transform: {coords: warp, scale: {1, 6, 1}} }
    wrinkle_n { nodes.Noise: {coords: across, frequency: 8, octaves: 3, fractal: NoiseRidged, seed: 203} }
    wrinkle { nodes.Smoothstep: {input: wrinkle_n, edge0_value: {0.8, 0, 0, 0}, edge1_value: {0.95, 0, 0, 0}} }
    eyes_c { nodes.Cells: {coords: across, distance: CellsNearest, count: 160, seed: 204} }
    eyes_d { nodes.Split: {input: eyes_c, channel: ChannelR} }
    eyes_r { nodes.Split: {input: eyes_c, channel: ChannelB} }
    eyes_on { nodes.Step: {input: eyes_r, edge_value: {0.86, 0, 0, 0}} }
    eyes_shape { nodes.Smoothstep: {input: eyes_d, edge0_value: {0.3, 0, 0, 0}, edge1_value: {0.14, 0, 0, 0}} }
    eyes { nodes.Multiply: {a: eyes_shape, b: eyes_on} }
    grain { nodes.Noise: {frequency: 96, octaves: 2, seed: 205} }
    base { nodes.Remap: {input: mottle, from_min: 0, from_max: 1, to_min: 0.45, to_max: 0.65} }
    fine { nodes.Multiply: {a: grain, b_value: {0.06, 0, 0, 0}} }
    h_fine { nodes.Add: {a: base, b: fine} }
    h_wrinkle { nodes.Mix: {a: h_fine, b_value: {0.35, 0, 0, 0}, factor: wrinkle} }
    height { nodes.Mix: {a: h_wrinkle, b_value: {0.3, 0, 0, 0}, factor: eyes} }

    if map == TREE_MAP_ALBEDO {
      grey {
        nodes.Ramp: {
          input: mottle,
          keys: [
            {0.2, {96, 98, 94}}, {0.4, {124, 126, 120}}, {0.55, {142, 142, 134}},
            {0.7, {118, 124, 112}}, {0.85, {152, 150, 140}}
          ]
        }
      }

      green_n { nodes.Noise: {coords: warp, frequency: 4, octaves: 3, seed: 206} }
      green { nodes.Smoothstep: {input: green_n, edge0_value: {0.55, 0, 0, 0}, edge1_value: {0.75, 0, 0, 0}} }
      algae { nodes.Mix: {a: grey, b_value: {0.12, 0.15, 0.09, 1}, factor: green} }
      lines { nodes.Mix: {a: algae, b_value: {0.07, 0.07, 0.065, 1}, factor: wrinkle} }
      color { nodes.Mix: {a: lines, b_value: {0.03, 0.03, 0.028, 1}, factor: eyes} }
      Graph: {output: color, width: TREE_BARK_RES}
    } else if map == TREE_MAP_NORMAL {
      bumps { nodes.Normal: {height: height, strength: 1.5} }
      Graph: {output: bumps, width: TREE_BARK_RES, format: GraphLinear}
    } else if map == TREE_MAP_HEIGHT {
      Graph: {output: height, width: TREE_BARK_RES, format: GraphSingle}
    } else {
      occlusion { nodes.Remap: {input: height, from_min: 0.25, from_max: 0.55, to_min: 0.7, to_max: 1, clamp: true} }
      rough { nodes.Remap: {input: mottle, from_min: 0, from_max: 1, to_min: 0.88, to_max: 0.72, clamp: true} }
      orm { nodes.Combine: {r: occlusion, g: rough, b_value: 0, a_value: 1} }
      Graph: {output: orm, width: TREE_BARK_RES, format: GraphLinear}
    }
  }

  // Oak: deep vertical furrows between long, blocky ridges, cracked across into plates, in grey
  // browns with lichen on the ridges
  template TreeOakBarkMap {
    prop map: i32 = 0

    warp_n { nodes.Noise: {channels: 3, frequency: 4, octaves: 2, seed: 211} }
    warp { nodes.Warp: {offset: warp_n, amount_value: 0.05} }
    // Coordinates squeezed across, so the features run long up the trunk
    long { nodes.Transform: {coords: warp, scale: {5, 1, 1}} }
    ridges { nodes.Noise: {coords: long, frequency: 3, octaves: 4, fractal: NoiseRidged, seed: 212} }
    plates_c { nodes.Cells: {coords: long, distance: CellsEdge, count: 90, edge: 0.2, seed: 213} }
    plate_d { nodes.Split: {input: plates_c, channel: ChannelR} }
    plate_t { nodes.Split: {input: plates_c, channel: ChannelB} }
    furrow { nodes.Smoothstep: {input: plate_d, edge0_value: {0, 0, 0, 0}, edge1_value: {0.3, 0, 0, 0}} }
    grain { nodes.Noise: {coords: long, frequency: 48, octaves: 2, seed: 214} }
    top { nodes.Remap: {input: ridges, from_min: 0, from_max: 1, to_min: 0.45, to_max: 0.9} }
    plate_h { nodes.Remap: {input: plate_t, from_min: 0, from_max: 1, to_min: 0.85, to_max: 1} }
    raised { nodes.Multiply: {a: top, b: plate_h} }
    h_plates { nodes.Multiply: {a: raised, b: furrow} }
    fine { nodes.Multiply: {a: grain, b_value: {0.08, 0, 0, 0}} }
    height { nodes.Add: {a: h_plates, b: fine} }

    if map == TREE_MAP_ALBEDO {
      wood {
        nodes.Ramp: {
          input: height,
          keys: [
            {0.1, {30, 25, 20}}, {0.3, {58, 50, 42}}, {0.5, {92, 84, 72}},
            {0.7, {118, 110, 96}}, {0.9, {140, 132, 116}}
          ]
        }
      }

      lichen_n { nodes.Noise: {coords: warp, frequency: 10, octaves: 3, seed: 215} }
      lichen_s { nodes.Smoothstep: {input: lichen_n, edge0_value: {0.6, 0, 0, 0}, edge1_value: {0.7, 0, 0, 0}} }
      lichen { nodes.Multiply: {a: lichen_s, b: furrow} }
      color { nodes.Mix: {a: wood, b_value: {0.22, 0.25, 0.15, 1}, factor: lichen} }
      Graph: {output: color, width: TREE_BARK_RES}
    } else if map == TREE_MAP_NORMAL {
      bumps { nodes.Normal: {height: height, strength: 5} }
      Graph: {output: bumps, width: TREE_BARK_RES, format: GraphLinear}
    } else if map == TREE_MAP_HEIGHT {
      Graph: {output: height, width: TREE_BARK_RES, format: GraphSingle}
    } else {
      occlusion { nodes.Remap: {input: height, from_min: 0, from_max: 0.5, to_min: 0.3, to_max: 1, clamp: true} }
      orm { nodes.Combine: {r: occlusion, g_value: 0.95, b_value: 0, a_value: 1} }
      Graph: {output: orm, width: TREE_BARK_RES, format: GraphLinear}
    }
  }

  // Birch: chalk white with a cream peel, dark horizontal lenticels, and black rough patches and
  // marks, which the trunk material darkens further toward its foot
  template TreeBirchBarkMap {
    prop map: i32 = 0

    warp_n { nodes.Noise: {channels: 3, frequency: 4, octaves: 2, seed: 221} }
    warp { nodes.Warp: {offset: warp_n, amount_value: 0.02} }
    // Coordinates squeezed along the trunk, so the lenticels run around it
    wide { nodes.Transform: {coords: warp, scale: {1, 10, 1}} }
    lent_c { nodes.Cells: {coords: wide, distance: CellsNearest, count: 140, seed: 222} }
    lent_d { nodes.Split: {input: lent_c, channel: ChannelR} }
    lent_r { nodes.Split: {input: lent_c, channel: ChannelB} }
    lent_on { nodes.Step: {input: lent_r, edge_value: {0.4, 0, 0, 0}} }
    lent_shape { nodes.Smoothstep: {input: lent_d, edge0_value: {0.3, 0, 0, 0}, edge1_value: {0.16, 0, 0, 0}} }
    lenticels { nodes.Multiply: {a: lent_shape, b: lent_on} }
    marks_n { nodes.Noise: {coords: warp, frequency: 5, octaves: 5, seed: 223} }
    marks { nodes.Smoothstep: {input: marks_n, edge0_value: {0.63, 0, 0, 0}, edge1_value: {0.7, 0, 0, 0}} }
    peel_n { nodes.Noise: {coords: wide, frequency: 3, octaves: 3, seed: 224} }
    peel { nodes.Smoothstep: {input: peel_n, edge0_value: {0.58, 0, 0, 0}, edge1_value: {0.72, 0, 0, 0}} }
    grain { nodes.Noise: {frequency: 128, octaves: 2, seed: 225} }
    fine { nodes.Multiply: {a: grain, b_value: {0.05, 0, 0, 0}} }
    h_base { nodes.Add: {a: fine, b_value: {0.6, 0, 0, 0}} }
    h_peel { nodes.Mix: {a: h_base, b_value: {0.7, 0, 0, 0}, factor: peel} }
    h_lent { nodes.Mix: {a: h_peel, b_value: {0.42, 0, 0, 0}, factor: lenticels} }
    rough_n { nodes.Noise: {coords: warp, frequency: 40, octaves: 3, fractal: NoiseRidged, seed: 226} }
    rough_h { nodes.Multiply: {a: rough_n, b_value: {0.3, 0, 0, 0}} }
    h_mark { nodes.Add: {a: rough_h, b_value: {0.2, 0, 0, 0}} }
    height { nodes.Mix: {a: h_lent, b: h_mark, factor: marks} }

    if map == TREE_MAP_ALBEDO {
      chalk {
        nodes.Ramp: {input: grain, keys: [{0.3, {214, 212, 204}}, {0.7, {232, 230, 222}}]}
      }

      cream { nodes.Mix: {a: chalk, b_value: {0.62, 0.5, 0.38, 1}, factor: peel} }
      dashes { nodes.Mix: {a: cream, b_value: {0.05, 0.04, 0.035, 1}, factor: lenticels} }
      color { nodes.Mix: {a: dashes, b_value: {0.018, 0.016, 0.015, 1}, factor: marks} }
      Graph: {output: color, width: TREE_BARK_RES}
    } else if map == TREE_MAP_NORMAL {
      bumps { nodes.Normal: {height: height, strength: 2} }
      Graph: {output: bumps, width: TREE_BARK_RES, format: GraphLinear}
    } else if map == TREE_MAP_HEIGHT {
      Graph: {output: height, width: TREE_BARK_RES, format: GraphSingle}
    } else {
      occlusion { nodes.Remap: {input: height, from_min: 0.15, from_max: 0.5, to_min: 0.6, to_max: 1, clamp: true} }
      rough { nodes.Remap: {input: marks, from_min: 0, from_max: 1, to_min: 0.62, to_max: 0.95, clamp: true} }
      orm { nodes.Combine: {r: occlusion, g: rough, b_value: 0, a_value: 1} }
      Graph: {output: orm, width: TREE_BARK_RES, format: GraphLinear}
    }
  }

  // Spruce: thin scales in reddish and grey browns, layered over each other, with dark gaps
  template TreeSpruceBarkMap {
    prop map: i32 = 0

    warp_n { nodes.Noise: {channels: 3, frequency: 6, octaves: 2, seed: 231} }
    warp { nodes.Warp: {offset: warp_n, amount_value: 0.03} }
    tall { nodes.Transform: {coords: warp, scale: {2, 1, 1}} }
    scales_c { nodes.Cells: {coords: tall, distance: CellsEdge, count: 320, edge: 0.15, seed: 232} }
    scale_d { nodes.Split: {input: scales_c, channel: ChannelR} }
    scale_t { nodes.Split: {input: scales_c, channel: ChannelB} }
    scale_edge { nodes.Smoothstep: {input: scale_d, edge0_value: {0, 0, 0, 0}, edge1_value: {0.2, 0, 0, 0}} }
    scale_lift { nodes.Remap: {input: scale_t, from_min: 0, from_max: 1, to_min: 0.5, to_max: 0.85} }
    grain { nodes.Noise: {coords: tall, frequency: 64, octaves: 2, seed: 233} }
    h_scales { nodes.Multiply: {a: scale_lift, b: scale_edge} }
    fine { nodes.Multiply: {a: grain, b_value: {0.1, 0, 0, 0}} }
    height { nodes.Add: {a: h_scales, b: fine} }

    if map == TREE_MAP_ALBEDO {
      flakes {
        nodes.Ramp: {
          input: scale_t,
          keys: [
            {0, {92, 62, 46}}, {0.3, {118, 82, 60}}, {0.5, {96, 84, 76}},
            {0.75, {132, 96, 70}}, {1, {84, 66, 56}}
          ]
        }
      }

      color { nodes.Mix: {a_value: {0.02, 0.014, 0.01, 1}, b: flakes, factor: scale_edge} }
      Graph: {output: color, width: TREE_BARK_RES}
    } else if map == TREE_MAP_NORMAL {
      bumps { nodes.Normal: {height: height, strength: 3} }
      Graph: {output: bumps, width: TREE_BARK_RES, format: GraphLinear}
    } else if map == TREE_MAP_HEIGHT {
      Graph: {output: height, width: TREE_BARK_RES, format: GraphSingle}
    } else {
      occlusion { nodes.Remap: {input: scale_edge, from_min: 0, from_max: 1, to_min: 0.45, to_max: 1, clamp: true} }
      orm { nodes.Combine: {r: occlusion, g_value: 0.9, b_value: 0, a_value: 1} }
      Graph: {output: orm, width: TREE_BARK_RES, format: GraphLinear}
    }
  }

  // Dead wood of the snags: bleached, silvery grey wood with the grain running along it, split
  // by long cracks, darker where the bark still clings
  template TreeDeadwoodMap {
    prop map: i32 = 0

    warp_n { nodes.Noise: {channels: 3, frequency: 3, octaves: 2, seed: 241} }
    warp { nodes.Warp: {offset: warp_n, amount_value: 0.04} }
    long { nodes.Transform: {coords: warp, scale: {8, 1, 1}} }
    grain { nodes.Noise: {coords: long, frequency: 4, octaves: 5, fractal: NoiseRidged, seed: 242} }
    cracks_c { nodes.Cells: {coords: long, distance: CellsEdge, count: 40, edge: 0.05, seed: 243} }
    crack_d { nodes.Split: {input: cracks_c, channel: ChannelR} }
    crack { nodes.Smoothstep: {input: crack_d, edge0_value: {0.06, 0, 0, 0}, edge1_value: {0, 0, 0, 0}} }
    bark_n { nodes.Noise: {coords: warp, frequency: 5, octaves: 4, seed: 244} }
    bark { nodes.Smoothstep: {input: bark_n, edge0_value: {0.66, 0, 0, 0}, edge1_value: {0.72, 0, 0, 0}} }
    h_grain { nodes.Remap: {input: grain, from_min: 0, from_max: 1, to_min: 0.4, to_max: 0.7} }
    h_bark { nodes.Mix: {a: h_grain, b_value: {0.85, 0, 0, 0}, factor: bark} }
    height { nodes.Mix: {a: h_bark, b_value: {0.05, 0, 0, 0}, factor: crack} }

    if map == TREE_MAP_ALBEDO {
      wood {
        nodes.Ramp: {
          input: grain,
          keys: [{0.2, {96, 90, 82}}, {0.5, {134, 128, 116}}, {0.8, {158, 152, 140}}]
        }
      }

      clinging { nodes.Mix: {a: wood, b_value: {0.1, 0.075, 0.05, 1}, factor: bark} }
      color { nodes.Mix: {a: clinging, b_value: {0.015, 0.012, 0.01, 1}, factor: crack} }
      Graph: {output: color, width: TREE_BARK_RES}
    } else if map == TREE_MAP_NORMAL {
      bumps { nodes.Normal: {height: height, strength: 3} }
      Graph: {output: bumps, width: TREE_BARK_RES, format: GraphLinear}
    } else if map == TREE_MAP_HEIGHT {
      Graph: {output: height, width: TREE_BARK_RES, format: GraphSingle}
    } else {
      occlusion { nodes.Remap: {input: height, from_min: 0, from_max: 0.4, to_min: 0.4, to_max: 1, clamp: true} }
      orm { nodes.Combine: {r: occlusion, g_value: 0.85, b_value: 0, a_value: 1} }
      Graph: {output: orm, width: TREE_BARK_RES, format: GraphLinear}
    }
  }

  TreeBeechBarkMap bark_beech_albedo(map: TREE_MAP_ALBEDO)
  TreeBeechBarkMap bark_beech_normal(map: TREE_MAP_NORMAL)
  TreeBeechBarkMap bark_beech_height(map: TREE_MAP_HEIGHT)
  TreeBeechBarkMap bark_beech_orm(map: TREE_MAP_ORM)
  TreeOakBarkMap bark_oak_albedo(map: TREE_MAP_ALBEDO)
  TreeOakBarkMap bark_oak_normal(map: TREE_MAP_NORMAL)
  TreeOakBarkMap bark_oak_height(map: TREE_MAP_HEIGHT)
  TreeOakBarkMap bark_oak_orm(map: TREE_MAP_ORM)
  TreeBirchBarkMap bark_birch_albedo(map: TREE_MAP_ALBEDO)
  TreeBirchBarkMap bark_birch_normal(map: TREE_MAP_NORMAL)
  TreeBirchBarkMap bark_birch_height(map: TREE_MAP_HEIGHT)
  TreeBirchBarkMap bark_birch_orm(map: TREE_MAP_ORM)
  TreeSpruceBarkMap bark_spruce_albedo(map: TREE_MAP_ALBEDO)
  TreeSpruceBarkMap bark_spruce_normal(map: TREE_MAP_NORMAL)
  TreeSpruceBarkMap bark_spruce_height(map: TREE_MAP_HEIGHT)
  TreeSpruceBarkMap bark_spruce_orm(map: TREE_MAP_ORM)
  TreeDeadwoodMap bark_dead_albedo(map: TREE_MAP_ALBEDO)
  TreeDeadwoodMap bark_dead_normal(map: TREE_MAP_NORMAL)
  TreeDeadwoodMap bark_dead_height(map: TREE_MAP_HEIGHT)
  TreeDeadwoodMap bark_dead_orm(map: TREE_MAP_ORM)
}

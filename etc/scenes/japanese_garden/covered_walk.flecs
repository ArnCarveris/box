include materials
include walk_lantern
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.movement

template CoveredWalk {
  prop bays: i32 = 4
  prop bay_length: f32 = 2.27

  const length = bays * bay_length
  const center = (bays - 1) * bay_length / 2
  const roof_length = length + 0.36
  const tiles: i32 = math.ceil(roof_length / 0.22)
  const tile_width = roof_length / tiles

  // The walk under its roof, between the deck, the roof and the posts, with the capture point at
  // eye height above the deck, between two lanterns
  reflection {
    Position: {0, 1.46, center}
    ReflectionProbe: {
      extent: {2.82, 2.14, length / 2 + 1},
      blend: 1,
      priority: 2,
      projection: {1.82, 1.14, length / 2},
      offset: {0, 0.46, bay_length / 2}
    }
  }
  for side in 0..2 {
    {
      Position: {(side - 0.5) * 1.4, 0.15, center}
      Box: {0.15, 0.12, length}
      Rgb: GardenCedar
    }
    {
      Position: {(side - 0.5) * 1.96, 0.23, center}
      Box: {0.09, 0.17, length}
      Rgb: {111, 64, 47}
    }
    {
      Position: {(side - 0.5) * 1.64, 2.66, center}
      Box: {0.15, 0.16, length + 0.22}
      Rgb: GardenVermilion
      ClearCoat: GardenLacquer
    }
  }
  spine {
    Position: {0, 2.82, center}
    Box: {0.13, 0.14, length + 0.22}
    Rgb: GardenCedar
  }
  for station in 0..(bays + 1) {
    {
      Position: {0, 0, station * bay_length - bay_length / 2}
      for side in 0..2 {
        {
          Position: {(side - 0.5) * 1.82, 0.11, 0}
          RoundedBox: {0.35, 0.22, 0.35, 0.035}
          Rgb: GardenStone
        }
        {
          Position: {(side - 0.5) * 1.82, 1.46, 0}
          Box: {0.15, 2.48, 0.15}
          Rgb: GardenVermilion
          ClearCoat: GardenLacquer
        }
        {
          Position: {(side - 0.5) * 1.82, 0.4, 0}
          Box: {0.19, 0.18, 0.19}
          Rgb: {65, 60, 55}
          PbrMaterial: {roughness: 0.55, metallic: 0.25}
        }
        {
          Position: {(side - 0.5) * 1.82, 2.46, 0}
          Box: {0.27, 0.12, 0.27}
          Rgb: {177, 108, 67}
        }
        {
          Position: {(side - 0.5) * 1.82, 2.56, 0}
          Box: {0.39, 0.1, 0.35}
          Rgb: GardenVermilion
          ClearCoat: GardenLacquer
        }
        {
          Position: {(side - 0.5) * 1.46, 2.36, 0}
          Rotation: {0, 0, (side - 0.5) * 1.44}
          Box: {0.09, 0.55, 0.1}
          Rgb: GardenCedar
        }
        for face in 0..2 {
          {
            Position: {(side - 0.5) * 1.82, 2.36, (face - 0.5) * 0.17}
            Rotation: {math.PI / 2, 0, 0}
            Cylinder: {radius: 0.022, length: 0.02, segments: 12}
            Rgb: {187, 145, 83}
            PbrMaterial: {roughness: 0.45, metallic: 0.4}
          }
        }
      }
      {
        Position: {0, 2.6, 0}
        Box: {2.3, 0.13, 0.16}
        Rgb: GardenCedar
      }
      {
        Position: {0, 2.79, 0}
        Box: {0.095, 0.3, 0.12}
        Rgb: GardenCedar
      }
    }
  }
  for bay in 0..bays {
    {
      Position: {0, 0, bay * bay_length}
      for board in 0..10 {
        {
          Position: {0, 0.26, (board - 4.5) * bay_length / 10}
          Box: {2.05, 0.12, bay_length / 10 - 0.015}
          Rgb: {147 + board % 3 * 8, 99 + board % 3 * 6, 69 + board % 3 * 4}
          PbrMaterial: {roughness: 0.22}
        }
      }
      for side in 0..2 {
        {
          Position: {(side - 0.5) * 1.82, 0.87, 0}
          RoundedBox: {0.115, 0.095, bay_length - 0.15, 0.02}
          Rgb: GardenVermilion
          ClearCoat: GardenLacquer
        }
        {
          Position: {(side - 0.5) * 1.82, 0.43, 0}
          Box: {0.075, 0.075, bay_length - 0.15}
          Rgb: GardenVermilion
          ClearCoat: GardenLacquer
        }
        for slat in 0..6 {
          {
            Position: {(side - 0.5) * 1.82, 0.65, (slat - 2.5) * bay_length / 6}
            Box: {0.045, 0.37, 0.045}
            Rgb: GardenCedar
          }
        }
        for half in 0..2 {
          for edge in 0..2 {
            {
              Position: {(side - 0.5) * 1.82, 0.65 + (half - 0.5) * 0.15, (edge - 0.5) * 0.15}
              Rotation: {(half - 0.5) * (edge - 0.5) * math.PI, 0, 0}
              Box: {0.045, 0.215, 0.03}
              Rgb: {178, 122, 76}
            }
          }
        }
        for rafter in 0..6 {
          {
            Position: {(side - 0.5) * 1.28, 2.72, (rafter - 2.5) * bay_length / 6}
            Rotation: {0, 0, -(side - 0.5) * 0.62}
            Box: {1.37, 0.085, 0.075}
            Rgb: {158, 100, 65}
          }
        }
      }
      WalkLantern(tint: {255, 193 + bay % 2 * 8, 125 + bay % 2 * 12}) {
        Position: {0, 2.08, 0}
        Rotation: {0, bay * 0.6, 0}
      }
    }
  }
  for side in 0..2 {
    {
      Position: {(side - 0.5) * 1.16, 2.86, center}
      Rotation: {0, 0, -(side - 0.5) * 0.62}
      {
        Position: {}
        Box: {1.36, 0.1, roof_length}
        Rgb: {62, 80, 101}
      }
      for seam in 0..2 {
        {
          Position: {(seam - 0.5) * 0.44, 0.06, 0}
          Box: {0.022, 0.014, roof_length}
          Rgb: {72, 91, 110}
        }
      }
      for tile in 0..tiles {
        {
          Position: {0, 0.065, -roof_length / 2 + (tile + 0.5) * tile_width}
          Rotation: {0, 0, math.PI / 2}
          Cylinder: {radius: 0.035, length: 1.36, segments: 10}
          Rgb: {85, 105, 122}
        }
        {
          Position: {(side - 0.5) * 1.37, 0.065, -roof_length / 2 + (tile + 0.5) * tile_width}
          Rotation: {0, 0, math.PI / 2}
          Cylinder: {radius: 0.046, length: 0.03, segments: 12}
          Rgb: {99, 119, 131}
        }
      }
      for end in 0..2 {
        {
          Position: {0, -0.035, (end - 0.5) * (roof_length + 0.025)}
          Box: {1.43, 0.13, 0.075}
          Rgb: {146, 105, 74}
        }
      }
    }
    {
      Position: {(side - 0.5) * 2.45, 2.61, center}
      Box: {0.11, 0.12, roof_length}
      Rgb: {67, 84, 102}
    }
  }
  ridge {
    Position: {0, 3.1, center}
    Rotation: {math.PI / 2, 0, 0}
    Cylinder: {radius: 0.095, length: roof_length + 0.09, segments: 16}
    Rgb: {99, 119, 131}
  }
  for end in 0..2 {
    {
      Position: {0, 2.82, center + (end - 0.5) * roof_length}
      TrianglePrism: {2.16, 0.42, 0.065}
      Rgb: {226, 211, 178}
    }
    {
      Position: {0, 2.65, center + (end - 0.5) * (roof_length + 0.08)}
      Box: {2.28, 0.095, 0.085}
      Rgb: GardenCedar
    }
    {
      Position: {0, 2.83, center + (end - 0.5) * (roof_length + 0.08)}
      Box: {0.08, 0.36, 0.085}
      Rgb: GardenCedar
    }
    {
      Position: {0, 3.1, center + (end - 0.5) * (roof_length + 0.12)}
      Rotation: {math.PI / 2, 0, 0}
      Cylinder: {radius: 0.125, length: 0.08, segments: 16}
      Rgb: {99, 119, 131}
    }
    {
      Position: {0, 3.1, center + (end - 0.5) * (roof_length + 0.21)}
      Rotation: {math.PI / 2, 0, 0}
      Torus: {radius: 0.072, tube: 0.018, segments: 16, rings: 6}
      Rgb: {63, 81, 102}
    }
  }
}

include materials
include tree_limb
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.movement

assets {
  template WalkLantern {
    prop tint: Rgb = {255, 197, 133}

    cord {
      Position: {0, 0.565, 0}
      Cylinder: {radius: 0.012, length: 0.23, segments: 8}
      Rgb: {76, 55, 44}
    }

    hanger {
      Position: {0, 0.415, 0}
      Rotation: {math.PI / 2, 0, 0}
      Torus: {radius: 0.055, tube: 0.013, segments: 16, rings: 6}
      Rgb: {75, 66, 53}
      PbrMaterial: {roughness: 0.45, metallic: 0.4}
    }

    shade {
      Scale: {1, 1.18, 1}
      Sphere: {radius: 0.29, segments: 24, smooth: true}
      Rgb: tint
      Emissive: {strength: 7, color: tint}
    }

    for rib in 0..9 {
      const y = (rib - 4) * 0.073
      {
        Position: {0, y, 0}
        Torus: {
          radius: 0.293 * math.sqrt(1 - y * y / (0.3422 * 0.3422)),
          tube: 0.011,
          segments: 24,
          rings: 6
        }
        Rgb: {143, 84, 54}
      }
    }

    for spine in 0..6 {
      const angle = spine * math.PI / 3

      for piece in 0..8 {
        const a0 = -1.2 + piece * 0.3
        const a1 = a0 + 0.3
        TreeLimb(
          ax: math.cos(angle) * math.cos(a0) * 0.294,
          ay: math.sin(a0) * 0.346,
          az: math.sin(angle) * math.cos(a0) * 0.294,
          bx: math.cos(angle) * math.cos(a1) * 0.294,
          by: math.sin(a1) * 0.346,
          bz: math.sin(angle) * math.cos(a1) * 0.294,
          base: 0.009,
          tip: 0.009,
          tint: {161, 96, 64}
        )
      }
    }

    for end in 0..2 {
      {
        Position: {0, (end - 0.5) * 0.67, 0}
        Cylinder: {radius: 0.115, length: 0.06, segments: 20}
        Rgb: {86, 53, 43}
      }

      {
        Position: {0, (end - 0.5) * 0.72, 0}
        Torus: {radius: 0.104, tube: 0.013, segments: 20, rings: 6}
        Rgb: {196, 150, 82}
        PbrMaterial: {roughness: 0.4, metallic: 0.35}
      }
    }

    knot {
      Position: {0, -0.395, 0}
      Scale: {1, 1.35, 1}
      Sphere: {radius: 0.027, segments: 12, smooth: true}
      Rgb: GardenVermilion
      ClearCoat: GardenLacquer
    }

    for strand in 0..7 {
      {
        Position: {math.cos(strand * 0.898) * 0.018, -0.48, math.sin(strand * 0.898) * 0.018}
        Cylinder: {radius: 0.006, length: 0.14 + strand % 2 * 0.02, segments: 6}
        Rgb: {173 + strand % 2 * 18, 62, 48}
      }
    }
  }
}

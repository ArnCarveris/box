include materials
include rock
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.movement

assets {
  template WaterBasin {
    basin {
      Position: {0, 0.4, 0}
      Tube: {radius: 0.5, thickness: 0.15, length: 0.65, segments: 12}
      Rgb: GardenStone
    }
    water {
      Position: {0, 0.61, 0}
      Cylinder: {radius: 0.35, length: 0.035, segments: 24}
      Rgb: {79, 143, 150}
      PbrMaterial: {roughness: 0.06}
    }
    for i in 0..2 {
      {
        Position: {(i - 0.5) * 0.55, 0.82, -0.35}
        Cylinder: {radius: 0.055, length: 1.64, segments: 8}
        Rgb: {157, 170, 110}
      }
    }
    spout {
      Position: {0, 1.3, -0.28}
      Rotation: {1.3, 0, 0}
      Tube: {radius: 0.075, thickness: 0.022, length: 0.8, segments: 10}
      Rgb: {176, 184, 119}
    }
    stream {
      Position: {0, 0.94, 0.1}
      Cylinder: {radius: 0.016, length: 0.55, segments: 6}
      Rgb: {153, 194, 197}
    }
    GardenRock(size: 0.55) { Position: {-0.55, 0, 0.2} }
    GardenRock(size: 0.4) { Position: {0.5, 0, 0.1} }
  }
}

using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.movement

template CeramicVase {
  prop glaze: Rgb = {126, 173, 164}

  vase_profile {
    Path2D: {
      start: {0.075, 0},
      segments: [
        {kind: Line, end: {0.082, 0.035}},
        {kind: CatmullRom, end: {0.128, 0.075}},
        {kind: CatmullRom, end: {0.15, 0.155}},
        {kind: CatmullRom, end: {0.132, 0.235}},
        {kind: CatmullRom, end: {0.086, 0.3}},
        {kind: CatmullRom, end: {0.07, 0.35}},
        {kind: CatmullRom, end: {0.078, 0.4}}
      ]
    }
  }
  body {
    Position: {0, 0, 0}
    Lathe: {profile: vase_profile, cap_start: true, cap_end: true, segments: 24}
    Rgb: glaze
    PbrMaterial: {roughness: 0.28}
    ClearCoat: {strength: 0.5, roughness: 0.1}
  }
  lip {
    Position: {0, 0.4, 0}
    Torus: {radius: 0.067, tube: 0.012, segments: 20, rings: 6}
    Rgb: glaze
    PbrMaterial: {roughness: 0.28}
  }
  opening {
    Position: {0, 0.402, 0}
    Cylinder: {radius: 0.058, length: 0.004, segments: 20}
    Rgb: {43, 57, 53}
  }
  for i in 0..2 {
    {
      Position: {0, 0.11 + i * 0.045, 0}
      Torus: {radius: 0.142 + i * 0.006, tube: 0.008, segments: 20, rings: 6}
      Rgb: {219, 207, 166}
    }
  }
}

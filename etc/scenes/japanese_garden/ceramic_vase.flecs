using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.movement

@tree Parent
template CeramicVase {
  prop glaze: Rgb = {126, 173, 164}

  foot {
    Position: {0, 0.025, 0}
    Cylinder: {radius: 0.08, length: 0.05, segments: 16}
    Rgb: glaze
  }
  body {
    Position: {0, 0.16, 0}
    Scale: {1, 0.9, 1}
    Sphere: {radius: 0.15, segments: 20, smooth: true}
    Rgb: glaze
    PbrMaterial: {roughness: 0.28}
  }
  shoulder {
    Position: {0, 0.26, 0}
    Frustum: {radius_bottom: 0.13, radius_top: 0.067, length: 0.13, segments: 20, smooth: true}
    Rgb: glaze
    PbrMaterial: {roughness: 0.28}
  }
  neck {
    Position: {0, 0.34, 0}
    Tube: {radius: 0.075, thickness: 0.018, length: 0.12, segments: 20}
    Rgb: glaze
    PbrMaterial: {roughness: 0.28}
  }
  lip {
    Position: {0, 0.398, 0}
    Torus: {radius: 0.067, tube: 0.012, segments: 20, rings: 6}
    Rgb: glaze
    PbrMaterial: {roughness: 0.28}
  }
  opening {
    Position: {0, 0.335, 0}
    Cylinder: {radius: 0.055, length: 0.008, segments: 20}
    Rgb: {43, 57, 53}
  }
  for i in 0..2 {
    {
      Position: {0, 0.11 + i * 0.045, 0}
      Torus: {radius: 0.14 + i * 0.008, tube: 0.009, segments: 20, rings: 6}
      Rgb: {219, 207, 166}
    }
  }
}

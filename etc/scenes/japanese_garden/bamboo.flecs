include materials
include tree_limb
include leaf
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.movement

assets {
  template Bamboo {
    prop height: f32 = 2.6
    prop phase: f32 = 0

    stalk_path {
      Path3D: {
        start: {0, 0, 0},
        segments: [
          {kind: CatmullRom, end: {0.16 / 49, height / 7, 0}},
          {kind: CatmullRom, end: {0.16 * 4 / 49, height * 2 / 7, 0}},
          {kind: CatmullRom, end: {0.16 * 9 / 49, height * 3 / 7, 0}},
          {kind: CatmullRom, end: {0.16 * 16 / 49, height * 4 / 7, 0}},
          {kind: CatmullRom, end: {0.16 * 25 / 49, height * 5 / 7, 0}},
          {kind: CatmullRom, end: {0.16 * 36 / 49, height * 6 / 7, 0}},
          {kind: CatmullRom, end: {0.16, height, 0}}
        ]
      }
    }

    stalk {
      Position: {0, 0, 0}
      Sweep: {
        path: stalk_path,
        profile: GardenRoundProfile,
        scale: {0.082, 0.082},
        taper: 0.61,
        rings: 42
      }
      Rgb: {122, 167, 85}
      PbrMaterial: {roughness: 0.55}
    }

    for i in 1..8 {
      const t = i / 7.0
      const lean = math.atan2(t * 0.32, height)
      {
        Position: {t * t * 0.16, height * t - 0.06, 0}
        Rotation: {0, 0, 0 - lean}
        Torus: {radius: 0.082 - t * 0.032, tube: 0.011, segments: 14, rings: 6}
        Rgb: {58, 93, 51}
      }

      {
        Position: {t * t * 0.16, height * t - 0.035, 0}
        Rotation: {0, 0, 0 - lean}
        Torus: {radius: 0.087 - t * 0.032, tube: 0.016, segments: 14, rings: 6}
        Rgb: {199, 211, 144}
      }
    }

    for i in 0..4 {
      const t = (i + 3) / 7.0
      const angle = i * 2.4 + phase
      const x = t * t * 0.16
      const y = height * t
      TreeLimb(ax: x, ay: y, az: 0,
        bx: x + math.cos(angle) * 0.48, by: y + 0.18, bz: math.sin(angle) * 0.48,
        base: 0.017, tip: 0.004, tint: {127, 155, 93})

      for j in 0..4 {
        const along = 0.13 + j * 0.1
        GardenLeaf(tint: {95 + j % 3 * 12, 139 + j % 3 * 10, 92 + j % 2 * 14}) {
          Position: {x + math.cos(angle) * along, y + along * 0.375, math.sin(angle) * along}
          Rotation: {0.25 + j * 0.12, math.PI / 2 - angle + (j % 2 - 0.5) * 1.35, 0}
          Scale: {0.65, 1, 1.3 + j % 2 * 0.3}
        }
      }
    }

    TreeLimb(ax: 0.16, ay: height, az: 0, bx: 0.2, by: height + 0.18, bz: 0.03,
      base: 0.05, tip: 0.006, tint: {126, 159, 103})

    for i in 0..2 {
      GardenLeaf(tint: {137, 168, 110}) {
        Position: {0.18, height + 0.09, 0.015}
        Rotation: {-0.65, phase + i * 2.6, 0}
        Scale: {0.5, 1, 0.95}
      }
    }
  }
}

        flower_bowl {
          Position: {0, 0.58, 0.35}
          Scale: {1, 0.45, 1}
          Sphere: {radius: 0.28, segments: 12, smooth: true}
          Rgb: accent
        }
        FlowerArrangement(tint: {248, 208, 174}, phase: 0.7) {
          Position: {0, 0.64, 0.35}
          Scale: {1.55, 1.3, 1.55}
        }
        for side in 0..2 {
          {
            Position: {(side - 0.5) * 0.82, 0.27, 0.55}
            Box: {0.035, 0.38, 0.05}
            Rgb: {181, 138, 91}
          }
        }
        arrangement_label {
          Position: {0, 0.43, 0.69}
          Box: {0.23, 0.09, 0.015}
          Rgb: GardenPaper
        }
      }
    }

    if style == 2 {
      desk {
        Position: {-0.6, 0.5, -0.1}
        Box: {1.5, 0.1, 0.8}
        Rgb: timber
      }
      for side in 0..2 {
        {
          Position: {-0.6 + (side - 0.5) * 1.2, 0.265, -0.1}
          Box: {0.12, 0.37, 0.55}
          Rgb: timber
        }
      }
      paper_sheet {
        Position: {-0.6, 0.555, -0.06}
        Box: {0.54, 0.01, 0.4}
        Rgb: GardenPaper
      }
      inkstone {
        Position: {-0.04, 0.575, -0.22}
        Box: {0.16, 0.05, 0.22}
        Rgb: GardenSlate
      }
      brush {
        Position: {-0.6, 0.575, 0.12}
        Rotation: {0, 0, math.PI / 2}
        Cylinder: {radius: 0.012, length: 0.4, segments: 6}
        Rgb: timber
      }
      SeatCushion(tint: accent) { Position: {-0.6, 0.16, 0.38} }
      ink_pool {
        Position: {-0.04, 0.602, -0.22}
        RoundedBox: {0.11, 0.008, 0.15, 0.025}
        Rgb: {27, 33, 39}
        PbrMaterial: {roughness: 0.14}
      }
      brush_tip {
        Position: {-0.36, 0.575, 0.12}
        Rotation: {0, 0, -math.PI / 2}
        Cone: {radius: 0.018, length: 0.08, segments: 8}
        Rgb: {48, 44, 41}
      }
      for i in 0..4 {
        {
          Position: {-0.72 + i * 0.075, 0.562, -0.08 + math.sin(i * 1.8) * 0.04}
          Rotation: {0, -0.2 + i * 0.12, 0}
          Box: {0.016, 0.004, 0.13 - i % 2 * 0.035}
          Rgb: {48, 54, 57}
        }
      }
      for i in 0..2 {
        {
          Position: {-1.15, 0.59 + i * 0.065, -0.25}
          Box: {0.29, 0.045, 0.32}
          Rgb: {214, 202, 173}
        }
        for cover in 0..2 {
          {
            Position: {-1.15, 0.563 + i * 0.065 + cover * 0.054, -0.25}
            Box: {0.31, 0.009, 0.34}
            Rgb: accent
          }
        }
      }
      for side in 0..2 {
        {
          Position: {1.4 + (side - 0.5) * 0.8, 0.75, -0.65}
          Box: {0.07, 1.5, 0.38}
          Rgb: timber
        }
      }
      for shelf in 0..3 {
        {
          Position: {1.4, 0.12 + shelf * 0.5, -0.65}
          Box: {0.8, 0.07, 0.38}
          Rgb: timber
        }
        for book in 0..5 {
          {
            Position: {1.12 + book * 0.14, 0.3 + shelf * 0.5, -0.65}
            Box: {0.1, 0.29 - book % 2 * 0.05, 0.27}
            Rgb: {135 + book * 17, 130 + shelf * 20, 131 + book % 3 * 24}
          }
          {
            Position: {1.12 + book * 0.14, 0.34 + shelf * 0.5, -0.509}
            Box: {0.055, 0.085, 0.008}
            Rgb: {231, 218, 183}
          }
          for band in 0..2 {
            {
              Position: {1.12 + book * 0.14, 0.21 + shelf * 0.5 + band * 0.16, -0.509}
              Box: {0.1, 0.012, 0.008}
              Rgb: {92, 87, 86}
            }
          }
        }
      }
    }

    if style == 4 {
      for i in 0..3 {
        {
          Position: {(i - 1) * 1.08, 0.17, 0.05}
          Scale: {1, 0.29, 1}
          Sphere: {radius: 0.31, segments: 24, smooth: true}
          Rgb: accent
        }
        {
          Position: {(i - 1) * 1.08, 0.17, 0.05}
          Torus: {radius: 0.305, tube: 0.012, segments: 24, rings: 6}
          Rgb: {218, 196, 162}
        }
        for stitch in 0..12 {
          const x = math.cos(stitch * math.PI / 6)
          const z = math.sin(stitch * math.PI / 6)
          TreeLimb(ax: (i - 1) * 1.08 + x * 0.31, ay: 0.17, az: 0.05 + z * 0.31,
            bx: (i - 1) * 1.08 + x * 0.286, by: 0.205, bz: 0.05 + z * 0.286,
            base: 0.007, tip: 0.007, tint: {218, 196, 162})
        }
      }
      altar {
        Position: {0, 0.24, -0.9}
        Box: {1.15, 0.32, 0.42}
        Rgb: timber
      }
      singing_bowl {
        Position: {0, 0.5, -0.9}
        Tube: {radius: 0.18, thickness: 0.035, length: 0.2, segments: 20}
        Rgb: {193, 153, 83}
        PbrMaterial: {roughness: 0.3, metallic: 0.6}
      }
      bowl_rim {
        Position: {0, 0.603, -0.9}
        Torus: {radius: 0.163, tube: 0.018, segments: 24, rings: 8}
        Rgb: {222, 184, 111}
        PbrMaterial: {roughness: 0.25, metallic: 0.6}
      }
      bowl_bottom {
        Position: {0, 0.416, -0.9}
        Cylinder: {radius: 0.148, length: 0.018, segments: 24}
        Rgb: {139, 105, 53}
      }
      striker {
        Position: {0.34, 0.425, -0.85}
        Rotation: {math.PI / 2, 0.3, 0}
        Cylinder: {radius: 0.025, length: 0.28, segments: 12}
        Rgb: {155, 108, 66}
      }
      incense_dish {
        Position: {-0.36, 0.42, -0.9}
        Cylinder: {radius: 0.11, length: 0.035, segments: 20}
        Rgb: accent
      }
      for i in 0..3 {
        {
          Position: {-0.4 + i * 0.035, 0.54, -0.9}
          Cylinder: {radius: 0.007, length: 0.22, segments: 6}
          Rgb: {172, 125, 72}
        }
      }
      CeramicVase(glaze: accent) { Position: {1.55, 0.08, -0.8} }
      FlowerArrangement(tint: {242, 222, 184}, phase: 2) {
        Position: {1.55, 0.48, -0.8}
        Scale: {1, 1.35, 1}
      }

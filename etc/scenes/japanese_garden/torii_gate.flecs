include materials
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.movement

assets {
  template ToriiGate {
    for side in 0..2 {
      {
        Position: {(side - 0.5) * 2.5, 1.3, 0}
        Cylinder: {radius: 0.12, length: 2.6, segments: 12}
        Rgb: GardenVermilion
        ClearCoat: GardenLacquer
      }

      {
        Position: {(side - 0.5) * 2.5, 0.16, 0}
        Cylinder: {radius: 0.2, length: 0.32, segments: 8}
        Rgb: GardenSlate
      }
    }

    crossbeam {
      Position: {0, 2.15, 0}
      Box: {3.05, 0.16, 0.18}
      Rgb: GardenVermilion
      ClearCoat: GardenLacquer
    }

    {
      Position: {0, 2.64, 0}
      Box: {3.38, 0.2, 0.27}
      Rgb: GardenVermilion
      ClearCoat: GardenLacquer
    }

    for side in 0..2 {
      {
        Position: {(side - 0.5) * 3.35, 2.74, 0}
        Rotation: {0, 0, (side - 0.5) * 0.4}
        Box: {0.66, 0.16, 0.32}
        Rgb: GardenSlate
      }
    }

    {
      Position: {0, 2.79, 0}
      Box: {3, 0.12, 0.32}
      Rgb: GardenSlate
    }

    plaque {
      Position: {0, 2.38, 0.04}
      Box: {0.28, 0.44, 0.15}
      Rgb: {215, 177, 110}
    }
  }
}

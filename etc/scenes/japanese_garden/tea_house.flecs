include materials
include paper_lantern
include ceramic_vase
include sakura_flower
include tree_limb
include house_interior
using flecs.script
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using box.movement

assets {
  template TeaHouseFrame {
    prop variant: i32 = 0
    prop accent: Rgb = {151, 109, 139}
    prop timber: Rgb = {109, 65, 53}

    for side in 0..2 {
      for block in 0..9 {
        {
          Position: {(block - 4) * 0.5, 0.16, (side - 0.5) * 3.29}
          RoundedBox: {0.47, 0.23, 0.075, 0.025}
          Rgb: {158 + block % 3 * 9, 166 + block % 3 * 8, 156 + block % 3 * 7}
        }
      }

      for block in 0..6 {
        {
          Position: {(side - 0.5) * 4.59, 0.16, (block - 2.5) * 0.5}
          RoundedBox: {0.075, 0.23, 0.47, 0.025}
          Rgb: {158 + block % 3 * 9, 166 + block % 3 * 8, 156 + block % 3 * 7}
        }
      }
    }

    for i in 0..19 {
      {
        Position: {-2.14 + i * 0.238, 0.505, 0.2}
        Box: {0.22, 0.035, 3.44}
        Rgb: {149 + i % 3 * 8, 99 + i % 3 * 6, 69 + i % 3 * 4}
        PbrMaterial: {roughness: 0.2}
      }
    }

    for track in 0..2 {
      {
        Position: {0, 0.57, 0.755 + track * 0.08}
        Box: {4.1, 0.009, 0.017}
        Rgb: {66, 47, 41}
      }
    }

    for board in 0..15 {
      {
        Position: {(board - 7) * 0.27, 0.85, -1.45}
        Box: {0.25, 0.55, 0.065}
        Rgb: {126 + board % 3 * 9, 87 + board % 3 * 7, 65 + board % 3 * 5}
      }
    }

    for rail in 0..2 {
      {
        Position: {0, 0.57 + rail * 0.58, -1.46}
        Box: {4.2, 0.085, 0.11}
        Rgb: timber
      }
    }

    for post in 0..4 {
      {
        Position: {-1.72 + post * 1.145, 1.84, -1.45}
        Box: {0.08, 1.31, 0.09}
        Rgb: timber
      }
    }

    for i in 0..17 {
      {
        Position: {(i - 8) * 0.24, 2.53, 0.82}
        Rotation: {0, 0, math.PI / 4}
        Box: {0.035, 0.23, 0.045}
        Rgb: {171, 116, 79}
      }
    }

    for side in 0..2 {
      for rafter in 0..15 {
        {
          Position: {(rafter - 7) * 0.36, 2.55, 0.1 + (side - 0.5) * 3.74}
          Box: {0.095, 0.13, 0.67}
          Rgb: {171, 116, 79}
        }
      }

      {
        Position: {(side - 0.5) * 0.48, 2.56, 1.825}
        Cylinder: {radius: 0.014, length: 0.12, segments: 8}
        Rgb: {56, 53, 48}
      }
    }

    if variant % 3 == 2 {
      for i in 0..3 {
        {
          Position: {(i - 1) * 0.36, 2.31, 1.75}
          Box: {0.33, 0.52, 0.035}
          Rgb: accent
        }

        {
          Position: {(i - 1) * 0.36, 2.3, 1.775}
          Rotation: {math.PI / 2, 0, 0}
          Cylinder: {radius: 0.065, length: 0.012, segments: 12}
          Rgb: GardenPaper
        }
      }
    }

    for i in 0..3 {
      {
        Position: {(i - 1) * 0.21, 1.65, -1.5}
        Box: {0.035, 0.84 - math.abs(i - 1) * 0.09, 0.035}
        Rgb: timber
      }
    }
  }

  template TeaHouseSides {
    prop variant: i32 = 0
    prop wall: Rgb = {238, 222, 192}
    prop timber: Rgb = {109, 65, 53}
    const panel_width = 0.8 + variant % 2 * 0.35
    const panes = 3 + variant % 3

    for side in 0..2 {
      {
        Position: {(side - 0.5) * 4.1, 1.52, -0.4}
        Box: {0.14, 2.05, 2.05}
        Rgb: wall
      }

      for board in 0..8 {
        {
          Position: {(side - 0.5) * 4.28, 0.85, -1.28 + board * 0.25}
          Box: {0.065, 0.55, 0.23}
          Rgb: {126 + board % 3 * 9, 87 + board % 3 * 7, 65 + board % 3 * 5}
        }
      }

      for rail in 0..2 {
        {
          Position: {(side - 0.5) * 4.28, 0.57 + rail * 0.58, -0.4}
          Box: {0.11, 0.085, 2.12}
          Rgb: timber
        }
      }

      {
        Position: {(side - 0.5) * 4.28, 1.73, -0.4}
        Rotation: {0, (side - 0.5) * math.PI, 0}
        panel {
          Position: {0, 0, 0}
          Box: {0.85, 0.8, 0.03}
          Rgb: GardenPaper
          Emissive: {strength: 0.35, color: {255, 183, 105}}
          DiffuseTransmission: GardenShoji
        }

        for bar in 0..5 {
          {
            Position: {(bar - 2) * 0.21, 0, 0.04}
            Box: {0.035, 0.85, 0.06}
            Rgb: timber
          }
        }

        for bar in 0..4 {
          {
            Position: {0, (bar - 1.5) * 0.26, 0.04}
            Box: {0.91, 0.035, 0.06}
            Rgb: timber
          }
        }

        sill {
          Position: {0, -0.45, 0.04}
          Box: {1.01, 0.075, 0.17}
          Rgb: timber
        }
      }

      {
        Position: {(side - 0.5) * 4.14, 2.46, 0.13}
        Box: {0.16, 0.17, 3.32}
        Rgb: timber
      }

      for z in 0..2 {
        {
          Position: {(side - 0.5) * 4.12, 1.59, -1.35 + z * 3.05}
          Box: {0.19, 2.23, 0.19}
          Rgb: timber
        }

        {
          Position: {(side - 0.5) * 4.12, 0.61, -1.35 + z * 3.05}
          Box: {0.235, 0.21, 0.235}
          Rgb: {67, 65, 61}
          PbrMaterial: {roughness: 0.6, metallic: 0.25}
        }

        {
          Position: {(side - 0.5) * 4.12, 2.37, -1.35 + z * 3.05}
          Box: {0.32, 0.13, 0.32}
          Rgb: {174, 119, 79}
        }

        {
          Position: {(side - 0.5) * 4.12, 2.51, -1.35 + z * 3.05}
          Box: {0.55, 0.14, 0.43}
          Rgb: timber
        }

        {
          Position: {(side - 0.5) * 3.78, 2.3, -1.35 + z * 3.05}
          Rotation: {0, 0, (side - 0.5) * -1.3}
          Box: {0.11, 0.55, 0.12}
          Rgb: timber
        }
      }

      {
        Position: {(side - 0.5) * 3.05, 1.55, 0.8}
        Box: {panel_width, 1.95, 0.065}
        Rgb: GardenPaper
        Emissive: {strength: 0.7, color: {255, 183, 105}}
        DiffuseTransmission: GardenShoji
      }

      for i in 0..(panes + 1) {
        {
          Position: {(side - 0.5) * 3.05 - panel_width / 2 + i * panel_width / panes, 1.55, 0.85}
          Box: {0.035, 2.02, 0.045}
          Rgb: timber
        }
      }

      for i in 0..6 {
        {
          Position: {(side - 0.5) * 3.05, 0.57 + i * 0.39, 0.85}
          Box: {panel_width + 0.05, 0.035, 0.045}
          Rgb: timber
        }
      }

      {
        Position: {(side - 0.5) * 3.05, 0.73, 0.89}
        Box: {panel_width + 0.04, 0.27, 0.05}
        Rgb: timber
      }

      {
        Position: {(side - 0.5) * 3.05 - (side - 0.5) * (panel_width - 0.16), 1.37, 0.89}
        RoundedBox: {0.065, 0.18, 0.025, 0.018}
        Rgb: {57, 54, 49}
        PbrMaterial: {roughness: 0.4, metallic: 0.45}
      }

      PaperLantern(tint: {255, 190 + variant % 3 * 12, 126 + variant % 2 * 20}) {
        Position: {(side - 0.5) * 3.35, 2.06, 1.53}
      }
    }
  }

  template TeaHousePlaque {
    prop variant: i32 = 0
    prop accent: Rgb = {151, 109, 139}

    Position: {0, 2.38, 1.825}
    RoundedBox: {0.68, 0.27, 0.065, 0.025}
    Rgb: {178, 128, 77}
    inset {
      Position: {0, 0, 0.038}
      Box: {0.57, 0.18, 0.018}
      Rgb: accent
    }

    if variant % 5 == 0 {
      cup {
        Position: {0, -0.025, 0.06}
        Box: {0.16, 0.07, 0.012}
        Rgb: GardenPaper
      }

      steam {
        Position: {0.025, 0.045, 0.06}
        Rotation: {0, 0, -0.25}
        Box: {0.012, 0.05, 0.012}
        Rgb: GardenPaper
      }
    }

    if variant % 5 == 1 {
      CeramicVase(glaze: GardenPaper) {
        Position: {0, -0.075, 0.07}
        Scale: {0.35, 0.35, 0.12}
      }
    }

    if variant % 5 == 2 {
      for page in 0..2 {
        {
          Position: {(page - 0.5) * 0.115, 0, 0.06}
          Rotation: {0, 0, (page - 0.5) * 0.15}
          Box: {0.1, 0.12, 0.012}
          Rgb: GardenPaper
        }
      }
    }

    if variant % 5 == 3 {
      SakuraFlower(tint: GardenPaper) {
        Position: {0, 0, 0.06}
        Rotation: {math.PI / 2, 0, 0}
        Scale: {0.85, 0.85, 0.85}
      }
    }

    if variant % 5 == 4 {
      circle {
        Position: {0, 0, 0.06}
        Rotation: {math.PI / 2, 0, 0}
        Torus: {radius: 0.065, tube: 0.012, segments: 20, rings: 6}
        Rgb: GardenPaper
      }
    }
  }

  template TeaHouseGableRoof {
    prop roof_color: Rgb = {65, 83, 101}
    prop wall: Rgb = {238, 222, 192}
    prop timber: Rgb = {109, 65, 53}

    for side in 0..2 {
      for i in 0..5 {
        {
          Position: {0, 3.45 - i * 0.185, 0.1 + (side - 0.5) * (0.45 + i * 0.82)}
          Rotation: {(side - 0.5) * 0.85, 0, 0}
          Box: {5.25 + i * 0.035, 0.12, 0.53}
          Rgb: roof_color
        }

        for tile in 0..24 {
          {
            Position: {
              -2.53 + tile * 0.22,
              3.53 - i * 0.185,
              0.1 + (side - 0.5) * (0.45 + i * 0.82)
            }
            Rotation: {math.PI / 2 + (side - 0.5) * 0.85, 0, 0}
            Cylinder: {radius: 0.055, length: 0.49, segments: 6}
            Rgb: {85, 105, 122}
          }
        }
      }

      {
        Position: {0, 2.76, 0.1 + (side - 0.5) * 4.18}
        Box: {5.48, 0.13, 0.23}
        Rgb: {99, 119, 131}
      }
    }

    for end in 0..2 {
      for side in 0..2 {
        {
          Position: {(end - 0.5) * 5.35, 3.14, 0.1 + (side - 0.5) * 2.02}
          Rotation: {(side - 0.5) * 0.85, 0, 0}
          Box: {0.11, 0.16, 2.28}
          Rgb: {155, 123, 95}
        }
      }

      {
        Position: {(end - 0.5) * 5.08, 2.9, 0.1}
        Rotation: {0, math.PI / 2, 0}
        Triangle: {2.8, 0.68}
        BackFaceMode: {BackFacePlain}
        Rgb: wall
      }

      {
        Position: {(end - 0.5) * 5.12, 2.92, 0.1}
        Box: {0.12, 0.6, 0.09}
        Rgb: timber
      }

      {
        Position: {(end - 0.5) * 5.12, 2.7, 0.1}
        Box: {0.12, 0.09, 2.8}
        Rgb: timber
      }

      {
        Position: {(end - 0.5) * 5.52, 3.58, 0.1}
        Rotation: {0, 0, math.PI / 2}
        Cylinder: {radius: 0.16, length: 0.12, segments: 16}
        Rgb: {120, 135, 141}
      }

      {
        Position: {(end - 0.5) * 5.65, 3.58, 0.1}
        Rotation: {0, 0, math.PI / 2}
        Torus: {radius: 0.09, tube: 0.025, segments: 16, rings: 6}
        Rgb: roof_color
      }
    }
  }

  template TeaHouseHipRoof {
    prop roof_color: Rgb = {65, 83, 101}

    for side in 0..2 {
      for i in 0..24 {
        {
          Position: {-2.6 + i * 0.225, 2.72, 0.1 + (side - 0.5) * 4.4}
          Rotation: {math.PI / 2, 0, 0}
          Cylinder: {radius: 0.055, length: 0.2, segments: 6}
          Rgb: {85, 105, 122}
        }
      }
    }

    for side in 0..2 {
      for row in 0..5 {
        const t = (row + 0.2) / 5.0
        const rx = 2.696 - t * 2.077
        const rz = 2.157 - t * 1.662
        {
          Position: {0, 2.65 + t * 0.95, 0.1 + (side - 0.5) * 2 * rz}
          Rotation: {(side - 0.5) * 1.038, 0, 0}
          Box: {rx * 2, 0.05, 0.1}
          Rgb: {69, 87, 106}
        }

        {
          Position: {(side - 0.5) * 2 * rx, 2.65 + t * 0.95, 0.1}
          Rotation: {0, 0, -(side - 0.5) * 0.858}
          Box: {0.1, 0.05, rz * 2}
          Rgb: {69, 87, 106}
        }
      }

      for rib in 0..17 {
        const u = (rib - 8) / 8.0
        const t = math.min(1, (2.696 - math.abs(u * 2.65)) / 2.077)
        TreeLimb(ax: u * 2.65, ay: 2.69, az: 0.1 + (side - 0.5) * 4.31,
          bx: u * 2.65, by: 2.69 + t * 0.9, bz: 0.1 + (side - 0.5) * 2 * (2.157 - t * 1.662),
          base: 0.035, tip: 0.028, tint: {85, 105, 122})
      }

      for rib in 0..11 {
        const u = (rib - 5) / 5.0
        const t = math.min(1, (2.157 - math.abs(u * 2.1)) / 1.662)
        TreeLimb(ax: (side - 0.5) * 5.39, ay: 2.69, az: 0.1 + u * 2.1,
          bx: (side - 0.5) * 2 * (2.696 - t * 2.077), by: 2.69 + t * 0.9, bz: 0.1 + u * 2.1,
          base: 0.035, tip: 0.028, tint: {85, 105, 122})
      }
    }

    for x in 0..2 {
      for z in 0..2 {
        TreeLimb(ax: (x - 0.5) * 5.39, ay: 2.73, az: 0.1 + (z - 0.5) * 4.31,
          bx: (x - 0.5) * 1.24, by: 3.62, bz: 0.1 + (z - 0.5) * 0.99,
          base: 0.075, tip: 0.06, tint: {99, 119, 131})
      }
    }
  }

  template TeaHouse {
    prop variant: i32 = 0
    prop scale: f32 = 1

    const walls: Rgb[] = [
      {238, 222, 192}, {213, 224, 201}, {221, 211, 225}, {241, 213, 189},
      {198, 217, 218}, {235, 222, 201}, {221, 201, 179}, {207, 220, 200}
    ]
    const roofs: Rgb[] = [
      {65, 83, 101}, {62, 80, 101}, {117, 91, 83}, {80, 101, 116},
      {68, 86, 107}, {108, 91, 115}, {73, 90, 109}, {59, 77, 99}
    ]
    const accents: Rgb[] = [
      {151, 109, 139}, {112, 163, 153}, {112, 139, 172}, {185, 128, 130},
      {137, 116, 153}, {173, 126, 89}, {165, 129, 99}, {124, 151, 117}
    ]
    const timbers: Rgb[] = [
      {109, 65, 53}, {117, 86, 61}, {88, 73, 72}, {135, 81, 65},
      {94, 81, 64}, {112, 69, 61}, {123, 89, 68}, {92, 80, 64}
    ]
    const wall: Rgb = walls[variant]
    const roof_color: Rgb = roofs[variant]
    const accent: Rgb = accents[variant]
    const timber: Rgb = timbers[variant]
    const panel_width = 0.8 + variant % 2 * 0.35
    const panes = 3 + variant % 3
    Scale: {scale, scale, scale}
    // The room and its veranda get a probe above the garden probes. Probe boxes ignore the scale of
    // the house, so they take it from the prop.
    reflection {
      Position: {0, 1.545, 0.33}
      ReflectionProbe: {
        extent: {2.98 * scale, 2.02 * scale, 2.62 * scale},
        blend: scale,
        priority: 2,
        projection: {1.98 * scale, 1.02 * scale, 1.62 * scale},
        offset: {0.75 * scale, 0.5 * scale, -0.1 * scale}
      }
    }

    foundation {
      Position: {0, 0.17, 0}
      RoundedBox: {4.6, 0.34, 3.3, 0.09}
      Rgb: GardenStone
    }

    TeaHouseFrame(variant: variant, accent: accent, timber: timber) {}

    veranda {
      Position: {0, 0.4, 0.2}
      Box: {4.55, 0.18, 3.5}
      Rgb: timber
    }

    step {
      Position: {0, 0.18, 2.12}
      RoundedBox: {2.2, 0.3, 0.65, 0.06}
      Rgb: GardenStone
    }

    threshold {
      Position: {0, 0.54, 0.8}
      Box: {4.18, 0.055, 0.21}
      Rgb: {173, 126, 83}
      PbrMaterial: {roughness: 0.25}
    }

    back_wall {
      Position: {0, 1.52, -1.36}
      Box: {4.1, 2.05, 0.14}
      Rgb: wall
    }

    rear_beam {
      Position: {0, 2.46, -1.43}
      Box: {4.4, 0.16, 0.19}
      Rgb: timber
    }

    TeaHouseSides(variant: variant, wall: wall, timber: timber) {}

    lintel {
      Position: {0, 2.64, 1.7}
      Box: {4.55, 0.2, 0.2}
      Rgb: timber
    }

    transom_rail {
      Position: {0, 2.42, 0.82}
      Box: {4.25, 0.065, 0.1}
      Rgb: timber
    }

    TeaHousePlaque shop_plaque(variant: variant, accent: accent)

    if variant % 3 != 1 {
      roof_core {
        Position: {0, 3.03, 0.1}
        Rotation: {0, math.PI / 2, 0}
        TrianglePrism: {4.05, 1.02, 5.05}
        Rgb: roof_color
      }

      TeaHouseGableRoof(roof_color: roof_color, wall: wall, timber: timber) {}

      ridge {
        Position: {0, 3.58, 0.1}
        Rotation: {0, 0, math.PI / 2}
        Cylinder: {radius: 0.12, length: 5.5, segments: 12}
        Rgb: {99, 119, 131}
      }
    }

    if variant % 3 == 1 {
      hip_roof {
        Position: {0, 3.1, 0.1}
        Scale: {1.25, 1, 1}
        tiles {
          Rotation: {0, math.PI / 4, 0}
          Frustum: {radius_bottom: 3.05, radius_top: 0.7, length: 0.95, segments: 4}
          Rgb: roof_color
        }
      }

      eaves {
        Position: {0, 2.63, 0.1}
        Box: {5.5, 0.13, 4.4}
        Rgb: roof_color
      }

      TeaHouseHipRoof(roof_color: roof_color) {}

      ridge_cap {
        Position: {0, 3.62, 0.1}
        RoundedBox: {1.35, 0.17, 1.05, 0.07}
        Rgb: roof_color
      }
    }

    rear_window {
      Position: {0, 1.65, -1.45}
      Rotation: {math.PI / 2, 0, 0}
      Cylinder: {radius: 0.45, length: 0.035, segments: 32}
      Rgb: GardenPaper
      Emissive: {strength: 1.2, color: {255, 195, 139}}
      DiffuseTransmission: GardenShoji
    }

    rear_frame {
      Position: {0, 1.65, -1.48}
      Rotation: {math.PI / 2, 0, 0}
      Torus: {radius: 0.45, tube: 0.045, segments: 32, rings: 6}
      Rgb: timber
    }

    PaperLantern() {
      Position: {-0.65, 2.02, -0.4}
    }

    HouseInterior interior(style: variant % 5, accent: accent, timber: timber) {
      Position: {0, 0.525, 0}
    }
  }
}

include spaceship/frigate
include spaceship/dock
include spaceship/dock_services
using flecs.script
using box.transform
using box.geometry
using box.spatial
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.controllers
using assets

$ {
  box.app.FpsTarget: {60}
  Scene: {baked: true, reflections: true, environment: true, alpha_cutout: true,
    transmission: true, triplanar: true, sheen: true, clear_coat: true, anisotropy: true}
  AmbientLight: {sky: {130, 165, 195}, ground: {45, 65, 88}, intensity: 0.65}
  Bake: {probe_spacing: 16, bounds_padding: 2, bounces: 1, capture_size: 16, budget_ms: 6}
  ReflectionBake: {resolution: 128, budget_ms: 2, scene_probe: true, scene_probe_height: 25}
}

window { Surface: {width: 1800, height: 1000, vsync: true} }

camera {
  Position: {-180, 165, 240}
  Rotation: {-0.55, -0.6435, 0}
  Camera: {fov: 42, near_: 0.5, far_: 1400}
  CameraController: {speed: 55}
}

sky {
  Rotation: {0.85, -2.5, 0}
  DirectionalLight: {intensity: 4.2}
  Rgb: {213, 231, 255}
}

assets {
  starfield {
    EnvironmentImage: {path: "etc/scenes/spaceship/assets/starfield.hdr"}
    Environment: {resolution: 1024}
  }
}

view {
  contact_shadows { Gtao: {radius: 1.3, final_value_power: 2.2} }
  engine_bloom { Bloom: {intensity: 0.15, threshold: 1.4} }
  film { Tonemap: {} }
  edge_smoothing { Smaa: {} }

  View: {
    camera: camera,
    clear: {enabled: true, color: {3, 6, 12, 255}},
    shadows: {enabled: true, max_distance: 600},
    lighting: {environment: {source: assets.starfield, intensity: 0.035, background: true}},
    effects: [
      {effect: contact_shadows},
      {effect: engine_bloom},
      {effect: film},
      {effect: edge_smoothing}
    ]
  }
}

spaceship {
  gantry_camera {
    Position: {-142, 78, 42}
    Rotation: {-0.31, -0.69, 0}
    Camera: {fov: 47, near_: 0.2, far_: 1400}
    CameraController: {speed: 25}
  }

  hull_camera {
    Position: {-66, 64, 108}
    Rotation: {-0.42, -0.55, 0}
    Camera: {fov: 45, near_: 0.2, far_: 1400}
    CameraController: {speed: 20}
  }

  aft_camera {
    Position: {147, 90, -228}
    Rotation: {-0.32, 2.568, 0}
    Camera: {fov: 49, near_: 0.5, far_: 1400}
    CameraController: {speed: 55}
  }

  bridge_camera {
    Position: {-40, 38, 10}
    Rotation: {-0.23, -0.85, 0}
    Camera: {fov: 48, near_: 0.1, far_: 1000}
    CameraController: {speed: 12}
  }

  clamp_camera {
    Position: {-66, 26, 75}
    Rotation: {-0.46, -0.45, 0}
    Camera: {fov: 48, near_: 0.1, far_: 1000}
    CameraController: {speed: 12}
  }

  rim {
    Rotation: {0.35, 0.65, 0}
    DirectionalLight: {intensity: 1.6}
    Rgb: {255, 180, 113}
  }

  fill {
    Rotation: {-0.5, 2.5, 0}
    DirectionalLight: {intensity: 0.65}
    Rgb: {86, 151, 215}
  }

  frigate {
    Frigate: {}
    port_a { AttachmentFrame: {position: {-18.4, -1, -40}} }
    port_b { AttachmentFrame: {position: {-13.3, -1, 27}} }
    starboard_a { AttachmentFrame: {position: {18.4, -1, -40}} }
    starboard_b { AttachmentFrame: {position: {13.3, -1, 27}} }
  }

  dock { OrbitalDock: {}; services { DockServices: {} } }
  port_a {
    DockClamp: {reach: 48}
    root { AttachmentFrame: {} }
    Rotation: {0, -1.5707963, 0}
    Align: {target: frigate, self: {frame: port_a.root}, other: {frame: frigate.port_a}}
  }

  port_b {
    DockClamp: {reach: 53.1}
    root { AttachmentFrame: {} }
    Rotation: {0, -1.5707963, 0}
    Align: {target: frigate, self: {frame: port_b.root}, other: {frame: frigate.port_b}}
  }

  starboard_a {
    DockClamp: {reach: 48}
    root { AttachmentFrame: {} }
    Rotation: {0, 1.5707963, 0}
    Align: {target: frigate, self: {frame: starboard_a.root}, other: {frame: frigate.starboard_a}}
  }

  starboard_b {
    DockClamp: {reach: 53.1}
    root { AttachmentFrame: {} }
    Rotation: {0, 1.5707963, 0}
    Align: {target: frigate, self: {frame: starboard_b.root}, other: {frame: frigate.starboard_b}}
  }
}

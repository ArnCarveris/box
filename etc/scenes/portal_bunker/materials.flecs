using box.material
using box.texture

// Materials of the bunker compound, from the scenario's material table; a patterned material samples
// the texture graphs of its pattern (textures.flecs) in world space, tinted by its Rgb.
prefab BunkerMat_tiles { Rgb: {133, 138, 143}; PbrMaterial: {metallic: 0, roughness: 0.72}; PbrTextures: {albedo: BunkerTex_tiles, normal: BunkerTex_tiles_normal}; texture.Mapping: {mode: MappingWorld, size: 4} }
prefab BunkerMat_plaster { Rgb: {158, 153, 140}; PbrMaterial: {metallic: 0, roughness: 0.96}; PbrTextures: {albedo: BunkerTex_noise}; texture.Mapping: {mode: MappingWorld, size: 5.3333} }

using box.view

$ {
  box.app.FpsTarget: {120}
  Scene: {
    reflections: true,
    environment: true,
    aerial_perspective: true,
    cookies: true,
    shader_features: {
      Extended: {
        blend_modes: true,
        water: true
      },
      Terrain: {
        texture_blend: true,
        texture_layers: true,
        triplanar: true
      }
    }
  }
}

// Infinite terrain: the ground of infinite_forest.flecs on its own, without trees, undergrowth, the
// water of the brooks, the landmarks or the trails. Walk with WASD, F switches to flying.
include ui/widgets
include trees/generator
include forest/library
include infinite_forest/state
include infinite_forest/materials
include infinite_forest/terrain
include infinite_forest/player
include infinite_forest/view

using box.view
using box.texture

$ {
  box.app.FpsTarget: {60}
  Scene: {
    reflections: true,
    environment: true,
    aerial_perspective: true,
    cookies: true,
    alpha_cutout: true,
    blend_modes: true,
    texture_blend: true,
    water: true,
    texture_layers: true,
    triplanar: true,
    diffuse_transmission: true,
    wind: true
  }
}

// No trails: they neither sink into the ground nor paint it with dirt
infinite_forest {
  land {
    trail_h { nodes.Multiply: {a: infinite_forest.land.track, b_value: {0, 0, 0, 0}} }
    trail_w { nodes.Multiply: {a: infinite_forest.land.track, b_value: {0, 0, 0, 0}} }
  }
}

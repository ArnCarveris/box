    }

    shoot : ForestTwig {
      Position: {0.09, r * 0.6, 0.18}
      Rotation: {PI / 2, 0.7, 0}
      Scale: {r * 0.6, 0.3, r * 0.6}
    }
  }

  // A cushion of moss on the floor
  prefab WildMoss {
    DrawRange: {far_: UNDER_SMALL_RANGE, fade: UNDER_SMALL_FADE}

    cushion : ForestMoss {
      Position: {0, -0.02, 0}
      Scale: {0.45, 0.14, 0.36}
    }
  }

  // A cell of the undergrowth, its corner at cell_x cell_z cells
  template WildUnderCell {
    prop cell_x: i32 = 0
    prop cell_z: i32 = 0
    prop level: i32 = 0
    prop size: f32 = 16

    // The stand over the middle of the cell (stands.flecs): the light on its floor, from the
    // deep shade of beech and conifers to the open birch groves, and its share of broadleaves,
    // which drop their litter. Above WILD_BROAD_HEIGHT the conifers of the highland stand
    const cx = (cell_x + 0.5) * size
    const cz = (cell_z + 0.5) * size
    const low = box.terrain.height(wildwood.land, cx, cz) < WILD_BROAD_HEIGHT
    const oakness = wild_oakness(cx, cz)
    const mixed = wild_mixed(cx, cz)
    const grove = wild_grove(cx, cz)
    const light = low ? 0.1 + 0.3 * oakness * (1 - mixed) + 0.55 * grove : 0.3 + 0.4 * grove
    const broad = low ? 1 - 0.75 * mixed * (1 - grove) : 0.1 + 0.5 * grove

    // Patches of the flowers, a few cells across
    const w_yellow = 0.2 + wild_noise(cx, cz, 60, 505)
    const w_white = 0.2 + wild_noise(cx, cz, 60, 606)
    const w_violet = 0.2 + wild_noise(cx, cz, 60, 707)

    if level == 0 {
      // Dense grass over the clearings and meadows, thinning toward their rims, and a little
      // sedge in it
      meadow {
        Scatter: {
          items: [{WildGrass, 1}, {WildSedge, 0.15}],
          density: UNDER_MEADOW, seed: 8101,
          ground: wildwood.land, mask_channel: 1, mask_min: 0.35, mask_max: 1, mask_edge: 0.3,
          slope_max: 32, height_min: GROUND_MIN, height_max: SNOW_LINE,
          scale_min: 0.42, scale_max: 0.8, avoid: [WildEdgeTrunks, WildBroadTrunks],
          avoid_radius: 0.6, spatial_ignore: true
        }
      }

      // Flowers of the season in the clearings, in patches
      flowers {
        Scatter: {
          items: [{WildFlower, w_yellow}, {WildFlowerWhite, w_white}, {WildFlowerViolet, w_violet}],
          density: 24, seed: 8102,
          ground: wildwood.land, mask_channel: 1, mask_min: 0.5, mask_max: 1, mask_edge: 0.2,
          slope_max: 30, height_min: GROUND_MIN, height_max: SNOW_LINE - 30,
          scale_min: 0.32, scale_max: 0.56, avoid: [WildEdgeTrunks], avoid_radius: 0.6,
          spatial_ignore: true
        }
      }

      // Grass in the sunny spots of the forest floor, with the light of the stand
      sunny {
        Scatter: {
          items: [{WildGrass, 1}, {WildSedge, 0.3}],
          density: 6 + UNDER_FLOOR_GRASS * light * light, seed: 8103,
          ground: wildwood.land, mask_channel: 0, mask_min: 0.3, mask_max: 1, mask_edge: 0.2,
          slope_max: 32, height_min: GROUND_MIN, height_max: WILD_TREE_LINE + 30,
          scale_min: 0.34, scale_max: 0.62,
          avoid: [WildBroadTrunks, WildSlopeTrunks, WildHighlandTrunks], avoid_radius: 0.6,
          spatial_ignore: true
        }
      }

      // Sedge in the shade under the stands
      sedge {
        Scatter: {
          items: [{WildSedge, 1}],
          density: 6 + 24 * (1 - light), seed: 8104,
          ground: wildwood.land, mask_channel: 0, mask_min: 0.45, mask_max: 1, mask_edge: 0.2,
          slope_max: 34, height_min: GROUND_MIN, height_max: WILD_TREE_LINE,
          scale_min: 0.4, scale_max: 0.7,
          avoid: [WildBroadTrunks, WildSlopeTrunks, WildHighlandTrunks], avoid_radius: 0.6,
          spatial_ignore: true
        }
      }

      // Wood anemones and celandine under the broadleaves
      anemones {
        Scatter: {
          items: [{WildFlowerWhite, 3}, {WildFlower, 1}],
          density: 1 + 10 * broad, seed: 8105,
          ground: wildwood.land, mask_channel: 0, mask_min: 0.5, mask_max: 1, mask_edge: 0.2,
          slope_max: 30, height_min: GROUND_MIN, height_max: WILD_BROAD_HEIGHT + 40,
          scale_min: 0.28, scale_max: 0.46, avoid: [WildBroadTrunks], avoid_radius: 0.5,
          spatial_ignore: true
        }
      }

      // Leaf litter under the broadleaves, lying on the ground
      litter {
        Scatter: {
          items: [{WildLitter, 1}],
          density: 3 + 40 * broad, seed: 8106,
          ground: wildwood.land, mask_channel: 0, mask_min: 0.4, mask_max: 1, mask_edge: 0.2,
          slope_max: 36, height_min: GROUND_MIN, height_max: WILD_TREE_LINE,
          align: 1, scale_min: 0.7, scale_max: 1.3, sink: -0.01, spatial_ignore: true
        }
      }

      // Mushrooms, twigs and moss in the stands: twigs under the broadleaves, moss under the
      // conifers, fly agarics among the birches and spruces
      small {
        Scatter: {
          items: [
            {WildMushrooms, 0.6}, {WildAgarics, 0.1 + 0.3 * grove + 0.2 * (1 - broad)},
            {WildTwig, 0.3 + 1.2 * broad}, {WildMoss, 0.3 + 1.4 * (1 - broad)}
          ],
          density: 2 + 4 * (1 - light), seed: 8107,
          ground: wildwood.land, mask_channel: 0, mask_min: 0.6, mask_max: 1, mask_edge: 0.15,
          slope_max: 32, height_min: GROUND_MIN, height_max: WILD_TREE_LINE,
          align: 0.6, scale_min: 0.8, scale_max: 1.3,
          avoid: [WildBroadTrunks, WildSlopeTrunks, WildHighlandTrunks], avoid_radius: 0.5,
          spatial_ignore: true
        }
      }
    }

    // Ferns in the shade under the stands
    ferns {
      Scatter: {
        items: [{WildFern, 1}],
        density: 3 + 16 * (1 - light), spacing: 0.8, mode: ScatterPoisson, seed: 8201,
        ground: wildwood.land, mask_channel: 0, mask_min: 0.45, mask_max: 1, mask_edge: 0.2,
        slope_max: 34, height_min: GROUND_MIN, height_max: WILD_TREE_LINE,
        scale_min: 0.55, scale_max: 1.1,
        avoid: [WildBroadTrunks, WildSlopeTrunks, WildHighlandTrunks], avoid_radius: 0.9,
        spatial_ignore: true
      }
    }

    // Hazel and elder along the rims of the clearings
    rims {
      Scatter: {
        items: [{WildShrubHazel, 1}, {WildShrubHazelLow, 1}, {WildShrubElder, 0.4 + 0.8 * grove}],
        density: 5, spacing: 2.4, mode: ScatterPoisson, seed: 8202,
        ground: wildwood.land, mask_channel: 1, mask_min: 0.1, mask_max: 0.42, mask_edge: 0.08,
        slope_max: 28, height_min: GROUND_MIN, height_max: WILD_BROAD_HEIGHT + 80,
        scale_min: 0.75, scale_max: 1.25, avoid: [WildEdgeTrunks, WildBroadTrunks],
        avoid_radius: 1.8, spatial_ignore: true
      }
    }

    // Shrubs along the edges of the trails
    verges {
      Scatter: {
        items: [{WildShrubHazel, 1}, {WildShrubHazelLow, 1.4}, {WildShrubElder, 0.6}],
        density: 6, spacing: 2.2, mode: ScatterPoisson, seed: 8203,
        ground: wildwood.land, mask_channel: 2, mask_min: 0.07, mask_max: 0.32, mask_edge: 0.04,
        slope_max: 26, height_min: GROUND_MIN, height_max: WILD_TREE_LINE,
        scale_min: 0.7, scale_max: 1.15,
        avoid: [WildBroadTrunks, WildSlopeTrunks, WildHighlandTrunks, WildEdgeTrunks],
        avoid_radius: 1.6, spatial_ignore: true
      }
    }

    // Fallen logs on the gentle floor of the stands, along the slope
    logs {
      Scatter: {
        items: [{WildLog, 1}, {WildLogLong, 0.6}, {WildLogThin, 1}],
        density: 0.4, spacing: 7, mode: ScatterPoisson, seed: 8204,
        ground: wildwood.land, mask_channel: 0, mask_min: 0.65, mask_max: 1, mask_edge: 0.1,
        slope_max: 14, height_min: GROUND_MIN, height_max: WILD_TREE_LINE,
        align: 1, scale_min: 0.85, scale_max: 1.15, sink: 0.04,
        avoid: [WildBroadTrunks, WildSlopeTrunks, WildHighlandTrunks], avoid_radius: 2.8,
        spatial_ignore: true
      }
    }

    // Stumps of the species of the stand
    stumps {
      Scatter: {
        items: [
          {WildStumpBeechCut, low ? (1 - oakness) * (1 - mixed) : 0},
          {WildStumpOakCut, low ? oakness * (1 - mixed) : 0},
          {WildStumpSpruceCut, low ? 0.2 + mixed : 1}
        ],
        density: 0.5, spacing: 4, mode: ScatterPoisson, seed: 8205,
        ground: wildwood.land, mask_channel: 0, mask_min: 0.6, mask_max: 1, mask_edge: 0.15,
        slope_max: 16, height_min: GROUND_MIN, height_max: WILD_TREE_LINE,
        align: 0.3, scale_min: 0.8, scale_max: 1.2, sink: 0.08,
        avoid: [WildBroadTrunks, WildSlopeTrunks, WildHighlandTrunks, logs], avoid_radius: 1.4,
        spatial_ignore: true
      }
    }

    // Rocks scattered through the stands
    rocks {
      Scatter: {
        items: [{WildRock, 1}, {WildRockFlat, 1}],
        density: 1, spacing: 2, mode: ScatterPoisson, seed: 8206,
        ground: wildwood.land, mask_channel: 0, mask_min: 0.35, mask_max: 1, mask_edge: 0.15,
        slope_max: 38, height_min: GROUND_MIN, height_max: GROUND_MAX,
        align: 0.6, scale_min: 0.25, scale_max: 0.7, sink: 0.03,
        avoid: [WildBroadTrunks, WildSlopeTrunks, WildHighlandTrunks], avoid_radius: 1.2,
        spatial_ignore: true
      }
    }

    // Scree stones below the rock walls and on the talus of the mountains
    scree {
      Scatter: {
        items: [{WildRock, 1}, {WildRockFlat, 1.4}],
        density: 40, spacing: 0.5, mode: ScatterPoisson, seed: 8207,
        ground: wildwood.land, mask_channel: 3, mask_min: 0.22, mask_max: 0.75, mask_edge: 0.1,
        slope_max: 34, height_min: GROUND_MIN, height_max: GROUND_MAX,
        align: 0.8, scale_min: 0.12, scale_max: 0.45, sink: 0.02, spatial_ignore: true
      }
    }
  }
}

wildwood {
  // The undergrowth around the focus
  undergrowth {
    ChunkGrid: {
      template: WildUnderCell,
      cell_size: {UNDER_CELL, 0, UNDER_CELL},
      levels: [UNDER_NEAR, UNDER_FAR],
      hysteresis: 6,
      budget: UNDER_BUDGET,
      budget_ms: UNDER_BUDGET_MS,
      ground: wildwood.land
    }
  }
}

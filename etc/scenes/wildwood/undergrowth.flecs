using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.render
using box.light
using box.world
using trees
using state
using assets

// The undergrowth of the wildwood: a ChunkGrid of small UNDER_CELL cells close around the focus
// whose template scatters the plants of the forest library (forest/undergrowth.flecs) over the
// terrain, so the floor is dense near the player and costs a bounded number of cells.
//
// Where a plant grows follows the masks of the terrain, the light of the stand and the trees:
// - the clearings and alpine meadows (mask channel 1): dense grass and the flowers of the
//   season, shrubs along their rims
// - the forest floor (channel 0): grass and sedge by the light of the stand, dense under the
//   birch groves and oaks, sparse under beech and conifers, where ferns, moss, mushrooms and
//   twigs take over; leaf litter everywhere under the broadleaves; logs, stumps and rocks
// - the trails (channel 2): bare, shrubs along their edges
// - the rock walls (channel 3): bare, scree stones below them
// The light and the share of broadleaves of a cell come from the stand noise of stands.flecs at
// its middle, so the floor follows the trees above it, and every scatter keeps clear of the
// trunks of the mature trees with Scatter avoid against their placement (the *Trunks prefabs of
// stands.flecs).
//
// The small plants grow within UNDER_NEAR (level 0), the ferns, shrubs, logs, stumps and rocks
// out to UNDER_FAR (level 1); a cell keeps them as it changes level. Each size class fades out
// with a DrawRange before its cells drop it, the grass first and the shrubs and logs last, so
// the edge of the undergrowth never shows as a ring.
//
// Plants have their origin on the ground, like the trees (trees.flecs) they stand on terrain at
// any height: their WindSway does not bend them from a ground at Y 0, their blades, fronds and
// leaves flutter more the further they are from the foot.
state {
  // Cells of UNDER_CELL meters: level 0 within UNDER_NEAR of the focus, everything, level 1
  // within UNDER_FAR, the larger plants. UNDER_BUDGET cells load per frame, within
  // UNDER_BUDGET_MS
  export const UNDER_CELL: f32 = 16
  export const UNDER_NEAR: f32 = 36
  export const UNDER_FAR: f32 = 64
  export const UNDER_BUDGET: i32 = 12
  export const UNDER_BUDGET_MS: f32 = 3

  // The size classes fade out between range - fade and range + fade, within the ring of their
  // level: mushrooms, moss and twigs, grass and flowers, litter, ferns, then shrubs, logs,
  // stumps and rocks
  export const UNDER_SMALL_RANGE: f32 = 15
  export const UNDER_SMALL_FADE: f32 = 4
  export const UNDER_GRASS_RANGE: f32 = 28
  export const UNDER_GRASS_FADE: f32 = 7
  export const UNDER_LITTER_RANGE: f32 = 29
  export const UNDER_LITTER_FADE: f32 = 6
  export const UNDER_FERN_RANGE: f32 = 44
  export const UNDER_FERN_FADE: f32 = 9
  export const UNDER_LARGE_RANGE: f32 = 54
  export const UNDER_LARGE_FADE: f32 = 9

  // Grass clumps per 100 m² of the clearings, and of the forest floor in full light
  export const UNDER_MEADOW: f32 = 300
  export const UNDER_FLOOR_GRASS: f32 = 110
}

assets {
  // The plants of the library with the DrawRange of their class and a WindSway that does not
  // bend them from Y 0, one entity an instance
  prefab WildGrass : ForestGrass {
    DrawRange: {far_: UNDER_GRASS_RANGE, fade: UNDER_GRASS_FADE}
    WindSway: {bend: 0, flutter: 0.07, flutter_frequency: 3, flutter_reach: 0.5}
    NoBake
  }

  prefab WildSedge : ForestSedge {
    DrawRange: {far_: UNDER_GRASS_RANGE, fade: UNDER_GRASS_FADE}
    WindSway: {bend: 0, flutter: 0.07, flutter_frequency: 3, flutter_reach: 0.5}
    NoBake
  }

  prefab WildFlower : ForestFlower {
    DrawRange: {far_: UNDER_GRASS_RANGE, fade: UNDER_GRASS_FADE}
    WindSway: {bend: 0, flutter: 0.05, flutter_frequency: 3.5, flutter_reach: 0.4}
    NoBake
  }

  prefab WildFlowerWhite : ForestFlowerWhite {
    DrawRange: {far_: UNDER_GRASS_RANGE, fade: UNDER_GRASS_FADE}

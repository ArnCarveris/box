    NoBake
  }

  // The parts of the larger plants, swaying without the bend
  prefab WildHazelCard : ForestShrubHazel {
    WindSway: {bend: 0, flutter: 0.05, flutter_frequency: 3.5, flutter_reach: 0.3}
    NoBake
  }

  prefab WildElderCard : ForestShrubElder {
    WindSway: {bend: 0, flutter: 0.05, flutter_frequency: 3.5, flutter_reach: 0.3}
    NoBake
  }

  prefab WildStumpBeech : ForestBarkBeech {
    WindSway: {bend: 0}
    NoBake
  }

  prefab WildStumpOak : ForestBarkOak {
    WindSway: {bend: 0}
    NoBake
  }

  prefab WildStumpSpruce : ForestBarkSpruce {
    WindSway: {bend: 0}
    NoBake
  }

  // Shrubs like ForestShrub, size meters across: 15 leaf cards pointing out and up, written out
  // as prefabs since a template does not grow in a prefab. They leave out its dark core, which
  // shows as a black mound under a shrub on the open floor
  prefab WildShrubHazel {
    DrawRange: {far_: UNDER_LARGE_RANGE, fade: UNDER_LARGE_FADE}
    const seed = 0.31
    const size = 1.5


    for c in 0..15 {
      const a = c * 2.39996 + seed * 6.2832
      const e = 0.15 + 1.25 * forest_hash(c + 1, seed * 31)
      const ox = cos(e) * sin(a)
      const oy = sin(e)
      const oz = cos(e) * cos(a)
      const jx = ox + (forest_hash(c + 2, seed * 31) - 0.5) * 0.6
      const jy = oy + 0.35
      const jz = oz + (forest_hash(c + 3, seed * 31) - 0.5) * 0.6
      const jl = sqrt(jx * jx + jy * jy + jz * jz)
      const b = (forest_hash(c + 4, seed * 31) - 0.5) * 1.8
      const card = size * (0.62 + 0.3 * forest_hash(c + 5, seed * 31))
      "card_{c}" : WildHazelCard {
        Position: {ox * size * 0.28, 0.08 + oy * size * 0.45, oz * size * 0.28}
        Rotation: {forest_card_pitch(jy / jl, b), forest_card_yaw(jx / jl, jy / jl, jz / jl, b), forest_card_roll(jy / jl, b)}
        Scale: {card, card, card}
      }
    }
  }

  prefab WildShrubHazelLow {
    DrawRange: {far_: UNDER_LARGE_RANGE, fade: UNDER_LARGE_FADE}
    const seed = 0.67
    const size = 1.2


    for c in 0..15 {
      const a = c * 2.39996 + seed * 6.2832
      const e = 0.1 + 1.0 * forest_hash(c + 1, seed * 31)
      const ox = cos(e) * sin(a)
      const oy = sin(e)
      const oz = cos(e) * cos(a)
      const jx = ox + (forest_hash(c + 2, seed * 31) - 0.5) * 0.6
      const jy = oy + 0.35
      const jz = oz + (forest_hash(c + 3, seed * 31) - 0.5) * 0.6
      const jl = sqrt(jx * jx + jy * jy + jz * jz)
      const b = (forest_hash(c + 4, seed * 31) - 0.5) * 1.8
      const card = size * (0.62 + 0.3 * forest_hash(c + 5, seed * 31))
      "card_{c}" : WildHazelCard {
        Position: {ox * size * 0.34, 0.06 + oy * size * 0.36, oz * size * 0.34}
        Rotation: {forest_card_pitch(jy / jl, b), forest_card_yaw(jx / jl, jy / jl, jz / jl, b), forest_card_roll(jy / jl, b)}
        Scale: {card, card, card}
      }
    }
  }

  prefab WildShrubElder {
    DrawRange: {far_: UNDER_LARGE_RANGE, fade: UNDER_LARGE_FADE}
    const seed = 0.83
    const size = 1.7


    for c in 0..15 {
      const a = c * 2.39996 + seed * 6.2832
      const e = 0.15 + 1.25 * forest_hash(c + 1, seed * 31)
      const ox = cos(e) * sin(a)
      const oy = sin(e)
      const oz = cos(e) * cos(a)
      const jx = ox + (forest_hash(c + 2, seed * 31) - 0.5) * 0.6
      const jy = oy + 0.35
      const jz = oz + (forest_hash(c + 3, seed * 31) - 0.5) * 0.6
      const jl = sqrt(jx * jx + jy * jy + jz * jz)
      const b = (forest_hash(c + 4, seed * 31) - 0.5) * 1.8
      const card = size * (0.62 + 0.3 * forest_hash(c + 5, seed * 31))
      "card_{c}" : WildElderCard {
        Position: {ox * size * 0.28, 0.08 + oy * size * 0.45, oz * size * 0.28}
        Rotation: {forest_card_pitch(jy / jl, b), forest_card_yaw(jx / jl, jy / jl, jz / jl, b), forest_card_roll(jy / jl, b)}
        Scale: {card, card, card}
      }

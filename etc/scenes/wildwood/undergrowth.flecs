  // Mushrooms like ForestMushroom in clusters: brown caps and a pair of fly agarics
  prefab WildMushrooms {
    DrawRange: {far_: UNDER_SMALL_RANGE, fade: UNDER_SMALL_FADE}

    for m in 0..3 {
      const size = 0.06 + 0.05 * forest_hash(m + 1, 71)
      const a = m * 2.1 + forest_hash(m + 2, 71)
      const d = 0.04 + 0.08 * forest_hash(m + 3, 71)
      const tilt = (forest_hash(m + 4, 71) - 0.5) * 0.4
      const cap_r = size * 0.6
      const stem_r = size * 0.12
      "stem_{m}" : ForestMushroomStem {
        Position: {sin(a) * d, size * 0.45, cos(a) * d}
        Scale: {stem_r, size * 0.95, stem_r}
      }

      "gills_{m}" : ForestMushroomGills {
        Position: {sin(a) * d, size * 0.9, cos(a) * d}
        Rotation: {tilt, a, 0}
        Scale: {cap_r * 0.95, size * 0.02, cap_r * 0.95}
      }

      "cap_{m}" : ForestMushroomCap {
        Position: {sin(a) * d, size * 0.9, cos(a) * d}
        Rotation: {tilt, a, 0}
        Scale: {cap_r, cap_r * 0.6, cap_r}
      }
    }
  }

  prefab WildAgarics {
    DrawRange: {far_: UNDER_SMALL_RANGE, fade: UNDER_SMALL_FADE}

    for m in 0..2 {
      const size = 0.1 + 0.05 * m
      const a = m * 2.6 + 0.4
      const d = 0.07 + 0.05 * m
      const tilt = 0.12 - 0.2 * m
      const cap_r = size * 0.7
      const stem_r = size * 0.12
      "stem_{m}" : ForestMushroomStem {
        Position: {sin(a) * d, size * 0.45, cos(a) * d}
        Scale: {stem_r, size * 0.95, stem_r}
      }

      "gills_{m}" : ForestMushroomGills {
        Position: {sin(a) * d, size * 0.9, cos(a) * d}
        Rotation: {tilt, a, 0}
        Scale: {cap_r * 0.95, size * 0.02, cap_r * 0.95}
      }

      "cap_{m}" : ForestAgaricCap {
        Position: {sin(a) * d, size * 0.9, cos(a) * d}
        Rotation: {tilt, a, 0}
        Scale: {cap_r, cap_r * 0.55, cap_r}

  }

  // Fallen logs of dead wood like ForestLog, length meters along local Z, their origin under the
  // middle so they lie along the slope, sunk a little into the floor, with their cut ends and
  // shelf fungus along a side
  prefab WildLog {
    DrawRange: {far_: UNDER_LARGE_RANGE, fade: UNDER_LARGE_FADE}
    const length = 3.6
    const radius = 0.26
    const y = radius * 0.78

    wood : ForestBarkDead {
      Position: {0, y, 0}
      Rotation: {PI / 2, 0, 0}
      Scale: {radius, length, radius}
      Frustum: {segments: 12, smooth: true, length: 1, radius_bottom: 1, radius_top: 0.86}
    }

    cut_a : ForestWoodCut {
      Position: {0, y, length / 2 - 0.01}
      Rotation: {PI / 2, 0, 0}
      Scale: {radius * 0.84, 0.03, radius * 0.84}
    }

    cut_b : ForestWoodCut {
      Position: {0, y, 0.01 - length / 2}
      Rotation: {PI / 2, 0, 0}
      Scale: {radius * 0.84, 0.03, radius * 0.84}
    }

    for j in 0..4 {
      const t = 0.2 + 0.6 * forest_hash(j + 11, 17)
      const fs = 0.07 + 0.07 * forest_hash(j + 12, 17)
      "fungus_{j}" : ForestFungus {
        Position: {radius * 0.88, y + radius * 0.25 * forest_hash(j + 13, 17), length * (t - 0.5)}
        Rotation: {0.05, PI / 2, 0}
        Scale: {fs * 1.4, fs * 0.32, fs}
        Sphere: {radius: 1, segments: 12, smooth: true}
      }
    }
  }


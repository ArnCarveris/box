    top : ForestWoodCut {
      Position: {0, height + 0.005, 0}
      Rotation: {0.06, 0, -0.04}
      Scale: {radius * 0.93, 0.03, radius * 0.93}
    }

    for j in 0..4 {
      const a = j * 1.5708 + forest_hash(j + 1, 43) * 0.8
      const rl = radius * (1.3 + 0.8 * forest_hash(j + 2, 43))

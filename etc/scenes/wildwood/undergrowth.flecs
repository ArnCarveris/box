  // A twig like ForestFallenTwig lying across its origin, with a side shoot
  prefab WildTwig {
    DrawRange: {far_: UNDER_SMALL_RANGE, fade: UNDER_SMALL_FADE}
    const length = 0.8
    const r = 0.008 + 0.012 * length

    stick : ForestTwig {
      Position: {0, r * 0.7, 0}
      Rotation: {PI / 2, 0, 0}

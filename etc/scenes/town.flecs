// Sakura machi, the town of box_old: fly with WASD (QE for down/up), hold the right mouse button
// to look around. The content lives in town_content.flecs, which the town perf and visual scenes
// share.

include town_content

using box.transform
using box.camera
using box.view
using box.effects
using box.surface
using box.controllers

window {
  Surface: {width: 1280, height: 720, vsync: true}
}

ssao {
  Ssao: {radius: 2.5, bias: 0.025, intensity: 1}
}

tonemap {
  Tonemap: {}
}

// The viewpoint of the town scene of ../flecs-engine, which looked from {-12.8, 9.455, 25.806} at
// {-12.366, 9.044, 25}. box_old's own camera sat 225 units away, where the town is a speck.
camera {
  Position: {-12.8, 9.455, 25.806}
  Rotation: {-0.4219, -0.4942, 0}
  Camera: {fov: 55, near_: 0.1}
  CameraController: {speed: 14, boost: 4, sensitivity: 0.003}
}

view {
  View: {camera: camera, clear: {enabled: true, color: {150, 178, 210, 255}}, lighting: {enabled: true}, shadows: {enabled: true, cascades: 4, resolution: 2048, max_distance: 200, split_lambda: 0.7, depth_bias: 2, normal_offset: 1.5, filter_size: 3, fade: 0.2}, culling: {enabled: true, occlusion: true, min_dimension_px: 4}, effects: [{enabled: true, effect: ssao}, {enabled: true, effect: tonemap}]}
}

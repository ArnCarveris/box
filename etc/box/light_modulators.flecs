module box.light

using box.shader

struct CloudShadows(scale: f32, speed: f32, density: f32, softness: f32)
struct Caustics(scale: f32, speed: f32, intensity: f32, depth: f32)

modulator_shaders {
  cloud_shadows { Shader: {path: "etc/shaders/light/clouds.wgsl"} }
  caustics { Shader: {path: "etc/shaders/light/caustics.wgsl"} }
}

modulators {
  prefab cloud_shadows {
    LightModulator: {shader: modulator_shaders.cloud_shadows,
      params: CloudShadows, enabled: true}
    CloudShadows: {scale: 40, speed: 4, density: 0, softness: 0.35}
  }
  prefab caustics {
    LightModulator: {shader: modulator_shaders.caustics,
      params: Caustics, enabled: true}
    Caustics: {scale: 2, speed: 1, intensity: 1, depth: 0}
  }
}

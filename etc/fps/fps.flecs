// The fps, load and GPU stats panels of box, the script module box.fps. box.fps loads it when a
// panel first opens and loads it again when the file changes on disk.
//
// C creates the scene of the panels (fps.ui), its camera and view, and the panels in a column at
// the top right of the surface: the fps panel (fps.ui.screen.panel), an instance of FpsWidget,
// above the load panel (fps.ui.screen.load), an instance of LoadWidget, above the GPU stats panel
// (fps.ui.screen.gpu), an instance of GpuWidget. Everything the panels show is defined here, in
// the colors of the theme.
//
// The panel is a heading over a chart of the last 120 frame times and a summary of the last
// second. The summary reads Summary, which box.fps writes from FrameSamples. box.fps exports
// the colors of the bars (green, yellow, red) and the longest frame time of a green and a yellow
// bar (fast_ms, slow_ms) from include/box/fps.h.
//
// The load panel has a row per thread of box: a head with the mean and worst time the thread
// worked per frame over the last second and its share of the frame time, which reads
// LoadSummary, over a chart of the last 120 frames of its series of LoadSamples.
//
// A chart is an FpsChart: the bars are children of its bars, an FpsBars, and the reference lines
// children of the chart over them. Neither the chart nor bars has a Layout, so a new sample lays
// nothing out.
//
// Every bar is an FpsBar of its own with a fixed name, which reads only its own muts: ms, the
// frame time of the sample it shows, and col, the column it stands in. bars reads only its mut
// first, the column at the left edge of the chart, and moves all bars left by that many slots.
// box.fps writes them whenever FrameSamples is set or notified, and only what changed. A new
// sample rotates the bars: box.fps writes it only to the bar of the oldest sample, with the
// column right of the newest bar, and moves bars one slot left, so a new sample evaluates one
// bar and bars, whatever the samples are, and none when it is as long as the one before it.
// Every 120 samples, and when the samples changed otherwise, box.fps writes the columns 0 to 119
// and first 0 again, so the columns stay small and every position a whole point.
//
// A script cannot do that: a bar that read FrameSamples itself would be evaluated again for
// every sample. ms, col and first are data only: the height, color and place of a bar stay
// here. Heights are whole points, so jitter below a point sets no height.

module box.fps

using flecs.script.math
using box.app
using box.ui
using box.layout
using box.geometry
using box.material
using box.text
using box.transform

// Bars of the chart, their width and the width of their slots, BOX_FPS_BARS,
// BOX_FPS_BAR_WIDTH and BOX_FPS_BAR_SLOT
const bar_count: i32 = 120
const bar_w: f32 = 3
const slot: f32 = 4
const chart_w: f32 = bar_count * slot

// Height of the chart and the frame time at its top, BOX_FPS_CHART_HEIGHT and BOX_FPS_CHART_MS
const chart_h: f32 = 60
const top_ms: f64 = 50

// Bar index of the chart. ms is the frame time in milliseconds of the sample it shows, 0
// without a sample, and col the column it stands in, which box.fps writes. In its parent, an
// FpsBars, it stands col slots right of the left edge of the chart; FpsBars moves it left by its
// first column. Its bottom is the bottom of the chart and its edges are on whole points: 1 point
// of gap, then bar_w of bar. Its height is linear in the frame time, at least bar_w and at most
// the chart, 0 without a sample.
template FpsBar {
  prop index: i32 = 0
  mut ms: f64 = 0
  mut col: i32 = index

  const h: f32 = match ms > 0 {
    true: max(bar_w, round(min(ms / top_ms, 1) * chart_h))
    _: 0
  }
  const level: i32 = match ms > slow_ms {
    true: 2
    _: match ms > fast_ms { true: 1; _: 0 }
  }

  Position: {-chart_w / 2 + col * slot + slot - bar_w / 2, -chart_h / 2 + h / 2, 0}
  Rect: {bar_w, h}
  Rgb: match level { 0: green; 1: yellow; _: red }
}

// The parent of the bars: first is the column at the left edge of the chart, which box.fps
// writes, so the bars of the columns first to first + bar_count - 1 fill the chart from left to
// right. A whole number of slots, so the bars stay on whole points.
template FpsBars {
  mut first: i32 = 0

  Position: {-first * slot, 0, 0}
}

// A chart of a series of samples: the bars bar_0 to bar_119 in bars, then the reference lines
// at 60 and 30 fps over them, centered in a row of points
template FpsChart {
  const t = box.ui.theme[Theme]

  Item: {width: {mode: Fixed, value: chart_w}, height: {mode: Fixed, value: chart_h}}

  bars {
    FpsBars: {}

    for i in 0..bar_count {
      "bar_{i}" {
        FpsBar: {index: i}
      }
    }
  }

  line_60 {
    Position: {0, floor(-chart_h / 2 + 1000.0 / 60 / top_ms * chart_h) + 0.5, 0}
    Line: {-chart_w / 2, 0, chart_w / 2, 0, 1}
    Rgb: t.text_muted
    Opacity: {0.5}
  }

  line_30 {
    Position: {0, floor(-chart_h / 2 + 1000.0 / 30 / top_ms * chart_h) + 0.5, 0}
    Line: {-chart_w / 2, 0, chart_w / 2, 0, 1}
    Rgb: t.text_muted
    Opacity: {0.5}
  }
}

// The fps panel: the heading, the chart and the summary
template FpsWidget {
  prop title: string = "Frame rate"

  const t = box.ui.theme[Theme]

  // Rows of the heading and the summary, whole points so the chart stays on the pixel grid
  const heading_h: f32 = ceil(t.font_size * 1.4)
  const summary_h: f32 = ceil(t.small_font_size * 1.4)

  Layout: {
    direction: Column,
    padding: {t.padding, t.padding, t.padding, t.padding},
    spacing: t.spacing / 2
  }
  Rect: {1, 1}
  Rgb: t.surface
  Border: {width: 1, radius: t.radius, color: {t.border.r, t.border.g, t.border.b, 255}}

  heading {
    Item: {width: {mode: Fixed, value: chart_w}, height: {mode: Fixed, value: heading_h}}
    Text: {value: title, size: t.font_size, line_height: heading_h}
    Rgb: t.text
  }

  chart {
    FpsChart: {}
  }

  // The mean and worst frame time on the left, the fps on the right in the color of the mean
  summary {
    const sum = Summary[Summary]
    const level: i32 = match sum.mean_ms > slow_ms {
      true: 2
      _: match sum.mean_ms > fast_ms { true: 1; _: 0 }
    }

    Layout: {direction: Row}
    Item: {width: {mode: Fixed, value: chart_w}, height: {mode: Fixed, value: summary_h}}

    times {
      Item: {width: {mode: Grow}}
      Text: {
        value: "mean {sum.mean_ms:.1} ms, worst {sum.worst_ms:.1} ms",
        size: t.small_font_size,
        line_height: summary_h
      }
      Rgb: t.text_muted
    }

    rate {
      Text: {
        value: "{sum.fps:.0} fps",
        size: t.small_font_size,
        line_height: summary_h,
        align: Right
      }
      Rgb: match level { 0: green; 1: yellow; _: red }
    }
  }
}

// The head of a row of the load panel: the name of the thread on the left, then the mean and
// worst time it worked per frame and, in the color of the mean, its share of the frame time
template LoadHead {
  prop label: string = ""
  prop mean_ms: f64 = 0
  prop worst_ms: f64 = 0
  prop share: f64 = 0

  const t = box.ui.theme[Theme]
  const row_h: f32 = ceil(t.small_font_size * 1.4)
  const level: i32 = match mean_ms > slow_ms {
    true: 2
    _: match mean_ms > fast_ms { true: 1; _: 0 }
  }

  Layout: {direction: Row, spacing: t.spacing}
  Item: {width: {mode: Fixed, value: chart_w}, height: {mode: Fixed, value: row_h}}

  name {
    Item: {width: {mode: Grow}}
    Text: {value: label, size: t.small_font_size, line_height: row_h}
    Rgb: t.text
  }

  times {
    Text: {
      value: "mean {mean_ms:.1} ms, worst {worst_ms:.1} ms",
      size: t.small_font_size,
      line_height: row_h,
      align: Right
    }
    Rgb: t.text_muted
  }

  percent {
    Text: {
      value: "{share:.0}%",
      size: t.small_font_size,
      line_height: row_h,
      align: Right
    }
    Rgb: match level { 0: green; 1: yellow; _: red }
  }
}

// The load panel: the heading and a row per thread, the head over the chart. A head reads
// LoadSummary in a scope of its own, so a new summary evaluates the heads and not the charts.
template LoadWidget {
  prop title: string = "Thread load"

  const t = box.ui.theme[Theme]
  const heading_h: f32 = ceil(t.font_size * 1.4)

  Layout: {
    direction: Column,
    padding: {t.padding, t.padding, t.padding, t.padding},
    spacing: t.spacing
  }
  Rect: {1, 1}
  Rgb: t.surface
  Border: {width: 1, radius: t.radius, color: {t.border.r, t.border.g, t.border.b, 255}}

  heading {
    Item: {width: {mode: Fixed, value: chart_w}, height: {mode: Fixed, value: heading_h}}
    Text: {value: title, size: t.font_size, line_height: heading_h}
    Rgb: t.text
  }

  main {
    Layout: {direction: Column, spacing: t.spacing / 2}

    head {
      const s = LoadSummary[LoadSummary].main
      LoadHead: {label: "Main thread", mean_ms: s.mean_ms, worst_ms: s.worst_ms, share: s.share}
    }

    chart {
      FpsChart: {}
    }
  }

  render {
    Layout: {direction: Column, spacing: t.spacing / 2}

    head {
      const s = LoadSummary[LoadSummary].render
      LoadHead: {label: "Render CPU", mean_ms: s.mean_ms, worst_ms: s.worst_ms, share: s.share}
    }

    chart {
      FpsChart: {}
    }
  }

  gpu {
    Layout: {direction: Column, spacing: t.spacing / 2}

    head {
      const s = LoadSummary[LoadSummary].gpu
      LoadHead: {
        label: "Render GPU wait",
        mean_ms: s.mean_ms,
        worst_ms: s.worst_ms,
        share: s.share
      }
    }

    chart {
      FpsChart: {}
    }
  }

  audio {
    Layout: {direction: Column, spacing: t.spacing / 2}

    head {
      const s = LoadSummary[LoadSummary].audio
      LoadHead: {label: "Audio", mean_ms: s.mean_ms, worst_ms: s.worst_ms, share: s.share}
    }

    chart {
      FpsChart: {}
    }
  }

  jobs {
    Layout: {direction: Column, spacing: t.spacing / 2}

    head {
      const sum = LoadSummary[LoadSummary]
      LoadHead: {
        label: "Jobs, busiest of {sum.workers}",
        mean_ms: sum.jobs.mean_ms,
        worst_ms: sum.jobs.worst_ms,
        share: sum.jobs.share
      }
    }

    chart {
      FpsChart: {}
    }
  }
}

// Width of a column of the GPU stats panel and of the gap between two columns
const gpu_col_w: f32 = 220
const gpu_gap: f32 = 16

// A row of the GPU stats panel: a label on the left, its value on the right
template GpuRow {
  prop label: string = ""
  prop value: string = ""

  const t = box.ui.theme[Theme]
  const row_h: f32 = ceil(t.small_font_size * 1.25)

  Layout: {direction: Row, spacing: t.spacing}
  Item: {width: {mode: Fixed, value: gpu_col_w}, height: {mode: Fixed, value: row_h}}

  name {
    Item: {width: {mode: Grow}}
    Text: {value: label, size: t.small_font_size, line_height: row_h}
    Rgb: t.text_muted
  }

  amount {
    Text: {value: value, size: t.small_font_size, line_height: row_h, align: Right}
    Rgb: t.text
  }
}

// The title of a section of the GPU stats panel, above its rows
template GpuTitle {
  prop label: string = ""

  const t = box.ui.theme[Theme]
  const row_h: f32 = ceil(t.small_font_size * 1.5)

  Item: {width: {mode: Fixed, value: gpu_col_w}, height: {mode: Fixed, value: row_h}}
  Text: {value: label, size: t.small_font_size, line_height: row_h}
  Rgb: t.text
}

// The GPU stats panel: the heading over three columns of sections. Every section reads GpuStats
// in a scope of its own; box.fps writes it every GpuPanel.interval with the counts per frame
// averaged over that interval. box.fps.count and box.fps.bytes format the numbers compactly.
template GpuWidget {
  prop title: string = "GPU stats"

  const t = box.ui.theme[Theme]
  const heading_h: f32 = ceil(t.font_size * 1.4)
  const width: f32 = gpu_col_w * 3 + gpu_gap * 2

  Layout: {
    direction: Column,
    padding: {t.padding, t.padding, t.padding, t.padding},
    spacing: t.spacing / 2
  }
  Rect: {1, 1}
  Rgb: t.surface
  Border: {width: 1, radius: t.radius, color: {t.border.r, t.border.g, t.border.b, 255}}

  // The title on the left, what the averages cover on the right
  heading {
    const g = GpuStats[GpuStats]

    Layout: {direction: Row}
    Item: {width: {mode: Fixed, value: width}, height: {mode: Fixed, value: heading_h}}

    name {
      Item: {width: {mode: Grow}}
      Text: {value: title, size: t.font_size, line_height: heading_h}
      Rgb: t.text
    }

    window {
      Text: {
        value: match g.gpu {
          true: "per frame, {g.packets} frames rendered"
          _: "no GPU backend"
        },
        size: t.small_font_size,
        line_height: heading_h,
        align: Right
      }
      Rgb: t.text_muted
    }
  }

  columns {
    Layout: {direction: Row, spacing: gpu_gap}

    left {
      Layout: {direction: Column}

      scene {
        const s = GpuStats[GpuStats].scene

        Layout: {direction: Column}

        title {
          GpuTitle: {label: "Scene"}
        }
        instances {
          GpuRow: {
            label: "Instances",
            value: "{box.fps.count(s.instances)}, {box.fps.count(s.dynamic)} dynamic"
          }
        }
        batches {
          GpuRow: {label: "Batches", value: box.fps.count(s.batches)}
        }
        visible {
          GpuRow: {
            label: "Visible",
            value: "{box.fps.count(s.visible)} of {box.fps.count(s.tested)}"
          }
        }
        culled {
          GpuRow: {
            label: "Culled",
            value: "{box.fps.count(s.frustum_culled)} frustum, " +
              "{box.fps.count(s.occlusion_culled)} occl."
          }
        }
        triangles {
          GpuRow: {label: "Triangles", value: box.fps.count(s.triangles)}
        }
        shadow_triangles {
          GpuRow: {label: "Shadow triangles", value: box.fps.count(s.shadow_triangles)}
        }
        other_triangles {
          GpuRow: {label: "Other triangles", value: box.fps.count(s.other_triangles)}
        }
      }

      shadows {
        const s = GpuStats[GpuStats].shadows

        Layout: {direction: Column}

        title {
          GpuTitle: {label: "Shadows"}
        }
        draws {
          GpuRow: {label: "Draw calls", value: box.fps.count(s.draws)}
        }
        tiles {
          GpuRow: {
            label: "Atlas tiles",
            value: "{box.fps.count(s.tiles)}, {box.fps.count(s.tiles_kept)} kept"
          }
        }
        cascades {
          GpuRow: {
            label: "Cascades",
            value: "{box.fps.count(s.cascades)}, {box.fps.count(s.cascades_kept)} kept"
          }
        }
      }

      time {
        const s = GpuStats[GpuStats].time

        Layout: {direction: Column}

        title {
          GpuTitle: {label: "GPU time"}
        }
        cull {
          GpuRow: {
            label: "Culling",
            value: match s.measured { true: "{s.cull_ms:.2} ms"; _: "-" }
          }
        }
        texture_graphs {
          GpuRow: {
            label: "Texture graphs",
            value: match s.measured { true: "{s.texture_graph_ms:.2} ms"; _: "-" }
          }
        }
        atmosphere {
          GpuRow: {
            label: "Atmosphere",
            value: match s.measured { true: "{s.atmosphere_ms:.2} ms"; _: "-" }
          }
        }
        grass {
          GpuRow: {
            label: "Grass",
            value: match s.measured { true: "{s.grass_ms:.2} ms"; _: "-" }
          }
        }
      }
    }

    middle {
      Layout: {direction: Column}

      commands {
        const s = GpuStats[GpuStats].commands

        Layout: {direction: Column}

        title {
          GpuTitle: {label: "Commands"}
        }
        total {
          GpuRow: {label: "Total", value: box.fps.count(s.total)}
        }
        passes {
          GpuRow: {
            label: "Passes",
            value: "{box.fps.count(s.render_passes)} render, " +
              "{box.fps.count(s.compute_passes)} compute"
          }
        }
        draws {
          GpuRow: {label: "Draw calls", value: box.fps.count(s.draws)}
        }
        dispatches {
          GpuRow: {
            label: "Dispatches",
            value: "{box.fps.count(s.dispatches)}, {box.fps.count(s.workgroups)} groups"
          }
        }
        pipelines {
          GpuRow: {label: "Pipeline switches", value: box.fps.count(s.pipelines)}
        }
        bind_groups {
          GpuRow: {label: "Bind groups", value: box.fps.count(s.bind_groups)}
        }
        buffer_binds {
          GpuRow: {label: "Buffer binds", value: box.fps.count(s.buffer_binds)}
        }
        copies {
          GpuRow: {
            label: "Copies",
            value: "{box.fps.count(s.copies)}, {box.fps.bytes(s.copy_bytes)}"
          }
        }
        writes {
          GpuRow: {
            label: "Queue writes",
            value: "{box.fps.count(s.writes)}, {box.fps.bytes(s.write_bytes)}"
          }
        }
        submits {
          GpuRow: {
            label: "Submits",
            value: "{box.fps.count(s.submits)}, {box.fps.count(s.command_buffers)} buffers"
          }
        }
      }

      pipelines {
        const s = GpuStats[GpuStats].commands

        Layout: {direction: Column}

        title {
          GpuTitle: {label: "Pipelines"}
        }
        cached {
          GpuRow: {
            label: "Cached",
            value: "{box.fps.count(s.pipelines_cached)}, " +
              "{box.fps.count(s.pipelines_building)} building"
          }
        }
        created {
          GpuRow: {label: "Created", value: box.fps.count(s.pipelines_created)}
        }
      }

      memory {
        const s = GpuStats[GpuStats].memory

        Layout: {direction: Column}

        title {
          GpuTitle: {label: "Memory"}
        }
        buffers {
          GpuRow: {
            label: "Buffers",
            value: "{box.fps.count(s.buffers)}, {box.fps.count(s.meshes)} meshes"
          }
        }
        instances {
          GpuRow: {label: "Instance pages", value: box.fps.bytes(s.instance_bytes)}
        }
        blend {
          GpuRow: {label: "Blend layers", value: box.fps.bytes(s.blend_bytes)}
        }
        graphs {
          GpuRow: {label: "Texture graphs", value: box.fps.bytes(s.graph_bytes)}
        }
      }
    }

    right {
      Layout: {direction: Column}

      packet {
        const s = GpuStats[GpuStats].packet

        Layout: {direction: Column}

        title {
          GpuTitle: {label: "Render packets"}
        }
        resources {
          GpuRow: {label: "Resources", value: box.fps.count(s.resources)}
        }
        uploads {
          GpuRow: {
            label: "Uploads",
            value: "{box.fps.count(s.uploads)}, {box.fps.bytes(s.bytes)}"
          }
        }
        scatters {
          GpuRow: {label: "Scatters", value: box.fps.count(s.scatters)}
        }
        processed {
          GpuRow: {label: "Changed entities", value: box.fps.count(s.processed)}
        }
        instance_bytes {
          GpuRow: {label: "Instance uploads", value: box.fps.bytes(s.instance_bytes)}
        }
      }

      texture_graphs {
        const s = GpuStats[GpuStats].texture_graphs

        Layout: {direction: Column}

        title {
          GpuTitle: {label: "Texture graphs"}
        }
        graphs {
          GpuRow: {
            label: "Graphs",
            value: "{box.fps.count(s.graphs)}, {box.fps.count(s.programs)} programs"
          }
        }
        evaluations {
          GpuRow: {label: "Evaluations", value: box.fps.count(s.evaluations)}
        }
        dispatches {
          GpuRow: {
            label: "Dispatches",
            value: "{box.fps.count(s.dispatches)}, {box.fps.count(s.texels)} texels"
          }
        }
        cache {
          GpuRow: {
            label: "Cache",
            value: "{box.fps.count(s.hits)} hit, {box.fps.count(s.misses)} miss"
          }
        }
        cached {
          GpuRow: {
            label: "Cached",
            value: "{box.fps.count(s.cached)}, {box.fps.bytes(s.cached_bytes)}"
          }
        }
      }

      mesh_graphs {
        const s = GpuStats[GpuStats].mesh_graphs

        Layout: {direction: Column}

        title {
          GpuTitle: {label: "Mesh graphs"}
        }
        jobs {
          GpuRow: {label: "Jobs", value: box.fps.count(s.jobs)}
        }
        evaluated {
          GpuRow: {
            label: "Nodes",
            value: "{box.fps.count(s.evaluated)}, {box.fps.count(s.hits)} cached"
          }
        }
        cached {
          GpuRow: {
            label: "Cached",
            value: "{box.fps.count(s.values)}, {box.fps.bytes(s.bytes)}"
          }
        }
      }

      grass {
        const s = GpuStats[GpuStats].grass

        Layout: {direction: Column}

        title {
          GpuTitle: {label: "Grass blades"}
        }
        blades {
          GpuRow: {
            label: "Drawn",
            value: "{box.fps.count(s.drawn)} of {box.fps.count(s.generated)}"
          }
        }
        lod0 {
          GpuRow: {
            label: "Level 0",
            value: "{box.fps.count(s.lod0.drawn)} of {box.fps.count(s.lod0.generated)}"
          }
        }
        lod1 {
          GpuRow: {
            label: "Level 1",
            value: "{box.fps.count(s.lod1.drawn)} of {box.fps.count(s.lod1.generated)}"
          }
        }
        lod2 {
          GpuRow: {
            label: "Level 2",
            value: "{box.fps.count(s.lod2.drawn)} of {box.fps.count(s.lod2.generated)}"
          }
        }
      }
    }
  }
}

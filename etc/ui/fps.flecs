// The frame rate panel. box.monitor loads this script at import into
// box.monitor.fps_panel and draws the panel while the exported visible
// variable is true, which the fps command switches. The panel reads the
// box.monitor.Fps singleton, which the engine refreshes and marks modified
// every frame: a background, two reference lines at sixty and thirty frames
// per second, one bar per recorded frame time with the newest on the right,
// green while the frame stayed above sixty frames per second, yellow above
// thirty and red below, and the frame rate of the last second as text.
// Everything here is ordinary UI, so an application that wants another panel
// ships its own script at etc/ui/fps.flecs.
module box.monitor.fps_panel
using flecs.script
using box.transform
using box.geometry
using box.material
using box.ui
using box.monitor

export mut visible = false

const bars = 120
const bar_w = 3
const slot = 4
const margin = 10
const pad = 6
const label_h = 20
const chart_h = 60
const bar_ms = 50
const green_ms = 1000.0 / 60.0 + 0.05
const yellow_ms = 1000.0 / 30.0 + 0.05
const width = bars * slot + pad * 2
const height = label_h + chart_h + pad * 3

if visible {
  panel {
    Ui: {height: 0, passthrough: true}

    screen {
      Anchor: {h: Left, v: Top}
      Layout: {}
      Fill: {width: 1, height: 1}

      frame {
        Anchor: {h: Right, v: Top, x: margin, y: margin}
        Layout: {width: width, height: height}

        back {
          HitThrough
          Anchor: {h: Left, v: Top}
          Rect: {width, height}
          Rgb: {10, 10, 13}
          Opacity: {0.7}
        }

        line_60 {
          HitThrough
          Anchor: {h: Left, v: Bottom, x: pad, y: pad + chart_h * (1000.0 / 60.0) / bar_ms}
          Rect: {bars * slot, 1}
          Rgb: {140, 140, 153}
          Opacity: {0.55}
        }

        line_30 {
          HitThrough
          Anchor: {h: Left, v: Bottom, x: pad, y: pad + chart_h * (1000.0 / 30.0) / bar_ms}
          Rect: {bars * slot, 1}
          Rgb: {140, 140, 153}
          Opacity: {0.55}
        }

        const fps = Fps[Fps]

        for i in 0..bars {
          if i >= bars - fps.count {
            const t = fps.history[i]
            "bar_{i}" {
              HitThrough
              Anchor: {h: Left, v: Bottom, x: pad + i * slot + slot - bar_w, y: pad}
              Rect: {bar_w, math.clamp(t / bar_ms * chart_h, bar_w, chart_h)}
              if t <= green_ms {
                Rgb: {74, 214, 97}
              } else if t <= yellow_ms {
                Rgb: {242, 199, 64}
              } else {
                Rgb: {232, 71, 66}
              }
            }
          }
        }

        label {
          HitThrough
          Anchor: {h: Right, v: Top, x: pad, y: height / 4 - label_h / 2}
          Font: {size: label_h}
          Text: {value: "{math.clamp(fps.fps, 0, 999):.0}", align: Right}
          if fps.mean_ms <= green_ms {
            Rgb: {74, 214, 97}
          } else if fps.mean_ms <= yellow_ms {
            Rgb: {242, 199, 64}
          } else {
            Rgb: {232, 71, 66}
          }
        }
      }
    }
  }
}

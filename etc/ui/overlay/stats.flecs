// The statistics panels: one column in the top right corner of the screen
// with the frame rate panel on top and every other panel under it. box.monitor
// ties every exported mut variable below but fps to the singleton its panel
// reads: turning a variable on adds the singleton, which starts its
// collection, and turning it off removes it, so a hidden panel costs nothing.
// The Fps singleton is always there. The fps and stats commands switch the
// variables. Every panel is a template from the widget script it is included
// from, so an application that wants another arrangement ships its own
// etc/ui/overlay/stats.flecs.
module box.monitor.stats
include theme
include fps
include renderer
include gpu
include passes
include pipelines
include bindgroups
include buffers
include compute
include systems
using flecs.script
using box.ui
using box.ui.theme
using box.monitor.panels

export mut fps = false
export mut renderer = false
export mut gpu = false
export mut pass = false
export mut pipeline = false
export mut bindgroup = false
export mut buffer = false
export mut compute = false
export mut systems = false

if fps || renderer || gpu || pass || pipeline || bindgroup || buffer || compute || systems {
  panel {
    Ui: {height: 0, passthrough: true}

    screen {
      Anchor: {h: Left, v: Top}
      Layout: {}
      Fill: {width: 1, height: 1}

      stack {
        Anchor: {h: Right, v: Top, x: margin, y: margin}
        Layout: {direction: Column, spacing: pad, h: Right, v: Top}

        if fps {
          FpsPanel fps_stats
        }

        if renderer {
          RendererPanel renderer_stats
        }

        if gpu {
          GpuPanel gpu_stats
        }

        if pass {
          PassPanel pass_stats
        }

        if pipeline {
          PipelinePanel pipeline_stats
        }

        if bindgroup {
          BindGroupPanel bindgroup_stats
        }

        if buffer {
          BufferPanel buffer_stats
        }

        if compute {
          ComputePanel compute_stats
        }

        if systems {
          SystemsPanel systems_stats
        }
      }
    }
  }
}

// The in game console the backtick key opens. box.ui loads this script the
// first time the console opens and fills the two elements it marks: the one
// with a ConsoleLog shows the log of the session and the one with a TextInput
// holds the line being typed, with its caret, its history and its completion.
// Everything else here is ordinary UI, so an application that wants another
// console ships its own script at etc/ui/console.flecs.
using box.transform
using box.geometry
using box.material
using box.ui

console {
  Ui: {height: 0}

  backdrop {
    Anchor: {h: Left, v: Top}
    Layout: {}
    Fill: {width: 0.5, height: 1}
    Rect: {}
    Rgb: {0, 0, 0}
    Opacity: {0.65}
    BackdropBlur: {radius: 32}
  }

  panel {
    Anchor: {h: Left, v: Top}
    Layout: {direction: Column, padding: 14, spacing: 8, h: Left, v: Top}
    Fill: {width: 0.5, height: 1}
    Font: {size: 18}

    scrollback {
      Layout: {}
      Fill: {width: 1, height: 0.9}
      Scroll: {y: Auto}
      ConsoleLog: {lines: 12}
      TerminalColors: {
        text: {255, 255, 255},
        muted: {133, 132, 124},
        accent: {57, 135, 229},
        error: {214, 58, 42},
        path: {79, 194, 180},
        type: {183, 140, 235},
        number: {110, 207, 139},
        string: {221, 167, 95}
      }
      Text: {value: "", align: Left}
      Rgb: {255, 255, 255}
    }

    prompt {
      Anchor: {h: Left, v: Bottom}
      Layout: {direction: Row, height: 24, padding: 4, spacing: 8, h: Left, v: Middle}
      Fill: {width: 1}
      Border: {radius: 6}
      Rgb: {24, 29, 44}

      marker {
        Text: {value: "$"}
        Rgb: {120, 210, 160}
      }

      input {
        Layout: {height: 18}
        Fill: {width: 1}
        TextInput: {focused: true, history: true, complete: true}
        Text: {value: ""}
        Rgb: {238, 244, 255}
      }
    }
  }
}
